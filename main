K.CreateSpace = K.Space

table.insert(h._themeListeners, function()
	for aj in pairs(ai) do
		if not aj._destroyed then
			aj:_rerender()
		end
	end
end)

do
	function h:OnError(aj)
		if type(aj) ~= "function" then
			return { Disconnect = function() end }
		end
		table.insert(h._errorListeners, aj)
		return {
			Disconnect = function()
				local ak = table.find(h._errorListeners, aj)
				if ak then
					table.remove(h._errorListeners, ak)
				end
			end,
		}
	end

	function h:GetErrors()
		return table.clone(h.Errors)
	end

	function h:ClearErrors()
		table.clear(h.Errors)
	end

	function h:SetErrorNotifications(aj)
		h.ErrorNotifications = aj ~= false
	end

	function h:Try(aj, ak, ...)
		if type(aj) == "function" then
			return runProtected("your code", aj, ak, ...)
		end
		return runProtected(tostring(aj), ak, ...)
	end

	function h:ReportError(aj, ak)
		return reportError(tostring(aj or "your code"), { Error = ak, Traceback = debug.traceback(nil, 2) or "" })
	end

	local aj = h.Utils

	function aj.WaitForCharacter(ak)
		local al = os.clock() + (tonumber(ak) or 10)
		repeat
			local am = g and g.Character
			if am and am:FindFirstChildOfClass("Humanoid") and (am:FindFirstChild("HumanoidRootPart") or am.PrimaryPart) then
				return am
			end
			task.wait(0.1)
		until os.clock() > al
		return nil
	end

	function aj.OnCharacter(ak)
		if type(ak) ~= "function" or not g then
			return { Disconnect = function() end }
		end
		local al
		local am = pcall(function()
			al = g.CharacterAdded:Connect(function(am)
				runProtected("a character callback", ak, am)
			end)
		end)
		if g.Character then
			task.spawn(runProtected, "a character callback", ak, g.Character)
		end
		local an = {
			Disconnect = function()
				if al then
					al:Disconnect()
					al = nil
				end
			end,
		}
		if am then
			table.insert(h._cleanup, an.Disconnect)
		end
		return an
	end

	local function dataPath(ak)
		local al = tostring(ak or "data"):gsub("[^%w%-_ ]", "")
		if al == "" then
			al = "data"
		end
		return "NucleusUI/data/" .. al .. ".json"
	end

	function aj.SaveData(ak, al)
		if type(writefile) ~= "function" then
			return false, "your executor can't write files"
		end
		local am, an = pcall(function()
			if type(isfolder) == "function" and type(makefolder) == "function" then
				if not isfolder("NucleusUI") then
					makefolder("NucleusUI")
				end
				if not isfolder("NucleusUI/data") then
					makefolder("NucleusUI/data")
				end
			end
			writefile(dataPath(ak), e:JSONEncode(al))
		end)
		if not am then
			log("SaveData failed: " .. tostring(an))
		end
		return am, not am and tostring(an) or nil
	end

	function aj.LoadData(ak, al)
		if type(readfile) ~= "function" then
			return al
		end
		local am = dataPath(ak)
		if type(isfile) == "function" and not isfile(am) then
			am = am:gsub("^NucleusUI/", "NeoxHub/")
			if not isfile(am) then
				return al
			end
		end
		local an, ao = pcall(function()
			return e:JSONDecode(readfile(am))
		end)
		if not an then
			log("LoadData could not read " .. tostring(ak) .. ", using the default instead")
			return al
		end
		return ao
	end

	function aj.Debounce(ak, al)
		local am = false
		al = tonumber(al) or 0.5
		return function(...)
			if am then
				return
			end
			am = true
			task.delay(al, function()
				am = false
			end)
			return ak(...)
		end
	end

	function K:SetBadge(ak)
		if ak == nil or ak == false or ak == "" or ak == 0 then
			self._badgeText = nil
		else
			self._badgeText = tostring(ak)
		end
		if not self._badge and self._badgeText then
			local al = create("Frame", {
				Name = "Badge",
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -8, 0.5, 0),
				Size = UDim2.fromOffset(0, 16),
				AutomaticSize = Enum.AutomaticSize.X,
				BackgroundColor3 = u.Accent,
				BackgroundTransparency = 0.82,
				BorderSizePixel = 0,
				ZIndex = 2,
				Parent = self._button,
			})
			addCorner(al, UDim.new(1, 0))
			addPadding(al, 6, 6)
			self._badgeLabel = createLabel({
				Size = UDim2.new(0, 0, 1, 0),
				AutomaticSize = Enum.AutomaticSize.X,
				Text = "",
				TextSize = 10,
				FontFace = w.Bold,
				TextColor3 = u.Accent,
				TextTruncate = Enum.TextTruncate.None,
				ZIndex = 2,
				Parent = al,
			})
			self._badge = al
			al:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
				self:_fitBadge()
			end)
		end
		if self._badge then
			if self._badgeText then
				self._badgeLabel.Text = self._badgeText
			end
			self._badge.Visible = self._badgeText ~= nil and not self.Window._compact
			self:_fitBadge()
		end
		return self
	end

	function K:GetBadge()
		return self._badgeText
	end

	function K:_fitBadge()
		local ak = self._label
		if not ak then
			return
		end
		local al = 0
		if self._badge and self._badge.Visible then
			local am = self.Window.Scale and self.Window.Scale.Scale or 1
			al = self._badge.AbsoluteSize.X / math.max(am, 0.01) + 6
		end
		ak.Size = UDim2.new(1, -(self._labelX + 8 + al), 1, 0)
	end

	function K:AccentPicker(ak)
		local al = normalizeOptions(ak, { Title = "Name", Description = "Desc" })
		local am = al.Callback
		return self:ColorPicker({
			Name = al.Name or "Accent colour",
			Desc = al.Desc,
			Default = al.Default or u.Accent,
			Flag = al.Flag,
			Callback = function(an)
				h:SetAccent(an)
				safeCall(am, an)
			end,
		})
	end

