	local function placeHint()
		if x then
			M.Position = UDim2.fromOffset(48, 26)
			M.Size = UDim2.new(1, -54, 0, 16)
			return
		end
		local N = L.AbsoluteSize.X / ai.Scale.Scale
		M.Position = UDim2.fromOffset(48 + N + 6, 26)
		M.Size = UDim2.new(1, -(54 + N + 6), 0, 16)
	end
	L:GetPropertyChangedSignal("AbsoluteSize"):Connect(placeHint)
	task.defer(placeHint)

	local N = create("Frame", {
		Name = "Content",
		Active = true,
		Position = UDim2.fromOffset(ai._sidebarWidth + 2, 0),
		Size = UDim2.new(1, -(ai._sidebarWidth + 2), 1, 0),
