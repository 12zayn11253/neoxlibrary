local tweenInfoCache = {}
local virtualGroups = setmetatable({}, { __mode = "k" })

local function fadeGroup(root, value, info)
	local state = virtualGroups[root]
	if not state then
		state = { Value = 0, Bases = setmetatable({}, { __mode = "k" }) }
		virtualGroups[root] = state
	end
	local previous = state.Value
	state.Value = value
	local last
	local function apply(object, property)
		local bases = state.Bases[object]
		if not bases then
			bases = {}
			state.Bases[object] = bases
		end
		local base = bases[property]
		if base == nil then
			base = object[property]
			if type(base) ~= "number" then
				return
			end
			bases[property] = base
			object[property] = base + (1 - base) * previous
		end
		local target = base + (1 - base) * value
		if info then
			last = TweenService:Create(object, info, { [property] = target })
			last:Play()
		else
			object[property] = target
		end
	end
	local function visit(object)
		if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
			apply(object, "TextTransparency")
		elseif object:IsA("ImageLabel") or object:IsA("ImageButton") then
			apply(object, "ImageTransparency")
		end
		if object:IsA("UIStroke") then
			apply(object, "Transparency")
		elseif object:IsA("GuiObject") then
			apply(object, "BackgroundTransparency")
		end
	end
	visit(root)
	for _, descendant in ipairs(root:GetDescendants()) do
		visit(descendant)
	end
	return last
end

local function tween(object, goals, duration, style, direction)
	duration = duration or 0.2
	if instantUI() then
		duration = 0
	end
	if not IS_TOUCH and goals.GroupTransparency ~= nil and virtualGroups[object] then
		local rest = table.clone(goals)
		rest.GroupTransparency = nil
		local info
		if duration > 0 then
			info = TweenInfo.new(duration, style or Enum.EasingStyle.Quart, direction or Enum.EasingDirection.Out)
		end
		local track = fadeGroup(object, goals.GroupTransparency, info)
		if next(rest) then
			return tween(object, rest, duration, style, direction) or track
		end
		return track
	end
	if duration <= 0 then
		for property, value in pairs(goals) do
			if property ~= "GroupTransparency" or object:IsA("CanvasGroup") then
				object[property] = value
			elseif object:IsA("GuiObject") then
				object.Visible = value < 1
			end
		end
		return nil
	end
	style = style or Enum.EasingStyle.Quart
	direction = direction or Enum.EasingDirection.Out

	local cacheKey = duration .. style.Name .. direction.Name
	local info = tweenInfoCache[cacheKey]
	if not info then
		info = TweenInfo.new(duration, style, direction)
		tweenInfoCache[cacheKey] = info
	end

	local track = TweenService:Create(object, info, goals)
	track:Play()
	return track
end

Nucleus.TextScale = 0.9
Nucleus.NotificationPosition = nil
local createNotifyHost
Nucleus._themeListeners = {}
Nucleus._cleanup = {}

local Localization = {
	Prefix = "loc:",
	Default = "en",
	Language = "en",
	Translations = {},
}
Nucleus._localization = Localization

local function translate(text)
	if type(text) ~= "string" then
		return text, nil
	end
	local prefix = Localization.Prefix
	if prefix == "" or text:sub(1, #prefix) ~= prefix then
		return text, nil
	end
	local key = text:sub(#prefix + 1)
	local pack = Localization.Translations[Localization.Language] or {}
	local fallback = Localization.Translations[Localization.Default] or {}
	return pack[key] or fallback[key] or key, key
end

Const.TRANSLATED_PROPERTIES = { Text = true, PlaceholderText = true }

local function setTranslated(instance, property, value)
	local text, key = translate(value)
	instance[property] = text
	instance:SetAttribute("NucleusLoc" .. property, key)
end

local function create(className, properties, children)
	local plainGroup = className == "CanvasGroup" and (IS_TOUCH or not Const.REAL_GROUPS[properties.Name or ""])
	local instance = Instance.new(plainGroup and "Frame" or className)
	if plainGroup and not IS_TOUCH then
		virtualGroups[instance] = { Value = properties.GroupTransparency or 0, Bases = setmetatable({}, { __mode = "k" }) }
	end
	for property, value in pairs(properties) do
		if plainGroup and property == "GroupTransparency" then
			continue
		elseif property == "TextSize" then
			instance.TextSize = math.max(Const.MIN_TEXT_SIZE, math.floor(value * (Nucleus.TextScale or 1) + 0.5))
		elseif Const.TRANSLATED_PROPERTIES[property] and type(value) == "string" then
			setTranslated(instance, property, value)
		elseif property ~= "Parent" then
			instance[property] = value
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = instance
		end
	end
	if properties.Parent then
		instance.Parent = properties.Parent
	end
	return instance
end

local function addCorner(parent, radius)
	return create("UICorner", {
		CornerRadius = radius or UDim.new(0, 8),
		Parent = parent,
	})
end

local function addStroke(parent, color, transparency, thickness)
	return create("UIStroke", {
		Color = color or Theme.Stroke,
		Transparency = transparency or 0,
		Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

Const.APPEARANCE_DEFAULTS = {
	WindowRadius = 12,
	CardRadius = 10,
	CardBorder = false,
	SidebarWidth = 146,
	Spacing = 6,
	Shadow = true,
	TabHighlight = "Fill",
	Depth = true,
}

Const.APPEARANCE_LIMITS = {
	WindowRadius = { 0, 24 },
	CardRadius = { 0, 18 },
	SidebarWidth = { 120, 220 },
	Spacing = { 2, 16 },
}

Const.TAB_HIGHLIGHTS = { Fill = true, Outline = true }

local Appearance = table.clone(Const.APPEARANCE_DEFAULTS)
Nucleus.Appearance = Appearance

local function applyAppearance(input)
	for key, value in pairs(Const.APPEARANCE_DEFAULTS) do
		Appearance[key] = value
	end
	if input == nil then
		return
	end
	if type(input) ~= "table" then
		log("Appearance should be a table, like Appearance = { CardRadius = 8 }")
		return
	end
	for key, value in pairs(input) do
		local default = Const.APPEARANCE_DEFAULTS[key]
		if key == "Font" then
			Nucleus:SetFont(value)
		elseif default == nil then
			local known = { "Font" }
			for name in pairs(Const.APPEARANCE_DEFAULTS) do
				table.insert(known, name)
			end
			table.sort(known)
			log(("Appearance has no option '%s'. Options: %s"):format(tostring(key), table.concat(known, ", ")))
		elseif type(default) == "number" then
			local number = tonumber(value)
			if number then
				local limits = Const.APPEARANCE_LIMITS[key]
				Appearance[key] = math.clamp(math.floor(number + 0.5), limits[1], limits[2])
			else
				log(("Appearance.%s should be a number"):format(key))
			end
		elseif type(default) == "boolean" then
			Appearance[key] = value == true
		elseif key == "TabHighlight" then
			if Const.TAB_HIGHLIGHTS[value] then
				Appearance[key] = value
			else
				log('Appearance.TabHighlight should be "Fill" or "Outline"')
			end
		end
	end
end
Nucleus._applyAppearance = applyAppearance

local function styleCard(card)
	addCorner(card, UDim.new(0, Appearance.CardRadius))
	local baseKey = Appearance.CardBorder and "Stroke" or "Surface2"
	local stroke = addStroke(card, Theme[baseKey])
	stroke:SetAttribute(Const.ATTR_STROKE_BASE, baseKey)
	if Appearance.Depth then
		create("UIGradient", {
			Name = "Depth",
			Rotation = 90,
			Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(222, 222, 226)),
			Parent = card,
		})
	end
	return stroke
end

local function addPadding(parent, left, right, top, bottom)
	return create("UIPadding", {
		PaddingLeft = UDim.new(0, left or 0),
		PaddingRight = UDim.new(0, right or 0),
		PaddingTop = UDim.new(0, top or 0),
		PaddingBottom = UDim.new(0, bottom or 0),
		Parent = parent,
	})
end

local function createLabel(properties)
	local defaults = {
		BackgroundTransparency = 1,
		TextColor3 = Theme.Text,
		TextSize = 14,
		FontFace = Fonts.Medium,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}
	for property, value in pairs(properties) do
		defaults[property] = value
	end
	return create("TextLabel", defaults)
end

local function addInnerShadow(parent, strength, reach)
	local shade = create("Frame", {
		Name = "InnerShadow",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		ZIndex = 0,
		Parent = parent,
	})
	shade:SetAttribute(Const.ATTR_NO_THEME, true)
	local corner = parent:FindFirstChildOfClass("UICorner")
	if corner then
		addCorner(shade, corner.CornerRadius)
	end
	create("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, strength or 0.55),
			NumberSequenceKeypoint.new(reach or 0.5, 1),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = shade,
	})
	return shade
end

local function addScrollFades(scroller, colorKey, size)
	size = size or 18
	local holder = create("Frame", {
		Name = "ScrollFades",
		Position = scroller.Position,
		Size = scroller.Size,
		BackgroundTransparency = 1,
		ZIndex = (scroller.ZIndex or 1) + 5,
		Parent = scroller.Parent,
	})
	local function makeFade(top)
		local fade = create("Frame", {
			AnchorPoint = Vector2.new(0, top and 0 or 1),
			Position = top and UDim2.new() or UDim2.fromScale(0, 1),
			Size = UDim2.new(1, 0, 0, size),
			BackgroundColor3 = Theme[colorKey],
			BorderSizePixel = 0,
			Visible = false,
			ZIndex = holder.ZIndex,
			Parent = holder,
		})
		create("UIGradient", {
			Rotation = top and 90 or 270,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = fade,
		})
		return fade
	end
	local topFade, bottomFade = makeFade(true), makeFade(false)
	local function update()
		local canvas, window, position = scroller.AbsoluteCanvasSize, scroller.AbsoluteWindowSize, scroller.CanvasPosition
		if not (canvas and window and position) then
			return
		end
		local y = position.Y
		local visible = window.Y
		local total = canvas.Y
		topFade.Visible = y > 2
		bottomFade.Visible = total - visible - y > 2
	end
	local function sync()
		holder.Position = scroller.Position
		holder.Size = scroller.Size
		holder.Visible = scroller.Visible
	end
	for _, property in ipairs({ "CanvasPosition", "AbsoluteCanvasSize", "AbsoluteWindowSize" }) do
		scroller:GetPropertyChangedSignal(property):Connect(update)
	end
	for _, property in ipairs({ "Position", "Size", "Visible" }) do
		scroller:GetPropertyChangedSignal(property):Connect(sync)
	end
	task.defer(update)
	return holder
end

local function addTopHighlight()
	return nil
end

local function setIcon(imageLabel, icon)
	local image, rectOffset, rectSize = resolveIcon(icon)
	if not image then
		return false
	end
	imageLabel.Image = image
	imageLabel.ImageRectOffset = rectOffset or Vector2.zero
	imageLabel.ImageRectSize = rectSize or Vector2.zero
	return true
end

local logoTargets = {}
local resolvedLogo
local resolvingLogo = false

local function imageLoads(id)
	local loaded = false
	local ok = pcall(function()
		game:GetService("ContentProvider"):PreloadAsync({ id }, function(_, status)
			loaded = status == Enum.AssetFetchStatus.Success
		end)
	end)
	return ok and loaded
end

local function findLogoImage(id)
	if imageLoads(id) then
		return id
	end
	local ok, objects = pcall(function()
		return game:GetObjects(id)
	end)
	if ok and type(objects) == "table" then
		local asset = objects[1]
		if typeof(asset) == "Instance" and (asset:IsA("Decal") or asset:IsA("Texture")) and asset.Texture ~= "" then
			return asset.Texture
		end
	end
	return id
end

local function setLogo(imageLabel, customIcon)
	if customIcon ~= nil then
		setIcon(imageLabel, customIcon)
		return
	end
	imageLabel.Image = resolvedLogo or Assets.Logo
	if resolvedLogo then
		return
	end
	logoTargets[imageLabel] = true
	if resolvingLogo then
		return
	end
	resolvingLogo = true
	task.spawn(function()
		local image = findLogoImage(Assets.Logo)
		resolvedLogo = image
		for target in pairs(logoTargets) do
			if target.Parent then
				target.Image = image
			end
		end
		table.clear(logoTargets)
	end)
end

local function createIcon(parent, icon, color, position)
	local holder = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = position,
		Size = UDim2.fromOffset(16, 16),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	local image = create("ImageLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ImageColor3 = color,
		ScaleType = Enum.ScaleType.Fit,
		Parent = holder,
	})
	setIcon(image, icon)
	return holder, image
end

local function getGuiParent()
	local hidden
	pcall(function()
		if typeof(gethui) == "function" then
			hidden = gethui()
		end
	end)
	if typeof(hidden) == "Instance" then
		return hidden
	end

	local coreGui
	pcall(function()
		local candidate = game:GetService("CoreGui")
		local probe = Instance.new("Folder")
		probe.Parent = candidate
		probe:Destroy()
		coreGui = candidate
	end)
	if coreGui then
		return coreGui
	end

	return LocalPlayer:WaitForChild("PlayerGui")
end

local insetFrame, cachedInset = nil, Vector2.zero
local function getMousePosition()
	local now = time()
	if insetFrame ~= now then
		insetFrame = now
		cachedInset = GuiService:GetGuiInset()
	end
	return UserInputService:GetMouseLocation() - cachedInset
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local function isMove(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
end

local function pointInside(point, guiObject)
	local position, size = guiObject.AbsolutePosition, guiObject.AbsoluteSize
	return point.X >= position.X and point.X <= position.X + size.X and point.Y >= position.Y and point.Y <= position.Y + size.Y
end

local function createChevron(parent, anchorX, offsetX)
	local holder = create("Frame", {
		AnchorPoint = Vector2.new(anchorX, 0.5),
		Position = UDim2.new(anchorX, offsetX, 0.5, 0),
		Size = UDim2.fromOffset(18, 18),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	local chevron = {}

	local image = create("ImageLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(16, 16),
		BackgroundTransparency = 1,
		ImageColor3 = Theme.Muted,
		ScaleType = Enum.ScaleType.Fit,
		Parent = holder,
	})

	if setIcon(image, "chevron-down") then
		function chevron:Set(open)
			tween(image, {
				Rotation = open and 180 or 0,
				ImageColor3 = open and Theme.Accent or Theme.Muted,
			}, 0.3, Enum.EasingStyle.Quint)
		end
		return chevron
	end

	image:Destroy()

	local function glyph(rotation, transparency)
		return createLabel({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(18, 18),
			Text = "›",
			TextSize = 22,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextColor3 = Theme.Muted,
			TextTransparency = transparency,
			Rotation = rotation,
			Parent = holder,
		})
	end

	local closedGlyph = glyph(90, 0)
	local openGlyph = glyph(270, 1)

	function chevron:Set(open)
		tween(closedGlyph, { TextTransparency = open and 1 or 0 }, 0.2)
		tween(openGlyph, {
			TextTransparency = open and 0 or 1,
			TextColor3 = open and Theme.Accent or Theme.Muted,
		}, 0.2)
	end

	return chevron
end

local ripplePool = {}

local function ripple(target, color)
	local mouse = getMousePosition()
	local diameter = math.max(target.AbsoluteSize.X, target.AbsoluteSize.Y) * 2.2

	local circle = table.remove(ripplePool)
	if not circle then
		circle = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			BorderSizePixel = 0,
		})
		addCorner(circle, UDim.new(1, 0))
	end

	circle.BackgroundColor3 = color or Theme.Accent
	circle.Position = UDim2.fromOffset(mouse.X - target.AbsolutePosition.X, mouse.Y - target.AbsolutePosition.Y)
	circle.Size = UDim2.fromOffset(0, 0)
	circle.BackgroundTransparency = 0.82
	circle.ZIndex = target.ZIndex + 1
	circle.Parent = target

	tween(circle, {
		Size = UDim2.fromOffset(diameter, diameter),
		BackgroundTransparency = 1,
	}, 0.55)

	task.delay(0.55, function()
		if circle.Parent ~= target then
			return
		end
		circle.Parent = nil
		if #ripplePool < 4 then
			table.insert(ripplePool, circle)
		else
			circle:Destroy()
		end
	end)
end

local function strokeBase(stroke)
	return Theme[stroke:GetAttribute(Const.ATTR_STROKE_BASE) or "Stroke"] or Theme.Stroke
end

local function flashStroke(stroke)
	if not stroke then
		return
	end
	tween(stroke, { Color = Theme.Accent, Transparency = 0.2 }, 0.08)
	task.delay(0.12, function()
		tween(stroke, { Color = strokeBase(stroke), Transparency = 0 }, 0.35)
	end)
end

Const.HOVER_LIFT = 0.4
Const.MINI_TEXT_WIDTH = 170

local function bindHoverStroke(guiObject, stroke)
	local lifted = false
	guiObject.MouseEnter:Connect(function()
		if IS_TOUCH then
			return
		end
		tween(stroke, { Color = Theme.StrokeHover }, 0.12)
		if guiObject.BackgroundColor3 == Theme.Surface2 and (guiObject.BackgroundTransparency or 0) < 1 then
			lifted = true
			tween(guiObject, { BackgroundColor3 = Theme.Surface2:Lerp(Theme.Surface3, Const.HOVER_LIFT) }, 0.12)
		end
	end)
	guiObject.MouseLeave:Connect(function()
		tween(stroke, { Color = strokeBase(stroke) }, 0.25)
		if lifted then
			lifted = false
			tween(guiObject, { BackgroundColor3 = Theme.Surface2 }, 0.25)
		end
	end)
end

Const.SHORT_KEY_NAMES = {
	[Enum.KeyCode.LeftControl] = "LCtrl",
	[Enum.KeyCode.RightControl] = "RCtrl",
	[Enum.KeyCode.LeftShift] = "LShift",
	[Enum.KeyCode.RightShift] = "RShift",
	[Enum.KeyCode.LeftAlt] = "LAlt",
	[Enum.KeyCode.RightAlt] = "RAlt",
	[Enum.KeyCode.Return] = "Enter",
	[Enum.KeyCode.Escape] = "Esc",
	[Enum.KeyCode.Backspace] = "Backspace",
}

local function keyDisplayName(keyCode)
	if keyCode == nil then
		return "None"
	end
	return Const.SHORT_KEY_NAMES[keyCode] or keyCode.Name
end

local function toKeyCode(value)
	if typeof(value) == "EnumItem" then
		return value
	end
	if type(value) ~= "string" or value == "" or value == "None" then
		return nil
	end
	local ok, keyCode = pcall(function()
		return Enum.KeyCode[value]
	end)
	if ok and keyCode then
		return keyCode
	end
	log("unknown key name: " .. value)
	return nil
end

local function createStepper(minimum, maximum, step)
	if maximum < minimum then
		minimum, maximum = maximum, minimum
	end
	if not step or step <= 0 then
		step = 1
	end

	local decimals = 0
	while decimals < 6 do
		local scaled = step * 10 ^ decimals
		if math.abs(scaled - math.floor(scaled + 0.5)) < 1e-9 then
			break
		end
		decimals += 1
	end
	local pattern = "%." .. decimals .. "f"

	return {
		snap = function(value)
			value = math.floor(value / step + 0.5) * step
			value = tonumber(string.format(pattern, value)) or value
			return math.clamp(value, minimum, maximum)
		end,
		format = function(value)
			return string.format(pattern, value)
		end,
	}
end

local decorateElement

local function registerElement(tab, options, element, frame, typeName, callbackKey)
	element._type = typeName
	element._frame = frame
	element._listeners = element._listeners or {}

	local window = tab and tab.Window
	element._tab = tab
	callbackKey = callbackKey or "Callback"
	local displayName = options.Name or options.Title or options.Text or options.Flag
	local label = displayName ~= nil and ('%s "%s"'):format(typeName, tostring(displayName)) or typeName
	element._label = label
	local userCallback = options[callbackKey]
	local wrapped = window ~= nil
	local changedListeners = {}

	if userCallback ~= nil and type(userCallback) ~= "function" then
		log(("%s: %s should be a function, but got a %s. It will be ignored."):format(label, callbackKey, typeof(userCallback)))
		userCallback = nil
	end
	if options.Flag ~= nil and type(options.Flag) ~= "string" then
		log(("%s: Flag should be a string, but got a %s."):format(label, typeof(options.Flag)))
		options.Flag = tostring(options.Flag)
	end
	if options.Flag and window then
		local existing = window.Flags[options.Flag]
		if existing and existing ~= element and not existing._destroyed then
			log(('%s: Flag "%s" is already used by %s. Every Flag needs to be unique, otherwise saving and loading mixes them up.')
				:format(label, options.Flag, existing._label or "another element"))
		end
	end
	if typeName == "Slider" and options.Range ~= nil
		and (type(options.Range) ~= "table" or not tonumber(options.Range[1]) or not tonumber(options.Range[2])) then
		log(("%s: Range should look like { min, max }, for example { 0, 100 }."):format(label))
	end
	if (typeName == "Slider" or typeName == "Stepper") and options.Increment ~= nil
		and (not tonumber(options.Increment) or tonumber(options.Increment) <= 0) then
		log(("%s: Increment should be a number above 0."):format(label))
	end
	if typeName == "Dropdown" and options.Options ~= nil and type(options.Options) ~= "table" then
		log(("%s: Options should be a list, for example { \"A\", \"B\" }."):format(label))
	end
	if typeName == "Toggle" and options.Loop ~= nil and type(options.Loop) ~= "function" then
		log(("%s: Loop should be a function."):format(label))
	end

	function element:OnChanged(listener)
		if type(listener) ~= "function" then
			return { Disconnect = function() end }
		end
		table.insert(changedListeners, listener)
		return {
			Disconnect = function()
				local index = table.find(changedListeners, listener)
				if index then
					table.remove(changedListeners, index)
				end
			end,
		}
	end

	if options.Flag then
		Nucleus.Flags[options.Flag] = element
		if window then
			window.Flags[options.Flag] = element
		end
		if window and window._loadedConfig and window._applyLateConfig then
			local flag = options.Flag
			task.defer(function()
				if window.Flags[flag] == element and not element._destroyed then
					window:_applyLateConfig(element, flag)
				end
			end)
		end
		local pending = Nucleus._flagListeners and Nucleus._flagListeners[options.Flag]
		if pending then
			for _, entry in ipairs(pending) do
				entry.Connections[element] = element:OnChanged(entry.Listener)
			end
		end
	end

	if window and callbackKey ~= "Callback" and type(options.Callback) == "function" then
		local pressCallback = options.Callback
		options.Callback = function(...)
			runProtected(label, pressCallback, ...)
		end
	end

	if window then
		options[callbackKey] = function(...)
			if element._destroyed then
				return
			end
			runProtected(label, userCallback, ...)
			for _, listener in ipairs(table.clone(changedListeners)) do
				runProtected(label .. " OnChanged", listener, ...)
			end
			if options.Flag then
				window:_autoSave()
			end
			window:_queueDependencies()
		end
		table.insert(window._elements, element)
		local dependsOn = options.DependsOn
		if dependsOn == nil then
			dependsOn = options.Depends
		end
		if dependsOn ~= nil then
			element._dependsOn = dependsOn
			table.insert(window._dependents, element)
			window:_queueDependencies()
		end
	end
	if type(element.Get) == "function" then
		local ok, value = pcall(element.Get, element)
		if ok then
			element._defaultValue = type(value) == "table" and table.clone(value) or value
		end
	end
	if type(element.Set) == "function" then
		if element.Reset == nil then
			function element:Reset()
				local default = element._defaultValue
				if type(default) == "table" then
					default = table.clone(default)
				end
				element:Set(default)
			end
		end
		if element.SetValue == nil then
			element.SetValue = element.Set
		end
	end
	if type(element.Get) == "function" and element.GetValue == nil then
		element.GetValue = element.Get
	end

	function element:SetCallback(callback)
		if wrapped then
			userCallback = callback
		else
			options[callbackKey] = callback
		end
	end

	if window and frame and window._searchIndex then
		local searchName = options.Name or options.Title or options.Text
		if type(searchName) == "string" and searchName ~= "" then
			table.insert(window._searchIndex, {
				Name = searchName,
				Tab = tab._rootTab or tab,
				Group = tab._groupElement,
				Frame = frame,
				Element = element,
			})
		end
	end

	function element:Destroy()
		if element._destroyed then
			return
		end
		element._destroyed = true
		for _, disconnect in ipairs(element._listeners) do
			disconnect()
		end
		element._listeners = {}
		if options.Flag then
			if Nucleus.Flags[options.Flag] == element then
				Nucleus.Flags[options.Flag] = nil
			end
			if window and window.Flags[options.Flag] == element then
				window.Flags[options.Flag] = nil
			end
		end
		table.clear(changedListeners)
		if window then
			window._controlsDirty = true
			local index = table.find(window._elements, element)
			if index then
				table.remove(window._elements, index)
			end
			index = table.find(window._dependents, element)
			if index then
				table.remove(window._dependents, index)
			end
			if window._searchIndex then
				for entryIndex = #window._searchIndex, 1, -1 do
					if window._searchIndex[entryIndex].Element == element then
						table.remove(window._searchIndex, entryIndex)
					end
				end
			end
		end
		if frame then
			frame:Destroy()
		end
	end

	if frame then
		decorateElement(element, frame, options, window)
	end

	if typeName ~= "KeyInfo" then
		for key, method in pairs(element) do
			if type(key) == "string" and type(method) == "function" and key:sub(1, 1) ~= "_" then
				element[key] = function(self, ...)
					if self ~= element then
						error(("%s%s: %s was called with a dot. Write element:%s(...) with a colon, not element.%s(...)")
							:format(Const.LOG_PREFIX, label, key, key, key), 2)
					end
					return method(self, ...)
				end
			end
		end
	end
	return element
end

local function createCard(tab, className, height)
	local properties = {
		Size = UDim2.new(1, 0, 0, height),
		BackgroundColor3 = Theme.Surface2,
		BorderSizePixel = 0,
		LayoutOrder = tab:_nextOrder(),
		Parent = tab.List,
	}
	if className == "TextButton" then
		properties.AutoButtonColor = false
		properties.Text = ""
	end
	local card = create(className, properties)
	card:SetAttribute(Const.ATTR_NO_DRAG, true)
	local stroke = styleCard(card)
	return card, stroke
end

local function createTitleBlock(parent, title, description, rightReserve)
	local titleLabel, descLabel
	if description then
		local top = (Const.ROW_HEIGHT_DESC - 38) / 2
		titleLabel = createLabel({
			Name = "Title",
			Position = UDim2.fromOffset(14, top),
			Size = UDim2.new(1, -(14 + rightReserve), 0, 18),
			Text = title,
			Parent = parent,
		})
		descLabel = createLabel({
			Name = "Desc",
			Position = UDim2.fromOffset(14, top + 20),
			Size = UDim2.new(1, -(14 + rightReserve), 0, 17),
			Text = description,
			TextSize = 13,
			FontFace = Fonts.Regular,
			TextColor3 = Theme.Muted,
			Parent = parent,
		})
	else
		titleLabel = createLabel({
			Name = "Title",
			Position = UDim2.fromOffset(14, 0),
			Size = UDim2.new(1, -(14 + rightReserve), 1, 0),
			Text = title,
			Parent = parent,
		})
	end
	return titleLabel, descLabel
end

local function createRowElement(tab, input, aliases, className, rightReserve, defaultTitle)
	local options = normalizeOptions(input, aliases)
	local height = options.Desc and Const.ROW_HEIGHT_DESC or Const.ROW_HEIGHT
	local card, stroke = createCard(tab, className or "Frame", height)
	bindHoverStroke(card, stroke)
	local titleLabel, descLabel
	if rightReserve then
		titleLabel, descLabel = createTitleBlock(card, options.Name or defaultTitle, options.Desc, rightReserve)
	end
	return options, card, stroke, height, titleLabel, descLabel
end

local function setTitleReserve(titleLabel, descLabel, rightReserve)
	if titleLabel then
		titleLabel.Size = UDim2.new(1, -(14 + rightReserve), titleLabel.Size.Y.Scale, titleLabel.Size.Y.Offset)
	end
	if descLabel then
		descLabel.Size = UDim2.new(1, -(14 + rightReserve), 0, descLabel.Size.Y.Offset)
	end
end

decorateElement = function(element, frame, options, window)
	local function findChild(name)
		return frame:FindFirstChild(name, true)
	end

	if element.SetTitle == nil then
		function element:SetTitle(text)
			local label = findChild("Title")
			if label then
				setTranslated(label, "Text", text == nil and "" or tostring(text))
			end
		end
	end

	if element.SetDesc == nil then
		function element:SetDesc(text)
			local label = findChild("Desc")
			if label then
				setTranslated(label, "Text", text == nil and "" or tostring(text))
			elseif text ~= nil and text ~= "" then
				log((element._label or "Element") .. ": SetDesc only works if the element was created with a Desc. Add Desc = \"\" when you create it.")
			end
		end
	end

	element.Visible = true
	function element:SetVisible(visible)
		element.Visible = visible ~= false
		frame.Visible = element.Visible

		frame:SetAttribute(Const.ATTR_HIDDEN, not element.Visible)
	end

	element.Locked = false
	local lockOverlay, lockReasonLabel
	function element:Lock(reason)
		return element:SetLocked(true, reason)
	end

	function element:Unlock()
		return element:SetLocked(false)
	end

	function element:SetLocked(locked, reason)
		element.Locked = locked == true
		if element.Locked and type(element.SetOpen) == "function" then
			element:SetOpen(false)
		end

		if not lockOverlay then
			if not element.Locked then
				return
			end
			lockOverlay = create("TextButton", {
				Name = "Lock",
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = Theme.Background,
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
				ZIndex = 20,
				Parent = frame,
			})
			addCorner(lockOverlay)

			local badge = create("Frame", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -10, 0.5, 0),
				Size = UDim2.fromOffset(0, Const.CHIP_HEIGHT),
				AutomaticSize = Enum.AutomaticSize.X,
				BackgroundColor3 = Theme.Surface,
				BorderSizePixel = 0,
				ZIndex = 21,
				Parent = lockOverlay,
			})
			addCorner(badge, UDim.new(0, 6))
			addStroke(badge)
			addPadding(badge, 8, 10)
			create("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				VerticalAlignment = Enum.VerticalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 6),
				Parent = badge,
			})

			local lockIcon = create("ImageLabel", {
				Size = UDim2.fromOffset(14, 14),
				BackgroundTransparency = 1,
				ImageColor3 = Theme.Muted,
				ScaleType = Enum.ScaleType.Fit,
				LayoutOrder = 1,
				ZIndex = 22,
				Parent = badge,
			})
			setIcon(lockIcon, "lock")

			lockReasonLabel = createLabel({
				Size = UDim2.new(0, 0, 1, 0),
				AutomaticSize = Enum.AutomaticSize.X,
				TextSize = 12,
				TextColor3 = Theme.Muted,
				TextTruncate = Enum.TextTruncate.None,
				LayoutOrder = 2,
				ZIndex = 22,
				Parent = badge,
			})
		end

		lockReasonLabel.Text = reason or "Locked"
		lockOverlay.Visible = element.Locked
		lockOverlay.BackgroundTransparency = element.Locked and 0.35 or 1
	end

	local tooltipText = options.Tooltip
	if window then
		frame.MouseEnter:Connect(function()
			if IS_TOUCH then
				return
			end
			if tooltipText and not element.Locked then
				window:_showTooltip(tooltipText, frame)
			end
		end)
		frame.MouseLeave:Connect(function()
			window:_hideTooltip(frame)
		end)
	end
	function element:SetTooltip(text)
		tooltipText = text
	end

	if options.Locked then
		element:SetLocked(true, options.LockedReason)
	end
	if options.Visible == false then
		element:SetVisible(false)
	end
end

local Tab = {}
Tab.__index = Tab

function Tab:_nextOrder()
	self._order += 1
	return self._order
end

function Tab:Section(input)
	local text = input
	if type(input) == "table" then
		text = input.Name or input.Title or ""
	end
	text = tostring(text or "")

	local holder = create("Frame", {
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundTransparency = 1,
		LayoutOrder = self:_nextOrder(),
		Parent = self.List,
	})
	local label = createLabel({
		Name = "Title",
		Position = UDim2.fromOffset(2, 12),
		Size = UDim2.new(1, -4, 0, 16),
		Text = text,
		TextSize = 13,
		FontFace = Fonts.Bold,
		TextColor3 = Theme.Text,
		Parent = holder,
	})

	local section = {}
	function section:Set(newText)
		setTranslated(label, "Text", tostring(newText))
	end
	section.SetTitle = section.Set

	return registerElement(self, {}, section, holder, "Section")
end

function Tab:Divider()
	local line = create("Frame", {
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = Theme.Stroke,
		BorderSizePixel = 0,
		LayoutOrder = self:_nextOrder(),
		Parent = self.List,
	})
	return registerElement(self, {}, {}, line, "Divider")
end

function Tab:Label(input)
	local options = normalizeOptions(input, { Name = "Text", Title = "Text" })

	local label = createLabel({
		Size = UDim2.new(1, 0, 0, 18),
		Text = tostring(options.Text or ""),
		TextSize = 13,
		FontFace = Fonts.Regular,
		TextColor3 = options.Color or Theme.Muted,
		LayoutOrder = self:_nextOrder(),
		Parent = self.List,
	})
	addPadding(label, 2)

	local element = { _listeners = {} }
	function element:Set(text)
		label.Text = tostring(text)
	end
	function element:Get()
		return label.Text
	end

	if type(options.Update) == "function" then
		local rate = math.max(tonumber(options.UpdateRate) or 1, 0.05)
		local running = true
		table.insert(element._listeners, function()
			running = false
		end)
		task.spawn(function()
			while running and label.Parent do
				local ok, value = pcall(options.Update)
				if ok and value ~= nil then
					label.Text = tostring(value)
				elseif not ok then
					log("label update error: " .. tostring(value))
				end
				task.wait(rate)
			end
		end)
		function element:SetUpdateRate(newRate)
			rate = math.max(tonumber(newRate) or rate, 0.05)
		end
	end

	return registerElement(self, options, element, label, "Label")
end

Const.PARAGRAPH_COLORS = {
	Red = Color3.fromRGB(240, 110, 110),
	Orange = Color3.fromRGB(245, 160, 90),
	Yellow = Color3.fromRGB(240, 205, 100),
	Green = Color3.fromRGB(120, 210, 150),
	Blue = Color3.fromRGB(110, 170, 250),
	Purple = Color3.fromRGB(175, 140, 250),
	Pink = Color3.fromRGB(240, 140, 190),
	Grey = Color3.fromRGB(150, 150, 156),
	Gray = Color3.fromRGB(150, 150, 156),
	White = Color3.fromRGB(235, 235, 240),
}

function Tab:Paragraph(input)
	local options = normalizeOptions(input, { Title = "Name", Desc = "Content", Description = "Content", Text = "Content" })

	local card = createCard(self, "Frame", 0)
	card.AutomaticSize = Enum.AutomaticSize.Y
	addPadding(card, 14, 14, 11, 12)
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 4),
		Parent = card,
	})

	local titleParent = card
	local copyButton
	if options.Copyable then
		titleParent = create("Frame", {
			Size = UDim2.new(1, 0, 0, 14),
			BackgroundTransparency = 1,
			LayoutOrder = 1,
			Parent = card,
		})
		copyButton = create("ImageButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 4, 0.5, 0),
			Size = UDim2.fromOffset(16, 16),
			BackgroundTransparency = 1,
			ImageColor3 = Theme.Muted,
			ScaleType = Enum.ScaleType.Fit,
			Parent = titleParent,
		})
		setIcon(copyButton, "copy")
		copyButton.MouseEnter:Connect(function()
			if IS_TOUCH then
				return
			end
			tween(copyButton, { ImageColor3 = Theme.Accent }, 0.12)
		end)
		copyButton.MouseLeave:Connect(function()
			tween(copyButton, { ImageColor3 = Theme.Muted }, 0.2)
		end)
	end

	createLabel({
		Name = "Title",
		Size = UDim2.new(1, options.Copyable and -24 or 0, 0, 14),
		Text = options.Name or "",
		LayoutOrder = 1,
		Parent = titleParent,
	})
	local content = createLabel({
		Name = "Content",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Text = options.Content or "",
		TextSize = 13,
		FontFace = Fonts.Regular,
		TextColor3 = Theme.Muted,
		TextWrapped = true,
		TextTruncate = Enum.TextTruncate.None,
		TextYAlignment = Enum.TextYAlignment.Top,
		LayoutOrder = 2,
		Parent = card,
	})

	local accent = options.Color
	if type(accent) == "string" then
		accent = Const.PARAGRAPH_COLORS[accent] or Theme[accent]
	end
	local titleLabel = titleParent:FindFirstChild("Title")
	if typeof(accent) == "Color3" then
		card.BackgroundColor3 = Theme.Surface2:Lerp(accent, 0.12)
		card:SetAttribute(Const.ATTR_NO_THEME, true)
		if titleLabel then
			titleLabel.TextColor3 = accent
			titleLabel:SetAttribute(Const.ATTR_NO_THEME, true)
		end
	end

	local image = options.Image or options.Icon
	if image ~= nil and image ~= "" and titleLabel then
		local size = math.clamp(tonumber(options.ImageSize) or 16, 12, 40)
		local row = create("Frame", {
			Name = "TitleRow",
			Size = UDim2.new(1, 0, 0, math.max(size, 14)),
			BackgroundTransparency = 1,
			LayoutOrder = 1,
			Parent = titleParent == card and card or titleParent,
		})
		local icon = create("ImageLabel", {
			Name = "ParagraphImage",
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromScale(0, 0.5),
			Size = UDim2.fromOffset(size, size),
			BackgroundTransparency = 1,
			ImageColor3 = typeof(accent) == "Color3" and accent or Theme.Accent,
			ScaleType = Enum.ScaleType.Fit,
			Parent = row,
		})
		setIcon(icon, image)
		titleLabel.Parent = row
		titleLabel.AnchorPoint = Vector2.new(0, 0.5)
		titleLabel.Position = UDim2.new(0, size + 8, 0.5, 0)
		titleLabel.Size = UDim2.new(1, -(size + 8) - (options.Copyable and 24 or 0), 0, 14)
	end

	local element = {}
	function element:Set(text)
		if type(text) == "table" then
			if text.Title ~= nil then
				element:SetTitle(text.Title)
			end
			text = text.Content or text.Desc
			if text == nil then
				return
			end
		end
		content.Text = text == nil and "" or tostring(text)
	end
	element.SetContent = element.Set
	element.SetDesc = element.Set
	function element:Get()
		return content.Text
	end

	if type(options.Buttons) == "table" and #options.Buttons > 0 then
		local row = create("Frame", {
			Name = "Buttons",
			Size = UDim2.new(1, 0, 0, 30),
			BackgroundTransparency = 1,
			LayoutOrder = 3,
			Parent = card,
		})
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = row,
		})
		create("UIPadding", { PaddingTop = UDim.new(0, 4), Parent = row })
		for index, definition in ipairs(options.Buttons) do
			if type(definition) == "table" then
				local primary = definition.Primary == true or definition.Variant == "Primary"
				local button = create("TextButton", {
					Size = UDim2.fromOffset(0, 26),
					AutomaticSize = Enum.AutomaticSize.X,
					BackgroundColor3 = primary and Theme.Accent or Theme.Surface,
					BorderSizePixel = 0,
					Text = "",
					AutoButtonColor = false,
					LayoutOrder = index,
					Parent = row,
				})
				button:SetAttribute(Const.ATTR_NO_DRAG, true)
				addCorner(button, UDim.new(0, 7))
				if not primary then
					addStroke(button)
				end
				local left = 10
				if definition.Icon then
					createIcon(button, definition.Icon, primary and Theme.AccentDark or Theme.Muted, UDim2.new(0, 9, 0.5, 0))
					left = 29
				end
				addPadding(button, left, 10)
				createLabel({
					Size = UDim2.fromOffset(0, 26),
					AutomaticSize = Enum.AutomaticSize.X,
					Text = tostring(definition.Title or definition.Name or "Button"),
					TextSize = 12,
					TextColor3 = primary and Theme.AccentDark or Theme.Text,
					TextTruncate = Enum.TextTruncate.None,
					Parent = button,
				})
				button.MouseButton1Click:Connect(function()
					if type(definition.Callback) == "function" then
						runProtected(("paragraph button \"%s\""):format(tostring(definition.Title or definition.Name)), definition.Callback)
					end
				end)
			end
		end
	end

	if copyButton then
		copyButton.MouseButton1Click:Connect(function()
			Nucleus:Copy(content.Text)
		end)
	end

	return registerElement(self, options, element, card, "Paragraph")
end

Const.BUTTON_STYLES = {
	Primary = "Accent",
	Danger = "Error",
}

function Tab:Button(input)
	local options = normalizeOptions(input, { Title = "Name", Description = "Desc" })

	local styleColorKey = Const.BUTTON_STYLES[options.Style]
	local styled = styleColorKey ~= nil
	local height = options.Desc and Const.ROW_HEIGHT_DESC or Const.ROW_HEIGHT
	local card, stroke = createCard(self, "TextButton", height)
	card.ClipsDescendants = true

	if styled then
		card.BackgroundColor3 = Theme[styleColorKey]
		card.BackgroundTransparency = 0.12
		stroke.Color = Theme[styleColorKey]
		stroke.Transparency = 0.4
		card.MouseEnter:Connect(function()
			if IS_TOUCH then
				return
			end
			tween(card, { BackgroundTransparency = 0 }, 0.12)
			tween(stroke, { Transparency = 0 }, 0.12)
		end)
		card.MouseLeave:Connect(function()
			tween(card, { BackgroundTransparency = 0.12 }, 0.25)
			tween(stroke, { Transparency = 0.4 }, 0.25)
		end)
	else
		bindHoverStroke(card, stroke)
	end

	local iconOffset = 0
	if options.Icon then
		createIcon(card, options.Icon, styled and Theme.AccentDark or Theme.Accent, UDim2.new(0, 14, 0.5, 0))
		iconOffset = 26
	end

	local titleLabel, descLabel = createTitleBlock(card, options.Name or "Button", options.Desc, 30)
	for _, label in ipairs({ titleLabel, descLabel }) do
		if iconOffset > 0 then
			label.Position += UDim2.fromOffset(iconOffset, 0)
			label.Size -= UDim2.fromOffset(iconOffset, 0)
		end
		if styled then
			label.TextColor3 = Theme.AccentDark
		end
	end

	createIcon(card, "mouse-pointer-click", styled and Theme.AccentDark or Theme.Muted, UDim2.new(1, -30, 0.5, 0))

	local element = {}
	local baseTitle = titleLabel.Text
	local baseColor = titleLabel.TextColor3
	local armed = false
	local armGeneration = 0
	local confirmText = type(options.Confirm) == "string" and options.Confirm or "Click again to confirm"

	local function disarm()
		armed = false
		armGeneration += 1
		titleLabel.Text = baseTitle
		tween(titleLabel, { TextColor3 = baseColor }, 0.2)
	end

	local function activate()
		if element.Locked or element._destroyed then
			return
		end
		ripple(card, styled and Theme.AccentDark or Theme.Accent)
		if options.Confirm and not armed then
			armed = true
			armGeneration += 1
			local generation = armGeneration
			titleLabel.Text = confirmText
			tween(titleLabel, { TextColor3 = styled and Theme.AccentDark or Theme.Warning }, 0.15)
			task.delay(options.ConfirmTimeout or 2.5, function()
				if armed and armGeneration == generation then
					disarm()
				end
			end)
			return
		end
		if armed then
			disarm()
		end
		safeCall(options.Callback)
	end
	card.MouseButton1Click:Connect(activate)

	local window = self.Window
	local buttonKey = toKeyCode(options.Keybind)
	local keyChip = createLabel({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -44, 0.5, 0),
		Size = UDim2.fromOffset(0, 18),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = "",
		TextSize = 12,
		TextColor3 = styled and Theme.AccentDark or Theme.Muted,
		TextTruncate = Enum.TextTruncate.None,
		Visible = false,
		Parent = card,
	})
	local function renderKey()
		keyChip.Visible = buttonKey ~= nil
		keyChip.Text = buttonKey and ("[" .. keyDisplayName(buttonKey) .. "]") or ""
		setTitleReserve(titleLabel, descLabel, 30 + (buttonKey and (keyChip.TextBounds.X + 14) or 0))
	end
	keyChip:GetPropertyChangedSignal("TextBounds"):Connect(renderKey)
	if window then
		window:_listen("Began", function(inputObject, gameProcessed)
			if gameProcessed or buttonKey == nil or inputObject.KeyCode ~= buttonKey then
				return
			end
			if UserInputService:GetFocusedTextBox() then
				return
			end
			activate()
		end, element)
		window:_registerKeybind({
			Name = options.Name or "Button",
			Element = element,
			GetKey = function()
				return buttonKey
			end,
			GetActive = function()
				return false
			end,
		})
	end
	renderKey()

	function element:SetKeybind(key)
		buttonKey = toKeyCode(key)
		renderKey()
	end
	function element:GetKeybind()
		return buttonKey
	end
	function element:Press()
		activate()
	end

	function element:SetText(text)
		baseTitle = tostring(text)
		if not armed then
			titleLabel.Text = baseTitle
		end
	end
	element.SetTitle = element.SetText

	return registerElement(self, options, element, card, "Button")
end

function Tab:Toggle(input)
	local options, card, stroke, _, titleLabel, descLabel = createRowElement(self, input, {
		Title = "Name",
		Description = "Desc",
		CurrentValue = "Default",
		Value = "Default",
	}, "TextButton", 56, "Toggle")

	local trackWidth = IS_TOUCH and 36 or 32
	local knobSize = IS_TOUCH and 14 or 12

	local isCheckbox = options.Type == "Checkbox" or options.Style == "Checkbox"
	local boxSize = IS_TOUCH and 20 or 18
	local track = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = isCheckbox and UDim2.fromOffset(boxSize, boxSize) or (IS_TOUCH and UDim2.fromOffset(36, 20) or UDim2.fromOffset(32, 18)),
		BackgroundColor3 = Theme.Surface3,
		BorderSizePixel = 0,
		Parent = card,
	})
	addCorner(track, isCheckbox and UDim.new(0, 5) or UDim.new(1, 0))
	addStroke(track, Theme.Stroke)
	addInnerShadow(track, 0.62, 0.6)
	local checkIcon
	if isCheckbox then
		trackWidth = boxSize
		checkIcon = create("ImageLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(boxSize - 6, boxSize - 6),
			BackgroundTransparency = 1,
			ImageColor3 = Theme.AccentDark,
			ImageTransparency = 1,
			ZIndex = 2,
			Parent = track,
		})
		setIcon(checkIcon, "check")
	end

	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(knobSize, knobSize),
		BackgroundColor3 = Theme.Muted,
		BorderSizePixel = 0,
		Parent = track,
	})
	addCorner(knob, UDim.new(1, 0))

	local element = { Value = options.Default == true }

	local function render(animated)
		local on = element.Value
		local duration = animated and 0.25 or 0
		if isCheckbox then
			knob.Visible = false
			tween(track, { BackgroundColor3 = on and Theme.Accent or Theme.Surface3 }, duration * 0.6)
			tween(checkIcon, { ImageTransparency = on and 0 or 1 }, duration * 0.6)
			return
		end
		tween(track, { BackgroundColor3 = on and Theme.Accent or Theme.Surface3 }, duration)
		tween(knob, {
			Position = on and UDim2.new(0, trackWidth - 3 - knobSize, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
		}, duration, Enum.EasingStyle.Back)
		tween(knob, { BackgroundColor3 = on and Theme.AccentDark or Theme.Muted }, duration)

		if animated then

			tween(knob, { Size = UDim2.fromOffset(knobSize + 4, knobSize - 2) }, 0.08)
			task.delay(0.08, function()
				tween(knob, { Size = UDim2.fromOffset(knobSize, knobSize) }, 0.2, Enum.EasingStyle.Back)
			end)
		end
	end

	local clicking = false
	function element:Set(value, silent)
		value = value == true
		if value == element.Value then
			return
		end
		element.Value = value
		render(true)
		if not clicking then
			flashStroke(stroke)
		end
		if not silent then
			safeCall(options.Callback, value)
		end
	end

	function element:Get()
		return element.Value
	end

	render(false)

	card.MouseButton1Click:Connect(function()
		clicking = true
		element:Set(not element.Value)
		clicking = false
	end)

	local window = self.Window
	local toggleKey = toKeyCode(options.Keybind)
	local keyChip = createLabel({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -(14 + trackWidth + 10), 0.5, 0),
		Size = UDim2.fromOffset(0, 18),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = "",
		TextSize = 12,
		TextColor3 = Theme.Muted,
		TextTruncate = Enum.TextTruncate.None,
		Visible = false,
		Parent = card,
	})

	local function renderKey()
		keyChip.Visible = toggleKey ~= nil
		keyChip.Text = toggleKey and ("[" .. keyDisplayName(toggleKey) .. "]") or ""
		local chipWidth = toggleKey and (keyChip.TextBounds.X + 10) or 0
		setTitleReserve(titleLabel, descLabel, 56 + chipWidth)
	end
	keyChip:GetPropertyChangedSignal("TextBounds"):Connect(renderKey)

	function element:SetKeybind(key)
		toggleKey = toKeyCode(key)
		renderKey()
	end
	function element:GetKeybind()
		return toggleKey
	end

	window:_listen("Began", function(inputObject, gameProcessed)
		if gameProcessed or element.Locked or toggleKey == nil then
			return
		end
		if inputObject.KeyCode ~= toggleKey or UserInputService:GetFocusedTextBox() then
			return
		end
		element:Set(not element.Value)
	end, element)

	window:_registerKeybind({
		Name = options.Name or "Toggle",
		Element = element,
		GetKey = function()
			return toggleKey
		end,
		GetActive = function()
			return element.Value
		end,
	})

	renderKey()

	local registered = registerElement(self, options, element, card, "Toggle")
	if type(options.Loop) == "function" then
		local loopHandle
		local function syncLoop(value)
			if value == true and not (loopHandle and loopHandle.Running) then
				loopHandle = window:Loop(options.Loop, options.LoopDelay or options.Delay, options.Name or "Toggle")
			elseif value ~= true and loopHandle then
				loopHandle:Stop()
				loopHandle = nil
			end
		end
		local baseSet = element.Set
		function element:Set(value, silent)
			baseSet(self, value, silent)
			syncLoop(element.Value)
		end
		table.insert(element._listeners, function()
			syncLoop(false)
		end)
		task.defer(function()
			if not element._destroyed then
				syncLoop(element.Value)
			end
		end)
	end
	if options.MobileButton and (IS_TOUCH or options.MobileButton == "Always") then
		window:FloatingButton({ Title = options.Name or "Toggle", Icon = options.MobileIcon, Toggle = element })
	end
	if element.Value then
		safeCall(options.Callback, true)
	end
	return registered
end

function Tab:Slider(input)
	local options = normalizeOptions(input, {
		Title = "Name",
		Description = "Desc",
		CurrentValue = "Default",
		Value = "Default",
		Increment = "Step",
	})

	local minimum = math.min(tonumber(options.Min) or 0, tonumber(options.Max) or 100)
	local maximum = math.max(tonumber(options.Min) or 0, tonumber(options.Max) or 100)
	local step = tonumber(options.Step) or 1
	local suffix = options.Suffix or ""
	local stepper = createStepper(minimum, maximum, step)
	local window = self.Window

	local height = Const.ROW_HEIGHT_DESC + 4 + (options.Desc and 18 or 0)
	local card, stroke = createCard(self, "Frame", height)
	bindHoverStroke(card, stroke)

	createLabel({
		Name = "Title",
		Position = UDim2.fromOffset(14, 10),
		Size = UDim2.new(1, -120, 0, 18),
		Text = options.Name or "Slider",
		Parent = card,
	})
	if options.Desc then
		createLabel({
			Name = "Desc",
			Position = UDim2.fromOffset(14, 28),
			Size = UDim2.new(1, -28, 0, 17),
			Text = options.Desc,
			TextSize = 13,
			FontFace = Fonts.Regular,
			TextColor3 = Theme.Muted,
			Parent = card,
		})
	end

	local chip = create("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 8),
		Size = UDim2.fromOffset(40, 22),
		BackgroundColor3 = Theme.Surface,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = card,
	})
	addCorner(chip, UDim.new(0, 6))
	local chipStroke = addStroke(chip)

	local valueLabel = createLabel({
		Size = UDim2.new(1, 0, 1, 0),
		TextSize = 13,
		TextColor3 = Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextTruncate = Enum.TextTruncate.None,
		Parent = chip,
	})

	local valueBox = create("TextBox", {
		Position = UDim2.fromOffset(9, 0),
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		Text = "",
		TextColor3 = Theme.Text,
		TextSize = 13,
		FontFace = Fonts.Medium,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		Visible = false,
		Parent = chip,
	})
	create("UISizeConstraint", {
		MinSize = Vector2.new(14, 0),
		Parent = valueBox,
	})

	local suffixLabel = createLabel({
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = suffix,
		TextSize = 13,
		TextColor3 = Theme.Accent,
		TextTruncate = Enum.TextTruncate.None,
		Visible = false,
		Parent = chip,
	})

	local chipButton = create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 2,
		Parent = chip,
	})

	local editing = false
	local function fitChip(instant)
		local width
		if editing then
			local boxWidth = valueBox.AbsoluteSize.X / window.Scale.Scale
			width = 9 + boxWidth + suffixLabel.TextBounds.X + 9
			suffixLabel.Position = UDim2.fromOffset(9 + boxWidth, 0)
		else
			width = valueLabel.TextBounds.X + 18
		end
		width = math.max(width, 36)
		if instant then
			chip.Size = UDim2.fromOffset(width, 22)
		else
			tween(chip, { Size = UDim2.fromOffset(width, 22) }, 0.2)
		end
	end

	valueLabel:GetPropertyChangedSignal("TextBounds"):Connect(function()
		if not editing then
			fitChip(false)
		end
	end)
	valueBox:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if editing then
			fitChip(false)
		end
	end)

	local track = create("Frame", {
		Position = UDim2.new(0, 14, 0, height - 16),
		Size = UDim2.new(1, -28, 0, 5),
		BackgroundColor3 = Theme.Surface3,
		BorderSizePixel = 0,
		Parent = card,
	})
	addCorner(track, UDim.new(1, 0))
	addInnerShadow(track, 0.6, 1)

	local fill = create("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Parent = track,
	})
	addCorner(fill, UDim.new(1, 0))

	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(12, 12),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = track,
	})
	addCorner(knob, UDim.new(1, 0))

	local hitArea = create("TextButton", {
		Position = UDim2.new(0, 8, 0, height - (IS_TOUCH and 35 or 29)),
		Size = UDim2.new(1, -16, 0, IS_TOUCH and 38 or 26),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 4,
		Parent = card,
	})

	local element = {
		Value = math.clamp(tonumber(options.Default) or minimum, minimum, maximum),
	}
	local dragging = false

	chipButton.MouseEnter:Connect(function()
		if IS_TOUCH then
			return
		end
		tween(chipStroke, { Color = Theme.StrokeHover }, 0.12)
	end)
	chipButton.MouseLeave:Connect(function()
		if not valueBox:IsFocused() then
			tween(chipStroke, { Color = Theme.Stroke }, 0.2)
		end
	end)

	chipButton.MouseButton1Click:Connect(function()
		editing = true
		valueBox.Text = stepper.format(element.Value)
		valueLabel.Visible = false
		valueBox.Visible = true
		suffixLabel.Visible = suffix ~= ""
		chipButton.Visible = false
		tween(chipStroke, { Color = Theme.StrokeHover }, 0.12)
		valueBox:CaptureFocus()
		task.defer(fitChip, false)
	end)

	valueBox.FocusLost:Connect(function()
		local typed = tonumber(valueBox.Text)
		editing = false
		valueBox.Visible = false
		suffixLabel.Visible = false
		valueLabel.Visible = true
		chipButton.Visible = true
		tween(chipStroke, { Color = Theme.Stroke }, 0.2)
		if typed then
			element:Set(typed)
		end
		fitChip(false)
	end)

	hitArea.MouseEnter:Connect(function()
		if IS_TOUCH then
			return
		end
		if not dragging then
			tween(knob, { Size = UDim2.fromOffset(14, 14) }, 0.15, Enum.EasingStyle.Back)
		end
	end)
	hitArea.MouseLeave:Connect(function()
		if not dragging then
			tween(knob, { Size = UDim2.fromOffset(12, 12) }, 0.2)
		end
	end)

	local snap = stepper.snap

	local function getAlpha()
		if maximum - minimum == 0 then
			return 0
		end
		return (element.Value - minimum) / (maximum - minimum)
	end

	local function moveTo(alpha, duration, style)
		style = style or Enum.EasingStyle.Linear
		tween(fill, { Size = UDim2.new(alpha, 0, 1, 0) }, duration, style)
		tween(knob, { Position = UDim2.new(alpha, 0, 0.5, 0) }, duration, style)
	end

	local function render(duration, style)
		moveTo(getAlpha(), duration, style)
		valueLabel.Text = stepper.format(element.Value) .. suffix
	end

	local function renderWithNudge(previousAlpha)
		local alpha = getAlpha()
		local trackWidth = math.max(track.AbsoluteSize.X, 1)
		local nudge = (alpha >= previousAlpha and 1 or -1) * (5 / trackWidth)
		moveTo(math.clamp(alpha + nudge, 0, 1), 0.22, Enum.EasingStyle.Quint)
		task.delay(0.22, function()
			if not dragging then
				moveTo(getAlpha(), 0.18, Enum.EasingStyle.Quint)
			end
		end)
		valueLabel.Text = stepper.format(element.Value) .. suffix
	end

	local function pulseKnob()
		tween(knob, { Size = UDim2.fromOffset(14, 12) }, 0.08)
		task.delay(0.1, function()
			tween(knob, { Size = UDim2.fromOffset(12, 12) }, 0.25, Enum.EasingStyle.Quint)
		end)
	end

	function element:Set(value, silent)
		value = snap(tonumber(value) or minimum)
		if value == element.Value then
			return
		end
		local previousAlpha = getAlpha()
		element.Value = value
		if dragging then
			render(0.05)
		else
			renderWithNudge(previousAlpha)
			pulseKnob()
			flashStroke(stroke)
		end
		if not silent then
			safeCall(options.Callback, value)
		end
	end

	function element:Get()
		return element.Value
	end

	function element:SetMin(newMin)
		return element:SetRange(newMin, maximum)
	end

	function element:SetMax(newMax)
		return element:SetRange(minimum, newMax)
	end

	function element:SetRange(newMin, newMax, newStep)
		minimum = math.min(tonumber(newMin) or minimum, tonumber(newMax) or maximum)
		maximum = math.max(tonumber(newMin) or minimum, tonumber(newMax) or maximum)
		step = tonumber(newStep) or step
		stepper = createStepper(minimum, maximum, step)
		snap = stepper.snap
		element.Value = snap(element.Value)
		render(0.2, Enum.EasingStyle.Quint)
	end

	local function setFromScreenX(x)
		local width = track.AbsoluteSize.X
		if width <= 0 then
			return
		end
		local alpha = math.clamp((x - track.AbsolutePosition.X) / width, 0, 1)
		element:Set(minimum + (maximum - minimum) * alpha)
	end

	hitArea.InputBegan:Connect(function(inputObject)
		if isPress(inputObject) and not element.Locked then
			dragging = true
			tween(knob, { Size = UDim2.fromOffset(16, 16) }, 0.15, Enum.EasingStyle.Back)
			setFromScreenX(getMousePosition().X)
		end
	end)

	window:_listen("Changed", function(inputObject)
		if dragging and isMove(inputObject) then
			setFromScreenX(getMousePosition().X)
		end
	end, element)

	window:_listen("Ended", function(inputObject)
		if dragging and isPress(inputObject) then
			dragging = false
			tween(knob, { Size = UDim2.fromOffset(12, 12) }, 0.2)
			safeCall(options.OnRelease, element.Value)
		end
	end, element)

	element.Value = snap(element.Value)
	render(0)
	task.defer(fitChip, true)

	return registerElement(self, options, element, card, "Slider")
end

Const.DROPDOWN_CHIP_MAX_TEXT = 146

function Tab:Dropdown(input)
	local options = normalizeOptions(input, {
		Title = "Name",
		Description = "Desc",
		CurrentOption = "Default",
		Value = "Default",
		MultipleOptions = "Multi",
		Values = "Options",
	})

	local multi = options.Multi == true
	if multi and type(options.Default) ~= "table" and options.Default ~= nil then
		options.Default = { options.Default }
	elseif not multi and type(options.Default) == "table" then
		options.Default = options.Default[1]
	end

	local optionList = table.clone(options.Options or {})
	local placeholder = options.Placeholder or "None"
	local searchThreshold = options.SearchAfter or 6

	local _, card, stroke, headerHeight = createRowElement(self, options, {}, "Frame")
	card.ClipsDescendants = true

	local header = create("TextButton", {
		Size = UDim2.new(1, 0, 0, headerHeight),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = card,
	})
	local titleLabel, descLabel = createTitleBlock(header, options.Name or "Dropdown", options.Desc, 180)

	local chip = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(60, Const.CHIP_HEIGHT),
		BackgroundColor3 = Theme.Surface,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = header,
	})
	addCorner(chip, UDim.new(0, 6))
	local chipStroke = addStroke(chip)

	local selectionLabel = createLabel({
		Position = UDim2.fromOffset(10, 0),
		Size = UDim2.new(1, -34, 1, 0),
		TextColor3 = Theme.Muted,
		TextSize = 13,
		TextTruncate = Enum.TextTruncate.None,
		ClipsDescendants = true,
		Parent = chip,
	})
	local chevron = createChevron(chip, 1, -6)

	local measureLabel = createLabel({
		Position = UDim2.fromOffset(0, 1000),
		Size = UDim2.fromOffset(0, Const.CHIP_HEIGHT),
		AutomaticSize = Enum.AutomaticSize.X,
		TextSize = 13,
		TextTransparency = 1,
		TextTruncate = Enum.TextTruncate.None,
		Parent = chip,
	})
	local fullText = ""

	local function truncatedSelection()
		measureLabel.Text = fullText
		if measureLabel.TextBounds.X <= Const.DROPDOWN_CHIP_MAX_TEXT then
			return fullText
		end
		local length = utf8.len(fullText)
		local function prefix(count)
			if not length then
				return fullText:sub(1, count)
			end
			return fullText:sub(1, (utf8.offset(fullText, count + 1) or #fullText + 1) - 1)
		end
		local low, high = 0, (length or #fullText) - 1
		while low < high do
			local mid = math.ceil((low + high) / 2)
			measureLabel.Text = prefix(mid) .. ".."
			if measureLabel.TextBounds.X <= Const.DROPDOWN_CHIP_MAX_TEXT then
				low = mid
			else
				high = mid - 1
			end
		end
		return prefix(low) .. ".."
	end

	local function fitChip(instant)
		local width = math.clamp(selectionLabel.TextBounds.X + 10 + 34, 60, 190)
		setTitleReserve(titleLabel, descLabel, width + 20)
		if instant then
			chip.Size = UDim2.fromOffset(width, Const.CHIP_HEIGHT)
		else
			tween(chip, { Size = UDim2.fromOffset(width, Const.CHIP_HEIGHT) }, 0.2)
		end
	end
	selectionLabel:GetPropertyChangedSignal("TextBounds"):Connect(function()
		fitChip(false)
	end)

	local listHolder = create("Frame", {
		Position = UDim2.new(0, 10, 0, headerHeight),
		Size = UDim2.new(1, -20, 0, 0),
		BackgroundTransparency = 1,
		Parent = card,
	})
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 4),
		Parent = listHolder,
	})

	local element = { Open = false }
	local selected = {}
	local rows = {}
	local searchQuery = ""
	local openGeneration = 0

	local searchFrame = create("Frame", {
		Size = UDim2.new(1, 0, 0, Const.OPTION_HEIGHT),
		BackgroundColor3 = Theme.Surface,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		LayoutOrder = 0,
		Visible = false,
		Parent = listHolder,
	})
	addCorner(searchFrame, UDim.new(0, 6))
	local searchStroke = addStroke(searchFrame, Theme.Stroke, 1)
	local _, searchIcon = createIcon(searchFrame, "search", Theme.Muted, UDim2.new(0, 10, 0.5, 0))
	searchIcon.Parent.Size = UDim2.fromOffset(14, 14)
	searchIcon.ImageTransparency = 1
	local searchBox = create("TextBox", {
		Position = UDim2.fromOffset(32, 0),
		Size = UDim2.new(1, -40, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		PlaceholderText = "Search",
		PlaceholderColor3 = Theme.Muted,
		TextColor3 = Theme.Text,
		TextSize = 13,
		FontFace = Fonts.Regular,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		TextTransparency = 1,
		Parent = searchFrame,
	})

	local function matchesSearch(option)
		return searchQuery == "" or string.find(string.lower(tostring(option)), searchQuery, 1, true) ~= nil
	end

	if multi then
		for _, option in ipairs(options.Default or {}) do
			selected[option] = true
		end
	elseif options.Default ~= nil then
		selected[options.Default] = true
	end

	local function getSelection()
		if multi then
			local result = {}
			for _, option in ipairs(optionList) do
				if selected[option] then
					table.insert(result, option)
				end
			end
			return result
		end
		for _, option in ipairs(optionList) do
			if selected[option] then
				return option
			end
		end
		return nil
	end

	local function renderSelection()
		local selection = getSelection()
		if multi then
			local names = {}
			for index, option in ipairs(selection) do
				names[index] = tostring(option)
			end
			fullText = #names > 0 and table.concat(names, ", ") or placeholder
		else
			fullText = selection ~= nil and tostring(selection) or placeholder
		end
		selectionLabel.Text = truncatedSelection()

		for option, row in pairs(rows) do
			local on = selected[option] == true
			if row.On ~= on then
				row.On = on
				tween(row.Label, { TextColor3 = on and Theme.Text or Theme.Muted }, 0.15)
				if element.Open then
					tween(row.Check, { ImageTransparency = on and 0 or 1 }, 0.15)
					tween(row.CheckScale, { Scale = on and 1 or 0.6 }, on and 0.3 or 0.15,
						on and Enum.EasingStyle.Back or Enum.EasingStyle.Quint)
				end
			end
		end
	end

	local function visibleOptionCount()
		local count = 0
		for _, option in ipairs(optionList) do
			if matchesSearch(option) then
				count += 1
			end
		end
		return count
	end

	local function applySearch()
		for option, row in pairs(rows) do
			row.Frame.Visible = matchesSearch(option)
		end
	end

	local function openHeight()
		local count = visibleOptionCount() + (searchFrame.Visible and 1 or 0)
		return headerHeight + count * (Const.OPTION_HEIGHT + 4) + 8
	end

	local function fadeRow(row, open)
		if not row.Stroke then
			row.Stroke = addStroke(row.Frame, Theme.Stroke, 1)
		end
		local showCheck = open and row.On
		tween(row.Check, { ImageTransparency = showCheck and 0 or 1 }, 0.18)
		row.CheckScale.Scale = showCheck and 1 or 0.6
		tween(row.Label, { TextTransparency = open and 0 or 1 }, 0.18)
		tween(row.Stroke, { Transparency = open and 0 or 1 }, 0.18)
		tween(row.Frame, { BackgroundTransparency = open and 0 or 1 }, 0.18)
	end

	local function setOpen(open)
		element.Open = open
		searchFrame.Visible = #optionList > searchThreshold
		if not open then
			searchQuery = ""
			searchBox.Text = ""
			searchBox:ReleaseFocus()
			applySearch()
		end

		tween(card, { Size = UDim2.new(1, 0, 0, open and openHeight() or headerHeight) }, 0.3, Enum.EasingStyle.Quint)
		tween(searchFrame, { BackgroundTransparency = open and 0 or 1 }, 0.2)
		tween(searchStroke, { Transparency = open and 0 or 1 }, 0.2)
		tween(searchBox, { TextTransparency = open and 0 or 1 }, 0.2)
		tween(searchIcon, { ImageTransparency = open and 0 or 1 }, 0.2)
		chevron:Set(open)
		tween(chipStroke, { Color = open and Theme.StrokeHover or Theme.Stroke }, 0.2)

		openGeneration += 1
		local generation = openGeneration

		if open then

			task.spawn(function()
				local first = true
				for _, option in ipairs(optionList) do
					local row = rows[option]
					if row and row.Frame.Visible then
						if not first then
							task.wait(0.025)
							if openGeneration ~= generation or not element.Open then
								return
							end
						end
						first = false
						fadeRow(row, true)
					end
				end
			end)
		else

			local visibleRows = {}
			for _, option in ipairs(optionList) do
				local row = rows[option]
				if row and row.Frame.Visible then
					table.insert(visibleRows, row)
				end
			end
			task.spawn(function()
				for index = #visibleRows, 1, -1 do
					fadeRow(visibleRows[index], false)
					if index > 1 then
						task.wait(0.015)
						if openGeneration ~= generation or element.Open then
							return
						end
					end
				end
			end)
		end
	end

	local function buildRows()
		local positions = {}
		for index, option in ipairs(optionList) do
			positions[option] = index
		end

		for option, row in pairs(rows) do
			if not positions[option] then
				row.Frame:Destroy()
				rows[option] = nil
			end
		end

		for index, option in ipairs(optionList) do
			local existing = rows[option]
			if existing then
				existing.Frame.LayoutOrder = index
				continue
			end

			local rowButton = create("TextButton", {
				Size = UDim2.new(1, 0, 0, Const.OPTION_HEIGHT),
				BackgroundColor3 = Theme.Surface,
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
				LayoutOrder = index,
				Parent = listHolder,
			})
			addCorner(rowButton, UDim.new(0, 6))

			local check = create("ImageLabel", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -10, 0.5, 0),
				Size = UDim2.fromOffset(14, 14),
				BackgroundTransparency = 1,
				ImageColor3 = Theme.Accent,
				ImageTransparency = 1,
				ScaleType = Enum.ScaleType.Fit,
				Parent = rowButton,
			})
			setIcon(check, "check")
			local checkScale = create("UIScale", { Scale = 0.6, Parent = check })

			local label = createLabel({
				Position = UDim2.fromOffset(12, -1),
				Size = UDim2.new(1, -36, 1, 0),
				Text = tostring(option),
				TextSize = 13,
				TextColor3 = Theme.Muted,
				TextTransparency = 1,
				Parent = rowButton,
			})

			local row = {
				Frame = rowButton,
				Label = label,
				Check = check,
				CheckScale = checkScale,
				Stroke = nil,
				On = nil,
			}
			rows[option] = row

			rowButton.MouseEnter:Connect(function()
				if IS_TOUCH then
					return
				end
				tween(label, { TextColor3 = Theme.Text }, 0.15)
				if row.Stroke then
					tween(row.Stroke, { Color = Theme.StrokeHover }, 0.12)
				end
			end)
			rowButton.MouseLeave:Connect(function()
				tween(label, { TextColor3 = selected[option] and Theme.Text or Theme.Muted }, 0.2)
				if row.Stroke then
					tween(row.Stroke, { Color = Theme.Stroke }, 0.2)
				end
			end)

			rowButton.MouseButton1Click:Connect(function()
				if not element.Open then
					return
				end
				if selected[option] then
					selected[option] = nil
				else
					if not multi then
						selected = {}
					end
					selected[option] = true
				end
				renderSelection()
				safeCall(options.Callback, getSelection())
				if not multi and selected[option] then
					setOpen(false)
				end
			end)
		end

		applySearch()
		if element.Open then
			card.Size = UDim2.new(1, 0, 0, openHeight())
		end
	end

	function element:Set(value, silent)
		selected = {}
		if multi then
			for _, option in ipairs(type(value) == "table" and value or { value }) do
				selected[option] = true
			end
		elseif value ~= nil then
			selected[value] = true
		end
		renderSelection()
		flashStroke(stroke)
		if not silent then
			safeCall(options.Callback, getSelection())
		end
	end

	function element:Get()
		return getSelection()
	end

	function element:Select(value)
		return element:Set(value)
	end

	function element:Refresh(newOptions, keepSelection)
		optionList = table.clone(newOptions or {})
		if not keepSelection then
			selected = {}
		end
		buildRows()
		renderSelection()
		if element.Open then
			setOpen(true)
		end
	end

	function element:SetOpen(open)
		setOpen(open == true)
	end

	function element:GetOptions()
		return table.clone(optionList)
	end

	function element:Add(option)
		if table.find(optionList, option) then
			return
		end
		local newList = table.clone(optionList)
		table.insert(newList, option)
		element:Refresh(newList, true)
	end

	function element:Remove(option)
		local index = table.find(optionList, option)
		if not index then
			return
		end
		local newList = table.clone(optionList)
		table.remove(newList, index)
		local wasSelected = selected[option]
		selected[option] = nil
		element:Refresh(newList, true)
		if wasSelected then
			safeCall(options.Callback, getSelection())
		end
	end

	function element:Clear(silent)
		element:Set(multi and {} or nil, silent)
	end

	header.MouseButton1Click:Connect(function()
		setOpen(not element.Open)
	end)

	if options.Players then
		local function playerNames()
			local names = {}
			for _, player in ipairs(Players:GetPlayers()) do
				if not (options.ExcludeSelf and player == LocalPlayer) then
					table.insert(names, options.UseDisplayName and player.DisplayName or player.Name)
				end
			end
			table.sort(names, function(a, b)
				return string.lower(a) < string.lower(b)
			end)
			return names
		end
		optionList = playerNames()
		local function resync()
			task.defer(function()
				if not element._destroyed then
					element:Refresh(playerNames(), true)
				end
			end)
		end
		local joined = Players.PlayerAdded:Connect(resync)
		local left = Players.PlayerRemoving:Connect(resync)
		element._listeners = element._listeners or {}
		table.insert(element._listeners, function()
			joined:Disconnect()
			left:Disconnect()
		end)
	end

	searchBox.Focused:Connect(function()
		tween(searchIcon, { ImageColor3 = Theme.Text }, 0.15)
		tween(searchStroke, { Color = Theme.StrokeHover }, 0.15)
	end)
	searchBox.FocusLost:Connect(function()
		tween(searchIcon, { ImageColor3 = Theme.Muted }, 0.2)
		tween(searchStroke, { Color = Theme.Stroke }, 0.2)
	end)
	searchBox:GetPropertyChangedSignal("Text"):Connect(function()
		searchQuery = string.lower(searchBox.Text)
		applySearch()
		if element.Open then
			tween(card, { Size = UDim2.new(1, 0, 0, openHeight()) }, 0.2, Enum.EasingStyle.Quint)
		end
	end)

	buildRows()
	renderSelection()
	task.defer(fitChip, true)

	return registerElement(self, options, element, card, "Dropdown")
end

function Tab:Input(input)
	if type(input) == "table" and (input.MultiLine or input.Multiline) then
		return self:TextArea(input)
	end
	local options, card, stroke, _, titleLabel, descLabel = createRowElement(self, input, {
		Title = "Name",
		Description = "Desc",
		PlaceholderText = "Placeholder",
		CurrentValue = "Default",
		Value = "Default",
	}, "Frame", 160, "Input")

	local window = self.Window
	local hasIcon = options.Icon ~= nil
	local maxLength = tonumber(options.MaxLength)

	local box = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(170, 26),
		BackgroundColor3 = Theme.Surface,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = card,
	})
	addCorner(box, UDim.new(0, 6))
	local boxStroke = addStroke(box)
	addInnerShadow(box, 0.6, 0.45)

	if hasIcon then
		createIcon(box, options.Icon, Theme.Muted, UDim2.new(0, 8, 0.5, 0))
	end

	local function clampLength(text)
		text = tostring(text or "")
		if maxLength and #text > maxLength then
			return text:sub(1, maxLength)
		end
		return text
	end

	local textBox = create("TextBox", {
		Position = UDim2.fromOffset(hasIcon and 30 or 8, 0),
		Size = UDim2.new(1, hasIcon and -38 or -16, 1, 0),
		BackgroundTransparency = 1,
		Text = clampLength(options.Default),
		PlaceholderText = options.Placeholder or "",
		PlaceholderColor3 = Theme.Muted,
		TextColor3 = Theme.Text,
		TextSize = 14,
		FontFace = Fonts.Regular,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = options.ClearOnFocus == true,
		TextTruncate = Enum.TextTruncate.None,
		ClipsDescendants = true,
		Parent = box,
	})

	local focused = false
	local leftInset = (hasIcon and 30 or 8) + 8

	local function fitBox(instant)
		local cardWidth = card.AbsoluteSize.X / window.Scale.Scale
		local maxWidth = math.clamp(cardWidth - 14 - 110 - 20, 100, 200)
		local textWidth = textBox.TextBounds.X
		if #textBox.Text == 0 then
			textWidth = math.min(textBox.TextBounds.X, 90)
		end
		local width = math.clamp(textWidth + leftInset + 12, 90, maxWidth) + (focused and 8 or 0)
		width = math.min(width, maxWidth + 8)
		setTitleReserve(titleLabel, descLabel, width + 20)
		if instant then
			box.Size = UDim2.fromOffset(width, 26)
		else
			tween(box, { Size = UDim2.fromOffset(width, 26) }, 0.18)
		end
	end

	card:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		fitBox(true)
	end)

	textBox:GetPropertyChangedSignal("Text"):Connect(function()
		local clamped = clampLength(textBox.Text)
		if clamped ~= textBox.Text then
			textBox.Text = clamped
			return
		end
		fitBox(false)
		if textBox:IsFocused() then
			safeCall(options.OnChanged, textBox.Text)
		end
	end)
	textBox:GetPropertyChangedSignal("TextBounds"):Connect(function()
		fitBox(false)
	end)
	task.defer(fitBox, true)

	textBox.Focused:Connect(function()
		focused = true
		tween(boxStroke, { Color = Theme.StrokeHover }, 0.15)
		fitBox(false)
	end)

	textBox.FocusLost:Connect(function(enterPressed)
		focused = false
		tween(boxStroke, { Color = Theme.Stroke }, 0.15)
		fitBox(false)
		if options.Numeric and not tonumber(textBox.Text) then
			textBox.Text = ""
			return
		end
		safeCall(options.Callback, textBox.Text, enterPressed)
	end)

	local element = {}
	function element:Set(text, silent)
		textBox.Text = clampLength(text)
		flashStroke(stroke)
		if not silent then
			safeCall(options.Callback, textBox.Text, false)
		end
	end
	function element:Get()
		return textBox.Text
	end
	function element:SetPlaceholder(text)
		textBox.PlaceholderText = tostring(text)
	end
	function element:Focus()
		textBox:CaptureFocus()
	end

	return registerElement(self, options, element, card, "Input")
end

function Tab:Keybind(input)
	local options, card, stroke, _, titleLabel, descLabel = createRowElement(self, input, {
		Title = "Name",
		Description = "Desc",
		CurrentKeybind = "Default",
		Value = "Default",
	}, "Frame", 110, "Keybind")

	local window = self.Window
	options.Default = toKeyCode(options.Default)
	local holdMode = options.Mode == "Hold"
	local toggleMode = options.Mode == "Toggle"

	local chip = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(44, Const.CHIP_HEIGHT),
		BackgroundColor3 = Theme.Surface,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		ClipsDescendants = true,
		Parent = card,
	})
	addCorner(chip, UDim.new(0, 6))
	local chipStroke = addStroke(chip)

	local keyLabel = createLabel({
		Size = UDim2.new(1, 0, 1, 0),
		TextSize = 13,
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextTruncate = Enum.TextTruncate.None,
		Parent = chip,
	})

	local element = {
		Value = options.Default,
		Listening = false,
		Held = false,
		State = options.DefaultState == true,
	}

	local function fitChip(instant)
		local width = math.max(keyLabel.TextBounds.X + 20, 36)
		setTitleReserve(titleLabel, descLabel, width + 20)
		if instant then
			chip.Size = UDim2.fromOffset(width, Const.CHIP_HEIGHT)
		else
			tween(chip, { Size = UDim2.fromOffset(width, Const.CHIP_HEIGHT) }, 0.2)
		end
	end
	keyLabel:GetPropertyChangedSignal("TextBounds"):Connect(function()
		fitChip(false)
	end)

	local function render()
		keyLabel.Text = element.Listening and "..." or keyDisplayName(element.Value)
		tween(chipStroke, { Color = element.Listening and Theme.StrokeHover or Theme.Stroke }, 0.15)
		tween(keyLabel, { TextColor3 = element.Listening and Theme.Accent or Theme.Muted }, 0.15)
	end

	local function releaseHold()
		if element.Held then
			element.Held = false
			safeCall(options.Callback, false)
		end
	end

	function element:Set(keyCode, silent)
		local wasListening = element.Listening
		releaseHold()
		keyCode = toKeyCode(keyCode)
		element.Value = keyCode
		element.Listening = false
		render()
		if not wasListening then
			flashStroke(stroke)
		end
		if not silent then
			safeCall(options.OnChanged, keyCode)
		end
	end

	function element:Get()
		return element.Value
	end

	function element:GetState()
		if holdMode then
			return element.Held
		end
		return element.State
	end

	function element:SetState(state, silent)
		element.State = state == true
		if not silent then
			safeCall(options.Callback, element.State)
		end
	end

	chip.MouseButton1Click:Connect(function()
		element.Listening = not element.Listening
		render()
	end)

	window:_listen("Began", function(inputObject, gameProcessed)
		if inputObject.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end

		if element.Listening then
			if UserInputService:GetFocusedTextBox() then
				element.Listening = false
				render()
				return
			end

			window._consumedKey = inputObject.KeyCode
			window._consumedAt = os.clock()
			if inputObject.KeyCode == Enum.KeyCode.Escape then
				element.Listening = false
				render()
			elseif inputObject.KeyCode == Enum.KeyCode.Backspace or inputObject.KeyCode == Enum.KeyCode.Delete then
				element:Set(nil)
			else
				element:Set(inputObject.KeyCode)
			end
			return
		end

		if gameProcessed or element.Locked or element.Value == nil or inputObject.KeyCode ~= element.Value then
			return
		end

		if holdMode then
			element.Held = true
			safeCall(options.Callback, true)
		elseif toggleMode then
			element:SetState(not element.State)
		else
			safeCall(options.Callback, inputObject.KeyCode)
		end
	end, element)

	window:_registerKeybind({
		Name = options.Name or "Keybind",
		Element = element,
		GetKey = function()
			return element.Value
		end,
		GetActive = function()
			if holdMode then
				return element.Held
			elseif toggleMode then
				return element.State
			end
			return nil
		end,
	})

	if holdMode then
		window:_listen("Ended", function(inputObject)
			if inputObject.KeyCode == element.Value then
				releaseHold()
			end
		end, element)
	end

	render()
	task.defer(fitChip, true)

	return registerElement(self, options, element, card, "Keybind", "OnChanged")
end

local function colorToHex(color)
	return string.format("#%02X%02X%02X",
		math.floor(color.R * 255 + 0.5),
		math.floor(color.G * 255 + 0.5),
		math.floor(color.B * 255 + 0.5))
end

local function parseColor(value)
	if type(value) == "string" then
		local ok, color = pcall(Color3.fromHex, value)
		return ok and color or nil
	end
	if typeof(value) == "Color3" then
		return value
	end
	return nil
end

local function exemptFromTheme(instance)
	instance:SetAttribute(Const.ATTR_NO_THEME, true)
	return instance
end

function Tab:ColorPicker(input)
	local options, card, stroke, headerHeight = createRowElement(self, input, {
		Title = "Name",
		Description = "Desc",
		Color = "Default",
		CurrentValue = "Default",
		Value = "Default",
	}, "Frame")
	card.ClipsDescendants = true

	local header = create("TextButton", {
		Size = UDim2.new(1, 0, 0, headerHeight),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = card,
	})
	createTitleBlock(header, options.Name or "Color", options.Desc, 90)

	local swatch = exemptFromTheme(create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -34, 0.5, 0),
		Size = UDim2.fromOffset(36, 20),
		BorderSizePixel = 0,
		Parent = header,
	}))
	addCorner(swatch, UDim.new(0, 6))
	addStroke(swatch, Theme.Stroke)

	local chevron = createChevron(header, 1, -12)

	local panel = create("Frame", {
		Position = UDim2.fromOffset(14, headerHeight + 2),
		Size = UDim2.new(1, -28, 0, 156),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = card,
	})

	local svSquare = exemptFromTheme(create("TextButton", {
		Size = UDim2.new(1, -30, 0, 110),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		ClipsDescendants = true,
		Parent = panel,
	}))
	addCorner(svSquare, UDim.new(0, 6))
	local svHueGradient = create("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.new(1, 0, 0)),
		Parent = svSquare,
	})

	local svDarken = exemptFromTheme(create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Parent = svSquare,
	}))
	create("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(1, 0),
		}),
		Rotation = 90,
		Parent = svDarken,
	})

	local svCursor = exemptFromTheme(create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(10, 10),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = svSquare,
	}))
	addCorner(svCursor, UDim.new(1, 0))
	addStroke(svCursor, Color3.new(1, 1, 1), 0, 2)

	local hueBar = exemptFromTheme(create("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(14, 110),
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		Parent = panel,
	}))
	addCorner(hueBar, UDim.new(0, 6))
	create("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
			ColorSequenceKeypoint.new(1 / 6, Color3.fromRGB(255, 255, 0)),
			ColorSequenceKeypoint.new(2 / 6, Color3.fromRGB(0, 255, 0)),
			ColorSequenceKeypoint.new(3 / 6, Color3.fromRGB(0, 255, 255)),
			ColorSequenceKeypoint.new(4 / 6, Color3.fromRGB(0, 0, 255)),
			ColorSequenceKeypoint.new(5 / 6, Color3.fromRGB(255, 0, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
		}),
		Rotation = 90,
		Parent = hueBar,
	})

	local hueCursor = exemptFromTheme(create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.fromOffset(18, 5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = hueBar,
	}))
	addCorner(hueCursor, UDim.new(1, 0))
	addStroke(hueCursor, Theme.AccentDark, 0.4)

	local hexFrame = create("Frame", {
		Position = UDim2.fromOffset(6, 122),
		Size = UDim2.fromOffset(118, 28),
		BackgroundColor3 = Theme.Surface,
		BorderSizePixel = 0,
		Parent = panel,
	})
	addCorner(hexFrame, UDim.new(0, 6))
	local hexStroke = addStroke(hexFrame)

	local hexBox = create("TextBox", {
		Position = UDim2.fromOffset(14, 0),
		Size = UDim2.new(1, -24, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		TextTruncate = Enum.TextTruncate.None,
		ClipsDescendants = false,
		TextColor3 = Theme.Text,
		TextSize = 13,
		FontFace = Fonts.Regular,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		Parent = hexFrame,
	})

	local rgbLabel = createLabel({
		Position = UDim2.fromOffset(134, 122),
		Size = UDim2.new(1, -134, 0, 28),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextSize = 13,
		FontFace = Fonts.Regular,
		TextColor3 = Theme.Muted,
		Parent = panel,
	})

	local element = { Open = false }

	local startColor = parseColor(options.Default) or Theme.Accent
	local hue, saturation, brightness = Color3.toHSV(startColor)
	local dragTarget

	local function render(duration)
		local color = Color3.fromHSV(hue, saturation, brightness)
		element.Value = color
		swatch.BackgroundColor3 = color
		svHueGradient.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromHSV(hue, 1, 1))
		tween(svCursor, { Position = UDim2.fromScale(saturation, 1 - brightness) }, duration, Enum.EasingStyle.Linear)
		tween(hueCursor, { Position = UDim2.new(0.5, 0, hue, 0) }, duration, Enum.EasingStyle.Linear)
		if not hexBox:IsFocused() then
			hexBox.Text = colorToHex(color)
		end
		rgbLabel.Text = string.format("RGB %d, %d, %d",
			math.floor(color.R * 255 + 0.5),
			math.floor(color.G * 255 + 0.5),
			math.floor(color.B * 255 + 0.5))
	end

	local function update(duration, silent)
		render(duration)
		if not silent then
			safeCall(options.Callback, element.Value)
		end
	end

	function element:Set(value, silent)
		local color = parseColor(value)
		if not color then
			log("ColorPicker:Set expects a Color3 or hex string")
			return
		end
		hue, saturation, brightness = Color3.toHSV(color)
		update(0.25, silent)
		flashStroke(stroke)
	end

	function element:Get()
		return element.Value
	end

	local function setOpen(open)
		element.Open = open
		tween(card, { Size = UDim2.new(1, 0, 0, open and headerHeight + 168 or headerHeight) }, 0.35, Enum.EasingStyle.Quint)
		chevron:Set(open)
		if open then
			panel.Visible = true
		else
			dragTarget = nil
			task.delay(0.35, function()
				if not element.Open then
					panel.Visible = false
				end
			end)
		end
	end

	function element:SetOpen(open)
		setOpen(open == true)
	end

	header.MouseButton1Click:Connect(function()
		setOpen(not element.Open)
	end)

	local function pickSV(point)
		saturation = math.clamp((point.X - svSquare.AbsolutePosition.X) / svSquare.AbsoluteSize.X, 0, 1)
		brightness = 1 - math.clamp((point.Y - svSquare.AbsolutePosition.Y) / svSquare.AbsoluteSize.Y, 0, 1)
		update(0.04)
	end

	local function pickHue(point)
		hue = math.clamp((point.Y - hueBar.AbsolutePosition.Y) / hueBar.AbsoluteSize.Y, 0, 0.999)
		update(0.04)
	end

	svSquare.InputBegan:Connect(function(inputObject)
		if isPress(inputObject) then
			dragTarget = "sv"
			tween(svCursor, { Size = UDim2.fromOffset(14, 14) }, 0.15, Enum.EasingStyle.Back)
			pickSV(getMousePosition())
		end
	end)

	hueBar.InputBegan:Connect(function(inputObject)
		if isPress(inputObject) then
			dragTarget = "hue"
			tween(hueCursor, { Size = UDim2.fromOffset(20, 7) }, 0.15, Enum.EasingStyle.Back)
			pickHue(getMousePosition())
		end
	end)

	local window = self.Window
	window:_listen("Changed", function(inputObject)
		if not dragTarget or not isMove(inputObject) then
			return
		end
		local point = getMousePosition()
		if dragTarget == "sv" then
			pickSV(point)
		else
			pickHue(point)
		end
	end, element)

	window:_listen("Ended", function(inputObject)
		if dragTarget and isPress(inputObject) then
			dragTarget = nil
			tween(svCursor, { Size = UDim2.fromOffset(10, 10) }, 0.2)
			tween(hueCursor, { Size = UDim2.fromOffset(18, 5) }, 0.2)
		end
	end, element)

	hexBox.Focused:Connect(function()
		tween(hexStroke, { Color = Theme.StrokeHover }, 0.15)
	end)
	hexBox.FocusLost:Connect(function()
		tween(hexStroke, { Color = Theme.Stroke }, 0.15)
		local r, g, b = hexBox.Text:match("^%s*#?(%x%x)(%x%x)(%x%x)%s*$")
		if r then
			element:Set(Color3.fromRGB(tonumber(r, 16), tonumber(g, 16), tonumber(b, 16)))
		else
			hexBox.Text = colorToHex(element.Value)
		end
	end)

	render(0)

	return registerElement(self, options, element, card, "ColorPicker")
end

Const.HOLD_DELAY = 0.4
Const.HOLD_REPEAT = 0.07

function Tab:Stepper(input)
	local options, card, stroke, _, titleLabel, descLabel = createRowElement(self, input, {
		Title = "Name",
		Description = "Desc",
		CurrentValue = "Default",
		Value = "Default",
		Increment = "Step",
	}, "Frame", 150, "Stepper")

	local window = self.Window
	local minimum = math.min(tonumber(options.Min) or 0, tonumber(options.Max) or 100)
	local maximum = math.max(tonumber(options.Min) or 0, tonumber(options.Max) or 100)
	local step = tonumber(options.Step) or 1
	local suffix = options.Suffix or ""
	local stepper = createStepper(minimum, maximum, step)

	local control = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(0, Const.CHIP_HEIGHT),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Theme.Surface,
		BorderSizePixel = 0,
		Parent = card,
	})
	addCorner(control, UDim.new(0, 6))
	local controlStroke = addStroke(control)
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Parent = control,
	})

	local function createStepButton(text, order)
		local button = create("TextButton", {
			Size = UDim2.fromOffset(Const.CHIP_HEIGHT, Const.CHIP_HEIGHT),
			BackgroundTransparency = 1,
			Text = text,
			TextColor3 = Theme.Muted,
			TextSize = 18,
			FontFace = Fonts.Medium,
			AutoButtonColor = false,
			LayoutOrder = order,
			Parent = control,
		})
		button.MouseEnter:Connect(function()
			if IS_TOUCH then
				return
			end
			tween(button, { TextColor3 = Theme.Accent }, 0.12)
		end)
		button.MouseLeave:Connect(function()
			tween(button, { TextColor3 = Theme.Muted }, 0.2)
		end)
		return button
	end

	local minusButton = createStepButton("−", 1)
	local valueLabel = createLabel({
		Size = UDim2.new(0, 30, 1, 0),
		TextSize = 13,
		TextColor3 = Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextTruncate = Enum.TextTruncate.None,
		LayoutOrder = 2,
		Parent = control,
	})
	local plusButton = createStepButton("+", 3)

	local function fitValue(instant)
		local width = math.max(valueLabel.TextBounds.X + 12, 30)
		if instant then
			valueLabel.Size = UDim2.new(0, width, 1, 0)
		else
			tween(valueLabel, { Size = UDim2.new(0, width, 1, 0) }, 0.2)
		end
	end
	valueLabel:GetPropertyChangedSignal("TextBounds"):Connect(function()
		fitValue(false)
	end)
	control:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		setTitleReserve(titleLabel, descLabel, control.AbsoluteSize.X / window.Scale.Scale + 20)
	end)

	local element = {
		Value = math.clamp(tonumber(options.Default) or minimum, minimum, maximum),
	}
	local stepping = false

	local function render()
		valueLabel.Text = stepper.format(element.Value) .. suffix
		tween(minusButton, { TextTransparency = element.Value <= minimum and 0.6 or 0 }, 0.15)
		tween(plusButton, { TextTransparency = element.Value >= maximum and 0.6 or 0 }, 0.15)
	end

	function element:Set(value, silent)
		value = stepper.snap(tonumber(value) or minimum)
		if value == element.Value then
			return
		end
		element.Value = value
		render()
		if not stepping then
			flashStroke(stroke)
		end
		if not silent then
			safeCall(options.Callback, value)
		end
	end

	function element:Get()
		return element.Value
	end

	local function nudge(direction)
		stepping = true
		element:Set(element.Value + direction * step)
		stepping = false
		tween(controlStroke, { Color = Theme.StrokeHover }, 0.08)
		task.delay(0.12, function()
			tween(controlStroke, { Color = Theme.Stroke }, 0.2)
		end)
	end

	local function bindRepeat(button, direction)
		local pressId, held = 0, false
		button.InputBegan:Connect(function(inputObject)
			if not isPress(inputObject) then
				return
			end
			pressId += 1
			local thisPress = pressId
			held = true
			nudge(direction)
			task.delay(Const.HOLD_DELAY, function()
				while held and pressId == thisPress and not element.Locked and not element._destroyed and button.Parent do
					nudge(direction)
					task.wait(Const.HOLD_REPEAT)
				end
			end)
		end)
		button.InputEnded:Connect(function(inputObject)
			if isPress(inputObject) then
				held = false
			end
		end)
		button.MouseLeave:Connect(function()
			held = false
		end)
	end

	bindRepeat(minusButton, -1)
	bindRepeat(plusButton, 1)

	element.Value = stepper.snap(element.Value)
	render()
	task.defer(fitValue, true)

	return registerElement(self, options, element, card, "Stepper")
end

function Tab:Progress(input)
	local options = normalizeOptions(input, {
		Title = "Name",
		Description = "Desc",
		CurrentValue = "Default",
		Value = "Default",
	})

	local card, stroke = createCard(self, "Frame", options.Desc and Const.ROW_HEIGHT_DESC + 10 or Const.ROW_HEIGHT + 10)
	bindHoverStroke(card, stroke)

	local top = options.Desc and (Const.ROW_HEIGHT_DESC - 38) / 2 - 2 or 12
	createLabel({
		Name = "Title",
		Position = UDim2.fromOffset(14, top),
		Size = UDim2.new(1, -110, 0, 18),
		Text = options.Name or "Progress",
		Parent = card,
	})
	if options.Desc then
		createLabel({
			Name = "Desc",
			Position = UDim2.fromOffset(14, top + 20),
			Size = UDim2.new(1, -110, 0, 17),
			Text = options.Desc,
			TextSize = 13,
			FontFace = Fonts.Regular,
			TextColor3 = Theme.Muted,
			Parent = card,
		})
	end

	local percentLabel = createLabel({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, top),
		Size = UDim2.fromOffset(90, 18),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextSize = 13,
		TextColor3 = Theme.Accent,
		Parent = card,
	})

	local track = create("Frame", {
		Position = UDim2.new(0, 14, 1, -16),
		Size = UDim2.new(1, -28, 0, 5),
		BackgroundColor3 = Theme.Surface3,
		BorderSizePixel = 0,
		Parent = card,
	})
	addCorner(track, UDim.new(1, 0))

	local fill = create("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = options.Color or Theme.Accent,
		BorderSizePixel = 0,
		Parent = track,
	})
	addCorner(fill, UDim.new(1, 0))

	local element = {
		Value = math.clamp(tonumber(options.Default) or 0, 0, 1),
	}
	local formatter = options.Format

	local function render(duration)
		local value = element.Value
		tween(fill, { Size = UDim2.new(value, 0, 1, 0) }, duration, Enum.EasingStyle.Quint)
		if type(formatter) == "function" then
			local ok, text = pcall(formatter, value)
			percentLabel.Text = ok and tostring(text) or ""
		else
			percentLabel.Text = string.format("%d%%", math.floor(value * 100 + 0.5))
		end
	end

	function element:Set(value, silent)
		value = math.clamp(tonumber(value) or 0, 0, 1)
		if value == element.Value then
			return
		end
		element.Value = value
		render(0.35)
		if not silent then
			safeCall(options.Callback, value)
		end
	end

	function element:Get()
		return element.Value
	end

	function element:SetColor(color)
		fill.BackgroundColor3 = color
	end

	render(0)

	return registerElement(self, options, element, card, "Progress")
end

function Tab:Group(input)
	local options = normalizeOptions(input, { Title = "Name", Description = "Desc" })
	local window = self.Window
	local headerHeight = options.Desc and Const.ROW_HEIGHT_DESC or Const.ROW_HEIGHT
	local open = not (options.Collapsed == true or options.Opened == false)

	local card, stroke = createCard(self, "Frame", headerHeight)
	card.BackgroundColor3 = Theme.Surface
	card.ClipsDescendants = true

	local header = create("TextButton", {
		Size = UDim2.new(1, 0, 0, headerHeight),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = card,
	})
	bindHoverStroke(header, stroke)

	local iconOffset = 0
	if options.Icon then
		createIcon(header, options.Icon, Theme.Accent, UDim2.new(0, 14, 0.5, 0))
		iconOffset = 26
	end
	local titleLabel, descLabel = createTitleBlock(header, options.Name or "Group", options.Desc, 40)
	for _, label in ipairs({ titleLabel, descLabel }) do
		label.Position += UDim2.fromOffset(iconOffset, 0)
		label.Size -= UDim2.fromOffset(iconOffset, 0)
	end
	local chevron = createChevron(header, 1, -14)

	local body = create("Frame", {
		Position = UDim2.fromOffset(10, headerHeight),
		Size = UDim2.new(1, -20, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = card,
	})
	local bodyLayout = create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		Parent = body,
	})

	local group = setmetatable({
		Name = options.Name or "Group",
		Window = window,
		List = body,
		Open = open,
		_order = 0,
		_rootTab = self._rootTab or self,
		_parentGroup = self._groupElement,
	}, Tab)
	group._groupElement = group

	local function targetHeight()
		if not group.Open then
			return headerHeight
		end
		local contentHeight = bodyLayout.AbsoluteContentSize.Y / window.Scale.Scale
		return headerHeight + (contentHeight > 0 and contentHeight + 10 or 0)
	end

	local animating = false
	local function fit(animated)
		if animated then
			animating = true
			tween(card, { Size = UDim2.new(1, 0, 0, targetHeight()) }, 0.3, Enum.EasingStyle.Quint)
			task.delay(0.3, function()
				animating = false
				card.Size = UDim2.new(1, 0, 0, targetHeight())
			end)
		elseif not animating then
			card.Size = UDim2.new(1, 0, 0, targetHeight())
		end
	end

	bodyLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		fit(false)
	end)

	function group:SetOpen(state)
		group.Open = state == true
		chevron:Set(group.Open)
		fit(true)
	end

	function group:ToggleOpen()
		group:SetOpen(not group.Open)
	end

	function group:SetTitle(text)
		group.Name = tostring(text)
		titleLabel.Text = group.Name
	end

	function group:Select()
		window:SelectTab(group._rootTab)
		if not group.Open then
			group:SetOpen(true)
		end
	end

	header.MouseButton1Click:Connect(function()
		group:SetOpen(not group.Open)
	end)

	chevron:Set(group.Open)
	task.defer(fit, false)

	return registerElement(self, options, group, card, "Group")
end

function Tab:ConfigManager(input)
	local options = normalizeOptions(input, {})
	local window = self.Window
	local manager = {}

	self:Section(options.Name or "Configs")

	local nameInput = self:Input({
		Name = "Config name",
		Placeholder = window.ConfigName,
		Callback = function(text, enterPressed)
			if enterPressed and #text > 0 then
				manager:Save(text)
			end
		end,
	})

	local configList = self:Dropdown({
		Name = "Saved configs",
		Options = window:ListConfigs(),
		Default = window.ConfigName,
		Callback = function(name)
			if name then
				nameInput:Set(name, true)
			end
		end,
	})

	function manager:Refresh()
		configList:Refresh(window:ListConfigs(), true)
	end

	function manager:Save(name)
		name = name or configList:Get() or window.ConfigName
		local ok, err = window:SaveConfig(name)
		manager:Refresh()
		if ok then
			configList:Set(window.ConfigName, true)
		end
		window:Notify({
			Title = ok and "Config saved" or "Save failed",
			Content = ok and window.ConfigName or tostring(err),
			Type = ok and "Success" or "Error",
			Duration = 3,
		})
	end

	function manager:Load(name)
		name = name or configList:Get()
		if not name then
			return
		end
		local ok, err = window:LoadConfig(name)
		window:Notify({
			Title = ok and "Config loaded" or "Load failed",
			Content = ok and name or tostring(err),
			Type = ok and "Success" or "Error",
			Duration = 3,
		})
	end

	function manager:Delete(name)
		name = name or configList:Get()
		if not name then
			return
		end
		local ok, err = window:DeleteConfig(name)
		manager:Refresh()
		window:Notify({
			Title = ok and "Config deleted" or "Delete failed",
			Content = ok and name or tostring(err),
			Type = ok and "Info" or "Error",
			Duration = 3,
		})
	end

	self:Button({
		Name = "Save",
		Desc = "Writes every flagged element to the selected name",
		Icon = "save",
		Style = "Primary",
		Callback = function()
			local typed = nameInput:Get()
			manager:Save(#typed > 0 and typed or nil)
		end,
	})

	self:Button({
		Name = "Load",
		Icon = "folder-open",
		Callback = function()
			manager:Load()
		end,
	})

	self:Button({
		Name = "Delete",
		Icon = "trash-2",
		Callback = function()
			local name = configList:Get()
			if not name then
				return
			end
			window:Confirm({
				Title = "Delete config",
				Content = "Remove " .. name .. "? This cannot be undone.",
				Icon = "trash-2",
				ConfirmText = "Delete",
				Callback = function()
					manager:Delete(name)
				end,
			})
		end,
	})

	self:Button({
		Name = "Export to clipboard",
		Desc = "Copy every setting as text to share or back up",
		Icon = "copy",
		Callback = function()
			local text = window:ExportConfig()
			if text then
				Nucleus:Copy(text)
			end
		end,
	})

	local importText = ""
	self:Input({
		Name = "Import config",
		Placeholder = "Paste config text",
		Callback = function(text)
			importText = text
		end,
	})

	self:Button({
		Name = "Apply imported config",
		Icon = "download",
		Callback = function()
			local ok, result = window:ImportConfig(importText)
			window:Notify({
				Title = ok and "Config imported" or "Import failed",
				Content = ok and ("Applied " .. result .. " settings.") or tostring(result),
				Type = ok and "Success" or "Error",
				Duration = 3,
			})
		end,
	})

	self:Button({
		Name = "Reset to defaults",
		Icon = "rotate-ccw",
		Style = "Danger",
		Callback = function()
			window:Confirm({
				Title = "Reset settings",
				Content = "Put every setting back to its default value?",
				Icon = "rotate-ccw",
				ConfirmText = "Reset",
				Callback = function()
					local count = window:ResetConfig()
					window:Notify({ Title = "Settings reset", Content = count .. " settings back to default.", Type = "Info", Duration = 3 })
				end,
			})
		end,
	})

	self:Toggle({
		Name = "Auto save",
		Desc = "Save whenever a flagged element changes",
		Default = window._autoSaveEnabled,
		Callback = function(enabled)
			window:SetAutoSave(enabled)
		end,
	})

	return manager
end

function Tab:ThemePicker(input)
	local options = normalizeOptions(input, { Title = "Name", Description = "Desc" })
	local userCallback = options.Callback
	return self:Dropdown({
		Name = options.Name or "Theme",
		Desc = options.Desc,
		Options = Nucleus:GetThemes(),
		Default = Nucleus.ThemeName,
		Flag = options.Flag,
		Callback = function(themeName)
			if themeName then
				Nucleus:SetTheme(themeName)
			end
			safeCall(userCallback, themeName)
		end,
	})
end

Const.KEY_TYPE_NAMES = {
	lifetime = "Lifetime",
	["1month"] = "Monthly",
	monthly = "Monthly",
	weekly = "Weekly",
	default = "Standard",
	free = "Free",
}

Const.KEY_DETAIL_LABELS = {
	Usage = "Usage",
	Discord = "Discord",
	HWID = "HWID",
}

local function readGlobal(key)
	local ok, value = pcall(function()
		local env = (type(getgenv) == "function" and getgenv()) or _G
		return env[key]
	end)
	if ok then
		return value
	end
	return nil
end

local function rawKeyData()
	local source = Nucleus._keySource
	if type(source) == "function" then
		local ok, data = pcall(source)
		if ok and type(data) == "table" then
			return data
		end
		if not Nucleus._keySourceWarned then
			Nucleus._keySourceWarned = true
			if ok then
				log("the Membership Data function should return a table, like { Type = \"lifetime\" }")
			else
				log("the Membership Data function failed: " .. tostring(data))
			end
		end
		return {}
	end
	return {
		Type = readGlobal("NEOX_KEY_TYPE"),
		Expiry = readGlobal("NEOX_KEY_EXPIRY"),
		Lifetime = readGlobal("NEOX_KEY_IS_LIFETIME"),
		Usage = readGlobal("NEOX_KEY_USAGE_COUNT"),
		Discord = readGlobal("NEOX_KEY_DISCORD"),
		HWID = readGlobal("NEOX_ACTIVE_HWID"),
	}
end

local function readKeyData()
	local data = rawKeyData()
	local rawType = data.Type
	if rawType ~= nil then
		rawType = tostring(rawType)
	end
	local expiry = tonumber(data.Expiry)
	local lifetime = data.Lifetime == true or rawType == "lifetime"
	local hasKey = rawType ~= nil or expiry ~= nil or lifetime
	if type(data.HasKey) == "boolean" then
		hasKey = data.HasKey
	end
	local premium = lifetime or rawType == "1month" or rawType == "monthly"
	if type(data.Premium) == "boolean" then
		premium = data.Premium
	end
	return data, {
		HasKey = hasKey,
		Premium = hasKey and premium,
		Type = rawType,
		Expiry = expiry,
		Lifetime = lifetime,
	}
end

local function getKeyStatus()
	local _, status = readKeyData()
	return {
		HasKey = status.HasKey,
		Premium = status.Premium,
		Type = status.Type,
		Expiry = status.Expiry,
	}
end
Nucleus._getKeyStatus = getKeyStatus

function Nucleus:SetKeySource(source)
	if source ~= nil and type(source) ~= "function" then
		log("SetKeySource needs a function that returns your key data, or nil to use the built-in key system")
		return false
	end
	Nucleus._keySource = source
	Nucleus._keySourceWarned = false
	for _, window in ipairs(Nucleus.Windows) do
		if window.KeyPanel and window.KeyPanel.Refresh then
			safeCall(window.KeyPanel.Refresh, window.KeyPanel)
		end
	end
	return true
end

local function formatDuration(seconds)
	seconds = math.max(0, math.floor(seconds))
	if seconds < 60 then
		return seconds .. "s"
	elseif seconds < 3600 then
		return string.format("%dm %02ds", seconds // 60, seconds % 60)
	elseif seconds < 86400 then
		return string.format("%dh %02dm", seconds // 3600, (seconds % 3600) // 60)
	end
	return string.format("%dd %dh", seconds // 86400, (seconds % 86400) // 3600)
end

local function createKeyPanel(window, parent, layoutOrder, input)
	local options = normalizeOptions(input, { Title = "Name" })
	if type(options.Data) == "function" then
		Nucleus._keySource = options.Data
		Nucleus._keySourceWarned = false
	elseif options.Data ~= nil then
		log("Membership Data should be a function that returns your key data")
	end
	local texts = type(options.Texts) == "table" and options.Texts or {}
	local function text(key, default)
		local value = texts[key]
		if value == nil then
			return default
		end
		return tostring(value)
	end
	local labels = type(options.Labels) == "table" and options.Labels or {}

	local function snapshot()
		local data, status = readKeyData()
		local names = options.TypeNames or Const.KEY_TYPE_NAMES
		local typeName
		if status.HasKey then
			typeName = status.Type ~= nil and (names[status.Type] or status.Type) or text("Active", "Active")
		else
			typeName = text("NoKeyBadge", "No key")
		end
		local result = {
			HasKey = status.HasKey,
			TypeName = tostring(typeName),
			Lifetime = status.Lifetime,
			Premium = status.Premium,
			Expiry = status.Expiry,
		}
		for key, value in pairs(data) do
			if result[key] == nil then
				result[key] = value
			end
		end
		return result
	end

	local card = create("Frame", {
		Name = "KeyPanel",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Surface2,
		BorderSizePixel = 0,
		LayoutOrder = layoutOrder,
		Parent = parent,
	})
	card:SetAttribute(Const.ATTR_NO_DRAG, true)
	styleCard(card)
	addPadding(card, 14, 14, 12, 12)
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		Parent = card,
	})

	local headerRow = create("Frame", {
		Size = UDim2.new(1, 0, 0, 20),
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = card,
	})
	createIcon(headerRow, options.Icon or "key-round", Theme.Accent, UDim2.new(0, 0, 0.5, 0))
	createLabel({
		Name = "Title",
		Position = UDim2.fromOffset(24, 0),
		Size = UDim2.new(1, -130, 1, 0),
		Text = options.Name or "Membership",
		TextSize = 14,
		Parent = headerRow,
	})

	local badge = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(0, 20),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Theme.Accent,
		BackgroundTransparency = 0.85,
		BorderSizePixel = 0,
		Visible = options.Badge ~= false,
		Parent = headerRow,
	})
	addCorner(badge, UDim.new(1, 0))
	local badgeStroke = addStroke(badge, Theme.Accent, 0.5)
	addPadding(badge, 9, 9)
	local badgeLabel = createLabel({
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = "",
		TextSize = 11,
		FontFace = Fonts.Bold,
		TextColor3 = Theme.Accent,
		TextTruncate = Enum.TextTruncate.None,
		Parent = badge,
	})

	local timeRow = create("Frame", {
		Size = UDim2.new(1, 0, 0, 38),
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Parent = card,
	})
	local timeValue = createLabel({
		Size = UDim2.new(0.55, 0, 0, 24),
		Text = "...",
		TextSize = 20,
		FontFace = Fonts.Bold,
		Parent = timeRow,
	})
	createLabel({
		Position = UDim2.fromOffset(0, 24),
		Size = UDim2.new(0.55, 0, 0, 14),
		Text = text("TimeLeft", "Time left"),
		TextSize = 12,
		FontFace = Fonts.Regular,
		TextColor3 = Theme.Muted,
		Parent = timeRow,
	})
	local expiresLabel = createLabel({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 4),
		Size = UDim2.new(0.45, 0, 0, 16),
		Text = "",
		TextSize = 12,
		FontFace = Fonts.Regular,
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = timeRow,
	})

	local totalTime = tonumber(options.TotalTime)
	local barFill
	if totalTime and totalTime > 0 then
		local barTrack = create("Frame", {
			Size = UDim2.new(1, 0, 0, 4),
			BackgroundColor3 = Theme.Surface3,
			BorderSizePixel = 0,
			LayoutOrder = 3,
			Parent = card,
		})
		addCorner(barTrack, UDim.new(1, 0))
		barFill = create("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Theme.Accent,
			BorderSizePixel = 0,
			Parent = barTrack,
		})
		addCorner(barFill, UDim.new(1, 0))
	end

	local detailNames = options.Details or { "Usage", "Discord", "HWID" }
	local detailValues = {}
	if #detailNames > 0 then
		local grid = create("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = 4,
			Parent = card,
		})
		create("UIGridLayout", {
			CellSize = UDim2.new(1 / math.min(#detailNames, 3), -6, 0, 40),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = grid,
		})
		for order, name in ipairs(detailNames) do
			local cell = create("Frame", {
				BackgroundColor3 = Theme.Surface,
				BorderSizePixel = 0,
				LayoutOrder = order,
				Parent = grid,
			})
			addCorner(cell, UDim.new(0, 6))
			createLabel({
				Position = UDim2.fromOffset(10, 5),
				Size = UDim2.new(1, -20, 0, 13),
				Text = tostring(labels[name] or Const.KEY_DETAIL_LABELS[name] or name),
				TextSize = 11,
				FontFace = Fonts.Regular,
				TextColor3 = Theme.Muted,
				Parent = cell,
			})
			detailValues[name] = createLabel({
				Position = UDim2.fromOffset(10, 19),
				Size = UDim2.new(1, -20, 0, 16),
				Text = "-",
				TextSize = 13,
				Parent = cell,
			})
		end
	end

	local promoLabel = createLabel({
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Text = options.PremiumText or "You're on a free key. Premium means no key resets and no waiting.",
		TextSize = 12,
		FontFace = Fonts.Regular,
		TextColor3 = Theme.Muted,
		TextWrapped = true,
		TextTruncate = Enum.TextTruncate.None,
		Visible = false,
		LayoutOrder = 5,
		Parent = card,
	})

	local rowHeight = IS_TOUCH and 32 or 30
	local buttonRow = create("Frame", {
		Size = UDim2.new(1, 0, 0, rowHeight),
		BackgroundTransparency = 1,
		Visible = false,
		LayoutOrder = 6,
		Parent = card,
	})
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, Const.PANEL_BUTTON_GAP),
		Parent = buttonRow,
	})
	local rowButtons = {}

	local function layoutRow()
		local visible = {}
		for _, entry in ipairs(rowButtons) do
			if entry.Button.Visible then
				table.insert(visible, entry)
			end
		end
		local count = #visible
		local equal = count > 0 and count <= 3
		for _, entry in ipairs(visible) do
			if equal then
				entry.Button.AutomaticSize = Enum.AutomaticSize.None
				entry.Button.Size = UDim2.new(1 / count, -math.ceil(Const.PANEL_BUTTON_GAP * (count - 1) / count), 0, rowHeight)
			else
				entry.Button.AutomaticSize = Enum.AutomaticSize.X
				entry.Button.Size = UDim2.fromOffset(0, rowHeight)
			end
			entry.Layout.HorizontalAlignment = equal and Enum.HorizontalAlignment.Center or Enum.HorizontalAlignment.Left
		end
	end

	local function addPanelButton(order, text, icon, style, callback)
		local primary = style == "Primary"
		local premium = style == "Premium"
		local restStroke = primary and Theme.Accent or (premium and Const.PREMIUM_GOLD or Theme.Stroke)
		local restTransparency = premium and 0.55 or 0
		local button = create("TextButton", {
			Size = UDim2.fromOffset(0, rowHeight),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = primary and Theme.Accent or Theme.Surface,
			BackgroundTransparency = primary and 0.1 or 0,
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = order,
			Parent = buttonRow,
		})
		addCorner(button, UDim.new(0, 7))
		local buttonStroke = addStroke(button, restStroke, restTransparency)
		addPadding(button, 10, 10)
		local layout = create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 7),
			Parent = button,
		})
		if icon then
			local image = create("ImageLabel", {
				Size = UDim2.fromOffset(15, 15),
				BackgroundTransparency = 1,
				ImageColor3 = primary and Theme.AccentDark or (premium and Const.PREMIUM_GOLD or Theme.Accent),
				ScaleType = Enum.ScaleType.Fit,
				LayoutOrder = 1,
				Parent = button,
			})
			if not setIcon(image, icon) then
				image:Destroy()
			end
		end
		createLabel({
			Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X,
			Text = text,
			TextSize = 12,
			TextColor3 = primary and Theme.AccentDark or Theme.Text,
			TextTruncate = Enum.TextTruncate.None,
			LayoutOrder = 2,
			Parent = button,
		})
		button.MouseEnter:Connect(function()
			if IS_TOUCH then
				return
			end
			if primary then
				tween(button, { BackgroundTransparency = 0 }, 0.12)
			elseif premium then
				tween(buttonStroke, { Transparency = 0.15 }, 0.12)
				tween(button, { BackgroundColor3 = Theme.Surface2 }, 0.12)
			else
				tween(buttonStroke, { Color = Theme.StrokeHover }, 0.12)
				tween(button, { BackgroundColor3 = Theme.Surface2 }, 0.12)
			end
		end)
		button.MouseLeave:Connect(function()
			if primary then
				tween(button, { BackgroundTransparency = 0.1 }, 0.2)
			else
				tween(buttonStroke, { Color = restStroke, Transparency = restTransparency }, 0.2)
				tween(button, { BackgroundColor3 = Theme.Surface }, 0.2)
			end
		end)
		button.MouseButton1Click:Connect(function()
			safeCall(callback)
		end)
		table.insert(rowButtons, { Button = button, Layout = layout })
		return button
	end

	local premiumButton
	if options.PremiumLink then
		premiumButton = addPanelButton(1, options.PremiumButton or "Get Premium", "crown", "Premium", function()
			Nucleus:Copy(options.PremiumLink)
		end)
	end
	local extraButtons = 0
	if options.DiscordLink then
		extraButtons += 1
		addPanelButton(2, options.DiscordButton or "Discord", "discord", nil, function()
			Nucleus:Copy(options.DiscordLink)
		end)
	end
	for index, buttonDef in ipairs(options.Buttons or {}) do
		extraButtons += 1
		local style = (buttonDef.Primary == true or buttonDef.Variant == "Primary" or buttonDef.Style == "Primary") and "Primary" or nil
		addPanelButton(2 + index, buttonDef.Title or buttonDef.Name or "Button", buttonDef.Icon, style, buttonDef.Callback)
	end
	layoutRow()

	local panel = { Frame = card }
	window._keyWarned = window._keyWarned or {}
	local warned = window._keyWarned
	local shown = {}

	local function setText(label, key, text)
		if shown[key] ~= text then
			shown[key] = text
			label.Text = text
		end
	end

	local function remind(key, title, content, kind)
		if options.Reminders == false or warned[key] then
			return
		end
		warned[key] = true
		local link = options.PremiumLink or (window._premium and window._premium.Link)
		local buttons
		if link and not getKeyStatus().Premium then
			content = content .. text("PremiumHint", " Premium keys never run out.")
			buttons = {
				{ Title = "Later" },
				{ Title = "Get Premium", Primary = true, Callback = function()
					if window._premium then
						window:_premiumClicked("reminder")
					else
						Nucleus:Copy(link)
					end
				end },
			}
		end
		window:Notify({ Title = title, Content = content, Type = kind, Duration = buttons and 12 or 6, Buttons = buttons })
	end

	function panel:Refresh()
		local data = snapshot()
		local accent = (not data.HasKey and Theme.Muted) or (data.Premium and Theme.Accent) or Theme.Warning
		setText(badgeLabel, "badge", string.upper(data.TypeName))
		badge.BackgroundColor3 = accent
		badgeStroke.Color = accent
		badgeLabel.TextColor3 = accent

		local left
		if data.Lifetime then
			setText(timeValue, "time", text("NeverExpires", "Never expires"))
			setText(expiresLabel, "expires", text("Lifetime", "Lifetime key"))
		elseif data.Expiry then
			left = math.floor(data.Expiry - os.time())
			setText(timeValue, "time", left > 0 and formatDuration(left) or text("Expired", "Expired"))
			setText(expiresLabel, "expires", text("Ends", "Ends ") .. os.date(options.DateFormat or "%b %d, %H:%M", data.Expiry))
		elseif data.HasKey then
			setText(timeValue, "time", text("Active", "Active"))
			setText(expiresLabel, "expires", "")
		else
			setText(timeValue, "time", text("NoKey", "No key loaded"))
			setText(expiresLabel, "expires", "")
		end
		timeValue.TextColor3 = (left and left <= 0) and Theme.Error or ((left and left <= 900) and Theme.Warning or Theme.Text)

		if barFill then
			local fraction = data.Lifetime and 1 or (left and math.clamp(left / totalTime, 0, 1) or 0)
			barFill.Size = UDim2.fromScale(fraction, 1)
			barFill.BackgroundColor3 = fraction <= 0.15 and Theme.Warning or Theme.Accent
		end

		for name, label in pairs(detailValues) do
			local value = data[name]
			local detailText
			if name == "HWID" then
				detailText = (type(value) == "string" and #value >= 4) and ("••••" .. string.sub(value, -4)) or text("Unknown", "Unknown")
			elseif name == "Discord" then
				detailText = (type(value) == "string" and value ~= "") and value or text("NotLinked", "Not linked")
			elseif value ~= nil and value ~= "" then
				detailText = tostring(value)
			else
				detailText = "-"
			end
			setText(label, "detail" .. name, detailText)
		end

		promoLabel.Visible = data.HasKey and not data.Premium and options.ShowPromo ~= false
		if premiumButton and premiumButton.Visible ~= not data.Premium then
			premiumButton.Visible = not data.Premium
			layoutRow()
		end
		buttonRow.Visible = (premiumButton ~= nil and not data.Premium) or extraButtons > 0

		if left and not data.Lifetime then
			if left <= 0 then
				remind("expired", text("ExpiredTitle", "Key expired"), text("ExpiredMessage", "Your key has run out. Get a new key to keep using the script."), "Error")
			elseif left <= 900 then
				local minutes = tostring(math.max(1, math.floor(left / 60)))
				remind("15m", text("SoonTitle", "Key expiring soon"), (text("SoonMessage", "Your key ends in about {minutes} minutes."):gsub("{minutes}", minutes)), "Warning")
			elseif left <= 3600 then
				remind("60m", text("HourTitle", "Key ends in 1 hour"), text("HourMessage", "Your key has about an hour left."), "Warning")
			end
		end
	end

	panel:Refresh()
	task.spawn(function()
		while card.Parent and not window._destroyed do
			task.wait(1)
			if card.Parent then
				panel:Refresh()
			end
		end
	end)

	return panel, card
end

function Tab:KeyInfo(input)
	local options = normalizeOptions(input, { Title = "Name" })
	local panel, card = createKeyPanel(self.Window, self.List, self:_nextOrder(), options)
	return registerElement(self, { Name = options.Name or "Membership" }, panel, card, "KeyInfo")
end

function Tab:Select()
	self.Window:SelectTab(self)
end

function Tab:SetTitle(text)
	self.Name = tostring(text)
	self._label.Text = self.Name
	if self._pageTitle then
		self._pageTitle.Text = self.Name
	end
end

Const.NO_CREATE_ALIAS = { Select = true, SetTitle = true }
for methodName, method in pairs(table.clone(Tab)) do
	if type(method) == "function"
		and methodName:sub(1, 1) ~= "_"
		and methodName:sub(1, 6) ~= "Create"
		and not Const.NO_CREATE_ALIAS[methodName]
	then
		Tab["Create" .. methodName] = method
	end
end

local function getExecutorName()
	local name
	pcall(function()
		if typeof(identifyexecutor) == "function" then
			name = (identifyexecutor())
		elseif typeof(getexecutorname) == "function" then
			name = getexecutorname()
		end
	end)
	if type(name) == "string" and #name > 0 then
		return name
	end
	return RunService:IsStudio() and "Studio" or "Unknown"
end

local function getGameName()
	local ok, info = pcall(function()
		return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
	end)
	if ok and type(info) == "table" and info.Name then
		return info.Name
	end
	return "Unknown game"
end

Const.COUNTRY_NAMES = {
	US = "United States",
	GB = "United Kingdom",
	DE = "Germany",
	FR = "France",
	NL = "Netherlands",
	SG = "Singapore",
	JP = "Japan",
	AU = "Australia",
	BR = "Brazil",
	IN = "India",
	HK = "Hong Kong",
	CA = "Canada",
}

local function fetchRegion(done, countryOnly)
	task.spawn(function()
		local requestFn = request
			or http_request
			or (syn and syn.request)
			or (http and http.request)
		local region
		if type(requestFn) == "function" then
			pcall(function()
				local response = requestFn({ Url = "https://ipinfo.io/json", Method = "GET" })
				local body = type(response) == "table" and (response.Body or response.body) or nil
				if type(body) == "string" then
					local data = HttpService:JSONDecode(body)
					if type(data) == "table" and data.country then
						local country = Const.COUNTRY_NAMES[data.country] or data.country
						if data.city and not countryOnly then
							region = data.city .. ", " .. country
						else
							region = country
						end
					end
				end
			end)
		end
		done(region or "Unavailable")
	end)
end

