		for av, aw in ipairs(i.WINDOW_PARTS) do
			au[string.lower(aw)] = aw
		end

		function aa:_layoutHeader()
			local av = -14
			for aw, ax in ipairs({ self._closeButton, self._minimizeButton }) do
				if ax and ax.Visible then
					ax.Position = UDim2.new(1, av, 0, 13)
					av -= 38
				end
			end
			if self._headerItems then
				self._headerItems.Position = UDim2.new(1, av - 4, 0, 18)
			end
		end

		function aa:_enforceParts()
			local av = self._hiddenParts or {}
			local aw = self._compact == true
			self._logo.Visible = not av.Logo
			if av.Title then
				self._titleLabel.Visible = false
			end
			if av.Subtitle then
				self._subtitleLabel.Visible = false
			end
			if self._searchFrame then
				self._searchFrame.Visible = not av.Search and not aw
			end
			self._profile.Visible = not av.Profile
			if av.KeyHint then
				self._keyChip.Visible = false
				self._hintLabel.Visible = false
			end
			if self._sidebarButton then
				self._sidebarButton.Visible = not av.SidebarButton
			end
			if not aw then
				self._titleLabel.Visible = not av.Title
				self._subtitleLabel.Visible = not av.Subtitle
			end
		end

		function aa:_applyParts()
			local av = self._hiddenParts or {}
			local aw = av.Logo and 14 or 54
			local ax = av.Subtitle or self._subtitleLabel.Text == ""
			self._titleLabel.Position = UDim2.fromOffset(aw, ax and 23 or 16)
			self._titleLabel.Size = UDim2.new(1, -(aw + 4), 0, 20)
			self._subtitleLabel.Position = UDim2.fromOffset(aw, av.Title and 26 or 36)
			self._subtitleLabel.Size = UDim2.new(1, -(aw + 4), 0, 14)

			self._listTopBase = self._listTopBase or self._listTop
			self._listTop = (self._searchFrame and not av.Search) and self._listTopBase or 72
			self._listBottom = av.Profile and 8 or 66
			if av.Search and self._searchBox and self._searchBox.Text ~= "" then
				self._searchBox.Text = ""
			end
			local ay = self._compact and 66 or self._listTop
			for az, aA in ipairs({ self.TabList, self._searchResults }) do
				if aA then
					aA.Position = UDim2.fromOffset(0, ay)
					aA.Size = UDim2.new(1, 0, 1, -(ay + self._listBottom))
				end
			end

			self._profileName.Position = UDim2.fromOffset(48, av.KeyHint and 16 or 7)
			if not av.KeyHint and not self._compact then
				self._keyChip.Visible = not x
				self._hintLabel.Visible = true
			end

			if self._closeButton then
				self._closeButton.Visible = not av.CloseButton
			end
			if self._minimizeButton then
				self._minimizeButton.Visible = not av.MinimizeButton
			end
			self:_layoutHeader()

			for az, aA in ipairs(self.Tabs) do
				self:_placePageTitle(aA)
			end
			self:_enforceParts()
		end

		function aa:_placePageTitle(av)
			local aw = self._hiddenParts or {}
			local ax = aw.SidebarButton and i.PAGE_PAD or (i.PAGE_PAD + 36)
			if av._pageTitle then
				av._pageTitle.Position = UDim2.fromOffset(ax, 18)
				av._pageTitle.Size = UDim2.new(1, -(ax + 48), 0, 24)
			end
			if av._pageDesc then
				av._pageDesc.Position = UDim2.fromOffset(ax, 40)
				av._pageDesc.Size = UDim2.new(1, -(ax + 48), 0, 16)
			end
		end

		function aa:SetPartVisible(av, aw)
			local ax = au[string.lower(tostring(av))]
			if not ax then
				log(("unknown window part '%s'. Parts: %s"):format(tostring(av), table.concat(i.WINDOW_PARTS, ", ")))
				return false
			end
			self._hiddenParts = self._hiddenParts or {}
			self._hiddenParts[ax] = aw == false or nil
			self:_applyParts()
			return true
		end

		function aa:HidePart(av)
			return self:SetPartVisible(av, false)
		end

		function aa:ShowPart(av)
			return self:SetPartVisible(av, true)
		end

		function aa:IsPartVisible(av)
			local aw = au[string.lower(tostring(av))]
			return aw ~= nil and not (self._hiddenParts and self._hiddenParts[aw])
		end

		function aa:GetParts()
			return table.clone(i.WINDOW_PARTS)
		end

		local av = aa.SetSubtitle
		function aa:SetSubtitle(aw)
			av(self, aw)
			self:_applyParts()
		end

		local aw = aa.Tab
		local function tabWithParts(ax, ...)
			local ay = aw(ax, ...)
			if type(ay) == "table" and ax._hiddenParts and ax._hiddenParts.SidebarButton then
				ax:_placePageTitle(ay)
			end
			return ay
		end
		for ax, ay in pairs(table.clone(aa)) do
			if ay == aw then
				aa[ax] = tabWithParts
			end
		end

		local function readHideList(ax)
			local ay = {}
			if type(ax) == "string" then
				ax = { ax }
			end
			if type(ax) ~= "table" then
				return ay
			end
			for az, aA in pairs(ax) do
				local aB = type(az) == "number" and aA or (aA == true and az or nil)
				local aC = aB and au[string.lower(tostring(aB))]
				if aC then
					ay[aC] = true
				elseif aB then
					log(("unknown window part '%s' in Hide. Parts: %s"):format(tostring(aB), table.concat(i.WINDOW_PARTS, ", ")))
				end
			end
			return ay
		end

		local function keyFile(ax, ay)
			local az = tostring(ax.Folder or "NucleusUI/Keys")
			local aA = tostring(ax.FileName or (ay and ay.Title) or "key")
			aA = aA:gsub("[^%w%-_]", "")
			if aA == "" then
				aA = "key"
			end
			return az, az .. "/" .. aA .. ".txt"
		end

		local function readSavedKey(ax)
			local ay, az = pcall(function()
				if type(isfile) == "function" and isfile(ax) then
					return readfile(ax)
				end
			end)
			if ay and type(az) == "string" and az ~= "" then
				return (az:gsub("^%s+", ""):gsub("%s+$", ""))
			end
			return nil
		end

		local function writeSavedKey(ax, ay, az)
			pcall(function()
				if type(writefile) ~= "function" then
					return
				end
				if type(makefolder) == "function" and type(isfolder) == "function" then
					local aA = ""
					for aB in ax:gmatch("[^/]+") do
						aA = aA == "" and aB or (aA .. "/" .. aB)
						if not isfolder(aA) then
							makefolder(aA)
						end
					end
				end
				writefile(ay, az)
			end)
		end

		local function checkKey(ax, ay)
			local az = ax.Check or ax.Validate or ax.Verify
			if type(az) == "function" then
				local aA, aB, aC = pcall(az, ay)
				if not aA then
					return false, "Could not check the key. Try again."
				end
				if type(aB) == "table" then
					return aB.Valid == true or aB.Success == true, aB.Message
				end
				return aB == true, aC
			end
			local aA = ax.Key or ax.Keys
			if type(aA) == "string" then
				aA = { aA }
			end
			for aB, aC in ipairs(type(aA) == "table" and aA or {}) do
				if ay == tostring(aC) then
					return true
				end
			end
			return false
		end

		function h:KeySystem(ax, ay)
			ax = type(ax) == "table" and ax or {}
			ay = ay or {}
			if ay.Theme ~= nil then
				pcall(h.SetTheme, h, ay.Theme)
			end
			local az, aA = keyFile(ax, ay)
			h._keyFile = aA
			h._savedKeyUsed = false
			if ax.SaveKey ~= false then
				local aB = readSavedKey(aA)
				if aB and checkKey(ax, aB) then
					h.Key = aB
					h._savedKeyUsed = true
					safeCall(ax.OnSuccess, aB)
					return aB
				end
			end

			local aB = create("ScreenGui", {
				Name = "NucleusKeySystem",
				IgnoreGuiInset = true,
				ResetOnSpawn = false,
				DisplayOrder = 1000,
				ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
			})
			pcall(function()
				if typeof(syn) == "table" and typeof(syn.protect_gui) == "function" then
					syn.protect_gui(aB)
				end
			end)

			local aC = x and 312 or 344
			local aD = create("Frame", {
				Name = "Backdrop",
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = Color3.new(0, 0, 0),
				BackgroundTransparency = 0.45,
				BorderSizePixel = 0,
				Active = true,
				Parent = aB,
			})
			aD:SetAttribute(i.ATTR_NO_THEME, true)
			local aE = create("Frame", {
				Name = "Card",
				Size = UDim2.fromOffset(aC, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundColor3 = u.Background,
				BorderSizePixel = 0,
				ZIndex = 2,
				Parent = aB,
			})
			addCorner(aE, UDim.new(0, C.WindowRadius + 2))
			addStroke(aE)
			addPadding(aE, 22, 22, 20, 18)
			create("UIListLayout", {
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 14),
				Parent = aE,
			})
			local L = create("UIScale", { Parent = aE })
			local function fitCard()
				local M = aB.AbsoluteSize
				if M.X <= 0 or M.Y <= 0 then
					return
				end
				local N = math.max(aE.AbsoluteSize.Y / math.max(L.Scale, 0.01), 1)
				L.Scale = math.clamp(math.min((M.Y - 32) / N, (M.X - 24) / aC), 0.6, 1)
				local O = Vector2.new(aC, N) * L.Scale
				aE.Position = UDim2.fromOffset(math.floor((M.X - O.X) / 2), math.floor((M.Y - O.Y) / 2))
			end
			aB:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitCard)
			aE:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitCard)

			local M = create("Frame", {
				Size = UDim2.new(1, 0, 0, 44),
				BackgroundTransparency = 1,
				LayoutOrder = 1,
				Parent = aE,
			})
			local N = create("Frame", {
				Size = UDim2.fromOffset(44, 44),
				BackgroundColor3 = u.Surface2,
				BorderSizePixel = 0,
				Parent = M,
			})
			addCorner(N, UDim.new(0, 12))
			addStroke(N)
			local O = create("ImageLabel", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(22, 22),
				BackgroundTransparency = 1,
				ImageColor3 = u.Accent,
				ScaleType = Enum.ScaleType.Fit,
				Parent = N,
			})
			if not setIcon(O, ax.Icon or ay.Icon or "key-round") then
				setIcon(O, "key-round")
			end
			createLabel({
				Position = UDim2.fromOffset(56, 3),
				Size = UDim2.new(1, -96, 0, 20),
				Text = tostring(ax.Title or ay.Title or i.LIB_NAME),
				TextSize = 17,
				FontFace = w.Bold,
				Parent = M,
			})
			createLabel({
				Position = UDim2.fromOffset(56, 25),
				Size = UDim2.new(1, -96, 0, 16),
				Text = tostring(ax.Subtitle or "Enter your key to continue"),
				TextSize = 13,
				FontFace = w.Regular,
				TextColor3 = u.Muted,
				Parent = M,
			})

			local P = false
			local Q
			if ax.CanClose ~= false then
				local R = create("TextButton", {
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.new(1, 6, 0, -4),
					Size = UDim2.fromOffset(30, 30),
					BackgroundColor3 = u.Surface2,
					BackgroundTransparency = 1,
					Text = "",
					AutoButtonColor = false,
					Parent = M,
				})
				addCorner(R, UDim.new(0, 8))
				local S = create("ImageLabel", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromScale(0.5, 0.5),
					Size = UDim2.fromOffset(16, 16),
					BackgroundTransparency = 1,
					ImageColor3 = u.Muted,
					ScaleType = Enum.ScaleType.Fit,
					Parent = R,
				})
				setIcon(S, "x")
				R.MouseEnter:Connect(function()
					tween(R, { BackgroundTransparency = 0 }, 0.15)
					tween(S, { ImageColor3 = u.Text }, 0.15)
				end)
				R.MouseLeave:Connect(function()
					tween(R, { BackgroundTransparency = 1 }, 0.2)
					tween(S, { ImageColor3 = u.Muted }, 0.2)
				end)
				R.MouseButton1Click:Connect(function()
					P = true
				end)
			end

			local R = ax.Note or ax.Desc or ax.Description
			if R then
				createLabel({
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					Text = tostring(R),
					TextSize = 13,
					FontFace = w.Regular,
					TextColor3 = u.Muted,
					TextWrapped = true,
					TextTruncate = Enum.TextTruncate.None,
					LayoutOrder = 2,
					Parent = aE,
				})
			end

			local S = ax.URL or ax.Url or ax.Link or ax.KeyLink
			local T = ax.Steps
			if T == nil and (S or type(ax.GetKey) == "function") then
				T = {
					"Press Get key to copy the link",
					"Open it in your browser and finish the steps",
					"Paste your key below and press " .. tostring(ax.SubmitText or "Continue"),
				}
			end
			if type(T) == "table" and #T > 0 then
				local U = create("Frame", {
					Name = "Steps",
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					BackgroundColor3 = u.Surface,
					BorderSizePixel = 0,
					LayoutOrder = 3,
					Parent = aE,
				})
				addCorner(U, UDim.new(0, 10))
				addStroke(U)
				addPadding(U, 12, 12, 11, 11)
				create("UIListLayout", {
					SortOrder = Enum.SortOrder.LayoutOrder,
					Padding = UDim.new(0, 8),
					Parent = U,
				})
				for V, W in ipairs(T) do
					local X = create("Frame", {
						Size = UDim2.new(1, 0, 0, 20),
						AutomaticSize = Enum.AutomaticSize.Y,
						BackgroundTransparency = 1,
						LayoutOrder = V,
						Parent = U,
					})
					local Y = create("Frame", {
						Size = UDim2.fromOffset(20, 20),
						BackgroundColor3 = u.Surface2,
						BorderSizePixel = 0,
						Parent = X,
					})
					addCorner(Y, UDim.new(1, 0))
					addStroke(Y)
					createLabel({
						Size = UDim2.fromScale(1, 1),
						Text = tostring(V),
						TextSize = 12,
						FontFace = w.Bold,
						TextColor3 = u.Accent,
						TextXAlignment = Enum.TextXAlignment.Center,
						Parent = Y,
					})
					createLabel({
						Position = UDim2.fromOffset(30, 0),
						Size = UDim2.new(1, -30, 0, 20),
						AutomaticSize = Enum.AutomaticSize.Y,
						Text = tostring(W),
						TextSize = 12,
						FontFace = w.Regular,
						TextColor3 = u.Text,
						TextWrapped = true,
						TextTruncate = Enum.TextTruncate.None,
						Parent = X,
					})
				end
			end

			local U = create("Frame", {
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				LayoutOrder = 4,
				Parent = aE,
			})
			create("UIListLayout", {
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 7),
				Parent = U,
			})
			createLabel({
				Size = UDim2.new(1, 0, 0, 14),
				Text = tostring(ax.InputTitle or "Key"),
				TextSize = 12,
				FontFace = w.Medium,
				TextColor3 = u.Muted,
				LayoutOrder = 1,
				Parent = U,
			})
			local V = create("Frame", {
				Size = UDim2.new(1, 0, 0, 42),
				BackgroundColor3 = u.Surface,
				BorderSizePixel = 0,
				LayoutOrder = 2,
				Parent = U,
			})
			addCorner(V, UDim.new(0, 9))
			local W = addStroke(V)
			local X, Y = createIcon(V, "key-round", u.Muted, UDim2.new(0, 13, 0.5, 0))
			local Z = create("TextBox", {
				Position = UDim2.fromOffset(40, 0),
				Size = UDim2.new(1, -52, 1, 0),
				BackgroundTransparency = 1,
				Text = "",
				PlaceholderText = tostring(ax.Placeholder or "Paste your key here"),
				PlaceholderColor3 = u.Muted,
				TextColor3 = u.Text,
				TextSize = 14,
				FontFace = w.Regular,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				ClearTextOnFocus = false,
				Parent = V,
			})

			local _ = create("Frame", {
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				Visible = false,
				LayoutOrder = 3,
				Parent = U,
			})
			local aF = create("ImageLabel", {
				Position = UDim2.fromOffset(0, 1),
				Size = UDim2.fromOffset(14, 14),
				BackgroundTransparency = 1,
				ScaleType = Enum.ScaleType.Fit,
				Parent = _,
			})
			local aG = createLabel({
				Position = UDim2.fromOffset(20, 0),
				Size = UDim2.new(1, -20, 0, 16),
				AutomaticSize = Enum.AutomaticSize.Y,
				Text = "",
				TextSize = 12,
				FontFace = w.Regular,
				TextColor3 = u.Muted,
				TextWrapped = true,
				TextTruncate = Enum.TextTruncate.None,
				Parent = _,
			})
			local function setStatus(aH, aI, aJ)
				aG.Text = aH or ""
				aG.TextColor3 = aI or u.Muted
				aF.ImageColor3 = aI or u.Muted
				aF.Visible = setIcon(aF, aJ or "info")
				_.Visible = aG.Text ~= ""
			end

			local function keyButton(aH, aI, aJ, aK, aL, aM, aN)
				local aO = create("TextButton", {
					Size = UDim2.new(1, 0, 0, aM),
					BackgroundColor3 = aL and u.Accent or u.Surface,
					Text = "",
					AutoButtonColor = false,
					LayoutOrder = aI,
					Parent = aH,
				})
				addCorner(aO, UDim.new(0, 9))
				local aP = addStroke(aO, aL and u.Accent or u.Stroke)
				create("UIListLayout", {
					FillDirection = Enum.FillDirection.Horizontal,
					HorizontalAlignment = Enum.HorizontalAlignment.Center,
					VerticalAlignment = Enum.VerticalAlignment.Center,
					SortOrder = Enum.SortOrder.LayoutOrder,
					Padding = UDim.new(0, 7),
					Parent = aO,
				})
				local aQ = createLabel({
					Size = UDim2.new(0, 0, 1, 0),
					AutomaticSize = Enum.AutomaticSize.X,
					Text = aJ,
					TextSize = aL and 14 or 13,
					FontFace = w.Bold,
					TextColor3 = aL and u.AccentDark or u.Text,
					TextTruncate = Enum.TextTruncate.None,
					LayoutOrder = aL and 1 or 2,
					Parent = aO,
				})
				if aK then
					local aR = create("ImageLabel", {
						Size = UDim2.fromOffset(15, 15),
						BackgroundTransparency = 1,
						ImageColor3 = aL and u.AccentDark or u.Accent,
						ScaleType = Enum.ScaleType.Fit,
						LayoutOrder = aL and 2 or 1,
						Parent = aO,
					})
					if not setIcon(aR, aK) then
						aR:Destroy()
					end
				end
				aO.MouseEnter:Connect(function()
					if x then
						return
					end
					if aL then
						tween(aO, { BackgroundTransparency = 0.12 }, 0.12)
					else
						tween(aP, { Color = u.StrokeHover }, 0.12)
						tween(aO, { BackgroundColor3 = u.Surface2 }, 0.12)
					end
				end)
				aO.MouseLeave:Connect(function()
					if aL then
						tween(aO, { BackgroundTransparency = 0 }, 0.2)
					else
						tween(aP, { Color = u.Stroke }, 0.2)
						tween(aO, { BackgroundColor3 = u.Surface }, 0.2)
					end
				end)
				aO.MouseButton1Click:Connect(function()
					safeCall(aN)
				end)
				return aO, aQ
			end

			local aH = false
			local aI
			local aJ = tostring(ax.SubmitText or "Continue")
			local function submit()
				if aH or Q or P then
					return
				end
				local aK = (Z.Text:gsub("^%s+", ""):gsub("%s+$", ""))
				if aK == "" then
					setStatus("Type or paste your key first.", u.Warning, "circle-alert")
					return
				end
				aH = true
				setStatus("Checking...", u.Muted, "loader-circle")
				if aI then
					aI.Text = "Checking..."
				end
				task.spawn(function()
					local aL, aM = checkKey(ax, aK)
					aH = false
					if aI then
						aI.Text = aJ
					end
					if P then
						return
					end
					if aL then
						setStatus(aM or "Key accepted.", u.Success, "circle-check")
						W.Color = u.Success
						if ax.SaveKey ~= false then
							writeSavedKey(az, aA, aK)
						end
						task.wait(0.35)
						Q = aK
					else
						setStatus(aM or "That key isn't valid. Check it and try again.", u.Error, "circle-x")
						W.Color = u.Error
						safeCall(ax.OnFail, aK)
					end
				end)
			end

			local aK, aL = keyButton(aE, 5, aJ, "arrow-right", true, 42, submit)
			aI = aL

			local aM = {}
			if S or type(ax.GetKey) == "function" then
				table.insert(aM, { tostring(ax.GetKeyText or "Get key"), "link", function()
					if type(ax.GetKey) == "function" then
						ax.GetKey()
						return
					end
					if h:Copy(tostring(S), true) then
						setStatus("Link copied. Paste it in your browser.", u.Muted, "copy")
					else
						setStatus(tostring(S), u.Muted, "link")
					end
				end })
			end
			if ax.Discord then
				table.insert(aM, { "Discord", "discord", function()
					if h:Copy(tostring(ax.Discord), true) then
						setStatus("Discord invite copied.", u.Muted, "copy")
					else
						setStatus(tostring(ax.Discord), u.Muted, "link")
					end
				end })
			end
			if #aM > 0 then
				local aN = create("Frame", {
					Size = UDim2.new(1, 0, 0, 38),
					BackgroundTransparency = 1,
					LayoutOrder = 6,
					Parent = aE,
				})
				create("UIListLayout", {
					FillDirection = Enum.FillDirection.Horizontal,
					SortOrder = Enum.SortOrder.LayoutOrder,
					Padding = UDim.new(0, 8),
					Parent = aN,
				})
				local aO = #aM
				for aP, aQ in ipairs(aM) do
					local aR = keyButton(aN, aP, aQ[1], aQ[2], false, 38, aQ[3])
					aR.Size = UDim2.new(1 / aO, -math.ceil(8 * (aO - 1) / aO), 0, 38)
				end
			end

			if ax.SaveKey ~= false then
				local aN = create("Frame", {
					Size = UDim2.new(1, 0, 0, 16),
					BackgroundTransparency = 1,
					LayoutOrder = 7,
					Parent = aE,
				})
				create("UIListLayout", {
					FillDirection = Enum.FillDirection.Horizontal,
					HorizontalAlignment = Enum.HorizontalAlignment.Center,
					VerticalAlignment = Enum.VerticalAlignment.Center,
					SortOrder = Enum.SortOrder.LayoutOrder,
					Padding = UDim.new(0, 6),
					Parent = aN,
				})
				local aO = create("ImageLabel", {
					Size = UDim2.fromOffset(12, 12),
					BackgroundTransparency = 1,
					ImageColor3 = u.Muted,
					ScaleType = Enum.ScaleType.Fit,
					LayoutOrder = 1,
					Parent = aN,
				})
				if not setIcon(aO, "lock") then
					aO:Destroy()
				end
				createLabel({
					Size = UDim2.new(0, 0, 1, 0),
					AutomaticSize = Enum.AutomaticSize.X,
					Text = tostring(ax.FooterText or "Your key is remembered on this device"),
					TextSize = 12,
					FontFace = w.Regular,
					TextColor3 = u.Muted,
					TextTruncate = Enum.TextTruncate.None,
					LayoutOrder = 2,
					Parent = aN,
				})
			end

			local aN = false
			Z.Focused:Connect(function()
				aN = true
				W.Color = u.StrokeHover
				Y.ImageColor3 = u.Text
			end)
			Z.FocusLost:Connect(function(aO)
				aN = false
				W.Color = u.Stroke
				Y.ImageColor3 = u.Muted
				if aO then
					submit()
				end
			end)
			Z:GetPropertyChangedSignal("Text"):Connect(function()
				if _.Visible and not aH then
					_.Visible = false
					W.Color = aN and u.StrokeHover or u.Stroke
				end
			end)
			setIcon(aF, "circle-check")
			aB.Parent = ay.Parent or getGuiParent()
			fitCard()
			task.defer(fitCard)

			while not Q and not P do
				task.wait(0.05)
			end
			aB:Destroy()
			if P then
				safeCall(ax.OnClose)
				return nil
			end
			h.Key = Q
			safeCall(ax.OnSuccess, Q)
			return Q
		end

		function h:ClearSavedKey(ax, ay)
			local az = h._keyFile
			if type(ax) == "table" or type(ay) == "table" then
				local aA, aB = keyFile(type(ax) == "table" and ax or {}, type(ay) == "table" and ay or nil)
				az = aB
			end
			if not az then
				return false
			end
			local aA = pcall(function()
				if type(isfile) == "function" and isfile(az) then
					if type(delfile) == "function" then
						delfile(az)
					else
						writefile(az, "")
					end
				end
			end)
			return aA
		end

		local ax = h.Window
		local function windowWithExtras(ay, az)
			local aA = ay == h and az or ay
			if type(aA) == "table" and type(aA.KeySystem) == "table" and aA.KeySystem.Enabled ~= false then
				local aB = h:KeySystem(aA.KeySystem, aA)
				if not aB then
					while true do
						task.wait(3600)
					end
				end
			end
			local aB = ax(ay, az)
			if type(aB) == "table" and type(aA) == "table" then
				aB.Key = h.Key
				local aC = aA.KeySystem
				if type(aC) == "table" and aC.Enabled ~= false and h._savedKeyUsed and aC.SavedNotice ~= false then
					h._savedKeyUsed = false
					task.delay(0.5, function()
						if not aB._destroyed then
							aB:Notify({
								Title = "Key accepted",
								Content = "Using your saved key.",
								Type = "Success",
								Icon = "key-round",
								Duration = 4,
							})
						end
					end)
				end
				local aD = readHideList(aA.Hide)
				if next(aD) then
					aB._hiddenParts = aD
				end
				aB:_applyParts()
			end
			return aB
		end
		for ay, az in pairs(table.clone(h)) do
			if az == ax then
				h[ay] = windowWithExtras
			end
		end
	end

	do
		local function fits(au, av)
			local aw = typeof(av)
			for ax in string.gmatch(au, "[^|]+") do
				if ax == "list" then
					if aw == "table" and (av[1] ~= nil or next(av) == nil) then
						return true
					end
				elseif ax == aw then
					return true
				end
			end
			return false
		end

		local function fromShorthand(au, ...)
			local av = select("#", ...)
			local aw = ...
			if av == 0 or (av == 1 and type(aw) ~= "function") then
				return nil
			end
			local ax, ay = {}, nil
			local az = 1
			for aA = 1, av do
				local aB = select(aA, ...)
				local aC = typeof(aB)
				if aC == "function" then
					if ax.Callback == nil then
						ax.Callback = aB
					end
				elseif aC == "table" and not fits("list", aB) then
					ay = ay or {}
					for aD, aE in pairs(aB) do
						if ay[aD] == nil then
							ay[aD] = aE
						end
					end
				elseif aB == nil then
					az += 1
				else
					while au[az] and not fits(au[az][2], aB) do
						az += 1
					end
					local aD = au[az]
					if aD then
						ax[aD[1] ] = aB
						az += 1
					end
				end
			end
			if ay then
				for aA, aB in pairs(ay) do
					if ax[aA] == nil then
						ax[aA] = aB
					end
				end
			end
			return ax
		end

		local au = false
		local av = {
			__index = function(av, aw)
				if aw == "Value" and not au and type(rawget(av, "Get")) == "function" then
					au = true
					local ax, ay = pcall(rawget(av, "Get"), av)
					au = false
					if ax then
						return ay
					end
				end
				return nil
			end,
		}

		local aw, ax = { "Title", "string" }, { "Desc", "string" }
		local ay = { aw, { "Min", "number" }, { "Max", "number" }, { "Value", "number" } }
		local az = { aw, { "Placeholder", "string" } }
		i.SHORTHAND = {
			Button = { aw, ax },
			Toggle = { aw, { "Value", "boolean" } },
			Slider = ay,
			Stepper = ay,
			Dropdown = { aw, { "Values", "list" }, { "Value", "string|number|list" } },
			Input = az,
			TextArea = az,
			Keybind = { aw, { "Value", "string|EnumItem" } },
			ColorPicker = { aw, { "Value", "Color3" } },
			Paragraph = { aw, ax },
			Progress = { aw, { "Value", "number" } },
			Code = { aw, { "Code", "string" } },
			Group = { aw, ax },
		}

		for aA, aB in pairs(i.SHORTHAND) do
			local aC = K[aA]
			if type(aC) == "function" then
				local function shorthand(aD, ...)
					local aE = fromShorthand(aB, ...)
					local aF
					if aE then
						if aA == "Dropdown" and type(aE.Value) == "table" and aE.Multi == nil then
							aE.Multi = true
						end
						aF = aC(aD, aE)
					else
						aF = aC(aD, ...)
					end
					if type(aF) == "table" and getmetatable(aF) == nil and rawget(aF, "Value") == nil
						and type(rawget(aF, "Get")) == "function" then
						setmetatable(aF, av)
					end
					return aF
				end
				for aD, aE in pairs(table.clone(K)) do
					if aE == aC then
						K[aD] = shorthand
					end
				end
			end
		end

		local function notifyShorthand(aA, aB, aC, aD)
			if type(aA) ~= "string" or (aB == nil and aC == nil and aD == nil) then
				return aA
			end
			local aE = { Title = aA }
			local aF = { aB, aC, aD }
			for aG = 1, 3 do
				local aH = aF[aG]
				if type(aH) == "number" then
					aE.Duration = aH
				elseif type(aH) == "string" and aE.Content == nil then
					aE.Content = aH
				elseif type(aH) == "string" then
					aE.Type = aH
				end
			end
			return aE
		end
		local aA = aa.Notify
		aa.Notify = function(aB, aC, aD, aE, aF)
			return aA(aB, notifyShorthand(aC, aD, aE, aF))
		end
		local aB = h.Notify
		h.Notify = function(aC, aD, aE, aF, aG)
			return aB(aC, notifyShorthand(aD, aE, aF, aG))
		end

		local aC = h.Window
		local function windowShorthand(aD, aE, aF)
			if aD == h then
				if type(aE) == "string" then
					aE = { Title = aE, Author = type(aF) == "string" and aF or nil }
				end
				return aC(aD, aE)
			end
			if type(aD) == "string" then
				return aC({ Title = aD, Author = type(aE) == "string" and aE or nil })
			end
			return aC(aD, aE)
		end
		for aD, aE in pairs(table.clone(h)) do
			if aE == aC then
				h[aD] = windowShorthand
			end
		end
	end

	local au = {
		"Notify", "Confirm", "Dialog", "Prompt", "Popup", "SetTheme", "AddTheme", "GetValue", "SetValue",
		"GetValues", "SetValues", "Copy", "Destroy", "Unload", "Loop", "Connect", "OnUnload", "OnError",
		"GetErrors", "ClearErrors", "SetLanguage", "SetLocalization", "Translate", "GetFlag", "GetThemes",
		"GetLanguage", "SetErrorNotifications", "Try", "ReportError", "PreloadIcons", "LoadFont",
		"SetAccent", "GetAccent", "SetFont", "SetKeySource", "GetKeyStatus", "IsPremium", "OnFlagChanged",
		"ForGame", "CheckVersion", "RequireFunctions",
	}
	for av, aw in ipairs(au) do
		local ax = h[aw]
		if type(ax) == "function" then
			h[aw] = function(ay, ...)
				if ay ~= h then
					return ax(h, ay, ...)
				end
				return ax(ay, ...)
			end
		end
	end

	local function guardMethods(av, aw)
		for ax, ay in pairs(av) do
			if type(ax) == "string" and type(ay) == "function" and ax:sub(1, 1) ~= "_" then
				av[ax] = function(az, ...)
					if type(az) ~= "table" or getmetatable(az) ~= av then
						error(("%s%s.%s(...) was called with a dot. Write %s:%s(...) with a colon instead.")
							:format(i.LOG_PREFIX, aw, ax, aw, ax), 2)
					end
					return ay(az, ...)
				end
			end
		end
	end
	guardMethods(K, "Tab")
	guardMethods(aa, "Window")
end
end
installFeatures()

return h
