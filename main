local function log(message)
	warn(LOG_PREFIX .. tostring(message))
end

local function normalizeOptions(input, aliases)
	local options = {}
	if type(input) == "string" then
		options.Name = input
	elseif type(input) == "table" then
		for key, value in pairs(input) do
			options[key] = value
		end
	end
	for alias, canonical in pairs(aliases or {}) do
		if options[canonical] == nil and options[alias] ~= nil then
			options[canonical] = options[alias]
		end
	end
	if type(options.Range) == "table" then
		options.Min = options.Min or options.Range[1]
		options.Max = options.Max or options.Range[2]
	end
	return options
end

local function safeCall(callback, ...)
	if type(callback) ~= "function" then
		return
	end
	local ok, err = pcall(callback, ...)
	if not ok then
		log("callback error: " .. tostring(err))
	end
end

