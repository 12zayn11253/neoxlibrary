function h:Popup(af)
	local ah = normalizeOptions(af, { Text = "Content", Message = "Content" })
	local ai = h.Windows[#h.Windows]
	local aj
	local ak = ai and ai.Gui
	if not ak then
		aj = create("ScreenGui", {
			Name = i.GUI_NAME .. "Popup",
			IgnoreGuiInset = true,
			ResetOnSpawn = false,
			DisplayOrder = 1000,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
			Parent = getGuiParent(),
		})
		ak = aj
	end

	local al = create("TextButton", {
		Name = "Popup",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 200,
		Parent = ak,
	})
	local am = create("CanvasGroup", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 12),
		Size = UDim2.fromOffset(340, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = u.Background,
		BorderSizePixel = 0,
		GroupTransparency = 1,
		ZIndex = 201,
		Parent = al,
	})
	addCorner(am, UDim.new(0, 10))
	addStroke(am, u.Stroke)
	addTopHighlight(am)
	addPadding(am, 18, 18, 16, 16)
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 10),
		Parent = am,
	})

	local an = create("Frame", {
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		ZIndex = 202,
		Parent = am,
	})
	local ao = 0
	if ah.Icon then
		local ap, aq = createIcon(an, ah.Icon, u.Accent, UDim2.new(0, 0, 0.5, 0))
		ap.ZIndex = 202
		aq.ZIndex = 202
		ao = 26
	end
	createLabel({
		Position = UDim2.fromOffset(ao, 0),
		Size = UDim2.new(1, -ao, 1, 0),
		Text = tostring(ah.Title or i.LIB_NAME),
		TextSize = 16,
		FontFace = w.Bold,
		ZIndex = 202,
		Parent = an,
	})

	if ah.Content then
		createLabel({
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Text = tostring(ah.Content),
			TextSize = 13,
			FontFace = w.Regular,
			TextColor3 = u.Muted,
			TextWrapped = true,
			TextTruncate = Enum.TextTruncate.None,
			TextYAlignment = Enum.TextYAlignment.Top,
			LayoutOrder = 2,
			ZIndex = 202,
			Parent = am,
		})
	end

	local ap = create("Frame", {
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundTransparency = 1,
		LayoutOrder = 3,
		ZIndex = 202,
		Parent = am,
	})
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		Parent = ap,
	})

	local aq = {}
	local ar = false
	function aq.Close()
		if ar then
			return
		end
		ar = true
		tween(al, { BackgroundTransparency = 1 }, 0.18)
		tween(am, { GroupTransparency = 1, Position = UDim2.new(0.5, 0, 0.5, 8) }, 0.18, Enum.EasingStyle.Quint)
		task.delay(0.2, function()
			al:Destroy()
			if aj then
				aj:Destroy()
			end
		end)
	end

	local as = ah.Buttons
	if type(as) ~= "table" or #as == 0 then
		as = { { Title = "OK", Variant = "Primary" } }
	end
	for at, au in ipairs(as) do
		local av = i.POPUP_VARIANTS[au.Variant] and au.Variant or "Secondary"
		local aw = av == "Primary"
		local ax = av == "Tertiary"
		local ay = create("TextButton", {
			Size = UDim2.fromOffset(0, 32),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = aw and u.Accent or u.Surface2,
			BackgroundTransparency = ax and 1 or 0,
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = at,
			ZIndex = 203,
			Parent = ap,
		})
		addCorner(ay, UDim.new(0, 7))
		if not aw and not ax then
			addStroke(ay, u.Stroke)
		end
		addPadding(ay, 14, 14)
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 6),
			Parent = ay,
		})
		createLabel({
			Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X,
			Text = tostring(au.Title or au.Name or "OK"),
			TextSize = 13,
			TextColor3 = aw and u.AccentDark or (ax and u.Muted or u.Text),
			TextTruncate = Enum.TextTruncate.None,
			LayoutOrder = 1,
			ZIndex = 204,
			Parent = ay,
		})
		if au.Icon then
			local az = create("ImageLabel", {
				Size = UDim2.fromOffset(14, 14),
				BackgroundTransparency = 1,
				ImageColor3 = aw and u.AccentDark or u.Text,
				ScaleType = Enum.ScaleType.Fit,
				LayoutOrder = 2,
				ZIndex = 204,
				Parent = ay,
			})
			if not setIcon(az, au.Icon) then
				az:Destroy()
			end
		end
		ay.MouseButton1Click:Connect(function()
			aq.Close()
			runProtected(('popup button "%s"'):format(tostring(au.Title or au.Name or "Button")), au.Callback)
		end)
	end

	if ah.CloseOnBackdrop ~= false then
		al.MouseButton1Click:Connect(aq.Close)
	end

	tween(al, { BackgroundTransparency = 0.5 }, 0.25)
	tween(am, { GroupTransparency = 0, Position = UDim2.fromScale(0.5, 0.5) }, 0.3, Enum.EasingStyle.Quint)
	return aq
end

local af = {}
for ah, ai in ipairs({
	"and", "break", "do", "else", "elseif", "end", "false", "for", "function", "if", "in",
	"local", "nil", "not", "or", "repeat", "return", "then", "true", "until", "while", "continue",
}) do
	af[ai] = true
end

local ah = {}
for ai, aj in ipairs({
	"game", "workspace", "script", "print", "warn", "error", "pairs", "ipairs", "require",
	"task", "math", "string", "table", "Instance", "Vector3", "Vector2", "CFrame", "Color3",
	"UDim2", "Enum", "tostring", "tonumber", "typeof", "type", "pcall", "loadstring", "getgenv",
}) do
	ah[aj] = true
end

i.MONO_FONT = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Regular)

local function escapeRich(ai)
	return (ai:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

local function colorHex(ai)
	return string.format("#%02X%02X%02X", math.floor(ai.R * 255 + 0.5), math.floor(ai.G * 255 + 0.5), math.floor(ai.B * 255 + 0.5))
end

local function highlightLua(ai)
	local aj = {
		keyword = colorHex(u.Accent),
		global = colorHex(u.Glow),
		string = colorHex(u.Success),
		number = colorHex(u.Warning),
		comment = colorHex(u.Muted),
	}
	local ak = {}
	local function paint(al, am)
		table.insert(ak, string.format('<font color="%s">%s</font>', aj[am], escapeRich(al)))
	end
	local al, am = 1, string.len(ai)
	while al <= am do
		local an = ai:sub(al)
		local ao = an:match("^%-%-%[(=*)%[")
		if ao then
			local ap = "]" .. ao .. "]"
			local aq = ai:find(ap, al, true)
			local ar = aq and (aq + #ap - 1) or am
			paint(ai:sub(al, ar), "comment")
			al = ar + 1
		elseif an:sub(1, 2) == "--" then
			local ap = ai:find("\n", al, true)
			local aq = ap and (ap - 1) or am
			paint(ai:sub(al, aq), "comment")
			al = aq + 1
		elseif an:match("^%[=*%[") then
			local ap = an:match("^%[(=*)%[")
			local aq = "]" .. ap .. "]"
			local ar = ai:find(aq, al, true)
			local as = ar and (ar + #aq - 1) or am
			paint(ai:sub(al, as), "string")
			al = as + 1
		else
			local ap = an:sub(1, 1)
			if ap == '"' or ap == "'" then
				local aq = al + 1
				while aq <= am do
					local ar = ai:sub(aq, aq)
					if ar == "\\" then
						aq += 2
					elseif ar == ap or ar == "\n" then
						break
					else
						aq += 1
					end
				end
				paint(ai:sub(al, math.min(aq, am)), "string")
				al = aq + 1
			elseif ap:match("%d") then
				local aq = an:match("^0[xX]%x+") or an:match("^%d+%.?%d*[eE]?[%-+]?%d*")
				paint(aq, "number")
				al += #aq
			elseif ap:match("[%a_]") then
				local aq = an:match("^[%w_]+")
				if af[aq] then
					paint(aq, "keyword")
				elseif ah[aq] then
					paint(aq, "global")
				else
					table.insert(ak, escapeRich(aq))
				end
				al += #aq
			else
				table.insert(ak, escapeRich(ap))
				al += 1
			end
		end
	end
	return table.concat(ak)
end

local ai = setmetatable({}, { __mode = "k" })

function K:Code(aj)
	local ak = normalizeOptions(aj, { Name = "Title", Text = "Code", Content = "Code" })
	local al = tostring(ak.Code or "")

	local am = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = u.Surface2,
		BorderSizePixel = 0,
		LayoutOrder = self:_nextOrder(),
		Parent = self.List,
	})
	am:SetAttribute(i.ATTR_NO_DRAG, true)
	styleCard(am)
	addPadding(am, 12, 12, 10, 12)
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		Parent = am,
	})

	local an = create("Frame", {
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = am,
	})
	createIcon(an, "code", u.Accent, UDim2.new(0, 2, 0.5, 0))
	createLabel({
		Name = "Title",
		Position = UDim2.fromOffset(24, 0),
		Size = UDim2.new(1, -110, 1, 0),
		Text = tostring(ak.Name or "Code"),
		Parent = an,
	})

	local ao = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(0, 22),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = u.Surface,
		Text = "",
		AutoButtonColor = false,
		Parent = an,
	})
	addCorner(ao, UDim.new(0, 6))
	local ap = addStroke(ao)
	addPadding(ao, 8, 9)
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 5),
		Parent = ao,
	})
	local aq = create("ImageLabel", {
		Size = UDim2.fromOffset(12, 12),
		BackgroundTransparency = 1,
		ImageColor3 = u.Muted,
		ScaleType = Enum.ScaleType.Fit,
		LayoutOrder = 1,
		Parent = ao,
	})
	if not setIcon(aq, "copy") then
		aq:Destroy()
	end
	local ar = createLabel({
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = "Copy",
		TextSize = 12,
		TextColor3 = u.Muted,
		TextTruncate = Enum.TextTruncate.None,
		LayoutOrder = 2,
		Parent = ao,
	})

	local as = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = u.Background,
		BorderSizePixel = 0,
		LayoutOrder = 2,
		Parent = am,
	})
	addCorner(as, UDim.new(0, 6))
	addStroke(as)
	addPadding(as, 12, 12, 10, 10)
	local at = createLabel({
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Text = "",
		TextSize = 13,
		FontFace = i.MONO_FONT,
		TextColor3 = u.Text,
		RichText = true,
		TextWrapped = true,
		TextTruncate = Enum.TextTruncate.None,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = as,
	})

	local au = { Title = ak.Name or "Code" }
	local av = {}

	local function render()
		local aw, ax = pcall(highlightLua, al)
		at.Text = aw and ax or escapeRich(al)
	end

	function au:SetCode(aw)
		al = tostring(aw or "")
		render()
	end
	function au:GetCode()
		return al
	end
	au.Get = au.GetCode
	function au:OnCopy(aw)
		table.insert(av, aw)
	end
	function au:_rerender()
		render()
	end

	ao.MouseEnter:Connect(function()
		if x then
			return
		end
		tween(ap, { Color = u.StrokeHover }, 0.12)
		tween(ar, { TextColor3 = u.Text }, 0.12)
	end)
	ao.MouseLeave:Connect(function()
		tween(ap, { Color = u.Stroke }, 0.2)
		tween(ar, { TextColor3 = u.Muted }, 0.2)
	end)
	ao.MouseButton1Click:Connect(function()
		h:Copy(al)
		ar.Text = "Copied"
		task.delay(1.5, function()
			if ar.Parent then
				ar.Text = "Copy"
			end
		end)
		for aw, ax in ipairs(av) do
			safeCall(ax, al)
		end
	end)

	render()
	ai[au] = true
	return registerElement(self, ak, au, am, "Code")
end

function K:Space(aj)
	local ak = tonumber(aj) or (type(aj) == "table" and tonumber(aj.Size or aj.Height)) or 8
	local al = create("Frame", {
		Size = UDim2.new(1, 0, 0, ak),
		BackgroundTransparency = 1,
		LayoutOrder = self:_nextOrder(),
		Parent = self.List,
	})
	return registerElement(self, {}, {}, al, "Space")
end

function K:Stat(aj)
	local ak = normalizeOptions(aj, { Title = "Name", Text = "Value" })
	local al = ak.Desc and i.ROW_HEIGHT_DESC or i.ROW_HEIGHT
	local am, an = createCard(self, "Frame", al)
	bindHoverStroke(am, an)

	local ao = 14
	if ak.Icon then
		createIcon(am, ak.Icon, u.Accent, UDim2.new(0, 14, 0.5, 0))
		ao = 40
	end
	local ap, aq = createTitleBlock(am, ak.Name or "Stat", ak.Desc, 150)
	for ar, as in ipairs({ ap, aq }) do
		as.Position += UDim2.fromOffset(ao - 14, 0)
		as.Size -= UDim2.fromOffset(ao - 14, 0)
	end

	local ar = createLabel({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.new(0, 140, 0, 20),
		Text = tostring(ak.Value or "-"),
		TextSize = 14,
		FontFace = w.Bold,
		TextColor3 = ak.Color or u.Accent,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = am,
	})

	local as = { Value = ak.Value, _listeners = {} }
	function as:Set(at)
		as.Value = at
		local au = tostring(at)
		if ar.Text ~= au then
			ar.Text = au
		end
	end
	as.SetValue = as.Set
	function as:Get()
		return as.Value
	end
	function as:SetColor(at)
		ar.TextColor3 = at
	end

	if type(ak.Update) == "function" then
		local at = math.max(tonumber(ak.UpdateRate) or 1, 0.05)
		local au = true
		table.insert(as._listeners, function()
			au = false
		end)
		task.spawn(function()
			while au and am.Parent do
				local av, aw = pcall(ak.Update)
				if av and aw ~= nil then
					as:Set(aw)
				end
				task.wait(at)
			end
		end)
	end

	return registerElement(self, ak, as, am, "Stat")
end

function K:Image(aj)
	local ak = normalizeOptions(aj, { Title = "Name", Text = "Caption", Desc = "Caption" })
	local al = tonumber(ak.Height) or 150

	local am = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = u.Surface2,
		BorderSizePixel = 0,
		LayoutOrder = self:_nextOrder(),
		Parent = self.List,
	})
	am:SetAttribute(i.ATTR_NO_DRAG, true)
	styleCard(am)
	addPadding(am, 8, 8, 8, 8)
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		Parent = am,
	})

	local an = create("ImageLabel", {
		Size = UDim2.new(1, 0, 0, al),
		BackgroundColor3 = u.Background,
		ScaleType = ak.ScaleType or Enum.ScaleType.Fit,
		LayoutOrder = 1,
		Parent = am,
	})
	an:SetAttribute(i.ATTR_NO_THEME, true)
	addCorner(an, UDim.new(0, 6))
	setIcon(an, ak.Image or ak.Icon)

	local ao
	if ak.Name or ak.Caption then
		ao = createLabel({
			Name = "Title",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Text = tostring(ak.Caption or ak.Name),
			TextSize = 12,
			FontFace = w.Regular,
			TextColor3 = u.Muted,
			TextWrapped = true,
			TextTruncate = Enum.TextTruncate.None,
			LayoutOrder = 2,
			Parent = am,
		})
		addPadding(ao, 4, 4)
	end

	local ap = {}
	function ap:SetImage(aq)
		setIcon(an, aq)
	end
	function ap:SetHeight(aq)
		an.Size = UDim2.new(1, 0, 0, tonumber(aq) or al)
	end
	return registerElement(self, ak, ap, am, "Image")
end

function aa:FloatingButton(aj)
	local ak = self
	local al = normalizeOptions(aj, { Name = "Title", Text = "Title" })
	local am = al.Toggle
	local an = #(self._floating or {})
	self._floating = self._floating or {}

	local ao = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = al.Position or UDim2.new(1, -16, 0.5, an * (x and 52 or 44)),
		Size = UDim2.fromOffset(0, x and 44 or 36),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = u.Background,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 60,
		Parent = self.Gui,
	})
	addCorner(ao, UDim.new(1, 0))
	local ap = addStroke(ao, u.Stroke)
	addPadding(ao, 12, 14)
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 7),
		Parent = ao,
	})

	local aq = create("Frame", {
		Size = UDim2.fromOffset(8, 8),
		BackgroundColor3 = u.Muted,
		BorderSizePixel = 0,
		LayoutOrder = 1,
		Visible = am ~= nil,
		ZIndex = 61,
		Parent = ao,
	})
	addCorner(aq, UDim.new(1, 0))

	if al.Icon then
		local ar = create("ImageLabel", {
			Size = UDim2.fromOffset(16, 16),
			BackgroundTransparency = 1,
			ImageColor3 = u.Accent,
			ScaleType = Enum.ScaleType.Fit,
			LayoutOrder = 2,
			ZIndex = 61,
			Parent = ao,
		})
		if not setIcon(ar, al.Icon) then
			ar:Destroy()
		end
	end

	local ar = createLabel({
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = tostring(al.Title or "Button"),
		TextSize = 13,
		TextTruncate = Enum.TextTruncate.AtEnd,
		LayoutOrder = 3,
		ZIndex = 61,
		Parent = ao,
	})

	create("UISizeConstraint", { MaxSize = Vector2.new(x and 140 or 220, math.huge), Parent = ar })

	local as = { Frame = ao }

	local function renderState()
		if not am then
			return
		end
		local at = am:Get() == true
		tween(aq, { BackgroundColor3 = at and u.Success or u.Muted }, 0.15)
		tween(ap, { Color = at and u.Accent or u.Stroke }, 0.15)
	end

	local function press()
		if am and type(am.Set) == "function" then
			if not am.Locked then
				am:Set(not am:Get())
			end
		else
			runProtected(('on-screen button "%s"'):format(tostring(al.Title or "Button")), al.Callback)
		end
		renderState()
		local at = create("UIScale", { Scale = 0.94, Parent = ao })
		tween(at, { Scale = 1 }, 0.2, Enum.EasingStyle.Back)
		task.delay(0.21, function()
			at:Destroy()
		end)
	end

	self:_makeDraggable(ao, press)
	table.insert(self._overlays, ao)
	table.insert(self._floating, as)

	if am then
		task.spawn(function()
			local at
			while ao.Parent and not am._destroyed do
				local au = am:Get() == true
				if au ~= at then
					at = au
					renderState()
				end
				task.wait(0.2)
			end
			if ao.Parent and am._destroyed then
				as:Destroy()
			end
		end)
	end

	function as:SetTitle(at)
		setTranslated(ar, "Text", tostring(at))
	end
	function as:SetVisible(at)
		ao.Visible = at ~= false
	end
	function as:Destroy()
		local at = table.find(ak._floating, as)
		if at then
			table.remove(ak._floating, at)
		end
		at = table.find(ak._overlays, ao)
		if at then
			table.remove(ak._overlays, at)
		end
		ao:Destroy()
	end

	if al.Visible == false or (al.TouchOnly and not x) then
		as:SetVisible(false)
	end
	renderState()
	return as
end
aa.MobileButton = aa.FloatingButton

function aa:_miniBar()
	if self._miniBarFrame then
		return self._miniBarFrame
	end
	local aj = self._miniOptions or {}
	local function shown(ak)
		if aj[ak] == false then
			return false
		end
		if type(aj.Hide) == "table" then
			for al, am in pairs(aj.Hide) do
				if am == ak or (al == ak and am == true) then
					return false
				end
			end
		end
		return true
	end
	local ak = create("Frame", {
		Name = "MinimizedBar",
		Size = UDim2.fromOffset(0, 50),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = u.Background,
		BorderSizePixel = 0,
		Active = true,
		Visible = false,
		ZIndex = 40,
		Parent = self.Gui,
	})
	addCorner(ak, UDim.new(0, 12))
	addStroke(ak)
	addPadding(ak, 10, 7)
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 10),
		Parent = ak,
	})
	local al = create("ImageLabel", {
		Size = UDim2.fromOffset(28, 28),
		BackgroundTransparency = 1,
		ImageColor3 = Color3.new(1, 1, 1),
		ScaleType = Enum.ScaleType.Fit,
		LayoutOrder = 1,
		Visible = shown("Logo"),
		ZIndex = 41,
		Parent = ak,
	})
	al.Image = self._logo.Image
	al.ImageColor3 = self._logo.ImageColor3
	al.ImageRectOffset = self._logo.ImageRectOffset
	al.ImageRectSize = self._logo.ImageRectSize

	local am = create("Frame", {
		Name = "Text",
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		ZIndex = 41,
		Parent = ak,
	})
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 1),
		Parent = am,
	})
	local an = createLabel({
		Name = "Title",
		Size = UDim2.fromOffset(0, 17),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = self._titleLabel.Text,
		TextSize = 14,
		TextTruncate = Enum.TextTruncate.None,
		LayoutOrder = 1,
		Visible = shown("Title"),
		ZIndex = 41,
		Parent = am,
	})
	create("UISizeConstraint", { MaxSize = Vector2.new(i.MINI_TEXT_WIDTH, 17), Parent = an })
	local ao = createLabel({
		Name = "Info",
		Size = UDim2.fromOffset(0, 14),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = "",
		TextSize = 11,
		FontFace = w.Regular,
		TextColor3 = u.Muted,
		TextTruncate = Enum.TextTruncate.AtEnd,
		LayoutOrder = 2,
		ZIndex = 41,
		Parent = am,
	})
	create("UISizeConstraint", { MaxSize = Vector2.new(i.MINI_TEXT_WIDTH, 14), Parent = ao })

	local ap = create("Frame", {
		Name = "Active",
		Size = UDim2.fromOffset(0, 22),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = u.Surface2,
		BorderSizePixel = 0,
		LayoutOrder = 3,
		Visible = false,
		ZIndex = 41,
		Parent = ak,
	})
	addCorner(ap, UDim.new(1, 0))
	addStroke(ap)
	addPadding(ap, 8, 9)
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6),
		Parent = ap,
	})
	local aq = create("Frame", {
		Size = UDim2.fromOffset(6, 6),
		BackgroundColor3 = u.Success,
		BorderSizePixel = 0,
		LayoutOrder = 1,
		ZIndex = 42,
		Parent = ap,
	})
	addCorner(aq, UDim.new(1, 0))
	local ar = createLabel({
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = "",
		TextSize = 11,
		TextTruncate = Enum.TextTruncate.None,
		LayoutOrder = 2,
		ZIndex = 42,
		Parent = ap,
	})

	local as = createLabel({
		Name = "Stats",
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = "",
		TextSize = 11,
		FontFace = w.Regular,
		TextColor3 = u.Muted,
		TextTruncate = Enum.TextTruncate.None,
		LayoutOrder = 5,
		Visible = shown("Stats"),
		ZIndex = 41,
		Parent = ak,
	})

	local at = {}
	for au, av in ipairs(type(aj.Toggles) == "table" and aj.Toggles or {}) do
		local aw = type(av) == "table" and av.Flag or av
		local ax = create("TextButton", {
			Name = "Toggle",
			Size = UDim2.fromOffset(0, 24),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = u.Surface2,
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = 4,
			Visible = false,
			ZIndex = 41,
			Parent = ak,
		})
		addCorner(ax, UDim.new(1, 0))
		local ay = addStroke(ax)
		addPadding(ax, 10, 10)
		local az = createLabel({
			Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X,
			Text = "",
			TextSize = 11,
			TextColor3 = u.Muted,
			TextTruncate = Enum.TextTruncate.None,
			ZIndex = 42,
			Parent = ax,
		})
		ax.MouseButton1Click:Connect(function()
			local aA = self.Flags[tostring(aw)]
			if aA and aA.Set and not aA._destroyed then
				aA:Set(aA.Value ~= true)
				if self._miniRefresh then
					self._miniRefresh()
				end
			end
		end)
		table.insert(at, {
			Flag = tostring(aw),
			Title = type(av) == "table" and (av.Title or av.Name) or nil,
			Button = ax,
			Stroke = ay,
			Label = az,
		})
	end

	local function barButton(au, av, aw, ax)
		local ay = create("TextButton", {
			Name = av,
			Size = UDim2.fromOffset(32, 32),
			BackgroundColor3 = u.Surface2,
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = au,
			ZIndex = 41,
			Parent = ak,
		})
		addCorner(ay, UDim.new(0, 8))
		local az = create("ImageLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(16, 16),
			BackgroundTransparency = 1,
			ImageColor3 = u.Muted,
			ScaleType = Enum.ScaleType.Fit,
			ZIndex = 42,
			Parent = ay,
		})
		setIcon(az, aw)
		ay.MouseEnter:Connect(function()
			if x then
				return
			end
			tween(ay, { BackgroundTransparency = 0 }, 0.15)
			tween(az, { ImageColor3 = u.Text }, 0.15)
		end)
		ay.MouseLeave:Connect(function()
			tween(ay, { BackgroundTransparency = 1 }, 0.2)
			tween(az, { ImageColor3 = u.Muted }, 0.2)
		end)
		ay.MouseButton1Click:Connect(ax)
		return ay
	end
	for au, av in ipairs(type(aj.Buttons) == "table" and aj.Buttons or {}) do
		if type(av) == "table" then
			local aw = barButton(6, "Custom" .. au, av.Icon or "circle", function()
				safeCall(av.Callback)
			end)
			if av.Tooltip or av.Title then
				aw.MouseEnter:Connect(function()
					self:_showTooltip(tostring(av.Tooltip or av.Title), aw)
				end)
				aw.MouseLeave:Connect(function()
					self:_hideTooltip(aw)
				end)
			end
		end
	end
	barButton(7, "Restore", "maximize-2", function()
		self:Minimize(false)
	end).Visible = shown("Restore")
	barButton(8, "Close", "x", function()
		self:RequestClose()
	end).Visible = shown("Close")

	local au, av = 0, os.clock()
	local function refresh()
		an.Text = self._titleLabel.Text
		local aw = self._miniText
		if type(aw) == "function" then
			local ax, ay = pcall(aw)
			aw = ax and ay or nil
		end
		if aw == nil or tostring(aw) == "" then
			aw = self._subtitleLabel.Text
		end
		ao.Text = tostring(aw or "")
		ao.Visible = ao.Text ~= "" and shown("Text")

		for ax, ay in ipairs(at) do
			local az = self.Flags[ay.Flag]
			local aA = az ~= nil and not az._destroyed and az.Set ~= nil
			ay.Button.Visible = aA
			if aA then
				local aB = az.Value == true
				ay.Label.Text = ay.Title or (az._label and az._label:match('^%w+ "(.*)"$')) or ay.Flag
				ay.Label.TextColor3 = aB and u.Text or u.Muted
				ay.Stroke.Color = aB and u.Accent or u.Stroke
			end
		end

		local ax = 0
		if shown("Active") then
			for ay, az in ipairs(self._elements) do
				if az._type == "Toggle" and az.Value == true and not az._destroyed then
					ax += 1
				end
			end
		end
		ap.Visible = ax > 0
		ar.Text = ax .. " on"

		if as.Visible then
			local ay = os.clock()
			local az = math.floor(au / math.max(ay - av, 0.001) + 0.5)
			au, av = 0, ay
			local aA, aB = pcall(function()
				return math.floor(g:GetNetworkPing() * 1000)
			end)
			as.Text = ("%d fps  ·  %d ms"):format(math.min(az, 999), aA and aB or 0)
		end
	end

	self:_makeDraggable(ak, function()
		self:Minimize(false)
	end)
	self._miniBarFrame = ak
	self._miniBarTitle = an
	self._miniBarInfo = ao
	self._miniBarLogo = al
	self._miniRefresh = refresh
	self._miniCount = function()
		au += 1
	end
	return ak
end

function aa:_startMiniLoop()
	if self._miniStop then
		self._miniStop()
	end
	local aj = self:_listen("Render", self._miniCount)
	local ak = true
	self._miniStop = function()
		ak = false
		aj()
		self._miniStop = nil
	end
	task.spawn(function()
		while ak and not self._destroyed do
			task.wait(1)
			if ak and self.Minimized then
				self._miniRefresh()
			end
		end
	end)
end

function aa:AddHomePage(aj, ak, al)
	if not self._addHomePage then
		log("AddHomePage needs the Home tab. Remove Home = false from your window to use it.")
		return nil
	end
	local am = aj
	if type(aj) == "string" then
		am = { Title = aj }
		for an, ao in ipairs({ ak, al }) do
			if type(ao) == "function" then
				am.Build = ao
			elseif type(ao) == "table" then
				am.Entries = ao
			elseif type(ao) == "string" then
				if am.Content == nil then
					am.Content = ao
				else
					am.Icon = ao
				end
			end
		end
	end
	if type(am) ~= "table" then
		return nil
	end
	local an = self._addHomePage(am)
	return an and an.Frame or nil
end

function aa:SelectHomePage(aj)
	if not self._showHomePage or not self._homePages then
		return false
	end
	local ak = tonumber(aj)
	if not ak then
		for al, am in ipairs(self._homePages) do
			if am.Title == aj then
				ak = al
			end
		end
	end
	if not ak or not self._homePages[ak] then
		return false
	end
	self._showHomePage(ak)
	return true
end

function h:SetAnimations(aj)
	h.Animations = aj == true
end

function aa:RequestClose()
	if self._destroyed then
		return
	end
	if self._closeAction == "Hide" then
		self:Toggle(false)
		return
	end
	if not self._confirmClose then
		h:Destroy()
		return
	end
	if self.Minimized then
		self:Minimize(false)
	end
	if not self.Open then
		self:Toggle(true)
	end
	self:Dialog({
		Title = "Unload " .. tostring(self._titleLabel.Text ~= "" and self._titleLabel.Text or i.LIB_NAME) .. "?",
		Content = "This closes the menu and turns off everything it was running. Run the script again to bring it back.",
		Icon = "power",
		Buttons = {
			{ Title = "Cancel" },
			{ Title = "Unload", Variant = "Primary", Callback = function()
				task.defer(function()
					h:Destroy()
				end)
			end },
		},
	})
end

function aa:SetMinimizedBar(aj)
	if type(aj) ~= "table" then
		return
	end
	self._miniOptions = self._miniOptions or {}
	for ak, al in pairs(aj) do
		self._miniOptions[ak] = al
	end
	if aj.Text ~= nil then
		self._miniText = aj.Text
	end
	local ak = self._miniBarFrame
	if not ak then
		return
	end
	local al = ak.Position
	local am = self.Minimized
	self._miniBarFrame = nil
	ak:Destroy()
	local an = self:_miniBar()
	an.Position = al
	if am then
		an.Visible = true
		self._miniRefresh()
		self:_startMiniLoop()
	end
end

function aa:SetMinimizedText(aj)
	self._miniText = aj
	if self.Minimized and self._miniRefresh then
		self._miniRefresh()
	end
end

function aa:Minimize(aj)
	if aj == nil then
		aj = not self.Minimized
	end
	aj = aj == true
	if self._destroyed or not self._introDone or aj == (self.Minimized == true) then
		return
	end
	if aj and not self.Open then
		return
	end
	local ak = self.Root
	local al = self:_miniBar()
	self:_hideTooltip()
	if aj then
		self.Minimized = true
		self._miniBarTitle.Text = self._titleLabel.Text
		self._miniBarLogo.Image = self._logo.Image
		self._miniRefresh()
		local am = ak.AbsolutePosition - self.Gui.AbsolutePosition
		al.Position = UDim2.fromOffset(math.max(am.X, 8), math.max(am.Y, 8))
		ak.Visible = false
		al.Visible = true
		self:_startMiniLoop()
	else
		self.Minimized = false
		if self._miniStop then
			self._miniStop()
		end
		al.Visible = false
		local am = al.AbsolutePosition - self.Gui.AbsolutePosition
		local an = ak.AbsoluteSize
		ak.Position = UDim2.fromOffset(am.X + an.X * ak.AnchorPoint.X, am.Y + an.Y * ak.AnchorPoint.Y)
		ak.Visible = true
		self:_clampToScreen()
	end
	for am, an in ipairs(self._events[aj and "Close" or "Open"]) do
		task.spawn(safeCall, an)
	end
end

function aa:Restore()
	self:Minimize(false)
end

do
	local aj = {
		"No key system, no checkpoints",
		"Instant access every time you play",
		"Supports future updates",
	}
	local ak = "NucleusUI/premium.json"

	local function isFreeUser(al)
		local am = h._getKeyStatus()
		if al._premium and al._premium.ShowWithoutKey then
			return not am.Premium
		end
		return am.HasKey and not am.Premium
	end

	local function readLastShown()
		local al, am = pcall(function()
			if type(isfile) == "function" and isfile(ak) then
				return tonumber(e:JSONDecode(readfile(ak)).LastShown)
			end
		end)
		return al and am or nil
	end

	local function writeLastShown(al)
		pcall(function()
			if type(writefile) ~= "function" then
				return
			end
			if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder("NucleusUI") then
				makefolder("NucleusUI")
			end
			writefile(ak, e:JSONEncode({ LastShown = al }))
		end)
	end

	function h:IsPremium()
		return h._getKeyStatus().Premium == true
	end

	function h:GetKeyStatus()
		return h._getKeyStatus()
	end

	function aa:_premiumClicked(al)
		local am = self._premium
		if not am then
			return
		end
		h:Copy(am.Link)
		safeCall(am.OnClick, al)
	end

	function aa:ShowPremium(al)
		local am = self._premium
		if not am or self._destroyed then
			return nil
		end
		local an = {}
		if am.Text then
			table.insert(an, tostring(am.Text))
			table.insert(an, "")
		end
		for ao, ap in ipairs(am.Perks) do
			table.insert(an, "•  " .. tostring(ap))
		end
		if am.Price then
			table.insert(an, "")
			table.insert(an, tostring(am.Price))
		end
		safeCall(am.OnShown, al or "manual")
		return h:Popup({
			Title = am.Title,
			Icon = "crown",
			Content = table.concat(an, "\n"),
			Buttons = {
				{ Title = "Not now", Variant = "Tertiary" },
				{ Title = am.ButtonText or "Get Premium", Icon = "crown", Variant = "Primary", Callback = function()
					self:_premiumClicked(al or "popup")
				end },
			},
		})
	end

	function aa:_setupPremium(al)
		local am = al.Premium
		if am == false then
			return
		end
		am = type(am) == "table" and am or {}
		local an = type(al.Home) == "table" and al.Home or {}
		local ao = (type(al.Membership) == "table" and al.Membership) or (type(an.Key) == "table" and an.Key) or {}
		local ap = am.Link or ao.PremiumLink
		if type(ap) ~= "string" or ap == "" then
			return
		end
		self._premium = {
			Link = ap,
			Title = am.Title or "Go Premium",
			Text = am.Text,
			Perks = type(am.Perks) == "table" and am.Perks or aj,
			Price = am.Price,
			ButtonText = am.ButtonText,
			ShowWithoutKey = am.ShowWithoutKey == true,
			OnClick = am.OnClick,
			OnShown = am.OnShown,
		}

		if am.HeaderButton ~= false then
			local aq = self:HeaderButton({
				Icon = "crown",
				Tooltip = "Get Premium",
				Callback = function()
					self:ShowPremium("header")
				end,
			})
			aq.Frame.Visible = isFreeUser(self)
			task.spawn(function()
				while not self._destroyed and aq.Frame.Parent do
					aq.Frame.Visible = isFreeUser(self)
					task.wait(3)
				end
			end)
		end

		if am.Popup ~= false then
			local aq = math.max(tonumber(am.PopupDelay) or 600, 5)
			local ar = tonumber(am.Cooldown) or 86400
			task.delay(aq, function()
				if self._destroyed or not isFreeUser(self) then
					return
				end
				local as = readLastShown()
				local at = os.time()
				if as and at - as < ar then
					return
				end
				writeLastShown(at)
				self:ShowPremium("timer")
			end)
		end
	end

	function K:PremiumBanner(al)
		local am = normalizeOptions(al, { Title = "Text", Name = "Text", Content = "Text" })
		local an = self.Window
		local ao = create("Frame", {
			Size = UDim2.new(1, 0, 0, i.ROW_HEIGHT),
			BackgroundColor3 = u.Surface2,
			BorderSizePixel = 0,
			LayoutOrder = self:_nextOrder(),
			Parent = self.List,
		})
		ao:SetAttribute(i.ATTR_NO_DRAG, true)
		addCorner(ao)
		local ap = addStroke(ao, u.Accent, 1)
		ap.Transparency = 0.6
		createIcon(ao, "crown", u.Accent, UDim2.new(0, 14, 0.5, 0))
		local aq = createLabel({
			Name = "Title",
			Position = UDim2.fromOffset(40, 0),
			Size = UDim2.new(1, -150, 1, 0),
			Text = tostring(am.Text or "Premium: no key system, instant access"),
			TextSize = 13,
			Parent = ao,
		})
		local ar = create("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(0, 26),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = u.Accent,
			BorderSizePixel = 0,
			Text = "",
			AutoButtonColor = false,
			Parent = ao,
		})
		ar:SetAttribute(i.ATTR_NO_DRAG, true)
		addCorner(ar, UDim.new(0, 6))
		addPadding(ar, 12, 12)
		createLabel({
			Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X,
			Text = tostring(am.ButtonText or "Get Premium"),
			TextSize = 12,
			TextColor3 = u.AccentDark,
			TextTruncate = Enum.TextTruncate.None,
			Parent = ar,
		})
		ar.MouseButton1Click:Connect(function()
			if am.Link then
				h:Copy(am.Link)
			elseif an._premium then
				an:ShowPremium("banner")
			end
		end)

		local as = {}
		function as:SetText(at)
			setTranslated(aq, "Text", tostring(at))
		end
		local at = registerElement(self, am, as, ao, "PremiumBanner")
		local function refresh()
			local au = h._getKeyStatus()
			local av = not au.Premium and (au.HasKey or am.ShowWithoutKey == true)
			ao.Visible = as.Visible ~= false and av
		end
		refresh()
		task.spawn(function()
			while ao.Parent and not an._destroyed do
				task.wait(3)
				refresh()
			end
		end)
		return at
	end
	K.CreatePremiumBanner = K.PremiumBanner
end

function aa:SetSidebarCollapsed(aj)
	self._sidebarCollapsed = aj == true
	self:_setCompact(self._autoCompact == true or self._sidebarCollapsed, self._introDone == true)
end

function aa:ToggleSidebar()
	self:SetSidebarCollapsed(not self._compact)
end

function aa:IsSidebarCollapsed()
	return self._compact == true
end

function aa:Popup(aj)
	return h:Popup(aj)
end

do
	local function startLoop(aj, ak, al, am, an)
		local ao = { Running = true }
		function ao:Stop()
			ao.Running = false
		end
		ao.Disconnect = ao.Stop
		if type(al) ~= "function" then
			ao.Running = false
			return ao
		end
		table.insert(ak, ao)
		task.spawn(function()
			local ap = 0
			while ao.Running and not aj._destroyed do
				local aq, ar = xpcall(al, captureError)
				if not aq then
					ap += 1
					ao.Errors = ap
					if ap == 1 or ap % 100 == 0 then
						reportError(an or "a loop", ar)
					end
				end
				if not ao.Running or aj._destroyed then
					break
				end
				local as = am
				if type(as) == "function" then
					local at, au = pcall(as)
					as = at and au or 0
				end
				as = tonumber(as) or 0
				if as > 0 then
					task.wait(as)
				else
					task.wait()
				end
			end
			ao.Running = false
			local aq = table.find(ak, ao)
			if aq then
				table.remove(ak, aq)
			end
		end)
		return ao
	end

	function aa:Loop(aj, ak, al)
		if type(aj) ~= "function" then
			log("Loop needs a function, but got a " .. typeof(aj) .. ".")
		end
		return startLoop(self, self._loops, aj, ak, al and ("loop \"" .. tostring(al) .. "\"") or nil)
	end

	function aa:Connect(aj, ak)
		assert(aj and type(ak) == "function", i.LOG_PREFIX .. "Connect needs a signal and a function")
		local al = aj:Connect(function(...)
			if not self._destroyed then
				runProtected("a connected event", ak, ...)
			end
		end)
		table.insert(self._connections, al)
		return al
	end

	function aa:Spawn(aj, ...)
		local ak = task.spawn(runProtected, "a spawned task", aj, ...)
		self:OnDestroy(function()
			if coroutine.status(ak) ~= "dead" then
				pcall(task.cancel, ak)
			end
		end)
		return ak
	end

	aa.OnUnload = aa.OnDestroy

	local aj = { _destroyed = false }
	local ak = {}

	function h:Loop(al, am)
		local an = h.Windows[#h.Windows]
		if an then
			return an:Loop(al, am)
		end
		local ao = startLoop(aj, ak, al, am)
		table.insert(h._cleanup, function()
			ao:Stop()
		end)
		return ao
	end

	function h:Connect(al, am)
		local an = h.Windows[#h.Windows]
		if an then
			return an:Connect(al, am)
		end
		local ao = al:Connect(function(...)
			safeCall(am, ...)
		end)
		table.insert(h._cleanup, function()
			ao:Disconnect()
		end)
		return ao
	end

	function h:OnUnload(al)
		if type(al) == "function" then
			table.insert(h._cleanup, al)
		end
	end

	function h:GetValues()
		local al = {}
		for am, an in pairs(h.Flags) do
			if type(an.Get) == "function" then
				local ao, ap = pcall(an.Get, an)
				if ao then
					al[am] = ap
				end
			end
		end
		return al
	end

	function h:SetValues(al)
		if type(al) ~= "table" then
			return
		end
		for am, an in pairs(al) do
			h:SetValue(am, an)
		end
	end
end

do
	local function isTruthy(aj)
		if type(aj) == "table" then
			return next(aj) ~= nil
		elseif type(aj) == "string" then
			return aj ~= ""
		elseif type(aj) == "number" then
			return aj ~= 0
		end
		return aj ~= nil and aj ~= false
	end

	local function matches(aj, ak)
		if ak == nil then
			return isTruthy(aj)
		end
		if type(ak) == "table" then
			for al, am in ipairs(ak) do
				if matches(aj, am) then
					return true
				end
			end
			return false
		end
		if type(aj) == "table" then
			return table.find(aj, ak) ~= nil
		end
		if typeof(aj) == "EnumItem" and type(ak) == "string" then
			return aj.Name == ak
		end
		return aj == ak
	end

	local function flagValue(aj, ak)
		local al = aj.Flags[ak] or h.Flags[ak]
		if al and type(al.Get) == "function" then
			local am, an = pcall(al.Get, al)
			if am then
				return an
			end
		elseif al == nil then
			aj._missingDependencies = aj._missingDependencies or {}
			if not aj._missingDependencies[ak] then
				aj._missingDependencies[ak] = true
				task.delay(3, function()
					if not aj._destroyed and aj.Flags[ak] == nil and h.Flags[ak] == nil then
						log(('DependsOn uses the Flag "%s", but no element has that Flag. Check the spelling.'):format(tostring(ak)))
					end
				end)
			end
		end
		return nil
	end

	local function evaluate(aj, ak)
		if type(ak) == "function" then
			local al, am = pcall(ak)
			return al and am and true or false
		elseif type(ak) == "string" then
			return isTruthy(flagValue(aj, ak))
		elseif type(ak) == "table" then
			if ak.Flag ~= nil then
				local al = matches(flagValue(aj, ak.Flag), ak.Value)
				if ak.Not then
					al = not al
				end
				return al
			end
			for al, am in ipairs(ak) do
				if not evaluate(aj, am) then
					return false
				end
			end
		end
		return true
	end

	function aa:_queueDependencies()
		if self._dependencyQueued or self._destroyed or #self._dependents == 0 then
			return
		end
		self._dependencyQueued = true
		task.defer(function()
			self._dependencyQueued = false
			if not self._destroyed then
				self:_refreshDependencies()
			end
		end)
	end

	function aa:_refreshDependencies()
		for aj, ak in ipairs(table.clone(self._dependents)) do
			if not ak._destroyed and type(ak.SetVisible) == "function" then
				local al = evaluate(self, ak._dependsOn)
				if ak._dependencyShown ~= al then
					ak._dependencyShown = al
					ak:SetVisible(al)
				end
			end
		end
	end
end

function K:Clear()
	local aj = self.Window
	if not aj or not self.List then
		return 0
	end
	local ak = {}
	for al, am in ipairs(aj._elements) do
		local an = am._frame
		if not am._destroyed and am._type ~= "KeyInfo" and typeof(an) == "Instance"
			and an:IsDescendantOf(self.List) then
			table.insert(ak, am)
		end
	end
	for al, am in ipairs(ak) do
		am:Destroy()
	end
	return #ak
end

i.BUTTON_ROW_STYLES = {
	Primary = "Accent",
	Danger = "Error",
}

function K:ButtonRow(aj)
	local ak = type(aj) == "table" and aj or {}
	local al = ak.Buttons
	if type(al) ~= "table" then
		al = {}
		for am, an in ipairs(ak) do
			table.insert(al, an)
		end
	end
	local am = math.max(#al, 1)
	local an = 8

	local ao = create("Frame", {
		Size = UDim2.new(1, 0, 0, i.ROW_HEIGHT),
		BackgroundTransparency = 1,
		LayoutOrder = self:_nextOrder(),
		Parent = self.List,
	})
	ao:SetAttribute(i.ATTR_NO_DRAG, true)
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, an),
		Parent = ao,
	})

	local ap = { Buttons = {} }
	for aq, ar in ipairs(al) do
		if type(ar) == "string" then
			ar = { Name = ar }
		end
		local as = ar.Name or ar.Title or ("Button " .. aq)
		local at = i.BUTTON_ROW_STYLES[ar.Style]
		local au = create("TextButton", {
			Name = "Button" .. aq,
			Size = UDim2.new(1 / am, -an * (am - 1) / am, 1, 0),
			BackgroundColor3 = at and u[at] or u.Surface2,
			BackgroundTransparency = at and 0.12 or 0,
			BorderSizePixel = 0,
			Text = "",
			AutoButtonColor = false,
			ClipsDescendants = true,
			LayoutOrder = aq,
			Parent = ao,
		})
		au:SetAttribute(i.ATTR_NO_DRAG, true)
		addCorner(au)
		local av = addStroke(au, at and u[at] or u.Stroke, 1)
		if at then
			av.Transparency = 0.4
			au.MouseEnter:Connect(function()
				if x then
					return
				end
				tween(au, { BackgroundTransparency = 0 }, 0.12)
				tween(av, { Transparency = 0 }, 0.12)
			end)
			au.MouseLeave:Connect(function()
				tween(au, { BackgroundTransparency = 0.12 }, 0.25)
				tween(av, { Transparency = 0.4 }, 0.25)
			end)
		else
			bindHoverStroke(au, av)
		end

		local aw = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundTransparency = 1,
			Parent = au,
		})
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 6),
			Parent = aw,
		})
		local ax = at and u.AccentDark or u.Text
		if ar.Icon then
			local ay = createIcon(aw, ar.Icon, at and u.AccentDark or u.Accent, UDim2.new())
			ay.AnchorPoint = Vector2.zero
			ay.LayoutOrder = 1
		end
		local ay = createLabel({
			Name = "Title",
			Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X,
			Text = tostring(as),
			TextSize = 13,
			TextColor3 = ax,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextTruncate = Enum.TextTruncate.None,
			LayoutOrder = 2,
			Parent = aw,
		})

		local function fitLabel()
			local az = au.AbsoluteSize.X - 20 - (ar.Icon and 22 or 0)
			if az > 0 and ay.TextBounds.X > az then
				ay.AutomaticSize = Enum.AutomaticSize.None
				ay.Size = UDim2.new(0, az, 1, 0)
				ay.TextTruncate = Enum.TextTruncate.AtEnd
			else
				ay.AutomaticSize = Enum.AutomaticSize.X
				ay.Size = UDim2.new(0, 0, 1, 0)
				ay.TextTruncate = Enum.TextTruncate.None
			end
		end
		au:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitLabel)
		task.defer(fitLabel)

		au.MouseButton1Click:Connect(function()
			if ap.Locked then
				return
			end
			ripple(au, at and u.AccentDark or u.Accent)
			runProtected(('Button "%s"'):format(tostring(as)), ar.Callback)
		end)

		ap.Buttons[aq] = {
			Frame = au,
			SetText = function(az, aA)
				setTranslated(ay, "Text", tostring(aA))
				fitLabel()
			end,
			SetCallback = function(az, aA)
				ar.Callback = aA
			end,
		}
	end

	function ap:GetButton(aq)
		return ap.Buttons[aq]
	end
	function ap:SetButtonText(aq, ar)
		local as = ap.Buttons[aq]
		if as then
			as:SetText(ar)
		end
	end

	return registerElement(self, { Name = ak.Name, DependsOn = ak.DependsOn, Tooltip = ak.Tooltip, Locked = ak.Locked, LockedReason = ak.LockedReason }, ap, ao, "ButtonRow")
end
K.Buttons = K.ButtonRow

function K:TextArea(aj)
	local ak = normalizeOptions(aj, {
		Title = "Name",
		Description = "Desc",
		PlaceholderText = "Placeholder",
		CurrentValue = "Default",
		Value = "Default",
	})
	local al = math.max(tonumber(ak.Height) or 84, 40)
	local am = math.max(tonumber(ak.MaxHeight) or 220, al)
	local an = tonumber(ak.MaxLength)

	local ao = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = u.Surface2,
		BorderSizePixel = 0,
		LayoutOrder = self:_nextOrder(),
		Parent = self.List,
	})
	ao:SetAttribute(i.ATTR_NO_DRAG, true)
	local ap = styleCard(ao)
	addPadding(ao, 14, 14, 11, 12)
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6),
		Parent = ao,
	})

	createLabel({
		Name = "Title",
		Size = UDim2.new(1, 0, 0, 14),
		Text = ak.Name or "Text",
		LayoutOrder = 1,
		Parent = ao,
	})
	if ak.Desc then
		createLabel({
			Name = "Desc",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Text = tostring(ak.Desc),
			TextSize = 12,
			FontFace = w.Regular,
			TextColor3 = u.Muted,
			TextWrapped = true,
			TextTruncate = Enum.TextTruncate.None,
			LayoutOrder = 2,
			Parent = ao,
		})
	end

	local aq = create("ScrollingFrame", {
		Size = UDim2.new(1, 0, 0, al),
		BackgroundColor3 = u.Surface,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = u.Muted,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		LayoutOrder = 3,
		Parent = ao,
	})
	addCorner(aq, UDim.new(0, 6))
	local ar = addStroke(aq)
	addPadding(aq, 8, 8, 6, 6)

	local function clampLength(as)
		as = tostring(as or "")
		if an and #as > an then
			return as:sub(1, an)
		end
		return as
	end

	local as = create("TextBox", {
		Size = UDim2.new(1, 0, 0, al - 12),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Text = "",
		PlaceholderText = tostring(ak.Placeholder or ""),
		PlaceholderColor3 = u.Muted,
		TextColor3 = u.Text,
		TextSize = 13,
		FontFace = ak.Monospace and i.MONO_FONT or w.Regular,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		MultiLine = true,
		ClearTextOnFocus = false,
		Parent = aq,
	})
	as.Text = clampLength(ak.Default)

	local function fitBox()
		local at = as.TextBounds.Y + 14
		aq.Size = UDim2.new(1, 0, 0, math.clamp(at, al, am))
	end

	as:GetPropertyChangedSignal("Text"):Connect(function()
		local at = clampLength(as.Text)
		if at ~= as.Text then
			as.Text = at
			return
		end
		if as:IsFocused() then
			safeCall(ak.OnChanged, as.Text)
			if (tonumber(as.CursorPosition) or -1) >= #as.Text then
				task.defer(function()
					aq.CanvasPosition = Vector2.new(0, math.max(aq.AbsoluteCanvasSize.Y - aq.AbsoluteWindowSize.Y, 0))
				end)
			end
		end
	end)
	as:GetPropertyChangedSignal("TextBounds"):Connect(fitBox)
	task.defer(fitBox)

	as.Focused:Connect(function()
		tween(ar, { Color = u.StrokeHover }, 0.15)
	end)
	as.FocusLost:Connect(function()
		tween(ar, { Color = u.Stroke }, 0.15)
		safeCall(ak.Callback, as.Text)
	end)

	local at = {}
	function at:Set(au, av)
		as.Text = clampLength(au)
		flashStroke(ap)
		if not av then
			safeCall(ak.Callback, as.Text)
		end
	end
	function at:Get()
		return as.Text
	end
	function at:SetPlaceholder(au)
		as.PlaceholderText = tostring(au)
	end
	function at:Focus()
		as:CaptureFocus()
	end
	function at:Clear()
		at:Set("")
	end

	return registerElement(self, ak, at, ao, "TextArea")
end

do
	local aj = {}
	h.Utils = aj

	function aj.GetCharacter(ak)
		ak = ak or g
		return ak and ak.Character or nil
	end

	function aj.GetHumanoid(ak)
		local al = aj.GetCharacter(ak)
		return al and al:FindFirstChildOfClass("Humanoid") or nil
	end

	function aj.GetRoot(ak)
		local al = aj.GetCharacter(ak)
		if not al then
			return nil
		end
		return al:FindFirstChild("HumanoidRootPart") or al.PrimaryPart
	end

	function aj.IsAlive(ak)
		local al = aj.GetHumanoid(ak)
		return al ~= nil and al.Health > 0
	end

	function aj.GetPlayers(ak)
		local al = {}
		for am, an in ipairs(f:GetPlayers()) do
			if not (ak and an == g) then
				table.insert(al, an)
			end
		end
		return al
	end

	function aj.GetPlayer(ak)
		if typeof(ak) == "Instance" then
			return ak
		end
		ak = string.lower(tostring(ak or ""))
		if ak == "" then
			return nil
		end
		local al
		for am, an in ipairs(f:GetPlayers()) do
			local ao, ap = string.lower(an.Name), string.lower(an.DisplayName or an.Name)
			if ao == ak or ap == ak then
				return an
			end
			if not al and (ao:sub(1, #ak) == ak or ap:sub(1, #ak) == ak) then
				al = an
			end
		end
		return al
	end

	function aj.GetClosestPlayer(ak)
		ak = type(ak) == "table" and ak or {}
		local al = aj.GetRoot()
		if not al then
			return nil
		end
		local am, an = nil, tonumber(ak.MaxDistance) or math.huge
		for ao, ap in ipairs(f:GetPlayers()) do
			local aq = ap ~= g
				and not (ak.TeamCheck and ap.Team ~= nil and ap.Team == g.Team)
				and (ak.AliveCheck == false or aj.IsAlive(ap))
			if aq then
				local ar = aj.GetRoot(ap)
				if ar then
					local as = (ar.Position - al.Position).Magnitude
					if as < an then
						am, an = ap, as
					end
				end
			end
		end
		return am, am and an or nil
	end

	function aj.Teleport(ak, al)
		local am = aj.GetRoot()
		if not am then
			return false
		end
		local an
		if typeof(ak) == "CFrame" then
			an = ak
		elseif typeof(ak) == "Vector3" then
			an = CFrame.new(ak)
		elseif typeof(ak) == "Instance" then
			if ak:IsA("Player") then
				local ao = aj.GetRoot(ak)
				an = ao and ao.CFrame
			elseif ak:IsA("BasePart") then
				an = ak.CFrame
			elseif ak:IsA("Model") then
				an = ak:GetPivot()
			end
		end
		if not an then
			return false
		end
		if typeof(al) == "Vector3" then
			an *= CFrame.new(al)
		elseif typeof(al) == "CFrame" then
			an *= al
		end
		local ao = am.Parent
		local ap = pcall(function()
			if ao and ao:IsA("Model") then
				ao:PivotTo(an)
			else
				am.CFrame = an
			end
		end)
		return ap
	end

	function aj.Rejoin()
		local ak = game:GetService("TeleportService")
		if #f:GetPlayers() <= 1 then
			return pcall(ak.Teleport, ak, game.PlaceId, g)
		end
		return pcall(ak.TeleportToPlaceInstance, ak, game.PlaceId, game.JobId, g)
	end

	function aj.ServerHop(ak)
		ak = type(ak) == "table" and ak or {}
		local al = ak.Lowest == true
		local am, an = pcall(function()
			local am = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=%s&limit=100&excludeFullGames=true")
				:format(game.PlaceId, al and "Asc" or "Desc")
			return e:JSONDecode(game:HttpGet(am)).data
		end)
		if not am or type(an) ~= "table" then
			return false, "could not load the server list"
		end
		local ao = {}
		for ap, aq in ipairs(an) do
			if type(aq) == "table" and aq.id ~= game.JobId then
				local ar, as = tonumber(aq.playing), tonumber(aq.maxPlayers)
				if ar and as and ar < as then
					table.insert(ao, aq.id)
				end
			end
		end
		if #ao == 0 then
			return false, "no other servers found"
		end
		local ap = game:GetService("TeleportService")
		local aq = al and ao[1] or ao[math.random(#ao)]
		return pcall(ap.TeleportToPlaceInstance, ap, game.PlaceId, aq, g)
	end

	local ak
	function aj.AntiAFK(al)
		if al == false then
			if ak then
				ak:Disconnect()
				ak = nil
			end
			return false
		end
		if ak then
			return true
		end
		local am, an = pcall(function()
			local am = game:GetService("VirtualUser")
			return g.Idled:Connect(function()
				pcall(function()
					am:CaptureController()
					am:ClickButton2(Vector2.zero)
				end)
			end)
		end)
		if not am or not an then
			return false
		end
		ak = an
		table.insert(h._cleanup, function()
			aj.AntiAFK(false)
		end)
		return true
	end

	function aj.GetExecutor()
		return getExecutorName()
	end

	function aj.FormatNumber(al, am)
		al = tonumber(al) or 0
		local an = { "", "K", "M", "B", "T", "Qd", "Qn" }
		local ao, ap = 1, math.abs(al)
		while ap >= 1000 and ao < #an do
			ap /= 1000
			ao += 1
		end
		local aq = string.format("%." .. math.clamp(tonumber(am) or 1, 0, 4) .. "f", ap)
		if aq:find("%.") then
			aq = aq:gsub("0+$", ""):gsub("%.$", "")
		end
		return (al < 0 and "-" or "") .. aq .. an[ao]
	end

	function aj.FormatTime(al)
		al = math.max(math.floor(tonumber(al) or 0), 0)
		local am, an, ao = al // 3600, (al % 3600) // 60, al % 60
		if am > 0 then
			return string.format("%d:%02d:%02d", am, an, ao)
		end
		return string.format("%d:%02d", an, ao)
	end

	h.GetExecutor = function()
		return getExecutorName()
	end
end

