	if ae.Animations ~= nil then
		h.Animations = ae.Animations == true
	end
	ai._closeAction = (type(ae.CloseAction) == "string" and string.lower(ae.CloseAction) == "hide") and "Hide" or "Unload"
	ai._confirmClose = ae.ConfirmClose ~= false
	local T = ae.MinimizedBar
	if T == nil then
		T = ae.MiniBar
	end
	if type(T) == "string" or type(T) == "function" then
		T = { Text = T }
	end
	ai._miniOptions = type(T) == "table" and T or {}
