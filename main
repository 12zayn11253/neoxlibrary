	Success = "circle-check",
	Warning = "triangle-alert",
	Error = "circle-x",
}

i.NOTIFY_TYPES = {
	Info = "Accent",
	Success = "Success",
	Warning = "Warning",
	Error = "Error",
}

local aa = {}
aa.__index = aa

i.DEFAULT_WINDOW_SIZE = UDim2.fromOffset(644, 428)
i.COMPACT_WIDTH = 560
i.SCROLLBAR_GRAB = 6
i.PAGE_PAD = 18
i.TAB_HEIGHT = 32
i.PHONE_LAYOUT = Vector2.new(512, 330)
i.PHONE_FIT = { PortraitX = 0.9, PortraitY = 0.56, TabletX = 0.56, LandscapeX = 0.52, LandscapeY = 0.82 }
i.COMPACT_SIDEBAR = 64
i.COMPACT_MIN = Vector2.new(400, 260)
i.DEFAULT_MIN_SIZE = Vector2.new(480, 360)

local function getTopbarInset()
	local ab, ac = pcall(function()
		return c.TopbarInset
	end)
	if ab and typeof(ac) == "Rect" and ac.Height > 0 then
		return ac
	end
	return nil
end

local function getTopbarHeight()
	local ab = getTopbarInset()
	if ab then
		return ab.Max.Y
	end
	local ac, ad = pcall(function()
		return c:GetGuiInset()
	end)
	return ac and typeof(ad) == "Vector2" and ad.Y or 36
end

local function toVector2(ab)
	if typeof(ab) == "Vector2" then
		return ab
	elseif typeof(ab) == "UDim2" then
		return Vector2.new(ab.X.Offset, ab.Y.Offset)
	elseif type(ab) == "table" then
		local ac, ad = tonumber(ab[1] or ab.X), tonumber(ab[2] or ab.Y)
		if ac and ad then
			return Vector2.new(ac, ad)
		end
	end
	return nil
end
h._toVector2 = toVector2

function h.Window(ab, ac)

	local ad = ac
	if ab ~= h and ac == nil then
		ad = ab
	end

	local ae = normalizeOptions(ad, {
		Name = "Title",
		LoadingSubtitle = "Subtitle",
		Author = "Subtitle",
		ToggleUIKeybind = "Keybind",
		ToggleKey = "Keybind",
	})
	if ae.HideSearchBar == true and ae.Search == nil then
		ae.Search = false
	end
	local af = ae.SidebarWidth or ae.SideBarWidth
	if af ~= nil then
		ae.Appearance = type(ae.Appearance) == "table" and table.clone(ae.Appearance) or {}
		if ae.Appearance.SidebarWidth == nil then
			ae.Appearance.SidebarWidth = af
		end
	end
	if type(ae.Folder) == "string" and ae.ConfigurationSaving == nil then
		ae.ConfigurationSaving = { Enabled = true, FolderName = ae.Folder }
	end

	if ae.Theme ~= nil then
		h:SetTheme(ae.Theme)
	end
	if type(ae.Localization) == "table" then
		h:SetLocalization(ae.Localization)
	end
	if ae.ErrorNotifications ~= nil then
		h.ErrorNotifications = ae.ErrorNotifications ~= false
	end
	if tonumber(ae.TextScale) then
		h.TextScale = math.clamp(tonumber(ae.TextScale), 0.7, 1.3)
	end
	applyAppearance(ae.Appearance)
	do
		local ah = type(ae.Home) == "table" and ae.Home or {}
		local ai = type(ae.Membership) == "table" and ae.Membership or (type(ah.Key) == "table" and ah.Key) or {}
		if type(ai.Data) == "function" then
			h._keySource = ai.Data
			h._keySourceWarned = false
		end
	end

	local ah = toKeyCode(ae.Keybind) or Enum.KeyCode.RightControl

	local ai = setmetatable({
		Tabs = {},
		Flags = {},
		CurrentTab = nil,
		Open = true,
		Keybind = ah,
		_connections = {},
		_controls = {},
		_inputListeners = {
			Began = {},
			Changed = {},
			Ended = {},
			Render = {},
		},
		_frameSteps = {},
		_destroyed = false,
		_elements = {},
		_dependents = {},
		_loops = {},
		_resetOnUnload = ae.ResetOnUnload == true,
		_events = { Open = {}, Close = {}, Destroy = {} },
		_sidebarCollapsed = ae.SidebarCollapsed == true,
		_looseTabOrder = 0,
		_sectionCount = 0,
		_searchIndex = {},
		_keybinds = {},
		_overlays = {},
		_userScale = math.clamp(tonumber(ae.Scale) or 1, 0.5, 1.5),
		_sidebarWidth = C.SidebarWidth,
		_socialsOptions = ae.Socials,
		_donationOptions = ae.Donations,
	}, aa)

	local function dispatcher(aj)
		return function(...)

			for ak, al in ipairs(table.clone(ai._inputListeners[aj])) do
				al(...)
			end
		end
	end

	local aj = dispatcher("Render")
	table.insert(ai._connections, d.RenderStepped:Connect(function(ak)
		aj(ak)
		for al, am in ipairs(ai._frameSteps) do
			am(ak)
		end
	end))
	table.insert(ai._connections, b.InputBegan:Connect(dispatcher("Began")))
	table.insert(ai._connections, b.InputChanged:Connect(dispatcher("Changed")))
	table.insert(ai._connections, b.InputEnded:Connect(dispatcher("Ended")))

	local ak = create("ScreenGui", {
		Name = ae.GuiName or i.GUI_NAME,
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		DisplayOrder = 999,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})
	ai.Gui = ak

	local al = create("Frame", {
		Name = "Window",
