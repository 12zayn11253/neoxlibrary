local DEFAULT_FONT_FAMILY = "rbxasset://fonts/families/GothamSSm.json"

NeoxHub.Fonts = {
	Regular = Font.new(DEFAULT_FONT_FAMILY, Enum.FontWeight.Regular),
	Medium = Font.new(DEFAULT_FONT_FAMILY, Enum.FontWeight.Medium),
	Bold = Font.new(DEFAULT_FONT_FAMILY, Enum.FontWeight.Bold),
}

local KNOWN_FONTS = {
	ValleySans = {
		Regular = "https://raw.githubusercontent.com/HelsinkiTypeStudio/valley-sans/main/fonts/ttf/ValleySans-Regular.ttf",
		Medium = "https://raw.githubusercontent.com/HelsinkiTypeStudio/valley-sans/main/fonts/ttf/ValleySans-Medium.ttf",
		SemiBold = "https://raw.githubusercontent.com/HelsinkiTypeStudio/valley-sans/main/fonts/ttf/ValleySans-SemiBold.ttf",
	},
}

local FONT_WEIGHTS = {
	Regular = { 400, Enum.FontWeight.Regular },
	Medium = { 500, Enum.FontWeight.Medium },
	SemiBold = { 600, Enum.FontWeight.SemiBold },
	Bold = { 700, Enum.FontWeight.Bold },
}

function NeoxHub:LoadFont(input)
	input = normalizeOptions(input, {})
	if type(writefile) ~= "function" or type(isfile) ~= "function" or type(getcustomasset) ~= "function" then
		log("custom fonts need writefile, isfile and getcustomasset")
		return false
	end

	local familyName = input.Name or "CustomFont"
	local weightUrls = input.Weights or KNOWN_FONTS[familyName]
	if type(weightUrls) ~= "table" then
		log("no font weights for " .. familyName)
		return false
	end

	local folder = input.Folder or FONT_FOLDER
	pcall(function()
		if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder(folder) then
			makefolder(folder)
		end
	end)

	local faces = {}
	local loadedWeights = {}
	for weightName, url in pairs(weightUrls) do
		local weightInfo = FONT_WEIGHTS[weightName]
		if weightInfo then
			local path = folder .. "/" .. familyName .. "-" .. weightName .. ".ttf"
			local ok = true
			if not isfile(path) then
				ok = pcall(function()
					writefile(path, game:HttpGet(url))
				end)
			end
			local assetOk, assetId = false, nil
			if ok then
				assetOk, assetId = pcall(getcustomasset, path)
			end
			if ok and assetOk and assetId then
				loadedWeights[weightName] = true
				table.insert(faces, {
					name = weightName,
					weight = weightInfo[1],
					style = "normal",
					assetId = assetId,
				})
			else
				log("could not download the " .. weightName .. " weight of " .. familyName)
			end
		end
	end

	if #faces == 0 then
		return false
	end

	local familyPath = folder .. "/" .. familyName .. ".json"
	local wrote = pcall(function()
		writefile(familyPath, HttpService:JSONEncode({ name = familyName, faces = faces }))
	end)
	if not wrote then
		return false
	end

	local familyOk, familyAsset = pcall(getcustomasset, familyPath)
	if not familyOk or not familyAsset then
		return false
	end

	local function fontFor(weightName, fallback)
		local weightInfo = FONT_WEIGHTS[weightName]
		if weightInfo and loadedWeights[weightName] then
			return Font.new(familyAsset, weightInfo[2])
		end
		return fallback
	end

	local fonts = NeoxHub.Fonts
	fonts.Regular = fontFor("Regular", fonts.Regular)
	fonts.Medium = fontFor("Medium", fontFor("Regular", fonts.Medium))
	fonts.Bold = fontFor("SemiBold", fontFor("Bold", fonts.Bold))
	return true
end

local ICON_PACK_URL = "https://raw.githubusercontent.com/Footagesus/Icons/refs/heads/main/lucide/dist/Icons.lua"
local iconPack

local function getIconPack()
	if iconPack ~= nil then
		return iconPack
	end
	local ok, result = pcall(function()
		return loadstring(game:HttpGet(ICON_PACK_URL))()
	end)
	if ok and type(result) == "table" then
		iconPack = result
	else
		iconPack = false
		log("lucide icons unavailable: " .. tostring(result))
	end
	return iconPack
end

function NeoxHub:PreloadIcons()
	return getIconPack() ~= false
end

local function resolveIcon(icon)
	if typeof(icon) == "table" then
		return icon.Image, icon.RectOffset, icon.RectSize
	end
	if type(icon) == "number" then
		return "rbxassetid://" .. tostring(icon)
	end
	if type(icon) ~= "string" or icon == "" then
		return nil
	end
	if icon:find("^rbxassetid://") or icon:find("^rbxasset://") or icon:find("^http") then
		return icon
	end

	local name = icon:gsub("^lucide:", "")
	local pack = getIconPack()
	if not pack then
		return nil
	end

	local entry = (pack.Icons and pack.Icons[name]) or pack[name]
	if type(entry) == "table" then
		local image = entry.Image
		if type(image) == "number" then
			image = "rbxassetid://" .. tostring(image)
		end
		local sheet = pack.Spritesheets and pack.Spritesheets[tostring(image)] or image
		return sheet, entry.ImageRectPosition, entry.ImageRectSize
	elseif type(entry) == "string" then
		return entry
	end

	log("unknown lucide icon: " .. name)
	return nil
end

