	return nil
end

local function setIcon(D, E)
	local F, G, H = resolveIcon(E)
	if not F then
		return false
	end
	D.Image = F
	D.ImageRectOffset = G or Vector2.zero
	D.ImageRectSize = H or Vector2.zero
	return true
end

local D = {}
local E
local F = false

local function imageLoads(G)
	local H = false
	local I = pcall(function()
		game:GetService("ContentProvider"):PreloadAsync({ G }, function(I, J)
			H = J == Enum.AssetFetchStatus.Success
		end)
	end)
	return I and H
end

local function findLogoImage(G)
	if imageLoads(G) then
		return G
	end
	local H, I = pcall(function()
		return game:GetObjects(G)
	end)
	if H and type(I) == "table" then
		local J = I[1]
		if typeof(J) == "Instance" and (J:IsA("Decal") or J:IsA("Texture")) and J.Texture ~= "" then
			return J.Texture
		end
	end
	return G
end

local function setLogo(G, H)
	if H ~= nil then
		setIcon(G, H)
		return
	end
	G.Image = E or v.Logo
	if E then
		return
	end
	D[G] = true
	if F then
		return
	end
	F = true
	task.spawn(function()
		local I = findLogoImage(v.Logo)
		E = I
		for J in pairs(D) do
			if J.Parent then
				J.Image = I
			end
		end
		table.clear(D)
	end)
end

local function createIcon(G, H, I, J)
	local K = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = J,
		Size = UDim2.fromOffset(16, 16),
		BackgroundTransparency = 1,
		Parent = G,
	})
	local L = create("ImageLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ImageColor3 = I,
		ScaleType = Enum.ScaleType.Fit,
		Parent = K,
	})
	setIcon(L, H)
	return K, L
end

local function getGuiParent()
	local G
	pcall(function()
		if typeof(gethui) == "function" then
			G = gethui()
		end
	end)
	if typeof(G) == "Instance" then
		return G
	end

	local H
	pcall(function()
		local I = game:GetService("CoreGui")
		local J = Instance.new("Folder")
		J.Parent = I
		J:Destroy()
		H = I
	end)
	if H then
		return H
	end

	return g:WaitForChild("PlayerGui")
end

local G, H = nil, Vector2.zero
local function getMousePosition()
	local I = time()
	if G ~= I then
		G = I
		H = c:GetGuiInset()
	end
	return b:GetMouseLocation() - H
end

local function isPress(I)
	return I.UserInputType == Enum.UserInputType.MouseButton1 or I.UserInputType == Enum.UserInputType.Touch
end

local function isMove(I)
	return I.UserInputType == Enum.UserInputType.MouseMovement or I.UserInputType == Enum.UserInputType.Touch
end

local function pointInside(I, J)
	local K, L = J.AbsolutePosition, J.AbsoluteSize
	return I.X >= K.X and I.X <= K.X + L.X and I.Y >= K.Y and I.Y <= K.Y + L.Y
end

local function createChevron(I, J, K)
	local L = create("Frame", {
		AnchorPoint = Vector2.new(J, 0.5),
		Position = UDim2.new(J, K, 0.5, 0),
		Size = UDim2.fromOffset(18, 18),
		BackgroundTransparency = 1,
		Parent = I,
	})
	local M = {}

	local N = create("ImageLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(16, 16),
		BackgroundTransparency = 1,
		ImageColor3 = u.Muted,
		ScaleType = Enum.ScaleType.Fit,
		Parent = L,
	})

	if setIcon(N, "chevron-down") then
		function M:Set(O)
			tween(N, {
				Rotation = O and 180 or 0,
				ImageColor3 = O and u.Accent or u.Muted,
			}, 0.3, Enum.EasingStyle.Quint)
		end
		return M
	end

	N:Destroy()

	local function glyph(O, P)
		return createLabel({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(18, 18),
			Text = "›",
			TextSize = 22,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextColor3 = u.Muted,
			TextTransparency = P,
			Rotation = O,
			Parent = L,
		})
	end

	local O = glyph(90, 0)
	local P = glyph(270, 1)

	function M:Set(Q)
		tween(O, { TextTransparency = Q and 1 or 0 }, 0.2)
		tween(P, {
			TextTransparency = Q and 0 or 1,
			TextColor3 = Q and u.Accent or u.Muted,
		}, 0.2)
	end

	return M
end

local I = {}

local function ripple(J, K)
	local L = getMousePosition()
	local M = math.max(J.AbsoluteSize.X, J.AbsoluteSize.Y) * 2.2

	local N = table.remove(I)
	if not N then
		N = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			BorderSizePixel = 0,
		})
		addCorner(N, UDim.new(1, 0))
	end

	N.BackgroundColor3 = K or u.Accent
	N.Position = UDim2.fromOffset(L.X - J.AbsolutePosition.X, L.Y - J.AbsolutePosition.Y)
	N.Size = UDim2.fromOffset(0, 0)
	N.BackgroundTransparency = 0.82
	N.ZIndex = J.ZIndex + 1
	N.Parent = J

	tween(N, {
		Size = UDim2.fromOffset(M, M),
		BackgroundTransparency = 1,
	}, 0.55)

	task.delay(0.55, function()
		if N.Parent ~= J then
			return
		end
		N.Parent = nil
		if #I < 4 then
			table.insert(I, N)
		else
			N:Destroy()
		end
	end)
end

local function strokeBase(J)
	return u[J:GetAttribute(i.ATTR_STROKE_BASE) or "Stroke"] or u.Stroke
end

local function flashStroke(J)
	if not J then
		return
	end
	tween(J, { Color = u.Accent, Transparency = 0.2 }, 0.08)
	task.delay(0.12, function()
		tween(J, { Color = strokeBase(J), Transparency = 0 }, 0.35)
	end)
end

i.HOVER_LIFT = 0.4
i.MINI_TEXT_WIDTH = 170

local function bindHoverStroke(J, K)
	local L = false
	J.MouseEnter:Connect(function()
		if x then
			return
		end
		tween(K, { Color = u.StrokeHover }, 0.12)
		if J.BackgroundColor3 == u.Surface2 and (J.BackgroundTransparency or 0) < 1 then
			L = true
			tween(J, { BackgroundColor3 = u.Surface2:Lerp(u.Surface3, i.HOVER_LIFT) }, 0.12)
		end
	end)
	J.MouseLeave:Connect(function()
		tween(K, { Color = strokeBase(K) }, 0.25)
		if L then
			L = false
			tween(J, { BackgroundColor3 = u.Surface2 }, 0.25)
		end
	end)
end

i.SHORT_KEY_NAMES = {
	[Enum.KeyCode.LeftControl] = "LCtrl",
	[Enum.KeyCode.RightControl] = "RCtrl",
	[Enum.KeyCode.LeftShift] = "LShift",
	[Enum.KeyCode.RightShift] = "RShift",
	[Enum.KeyCode.LeftAlt] = "LAlt",
	[Enum.KeyCode.RightAlt] = "RAlt",
	[Enum.KeyCode.Return] = "Enter",
	[Enum.KeyCode.Escape] = "Esc",
	[Enum.KeyCode.Backspace] = "Backspace",
}

local function keyDisplayName(J)
	if J == nil then
		return "None"
	end
	return i.SHORT_KEY_NAMES[J] or J.Name
end

local function toKeyCode(J)
	if typeof(J) == "EnumItem" then
		return J
	end
	if type(J) ~= "string" or J == "" or J == "None" then
		return nil
	end
	local K, L = pcall(function()
		return Enum.KeyCode[J]
	end)
	if K and L then
		return L
	end
	log("unknown key name: " .. J)
	return nil
end

local function createStepper(J, K, L)
	if K < J then
		J, K = K, J
	end
	if not L or L <= 0 then
		L = 1
	end

	local M = 0
	while M < 6 do
		local N = L * 10 ^ M
		if math.abs(N - math.floor(N + 0.5)) < 1e-9 then
			break
		end
		M += 1
	end
	local N = "%." .. M .. "f"

	return {
		snap = function(O)
			O = math.floor(O / L + 0.5) * L
			O = tonumber(string.format(N, O)) or O
			return math.clamp(O, J, K)
		end,
		format = function(O)
			return string.format(N, O)
		end,
	}
end

local J

local function registerElement(K, L, M, N, O, P)
	M._type = O
	M._frame = N
	M._listeners = M._listeners or {}

	local Q = K and K.Window
	M._tab = K
	P = P or "Callback"
	local R = L.Name or L.Title or L.Text or L.Flag
	local S = R ~= nil and ('%s "%s"'):format(O, tostring(R)) or O
	M._label = S
	local T = L[P]
	local U = Q ~= nil
	local V = {}

	if T ~= nil and type(T) ~= "function" then
		log(("%s: %s should be a function, but got a %s. It will be ignored."):format(S, P, typeof(T)))
		T = nil
	end
	if L.Flag ~= nil and type(L.Flag) ~= "string" then
		log(("%s: Flag should be a string, but got a %s."):format(S, typeof(L.Flag)))
		L.Flag = tostring(L.Flag)
	end
	if L.Flag and Q then
		local W = Q.Flags[L.Flag]
		if W and W ~= M and not W._destroyed then
			log(('%s: Flag "%s" is already used by %s. Every Flag needs to be unique, otherwise saving and loading mixes them up.')
				:format(S, L.Flag, W._label or "another element"))
		end
	end
	if O == "Slider" and L.Range ~= nil
		and (type(L.Range) ~= "table" or not tonumber(L.Range[1]) or not tonumber(L.Range[2])) then
		log(("%s: Range should look like { min, max }, for example { 0, 100 }."):format(S))
	end
	if (O == "Slider" or O == "Stepper") and L.Increment ~= nil
		and (not tonumber(L.Increment) or tonumber(L.Increment) <= 0) then
		log(("%s: Increment should be a number above 0."):format(S))
	end
	if O == "Dropdown" and L.Options ~= nil and type(L.Options) ~= "table" then
		log(("%s: Options should be a list, for example { \"A\", \"B\" }."):format(S))
	end
	if O == "Toggle" and L.Loop ~= nil and type(L.Loop) ~= "function" then
		log(("%s: Loop should be a function."):format(S))
	end

	function M:OnChanged(W)
		if type(W) ~= "function" then
			return { Disconnect = function() end }
		end
		table.insert(V, W)
		return {
			Disconnect = function()
				local X = table.find(V, W)
				if X then
					table.remove(V, X)
				end
			end,
		}
	end

	if L.Flag then
		h.Flags[L.Flag] = M
		if Q then
			Q.Flags[L.Flag] = M
		end
		if Q and Q._loadedConfig and Q._applyLateConfig then
			local W = L.Flag
			task.defer(function()
				if Q.Flags[W] == M and not M._destroyed then
					Q:_applyLateConfig(M, W)
				end
			end)
		end
		local W = h._flagListeners and h._flagListeners[L.Flag]
		if W then
			for X, Y in ipairs(W) do
				Y.Connections[M] = M:OnChanged(Y.Listener)
			end
		end
	end

	if Q and P ~= "Callback" and type(L.Callback) == "function" then
		local W = L.Callback
		L.Callback = function(...)
			runProtected(S, W, ...)
		end
	end

	if Q then
		L[P] = function(...)
			if M._destroyed then
				return
			end
			runProtected(S, T, ...)
			for W, X in ipairs(table.clone(V)) do
				runProtected(S .. " OnChanged", X, ...)
			end
			if L.Flag then
				Q:_autoSave()
			end
			Q:_queueDependencies()
		end
		table.insert(Q._elements, M)
		local W = L.DependsOn
		if W == nil then
			W = L.Depends
		end
		if W ~= nil then
			M._dependsOn = W
			table.insert(Q._dependents, M)
			Q:_queueDependencies()
		end
	end
	if type(M.Get) == "function" then
		local W, X = pcall(M.Get, M)
		if W then
			M._defaultValue = type(X) == "table" and table.clone(X) or X
		end
	end
	if type(M.Set) == "function" then
		if M.Reset == nil then
			function M:Reset()
				local W = M._defaultValue
				if type(W) == "table" then
					W = table.clone(W)
				end
				M:Set(W)
			end
		end
		if M.SetValue == nil then
			M.SetValue = M.Set
		end
	end
	if type(M.Get) == "function" and M.GetValue == nil then
		M.GetValue = M.Get
	end

	function M:SetCallback(W)
		if U then
			T = W
		else
			L[P] = W
		end
	end

	if Q and N and Q._searchIndex then
		local W = L.Name or L.Title or L.Text
		if type(W) == "string" and W ~= "" then
			table.insert(Q._searchIndex, {
				Name = W,
				Tab = K._rootTab or K,
				Group = K._groupElement,
				Frame = N,
				Element = M,
			})
		end
	end

	function M:Destroy()
		if M._destroyed then
			return
		end
		M._destroyed = true
		for W, X in ipairs(M._listeners) do
			X()
		end
		M._listeners = {}
		if L.Flag then
			if h.Flags[L.Flag] == M then
				h.Flags[L.Flag] = nil
			end
			if Q and Q.Flags[L.Flag] == M then
				Q.Flags[L.Flag] = nil
			end
		end
		table.clear(V)
		if Q then
			Q._controlsDirty = true
			local W = table.find(Q._elements, M)
			if W then
				table.remove(Q._elements, W)
			end
			W = table.find(Q._dependents, M)
			if W then
				table.remove(Q._dependents, W)
			end
			if Q._searchIndex then
				for X = #Q._searchIndex, 1, -1 do
					if Q._searchIndex[X].Element == M then
						table.remove(Q._searchIndex, X)
					end
				end
			end
		end
		if N then
			N:Destroy()
		end
	end

	if N then
		J(M, N, L, Q)
	end

	if O ~= "KeyInfo" then
		for W, X in pairs(M) do
			if type(W) == "string" and type(X) == "function" and W:sub(1, 1) ~= "_" then
				M[W] = function(Y, ...)
					if Y ~= M then
						error(("%s%s: %s was called with a dot. Write element:%s(...) with a colon, not element.%s(...)")
							:format(i.LOG_PREFIX, S, W, W, W), 2)
					end
					return X(Y, ...)
				end
			end
		end
	end
	return M
end

local function createCard(K, L, M)
	local N = {
		Size = UDim2.new(1, 0, 0, M),
		BackgroundColor3 = u.Surface2,
		BorderSizePixel = 0,
		LayoutOrder = K:_nextOrder(),
		Parent = K.List,
	}
	if L == "TextButton" then
		N.AutoButtonColor = false
		N.Text = ""
	end
	local O = create(L, N)
	O:SetAttribute(i.ATTR_NO_DRAG, true)
	local P = styleCard(O)
	return O, P
end

local function createTitleBlock(K, L, M, N)
	local O, P
	if M then
		local Q = (i.ROW_HEIGHT_DESC - 38) / 2
		O = createLabel({
			Name = "Title",
			Position = UDim2.fromOffset(14, Q),
			Size = UDim2.new(1, -(14 + N), 0, 18),
			Text = L,
			Parent = K,
		})
		P = createLabel({
			Name = "Desc",
			Position = UDim2.fromOffset(14, Q + 20),
			Size = UDim2.new(1, -(14 + N), 0, 17),
			Text = M,
			TextSize = 13,
			FontFace = w.Regular,
			TextColor3 = u.Muted,
			Parent = K,
		})
	else
		O = createLabel({
			Name = "Title",
			Position = UDim2.fromOffset(14, 0),
			Size = UDim2.new(1, -(14 + N), 1, 0),
			Text = L,
			Parent = K,
		})
	end
	return O, P
end

local function createRowElement(K, L, M, N, O, P)
	local Q = normalizeOptions(L, M)
	local R = Q.Desc and i.ROW_HEIGHT_DESC or i.ROW_HEIGHT
	local S, T = createCard(K, N or "Frame", R)
	bindHoverStroke(S, T)
	local U, V
	if O then
		U, V = createTitleBlock(S, Q.Name or P, Q.Desc, O)
	end
	return Q, S, T, R, U, V
end

local function setTitleReserve(K, L, M)
	if K then
		K.Size = UDim2.new(1, -(14 + M), K.Size.Y.Scale, K.Size.Y.Offset)
	end
	if L then
		L.Size = UDim2.new(1, -(14 + M), 0, L.Size.Y.Offset)
	end
end

J = function(K, L, M, N)
	local function findChild(O)
		return L:FindFirstChild(O, true)
	end

	if K.SetTitle == nil then
		function K:SetTitle(O)
			local P = findChild("Title")
			if P then
				setTranslated(P, "Text", O == nil and "" or tostring(O))
			end
		end
	end

	if K.SetDesc == nil then
		function K:SetDesc(O)
			local P = findChild("Desc")
			if P then
				setTranslated(P, "Text", O == nil and "" or tostring(O))
			elseif O ~= nil and O ~= "" then
				log((K._label or "Element") .. ": SetDesc only works if the element was created with a Desc. Add Desc = \"\" when you create it.")
			end
		end
	end

	K.Visible = true
	function K:SetVisible(O)
		K.Visible = O ~= false
		L.Visible = K.Visible

		L:SetAttribute(i.ATTR_HIDDEN, not K.Visible)
	end

	K.Locked = false
	local O, P
	function K:Lock(Q)
		return K:SetLocked(true, Q)
	end

	function K:Unlock()
		return K:SetLocked(false)
	end

	function K:SetLocked(Q, R)
		K.Locked = Q == true
		if K.Locked and type(K.SetOpen) == "function" then
			K:SetOpen(false)
		end

		if not O then
			if not K.Locked then
				return
			end
			O = create("TextButton", {
				Name = "Lock",
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = u.Background,
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
				ZIndex = 20,
				Parent = L,
			})
			addCorner(O)

			local S = create("Frame", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -10, 0.5, 0),
				Size = UDim2.fromOffset(0, i.CHIP_HEIGHT),
				AutomaticSize = Enum.AutomaticSize.X,
				BackgroundColor3 = u.Surface,
				BorderSizePixel = 0,
				ZIndex = 21,
				Parent = O,
			})
			addCorner(S, UDim.new(0, 6))
			addStroke(S)
			addPadding(S, 8, 10)
			create("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				VerticalAlignment = Enum.VerticalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 6),
				Parent = S,
			})

			local T = create("ImageLabel", {
				Size = UDim2.fromOffset(14, 14),
				BackgroundTransparency = 1,
				ImageColor3 = u.Muted,
				ScaleType = Enum.ScaleType.Fit,
				LayoutOrder = 1,
				ZIndex = 22,
				Parent = S,
			})
			setIcon(T, "lock")

			P = createLabel({
				Size = UDim2.new(0, 0, 1, 0),
				AutomaticSize = Enum.AutomaticSize.X,
				TextSize = 12,
				TextColor3 = u.Muted,
				TextTruncate = Enum.TextTruncate.None,
				LayoutOrder = 2,
				ZIndex = 22,
				Parent = S,
			})
		end

		P.Text = R or "Locked"
		O.Visible = K.Locked
		O.BackgroundTransparency = K.Locked and 0.35 or 1
	end

	local Q = M.Tooltip
	if N then
		L.MouseEnter:Connect(function()
			if x then
				return
			end
			if Q and not K.Locked then
				N:_showTooltip(Q, L)
			end
		end)
		L.MouseLeave:Connect(function()
			N:_hideTooltip(L)
		end)
	end
	function K:SetTooltip(R)
		Q = R
	end

	if M.Locked then
		K:SetLocked(true, M.LockedReason)
	end
	if M.Visible == false then
		K:SetVisible(false)
	end
end

local K = {}
K.__index = K

function K:_nextOrder()
	self._order += 1
	return self._order
end

function K:Section(L)
	local M = L
	if type(L) == "table" then
		M = L.Name or L.Title or ""
	end
	M = tostring(M or "")

	local N = create("Frame", {
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundTransparency = 1,
		LayoutOrder = self:_nextOrder(),
		Parent = self.List,
	})
	local O = createLabel({
		Name = "Title",
		Position = UDim2.fromOffset(2, 12),
		Size = UDim2.new(1, -4, 0, 16),
		Text = M,
		TextSize = 13,
		FontFace = w.Bold,
		TextColor3 = u.Text,
		Parent = N,
	})

	local P = {}
	function P:Set(Q)
		setTranslated(O, "Text", tostring(Q))
	end
	P.SetTitle = P.Set

	return registerElement(self, {}, P, N, "Section")
end

function K:Divider()
	local L = create("Frame", {
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = u.Stroke,
		BorderSizePixel = 0,
		LayoutOrder = self:_nextOrder(),
		Parent = self.List,
	})
	return registerElement(self, {}, {}, L, "Divider")
end

function K:Label(L)
	local M = normalizeOptions(L, { Name = "Text", Title = "Text" })

	local N = createLabel({
		Size = UDim2.new(1, 0, 0, 18),
		Text = tostring(M.Text or ""),
		TextSize = 13,
		FontFace = w.Regular,
		TextColor3 = M.Color or u.Muted,
		LayoutOrder = self:_nextOrder(),
		Parent = self.List,
	})
	addPadding(N, 2)

	local O = { _listeners = {} }
	function O:Set(P)
		N.Text = tostring(P)
	end
	function O:Get()
		return N.Text
	end

	if type(M.Update) == "function" then
		local P = math.max(tonumber(M.UpdateRate) or 1, 0.05)
		local Q = true
		table.insert(O._listeners, function()
			Q = false
		end)
		task.spawn(function()
			while Q and N.Parent do
				local R, S = pcall(M.Update)
				if R and S ~= nil then
					N.Text = tostring(S)
				elseif not R then
					log("label update error: " .. tostring(S))
				end
				task.wait(P)
			end
		end)
		function O:SetUpdateRate(R)
			P = math.max(tonumber(R) or P, 0.05)
		end
	end

	return registerElement(self, M, O, N, "Label")
end

i.PARAGRAPH_COLORS = {
	Red = Color3.fromRGB(240, 110, 110),
	Orange = Color3.fromRGB(245, 160, 90),
	Yellow = Color3.fromRGB(240, 205, 100),
	Green = Color3.fromRGB(120, 210, 150),
	Blue = Color3.fromRGB(110, 170, 250),
	Purple = Color3.fromRGB(175, 140, 250),
	Pink = Color3.fromRGB(240, 140, 190),
	Grey = Color3.fromRGB(150, 150, 156),
	Gray = Color3.fromRGB(150, 150, 156),
	White = Color3.fromRGB(235, 235, 240),
}

function K:Paragraph(L)
	local M = normalizeOptions(L, { Title = "Name", Desc = "Content", Description = "Content", Text = "Content" })

	local N = createCard(self, "Frame", 0)
	N.AutomaticSize = Enum.AutomaticSize.Y
	addPadding(N, 14, 14, 11, 12)
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 4),
		Parent = N,
	})

	local O = N
	local P
	if M.Copyable then
		O = create("Frame", {
			Size = UDim2.new(1, 0, 0, 14),
			BackgroundTransparency = 1,
			LayoutOrder = 1,
			Parent = N,
		})
		P = create("ImageButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 4, 0.5, 0),
			Size = UDim2.fromOffset(16, 16),
			BackgroundTransparency = 1,
			ImageColor3 = u.Muted,
			ScaleType = Enum.ScaleType.Fit,
			Parent = O,
		})
		setIcon(P, "copy")
		P.MouseEnter:Connect(function()
			if x then
				return
			end
			tween(P, { ImageColor3 = u.Accent }, 0.12)
		end)
		P.MouseLeave:Connect(function()
			tween(P, { ImageColor3 = u.Muted }, 0.2)
		end)
	end

	createLabel({
		Name = "Title",
		Size = UDim2.new(1, M.Copyable and -24 or 0, 0, 14),
		Text = M.Name or "",
		LayoutOrder = 1,
		Parent = O,
	})
	local Q = createLabel({
		Name = "Content",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Text = M.Content or "",
		TextSize = 13,
		FontFace = w.Regular,
		TextColor3 = u.Muted,
		TextWrapped = true,
		TextTruncate = Enum.TextTruncate.None,
		TextYAlignment = Enum.TextYAlignment.Top,
		LayoutOrder = 2,
		Parent = N,
	})

	local R = M.Color
	if type(R) == "string" then
		R = i.PARAGRAPH_COLORS[R] or u[R]
	end
	local S = O:FindFirstChild("Title")
	if typeof(R) == "Color3" then
		N.BackgroundColor3 = u.Surface2:Lerp(R, 0.12)
		N:SetAttribute(i.ATTR_NO_THEME, true)
		if S then
			S.TextColor3 = R
			S:SetAttribute(i.ATTR_NO_THEME, true)
		end
	end

	local T = M.Image or M.Icon
	if T ~= nil and T ~= "" and S then
		local U = math.clamp(tonumber(M.ImageSize) or 16, 12, 40)
		local V = create("Frame", {
			Name = "TitleRow",
			Size = UDim2.new(1, 0, 0, math.max(U, 14)),
			BackgroundTransparency = 1,
			LayoutOrder = 1,
			Parent = O == N and N or O,
		})
		local W = create("ImageLabel", {
			Name = "ParagraphImage",
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromScale(0, 0.5),
			Size = UDim2.fromOffset(U, U),
			BackgroundTransparency = 1,
			ImageColor3 = typeof(R) == "Color3" and R or u.Accent,
			ScaleType = Enum.ScaleType.Fit,
			Parent = V,
		})
		setIcon(W, T)
		S.Parent = V
		S.AnchorPoint = Vector2.new(0, 0.5)
		S.Position = UDim2.new(0, U + 8, 0.5, 0)
		S.Size = UDim2.new(1, -(U + 8) - (M.Copyable and 24 or 0), 0, 14)
	end

	local U = {}
	function U:Set(V)
		if type(V) == "table" then
			if V.Title ~= nil then
				U:SetTitle(V.Title)
			end
			V = V.Content or V.Desc
			if V == nil then
				return
			end
		end
		Q.Text = V == nil and "" or tostring(V)
	end
	U.SetContent = U.Set
	U.SetDesc = U.Set
	function U:Get()
		return Q.Text
	end

	if type(M.Buttons) == "table" and #M.Buttons > 0 then
		local V = create("Frame", {
			Name = "Buttons",
			Size = UDim2.new(1, 0, 0, 30),
			BackgroundTransparency = 1,
			LayoutOrder = 3,
			Parent = N,
		})
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = V,
		})
		create("UIPadding", { PaddingTop = UDim.new(0, 4), Parent = V })
		for W, X in ipairs(M.Buttons) do
			if type(X) == "table" then
				local Y = X.Primary == true or X.Variant == "Primary"
				local Z = create("TextButton", {
					Size = UDim2.fromOffset(0, 26),
					AutomaticSize = Enum.AutomaticSize.X,
					BackgroundColor3 = Y and u.Accent or u.Surface,
					BorderSizePixel = 0,
					Text = "",
					AutoButtonColor = false,
					LayoutOrder = W,
					Parent = V,
				})
				Z:SetAttribute(i.ATTR_NO_DRAG, true)
				addCorner(Z, UDim.new(0, 7))
				if not Y then
					addStroke(Z)
				end
				local _ = 10
				if X.Icon then
					createIcon(Z, X.Icon, Y and u.AccentDark or u.Muted, UDim2.new(0, 9, 0.5, 0))
					_ = 29
				end
				addPadding(Z, _, 10)
				createLabel({
					Size = UDim2.fromOffset(0, 26),
					AutomaticSize = Enum.AutomaticSize.X,
					Text = tostring(X.Title or X.Name or "Button"),
					TextSize = 12,
					TextColor3 = Y and u.AccentDark or u.Text,
					TextTruncate = Enum.TextTruncate.None,
					Parent = Z,
				})
				Z.MouseButton1Click:Connect(function()
					if type(X.Callback) == "function" then
						runProtected(("paragraph button \"%s\""):format(tostring(X.Title or X.Name)), X.Callback)
					end
				end)
			end
		end
	end

	if P then
		P.MouseButton1Click:Connect(function()
			h:Copy(Q.Text)
		end)
	end

	return registerElement(self, M, U, N, "Paragraph")
end

i.BUTTON_STYLES = {
	Primary = "Accent",
	Danger = "Error",
}

function K:Button(L)
	local M = normalizeOptions(L, { Title = "Name", Description = "Desc" })

	local N = i.BUTTON_STYLES[M.Style]
	local O = N ~= nil
	local P = M.Desc and i.ROW_HEIGHT_DESC or i.ROW_HEIGHT
	local Q, R = createCard(self, "TextButton", P)
	Q.ClipsDescendants = true

	if O then
		Q.BackgroundColor3 = u[N]
		Q.BackgroundTransparency = 0.12
		R.Color = u[N]
		R.Transparency = 0.4
		Q.MouseEnter:Connect(function()
			if x then
				return
			end
			tween(Q, { BackgroundTransparency = 0 }, 0.12)
			tween(R, { Transparency = 0 }, 0.12)
		end)
		Q.MouseLeave:Connect(function()
			tween(Q, { BackgroundTransparency = 0.12 }, 0.25)
			tween(R, { Transparency = 0.4 }, 0.25)
		end)
	else
		bindHoverStroke(Q, R)
	end

	local S = 0
	if M.Icon then
		createIcon(Q, M.Icon, O and u.AccentDark or u.Accent, UDim2.new(0, 14, 0.5, 0))
		S = 26
	end

	local T, U = createTitleBlock(Q, M.Name or "Button", M.Desc, 30)
	for V, W in ipairs({ T, U }) do
		if S > 0 then
			W.Position += UDim2.fromOffset(S, 0)
			W.Size -= UDim2.fromOffset(S, 0)
		end
		if O then
			W.TextColor3 = u.AccentDark
		end
	end

	createIcon(Q, "mouse-pointer-click", O and u.AccentDark or u.Muted, UDim2.new(1, -30, 0.5, 0))

	local V = {}
	local W = T.Text
	local X = T.TextColor3
	local Y = false
	local Z = 0
	local _ = type(M.Confirm) == "string" and M.Confirm or "Click again to confirm"

	local function disarm()
		Y = false
		Z += 1
		T.Text = W
		tween(T, { TextColor3 = X }, 0.2)
	end

	local function activate()
		if V.Locked or V._destroyed then
			return
		end
		ripple(Q, O and u.AccentDark or u.Accent)
		if M.Confirm and not Y then
			Y = true
			Z += 1
			local aa = Z
			T.Text = _
			tween(T, { TextColor3 = O and u.AccentDark or u.Warning }, 0.15)
			task.delay(M.ConfirmTimeout or 2.5, function()
				if Y and Z == aa then
					disarm()
				end
			end)
			return
		end
		if Y then
			disarm()
		end
		safeCall(M.Callback)
	end
	Q.MouseButton1Click:Connect(activate)

	local aa = self.Window
	local ab = toKeyCode(M.Keybind)
	local ac = createLabel({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -44, 0.5, 0),
		Size = UDim2.fromOffset(0, 18),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = "",
		TextSize = 12,
		TextColor3 = O and u.AccentDark or u.Muted,
		TextTruncate = Enum.TextTruncate.None,
		Visible = false,
		Parent = Q,
	})
	local function renderKey()
		ac.Visible = ab ~= nil
		ac.Text = ab and ("[" .. keyDisplayName(ab) .. "]") or ""
		setTitleReserve(T, U, 30 + (ab and (ac.TextBounds.X + 14) or 0))
	end
	ac:GetPropertyChangedSignal("TextBounds"):Connect(renderKey)
	if aa then
		aa:_listen("Began", function(ad, ae)
			if ae or ab == nil or ad.KeyCode ~= ab then
				return
			end
			if b:GetFocusedTextBox() then
				return
			end
			activate()
		end, V)
		aa:_registerKeybind({
			Name = M.Name or "Button",
			Element = V,
			GetKey = function()
				return ab
			end,
			GetActive = function()
				return false
			end,
		})
	end
	renderKey()

	function V:SetKeybind(ad)
		ab = toKeyCode(ad)
		renderKey()
	end
	function V:GetKeybind()
		return ab
	end
	function V:Press()
		activate()
	end

	function V:SetText(ad)
		W = tostring(ad)
		if not Y then
			T.Text = W
		end
	end
	V.SetTitle = V.SetText

	return registerElement(self, M, V, Q, "Button")
end

function K:Toggle(aa)
	local ab, ac, ad, ae, L, M = createRowElement(self, aa, {
		Title = "Name",
		Description = "Desc",
		CurrentValue = "Default",
		Value = "Default",
	}, "TextButton", 56, "Toggle")

	local N = x and 36 or 32
	local O = x and 14 or 12

	local P = ab.Type == "Checkbox" or ab.Style == "Checkbox"
	local Q = x and 20 or 18
	local R = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = P and UDim2.fromOffset(Q, Q) or (x and UDim2.fromOffset(36, 20) or UDim2.fromOffset(32, 18)),
		BackgroundColor3 = u.Surface3,
		BorderSizePixel = 0,
		Parent = ac,
	})
	addCorner(R, P and UDim.new(0, 5) or UDim.new(1, 0))
	addStroke(R, u.Stroke)
	addInnerShadow(R, 0.62, 0.6)
	local S
	if P then
		N = Q
		S = create("ImageLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(Q - 6, Q - 6),
			BackgroundTransparency = 1,
			ImageColor3 = u.AccentDark,
			ImageTransparency = 1,
			ZIndex = 2,
			Parent = R,
		})
		setIcon(S, "check")
	end

	local T = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(O, O),
		BackgroundColor3 = u.Muted,
		BorderSizePixel = 0,
		Parent = R,
	})
	addCorner(T, UDim.new(1, 0))

	local U = { Value = ab.Default == true }

	local function render(V)
		local W = U.Value
		local X = V and 0.25 or 0
		if P then
			T.Visible = false
			tween(R, { BackgroundColor3 = W and u.Accent or u.Surface3 }, X * 0.6)
			tween(S, { ImageTransparency = W and 0 or 1 }, X * 0.6)
			return
		end
		tween(R, { BackgroundColor3 = W and u.Accent or u.Surface3 }, X)
		tween(T, {
			Position = W and UDim2.new(0, N - 3 - O, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
		}, X, Enum.EasingStyle.Back)
		tween(T, { BackgroundColor3 = W and u.AccentDark or u.Muted }, X)

		if V then

			tween(T, { Size = UDim2.fromOffset(O + 4, O - 2) }, 0.08)
			task.delay(0.08, function()
				tween(T, { Size = UDim2.fromOffset(O, O) }, 0.2, Enum.EasingStyle.Back)
			end)
		end
	end

	local V = false
	function U:Set(W, X)
		W = W == true
		if W == U.Value then
			return
		end
		U.Value = W
		render(true)
		if not V then
			flashStroke(ad)
		end
		if not X then
			safeCall(ab.Callback, W)
		end
	end

	function U:Get()
		return U.Value
	end

	render(false)

	ac.MouseButton1Click:Connect(function()
		V = true
		U:Set(not U.Value)
		V = false
	end)

	local W = self.Window
	local X = toKeyCode(ab.Keybind)
	local Y = createLabel({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -(14 + N + 10), 0.5, 0),
		Size = UDim2.fromOffset(0, 18),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = "",
		TextSize = 12,
		TextColor3 = u.Muted,
		TextTruncate = Enum.TextTruncate.None,
		Visible = false,
		Parent = ac,
	})

	local function renderKey()
		Y.Visible = X ~= nil
		Y.Text = X and ("[" .. keyDisplayName(X) .. "]") or ""
		local Z = X and (Y.TextBounds.X + 10) or 0
		setTitleReserve(L, M, 56 + Z)
	end
	Y:GetPropertyChangedSignal("TextBounds"):Connect(renderKey)

	function U:SetKeybind(Z)
		X = toKeyCode(Z)
		renderKey()
	end
	function U:GetKeybind()
		return X
	end

	W:_listen("Began", function(Z, _)
		if _ or U.Locked or X == nil then
			return
		end
		if Z.KeyCode ~= X or b:GetFocusedTextBox() then
			return
		end
		U:Set(not U.Value)
	end, U)

	W:_registerKeybind({
		Name = ab.Name or "Toggle",
		Element = U,
		GetKey = function()
			return X
		end,
		GetActive = function()
			return U.Value
		end,
	})

	renderKey()

	local Z = registerElement(self, ab, U, ac, "Toggle")
	if type(ab.Loop) == "function" then
		local _
		local function syncLoop(af)
			if af == true and not (_ and _.Running) then
				_ = W:Loop(ab.Loop, ab.LoopDelay or ab.Delay, ab.Name or "Toggle")
			elseif af ~= true and _ then
				_:Stop()
				_ = nil
			end
		end
		local af = U.Set
		function U:Set(ag, ah)
			af(self, ag, ah)
			syncLoop(U.Value)
		end
		table.insert(U._listeners, function()
			syncLoop(false)
		end)
		task.defer(function()
			if not U._destroyed then
				syncLoop(U.Value)
			end
		end)
	end
	if ab.MobileButton and (x or ab.MobileButton == "Always") then
		W:FloatingButton({ Title = ab.Name or "Toggle", Icon = ab.MobileIcon, Toggle = U })
	end
	if U.Value then
		safeCall(ab.Callback, true)
	end
	return Z
end

function K:Slider(aa)
	local ab = normalizeOptions(aa, {
		Title = "Name",
		Description = "Desc",
		CurrentValue = "Default",
		Value = "Default",
		Increment = "Step",
	})

	local ac = math.min(tonumber(ab.Min) or 0, tonumber(ab.Max) or 100)
	local ad = math.max(tonumber(ab.Min) or 0, tonumber(ab.Max) or 100)
	local ae = tonumber(ab.Step) or 1
	local af = ab.Suffix or ""
	local ag = createStepper(ac, ad, ae)
	local ah = self.Window

	local L = i.ROW_HEIGHT_DESC + 4 + (ab.Desc and 18 or 0)
	local M, N = createCard(self, "Frame", L)
	bindHoverStroke(M, N)

	createLabel({
		Name = "Title",
		Position = UDim2.fromOffset(14, 10),
		Size = UDim2.new(1, -120, 0, 18),
		Text = ab.Name or "Slider",
		Parent = M,
	})
	if ab.Desc then
		createLabel({
			Name = "Desc",
			Position = UDim2.fromOffset(14, 28),
			Size = UDim2.new(1, -28, 0, 17),
			Text = ab.Desc,
			TextSize = 13,
			FontFace = w.Regular,
			TextColor3 = u.Muted,
			Parent = M,
		})
	end

	local O = create("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 8),
		Size = UDim2.fromOffset(40, 22),
		BackgroundColor3 = u.Surface,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = M,
	})
	addCorner(O, UDim.new(0, 6))
	local P = addStroke(O)

	local Q = createLabel({
		Size = UDim2.new(1, 0, 1, 0),
		TextSize = 13,
		TextColor3 = u.Accent,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextTruncate = Enum.TextTruncate.None,
		Parent = O,
	})

	local R = create("TextBox", {
		Position = UDim2.fromOffset(9, 0),
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		Text = "",
		TextColor3 = u.Text,
		TextSize = 13,
		FontFace = w.Medium,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		Visible = false,
		Parent = O,
	})
	create("UISizeConstraint", {
		MinSize = Vector2.new(14, 0),
		Parent = R,
	})

	local S = createLabel({
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = af,
		TextSize = 13,
		TextColor3 = u.Accent,
		TextTruncate = Enum.TextTruncate.None,
		Visible = false,
		Parent = O,
	})

	local T = create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 2,
		Parent = O,
	})

	local U = false
	local function fitChip(V)
		local W
		if U then
			local X = R.AbsoluteSize.X / ah.Scale.Scale
			W = 9 + X + S.TextBounds.X + 9
			S.Position = UDim2.fromOffset(9 + X, 0)
		else
			W = Q.TextBounds.X + 18
		end
		W = math.max(W, 36)
		if V then
			O.Size = UDim2.fromOffset(W, 22)
		else
			tween(O, { Size = UDim2.fromOffset(W, 22) }, 0.2)
		end
	end

	Q:GetPropertyChangedSignal("TextBounds"):Connect(function()
		if not U then
			fitChip(false)
		end
	end)
	R:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if U then
			fitChip(false)
		end
	end)

	local V = create("Frame", {
		Position = UDim2.new(0, 14, 0, L - 16),
		Size = UDim2.new(1, -28, 0, 5),
		BackgroundColor3 = u.Surface3,
		BorderSizePixel = 0,
		Parent = M,
	})
	addCorner(V, UDim.new(1, 0))
	addInnerShadow(V, 0.6, 1)

	local W = create("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = u.Accent,
		BorderSizePixel = 0,
		Parent = V,
	})
	addCorner(W, UDim.new(1, 0))

	local X = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(12, 12),
		BackgroundColor3 = u.Accent,
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = V,
	})
	addCorner(X, UDim.new(1, 0))

	local Y = create("TextButton", {
		Position = UDim2.new(0, 8, 0, L - (x and 35 or 29)),
		Size = UDim2.new(1, -16, 0, x and 38 or 26),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 4,
		Parent = M,
	})

	local Z = {
		Value = math.clamp(tonumber(ab.Default) or ac, ac, ad),
	}
	local _ = false

	T.MouseEnter:Connect(function()
		if x then
			return
		end
		tween(P, { Color = u.StrokeHover }, 0.12)
	end)
	T.MouseLeave:Connect(function()
		if not R:IsFocused() then
			tween(P, { Color = u.Stroke }, 0.2)
		end
	end)

	T.MouseButton1Click:Connect(function()
		U = true
		R.Text = ag.format(Z.Value)
		Q.Visible = false
		R.Visible = true
		S.Visible = af ~= ""
		T.Visible = false
		tween(P, { Color = u.StrokeHover }, 0.12)
		R:CaptureFocus()
		task.defer(fitChip, false)
	end)

	R.FocusLost:Connect(function()
		local ai = tonumber(R.Text)
		U = false
		R.Visible = false
		S.Visible = false
		Q.Visible = true
		T.Visible = true
		tween(P, { Color = u.Stroke }, 0.2)
		if ai then
			Z:Set(ai)
		end
		fitChip(false)
	end)

	Y.MouseEnter:Connect(function()
		if x then
			return
		end
		if not _ then
			tween(X, { Size = UDim2.fromOffset(14, 14) }, 0.15, Enum.EasingStyle.Back)
		end
	end)
	Y.MouseLeave:Connect(function()
		if not _ then
			tween(X, { Size = UDim2.fromOffset(12, 12) }, 0.2)
		end
	end)

	local ai = ag.snap

	local function getAlpha()
		if ad - ac == 0 then
			return 0
		end
		return (Z.Value - ac) / (ad - ac)
	end

	local function moveTo(aj, ak, al)
		al = al or Enum.EasingStyle.Linear
		tween(W, { Size = UDim2.new(aj, 0, 1, 0) }, ak, al)
		tween(X, { Position = UDim2.new(aj, 0, 0.5, 0) }, ak, al)
	end

	local function render(aj, ak)
		moveTo(getAlpha(), aj, ak)
		Q.Text = ag.format(Z.Value) .. af
	end

	local function renderWithNudge(aj)
		local ak = getAlpha()
		local al = math.max(V.AbsoluteSize.X, 1)
		local am = (ak >= aj and 1 or -1) * (5 / al)
		moveTo(math.clamp(ak + am, 0, 1), 0.22, Enum.EasingStyle.Quint)
		task.delay(0.22, function()
			if not _ then
				moveTo(getAlpha(), 0.18, Enum.EasingStyle.Quint)
			end
		end)
		Q.Text = ag.format(Z.Value) .. af
	end

	local function pulseKnob()
		tween(X, { Size = UDim2.fromOffset(14, 12) }, 0.08)
		task.delay(0.1, function()
			tween(X, { Size = UDim2.fromOffset(12, 12) }, 0.25, Enum.EasingStyle.Quint)
		end)
	end

	function Z:Set(aj, ak)
		aj = ai(tonumber(aj) or ac)
		if aj == Z.Value then
			return
		end
		local al = getAlpha()
		Z.Value = aj
		if _ then
			render(0.05)
		else
			renderWithNudge(al)
			pulseKnob()
			flashStroke(N)
		end
		if not ak then
			safeCall(ab.Callback, aj)
		end
	end

	function Z:Get()
		return Z.Value
	end

	function Z:SetMin(aj)
		return Z:SetRange(aj, ad)
	end

	function Z:SetMax(aj)
		return Z:SetRange(ac, aj)
	end

	function Z:SetRange(aj, ak, al)
		ac = math.min(tonumber(aj) or ac, tonumber(ak) or ad)
		ad = math.max(tonumber(aj) or ac, tonumber(ak) or ad)
		ae = tonumber(al) or ae
		ag = createStepper(ac, ad, ae)
		ai = ag.snap
		Z.Value = ai(Z.Value)
		render(0.2, Enum.EasingStyle.Quint)
	end

	local function setFromScreenX(aj)
		local ak = V.AbsoluteSize.X
		if ak <= 0 then
			return
		end
		local al = math.clamp((aj - V.AbsolutePosition.X) / ak, 0, 1)
		Z:Set(ac + (ad - ac) * al)
	end

	Y.InputBegan:Connect(function(aj)
		if isPress(aj) and not Z.Locked then
			_ = true
			tween(X, { Size = UDim2.fromOffset(16, 16) }, 0.15, Enum.EasingStyle.Back)
			setFromScreenX(getMousePosition().X)
		end
	end)

	ah:_listen("Changed", function(aj)
		if _ and isMove(aj) then
			setFromScreenX(getMousePosition().X)
		end
	end, Z)

	ah:_listen("Ended", function(aj)
		if _ and isPress(aj) then
			_ = false
			tween(X, { Size = UDim2.fromOffset(12, 12) }, 0.2)
			safeCall(ab.OnRelease, Z.Value)
		end
	end, Z)

	Z.Value = ai(Z.Value)
	render(0)
	task.defer(fitChip, true)

	return registerElement(self, ab, Z, M, "Slider")
end

i.DROPDOWN_CHIP_MAX_TEXT = 146

function K:Dropdown(aa)
	local ab = normalizeOptions(aa, {
		Title = "Name",
		Description = "Desc",
		CurrentOption = "Default",
		Value = "Default",
		MultipleOptions = "Multi",
		Values = "Options",
	})

	local ac = ab.Multi == true
	if ac and type(ab.Default) ~= "table" and ab.Default ~= nil then
		ab.Default = { ab.Default }
	elseif not ac and type(ab.Default) == "table" then
		ab.Default = ab.Default[1]
	end

	local ad = table.clone(ab.Options or {})
	local ae = ab.Placeholder or "None"
	local af = ab.SearchAfter or 6

	local ag, ah, ai, aj = createRowElement(self, ab, {}, "Frame")
	ah.ClipsDescendants = true

	local ak = create("TextButton", {
		Size = UDim2.new(1, 0, 0, aj),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = ah,
	})
	local al, am = createTitleBlock(ak, ab.Name or "Dropdown", ab.Desc, 180)

	local L = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(60, i.CHIP_HEIGHT),
		BackgroundColor3 = u.Surface,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = ak,
	})
	addCorner(L, UDim.new(0, 6))
	local M = addStroke(L)

	local N = createLabel({
		Position = UDim2.fromOffset(10, 0),
		Size = UDim2.new(1, -34, 1, 0),
		TextColor3 = u.Muted,
		TextSize = 13,
		TextTruncate = Enum.TextTruncate.None,
		ClipsDescendants = true,
		Parent = L,
	})
	local O = createChevron(L, 1, -6)

	local P = createLabel({
		Position = UDim2.fromOffset(0, 1000),
		Size = UDim2.fromOffset(0, i.CHIP_HEIGHT),
		AutomaticSize = Enum.AutomaticSize.X,
		TextSize = 13,
		TextTransparency = 1,
		TextTruncate = Enum.TextTruncate.None,
		Parent = L,
	})
	local Q = ""

	local function truncatedSelection()
		P.Text = Q
		if P.TextBounds.X <= i.DROPDOWN_CHIP_MAX_TEXT then
			return Q
		end
		local R = utf8.len(Q)
		local function prefix(S)
			if not R then
				return Q:sub(1, S)
			end
			return Q:sub(1, (utf8.offset(Q, S + 1) or #Q + 1) - 1)
		end
		local S, T = 0, (R or #Q) - 1
		while S < T do
			local U = math.ceil((S + T) / 2)
			P.Text = prefix(U) .. ".."
			if P.TextBounds.X <= i.DROPDOWN_CHIP_MAX_TEXT then
				S = U
			else
				T = U - 1
			end
		end
		return prefix(S) .. ".."
	end

	local function fitChip(R)
		local S = math.clamp(N.TextBounds.X + 10 + 34, 60, 190)
		setTitleReserve(al, am, S + 20)
		if R then
			L.Size = UDim2.fromOffset(S, i.CHIP_HEIGHT)
		else
			tween(L, { Size = UDim2.fromOffset(S, i.CHIP_HEIGHT) }, 0.2)
		end
	end
	N:GetPropertyChangedSignal("TextBounds"):Connect(function()
		fitChip(false)
	end)

	local R = create("Frame", {
		Position = UDim2.new(0, 10, 0, aj),
		Size = UDim2.new(1, -20, 0, 0),
		BackgroundTransparency = 1,
		Parent = ah,
	})
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 4),
		Parent = R,
	})

	local S = { Open = false }
	local T = {}
	local U = {}
	local V = ""
	local W = 0

	local X = create("Frame", {
		Size = UDim2.new(1, 0, 0, i.OPTION_HEIGHT),
		BackgroundColor3 = u.Surface,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		LayoutOrder = 0,
		Visible = false,
		Parent = R,
	})
	addCorner(X, UDim.new(0, 6))
	local Y = addStroke(X, u.Stroke, 1)
	local Z, _ = createIcon(X, "search", u.Muted, UDim2.new(0, 10, 0.5, 0))
	_.Parent.Size = UDim2.fromOffset(14, 14)
	_.ImageTransparency = 1
	local an = create("TextBox", {
		Position = UDim2.fromOffset(32, 0),
		Size = UDim2.new(1, -40, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		PlaceholderText = "Search",
		PlaceholderColor3 = u.Muted,
		TextColor3 = u.Text,
		TextSize = 13,
		FontFace = w.Regular,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		TextTransparency = 1,
		Parent = X,
	})

	local function matchesSearch(ao)
		return V == "" or string.find(string.lower(tostring(ao)), V, 1, true) ~= nil
	end

	if ac then
		for ao, ap in ipairs(ab.Default or {}) do
			T[ap] = true
		end
	elseif ab.Default ~= nil then
		T[ab.Default] = true
	end

	local function getSelection()
		if ac then
			local ao = {}
			for ap, aq in ipairs(ad) do
				if T[aq] then
					table.insert(ao, aq)
				end
			end
			return ao
		end
		for ao, ap in ipairs(ad) do
			if T[ap] then
				return ap
			end
		end
		return nil
	end

	local function renderSelection()
		local ao = getSelection()
		if ac then
			local ap = {}
			for aq, ar in ipairs(ao) do
				ap[aq] = tostring(ar)
			end
			Q = #ap > 0 and table.concat(ap, ", ") or ae
		else
			Q = ao ~= nil and tostring(ao) or ae
		end
		N.Text = truncatedSelection()

		for ap, aq in pairs(U) do
			local ar = T[ap] == true
			if aq.On ~= ar then
				aq.On = ar
				tween(aq.Label, { TextColor3 = ar and u.Text or u.Muted }, 0.15)
				if S.Open then
					tween(aq.Check, { ImageTransparency = ar and 0 or 1 }, 0.15)
					tween(aq.CheckScale, { Scale = ar and 1 or 0.6 }, ar and 0.3 or 0.15,
						ar and Enum.EasingStyle.Back or Enum.EasingStyle.Quint)
				end
			end
		end
	end

	local function visibleOptionCount()
		local ao = 0
		for ap, aq in ipairs(ad) do
			if matchesSearch(aq) then
				ao += 1
			end
		end
		return ao
	end

	local function applySearch()
		for ao, ap in pairs(U) do
			ap.Frame.Visible = matchesSearch(ao)
		end
	end

	local function openHeight()
		local ao = visibleOptionCount() + (X.Visible and 1 or 0)
		return aj + ao * (i.OPTION_HEIGHT + 4) + 8
	end

	local function fadeRow(ao, ap)
		if not ao.Stroke then
			ao.Stroke = addStroke(ao.Frame, u.Stroke, 1)
		end
		local aq = ap and ao.On
		tween(ao.Check, { ImageTransparency = aq and 0 or 1 }, 0.18)
		ao.CheckScale.Scale = aq and 1 or 0.6
		tween(ao.Label, { TextTransparency = ap and 0 or 1 }, 0.18)
		tween(ao.Stroke, { Transparency = ap and 0 or 1 }, 0.18)
		tween(ao.Frame, { BackgroundTransparency = ap and 0 or 1 }, 0.18)
	end

	local function setOpen(ao)
		S.Open = ao
		X.Visible = #ad > af
		if not ao then
			V = ""
			an.Text = ""
			an:ReleaseFocus()
			applySearch()
		end

		tween(ah, { Size = UDim2.new(1, 0, 0, ao and openHeight() or aj) }, 0.3, Enum.EasingStyle.Quint)
		tween(X, { BackgroundTransparency = ao and 0 or 1 }, 0.2)
		tween(Y, { Transparency = ao and 0 or 1 }, 0.2)
		tween(an, { TextTransparency = ao and 0 or 1 }, 0.2)
		tween(_, { ImageTransparency = ao and 0 or 1 }, 0.2)
		O:Set(ao)
		tween(M, { Color = ao and u.StrokeHover or u.Stroke }, 0.2)

		W += 1
		local ap = W

		if ao then

			task.spawn(function()
				local aq = true
				for ar, as in ipairs(ad) do
					local at = U[as]
					if at and at.Frame.Visible then
						if not aq then
							task.wait(0.025)
							if W ~= ap or not S.Open then
								return
							end
						end
						aq = false
						fadeRow(at, true)
					end
				end
			end)
		else

			local aq = {}
			for ar, as in ipairs(ad) do
				local at = U[as]
				if at and at.Frame.Visible then
					table.insert(aq, at)
				end
			end
			task.spawn(function()
				for ar = #aq, 1, -1 do
					fadeRow(aq[ar], false)
					if ar > 1 then
						task.wait(0.015)
						if W ~= ap or S.Open then
							return
						end
					end
				end
			end)
		end
	end

	local function buildRows()
		local ao = {}
		for ap, aq in ipairs(ad) do
			ao[aq] = ap
		end

		for ap, aq in pairs(U) do
			if not ao[ap] then
				aq.Frame:Destroy()
				U[ap] = nil
			end
		end

		for ap, aq in ipairs(ad) do
			local ar = U[aq]
			if ar then
				ar.Frame.LayoutOrder = ap
				continue
			end

			local as = create("TextButton", {
				Size = UDim2.new(1, 0, 0, i.OPTION_HEIGHT),
				BackgroundColor3 = u.Surface,
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
				LayoutOrder = ap,
				Parent = R,
			})
			addCorner(as, UDim.new(0, 6))

			local at = create("ImageLabel", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -10, 0.5, 0),
				Size = UDim2.fromOffset(14, 14),
				BackgroundTransparency = 1,
				ImageColor3 = u.Accent,
				ImageTransparency = 1,
				ScaleType = Enum.ScaleType.Fit,
				Parent = as,
			})
			setIcon(at, "check")
			local au = create("UIScale", { Scale = 0.6, Parent = at })

			local av = createLabel({
				Position = UDim2.fromOffset(12, -1),
				Size = UDim2.new(1, -36, 1, 0),
				Text = tostring(aq),
				TextSize = 13,
				TextColor3 = u.Muted,
				TextTransparency = 1,
				Parent = as,
			})

			local aw = {
				Frame = as,
				Label = av,
				Check = at,
				CheckScale = au,
				Stroke = nil,
				On = nil,
			}
			U[aq] = aw

			as.MouseEnter:Connect(function()
				if x then
					return
				end
				tween(av, { TextColor3 = u.Text }, 0.15)
				if aw.Stroke then
					tween(aw.Stroke, { Color = u.StrokeHover }, 0.12)
				end
			end)
			as.MouseLeave:Connect(function()
				tween(av, { TextColor3 = T[aq] and u.Text or u.Muted }, 0.2)
				if aw.Stroke then
					tween(aw.Stroke, { Color = u.Stroke }, 0.2)
				end
			end)

			as.MouseButton1Click:Connect(function()
				if not S.Open then
					return
				end
				if T[aq] then
					T[aq] = nil
				else
					if not ac then
						T = {}
					end
					T[aq] = true
				end
				renderSelection()
				safeCall(ab.Callback, getSelection())
				if not ac and T[aq] then
					setOpen(false)
				end
			end)
		end

		applySearch()
		if S.Open then
			ah.Size = UDim2.new(1, 0, 0, openHeight())
		end
	end

	function S:Set(ao, ap)
		T = {}
		if ac then
			for aq, ar in ipairs(type(ao) == "table" and ao or { ao }) do
				T[ar] = true
			end
		elseif ao ~= nil then
			T[ao] = true
		end
		renderSelection()
		flashStroke(ai)
		if not ap then
			safeCall(ab.Callback, getSelection())
		end
	end

	function S:Get()
		return getSelection()
	end

	function S:Select(ao)
		return S:Set(ao)
	end

	function S:Refresh(ao, ap)
		ad = table.clone(ao or {})
		if not ap then
			T = {}
		end
		buildRows()
		renderSelection()
		if S.Open then
			setOpen(true)
		end
	end

	function S:SetOpen(ao)
		setOpen(ao == true)
	end

	function S:GetOptions()
		return table.clone(ad)
	end

	function S:Add(ao)
		if table.find(ad, ao) then
			return
		end
		local ap = table.clone(ad)
		table.insert(ap, ao)
		S:Refresh(ap, true)
	end

	function S:Remove(ao)
		local ap = table.find(ad, ao)
		if not ap then
			return
		end
		local aq = table.clone(ad)
		table.remove(aq, ap)
		local ar = T[ao]
		T[ao] = nil
		S:Refresh(aq, true)
		if ar then
			safeCall(ab.Callback, getSelection())
		end
	end

	function S:Clear(ao)
		S:Set(ac and {} or nil, ao)
	end

	ak.MouseButton1Click:Connect(function()
		setOpen(not S.Open)
	end)

	if ab.Players then
		local function playerNames()
			local ao = {}
			for ap, aq in ipairs(f:GetPlayers()) do
				if not (ab.ExcludeSelf and aq == g) then
					table.insert(ao, ab.UseDisplayName and aq.DisplayName or aq.Name)
				end
			end
			table.sort(ao, function(ap, aq)
				return string.lower(ap) < string.lower(aq)
			end)
			return ao
		end
		ad = playerNames()
		local function resync()
			task.defer(function()
				if not S._destroyed then
					S:Refresh(playerNames(), true)
				end
			end)
		end
		local ao = f.PlayerAdded:Connect(resync)
		local ap = f.PlayerRemoving:Connect(resync)
		S._listeners = S._listeners or {}
		table.insert(S._listeners, function()
			ao:Disconnect()
			ap:Disconnect()
		end)
	end

	an.Focused:Connect(function()
		tween(_, { ImageColor3 = u.Text }, 0.15)
		tween(Y, { Color = u.StrokeHover }, 0.15)
	end)
	an.FocusLost:Connect(function()
		tween(_, { ImageColor3 = u.Muted }, 0.2)
		tween(Y, { Color = u.Stroke }, 0.2)
	end)
	an:GetPropertyChangedSignal("Text"):Connect(function()
		V = string.lower(an.Text)
		applySearch()
		if S.Open then
			tween(ah, { Size = UDim2.new(1, 0, 0, openHeight()) }, 0.2, Enum.EasingStyle.Quint)
		end
	end)

	buildRows()
	renderSelection()
	task.defer(fitChip, true)

	return registerElement(self, ab, S, ah, "Dropdown")
end

function K:Input(aa)
	if type(aa) == "table" and (aa.MultiLine or aa.Multiline) then
		return self:TextArea(aa)
	end
	local ab, ac, ad, ae, af, ah = createRowElement(self, aa, {
		Title = "Name",
		Description = "Desc",
		PlaceholderText = "Placeholder",
		CurrentValue = "Default",
		Value = "Default",
	}, "Frame", 160, "Input")

	local ai = self.Window
	local aj = ab.Icon ~= nil
	local ak = tonumber(ab.MaxLength)

	local al = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(170, 26),
		BackgroundColor3 = u.Surface,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = ac,
	})
	addCorner(al, UDim.new(0, 6))
	local am = addStroke(al)
	addInnerShadow(al, 0.6, 0.45)

	if aj then
		createIcon(al, ab.Icon, u.Muted, UDim2.new(0, 8, 0.5, 0))
	end

	local function clampLength(an)
		an = tostring(an or "")
		if ak and #an > ak then
			return an:sub(1, ak)
		end
		return an
	end

	local an = create("TextBox", {
		Position = UDim2.fromOffset(aj and 30 or 8, 0),
		Size = UDim2.new(1, aj and -38 or -16, 1, 0),
		BackgroundTransparency = 1,
		Text = clampLength(ab.Default),
		PlaceholderText = ab.Placeholder or "",
		PlaceholderColor3 = u.Muted,
		TextColor3 = u.Text,
		TextSize = 14,
		FontFace = w.Regular,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = ab.ClearOnFocus == true,
		TextTruncate = Enum.TextTruncate.None,
		ClipsDescendants = true,
		Parent = al,
	})

	local ao = false
	local ap = (aj and 30 or 8) + 8

	local function fitBox(aq)
		local ar = ac.AbsoluteSize.X / ai.Scale.Scale
		local as = math.clamp(ar - 14 - 110 - 20, 100, 200)
		local at = an.TextBounds.X
		if #an.Text == 0 then
			at = math.min(an.TextBounds.X, 90)
		end
		local au = math.clamp(at + ap + 12, 90, as) + (ao and 8 or 0)
		au = math.min(au, as + 8)
		setTitleReserve(af, ah, au + 20)
		if aq then
			al.Size = UDim2.fromOffset(au, 26)
		else
			tween(al, { Size = UDim2.fromOffset(au, 26) }, 0.18)
		end
	end

	ac:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		fitBox(true)
	end)

	an:GetPropertyChangedSignal("Text"):Connect(function()
		local aq = clampLength(an.Text)
		if aq ~= an.Text then
			an.Text = aq
			return
		end
		fitBox(false)
		if an:IsFocused() then
			safeCall(ab.OnChanged, an.Text)
		end
	end)
	an:GetPropertyChangedSignal("TextBounds"):Connect(function()
		fitBox(false)
	end)
	task.defer(fitBox, true)

	an.Focused:Connect(function()
		ao = true
		tween(am, { Color = u.StrokeHover }, 0.15)
		fitBox(false)
	end)

	an.FocusLost:Connect(function(aq)
		ao = false
		tween(am, { Color = u.Stroke }, 0.15)
		fitBox(false)
		if ab.Numeric and not tonumber(an.Text) then
			an.Text = ""
			return
		end
		safeCall(ab.Callback, an.Text, aq)
	end)

	local aq = {}
	function aq:Set(ar, as)
		an.Text = clampLength(ar)
		flashStroke(ad)
		if not as then
			safeCall(ab.Callback, an.Text, false)
		end
	end
	function aq:Get()
		return an.Text
	end
	function aq:SetPlaceholder(ar)
		an.PlaceholderText = tostring(ar)
	end
	function aq:Focus()
		an:CaptureFocus()
	end

	return registerElement(self, ab, aq, ac, "Input")
end

function K:Keybind(aa)
	local ab, ac, ad, ae, af, ah = createRowElement(self, aa, {
		Title = "Name",
		Description = "Desc",
		CurrentKeybind = "Default",
		Value = "Default",
	}, "Frame", 110, "Keybind")

	local ai = self.Window
	ab.Default = toKeyCode(ab.Default)
	local aj = ab.Mode == "Hold"
	local ak = ab.Mode == "Toggle"

	local al = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(44, i.CHIP_HEIGHT),
		BackgroundColor3 = u.Surface,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		ClipsDescendants = true,
		Parent = ac,
	})
	addCorner(al, UDim.new(0, 6))
	local am = addStroke(al)

	local an = createLabel({
		Size = UDim2.new(1, 0, 1, 0),
		TextSize = 13,
		TextColor3 = u.Muted,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextTruncate = Enum.TextTruncate.None,
		Parent = al,
	})

	local ao = {
		Value = ab.Default,
		Listening = false,
		Held = false,
		State = ab.DefaultState == true,
	}

	local function fitChip(ap)
		local aq = math.max(an.TextBounds.X + 20, 36)
		setTitleReserve(af, ah, aq + 20)
		if ap then
			al.Size = UDim2.fromOffset(aq, i.CHIP_HEIGHT)
		else
			tween(al, { Size = UDim2.fromOffset(aq, i.CHIP_HEIGHT) }, 0.2)
		end
	end
	an:GetPropertyChangedSignal("TextBounds"):Connect(function()
		fitChip(false)
	end)

	local function render()
		an.Text = ao.Listening and "..." or keyDisplayName(ao.Value)
		tween(am, { Color = ao.Listening and u.StrokeHover or u.Stroke }, 0.15)
		tween(an, { TextColor3 = ao.Listening and u.Accent or u.Muted }, 0.15)
	end

	local function releaseHold()
		if ao.Held then
			ao.Held = false
			safeCall(ab.Callback, false)
		end
	end

	function ao:Set(ap, aq)
		local ar = ao.Listening
		releaseHold()
		ap = toKeyCode(ap)
		ao.Value = ap
		ao.Listening = false
		render()
		if not ar then
			flashStroke(ad)
		end
		if not aq then
			safeCall(ab.OnChanged, ap)
		end
	end

	function ao:Get()
		return ao.Value
	end

	function ao:GetState()
		if aj then
			return ao.Held
		end
		return ao.State
	end

	function ao:SetState(ap, aq)
		ao.State = ap == true
		if not aq then
			safeCall(ab.Callback, ao.State)
		end
	end

	al.MouseButton1Click:Connect(function()
		ao.Listening = not ao.Listening
		render()
	end)

	ai:_listen("Began", function(ap, aq)
		if ap.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end

		if ao.Listening then
			if b:GetFocusedTextBox() then
				ao.Listening = false
				render()
				return
			end

			ai._consumedKey = ap.KeyCode
			ai._consumedAt = os.clock()
			if ap.KeyCode == Enum.KeyCode.Escape then
				ao.Listening = false
				render()
			elseif ap.KeyCode == Enum.KeyCode.Backspace or ap.KeyCode == Enum.KeyCode.Delete then
				ao:Set(nil)
			else
				ao:Set(ap.KeyCode)
			end
			return
		end

		if aq or ao.Locked or ao.Value == nil or ap.KeyCode ~= ao.Value then
			return
		end

		if aj then
			ao.Held = true
			safeCall(ab.Callback, true)
		elseif ak then
			ao:SetState(not ao.State)
		else
			safeCall(ab.Callback, ap.KeyCode)
		end
	end, ao)

	ai:_registerKeybind({
		Name = ab.Name or "Keybind",
		Element = ao,
		GetKey = function()
			return ao.Value
		end,
		GetActive = function()
			if aj then
				return ao.Held
			elseif ak then
				return ao.State
			end
			return nil
		end,
	})

	if aj then
		ai:_listen("Ended", function(ap)
			if ap.KeyCode == ao.Value then
				releaseHold()
			end
		end, ao)
	end

	render()
	task.defer(fitChip, true)

	return registerElement(self, ab, ao, ac, "Keybind", "OnChanged")
end

local function colorToHex(aa)
	return string.format("#%02X%02X%02X",
		math.floor(aa.R * 255 + 0.5),
		math.floor(aa.G * 255 + 0.5),
		math.floor(aa.B * 255 + 0.5))
end

local function parseColor(aa)
	if type(aa) == "string" then
		local ab, ac = pcall(Color3.fromHex, aa)
		return ab and ac or nil
	end
	if typeof(aa) == "Color3" then
		return aa
	end
	return nil
end

local function exemptFromTheme(aa)
	aa:SetAttribute(i.ATTR_NO_THEME, true)
	return aa
end

function K:ColorPicker(aa)
	local ab, ac, ad, ae = createRowElement(self, aa, {
		Title = "Name",
		Description = "Desc",
		Color = "Default",
		CurrentValue = "Default",
		Value = "Default",
	}, "Frame")
	ac.ClipsDescendants = true

	local af = create("TextButton", {
		Size = UDim2.new(1, 0, 0, ae),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = ac,
	})
	createTitleBlock(af, ab.Name or "Color", ab.Desc, 90)

	local ah = exemptFromTheme(create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -34, 0.5, 0),
		Size = UDim2.fromOffset(36, 20),
		BorderSizePixel = 0,
		Parent = af,
	}))
	addCorner(ah, UDim.new(0, 6))
	addStroke(ah, u.Stroke)

	local ai = createChevron(af, 1, -12)

	local aj = create("Frame", {
		Position = UDim2.fromOffset(14, ae + 2),
		Size = UDim2.new(1, -28, 0, 156),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = ac,
	})

	local ak = exemptFromTheme(create("TextButton", {
		Size = UDim2.new(1, -30, 0, 110),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		ClipsDescendants = true,
		Parent = aj,
	}))
	addCorner(ak, UDim.new(0, 6))
	local al = create("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.new(1, 0, 0)),
		Parent = ak,
	})

	local am = exemptFromTheme(create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Parent = ak,
	}))
	create("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(1, 0),
		}),
		Rotation = 90,
		Parent = am,
	})

	local an = exemptFromTheme(create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(10, 10),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = ak,
	}))
	addCorner(an, UDim.new(1, 0))
	addStroke(an, Color3.new(1, 1, 1), 0, 2)

	local ao = exemptFromTheme(create("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(14, 110),
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		Parent = aj,
	}))
	addCorner(ao, UDim.new(0, 6))
	create("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
			ColorSequenceKeypoint.new(1 / 6, Color3.fromRGB(255, 255, 0)),
			ColorSequenceKeypoint.new(2 / 6, Color3.fromRGB(0, 255, 0)),
			ColorSequenceKeypoint.new(3 / 6, Color3.fromRGB(0, 255, 255)),
			ColorSequenceKeypoint.new(4 / 6, Color3.fromRGB(0, 0, 255)),
			ColorSequenceKeypoint.new(5 / 6, Color3.fromRGB(255, 0, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
		}),
		Rotation = 90,
		Parent = ao,
	})

	local ap = exemptFromTheme(create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.fromOffset(18, 5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = ao,
	}))
	addCorner(ap, UDim.new(1, 0))
	addStroke(ap, u.AccentDark, 0.4)

	local aq = create("Frame", {
		Position = UDim2.fromOffset(6, 122),
		Size = UDim2.fromOffset(118, 28),
		BackgroundColor3 = u.Surface,
		BorderSizePixel = 0,
		Parent = aj,
	})
	addCorner(aq, UDim.new(0, 6))
	local ar = addStroke(aq)

	local as = create("TextBox", {
		Position = UDim2.fromOffset(14, 0),
		Size = UDim2.new(1, -24, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		TextTruncate = Enum.TextTruncate.None,
		ClipsDescendants = false,
		TextColor3 = u.Text,
		TextSize = 13,
		FontFace = w.Regular,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		Parent = aq,
	})

	local at = createLabel({
		Position = UDim2.fromOffset(134, 122),
		Size = UDim2.new(1, -134, 0, 28),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextSize = 13,
		FontFace = w.Regular,
		TextColor3 = u.Muted,
		Parent = aj,
	})

	local au = { Open = false }

	local av = parseColor(ab.Default) or u.Accent
	local aw, L, M = Color3.toHSV(av)
	local N

	local function render(O)
		local P = Color3.fromHSV(aw, L, M)
		au.Value = P
		ah.BackgroundColor3 = P
		al.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromHSV(aw, 1, 1))
		tween(an, { Position = UDim2.fromScale(L, 1 - M) }, O, Enum.EasingStyle.Linear)
		tween(ap, { Position = UDim2.new(0.5, 0, aw, 0) }, O, Enum.EasingStyle.Linear)
		if not as:IsFocused() then
			as.Text = colorToHex(P)
		end
		at.Text = string.format("RGB %d, %d, %d",
			math.floor(P.R * 255 + 0.5),
			math.floor(P.G * 255 + 0.5),
			math.floor(P.B * 255 + 0.5))
	end

	local function update(O, P)
		render(O)
		if not P then
			safeCall(ab.Callback, au.Value)
		end
	end

	function au:Set(O, P)
		local Q = parseColor(O)
		if not Q then
			log("ColorPicker:Set expects a Color3 or hex string")
			return
		end
		aw, L, M = Color3.toHSV(Q)
		update(0.25, P)
		flashStroke(ad)
	end

	function au:Get()
		return au.Value
	end

	local function setOpen(O)
		au.Open = O
		tween(ac, { Size = UDim2.new(1, 0, 0, O and ae + 168 or ae) }, 0.35, Enum.EasingStyle.Quint)
		ai:Set(O)
		if O then
			aj.Visible = true
		else
			N = nil
			task.delay(0.35, function()
				if not au.Open then
					aj.Visible = false
				end
			end)
		end
	end

	function au:SetOpen(O)
		setOpen(O == true)
	end

	af.MouseButton1Click:Connect(function()
		setOpen(not au.Open)
	end)

	local function pickSV(O)
		L = math.clamp((O.X - ak.AbsolutePosition.X) / ak.AbsoluteSize.X, 0, 1)
		M = 1 - math.clamp((O.Y - ak.AbsolutePosition.Y) / ak.AbsoluteSize.Y, 0, 1)
		update(0.04)
	end

	local function pickHue(O)
		aw = math.clamp((O.Y - ao.AbsolutePosition.Y) / ao.AbsoluteSize.Y, 0, 0.999)
		update(0.04)
	end

	ak.InputBegan:Connect(function(O)
		if isPress(O) then
			N = "sv"
			tween(an, { Size = UDim2.fromOffset(14, 14) }, 0.15, Enum.EasingStyle.Back)
			pickSV(getMousePosition())
		end
	end)

	ao.InputBegan:Connect(function(O)
		if isPress(O) then
			N = "hue"
			tween(ap, { Size = UDim2.fromOffset(20, 7) }, 0.15, Enum.EasingStyle.Back)
			pickHue(getMousePosition())
		end
	end)

	local O = self.Window
	O:_listen("Changed", function(P)
		if not N or not isMove(P) then
			return
		end
		local Q = getMousePosition()
		if N == "sv" then
			pickSV(Q)
		else
			pickHue(Q)
		end
	end, au)

	O:_listen("Ended", function(P)
		if N and isPress(P) then
			N = nil
			tween(an, { Size = UDim2.fromOffset(10, 10) }, 0.2)
			tween(ap, { Size = UDim2.fromOffset(18, 5) }, 0.2)
		end
	end, au)

	as.Focused:Connect(function()
		tween(ar, { Color = u.StrokeHover }, 0.15)
	end)
	as.FocusLost:Connect(function()
		tween(ar, { Color = u.Stroke }, 0.15)
		local P, Q, R = as.Text:match("^%s*#?(%x%x)(%x%x)(%x%x)%s*$")
		if P then
			au:Set(Color3.fromRGB(tonumber(P, 16), tonumber(Q, 16), tonumber(R, 16)))
		else
			as.Text = colorToHex(au.Value)
		end
	end)

	render(0)

	return registerElement(self, ab, au, ac, "ColorPicker")
end

i.HOLD_DELAY = 0.4
i.HOLD_REPEAT = 0.07

function K:Stepper(aa)
	local ab, ac, ad, ae, af, ah = createRowElement(self, aa, {
		Title = "Name",
		Description = "Desc",
		CurrentValue = "Default",
		Value = "Default",
		Increment = "Step",
	}, "Frame", 150, "Stepper")

	local ai = self.Window
	local aj = math.min(tonumber(ab.Min) or 0, tonumber(ab.Max) or 100)
	local ak = math.max(tonumber(ab.Min) or 0, tonumber(ab.Max) or 100)
	local al = tonumber(ab.Step) or 1
	local am = ab.Suffix or ""
	local an = createStepper(aj, ak, al)

	local ao = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(0, i.CHIP_HEIGHT),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = u.Surface,
		BorderSizePixel = 0,
		Parent = ac,
	})
	addCorner(ao, UDim.new(0, 6))
	local ap = addStroke(ao)
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Parent = ao,
	})

	local function createStepButton(aq, ar)
		local as = create("TextButton", {
			Size = UDim2.fromOffset(i.CHIP_HEIGHT, i.CHIP_HEIGHT),
			BackgroundTransparency = 1,
			Text = aq,
			TextColor3 = u.Muted,
			TextSize = 18,
			FontFace = w.Medium,
			AutoButtonColor = false,
			LayoutOrder = ar,
			Parent = ao,
		})
		as.MouseEnter:Connect(function()
			if x then
				return
			end
			tween(as, { TextColor3 = u.Accent }, 0.12)
		end)
		as.MouseLeave:Connect(function()
			tween(as, { TextColor3 = u.Muted }, 0.2)
		end)
		return as
	end

	local aq = createStepButton("−", 1)
	local ar = createLabel({
		Size = UDim2.new(0, 30, 1, 0),
		TextSize = 13,
		TextColor3 = u.Accent,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextTruncate = Enum.TextTruncate.None,
		LayoutOrder = 2,
		Parent = ao,
	})
	local as = createStepButton("+", 3)

	local function fitValue(at)
		local au = math.max(ar.TextBounds.X + 12, 30)
		if at then
			ar.Size = UDim2.new(0, au, 1, 0)
		else
			tween(ar, { Size = UDim2.new(0, au, 1, 0) }, 0.2)
		end
	end
	ar:GetPropertyChangedSignal("TextBounds"):Connect(function()
		fitValue(false)
	end)
	ao:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		setTitleReserve(af, ah, ao.AbsoluteSize.X / ai.Scale.Scale + 20)
	end)

	local at = {
		Value = math.clamp(tonumber(ab.Default) or aj, aj, ak),
	}
	local au = false

	local function render()
		ar.Text = an.format(at.Value) .. am
		tween(aq, { TextTransparency = at.Value <= aj and 0.6 or 0 }, 0.15)
		tween(as, { TextTransparency = at.Value >= ak and 0.6 or 0 }, 0.15)
	end

	function at:Set(av, aw)
		av = an.snap(tonumber(av) or aj)
		if av == at.Value then
			return
		end
		at.Value = av
		render()
		if not au then
			flashStroke(ad)
		end
		if not aw then
			safeCall(ab.Callback, av)
		end
	end

	function at:Get()
		return at.Value
	end

	local function nudge(av)
		au = true
		at:Set(at.Value + av * al)
		au = false
		tween(ap, { Color = u.StrokeHover }, 0.08)
		task.delay(0.12, function()
			tween(ap, { Color = u.Stroke }, 0.2)
		end)
	end

	local function bindRepeat(av, aw)
		local L, M = 0, false
		av.InputBegan:Connect(function(N)
			if not isPress(N) then
				return
			end
			L += 1
			local O = L
			M = true
			nudge(aw)
			task.delay(i.HOLD_DELAY, function()
				while M and L == O and not at.Locked and not at._destroyed and av.Parent do
					nudge(aw)
					task.wait(i.HOLD_REPEAT)
				end
			end)
		end)
		av.InputEnded:Connect(function(N)
			if isPress(N) then
				M = false
			end
		end)
		av.MouseLeave:Connect(function()
			M = false
		end)
	end

	bindRepeat(aq, -1)
	bindRepeat(as, 1)

	at.Value = an.snap(at.Value)
	render()
	task.defer(fitValue, true)

	return registerElement(self, ab, at, ac, "Stepper")
end

function K:Progress(aa)
	local ab = normalizeOptions(aa, {
		Title = "Name",
		Description = "Desc",
		CurrentValue = "Default",
		Value = "Default",
	})

	local ac, ad = createCard(self, "Frame", ab.Desc and i.ROW_HEIGHT_DESC + 10 or i.ROW_HEIGHT + 10)
	bindHoverStroke(ac, ad)

	local ae = ab.Desc and (i.ROW_HEIGHT_DESC - 38) / 2 - 2 or 12
	createLabel({
		Name = "Title",
		Position = UDim2.fromOffset(14, ae),
		Size = UDim2.new(1, -110, 0, 18),
		Text = ab.Name or "Progress",
		Parent = ac,
	})
	if ab.Desc then
		createLabel({
			Name = "Desc",
			Position = UDim2.fromOffset(14, ae + 20),
			Size = UDim2.new(1, -110, 0, 17),
			Text = ab.Desc,
			TextSize = 13,
			FontFace = w.Regular,
			TextColor3 = u.Muted,
			Parent = ac,
		})
	end

	local af = createLabel({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, ae),
		Size = UDim2.fromOffset(90, 18),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextSize = 13,
		TextColor3 = u.Accent,
		Parent = ac,
	})

	local ah = create("Frame", {
		Position = UDim2.new(0, 14, 1, -16),
		Size = UDim2.new(1, -28, 0, 5),
		BackgroundColor3 = u.Surface3,
		BorderSizePixel = 0,
		Parent = ac,
	})
	addCorner(ah, UDim.new(1, 0))

	local ai = create("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = ab.Color or u.Accent,
		BorderSizePixel = 0,
		Parent = ah,
	})
	addCorner(ai, UDim.new(1, 0))

	local aj = {
		Value = math.clamp(tonumber(ab.Default) or 0, 0, 1),
	}
	local ak = ab.Format

	local function render(al)
		local am = aj.Value
		tween(ai, { Size = UDim2.new(am, 0, 1, 0) }, al, Enum.EasingStyle.Quint)
		if type(ak) == "function" then
			local an, ao = pcall(ak, am)
			af.Text = an and tostring(ao) or ""
		else
			af.Text = string.format("%d%%", math.floor(am * 100 + 0.5))
		end
	end

	function aj:Set(al, am)
		al = math.clamp(tonumber(al) or 0, 0, 1)
		if al == aj.Value then
			return
		end
		aj.Value = al
		render(0.35)
		if not am then
			safeCall(ab.Callback, al)
		end
	end

	function aj:Get()
		return aj.Value
	end

	function aj:SetColor(al)
		ai.BackgroundColor3 = al
	end

	render(0)

	return registerElement(self, ab, aj, ac, "Progress")
end

function K:Group(aa)
	local ab = normalizeOptions(aa, { Title = "Name", Description = "Desc" })
	local ac = self.Window
	local ad = ab.Desc and i.ROW_HEIGHT_DESC or i.ROW_HEIGHT
	local ae = not (ab.Collapsed == true or ab.Opened == false)

	local af, ah = createCard(self, "Frame", ad)
	af.BackgroundColor3 = u.Surface
	af.ClipsDescendants = true

	local ai = create("TextButton", {
		Size = UDim2.new(1, 0, 0, ad),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = af,
	})
	bindHoverStroke(ai, ah)

	local aj = 0
	if ab.Icon then
		createIcon(ai, ab.Icon, u.Accent, UDim2.new(0, 14, 0.5, 0))
		aj = 26
	end
	local ak, al = createTitleBlock(ai, ab.Name or "Group", ab.Desc, 40)
	for am, an in ipairs({ ak, al }) do
		an.Position += UDim2.fromOffset(aj, 0)
		an.Size -= UDim2.fromOffset(aj, 0)
	end
	local am = createChevron(ai, 1, -14)

	local an = create("Frame", {
		Position = UDim2.fromOffset(10, ad),
		Size = UDim2.new(1, -20, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = af,
	})
	local ao = create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		Parent = an,
	})

	local ap = setmetatable({
		Name = ab.Name or "Group",
		Window = ac,
		List = an,
		Open = ae,
		_order = 0,
		_rootTab = self._rootTab or self,
		_parentGroup = self._groupElement,
	}, K)
	ap._groupElement = ap

	local function targetHeight()
		if not ap.Open then
			return ad
		end
		local aq = ao.AbsoluteContentSize.Y / ac.Scale.Scale
		return ad + (aq > 0 and aq + 10 or 0)
	end

	local aq = false
	local function fit(ar)
		if ar then
			aq = true
			tween(af, { Size = UDim2.new(1, 0, 0, targetHeight()) }, 0.3, Enum.EasingStyle.Quint)
			task.delay(0.3, function()
				aq = false
				af.Size = UDim2.new(1, 0, 0, targetHeight())
			end)
		elseif not aq then
			af.Size = UDim2.new(1, 0, 0, targetHeight())
		end
	end

	ao:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		fit(false)
	end)

	function ap:SetOpen(ar)
		ap.Open = ar == true
		am:Set(ap.Open)
		fit(true)
	end

	function ap:ToggleOpen()
		ap:SetOpen(not ap.Open)
	end

	function ap:SetTitle(ar)
		ap.Name = tostring(ar)
		ak.Text = ap.Name
	end

	function ap:Select()
		ac:SelectTab(ap._rootTab)
		if not ap.Open then
			ap:SetOpen(true)
		end
	end

	ai.MouseButton1Click:Connect(function()
		ap:SetOpen(not ap.Open)
	end)

	am:Set(ap.Open)
	task.defer(fit, false)

	return registerElement(self, ab, ap, af, "Group")
end

function K:ConfigManager(aa)
	local ab = normalizeOptions(aa, {})
	local ac = self.Window
	local ad = {}

	self:Section(ab.Name or "Configs")

	local ae = self:Input({
		Name = "Config name",
		Placeholder = ac.ConfigName,
		Callback = function(ae, af)
			if af and #ae > 0 then
				ad:Save(ae)
			end
		end,
	})

	local af = self:Dropdown({
		Name = "Saved configs",
		Options = ac:ListConfigs(),
		Default = ac.ConfigName,
		Callback = function(af)
			if af then
				ae:Set(af, true)
			end
		end,
	})

	function ad:Refresh()
		af:Refresh(ac:ListConfigs(), true)
	end

	function ad:Save(ah)
		ah = ah or af:Get() or ac.ConfigName
		local ai, aj = ac:SaveConfig(ah)
		ad:Refresh()
		if ai then
			af:Set(ac.ConfigName, true)
		end
		ac:Notify({
			Title = ai and "Config saved" or "Save failed",
			Content = ai and ac.ConfigName or tostring(aj),
			Type = ai and "Success" or "Error",
			Duration = 3,
		})
	end

	function ad:Load(ah)
		ah = ah or af:Get()
		if not ah then
			return
		end
		local ai, aj = ac:LoadConfig(ah)
		ac:Notify({
			Title = ai and "Config loaded" or "Load failed",
			Content = ai and ah or tostring(aj),
			Type = ai and "Success" or "Error",
			Duration = 3,
		})
	end

	function ad:Delete(ah)
		ah = ah or af:Get()
		if not ah then
			return
		end
		local ai, aj = ac:DeleteConfig(ah)
		ad:Refresh()
		ac:Notify({
			Title = ai and "Config deleted" or "Delete failed",
			Content = ai and ah or tostring(aj),
			Type = ai and "Info" or "Error",
			Duration = 3,
		})
	end

	self:Button({
		Name = "Save",
		Desc = "Writes every flagged element to the selected name",
		Icon = "save",
		Style = "Primary",
		Callback = function()
			local ah = ae:Get()
			ad:Save(#ah > 0 and ah or nil)
		end,
	})

	self:Button({
		Name = "Load",
		Icon = "folder-open",
		Callback = function()
			ad:Load()
		end,
	})

	self:Button({
		Name = "Delete",
		Icon = "trash-2",
		Callback = function()
			local ah = af:Get()
			if not ah then
				return
			end
			ac:Confirm({
				Title = "Delete config",
				Content = "Remove " .. ah .. "? This cannot be undone.",
				Icon = "trash-2",
				ConfirmText = "Delete",
				Callback = function()
					ad:Delete(ah)
				end,
			})
		end,
	})

	self:Button({
		Name = "Export to clipboard",
		Desc = "Copy every setting as text to share or back up",
		Icon = "copy",
		Callback = function()
			local ah = ac:ExportConfig()
			if ah then
				h:Copy(ah)
			end
		end,
	})

	local ah = ""
	self:Input({
		Name = "Import config",
		Placeholder = "Paste config text",
		Callback = function(ai)
			ah = ai
		end,
	})

	self:Button({
		Name = "Apply imported config",
		Icon = "download",
		Callback = function()
			local ai, aj = ac:ImportConfig(ah)
			ac:Notify({
				Title = ai and "Config imported" or "Import failed",
				Content = ai and ("Applied " .. aj .. " settings.") or tostring(aj),
				Type = ai and "Success" or "Error",
				Duration = 3,
			})
		end,
	})

	self:Button({
		Name = "Reset to defaults",
		Icon = "rotate-ccw",
		Style = "Danger",
		Callback = function()
			ac:Confirm({
				Title = "Reset settings",
				Content = "Put every setting back to its default value?",
				Icon = "rotate-ccw",
				ConfirmText = "Reset",
				Callback = function()
					local ai = ac:ResetConfig()
					ac:Notify({ Title = "Settings reset", Content = ai .. " settings back to default.", Type = "Info", Duration = 3 })
				end,
			})
		end,
	})

	self:Toggle({
		Name = "Auto save",
		Desc = "Save whenever a flagged element changes",
		Default = ac._autoSaveEnabled,
		Callback = function(ai)
			ac:SetAutoSave(ai)
		end,
	})

	return ad
end

function K:ThemePicker(aa)
	local ab = normalizeOptions(aa, { Title = "Name", Description = "Desc" })
	local ac = ab.Callback
	return self:Dropdown({
		Name = ab.Name or "Theme",
		Desc = ab.Desc,
		Options = h:GetThemes(),
		Default = h.ThemeName,
		Flag = ab.Flag,
		Callback = function(ad)
			if ad then
				h:SetTheme(ad)
			end
			safeCall(ac, ad)
		end,
	})
end

i.KEY_TYPE_NAMES = {
	lifetime = "Lifetime",
	["1month"] = "Monthly",
	monthly = "Monthly",
	weekly = "Weekly",
	default = "Standard",
	free = "Free",
}

i.KEY_DETAIL_LABELS = {
	Usage = "Usage",
	Discord = "Discord",
	HWID = "HWID",
}

local function readGlobal(aa)
	local ab, ac = pcall(function()
		local ab = (type(getgenv) == "function" and getgenv()) or _G
		return ab[aa]
	end)
	if ab then
		return ac
	end
	return nil
end

local function rawKeyData()
	local aa = h._keySource
	if type(aa) == "function" then
		local ab, ac = pcall(aa)
		if ab and type(ac) == "table" then
			return ac
		end
		if not h._keySourceWarned then
			h._keySourceWarned = true
			if ab then
				log("the Membership Data function should return a table, like { Type = \"lifetime\" }")
			else
				log("the Membership Data function failed: " .. tostring(ac))
			end
		end
		return {}
	end
	return {
		Type = readGlobal("NEOX_KEY_TYPE"),
		Expiry = readGlobal("NEOX_KEY_EXPIRY"),
		Lifetime = readGlobal("NEOX_KEY_IS_LIFETIME"),
		Usage = readGlobal("NEOX_KEY_USAGE_COUNT"),
		Discord = readGlobal("NEOX_KEY_DISCORD"),
		HWID = readGlobal("NEOX_ACTIVE_HWID"),
	}
end

local function readKeyData()
	local aa = rawKeyData()
	local ab = aa.Type
	if ab ~= nil then
		ab = tostring(ab)
	end
	local ac = tonumber(aa.Expiry)
	local ad = aa.Lifetime == true or ab == "lifetime"
	local ae = ab ~= nil or ac ~= nil or ad
	if type(aa.HasKey) == "boolean" then
		ae = aa.HasKey
	end
	local af = ad or ab == "1month" or ab == "monthly"
	if type(aa.Premium) == "boolean" then
		af = aa.Premium
	end
	return aa, {
		HasKey = ae,
		Premium = ae and af,
		Type = ab,
		Expiry = ac,
		Lifetime = ad,
	}
end

local function getKeyStatus()
	local aa, ab = readKeyData()
	return {
		HasKey = ab.HasKey,
		Premium = ab.Premium,
		Type = ab.Type,
		Expiry = ab.Expiry,
	}
end
h._getKeyStatus = getKeyStatus

function h:SetKeySource(aa)
	if aa ~= nil and type(aa) ~= "function" then
		log("SetKeySource needs a function that returns your key data, or nil to use the built-in key system")
		return false
	end
	h._keySource = aa
	h._keySourceWarned = false
	for ab, ac in ipairs(h.Windows) do
		if ac.KeyPanel and ac.KeyPanel.Refresh then
			safeCall(ac.KeyPanel.Refresh, ac.KeyPanel)
		end
	end
	return true
end

local function formatDuration(aa)
	aa = math.max(0, math.floor(aa))
	if aa < 60 then
		return aa .. "s"
	elseif aa < 3600 then
		return string.format("%dm %02ds", aa // 60, aa % 60)
	elseif aa < 86400 then
		return string.format("%dh %02dm", aa // 3600, (aa % 3600) // 60)
	end
	return string.format("%dd %dh", aa // 86400, (aa % 86400) // 3600)
end

local function createKeyPanel(aa, ab, ac, ad)
	local ae = normalizeOptions(ad, { Title = "Name" })
	if type(ae.Data) == "function" then
		h._keySource = ae.Data
		h._keySourceWarned = false
	elseif ae.Data ~= nil then
		log("Membership Data should be a function that returns your key data")
	end
	local af = type(ae.Texts) == "table" and ae.Texts or {}
	local function text(ah, ai)
		local aj = af[ah]
		if aj == nil then
			return ai
		end
		return tostring(aj)
	end
	local ah = type(ae.Labels) == "table" and ae.Labels or {}

	local function snapshot()
		local ai, aj = readKeyData()
		local ak = ae.TypeNames or i.KEY_TYPE_NAMES
		local al
		if aj.HasKey then
			al = aj.Type ~= nil and (ak[aj.Type] or aj.Type) or text("Active", "Active")
		else
			al = text("NoKeyBadge", "No key")
		end
		local am = {
			HasKey = aj.HasKey,
			TypeName = tostring(al),
			Lifetime = aj.Lifetime,
			Premium = aj.Premium,
			Expiry = aj.Expiry,
		}
		for an, ao in pairs(ai) do
			if am[an] == nil then
				am[an] = ao
			end
		end
		return am
	end

	local ai = create("Frame", {
		Name = "KeyPanel",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = u.Surface2,
		BorderSizePixel = 0,
		LayoutOrder = ac,
		Parent = ab,
	})
	ai:SetAttribute(i.ATTR_NO_DRAG, true)
	styleCard(ai)
	addPadding(ai, 14, 14, 12, 12)
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		Parent = ai,
	})

	local aj = create("Frame", {
		Size = UDim2.new(1, 0, 0, 20),
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = ai,
	})
	createIcon(aj, ae.Icon or "key-round", u.Accent, UDim2.new(0, 0, 0.5, 0))
	createLabel({
		Name = "Title",
		Position = UDim2.fromOffset(24, 0),
		Size = UDim2.new(1, -130, 1, 0),
		Text = ae.Name or "Membership",
		TextSize = 14,
		Parent = aj,
	})

	local ak = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(0, 20),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = u.Accent,
		BackgroundTransparency = 0.85,
		BorderSizePixel = 0,
		Visible = ae.Badge ~= false,
		Parent = aj,
	})
	addCorner(ak, UDim.new(1, 0))
	local al = addStroke(ak, u.Accent, 0.5)
	addPadding(ak, 9, 9)
	local am = createLabel({
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = "",
		TextSize = 11,
		FontFace = w.Bold,
		TextColor3 = u.Accent,
		TextTruncate = Enum.TextTruncate.None,
		Parent = ak,
	})

	local an = create("Frame", {
		Size = UDim2.new(1, 0, 0, 38),
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Parent = ai,
	})
	local ao = createLabel({
		Size = UDim2.new(0.55, 0, 0, 24),
		Text = "...",
		TextSize = 20,
		FontFace = w.Bold,
		Parent = an,
	})
	createLabel({
		Position = UDim2.fromOffset(0, 24),
		Size = UDim2.new(0.55, 0, 0, 14),
		Text = text("TimeLeft", "Time left"),
		TextSize = 12,
		FontFace = w.Regular,
		TextColor3 = u.Muted,
		Parent = an,
	})
	local ap = createLabel({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 4),
		Size = UDim2.new(0.45, 0, 0, 16),
		Text = "",
		TextSize = 12,
		FontFace = w.Regular,
		TextColor3 = u.Muted,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = an,
	})

	local aq = tonumber(ae.TotalTime)
	local ar
	if aq and aq > 0 then
		local as = create("Frame", {
			Size = UDim2.new(1, 0, 0, 4),
			BackgroundColor3 = u.Surface3,
			BorderSizePixel = 0,
			LayoutOrder = 3,
			Parent = ai,
		})
		addCorner(as, UDim.new(1, 0))
		ar = create("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = u.Accent,
			BorderSizePixel = 0,
			Parent = as,
		})
		addCorner(ar, UDim.new(1, 0))
	end

	local as = ae.Details or { "Usage", "Discord", "HWID" }
	local at = {}
	if #as > 0 then
		local au = create("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = 4,
			Parent = ai,
		})
		create("UIGridLayout", {
			CellSize = UDim2.new(1 / math.min(#as, 3), -6, 0, 40),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = au,
		})
		for av, aw in ipairs(as) do
			local L = create("Frame", {
				BackgroundColor3 = u.Surface,
				BorderSizePixel = 0,
				LayoutOrder = av,
				Parent = au,
			})
			addCorner(L, UDim.new(0, 6))
			createLabel({
				Position = UDim2.fromOffset(10, 5),
				Size = UDim2.new(1, -20, 0, 13),
				Text = tostring(ah[aw] or i.KEY_DETAIL_LABELS[aw] or aw),
				TextSize = 11,
				FontFace = w.Regular,
				TextColor3 = u.Muted,
				Parent = L,
			})
			at[aw] = createLabel({
				Position = UDim2.fromOffset(10, 19),
				Size = UDim2.new(1, -20, 0, 16),
				Text = "-",
				TextSize = 13,
				Parent = L,
			})
		end
	end

	local au = createLabel({
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Text = ae.PremiumText or "You're on a free key. Premium means no key resets and no waiting.",
		TextSize = 12,
		FontFace = w.Regular,
		TextColor3 = u.Muted,
		TextWrapped = true,
		TextTruncate = Enum.TextTruncate.None,
		Visible = false,
		LayoutOrder = 5,
		Parent = ai,
	})

	local av = x and 32 or 30
	local aw = create("Frame", {
		Size = UDim2.new(1, 0, 0, av),
		BackgroundTransparency = 1,
		Visible = false,
		LayoutOrder = 6,
		Parent = ai,
	})
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, i.PANEL_BUTTON_GAP),
		Parent = aw,
	})
	local L = {}

	local function layoutRow()
		local M = {}
		for N, O in ipairs(L) do
			if O.Button.Visible then
				table.insert(M, O)
			end
		end
		local N = #M
		local O = N > 0 and N <= 3
		for P, Q in ipairs(M) do
			if O then
				Q.Button.AutomaticSize = Enum.AutomaticSize.None
				Q.Button.Size = UDim2.new(1 / N, -math.ceil(i.PANEL_BUTTON_GAP * (N - 1) / N), 0, av)
			else
				Q.Button.AutomaticSize = Enum.AutomaticSize.X
				Q.Button.Size = UDim2.fromOffset(0, av)
			end
			Q.Layout.HorizontalAlignment = O and Enum.HorizontalAlignment.Center or Enum.HorizontalAlignment.Left
		end
	end

	local function addPanelButton(M, N, O, P, Q)
		local R = P == "Primary"
		local S = P == "Premium"
		local T = R and u.Accent or (S and i.PREMIUM_GOLD or u.Stroke)
		local U = S and 0.55 or 0
		local V = create("TextButton", {
			Size = UDim2.fromOffset(0, av),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = R and u.Accent or u.Surface,
			BackgroundTransparency = R and 0.1 or 0,
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = M,
			Parent = aw,
		})
		addCorner(V, UDim.new(0, 7))
		local W = addStroke(V, T, U)
		addPadding(V, 10, 10)
		local X = create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 7),
			Parent = V,
		})
		if O then
			local Y = create("ImageLabel", {
				Size = UDim2.fromOffset(15, 15),
				BackgroundTransparency = 1,
				ImageColor3 = R and u.AccentDark or (S and i.PREMIUM_GOLD or u.Accent),
				ScaleType = Enum.ScaleType.Fit,
				LayoutOrder = 1,
				Parent = V,
			})
			if not setIcon(Y, O) then
				Y:Destroy()
			end
		end
		createLabel({
			Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X,
			Text = N,
			TextSize = 12,
			TextColor3 = R and u.AccentDark or u.Text,
			TextTruncate = Enum.TextTruncate.None,
			LayoutOrder = 2,
			Parent = V,
		})
		V.MouseEnter:Connect(function()
			if x then
				return
			end
			if R then
				tween(V, { BackgroundTransparency = 0 }, 0.12)
			elseif S then
				tween(W, { Transparency = 0.15 }, 0.12)
				tween(V, { BackgroundColor3 = u.Surface2 }, 0.12)
			else
				tween(W, { Color = u.StrokeHover }, 0.12)
				tween(V, { BackgroundColor3 = u.Surface2 }, 0.12)
			end
		end)
		V.MouseLeave:Connect(function()
			if R then
				tween(V, { BackgroundTransparency = 0.1 }, 0.2)
			else
				tween(W, { Color = T, Transparency = U }, 0.2)
				tween(V, { BackgroundColor3 = u.Surface }, 0.2)
			end
		end)
		V.MouseButton1Click:Connect(function()
			safeCall(Q)
		end)
		table.insert(L, { Button = V, Layout = X })
		return V
	end

	local M
	if ae.PremiumLink then
		M = addPanelButton(1, ae.PremiumButton or "Get Premium", "crown", "Premium", function()
			h:Copy(ae.PremiumLink)
		end)
	end
	local N = 0
	if ae.DiscordLink then
		N += 1
		addPanelButton(2, ae.DiscordButton or "Discord", "discord", nil, function()
			h:Copy(ae.DiscordLink)
		end)
	end
	for O, P in ipairs(ae.Buttons or {}) do
		N += 1
		local Q = (P.Primary == true or P.Variant == "Primary" or P.Style == "Primary") and "Primary" or nil
		addPanelButton(2 + O, P.Title or P.Name or "Button", P.Icon, Q, P.Callback)
	end
	layoutRow()

	local O = { Frame = ai }
	aa._keyWarned = aa._keyWarned or {}
	local P = aa._keyWarned
	local Q = {}

	local function setText(R, S, T)
		if Q[S] ~= T then
			Q[S] = T
			R.Text = T
		end
	end

	local function remind(R, S, T, U)
		if ae.Reminders == false or P[R] then
			return
		end
		P[R] = true
		local V = ae.PremiumLink or (aa._premium and aa._premium.Link)
		local W
		if V and not getKeyStatus().Premium then
			T = T .. text("PremiumHint", " Premium keys never run out.")
			W = {
				{ Title = "Later" },
				{ Title = "Get Premium", Primary = true, Callback = function()
					if aa._premium then
						aa:_premiumClicked("reminder")
					else
						h:Copy(V)
					end
				end },
			}
		end
		aa:Notify({ Title = S, Content = T, Type = U, Duration = W and 12 or 6, Buttons = W })
	end

	function O:Refresh()
		local R = snapshot()
		local S = (not R.HasKey and u.Muted) or (R.Premium and u.Accent) or u.Warning
		setText(am, "badge", string.upper(R.TypeName))
		ak.BackgroundColor3 = S
		al.Color = S
		am.TextColor3 = S

		local T
		if R.Lifetime then
			setText(ao, "time", text("NeverExpires", "Never expires"))
			setText(ap, "expires", text("Lifetime", "Lifetime key"))
		elseif R.Expiry then
			T = math.floor(R.Expiry - os.time())
			setText(ao, "time", T > 0 and formatDuration(T) or text("Expired", "Expired"))
			setText(ap, "expires", text("Ends", "Ends ") .. os.date(ae.DateFormat or "%b %d, %H:%M", R.Expiry))
		elseif R.HasKey then
			setText(ao, "time", text("Active", "Active"))
			setText(ap, "expires", "")
		else
			setText(ao, "time", text("NoKey", "No key loaded"))
			setText(ap, "expires", "")
		end
		ao.TextColor3 = (T and T <= 0) and u.Error or ((T and T <= 900) and u.Warning or u.Text)

		if ar then
			local U = R.Lifetime and 1 or (T and math.clamp(T / aq, 0, 1) or 0)
			ar.Size = UDim2.fromScale(U, 1)
			ar.BackgroundColor3 = U <= 0.15 and u.Warning or u.Accent
		end

		for U, V in pairs(at) do
			local W = R[U]
			local X
			if U == "HWID" then
				X = (type(W) == "string" and #W >= 4) and ("••••" .. string.sub(W, -4)) or text("Unknown", "Unknown")
			elseif U == "Discord" then
				X = (type(W) == "string" and W ~= "") and W or text("NotLinked", "Not linked")
			elseif W ~= nil and W ~= "" then
				X = tostring(W)
			else
				X = "-"
			end
			setText(V, "detail" .. U, X)
		end

		au.Visible = R.HasKey and not R.Premium and ae.ShowPromo ~= false
		if M and M.Visible ~= not R.Premium then
			M.Visible = not R.Premium
			layoutRow()
		end
		aw.Visible = (M ~= nil and not R.Premium) or N > 0

		if T and not R.Lifetime then
			if T <= 0 then
				remind("expired", text("ExpiredTitle", "Key expired"), text("ExpiredMessage", "Get a new key to keep using the script."), "Error")
			elseif T <= 900 then
				local U = tostring(math.max(1, math.floor(T / 60)))
				remind("15m", text("SoonTitle", "Key expiring soon"), (text("SoonMessage", "Your key ends in about {minutes} minutes."):gsub("{minutes}", U)), "Warning")
			elseif T <= 3600 then
				remind("60m", text("HourTitle", "Key expires in 1 hour"), text("HourMessage", "Your key has about an hour left."), "Warning")
			end
		end
	end

	O:Refresh()
	task.spawn(function()
		while ai.Parent and not aa._destroyed do
			task.wait(1)
			if ai.Parent then
				O:Refresh()
			end
		end
	end)

	return O, ai
end

function K:KeyInfo(aa)
	local ab = normalizeOptions(aa, { Title = "Name" })
	local ac, ad = createKeyPanel(self.Window, self.List, self:_nextOrder(), ab)
	return registerElement(self, { Name = ab.Name or "Membership" }, ac, ad, "KeyInfo")
end

function K:Select()
	self.Window:SelectTab(self)
end

function K:SetTitle(aa)
	self.Name = tostring(aa)
	self._label.Text = self.Name
	if self._pageTitle then
		self._pageTitle.Text = self.Name
	end
end

i.NO_CREATE_ALIAS = { Select = true, SetTitle = true }
for aa, ab in pairs(table.clone(K)) do
	if type(ab) == "function"
		and aa:sub(1, 1) ~= "_"
		and aa:sub(1, 6) ~= "Create"
		and not i.NO_CREATE_ALIAS[aa]
	then
		K["Create" .. aa] = ab
	end
end

local function getExecutorName()
	local aa
	pcall(function()
		if typeof(identifyexecutor) == "function" then
			aa = (identifyexecutor())
		elseif typeof(getexecutorname) == "function" then
			aa = getexecutorname()
		end
	end)
	if type(aa) == "string" and #aa > 0 then
		return aa
	end
	return d:IsStudio() and "Studio" or "Unknown"
end

local function getGameName()
	local aa, ab = pcall(function()
		return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
	end)
	if aa and type(ab) == "table" and ab.Name then
		return ab.Name
	end
	return "Unknown game"
end

i.COUNTRY_NAMES = {
	US = "United States",
	GB = "United Kingdom",
	DE = "Germany",
	FR = "France",
	NL = "Netherlands",
	SG = "Singapore",
	JP = "Japan",
	AU = "Australia",
	BR = "Brazil",
	IN = "India",
	HK = "Hong Kong",
	CA = "Canada",
}

local function fetchRegion(aa, ab)
	task.spawn(function()
		local ac = request
			or http_request
			or (syn and syn.request)
			or (http and http.request)
		local ad
		if type(ac) == "function" then
			pcall(function()
				local ae = ac({ Url = "https://ipinfo.io/json", Method = "GET" })
				local af = type(ae) == "table" and (ae.Body or ae.body) or nil
				if type(af) == "string" then
					local ah = e:JSONDecode(af)
					if type(ah) == "table" and ah.country then
						local ai = i.COUNTRY_NAMES[ah.country] or ah.country
						if ah.city and not ab then
							ad = ah.city .. ", " .. ai
						else
							ad = ai
						end
					end
				end
			end)
		end
		aa(ad or "Unavailable")
	end)
end

