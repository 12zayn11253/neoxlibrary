		TextSize = 13,
		TextTruncate = Enum.TextTruncate.None,
		ZIndex = 31,
		Parent = pill,
	})
	self.OpenButton = pill

	self:_makeDraggable(pill, function()
		self:Toggle()
	end)
	table.insert(self._overlays, pill)
end

function Window:_makeDraggable(target, onTap)
	local screenGui = self.Gui
	local pressing, moved = false, false
	local grabOffset, pressPoint = Vector2.zero, Vector2.zero

	target.InputBegan:Connect(function(inputObject)
		if isPress(inputObject) then
			pressing, moved = true, false
			pressPoint = getMousePosition()
			grabOffset = pressPoint - target.AbsolutePosition
		end
	end)

	table.insert(self._connections, UserInputService.InputChanged:Connect(function(inputObject)
		if not pressing or not isMove(inputObject) then
			return
		end
		local point = getMousePosition()
		if (point - pressPoint).Magnitude > 4 then
			moved = true
		end
		if not moved then
			return
		end
		local position = point - grabOffset - screenGui.AbsolutePosition
		target.AnchorPoint = Vector2.new(0, 0)
		target.Position = UDim2.fromOffset(
			math.clamp(position.X, 0, math.max(screenGui.AbsoluteSize.X - target.AbsoluteSize.X, 0)),
			math.clamp(position.Y, 0, math.max(screenGui.AbsoluteSize.Y - target.AbsoluteSize.Y, 0))
		)
	end))

	table.insert(self._connections, UserInputService.InputEnded:Connect(function(inputObject)
		if pressing and isPress(inputObject) then
			pressing = false
			if not moved and onTap then
				onTap()
			end
		end
	end))
end

function Window:_enableResize(minSize)
	local maxSize = self.MaxSize or Vector2.new(math.huge, math.huge)

	local grip = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, 4, 1, 4),
		Size = UDim2.fromOffset(32, 32),
		BackgroundTransparency = 1,
		Active = true,
		ZIndex = 20,
		Parent = self.Root,
	})
	self._grip = grip

	local gripImage = create("ImageLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, -16, 0.5, -16),
		Size = UDim2.fromOffset(96, 96),
		BackgroundTransparency = 1,
		Image = Assets.ResizeGrip,
		ImageColor3 = Theme.Accent,
		ImageTransparency = 0.8,
		ZIndex = 20,
		Parent = grip,
	})

	local resizing = false
	local startSize = self.Root.Size
	local startPoint = Vector2.zero
	local targetSize

	grip.InputBegan:Connect(function(inputObject)
		if isPress(inputObject) then
			resizing = true
			startSize = self.Root.Size
			startPoint = getMousePosition()
			tween(gripImage, { ImageTransparency = 0.35 }, 0.1)
		end
	end)
	grip.MouseEnter:Connect(function()
		if not resizing then
			tween(gripImage, { ImageTransparency = 0.35 }, 0.1)
		end
	end)
	grip.MouseLeave:Connect(function()
		if not resizing then
			tween(gripImage, { ImageTransparency = 0.8 }, 0.17)
		end
	end)

	table.insert(self._connections, UserInputService.InputEnded:Connect(function(inputObject)
		if resizing and isPress(inputObject) then
			resizing = false
			tween(gripImage, { ImageTransparency = 0.8 }, 0.17)
			if targetSize then
				self.Root.Size = UDim2.fromOffset(targetSize.X, targetSize.Y)
				targetSize = nil
			end
			self:_fitToScreen()
			self:_clampToScreen()
		end
	end))

	table.insert(self._frameSteps, function(deltaTime)
		if not resizing then
			return
		end
		local delta = (getMousePosition() - startPoint) / self.Scale.Scale
		targetSize = Vector2.new(
			math.clamp(startSize.X.Offset + delta.X * 2, minSize.X, maxSize.X),
			math.clamp(startSize.Y.Offset + delta.Y * 2, minSize.Y, maxSize.Y)
		)
		local current = Vector2.new(self.Root.Size.X.Offset, self.Root.Size.Y.Offset)
		local alpha = 1 - math.exp(-deltaTime * 35)
		local nextSize = current:Lerp(targetSize, alpha)
		nextSize = Vector2.new(math.floor(nextSize.X + 0.5), math.floor(nextSize.Y + 0.5))
		if nextSize ~= current then
			self.Root.Size = UDim2.fromOffset(nextSize.X, nextSize.Y)
		end
	end)
end

local function sanitizeConfigName(name)
	name = tostring(name or "")
		:gsub('[%c/\\:%*%?"<>|]', "")
		:gsub("%.%.+", ".")
		:gsub("^[%s%.]+", "")
		:gsub("[%s%.]+$", "")
	if name == "" then
		return nil
	end
	return name
end

local function configPath(window, name)
	local clean = sanitizeConfigName(name)
	if not clean then
		return nil, "invalid config name"
	end
	return window.ConfigFolder .. "/" .. clean .. ".json", clean
end

local function hasFileApi()
	return type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
end

local function ensureFolder(folder)
	if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder(folder) then
		makefolder(folder)
	end
end

local function serializeElement(element)
	local typeName = element._type
	local value = element:Get()
	if typeName == "Keybind" then
		return { Type = typeName, Value = value and value.Name or nil }
	elseif typeName == "ColorPicker" then
		return { Type = typeName, Value = { value.R, value.G, value.B } }
	end
	return { Type = typeName, Value = value }
end

local function applySavedValue(element, saved, silent)
	local typeName = element._type
	local value = saved.Value
	if typeName == "Keybind" then
		element:Set(toKeyCode(value), silent)
	elseif typeName == "ColorPicker" then
		if type(value) == "table" then
			element:Set(Color3.new(value[1], value[2], value[3]), silent)
		end
	elseif typeName == "Dropdown" then

		element:Set(value, silent)
	elseif value ~= nil then
		element:Set(value, silent)
	end
end

function Window:SaveConfig(name)
	if not hasFileApi() then
		return false, "file API unavailable"
	end
	local path, cleanName = configPath(self, name or self.ConfigName)
	if not path then
		return false, cleanName
	end

	local data = {}
	for flag, element in pairs(self.Flags) do
		if element._type and type(element.Get) == "function" then
			data[flag] = serializeElement(element)
		end
	end

	local ok, err = pcall(function()
		ensureFolder(self.ConfigFolder)
		writefile(path, HttpService:JSONEncode(data))
	end)
	if ok then
		self.ConfigName = cleanName
	end
	return ok, err
end

function Window:LoadConfig(name, silent)
	if not hasFileApi() then
		return false, "file API unavailable"
	end
	local path, cleanName = configPath(self, name or self.ConfigName)
	if not path then
		return false, cleanName
	end
	if not isfile(path) then
		return false, "no config named " .. cleanName
	end

	local ok, data = pcall(function()
		return HttpService:JSONDecode(readfile(path))
	end)
	if not ok or type(data) ~= "table" then
		return false, "config is not valid JSON"
	end

	local autoSaveWas = self._autoSaveEnabled
	self._autoSaveEnabled = false
	for flag, saved in pairs(data) do
		local element = self.Flags[flag]
		if element and type(element.Set) == "function" and type(saved) == "table" and saved.Type == element._type then
			local applied, err = pcall(applySavedValue, element, saved, silent == true)
			if not applied then
				log("could not load flag " .. tostring(flag) .. ": " .. tostring(err))
			end
		end
	end
	self._autoSaveEnabled = autoSaveWas
	self._autoSaveReady = true
	self.ConfigName = cleanName
	return true
end

function Window:DeleteConfig(name)
	if not hasFileApi() or type(delfile) ~= "function" then
		return false, "file API unavailable"
	end
	local path, cleanName = configPath(self, name)
	if not path then
		return false, cleanName
	end
	if not isfile(path) then
		return false, "no config named " .. cleanName
	end
	return pcall(delfile, path)
end

function Window:ListConfigs()
	local names = {}
	if type(listfiles) ~= "function" or type(isfolder) ~= "function" or not isfolder(self.ConfigFolder) then
		return names
	end
	local ok, files = pcall(listfiles, self.ConfigFolder)
	if not ok or type(files) ~= "table" then
		return names
	end
	for _, file in ipairs(files) do
		local name = file:match("([^/\\]+)%.json$")
		if name then
			table.insert(names, name)
		end
	end
	table.sort(names)
	return names
end

function Window:SetAutoSave(enabled)
	self._autoSaveEnabled = enabled == true
end

function Window:_autoSave()
	if not self._autoSaveEnabled or self._destroyed or not self._autoSaveReady or self._autoSavePending then
		return
	end
	self._autoSavePending = true
	task.delay(0.5, function()
		self._autoSavePending = false
		if not self._destroyed then
			self:SaveConfig(self.ConfigName)
		end
	end)
end

local function createEmptyState(parent, icon, text)
	local holder = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, -10),
		Size = UDim2.fromOffset(200, 70),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	local image = create("ImageLabel", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.fromOffset(26, 26),
		BackgroundTransparency = 1,
		ImageColor3 = Theme.Muted,
		ImageTransparency = 0.15,
		ScaleType = Enum.ScaleType.Fit,
		Parent = holder,
	})
	setIcon(image, icon)
	local label = createLabel({
		Position = UDim2.fromOffset(0, 36),
		Size = UDim2.new(1, 0, 0, 16),
		Text = text,
		TextSize = 13,
		FontFace = Fonts.Regular,
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = holder,
	})
	return holder, label, image
end

local function createStatTile(parent, order, icon, title)
	local tile = create("Frame", {
		Size = UDim2.new(0.5, -4, 0, 62),
		BackgroundColor3 = Theme.Surface2,
		BorderSizePixel = 0,
		LayoutOrder = order,
		Parent = parent,
	})
	addCorner(tile)
	addStroke(tile)
	tile:SetAttribute(ATTR_NO_DRAG, true)
	if icon then
		createIcon(tile, icon, Theme.Muted, UDim2.new(0, 14, 0, 21))
	end
	createLabel({
		Position = UDim2.fromOffset(icon and 36 or 14, 12),
		Size = UDim2.new(1, -(icon and 50 or 28), 0, 16),
		Text = title,
		TextSize = 12,
		TextColor3 = Theme.Muted,
		Parent = tile,
	})
	return createLabel({
		Position = UDim2.fromOffset(14, 34),
		Size = UDim2.new(1, -28, 0, 18),
		Text = "…",
		TextSize = 15,
		Parent = tile,
	})
end

local originalTransparency = setmetatable({}, { __mode = "k" })

local function fadeInTree(rootObject)
	local entries = {}

	local function remember(instance, property)
		local original = originalTransparency[instance]
		if original == nil then
			original = instance[property]
			originalTransparency[instance] = original
		end
		table.insert(entries, { instance, property, original })
	end

	local function walk(parent)
		for _, child in ipairs(parent:GetChildren()) do
			if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
				remember(child, "TextTransparency")
			elseif child:IsA("ImageLabel") or child:IsA("ImageButton") then
				remember(child, "ImageTransparency")
			elseif child:IsA("UIStroke") then
				remember(child, "Transparency")
			elseif child:IsA("Frame") then
				remember(child, "BackgroundTransparency")
			end
			walk(child)
		end
	end

	if rootObject:IsA("Frame") then
		remember(rootObject, "BackgroundTransparency")
	end
	walk(rootObject)

	for _, entry in ipairs(entries) do
		entry[1][entry[2]] = 1
		tween(entry[1], { [entry[2]] = entry[3] }, 0.28)
	end
end

local function slideIn(group, offsetY)
	offsetY = offsetY or 0
	group.GroupTransparency = 1
	group.Position = UDim2.fromOffset(0, offsetY + 14)
	group.Visible = true
	tween(group, { GroupTransparency = 0, Position = UDim2.fromOffset(0, offsetY) }, 0.32, Enum.EasingStyle.Quint)
end

local DEFAULT_STATS = { "FPS", "Ping", "Executor", "Game", "Region", "Time" }

function Window:_buildHome(homeOptions)
	local homeTab = self:Tab({
		Name = homeOptions.Name or "Home",
		Desc = homeOptions.Desc,
		Icon = homeOptions.Icon or "house",
	})
	local list = homeTab.List
	local pageDefs = homeOptions.Pages or homeOptions.Tabs
	local pages = {}

	local pillRow
	if type(pageDefs) == "table" and #pageDefs > 0 then
		pillRow = create("Frame", {
			Size = UDim2.new(1, 0, 0, 32),
			BackgroundTransparency = 1,
			LayoutOrder = 1,
			Parent = list,
		})
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 6),
			Parent = pillRow,
		})
	end

	local greeting = homeOptions.Greeting
	if greeting == nil then
		local hour = tonumber(os.date("%H")) or 12
		local partOfDay = hour < 12 and "morning" or (hour < 18 and "afternoon" or "evening")
		greeting = "Good " .. partOfDay .. "."
	end

	local welcomeCard = create("Frame", {
		Size = UDim2.new(1, 0, 0, 58),
		BackgroundColor3 = Theme.Surface2,
		BorderSizePixel = 0,
		LayoutOrder = 2,
		Parent = list,
	})
	welcomeCard:SetAttribute(ATTR_NO_DRAG, true)
	addCorner(welcomeCard)
	addStroke(welcomeCard)

	local avatar = create("ImageLabel", {
		Position = UDim2.fromOffset(12, 11),
		Size = UDim2.fromOffset(36, 36),
		BackgroundColor3 = Theme.Surface,
		BorderSizePixel = 0,
		Parent = welcomeCard,
	})
	addCorner(avatar, UDim.new(0, 8))
	addStroke(avatar)
	task.spawn(function()
		local ok, image = pcall(function()
			return Players:GetUserThumbnailAsync(LocalPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
		end)
		if ok and image and avatar.Parent then
			avatar.Image = image
		end
	end)

	createLabel({
		Position = UDim2.fromOffset(58, 11),
		Size = UDim2.new(1, -72, 0, 18),
		Text = (homeOptions.Welcome or "Hello, ") .. LocalPlayer.DisplayName,
		TextSize = 15,
		Parent = welcomeCard,
	})
	createLabel({
		Position = UDim2.fromOffset(58, 30),
		Size = UDim2.new(1, -72, 0, 16),
		Text = greeting,
		TextSize = 13,
		FontFace = Fonts.Regular,
		TextColor3 = Theme.Muted,
		Parent = welcomeCard,
	})

	local detailsPage = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 3,
		Parent = list,
	})
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		Parent = detailsPage,
	})

	if homeOptions.Sections ~= false then
		local headerRow = create("Frame", {
			Size = UDim2.new(1, 0, 0, 24),
			BackgroundTransparency = 1,
			LayoutOrder = 1,
			Parent = detailsPage,
		})
		local headerLabel = createLabel({
			Position = UDim2.fromOffset(2, 6),
			Size = UDim2.new(0, 0, 0, 16),
			AutomaticSize = Enum.AutomaticSize.X,
			Text = string.upper(homeOptions.SectionName or "System info"),
			TextSize = 12,
			TextColor3 = Theme.Muted,
			TextTruncate = Enum.TextTruncate.None,
			Parent = headerRow,
		})
		local headerLine = create("Frame", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0, 14),
			Size = UDim2.new(1, -12, 0, 1),
			BackgroundColor3 = Theme.Stroke,
			BorderSizePixel = 0,
			Parent = headerRow,
		})
		local function fitLine()
			headerLine.Size = UDim2.new(1, -(headerLabel.AbsoluteSize.X / self.Scale.Scale + 14), 0, 1)
		end
		headerLabel:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitLine)
		task.defer(fitLine)
	end

	local statGrid = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Parent = detailsPage,
	})
	create("UIGridLayout", {
		CellSize = UDim2.new(0.5, -4, 0, 62),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = statGrid,
	})

	local enabledStats = {}
	for _, statName in ipairs(homeOptions.Stats or DEFAULT_STATS) do
		enabledStats[statName] = true
	end

	local tileCount = 0
	local function addStat(statName, icon, title)
		if not enabledStats[statName] then
			return nil
		end
		tileCount += 1
		return createStatTile(statGrid, tileCount, icon, title)
	end

	local fpsValue = addStat("FPS", "activity", "FPS")
	local pingValue = addStat("Ping", "wifi", "Ping")
	local executorValue = addStat("Executor", "terminal", "Executor")
	local gameValue = addStat("Game", "gamepad-2", "Game")
	local regionValue = addStat("Region", "globe", "Your region")
	local timeValue = addStat("Time", "clock", "Time of day")
	local playersValue = addStat("Players", "users", "Players")
	local uptimeValue = addStat("Uptime", "timer", "Session")

	if executorValue then
		executorValue.Text = getExecutorName()
	end
	if gameValue then
		gameValue.Text = "Loading"
		task.spawn(function()
			local name = getGameName()
			if gameValue.Parent then
				gameValue.Text = name
			end
		end)
	end
	if regionValue then
		regionValue.Text = "Loading"
		fetchRegion(function(region)
			if regionValue.Parent then
				regionValue.Text = region
			end
		end, homeOptions.RegionCity == false)
	end

	local frames = 0
	local sessionStart = os.clock()
	self:_listen("Render", function()
		frames += 1
	end)

	task.spawn(function()
		while not self._destroyed and homeTab.List.Parent and homeTab._page.Parent do

			if not self.Open or self.CurrentTab ~= homeTab then
				frames = 0
				task.wait(1)
				continue
			end
			if fpsValue then
				fpsValue.Text = tostring(frames)
			end
			frames = 0
			if pingValue then
				local ok, ping = pcall(function()
					return math.floor(LocalPlayer:GetNetworkPing() * 1000)
				end)
				pingValue.Text = (ok and ping or 0) .. " ms"
			end
			if timeValue then
				timeValue.Text = os.date(homeOptions.TimeFormat or "%H:%M")
			end
			if playersValue then
				playersValue.Text = #Players:GetPlayers() .. " / " .. Players.MaxPlayers
			end
			if uptimeValue then
				local seconds = math.floor(os.clock() - sessionStart)
				uptimeValue.Text = string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
			end
			task.wait(1)
		end
	end)

	table.insert(pages, {
		Title = homeOptions.SectionName or "Details",
		Icon = homeOptions.TabIcon or "layout-grid",
		Frame = detailsPage,
	})

	if pillRow then
		local function addTextCard(parent, order)
			local card = create("Frame", {
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundColor3 = Theme.Surface2,
				BorderSizePixel = 0,
				LayoutOrder = order,
				Parent = parent,
			})
			card:SetAttribute(ATTR_NO_DRAG, true)
			addCorner(card)
			addStroke(card)
			addPadding(card, 14, 14, 12, 14)
			return card
		end

		for _, pageDef in ipairs(pageDefs) do
			local pageFrame = create("Frame", {
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				Visible = false,
				LayoutOrder = 3,
				Parent = list,
			})
			create("UIListLayout", {
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 8),
				Parent = pageFrame,
			})

			if type(pageDef.Content) == "string" then
				local card = addTextCard(pageFrame, 1)
				createLabel({
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					Text = pageDef.Content,
					TextSize = 13,
					FontFace = Fonts.Regular,
					TextColor3 = Theme.Muted,
					TextWrapped = true,
					TextTruncate = Enum.TextTruncate.None,
					TextYAlignment = Enum.TextYAlignment.Top,
					Parent = card,
				})
			end

			if type(pageDef.Entries) == "table" then
				for entryIndex, entry in ipairs(pageDef.Entries) do
					local card = addTextCard(pageFrame, entryIndex + 1)
					create("UIListLayout", {
						SortOrder = Enum.SortOrder.LayoutOrder,
						Padding = UDim.new(0, 4),
						Parent = card,
					})

					local titleRow = create("Frame", {
						Size = UDim2.new(1, 0, 0, 18),
						BackgroundTransparency = 1,
						LayoutOrder = 1,
						Parent = card,
					})
					createLabel({
						Size = UDim2.new(1, -70, 1, 0),
						Text = entry.Title or entry.Version or "Update",
						TextSize = 14,
						Parent = titleRow,
					})

					if entry.Date or entry.Tag then
						local tag = create("Frame", {
							AnchorPoint = Vector2.new(1, 0.5),
							Position = UDim2.new(1, 0, 0.5, 0),
							Size = UDim2.fromOffset(0, 20),
							AutomaticSize = Enum.AutomaticSize.X,
							BackgroundColor3 = Theme.Surface,
							BorderSizePixel = 0,
							Parent = titleRow,
						})
						addCorner(tag, UDim.new(0, 5))
						addStroke(tag)
						addPadding(tag, 8, 8)
						createLabel({
							Size = UDim2.new(0, 0, 1, 0),
							AutomaticSize = Enum.AutomaticSize.X,
							Text = tostring(entry.Tag or entry.Date),
							TextSize = 11,
							TextColor3 = Theme.Muted,
							TextTruncate = Enum.TextTruncate.None,
							Parent = tag,
						})
					end

					local bodyText = entry.Content or entry.Body
					if type(entry.Changes) == "table" then
						bodyText = "• " .. table.concat(entry.Changes, "\n• ")
					end
					if bodyText then
						createLabel({
							Size = UDim2.new(1, 0, 0, 0),
							AutomaticSize = Enum.AutomaticSize.Y,
							Text = tostring(bodyText),
							TextSize = 13,
							FontFace = Fonts.Regular,
							TextColor3 = Theme.Muted,
							TextWrapped = true,
							TextTruncate = Enum.TextTruncate.None,
							TextYAlignment = Enum.TextYAlignment.Top,
							LayoutOrder = 2,
							Parent = card,
						})
					end
				end
			end

			if type(pageDef.Build) == "function" then
				safeCall(pageDef.Build, pageFrame)
				for _, child in ipairs(pageFrame:GetChildren()) do
					if child:IsA("GuiObject") then
						child:SetAttribute(ATTR_NO_DRAG, true)
					end
				end
			end

			table.insert(pages, {
				Title = pageDef.Name or pageDef.Title or "Page",
				Icon = pageDef.Icon,
				Frame = pageFrame,
			})
		end

		local pills = {}

		local function showPage(pageIndex, instant)
			local changed = self._homeIndex ~= pageIndex
			self._homeIndex = pageIndex
			welcomeCard.Visible = pageIndex == 1
			if pageIndex == 1 and changed and not instant then
				fadeInTree(welcomeCard)
			end

			for index, page in ipairs(pages) do
				local active = index == pageIndex
				page.Frame.Visible = active
				if active and changed and not instant then
					for _, child in ipairs(page.Frame:GetChildren()) do
						if child:IsA("GuiObject") then
							fadeInTree(child)
						end
					end
				end

				local pill = pills[index]
				if pill then
					tween(pill.Frame, { BackgroundTransparency = active and 0 or 1 }, 0.15)
					tween(pill.Stroke, { Transparency = active and 0 or 1 }, 0.15)
					tween(pill.Label, { TextColor3 = active and Theme.Text or Theme.Muted }, 0.15)
					if pill.Icon then
						tween(pill.Icon, { ImageColor3 = active and Theme.Accent or Theme.Muted }, 0.15)
					end
				end
			end
		end

		for index, page in ipairs(pages) do
			local pillButton = create("TextButton", {
				Size = UDim2.fromOffset(0, 32),
				AutomaticSize = Enum.AutomaticSize.X,
				BackgroundColor3 = Theme.Surface2,
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
				LayoutOrder = index,
				Parent = pillRow,
			})
			addCorner(pillButton, UDim.new(0, 7))
			local pillStroke = addStroke(pillButton, Theme.Stroke, 1)
			addPadding(pillButton, 12, 12)

			local pillIcon
			if page.Icon then
				pillIcon = create("ImageLabel", {
					AnchorPoint = Vector2.new(0, 0.5),
					Position = UDim2.new(0, 0, 0.5, 0),
					Size = UDim2.fromOffset(14, 14),
					BackgroundTransparency = 1,
					ImageColor3 = Theme.Muted,
					ScaleType = Enum.ScaleType.Fit,
					Parent = pillButton,
				})
				setIcon(pillIcon, page.Icon)
			end

			local pillLabel = createLabel({
				Position = UDim2.fromOffset(pillIcon and 20 or 0, 0),
				Size = UDim2.new(0, 0, 1, 0),
				AutomaticSize = Enum.AutomaticSize.X,
				Text = page.Title,
				TextSize = 13,
				TextColor3 = Theme.Muted,
				TextTruncate = Enum.TextTruncate.None,
				Parent = pillButton,
			})

			pills[index] = {
				Frame = pillButton,
				Stroke = pillStroke,
				Label = pillLabel,
				Icon = pillIcon,
			}

			pillButton.MouseEnter:Connect(function()
				if self._homeIndex ~= index then
					tween(pillButton, { BackgroundTransparency = 0.4 }, 0.12)
					tween(pillStroke, { Transparency = 0.5 }, 0.12)
				end
			end)
			pillButton.MouseLeave:Connect(function()
				if self._homeIndex ~= index then
					tween(pillButton, { BackgroundTransparency = 1 }, 0.2)
					tween(pillStroke, { Transparency = 1 }, 0.2)
				end
			end)
			pillButton.MouseButton1Click:Connect(function()
				showPage(index)
			end)
		end

		showPage(1)
	end

	homeTab._order = 10
	self.Home = homeTab
	return homeTab
end

function Window:Tab(input, icon)
	local options = normalizeOptions(input, { Title = "Name", Description = "Desc" })
	if icon ~= nil and options.Icon == nil then
		options.Icon = icon
	end

	local tab = setmetatable({
		Name = options.Name or "Tab",
		Window = self,
		_order = 0,
	}, Tab)

	local button = create("TextButton", {
		Size = UDim2.fromOffset(0, 30),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Theme.Surface2,
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = #self.Tabs + 1,
		Parent = self.TabList,
	})
	addCorner(button, UDim.new(0, 7))
	local buttonStroke = addStroke(button, Theme.Stroke, 1)
	addPadding(button, 12, 12)
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 7),
		Parent = button,
	})
	tab._button = button
	tab._stroke = buttonStroke

	if options.Icon ~= nil then
		local iconImage = create("ImageLabel", {
			Size = UDim2.fromOffset(15, 15),
			BackgroundTransparency = 1,
			ImageColor3 = Theme.Muted,
			ScaleType = Enum.ScaleType.Fit,
			LayoutOrder = 1,
			Parent = button,
		})
		if setIcon(iconImage, options.Icon) then
			tab._icon = iconImage
		else
			iconImage:Destroy()
		end
	end

	tab._label = createLabel({
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = tab.Name,
		TextSize = 13,
		TextColor3 = Theme.Muted,
		TextTruncate = Enum.TextTruncate.None,
		LayoutOrder = 2,
		Parent = button,
	})
	button:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if self.CurrentTab == tab and self._introDone then
			self:_placeIndicator(tab)
		end
	end)

	local page = create("Frame", {
		Name = tab.Name,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = self.Content,
	})
	tab._page = page

	if options.Desc then
		tab._pageDesc = createLabel({
			Position = UDim2.fromOffset(20, 12),
			Size = UDim2.new(1, -40, 0, 16),
			Text = options.Desc,
			TextSize = 12,
			FontFace = Fonts.Regular,
			TextColor3 = Theme.Muted,
			Parent = page,
		})
	end

	local listTop = options.Desc and 32 or 4
	local list = create("ScrollingFrame", {
		Position = UDim2.fromOffset(0, listTop),
		Size = UDim2.new(1, 0, 1, -listTop),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Accent,
		ScrollBarImageTransparency = 0.4,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = page,
	})
	addPadding(list, 18, 18, 10, 18)
	if IS_TOUCH then
		list:SetAttribute(ATTR_NO_DRAG, true)
	end
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6),
		Parent = list,
	})
	tab.List = list

	local emptyState = createEmptyState(page, options.Icon or "layout-grid", options.EmptyText or "Nothing here yet")
	local childCount = 0
	list.ChildAdded:Connect(function(child)
		if child:IsA("GuiObject") then
			childCount += 1
			emptyState.Visible = false
		end
	end)
	list.ChildRemoved:Connect(function(child)
		if child:IsA("GuiObject") then
			childCount = math.max(childCount - 1, 0)
			emptyState.Visible = childCount <= 0
		end
	end)
	emptyState.Visible = true

	button.MouseEnter:Connect(function()
		if self.CurrentTab ~= tab then
			tween(button, { BackgroundTransparency = 0.5 }, 0.12)
			tween(buttonStroke, { Transparency = 0.6 }, 0.12)
		end
	end)
	button.MouseLeave:Connect(function()
		if self.CurrentTab ~= tab then
			tween(button, { BackgroundTransparency = 1 }, 0.2)
			tween(buttonStroke, { Transparency = 1 }, 0.2)
		end
	end)
	button.MouseButton1Click:Connect(function()
		self:SelectTab(tab)
	end)

	if not self._introDone then
		button.Visible = false
	end

	table.insert(self.Tabs, tab)
	if #self.Tabs == 1 then
		task.defer(function()
			if not self.CurrentTab then
				self:SelectTab(tab)
			end
		end)
	end

	return tab
end
Window.CreateTab = Window.Tab

function Window:_indicatorX(tab)
	local strip = self.TabList.Parent
	local scale = self.Scale.Scale
	local x = (tab._button.AbsolutePosition.X - strip.AbsolutePosition.X) / scale
	local width = tab._button.AbsoluteSize.X / scale
	return x, width
end

function Window:_placeIndicator(tab)
	local indicator = self.Indicator
	local x, width = self:_indicatorX(tab)
	if not indicator.Visible then
		indicator.Visible = true
		indicator.Position = UDim2.new(0, x + width / 2, 0.5, 0)
		indicator.Size = UDim2.fromOffset(0, 30)
	end
	tween(indicator, {
		Position = UDim2.new(0, x, 0.5, 0),
		Size = UDim2.fromOffset(width, 30),
	}, 0.35, Enum.EasingStyle.Quint)
end

function Window:SelectTab(tab)
	if type(tab) == "string" then
		local wanted = tab
		tab = nil
		for _, candidate in ipairs(self.Tabs) do
			if candidate.Name == wanted then
				tab = candidate
				break
			end
		end
	end
	if type(tab) ~= "table" or self.CurrentTab == tab then
		return
	end

	local previous = self.CurrentTab
	self.CurrentTab = tab
	self:_settleTransition()

	self._transitionGeneration = (self._transitionGeneration or 0) + 1
	local generation = self._transitionGeneration

	if previous then
		tween(previous._button, { BackgroundTransparency = 1 }, 0.2)
		tween(previous._stroke, { Transparency = 1 }, 0.2)
		tween(previous._label, { TextColor3 = Theme.Muted }, 0.2)
		if previous._icon then
			tween(previous._icon, { ImageColor3 = Theme.Muted }, 0.2)
		end

		local outLayer = self._outLayer
		previous._page.Parent = outLayer
		self._outPage = previous._page
		outLayer.GroupTransparency = 0
		outLayer.Position = UDim2.fromOffset(0, 0)
		outLayer.Visible = true
		tween(outLayer, { GroupTransparency = 1, Position = UDim2.fromOffset(0, -10) }, 0.18)
		task.delay(0.18, function()
			if self._transitionGeneration == generation then
				self:_settleOut()
			end
		end)
	end

	tween(tab._button, { BackgroundTransparency = 1 }, 0.2)
	tween(tab._stroke, { Transparency = 1 }, 0.2)
	tween(tab._label, { TextColor3 = Theme.Text }, 0.2)
	if tab._icon then
		tween(tab._icon, { ImageColor3 = Theme.Accent }, 0.2)
	end
	self:_placeIndicator(tab)

	local page = tab._page
	page.Position = UDim2.fromOffset(0, 0)
	page.Visible = true
	page.Parent = self._inLayer
	self._inPage = page
	slideIn(self._inLayer)
	task.delay(0.32, function()
		if self._transitionGeneration == generation then
			self:_settleIn()
		end
	end)
end

function Window:_settleOut()
	local page = self._outPage
	if page then
		page.Parent = self.Content
		page.Visible = false
		self._outPage = nil
	end
	self._outLayer.Visible = false
end

function Window:_settleIn()
	local page = self._inPage
	if page then
		page.Parent = self.Content
		page.Position = UDim2.fromOffset(0, 0)
		self._inPage = nil
	end
	self._inLayer.Visible = false
end

function Window:_settleTransition()
	self:_settleOut()
	self:_settleIn()
end

local DIALOG_PADDING = 18
local DIALOG_WIDTH = 300

function Window:Dialog(input)
	local options = normalizeOptions(input, { Text = "Content", Message = "Content" })

	if self._dialog then
		self._dialog.Close()
	end

	local pad = DIALOG_PADDING

	local backdrop = create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 40,
		Parent = self.Body,
	})

	local panel = create("TextButton", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 10),
		Size = UDim2.fromOffset(DIALOG_WIDTH, 120),
		BackgroundColor3 = Theme.Background,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 41,
		Parent = backdrop,
	})
	addCorner(panel, UDim.new(0, 8))
	local panelStroke = addStroke(panel, Theme.Stroke, 1)
	local panelAccent = addAccentLine(panel)
	panelAccent.ZIndex = 42
	panelAccent.BackgroundTransparency = 1
	local panelScale = create("UIScale", { Scale = 0.94, Parent = panel })

	local fades = { { panelAccent, "BackgroundTransparency", 0 } }
	local titleOffset = 0

	if options.Icon then
		local iconHolder, iconImage = createIcon(panel, options.Icon, Theme.Accent, UDim2.new(0, pad, 0, pad + 9))
		iconImage.ImageTransparency = 1
		iconHolder.ZIndex = 42
		iconImage.ZIndex = 42
		table.insert(fades, { iconImage, "ImageTransparency", 0 })
		titleOffset = 24
	end

	local titleLabel = createLabel({
		Position = UDim2.fromOffset(pad + titleOffset, pad),
		Size = UDim2.new(1, -(pad * 2 + titleOffset), 0, 18),
		Text = options.Title or "Are you sure?",
		TextSize = 15,
		TextTransparency = 1,
		ZIndex = 42,
		Parent = panel,
	})
	table.insert(fades, { titleLabel, "TextTransparency", 0 })

	local buttonRow = create("Frame", {
		Name = "ButtonRow",
		Size = UDim2.new(1, -pad * 2, 0, 34),
		BackgroundTransparency = 1,
		ZIndex = 42,
		Parent = panel,
	})
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		Parent = buttonRow,
	})

	local contentHeight = 0
	local function layout()
		panel.Size = UDim2.fromOffset(DIALOG_WIDTH, pad + 24 + contentHeight + 12 + 34 + pad)
		buttonRow.Position = UDim2.fromOffset(pad, pad + 24 + contentHeight + 12)
	end

	if options.Content then
		local contentLabel = createLabel({
			Position = UDim2.fromOffset(pad, pad + 24),
			Size = UDim2.new(1, -pad * 2, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Text = tostring(options.Content),
			TextSize = 13,
			FontFace = Fonts.Regular,
			TextColor3 = Theme.Muted,
			TextWrapped = true,
			TextTransparency = 1,
			TextTruncate = Enum.TextTruncate.None,
			TextYAlignment = Enum.TextYAlignment.Top,
			ZIndex = 42,
			Parent = panel,
		})
		table.insert(fades, { contentLabel, "TextTransparency", 0 })
		contentHeight = math.max(contentLabel.TextBounds.Y, 16) + 6
		contentLabel:GetPropertyChangedSignal("TextBounds"):Connect(function()
			local newHeight = math.max(contentLabel.TextBounds.Y, 16) + 6
			if newHeight ~= contentHeight then
				contentHeight = newHeight
				layout()
			end
		end)
	end
	layout()

	local dialog = {}
	local closed = false

	function dialog.Close()
		if closed then
			return
		end
		closed = true
		if self._dialog == dialog then
			self._dialog = nil
		end
		tween(backdrop, { BackgroundTransparency = 1 }, 0.18)
		tween(panel, { BackgroundTransparency = 1, Position = UDim2.new(0.5, 0, 0.5, 8) }, 0.18, Enum.EasingStyle.Quint)
		tween(panelScale, { Scale = 0.96 }, 0.18, Enum.EasingStyle.Quint)
		tween(panelStroke, { Transparency = 1 }, 0.12)
		for _, fade in ipairs(fades) do
			tween(fade[1], { [fade[2]] = 1 }, 0.12)
		end
		task.delay(0.2, function()
			backdrop:Destroy()
		end)
	end

	function dialog.Cancel()
		if closed then
			return
		end
		dialog.Close()
		safeCall(options.OnCancel)
	end

	local buttons = options.Buttons
	if type(buttons) ~= "table" or #buttons == 0 then
		buttons = { { Title = "OK", Variant = "Primary" } }
	end

	for order, buttonDef in ipairs(buttons) do
		local primary = buttonDef.Variant == "Primary"
		local restBackground = primary and 0.12 or 0
		local restStroke = primary and 0.4 or 0

		local dialogButton = create("TextButton", {
			Size = UDim2.fromOffset(0, 34),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = primary and Theme.Accent or Theme.Surface2,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Text = "",
			AutoButtonColor = false,
			ClipsDescendants = true,
			LayoutOrder = order,
			ZIndex = 43,
			Parent = buttonRow,
		})
		addCorner(dialogButton, UDim.new(0, 7))
		local buttonStroke = addStroke(dialogButton, primary and Theme.Accent or Theme.Stroke, 1)
		addPadding(dialogButton, 14, 14)

		local buttonLabel = createLabel({
			Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X,
			Text = buttonDef.Title or buttonDef.Name or "OK",
			TextSize = 13,
			TextColor3 = primary and Theme.AccentDark or Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextTransparency = 1,
			ZIndex = 44,
			Parent = dialogButton,
		})

		table.insert(fades, { dialogButton, "BackgroundTransparency", restBackground })
		table.insert(fades, { buttonStroke, "Transparency", restStroke })
		table.insert(fades, { buttonLabel, "TextTransparency", 0 })

		dialogButton.MouseEnter:Connect(function()
			if closed then
				return
			end
			if primary then
				tween(dialogButton, { BackgroundTransparency = 0 }, 0.12)
				tween(buttonStroke, { Transparency = 0 }, 0.12)
			else
				tween(buttonStroke, { Color = Theme.StrokeHover }, 0.12)
			end
		end)
		dialogButton.MouseLeave:Connect(function()
			if closed then
				return
			end
			if primary then
				tween(dialogButton, { BackgroundTransparency = restBackground }, 0.2)
				tween(buttonStroke, { Transparency = restStroke }, 0.2)
			else
				tween(buttonStroke, { Color = Theme.Stroke }, 0.2)
			end
		end)
		dialogButton.MouseButton1Click:Connect(function()
			if closed then
				return
			end
			dialog.Close()
			safeCall(buttonDef.Callback)
		end)
	end

	dialog.Dismissable = options.CloseOnBackdrop ~= false
	if dialog.Dismissable then
		backdrop.MouseButton1Click:Connect(dialog.Cancel)
	end

	self._dialog = dialog

	tween(backdrop, { BackgroundTransparency = 0.45 }, 0.25)
	tween(panel, { BackgroundTransparency = 0, Position = UDim2.fromScale(0.5, 0.5) }, 0.3, Enum.EasingStyle.Quint)
	tween(panelStroke, { Transparency = 0 }, 0.25)
	tween(panelScale, { Scale = 1 }, 0.4, Enum.EasingStyle.Back)
	for _, fade in ipairs(fades) do
		tween(fade[1], { [fade[2]] = fade[3] }, 0.25)
	end

	return dialog
end

function Window:Confirm(input)
	local options = normalizeOptions(input, { Text = "Content", Message = "Content" })
	return self:Dialog({
		Title = options.Title or "Are you sure?",
		Content = options.Content,
		Icon = options.Icon,
		OnCancel = options.OnCancel,
		CloseOnBackdrop = options.CloseOnBackdrop,
		Buttons = {
			{ Title = options.CancelText or "Cancel", Callback = options.OnCancel },
			{ Title = options.ConfirmText or "Confirm", Variant = "Primary", Callback = options.Callback },
		},
	})
end

function Window:_listen(kind, listener, owner)
	local listeners = self._inputListeners[kind]
	table.insert(listeners, listener)

	local function disconnect()
		local index = table.find(listeners, listener)
		if index then
			table.remove(listeners, index)
		end
	end

	if owner then
		owner._listeners = owner._listeners or {}
		table.insert(owner._listeners, disconnect)
	end
	return disconnect
end

function Window:Toggle(open)
	if not self._introDone or self._destroyed then
		return
	end
	if open == nil then
		open = not self.Open
	end
	if open == self.Open then
		return
	end
	self.Open = open
	self:_hideTooltip()

	if open then
		self.Root.Visible = true
		tween(self.Scale, { Scale = self._fitScale or 1 }, 0.4, Enum.EasingStyle.Back)
		tween(self.Body, { GroupTransparency = 0 }, 0.25)
		tween(self.BodyStroke, { Transparency = 0 }, 0.25)
		tween(self.Shadow, { ImageTransparency = 0.6 }, 0.3)
	else
		tween(self.Scale, { Scale = (self._fitScale or 1) * 0.94 }, 0.2, Enum.EasingStyle.Quint)
		tween(self.Body, { GroupTransparency = 1 }, 0.16)
		tween(self.BodyStroke, { Transparency = 1 }, 0.12)
		tween(self.Shadow, { ImageTransparency = 1 }, 0.16)
		task.delay(0.2, function()
			if not self.Open and not self._destroyed then
				self.Root.Visible = false
			end
		end)
	end
end

function Window:SetKeepOnScreen(keep)
	self.KeepOnScreen = keep ~= false
	if self.KeepOnScreen then
		self:_clampToScreen()
	end
end

function Window:SetKeybind(key)
	key = toKeyCode(key)
	if not key then
		return
	end
	self.Keybind = key
	self._keyChipLabel.Text = keyDisplayName(key)
end

function Window:SetTitle(text)
	self._titleLabel.Text = tostring(text)
end

function Window:SetSubtitle(text)
	self._subtitleLabel.Text = tostring(text)
end

function Window:SetIcon(icon)
	setIcon(self._logo, icon)
end

function Window:SetTheme(themeInput)
	return NeoxHub:SetTheme(themeInput)
end

function Window:Minimize(state)
	if state == nil then
		state = not self._minimized
	end
	state = state == true
	if state == self._minimized or (not state and self._minimized == nil) then
		return
	end
	self._minimized = state
	self:_hideTooltip()
	local width = self.Root.Size.X.Offset
	if state then
		self._restoreHeight = self.Root.Size.Y.Offset
		if self._searchResults then
			self._searchResults.Visible = false
		end
		self._grip.Visible = false
		tween(self.Root, { Size = UDim2.fromOffset(width, TOPBAR_HEIGHT) }, 0.3, Enum.EasingStyle.Quint)
	else
		tween(self.Root, { Size = UDim2.fromOffset(width, self._restoreHeight or DEFAULT_WINDOW_SIZE.Y.Offset) }, 0.3, Enum.EasingStyle.Quint)
		task.delay(0.3, function()
			if not self._minimized and not self._destroyed then
				self._grip.Visible = true
				self:_clampToScreen()
			end
		end)
	end
end

function Window:IsMinimized()
	return self._minimized == true
end

function Window:SetFooter(text)
	self._footerLabel.Text = tostring(text)
end

function Window:SetScale(scale)
	self._userScale = math.clamp(tonumber(scale) or 1, 0.5, 1.5)
	self:_fitToScreen()
	self:_clampToScreen()
end

function Window:GetScale()
	return self._userScale or 1
end

function Window:_registerKeybind(entry)
	table.insert(self._keybinds, entry)
end

function Window:_showTooltip(text, owner)
	self._tooltipOwner = owner
	self._tooltipGeneration = (self._tooltipGeneration or 0) + 1
	local generation = self._tooltipGeneration
	task.delay(0.35, function()
		if self._destroyed or self._tooltipGeneration ~= generation or self._tooltipOwner ~= owner or not self.Open then
			return
		end
		self._tooltipLabel.Text = tostring(text)
		self._tooltip.Visible = true
	end)
end

function Window:_hideTooltip(owner)
	if owner and owner ~= self._tooltipOwner then
		return
	end
	self._tooltipOwner = nil
	self._tooltipGeneration = (self._tooltipGeneration or 0) + 1
	if self._tooltip then
		self._tooltip.Visible = false
	end
end

local MAX_SEARCH_RESULTS = 40

function Window:_runSearch(text)
	local results = self._searchResults
	if not results then
		return
	end
	for _, child in ipairs(results:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end

	local query = string.lower((text or ""):match("^%s*(.-)%s*$"))
	if query == "" then
		results.Visible = false
		return
	end

	results.Visible = true

	local matches = {}
	for _, tab in ipairs(self.Tabs) do
		if string.find(string.lower(tab.Name), query, 1, true) then
			table.insert(matches, { Title = tab.Name, Subtitle = "Tab", Tab = tab })
		end
	end
	for _, entry in ipairs(self._searchIndex) do
		if #matches >= MAX_SEARCH_RESULTS then
			break
		end
		local element = entry.Element
		if not element._destroyed and entry.Frame.Parent and element.Visible ~= false
			and string.find(string.lower(entry.Name), query, 1, true)
		then
			table.insert(matches, {
				Title = entry.Name,
				Subtitle = entry.Tab.Name,
				Tab = entry.Tab,
				Group = entry.Group,
				Frame = entry.Frame,
			})
		end
	end

	results.Size = UDim2.fromOffset(250, math.min(math.max(#matches, 1) * 42 + 12, 300))

	if #matches == 0 then
		createLabel({
			Size = UDim2.new(1, 0, 0, 30),
			Text = "No results",
			TextSize = 13,
			FontFace = Fonts.Regular,
			TextColor3 = Theme.Muted,
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = results,
		})
		return
	end

	for order, match in ipairs(matches) do
		local row = create("TextButton", {
			Size = UDim2.new(1, 0, 0, 40),
			BackgroundColor3 = Theme.Surface2,
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = order,
			Parent = results,
		})
		addCorner(row)
		local rowStroke = addStroke(row, Theme.Stroke, 1)
		createLabel({
			Position = UDim2.fromOffset(12, 5),
			Size = UDim2.new(1, -20, 0, 16),
			Text = match.Title,
			TextSize = 13,
			Parent = row,
		})
		createLabel({
			Position = UDim2.fromOffset(12, 21),
			Size = UDim2.new(1, -20, 0, 14),
			Text = match.Subtitle,
			TextSize = 11,
			FontFace = Fonts.Regular,
			TextColor3 = Theme.Muted,
			Parent = row,
		})
		row.MouseEnter:Connect(function()
			tween(row, { BackgroundTransparency = 0.4 }, 0.12)
			tween(rowStroke, { Transparency = 0.5 }, 0.12)
		end)
		row.MouseLeave:Connect(function()
			tween(row, { BackgroundTransparency = 1 }, 0.2)
			tween(rowStroke, { Transparency = 1 }, 0.2)
		end)
		row.MouseButton1Click:Connect(function()
			self:_jumpTo(match)
		end)
	end
end

function Window:_jumpTo(match)
	if self._searchBox then
		self._searchBox.Text = ""
	end
	self:SelectTab(match.Tab)

	local group = match.Group
	while group do
		if not group.Open then
			group:SetOpen(true)
		end
		group = group._parentGroup
	end

	local frame = match.Frame
	if not frame then
		return
	end
	task.delay(0.4, function()
		if self._destroyed or not frame.Parent then
			return
		end
		local list = match.Tab.List
		local offset = (frame.AbsolutePosition.Y - list.AbsolutePosition.Y) / self.Scale.Scale
		local targetY = math.max(list.CanvasPosition.Y + offset - 12, 0)
		tween(list, { CanvasPosition = Vector2.new(0, targetY) }, 0.35, Enum.EasingStyle.Quint)
		task.delay(0.3, function()
			for _, child in ipairs(frame:GetChildren()) do
				if child:IsA("UIStroke") then
					flashStroke(child)
					task.delay(0.5, function()
						flashStroke(child)
					end)
					break
				end
			end
		end)
	end)
end

function Window:Search(text)
	if self._searchBox then
		self._searchBox.Text = tostring(text or "")
	end
end

local function createOverlayPanel(window, position, width)
	local panel = create("Frame", {
		Position = position,
		Size = UDim2.fromOffset(width or 0, 0),
		AutomaticSize = width and Enum.AutomaticSize.Y or Enum.AutomaticSize.XY,
		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,
		ZIndex = 50,
		Parent = window.Gui,
	})
	addCorner(panel, UDim.new(0, 8))
	addStroke(panel)
	addAccentLine(panel)
	table.insert(window._overlays, panel)
	return panel
end

function Window:Watermark(input)
	local options = normalizeOptions(input, { Name = "Text", Title = "Text" })
	local showFps = options.ShowFPS ~= false
	local showPing = options.ShowPing ~= false
	local showTime = options.ShowTime ~= false

	local panel = createOverlayPanel(self, options.Position or UDim2.fromOffset(16, 16))
	panel.Size = UDim2.fromOffset(0, 30)
	panel.AutomaticSize = Enum.AutomaticSize.X
	addPadding(panel, 10, 12)
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		Parent = panel,
	})

	local icon = create("ImageLabel", {
		Size = UDim2.fromOffset(16, 16),
		BackgroundTransparency = 1,
		ImageColor3 = Theme.Accent,
		ScaleType = Enum.ScaleType.Fit,
		LayoutOrder = 1,
		ZIndex = 51,
		Parent = panel,
	})
	setIcon(icon, options.Icon or Assets.Logo)

	local label = createLabel({
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		TextSize = 13,
		TextTruncate = Enum.TextTruncate.None,
		LayoutOrder = 2,
		ZIndex = 51,
		Parent = panel,
	})

	local watermark = { Frame = panel, Visible = true }
	local textSource = options.Text or self._titleLabel.Text
	local frames, fps = 0, 0
	local stopRender = self:_listen("Render", function()
		frames += 1
	end)

	local function render()
		local parts = {}
		local base = textSource
		if type(base) == "function" then
			local ok, value = pcall(base)
			base = ok and value or ""
		end
		if base ~= nil and tostring(base) ~= "" then
			table.insert(parts, tostring(base))
		end
		if showFps then
			table.insert(parts, fps .. " fps")
		end
		if showPing then
			local ok, ping = pcall(function()
				return math.floor(LocalPlayer:GetNetworkPing() * 1000)
			end)
			table.insert(parts, (ok and ping or 0) .. " ms")
		end
		if showTime then
			table.insert(parts, os.date(options.TimeFormat or "%H:%M"))
		end
		label.Text = table.concat(parts, "  •  ")
	end

	function watermark:SetText(text)
		textSource = text
		render()
	end

	function watermark:SetVisible(visible)
		watermark.Visible = visible ~= false
		panel.Visible = watermark.Visible
	end

	function watermark:Destroy()
		stopRender()
		panel:Destroy()
	end

	self:_makeDraggable(panel)
	render()

	task.spawn(function()
		local last = os.clock()
		while not self._destroyed and panel.Parent do
			task.wait(1)
			local now = os.clock()
			fps = math.floor(frames / math.max(now - last, 0.001) + 0.5)
			frames, last = 0, now
			if panel.Visible then
				render()
			end
		end
	end)

	if options.Visible == false then
		watermark:SetVisible(false)
	end
	return watermark
end

function Window:KeybindList(input)
	local options = normalizeOptions(input, { Name = "Title" })
	local activeOnly = options.ActiveOnly == true

	local panel = createOverlayPanel(self, options.Position or UDim2.new(0, 16, 0.5, -80), 210)
	addPadding(panel, 12, 12, 10, 10)
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6),
		Parent = panel,
	})

	local headerRow = create("Frame", {
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		ZIndex = 51,
		Parent = panel,
	})
	createIcon(headerRow, "keyboard", Theme.Accent, UDim2.new(0, 0, 0.5, 0))
	createLabel({
		Position = UDim2.fromOffset(24, 0),
		Size = UDim2.new(1, -24, 1, 0),
		Text = options.Title or "Keybinds",
		TextSize = 13,
		ZIndex = 51,
		Parent = headerRow,
	})
	create("Frame", {
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = Theme.Stroke,
		BorderSizePixel = 0,
		LayoutOrder = 2,
		ZIndex = 51,
		Parent = panel,
	})

	local rowsHolder = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 3,
		ZIndex = 51,
		Parent = panel,
	})
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 4),
		Parent = rowsHolder,
	})

	local list = { Frame = panel, Visible = true }
	local lastSignature

	local function refresh()
		local entries = {}
		local signatureParts = {}
		for _, entry in ipairs(self._keybinds) do
			local key = entry.GetKey()
			if key and not entry.Element._destroyed then
				local active = entry.GetActive()
				if not activeOnly or active then
					table.insert(entries, { Name = entry.Name, Key = key, Active = active })
					table.insert(signatureParts, entry.Name .. key.Name .. tostring(active))
				end
			end
		end
		local signature = table.concat(signatureParts, "|")
		if signature == lastSignature then
			return
		end
		lastSignature = signature

		for _, child in ipairs(rowsHolder:GetChildren()) do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end

		if #entries == 0 then
			createLabel({
				Size = UDim2.new(1, 0, 0, 18),
				Text = activeOnly and "Nothing active" or "No keybinds",
				TextSize = 12,
				FontFace = Fonts.Regular,
				TextColor3 = Theme.Muted,
				ZIndex = 51,
				Parent = rowsHolder,
			})
			return
		end

		for order, entry in ipairs(entries) do
			local row = create("Frame", {
				Size = UDim2.new(1, 0, 0, 18),
				BackgroundTransparency = 1,
				LayoutOrder = order,
				ZIndex = 51,
				Parent = rowsHolder,
			})
			createLabel({
				Size = UDim2.new(1, -70, 1, 0),
				Text = entry.Name,
				TextSize = 12,
				FontFace = Fonts.Regular,
				TextColor3 = entry.Active and Theme.Text or Theme.Muted,
				ZIndex = 51,
				Parent = row,
			})
			createLabel({
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, 0, 0, 0),
				Size = UDim2.new(0, 70, 1, 0),
				Text = "[" .. keyDisplayName(entry.Key) .. "]",
				TextSize = 12,
				TextColor3 = entry.Active and Theme.Accent or Theme.Muted,
				TextXAlignment = Enum.TextXAlignment.Right,
				ZIndex = 51,
				Parent = row,
			})
		end
	end

	function list:SetVisible(visible)
		list.Visible = visible ~= false
		panel.Visible = list.Visible
	end

	function list:Refresh()
		lastSignature = nil
		refresh()
	end

	function list:Destroy()
		panel:Destroy()
	end

	self:_makeDraggable(panel)
	refresh()

	task.spawn(function()
		while not self._destroyed and panel.Parent do
			task.wait(0.2)
			if panel.Visible then
				refresh()
			end
		end
	end)

	if options.Visible == false then
		list:SetVisible(false)
	end
	return list
end

function Window:Notify(input)
	local options = normalizeOptions(input, { Text = "Content", Message = "Content", Image = "Icon" })

	local duration = options.Duration
	if duration == nil then
		duration = 4
	end
	local persistent = duration == false or (type(duration) == "number" and (duration <= 0 or duration == math.huge))
	if type(duration) ~= "number" then
		duration = 4
	end

	local colorKey = NOTIFY_TYPES[options.Type]
	local accentColor = colorKey and Theme[colorKey] or Theme.Accent
	local titleColor = (colorKey and options.Type ~= "Info") and accentColor or Theme.Text

	self._notifyOrder += 1

	local slot = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundTransparency = 1,
		LayoutOrder = self._notifyOrder,
		Parent = self.NotifyHolder,
	})
	local slider = create("Frame", {
		Position = UDim2.fromOffset(320, 0),
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = slot,
	})
	local shadow = create("ImageLabel", {
		Position = UDim2.fromOffset(-20, -20),
		Size = UDim2.new(1, 40, 1, 40),
		BackgroundTransparency = 1,
		Image = Assets.Shadow,
		ImageColor3 = Color3.new(0, 0, 0),
		ImageTransparency = 1,
		ScaleType = Enum.ScaleType.Slice,
		SliceCenter = Rect.new(49, 49, 450, 450),
		ZIndex = 0,
		Parent = slider,
	})
	local card = create("CanvasGroup", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,
		GroupTransparency = 1,
		Parent = slider,
	})
	addCorner(card, UDim.new(0, 8))
	local cardStroke = addStroke(card, Theme.Stroke)
	local typeLine = addAccentLine(card)
	typeLine.BackgroundColor3 = accentColor

	local inner = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = card,
	})
	addPadding(inner, 14, 14, 14, persistent and 14 or 22)

	local icon = options.Icon
	if icon == nil then
		icon = NOTIFY_ICONS[options.Type]
	end
	local textOffset = 0
	if icon then
		local iconTile = create("Frame", {
			Size = UDim2.fromOffset(30, 30),
			BackgroundColor3 = Theme.Surface2,
			BorderSizePixel = 0,
			Parent = inner,
		})
		addCorner(iconTile, UDim.new(0, 8))
		addStroke(iconTile)
		local iconImage = create("ImageLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(16, 16),
			BackgroundTransparency = 1,
			ImageColor3 = accentColor,
			ScaleType = Enum.ScaleType.Fit,
			Parent = iconTile,
		})
		setIcon(iconImage, icon)
		textOffset = 42
	end

	createLabel({
		Position = UDim2.fromOffset(textOffset, 0),
		Size = UDim2.new(1, -28 - textOffset, 0, 16),
		Text = tostring(options.Title or "Notification"),
		TextSize = 14,
		FontFace = Fonts.Bold,
		TextColor3 = titleColor,
		Parent = inner,
	})

	local dismissButton = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 6, 0, -5),
		Size = UDim2.fromOffset(24, 24),
		BackgroundTransparency = 1,
		Text = "×",
		TextColor3 = Theme.Muted,
		TextSize = 22,
		FontFace = Fonts.Bold,
		AutoButtonColor = false,
		Parent = inner,
	})
	dismissButton.MouseEnter:Connect(function()
		tween(dismissButton, { TextColor3 = Theme.Text }, 0.15)
	end)
	dismissButton.MouseLeave:Connect(function()
		tween(dismissButton, { TextColor3 = Theme.Muted }, 0.2)
	end)

	if options.Content then
		createLabel({
			Position = UDim2.fromOffset(textOffset, 21),
			Size = UDim2.new(1, -textOffset, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Text = tostring(options.Content),
			TextSize = 13,
			FontFace = Fonts.Regular,
			TextColor3 = Theme.Muted,
			TextWrapped = true,
			TextTruncate = Enum.TextTruncate.None,
			TextYAlignment = Enum.TextYAlignment.Top,
			Parent = inner,
		})
	end

	local timerFill
	if not persistent then
		local timerTrack = create("Frame", {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 16, 1, -8),
			Size = UDim2.new(1, -32, 0, 3),
			BackgroundColor3 = Theme.Surface3,
			BorderSizePixel = 0,
			Parent = card,
		})
		addCorner(timerTrack, UDim.new(1, 0))
		timerFill = create("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = accentColor,
			BorderSizePixel = 0,
			Parent = timerTrack,
		})
		addCorner(timerFill, UDim.new(1, 0))
	end

	local settled = false
	task.defer(function()
		if slot.Parent then
			tween(slot, { Size = UDim2.new(1, 0, 0, card.AbsoluteSize.Y) }, 0.3, Enum.EasingStyle.Quint)
		end
	end)
	task.delay(0.32, function()
		settled = true
		if slot.Parent and not slot.ClipsDescendants then
			slot.Size = UDim2.new(1, 0, 0, card.AbsoluteSize.Y)
		end
	end)

	card:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if settled and slot.Parent and not slot.ClipsDescendants then
			slot.Size = UDim2.new(1, 0, 0, card.AbsoluteSize.Y)
		end
	end)

	tween(slider, { Position = UDim2.fromOffset(0, 0) }, 0.45, Enum.EasingStyle.Quint)
	tween(card, { GroupTransparency = 0 }, 0.3)
	tween(shadow, { ImageTransparency = 0.6 }, 0.4)
	if timerFill then
		tween(timerFill, { Size = UDim2.fromScale(0, 1) }, duration, Enum.EasingStyle.Linear)
	end

	local dismissed = false
	local function dismiss()
		if dismissed then
			return
		end
		dismissed = true
		local index = table.find(self._toasts, dismiss)
		if index then
			table.remove(self._toasts, index)
		end
		tween(slider, { Position = UDim2.fromOffset(320, 0) }, 0.3, Enum.EasingStyle.Quint)
		tween(card, { GroupTransparency = 1 }, 0.2)
		tween(cardStroke, { Transparency = 1 }, 0.15)
		tween(shadow, { ImageTransparency = 1 }, 0.2)
		task.delay(0.22, function()
			if not slot.Parent then
				return
			end
			slot.ClipsDescendants = true
			tween(slot, { Size = UDim2.new(1, 0, 0, -4) }, 0.22, Enum.EasingStyle.Quint)
			task.delay(0.24, function()
				slot:Destroy()
			end)
		end)
	end

	if not persistent then
		task.delay(duration, dismiss)
	end
	dismissButton.MouseButton1Click:Connect(dismiss)

	table.insert(self._toasts, dismiss)
	while #self._toasts > self.MaxNotifications do
		table.remove(self._toasts, 1)()
	end

	return { Dismiss = dismiss }
end

function Window:Destroy()
	if self._destroyed then
		return
	end
	self._destroyed = true

	local index = table.find(NeoxHub.Windows, self)
	if index then
		table.remove(NeoxHub.Windows, index)
	end

	for _, connection in ipairs(self._connections) do
		connection:Disconnect()
	end
	self._connections = {}

	for _, listeners in pairs(self._inputListeners) do
		table.clear(listeners)
	end
	table.clear(self._frameSteps)

	for flag, element in pairs(self.Flags) do
		if NeoxHub.Flags[flag] == element then
			NeoxHub.Flags[flag] = nil
		end
	end
	self.Flags = {}

	tween(self.Scale, { Scale = 0.9 }, 0.2)
	tween(self.Body, { GroupTransparency = 1 }, 0.2)
	tween(self.BodyStroke, { Transparency = 1 }, 0.12)
	tween(self.Shadow, { ImageTransparency = 1 }, 0.2)
	task.delay(0.22, function()
		self.Gui:Destroy()
	end)
end

return NeoxHub
