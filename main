		local image = create("ImageLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(17, 17),
			BackgroundTransparency = 1,
			ImageColor3 = Theme.Muted,
			ScaleType = Enum.ScaleType.Fit,
			ZIndex = 6,
			Parent = button,
		})
		setIcon(image, icon)
		button.MouseEnter:Connect(function()
			if IS_TOUCH then
				return
			end
			tween(button, { BackgroundTransparency = 0 }, 0.15)
			tween(image, { ImageColor3 = Theme.Text }, 0.15)
		end)
		button.MouseLeave:Connect(function()
			tween(button, { BackgroundTransparency = 1 }, 0.2)
			tween(image, { ImageColor3 = Theme.Muted }, 0.2)
		end)
		return button
	end

	local closeButton = headerIconButton("Close", "x", -14)
	closeButton.MouseButton1Click:Connect(function()
		window:RequestClose()
	end)
	window._closeButton = closeButton

	if options.MinimizeButton ~= false then
		local minimizeButton = headerIconButton("Minimize", "minus", -52)
		minimizeButton:SetAttribute(Const.ATTR_NO_DRAG, true)
		minimizeButton.MouseButton1Click:Connect(function()
			window:Minimize(true)
		end)
		window._minimizeButton = minimizeButton
	end

	window._notifyHost = createNotifyHost(screenGui, window._connections, options.MaxNotifications or 4, options.NotificationPosition or Nucleus.NotificationPosition)
	window.NotifyHolder = window._notifyHost.Holder
	window._toasts = window._notifyHost.Toasts
	window.MaxNotifications = window._notifyHost.MaxNotifications

	window._controlsDirty = true
	table.insert(window._connections, body.DescendantAdded:Connect(function()
		window._controlsDirty = true
	end))
	table.insert(window._connections, body.DescendantRemoving:Connect(function()
		window._controlsDirty = true
	end))

	local tooltip = create("Frame", {
		Name = "Tooltip",
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundColor3 = Theme.Surface,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 100,
		Parent = screenGui,
	})
	addCorner(tooltip, UDim.new(0, 6))
	addStroke(tooltip)
	addPadding(tooltip, 9, 9, 6, 6)
	local tooltipLabel = createLabel({
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		TextSize = 12,
		FontFace = Fonts.Regular,
		TextWrapped = true,
		TextTruncate = Enum.TextTruncate.None,
		ZIndex = 101,
		Parent = tooltip,
	})
	create("UISizeConstraint", {
		MaxSize = Vector2.new(240, math.huge),
		Parent = tooltipLabel,
	})
	window._tooltip = tooltip
	window._tooltipLabel = tooltipLabel
	table.insert(window._frameSteps, function()
		if not tooltip.Visible then
			return
		end
		local point = getMousePosition() - screenGui.AbsolutePosition
		local screen = screenGui.AbsoluteSize
		local x = math.min(point.X + 14, screen.X - tooltip.AbsoluteSize.X - 8)
		local y = point.Y + 18
		if y + tooltip.AbsoluteSize.Y > screen.Y - 8 then
			y = point.Y - tooltip.AbsoluteSize.Y - 8
		end
		tooltip.Position = UDim2.fromOffset(math.max(x, 8), math.max(y, 8))
	end)

	window:_enableDrag()
	window.MaxSize = toVector2(options.MaxSize)
	window.KeepOnScreen = options.KeepOnScreen ~= false
	if options.Animations ~= nil then
		Nucleus.Animations = options.Animations == true
	end
	window._closeAction = (type(options.CloseAction) == "string" and string.lower(options.CloseAction) == "hide") and "Hide" or "Unload"
	window._confirmClose = options.ConfirmClose ~= false
	local miniOptions = options.MinimizedBar
	if miniOptions == nil then
		miniOptions = options.MiniBar
	end
	if type(miniOptions) == "string" or type(miniOptions) == "function" then
		miniOptions = { Text = miniOptions }
	end
	window._miniOptions = type(miniOptions) == "table" and miniOptions or {}
	window._miniText = window._miniOptions.Text
	window:_enableResize(toVector2(options.MinSize) or Const.DEFAULT_MIN_SIZE)
	if options.Resizable == false then
		window._grip.Visible = false
	end

	local saving = options.ConfigurationSaving
	if type(saving) == "table" and saving.Enabled ~= false then
		window.ConfigFolder = saving.FolderName or Const.GUI_NAME
		if not saving.FolderName and type(isfolder) == "function" then
			local okNew, hasNew = pcall(isfolder, Const.GUI_NAME)
			local okOld, hasOld = pcall(isfolder, "NeoxHub")
			if okNew and okOld and not hasNew and hasOld then
				window.ConfigFolder = "NeoxHub"
			end
		end
		if saving.PerGame == true then
			local gameKey = (game.GameId and game.GameId ~= 0) and game.GameId or game.PlaceId
			window.ConfigFolder = window.ConfigFolder .. "/" .. tostring(gameKey)
		end
		window.ConfigName = saving.FileName or "default"
		window._autoSaveEnabled = saving.AutoSave == true
		window._autoLoad = saving.AutoLoad == true
	else
		window.ConfigFolder = Const.GUI_NAME
		window.ConfigName = "default"
		window._autoSaveEnabled = false
	end

	table.insert(window._connections, UserInputService.InputBegan:Connect(function(inputObject, gameProcessed)
		if gameProcessed then
			return
		end
		if inputObject.KeyCode == Enum.KeyCode.Escape and window._dialog and window._dialog.Dismissable then
			window._dialog.Cancel()
			return
		end
		if inputObject.UserInputType == Enum.UserInputType.Keyboard and inputObject.KeyCode == window.Keybind then

			task.defer(function()
				local consumed = window._consumedKey == inputObject.KeyCode
					and os.clock() - (window._consumedAt or 0) < 0.2
				window._consumedKey = nil
				if not consumed and not window._destroyed then
					window:Toggle(not window.Open)
				end
			end)
		end
	end))

	pcall(function()
		if typeof(syn) == "table" and typeof(syn.protect_gui) == "function" then
			syn.protect_gui(screenGui)
		end
	end)
	screenGui.Parent = options.Parent or getGuiParent()

	window.Scale.Scale = 0.9
	window:_setFade(0)
	window.Shadow.ImageTransparency = 1
	window.BodyStroke.Transparency = 1
	root.Visible = false
	window:_fitToScreen(true)

	table.insert(window._connections, screenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		window:_fitToScreen()
		window:_clampToScreen()
	end))

	local wantsOpenButton = options.OpenButton
	if (wantsOpenButton ~= nil and wantsOpenButton ~= false) or (wantsOpenButton == nil and IS_TOUCH) then
		window:_createOpenButton(type(wantsOpenButton) == "table" and wantsOpenButton or {})
	end

	window._introDone = false
	table.insert(Nucleus.Windows, window)

	window:_setupPremium(options)
	window:_setupDonations()
	if options.RememberTab == true then
		local key = tostring(options.Title or "window"):gsub("[^%w]", "")
		window._rememberKey = "tab_" .. (key ~= "" and key or "window")
		task.delay(0.6, function()
			if not window._destroyed then
				window:_restoreTab()
			end
		end)
	end
	if options.Home ~= false then
		window:_buildHome(type(options.Home) == "table" and options.Home or {}, options.Membership)
	end

	if type(options.User) == "table" and options.User.Anonymous then
		window:SetAnonymous(true)
	end
	if options.Background then
		window:SetBackground(options.Background, options.BackgroundTransparency)
	end

	local loading = options.Loading
	if type(loading) == "table" then
		options.LoadingDuration = loading.Duration or options.LoadingDuration
		options.LoadingText = loading.Text or loading.Subtitle or options.LoadingText
		options.LoadingSteps = loading.Steps or options.LoadingSteps
		options.LoadingTitle = loading.Title or options.LoadingTitle
		loading = loading.Enabled ~= false
	end

	if loading == false then
		task.defer(function()
			if not window._destroyed then
				window:_playIntro()
			end
		end)
	else
		window:_showLoader(options)
	end

	return window
end
Nucleus.CreateWindow = Nucleus.Window

local function remapProperty(instance, property, colorMap)
	local replacement = colorMap[instance[property]:ToHex()]
	if replacement then
		instance[property] = replacement
	end
end

local function remapGradient(gradient, colorMap)
	local changed = false
	local keypoints = {}
	for index, keypoint in ipairs(gradient.Color.Keypoints) do
		local replacement = colorMap[keypoint.Value:ToHex()]
		if replacement then
			changed = true
		end
		keypoints[index] = ColorSequenceKeypoint.new(keypoint.Time, replacement or keypoint.Value)
	end
	if changed then
		gradient.Color = ColorSequence.new(keypoints)
	end
end

local function isThemeExempt(instance)
	if instance:GetAttribute(Const.ATTR_NO_THEME) then
		return true
	end

	local parent = instance.Parent
	return parent ~= nil
		and (instance:IsA("UIStroke") or instance:IsA("UIGradient"))
		and parent:GetAttribute(Const.ATTR_NO_THEME) == true
end

local function recolorInstance(instance, colorMap)
	if isThemeExempt(instance) then
		return
	end
	if instance:IsA("GuiObject") then
		remapProperty(instance, "BackgroundColor3", colorMap)
	end
	if instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox") then
		remapProperty(instance, "TextColor3", colorMap)
	end
	if instance:IsA("TextBox") then
		remapProperty(instance, "PlaceholderColor3", colorMap)
	end
	if instance:IsA("ImageLabel") or instance:IsA("ImageButton") then
		remapProperty(instance, "ImageColor3", colorMap)
	end
	if instance:IsA("ScrollingFrame") then
		remapProperty(instance, "ScrollBarImageColor3", colorMap)
	end
	if instance:IsA("UIStroke") then
		remapProperty(instance, "Color", colorMap)
	elseif instance:IsA("UIGradient") then
		remapGradient(instance, colorMap)
	end
end

local function recolorAllWindows(colorMap)
	for _, window in ipairs(Nucleus.Windows) do
		if window.Gui and window.Gui.Parent then
			for _, descendant in ipairs(window.Gui:GetDescendants()) do
				recolorInstance(descendant, colorMap)
			end
		end
	end
end

Const.THEME_ALIASES = {
	Mono = "Default",
	Dark = "Default",
	White = "Light",
	Black = "Obsidian",
}

local function resolveTheme(themeInput)
	if type(themeInput) == "string" then
		themeInput = Const.THEME_ALIASES[themeInput] or themeInput
		local preset = Nucleus.Themes[themeInput]
		if not preset then
			log("unknown theme: " .. themeInput)
			return nil
		end
		return table.clone(preset), themeInput
	elseif type(themeInput) == "table" then
		local baseName = themeInput.Base or "Default"
		local base = Nucleus.Themes[Const.THEME_ALIASES[baseName] or baseName] or Nucleus.Themes.Default
		local theme = table.clone(base)
		for _, key in ipairs(THEME_KEYS) do
			if typeof(themeInput[key]) == "Color3" then
				theme[key] = themeInput[key]
			end
		end
		return theme, themeInput.Name or "Custom"
	end
	log("SetTheme expects a theme name or a table of colours")
	return nil
end

function Nucleus:SetAccent(color)
	if color ~= nil and typeof(color) ~= "Color3" then
		log("SetAccent needs a Color3, like Color3.fromRGB(120, 200, 255), or nil to use the theme's own accent")
		return false
	end
	Nucleus._accent = color
	return Nucleus:SetTheme(Nucleus._themeInput or Nucleus.ThemeName)
end

function Nucleus:GetAccent()
	return Theme.Accent
end

function Nucleus:GetThemes()
	local names = {}
	for name in pairs(Nucleus.Themes) do
		if name ~= "Default" then
			table.insert(names, name)
		end
	end
	table.sort(names)
	table.insert(names, 1, "Default")
	return names
end

function Nucleus:AddTheme(name, colors)
	assert(type(name) == "string" and name ~= "", "AddTheme needs a name")
	local theme = resolveTheme(colors)
	if theme then
		Nucleus.Themes[name] = theme
	end
	return theme ~= nil
end

local themeGeneration = 0

local function accentContrast(color)
	local luminance = 0.299 * color.R + 0.587 * color.G + 0.114 * color.B
	if luminance > 0.55 then
		return Color3.fromRGB(17, 17, 19)
	end
	return Color3.fromRGB(251, 251, 252)
end

function Nucleus:SetTheme(themeInput)
	local newTheme, newName = resolveTheme(themeInput)
	if not newTheme then
		return false
	end
	Nucleus._themeInput = themeInput
	local accent = Nucleus._accent
	if accent then
		newTheme.Accent = accent
		newTheme.AccentDark = accentContrast(accent)
	end

	local colorMap = {}
	local newHexes = {}
	for _, key in ipairs(THEME_KEYS) do
		newHexes[newTheme[key]:ToHex()] = true
	end
	for _, key in ipairs(THEME_KEYS) do
		local oldColor, newColor = Theme[key], newTheme[key]
		local oldHex = oldColor:ToHex()
		if oldColor ~= newColor and colorMap[oldHex] == nil then
			colorMap[oldHex] = newColor
		end
	end

	for _, key in ipairs(THEME_KEYS) do
		Theme[key] = newTheme[key]
	end
	Nucleus.ThemeName = newName

	recolorAllWindows(colorMap)
	for _, listener in ipairs(Nucleus._themeListeners) do
		safeCall(listener)
	end

	themeGeneration += 1
	local generation = themeGeneration
	local lateMap = {}
	for oldHex, newColor in pairs(colorMap) do
		if not newHexes[oldHex] then
			lateMap[oldHex] = newColor
		end
	end
	task.delay(0.6, function()
		if generation == themeGeneration then
			recolorAllWindows(lateMap)
		end
	end)

	return true
end

local function latestWindow()
	return Nucleus.Windows[#Nucleus.Windows]
end

function Nucleus:Notify(input)
	local window = latestWindow()
	if window then
		return window:Notify(input)
	end
	return Nucleus:_notifyFallback(input)
end

function Nucleus:Confirm(input)
	local window = latestWindow()
	return window and window:Confirm(input) or nil
end

function Nucleus:Prompt(input)
	local window = latestWindow()
	return window and window:Prompt(input) or nil
end

function Nucleus:Dialog(input)
	local window = latestWindow()
	return window and window:Dialog(input) or nil
end

function Nucleus:GetFlag(flag)
	return Nucleus.Flags[flag]
end

function Nucleus:GetValue(flag)
	local element = Nucleus.Flags[flag]
	if element and type(element.Get) == "function" then
		return element:Get()
	end
	return nil
end

function Nucleus:SetValue(flag, value, silent)
	local element = Nucleus.Flags[flag]
	if element and type(element.Set) == "function" then
		element:Set(value, silent)
		return true
	end
	return false
end

function Nucleus:Copy(text, silent)
	text = tostring(text or "")
	local copyFn = setclipboard
		or toclipboard
		or (syn and syn.write_clipboard)
		or (Clipboard and Clipboard.set)
	if type(copyFn) ~= "function" then
		Nucleus:Notify({ Title = "Copy unavailable", Content = "Your executor has no clipboard support.", Type = "Error", Duration = 3 })
		return false
	end
	local ok = pcall(copyFn, text)
	if silent and ok then
		return true
	end
	local preview = #text > 60 and (text:sub(1, 57) .. "...") or text
	Nucleus:Notify({
		Title = ok and "Copied to clipboard" or "Copy failed",
		Content = preview ~= "" and preview or nil,
		Type = ok and "Success" or "Error",
		Duration = 2.5,
	})
	return ok
end

function Nucleus:Destroy()
	for index = #Nucleus.Windows, 1, -1 do
		Nucleus.Windows[index]:Destroy()
	end
	local cleanup = Nucleus._cleanup
	Nucleus._cleanup = {}
	for _, callback in ipairs(cleanup) do
		task.spawn(safeCall, callback)
	end
end
Nucleus.Unload = Nucleus.Destroy

local function isVisiblyAt(guiObject, stopAt, point)
	local current = guiObject
	while current and current ~= stopAt and current:IsA("GuiObject") do
		if not current.Visible then
			return false
		end
		local parent = current.Parent
		if parent and parent ~= stopAt and parent:IsA("GuiObject")
			and (parent.ClipsDescendants or parent:IsA("ScrollingFrame"))
			and not pointInside(point, parent)
		then
			return false
		end
		current = parent
	end
	return true
end

function Window:_refreshControls()
	local controls = {}
	for _, descendant in ipairs(self.Body:GetDescendants()) do
		if descendant:IsA("GuiButton") or descendant:IsA("TextBox") or descendant:GetAttribute(Const.ATTR_NO_DRAG) then
			table.insert(controls, descendant)
		end
	end
	self._controls = controls
	self._controlsDirty = false
end

function Window:_overControl(point)
	if self._dialog then
		return true
	end
	if self._controlsDirty then
		self:_refreshControls()
	end
	for _, control in ipairs(self._controls) do
		if control.Parent and pointInside(point, control) and isVisiblyAt(control, self.Body, point) then
			return true
		end
	end
	return false
end

function Window:_overOverlay(point)
	if self._grip and pointInside(point, self._grip) then
		return true
	end
	for _, overlay in ipairs(self._overlays) do
		if overlay.Parent and overlay.Visible and pointInside(point, overlay) then
			return true
		end
	end
	if self.OpenButton and self.OpenButton.Visible and pointInside(point, self.OpenButton) then
		return true
	end
	for _, toast in ipairs(self.NotifyHolder:GetChildren()) do
		if toast:IsA("GuiObject") and pointInside(point, toast) then
			return true
		end
	end
	return false
end

function Window:_enableDrag()
	local dragging = false
	local grabOffset = Vector2.zero

	local function rootCenter()
		local root = self.Root
		return root.AbsolutePosition + root.AbsoluteSize * root.AnchorPoint - self.Gui.AbsolutePosition
	end

	table.insert(self._connections, UserInputService.InputBegan:Connect(function(inputObject)
		if not isPress(inputObject) or not self.Open or not self.Root.Visible then
			return
		end
		local point = getMousePosition()
		if not pointInside(point, self.Body) or self:_overControl(point) or self:_overOverlay(point) then
			return
		end
		dragging = true
		grabOffset = point - rootCenter()
	end))

	table.insert(self._connections, UserInputService.InputEnded:Connect(function(inputObject)
		if dragging and isPress(inputObject) then
			dragging = false
			self:_clampToScreen()
		end
	end))

	table.insert(self._frameSteps, function(deltaTime)
		if not dragging then
			return
		end
		local target = getMousePosition() - grabOffset
		local alpha = 1 - math.exp(-deltaTime * 45)
		local position = rootCenter():Lerp(target, alpha)
		self.Root.Position = UDim2.fromOffset(position.X, position.Y)
		self._userMoved = true
	end)
end

function Window:_restPosition()
	return self._restCenter or UDim2.fromScale(0.5, 0.5)
end

local function revealElement(guiObject, delay, force)
	if not guiObject.Visible and not force then
		return
	end
	guiObject.Visible = false
	task.delay(delay, function()
		if not guiObject.Parent or guiObject:GetAttribute(Const.ATTR_HIDDEN) then
			return
		end
		local scale = create("UIScale", { Scale = 0.94, Parent = guiObject })
		guiObject.Visible = true
		tween(scale, { Scale = 1 }, 0.4, Enum.EasingStyle.Back)
		task.delay(0.4, function()
			scale:Destroy()
		end)
	end)
end

function Window:_revealCards(tab, delay)
	if tab._revealed then
		return
	end
	tab._revealed = true
	if instantUI() then
		return
	end
	local index = 0
	for _, child in ipairs(tab.List:GetChildren()) do
		if child:IsA("GuiObject") then
			revealElement(child, (delay or 0) + index * 0.035)
			index += 1
		end
	end
end

function Window:_playIntro(fromLoader)
	if self._introDone or self._destroyed then
		return
	end
	self._introDone = true
	if self._autoLoad and not self._autoLoaded then
		self._autoLoaded = true
		self:LoadConfig(self.ConfigName)
	end
	task.delay(1, function()
		self._autoSaveReady = true
	end)

	local root, shadow, scale = self.Root, self.Shadow, self.Scale

	if self.CurrentTab then
		self:_revealCards(self.CurrentTab, fromLoader and 0.15 or 0.25)
	end

	root.Visible = true
	if fromLoader then

		scale.Scale = self._fitScale or 1
		root.Position = self:_restPosition()
		self:_fadeIn(0.3)
		tween(self.BodyStroke, { Transparency = 0 }, 0.3)
		tween(shadow, { ImageTransparency = 0.6 }, 0.3)
	else
		root.Position = self:_restPosition() + UDim2.fromOffset(0, 24)
		tween(scale, { Scale = self._fitScale or 1 }, 0.5, Enum.EasingStyle.Back)
		tween(root, { Position = self:_restPosition() }, 0.5, Enum.EasingStyle.Quint)
		self:_fadeIn(0.35)
		tween(self.BodyStroke, { Transparency = 0 }, 0.35)
		tween(shadow, { ImageTransparency = 0.6 }, 0.5)
	end

	if instantUI() then
		for _, tab in ipairs(self.Tabs) do
			tab._button.Visible = tab._button:GetAttribute(Const.ATTR_HIDDEN) ~= true
		end
	else
		for index, tab in ipairs(self.Tabs) do
			revealElement(tab._button, 0.1 + index * 0.05, true)
		end
	end

	if self.CurrentTab then
		self:_placeIndicator(self.CurrentTab)
	end
end

function Window:_showLoader(options)
	local duration = options.LoadingDuration or 1.6

	local card = create("CanvasGroup", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 16),
		Size = UDim2.fromOffset(300, 132),
		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,
		GroupTransparency = 1,
		ZIndex = 10,
		Parent = self.Gui,
	})
	local corner = addCorner(card, UDim.new(0, 12))
	local cardStroke = addStroke(card, Theme.Stroke, 1)
	addTopHighlight(card)

	local cardScale = create("UIScale", { Scale = 0.92, Parent = card })

	local shadow = create("ImageLabel", {
		Position = UDim2.fromOffset(-25, -25),
		Size = UDim2.new(1, 50, 1, 50),
		BackgroundTransparency = 1,
		Image = Assets.Shadow,
		ImageColor3 = Color3.new(0, 0, 0),
		ImageTransparency = 1,
		ScaleType = Enum.ScaleType.Slice,
		SliceCenter = Rect.new(49, 49, 450, 450),
		ZIndex = 0,
		Parent = card,
	})

	local logoHolder = create("Frame", {
		Position = UDim2.fromOffset(22, 24),
		Size = UDim2.fromOffset(48, 48),
		BackgroundTransparency = 1,
		Parent = card,
	})
	local logo = create("ImageLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.5, 0.5),
		Rotation = -14,
		BackgroundTransparency = 1,
		ImageColor3 = logoColor(options.Icon),
		ImageTransparency = 1,
		ScaleType = Enum.ScaleType.Fit,
		Parent = logoHolder,
	})
	setLogo(logo, options.Icon)
	task.delay(0.15, function()
		tween(logo, { Size = UDim2.fromScale(0.85, 0.85), Rotation = 0 }, 0.6, Enum.EasingStyle.Back)
		tween(logo, { ImageTransparency = 0 }, 0.4)
	end)

	createLabel({
		Position = UDim2.fromOffset(84, 30),
		Size = UDim2.new(1, -104, 0, 22),
		Text = options.LoadingTitle or options.Title or Const.LIB_NAME,
		TextSize = 20,
		Parent = card,
	})
	local statusLabel = createLabel({
		Position = UDim2.fromOffset(84, 52),
		Size = UDim2.new(1, -104, 0, 16),
		Text = options.LoadingText or options.Subtitle or "Loading",
		TextSize = 13,
		FontFace = Fonts.Regular,
		TextColor3 = Theme.Muted,
		Parent = card,
	})

	local barTrack = create("Frame", {
		Position = UDim2.new(0, 24, 1, -30),
		Size = UDim2.new(1, -48, 0, 4),
		BackgroundColor3 = Theme.Surface3,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = card,
	})
	addCorner(barTrack, UDim.new(1, 0))
	local barFill = create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Parent = barTrack,
	})
	addCorner(barFill, UDim.new(1, 0))
	local shimmer = create("Frame", {
		Position = UDim2.fromScale(-0.4, 0),
		Size = UDim2.fromScale(0.4, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = barTrack,
	})
	create("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = shimmer,
	})

	tween(card, { GroupTransparency = 0, Position = UDim2.fromScale(0.5, 0.5) }, 0.4, Enum.EasingStyle.Quint)
	tween(cardScale, { Scale = 1 }, 0.5, Enum.EasingStyle.Back)
	tween(shadow, { ImageTransparency = 0.6 }, 0.4)

	local shimmerTween = TweenService:Create(shimmer,
		TweenInfo.new(1.1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1),
		{ Position = UDim2.fromScale(1, 0) })
	shimmerTween:Play()

	tween(barFill, { Size = UDim2.fromScale(0.85, 1) }, duration * 0.8, Enum.EasingStyle.Quart)
	task.spawn(getIconPack)

	local steps = options.LoadingSteps or { "Preparing interface", "Loading icons", "Almost there" }
	for index, text in ipairs(steps) do
		task.delay(duration * (index - 1) / #steps, function()
			if card.Parent then
				statusLabel.Text = text
			end
		end)
	end

	task.delay(duration, function()
		if self._destroyed or not card.Parent then
			shimmerTween:Cancel()
			return
		end
		tween(barFill, { Size = UDim2.fromScale(1, 1) }, 0.25, Enum.EasingStyle.Quint)

		task.delay(0.25, function()
			shimmerTween:Cancel()
			if self._destroyed or not card.Parent then
				return
			end

			for _, child in ipairs(card:GetChildren()) do
				if child:IsA("TextLabel") then
					tween(child, { TextTransparency = 1 }, 0.15)
				end
			end
			tween(logo, { ImageTransparency = 1 }, 0.15)
			tween(barTrack, { BackgroundTransparency = 1 }, 0.15)
			tween(barFill, { BackgroundTransparency = 1 }, 0.15)
			tween(shimmer, { BackgroundTransparency = 1 }, 0.1)

			local fitScale = self._fitScale or 1
			local windowSize = self.Root.Size
			tween(card, {
				Size = UDim2.fromOffset(windowSize.X.Offset * fitScale, windowSize.Y.Offset * fitScale),
				Position = self:_restPosition(),
			}, 0.5, Enum.EasingStyle.Quint)
			tween(corner, { CornerRadius = UDim.new(0, 10) }, 0.5, Enum.EasingStyle.Quint)
			tween(cardScale, { Scale = 1 }, 0.5, Enum.EasingStyle.Quint)

			task.delay(0.28, function()
				if self._destroyed then
					return
				end
				self:_playIntro(true)
				tween(card, { GroupTransparency = 1 }, 0.25)
				tween(cardStroke, { Transparency = 1 }, 0.2)
				tween(shadow, { ImageTransparency = 1 }, 0.2)
			end)
			task.delay(0.6, function()
				card:Destroy()
			end)
		end)
	end)
end

function Window:_fitToScreen(instant)
	local screen = self.Gui.AbsoluteSize
	if screen.X == 0 or screen.Y == 0 then
		return
	end
	local base = self._baseSize or Vector2.new(self.Root.Size.X.Offset, self.Root.Size.Y.Offset)
	local userScale = self._userScale or 1
	local width, height

	if IS_TOUCH then
		local large = math.min(screen.X, screen.Y) >= 700
		local portrait = screen.Y > screen.X
		local topbar = math.clamp(getTopbarHeight(), 0, screen.Y * 0.25)
		local usableY = screen.Y - topbar
		local fit
		if self._userResized then
			width = math.floor(base.X)
			height = math.floor(base.Y)
			fit = self._lockedFit or self._fitScale or 1
		else
			width = math.floor(large and base.X or math.min(base.X, Const.PHONE_LAYOUT.X))
			height = math.floor(large and base.Y or math.min(base.Y, Const.PHONE_LAYOUT.Y))
			local maxX = screen.X * (portrait and Const.PHONE_FIT.PortraitX or (large and Const.PHONE_FIT.TabletX or Const.PHONE_FIT.LandscapeX))
			local maxY = usableY * (portrait and Const.PHONE_FIT.PortraitY or Const.PHONE_FIT.LandscapeY)
			fit = math.min(maxX / width, maxY / height, 1) * userScale
		end
		fit = math.min(fit, (screen.X - 16) / width, (usableY - 16) / height)
		self._fitScale = math.max(fit, 0.45)
		self._restCenter = UDim2.new(0.5, 0, 0.5, math.floor(topbar / 2))
		if self._introDone and not self._userMoved and self.Root.Position ~= self._restCenter then
			self.Root.Position = self._restCenter
		end
	else
		local margin = 24
		local availX, availY = screen.X - margin * 2, screen.Y - margin * 2
		width = math.min(base.X, availX / userScale)
		height = math.min(base.Y, availY / userScale)
		width = math.floor(math.max(width, math.min(Const.COMPACT_MIN.X, base.X)))
		height = math.floor(math.max(height, math.min(Const.COMPACT_MIN.Y, base.Y)))
		local fit = math.min(availX / width, availY / height)
		self._fitScale = math.max(math.min(userScale, fit), 0.5)
		local root = self.Root
		local centered = root.AnchorPoint.X == 0.5 and root.Position.X.Scale == 0.5
		if centered then
			width -= (math.floor(screen.X) - width) % 2
			height -= (math.floor(screen.Y) - height) % 2
		else
			width -= width % 2
			height -= height % 2
		end
	end

	local current = self.Root.Size
	if current.X.Offset ~= width or current.Y.Offset ~= height then
		self.Root.Size = UDim2.fromOffset(width, height)
	end
	self._autoCompact = width < (IS_TOUCH and Const.PHONE_LAYOUT.X or Const.COMPACT_WIDTH)
	self:_setCompact(self._autoCompact or self._sidebarCollapsed == true)

	if self._introDone and self.Open then
		if instant then
			self.Scale.Scale = self._fitScale
		else
			tween(self.Scale, { Scale = self._fitScale }, 0.2)
		end
	end
end

Const.SIDEBAR_TWEEN = 0.3

function Window:_layoutTabButton(tab, animated, keepText)
	local compact = self._compact == true
	tab._button.Size = UDim2.new(1, 0, 0, Const.TAB_HEIGHT)
	if tab._icon then
		local half = math.floor(tab._icon.Size.X.Offset / 2)
		local goal = compact and UDim2.new(0.5, -half, 0.5, 0) or UDim2.new(0, 12, 0.5, 0)
		tab._icon.AnchorPoint = Vector2.new(0, 0.5)
		if animated then
			tween(tab._icon, { Position = goal }, Const.SIDEBAR_TWEEN, Enum.EasingStyle.Quint)
		else
			tab._icon.Position = goal
		end
	end
	if keepText then
		return
	end
	tab._label.Visible = not compact
	if tab._initial then
		tab._initial.Visible = compact and not tab._icon
	end
	if tab._badge then
		tab._badge.Visible = not compact and tab._badgeText ~= nil
		tab:_fitBadge()
	end
	if tab._lockIcon then
		tab._lockIcon.Visible = tab._locked == true and not compact
	end
end

function Window:_fadeItem(item, show, generation)
	if not item then
		return
	end
	self._fadeBase = self._fadeBase or setmetatable({}, { __mode = "k" })
	local base = self._fadeBase
	local targets = {}
	local function add(object, property)
		local saved = base[object]
		local value = saved and saved[property]
		if value == nil then
			value = object[property]
			if type(value) ~= "number" or value >= 1 then
				return
			end
			saved = saved or {}
			saved[property] = value
			base[object] = saved
		end
		table.insert(targets, { object, property, value })
	end
	local function scan(object)
		if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
			add(object, "TextTransparency")
		elseif object:IsA("ImageLabel") or object:IsA("ImageButton") then
			add(object, "ImageTransparency")
		end
		if object:IsA("UIStroke") then
			add(object, "Transparency")
		elseif object:IsA("GuiObject") then
			add(object, "BackgroundTransparency")
		end
	end
	scan(item)
	for _, descendant in ipairs(item:GetDescendants()) do
		scan(descendant)
	end
	if show then
		item.Visible = true
		for _, target in ipairs(targets) do
			target[1][target[2]] = 1
		end
		task.delay(0.08, function()
			if self._compactGeneration ~= generation or self._destroyed then
				return
			end
			for _, target in ipairs(targets) do
				tween(target[1], { [target[2]] = target[3] }, 0.22)
			end
		end)
	else
		for _, target in ipairs(targets) do
			tween(target[1], { [target[2]] = 1 }, 0.12)
		end
	end
end

function Window:_restoreFades()
	for object, saved in pairs(self._fadeBase or {}) do
		for property, value in pairs(saved) do
			object[property] = value
		end
	end
	self._fadeBase = nil
end

function Window:_sidebarTextItems(compact)
	local items = { self._titleLabel, self._subtitleLabel, self._profileName, self._hintLabel }
	if not IS_TOUCH then
		table.insert(items, self._keyChip)
	end
	if self._searchFrame then
		table.insert(items, self._searchFrame)
	end
	for _, tab in ipairs(self.Tabs) do
		table.insert(items, tab._label)
		if tab._badge and tab._badgeText ~= nil then
			table.insert(items, tab._badge)
		end
		if tab._lockIcon and tab._locked then
			table.insert(items, tab._lockIcon)
		end
	end
	return items
end

function Window:_setCompact(compact, animated)
	compact = compact == true
	if self._compact == compact then
		return
	end
	self._compact = compact
	animated = animated == true and not instantUI()
	self._compactGeneration = (self._compactGeneration or 0) + 1
	local generation = self._compactGeneration
	if self._sidebarIcon then
		local rotation = compact and 180 or 0
		if animated then
			tween(self._sidebarIcon, { Rotation = rotation }, Const.SIDEBAR_TWEEN, Enum.EasingStyle.Quint)
		else
			self._sidebarIcon.Rotation = rotation
		end
	end

	local width = compact and Const.COMPACT_SIDEBAR or self._sidebarWidth
	local sidebarSize = UDim2.new(0, width - 8, 1, -16)
	local contentPosition = UDim2.fromOffset(width + 2, 0)
	local contentSize = UDim2.new(1, -(width + 2), 1, 0)
	local top = compact and 66 or self._listTop
	local listPosition = UDim2.fromOffset(0, top)
	local listSize = UDim2.new(1, 0, 1, -(top + (self._listBottom or 66)))
	local logoHalf = math.floor(self._logo.Size.X.Offset / 2)
	local avatarHalf = math.floor(self._avatar.Size.X.Offset / 2)
	local logoPosition = compact and UDim2.new(0.5, -logoHalf, 0, 15) or UDim2.fromOffset(12, 15)
	local avatarPosition = compact and UDim2.new(0.5, -avatarHalf, 0.5, 0) or UDim2.new(0, 8, 0.5, 0)
	self._logo.AnchorPoint = Vector2.zero
	self._avatar.AnchorPoint = Vector2.new(0, 0.5)

	local function placeLists(list)
		list.Position = listPosition
		list.Size = listSize
	end

	local function finish()
		if self._compactGeneration ~= generation or self._destroyed then
			return
		end
		self._sidebar.ClipsDescendants = false
		self._sidebar.Size = sidebarSize
		self.Content.Position = contentPosition
		self.Content.Size = contentSize
		self._logo.Position = logoPosition
		self._avatar.Position = avatarPosition
		placeLists(self.TabList)
		if self._searchResults then
			placeLists(self._searchResults)
		end
		self._titleLabel.Visible = not compact
		self._subtitleLabel.Visible = not compact
		if self._searchFrame then
			self._searchFrame.Visible = not compact
		end
		self._profileName.Visible = not compact
		self._keyChip.Visible = not compact and not IS_TOUCH
		self._hintLabel.Visible = not compact
		if self._enforceParts then
			self:_enforceParts()
		end
		for _, tab in ipairs(self.Tabs) do
			self:_layoutTabButton(tab)
		end
		for _, section in ipairs(self._sections or {}) do
			section:_applyCompact(compact)
			if section._header then
				section._header.Size = UDim2.new(1, 0, 0, 38)
				section._header.ClipsDescendants = false
			end
		end
		self:_restoreFades()
		local current = self.CurrentTab
		if current and self._introDone and current._button.Visible then
			self:_placeIndicator(current)
		end
	end

	if compact and self._searchFrame and self._searchBox.Text ~= "" then
		self._searchBox.Text = ""
	end

	if not animated then
		finish()
		return
	end

	local ease = Enum.EasingStyle.Quint
	local duration = Const.SIDEBAR_TWEEN
	self._sidebar.ClipsDescendants = true
	tween(self._sidebar, { Size = sidebarSize }, duration, ease)
	tween(self.Content, { Position = contentPosition, Size = contentSize }, duration, ease)
	tween(self._logo, { Position = logoPosition }, duration, ease)
	tween(self._avatar, { Position = avatarPosition }, duration, ease)
	tween(self.TabList, { Position = listPosition, Size = listSize }, duration, ease)
	if self._searchResults then
		placeLists(self._searchResults)
	end

	if compact then
		for _, item in ipairs(self:_sidebarTextItems()) do
			if item.Visible then
				self:_fadeItem(item, false, generation)
			end
		end
		for _, tab in ipairs(self.Tabs) do
			self:_layoutTabButton(tab, true, true)
		end
		for _, section in ipairs(self._sections or {}) do
			if section._header and section._header.Visible then
				section._header.ClipsDescendants = true
				self:_fadeItem(section._header, false, generation)
				tween(section._header, { Size = UDim2.new(1, 0, 0, 0) }, duration, ease)
			end
		end
	else
		self._titleLabel.Visible = true
		self._subtitleLabel.Visible = true
		self._profileName.Visible = true
		self._hintLabel.Visible = true
		self._keyChip.Visible = not IS_TOUCH
		if self._searchFrame then
			self._searchFrame.Visible = true
		end
		if self._enforceParts then
			self:_enforceParts()
		end
		for _, tab in ipairs(self.Tabs) do
			self:_layoutTabButton(tab, true)
		end
		for _, item in ipairs(self:_sidebarTextItems()) do
			if item.Visible then
				self:_fadeItem(item, true, generation)
			end
		end
		for _, section in ipairs(self._sections or {}) do
			section:_applyCompact(false)
			local header = section._header
			if header then
				header.ClipsDescendants = true
				header.Size = UDim2.new(1, 0, 0, 0)
				self:_fadeItem(header, true, generation)
				tween(header, { Size = UDim2.new(1, 0, 0, 38) }, duration, ease)
			end
		end
	end
	task.delay(duration + 0.04, finish)
end

function Window:_clampToScreen()
	if not self.KeepOnScreen then
		return
	end
	local screen = self.Gui.AbsoluteSize
	local root = self.Root
	local half = root.AbsoluteSize / 2
	local center = root.AbsolutePosition + half - self.Gui.AbsolutePosition
	local clamped = Vector2.new(
		math.clamp(center.X, math.min(half.X, screen.X / 2), math.max(screen.X - half.X, screen.X / 2)),
		math.clamp(center.Y, math.min(half.Y, screen.Y / 2), math.max(screen.Y - half.Y, screen.Y / 2))
	)
	if (clamped - center).Magnitude > 0.5 then
		tween(root, { Position = UDim2.fromOffset(math.floor(clamped.X + 0.5), math.floor(clamped.Y + 0.5)) }, 0.25, Enum.EasingStyle.Quint)
	end
end

function Window:_createOpenButton(buttonOptions)
	local screenGui = self.Gui
	local pill = create("TextButton", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.fromOffset(0, 34),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 30,
		Parent = screenGui,
	})
	addCorner(pill, UDim.new(1, 0))
	addStroke(pill, Theme.Stroke)
	addPadding(pill, 12, 16)

	local icon = create("ImageLabel", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(22, 22),
		BackgroundTransparency = 1,
		ImageColor3 = logoColor(buttonOptions.Icon),
		ScaleType = Enum.ScaleType.Fit,
		ZIndex = 31,
		Parent = pill,
	})
	setLogo(icon, buttonOptions.Icon)

	local pillLabel = createLabel({
		Position = UDim2.fromOffset(30, 0),
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = buttonOptions.Title or Const.LIB_NAME,
		TextSize = 13,
		TextTruncate = Enum.TextTruncate.None,
		ZIndex = 31,
		Parent = pill,
	})
	self.OpenButton = pill

	local autoPosition
	local function placePill()
		if autoPosition and pill.Position ~= autoPosition then
			return
		end
		local inset = getTopbarInset()
		if inset and inset.Min.X > 0 and inset.Height >= 30 then
			local tall = inset.Height >= 50
			local height = tall and 44 or 32
			local centerY = tall and (inset.Max.Y - 24) or (inset.Min.Y + inset.Height / 2)
			pill.AnchorPoint = Vector2.new(0, 0.5)
			pill.Size = UDim2.fromOffset(0, height)
			icon.Size = UDim2.fromOffset(tall and 26 or 22, tall and 26 or 22)
			pillLabel.Position = UDim2.fromOffset(tall and 34 or 30, 0)
			pillLabel.TextSize = math.floor((tall and 15 or 13) * Nucleus.TextScale + 0.5)
			autoPosition = UDim2.fromOffset(inset.Min.X + 10, centerY)
		else
			pill.AnchorPoint = Vector2.new(0.5, 0)
			autoPosition = UDim2.new(0.5, 0, 0, 6)
		end
		pill.Position = autoPosition
	end
	placePill()
	pcall(function()
		table.insert(self._connections, GuiService:GetPropertyChangedSignal("TopbarInset"):Connect(placePill))
	end)

	self:_makeDraggable(pill, function()
		self:Toggle()
	end)
	table.insert(self._overlays, pill)
end

function Window:_makeDraggable(target, onTap)
	local screenGui = self.Gui
	local pressing, moved = false, false
	local grabOffset, pressPoint = Vector2.zero, Vector2.zero

	target.InputBegan:Connect(function(inputObject)
		if isPress(inputObject) then
			pressing, moved = true, false
			pressPoint = getMousePosition()
			grabOffset = pressPoint - target.AbsolutePosition
		end
	end)

	table.insert(self._connections, UserInputService.InputChanged:Connect(function(inputObject)
		if not pressing or not isMove(inputObject) then
			return
		end
		local point = getMousePosition()
		if (point - pressPoint).Magnitude > 4 then
			moved = true
		end
		if not moved then
			return
		end
		local position = point - grabOffset - screenGui.AbsolutePosition
		target.AnchorPoint = Vector2.new(0, 0)
		target.Position = UDim2.fromOffset(
			math.floor(math.clamp(position.X, 0, math.max(screenGui.AbsoluteSize.X - target.AbsoluteSize.X, 0)) + 0.5),
			math.floor(math.clamp(position.Y, 0, math.max(screenGui.AbsoluteSize.Y - target.AbsoluteSize.Y, 0)) + 0.5)
		)
	end))

	table.insert(self._connections, UserInputService.InputEnded:Connect(function(inputObject)
		if pressing and isPress(inputObject) then
			pressing = false
			if not moved and onTap then
				onTap()
			end
		end
	end))
end

function Window:_enableResize(minSize)
	local maxSize = self.MaxSize or Vector2.new(math.huge, math.huge)
	if IS_TOUCH then
		minSize = Vector2.new(math.min(minSize.X, 360), math.min(minSize.Y, 240))
	end

	local grip = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, 4, 1, 4),
		Size = IS_TOUCH and UDim2.fromOffset(48, 48) or UDim2.fromOffset(32, 32),
		BackgroundTransparency = 1,
		Active = true,
		ZIndex = 20,
		Parent = self.Root,
	})
	self._grip = grip

	local gripImage = create("ImageLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, -16, 0.5, -16),
		Size = UDim2.fromOffset(96, 96),
		BackgroundTransparency = 1,
		Image = Assets.ResizeGrip,
		ImageColor3 = Theme.Accent,
		ImageTransparency = 0.8,
		ZIndex = 20,
		Parent = grip,
	})

	local resizing = false
	local startSize = self.Root.Size
	local startPoint = Vector2.zero
	local targetSize

	grip.InputBegan:Connect(function(inputObject)
		if isPress(inputObject) then
			resizing = true
			startSize = self.Root.Size
			startPoint = getMousePosition()
			tween(gripImage, { ImageTransparency = 0.35 }, 0.1)
		end
	end)
	grip.MouseEnter:Connect(function()
		if IS_TOUCH then
			return
		end
		if not resizing then
			tween(gripImage, { ImageTransparency = 0.35 }, 0.1)
		end
	end)
	grip.MouseLeave:Connect(function()
		if not resizing then
			tween(gripImage, { ImageTransparency = 0.8 }, 0.17)
		end
	end)

	table.insert(self._connections, UserInputService.InputEnded:Connect(function(inputObject)
		if resizing and isPress(inputObject) then
			resizing = false
			tween(gripImage, { ImageTransparency = 0.8 }, 0.17)
			if targetSize then
				self.Root.Size = UDim2.fromOffset(targetSize.X, targetSize.Y)
				self._baseSize = targetSize
				targetSize = nil
				self._userResized = true
				self._lockedFit = self._fitScale
			end
			self:_fitToScreen()
			self:_clampToScreen()
		end
	end))

	table.insert(self._frameSteps, function(deltaTime)
		if not resizing then
			return
		end
		local delta = (getMousePosition() - startPoint) / self.Scale.Scale
		targetSize = Vector2.new(
			math.clamp(startSize.X.Offset + delta.X * 2, minSize.X, maxSize.X),
			math.clamp(startSize.Y.Offset + delta.Y * 2, minSize.Y, maxSize.Y)
		)
		local current = Vector2.new(self.Root.Size.X.Offset, self.Root.Size.Y.Offset)
		local alpha = 1 - math.exp(-deltaTime * 35)
		local nextSize = current:Lerp(targetSize, alpha)
		nextSize = Vector2.new(math.floor(nextSize.X + 0.5), math.floor(nextSize.Y + 0.5))
		if nextSize ~= current then
			self.Root.Size = UDim2.fromOffset(nextSize.X, nextSize.Y)
		end
	end)
end

local function sanitizeConfigName(name)
	name = tostring(name or "")
		:gsub('[%c/\\:%*%?"<>|]', "")
		:gsub("%.%.+", ".")
		:gsub("^[%s%.]+", "")
		:gsub("[%s%.]+$", "")
	if name == "" then
		return nil
	end
	return name
end

local function configPath(window, name)
	local clean = sanitizeConfigName(name)
	if not clean then
		return nil, "invalid config name"
	end
	return window.ConfigFolder .. "/" .. clean .. ".json", clean
end

local function hasFileApi()
	return type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
end

local function ensureFolder(folder)
	if type(isfolder) ~= "function" or type(makefolder) ~= "function" then
		return
	end
	local path = ""
	for part in string.gmatch(folder, "[^/]+") do
		path = path == "" and part or (path .. "/" .. part)
		if not isfolder(path) then
			makefolder(path)
		end
	end
end

local function serializeElement(element)
	local typeName = element._type
	local value = element:Get()
	if typeName == "Keybind" then
		return { Type = typeName, Value = value and value.Name or nil }
	elseif typeName == "ColorPicker" then
		return { Type = typeName, Value = { value.R, value.G, value.B } }
	end
	return { Type = typeName, Value = value }
end

local function applySavedValue(element, saved, silent)
	local typeName = element._type
	local value = saved.Value
	if typeName == "Keybind" then
		element:Set(toKeyCode(value), silent)
	elseif typeName == "ColorPicker" then
		if type(value) == "table" then
			element:Set(Color3.new(value[1], value[2], value[3]), silent)
		end
	elseif typeName == "Dropdown" then

		element:Set(value, silent)
	elseif value ~= nil then
		element:Set(value, silent)
	end
end

function Window:SaveConfig(name)
	if not hasFileApi() then
		return false, "file API unavailable"
	end
	local path, cleanName = configPath(self, name or self.ConfigName)
	if not path then
		return false, cleanName
	end

	local data = {}
	for flag, element in pairs(self.Flags) do
		if element._type and type(element.Get) == "function" then
			data[flag] = serializeElement(element)
		end
	end
	for flag, saved in pairs(self._loadedConfig or {}) do
		if data[flag] == nil then
			data[flag] = saved
		end
	end

	local ok, err = pcall(function()
		ensureFolder(self.ConfigFolder)
		writefile(path, HttpService:JSONEncode(data))
	end)
	if ok then
		self.ConfigName = cleanName
	end
	return ok, err
end

function Window:LoadConfig(name, silent)
	if not hasFileApi() then
		return false, "file API unavailable"
	end
	local path, cleanName = configPath(self, name or self.ConfigName)
	if not path then
		return false, cleanName
	end
	if not isfile(path) then
		return false, "no config named " .. cleanName
	end

	local ok, data = pcall(function()
		return HttpService:JSONDecode(readfile(path))
	end)
	if not ok or type(data) ~= "table" then
		return false, "config is not valid JSON"
	end

	local autoSaveWas = self._autoSaveEnabled
	self._autoSaveEnabled = false
	for flag, saved in pairs(data) do
		local element = self.Flags[flag]
		if element and type(element.Set) == "function" and type(saved) == "table" and saved.Type == element._type then
			local applied, err = pcall(applySavedValue, element, saved, silent == true)
			if not applied then
				log("could not load flag " .. tostring(flag) .. ": " .. tostring(err))
			end
		end
	end
	self._autoSaveEnabled = autoSaveWas
	self._autoSaveReady = true
	self.ConfigName = cleanName
	self._loadedConfig = data
	self:_queueDependencies()
	return true
end

function Window:_applyLateConfig(element, flag)
	local data = self._loadedConfig
	local saved = data and data[flag]
	if type(saved) ~= "table" or saved.Type ~= element._type or type(element.Set) ~= "function" then
		return
	end
	local autoSaveWas = self._autoSaveEnabled
	self._autoSaveEnabled = false
	local applied, err = pcall(applySavedValue, element, saved, false)
	self._autoSaveEnabled = autoSaveWas
	if not applied then
		log("could not load flag " .. tostring(flag) .. ": " .. tostring(err))
	end
end

function Window:DeleteConfig(name)
	if not hasFileApi() or type(delfile) ~= "function" then
		return false, "file API unavailable"
	end
	local path, cleanName = configPath(self, name)
	if not path then
		return false, cleanName
	end
	if not isfile(path) then
		return false, "no config named " .. cleanName
	end
	return pcall(delfile, path)
end

function Window:ListConfigs()
	local names = {}
	if type(listfiles) ~= "function" or type(isfolder) ~= "function" or not isfolder(self.ConfigFolder) then
		return names
	end
	local ok, files = pcall(listfiles, self.ConfigFolder)
	if not ok or type(files) ~= "table" then
		return names
	end
	for _, file in ipairs(files) do
		local name = file:match("([^/\\]+)%.json$")
		if name then
			table.insert(names, name)
		end
	end
	table.sort(names)
	return names
end

function Window:ExportConfig()
	local data = {}
	for flag, element in pairs(self.Flags) do
		if element._type and type(element.Get) == "function" then
			data[flag] = serializeElement(element)
		end
	end
	for flag, saved in pairs(self._loadedConfig or {}) do
		if data[flag] == nil then
			data[flag] = saved
		end
	end
	local ok, text = pcall(function()
		return HttpService:JSONEncode(data)
	end)
	return ok and text or nil
end

function Window:ImportConfig(text)
	local ok, data = pcall(function()
		return HttpService:JSONDecode(text)
	end)
	if not ok or type(data) ~= "table" then
		return false, "that is not a valid config"
	end
	local applied = 0
	for flag, saved in pairs(data) do
		local element = self.Flags[flag]
		if element and type(element.Set) == "function" and type(saved) == "table" and saved.Type == element._type then
			if pcall(applySavedValue, element, saved, false) then
				applied += 1
			end
		end
	end
	self._loadedConfig = data
	if applied == 0 then
		return false, "nothing in that config matches this script"
	end
	return true, applied
end

function Window:ResetConfig()
	local reset = 0
	for _, element in pairs(self.Flags) do
		if element._defaultValue ~= nil and type(element.Set) == "function" then
			local value = element._defaultValue
			if type(value) == "table" then
				value = table.clone(value)
			end
			if pcall(element.Set, element, value) then
				reset += 1
			end
		end
	end
	return reset
end

function Window:SetAutoSave(enabled)
	self._autoSaveEnabled = enabled == true
end

function Window:_autoSave()
	if not self._autoSaveEnabled or self._destroyed or not self._autoSaveReady or self._autoSavePending then
		return
	end
	self._autoSavePending = true
	task.delay(0.5, function()
		self._autoSavePending = false
		if not self._destroyed then
			self:SaveConfig(self.ConfigName)
		end
	end)
end

local function createEmptyState(parent, icon, text)
	local holder = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, -10),
		Size = UDim2.fromOffset(200, 70),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	local image = create("ImageLabel", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.fromOffset(26, 26),
		BackgroundTransparency = 1,
		ImageColor3 = Theme.Muted,
		ImageTransparency = 0.15,
		ScaleType = Enum.ScaleType.Fit,
		Parent = holder,
	})
	setIcon(image, icon)
	local label = createLabel({
		Position = UDim2.fromOffset(0, 36),
		Size = UDim2.new(1, 0, 0, 16),
		Text = text,
		TextSize = 13,
		FontFace = Fonts.Regular,
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = holder,
	})
	return holder, label, image
end

local function createStatTile(parent, order, icon, title)
	local tile = create("Frame", {
		Size = UDim2.new(0.5, -4, 0, 62),
		BackgroundColor3 = Theme.Surface2,
		BorderSizePixel = 0,
		LayoutOrder = order,
		Parent = parent,
	})
	styleCard(tile)
	tile:SetAttribute(Const.ATTR_NO_DRAG, true)
	if icon then
		createIcon(tile, icon, Theme.Muted, UDim2.new(0, 14, 0, 21))
	end
	createLabel({
		Position = UDim2.fromOffset(icon and 36 or 14, 12),
		Size = UDim2.new(1, -(icon and 50 or 28), 0, 16),
		Text = title,
		TextSize = 12,
		TextColor3 = Theme.Muted,
		Parent = tile,
	})
	return createLabel({
		Position = UDim2.fromOffset(14, 34),
		Size = UDim2.new(1, -28, 0, 18),
		Text = "…",
		TextSize = 15,
		Parent = tile,
	})
end

local originalTransparency = setmetatable({}, { __mode = "k" })

local function fadeInTree(rootObject)
	local entries = {}

	local function remember(instance, property)
		local original = originalTransparency[instance]
		if original == nil then
			original = instance[property]
			originalTransparency[instance] = original
		end
		table.insert(entries, { instance, property, original })
	end

	local function walk(parent)
		for _, child in ipairs(parent:GetChildren()) do
			if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
				remember(child, "TextTransparency")
			elseif child:IsA("ImageLabel") or child:IsA("ImageButton") then
				remember(child, "ImageTransparency")
			elseif child:IsA("UIStroke") then
				remember(child, "Transparency")
			elseif child:IsA("Frame") then
				remember(child, "BackgroundTransparency")
			end
			walk(child)
		end
	end

	if rootObject:IsA("Frame") then
		remember(rootObject, "BackgroundTransparency")
	end
	walk(rootObject)

	for _, entry in ipairs(entries) do
		entry[1][entry[2]] = 1
		tween(entry[1], { [entry[2]] = entry[3] }, 0.28)
	end
end

local function slideIn(group, offsetY)
	offsetY = offsetY or 0
	group.GroupTransparency = 1
	group.Position = UDim2.fromOffset(0, offsetY + 14)
	group.Visible = true
	tween(group, { GroupTransparency = 0, Position = UDim2.fromOffset(0, offsetY) }, 0.32, Enum.EasingStyle.Quint)
end

local function createChangelogCard(parent, order, entry)
	local card = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Surface2,
		BorderSizePixel = 0,
		LayoutOrder = order,
		Parent = parent,
	})
	card:SetAttribute(Const.ATTR_NO_DRAG, true)
	styleCard(card)
	addPadding(card, 14, 14, 12, 14)
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 4),
		Parent = card,
	})

	local titleRow = create("Frame", {
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = card,
	})
	createLabel({
		Size = UDim2.new(1, -70, 1, 0),
		Text = entry.Title or entry.Version or "Update",
		TextSize = 14,
		Parent = titleRow,
	})

	if entry.Date or entry.Tag then
		local tag = create("Frame", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0),
			Size = UDim2.fromOffset(0, 20),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = Theme.Surface,
			BorderSizePixel = 0,
			Parent = titleRow,
		})
		addCorner(tag, UDim.new(0, 5))
		addStroke(tag)
		addPadding(tag, 8, 8)
		createLabel({
			Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X,
			Text = tostring(entry.Tag or entry.Date),
			TextSize = 11,
			TextColor3 = Theme.Muted,
			TextTruncate = Enum.TextTruncate.None,
			Parent = tag,
		})
	end

	local bodyText = entry.Content or entry.Body
	if type(entry.Changes) == "table" then
		bodyText = "• " .. table.concat(entry.Changes, "\n• ")
	end
	if bodyText then
		createLabel({
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Text = tostring(bodyText),
			TextSize = 13,
			FontFace = Fonts.Regular,
			TextColor3 = Theme.Muted,
			TextWrapped = true,
			TextTruncate = Enum.TextTruncate.None,
			TextYAlignment = Enum.TextYAlignment.Top,
			LayoutOrder = 2,
			Parent = card,
		})
	end
	return card
end

Const.DEFAULT_STATS = { "FPS", "Ping", "Executor", "Game", "Region", "Time" }

function Window:_buildHome(homeOptions, membership)
	local homeTab = self:Tab({
		Name = homeOptions.Name or homeOptions.Title or "Home",
		Desc = homeOptions.Desc,
		Icon = homeOptions.Icon or "house",
	})
	local list = homeTab.List
	local pageDefs = homeOptions.Pages or homeOptions.Tabs
	local pages = {}

	local layout = type(homeOptions.Layout) == "table" and homeOptions.Layout or nil
	local layoutIndex = {}
	if layout then
		for index, name in ipairs(layout) do
			layoutIndex[tostring(name)] = index
		end
	end
	local function shown(name)
		return layout == nil or layoutIndex[name] ~= nil
	end
	local function orderOf(name, default)
		return layoutIndex[name] and layoutIndex[name] * 10 or default
	end
	self._homeShown = shown
	self._homeOrderOf = orderOf

	if type(pageDefs) ~= "table" then
		pageDefs = {}
	end
	local pillRow = create("Frame", {
		Name = "PageBar",
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Visible = #pageDefs > 0,
		Parent = list,
	})
	pillRow:SetAttribute(Const.ATTR_NO_DRAG, true)
	local pillStrip = create("ScrollingFrame", {
		Name = "Strip",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 0,
		ScrollingDirection = Enum.ScrollingDirection.X,
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		CanvasSize = UDim2.new(),
		ElasticBehavior = Enum.ElasticBehavior.Never,
		Parent = pillRow,
	})
	pillStrip:SetAttribute(Const.ATTR_NO_DRAG, true)
	local pillLayout = create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6),
		Parent = pillStrip,
	})

	local function pageArrow(name, icon, anchorX)
		local button = create("TextButton", {
			Name = name,
			AnchorPoint = Vector2.new(anchorX, 0),
			Position = UDim2.fromScale(anchorX, 0),
			Size = UDim2.fromOffset(28, 32),
			BackgroundColor3 = Theme.Surface2,
			Text = "",
			AutoButtonColor = false,
			Visible = false,
			ZIndex = 3,
			Parent = pillRow,
		})
		addCorner(button, UDim.new(0, 7))
		local stroke = addStroke(button)
		local image = create("ImageLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(16, 16),
			BackgroundTransparency = 1,
			ImageColor3 = Theme.Text,
			ScaleType = Enum.ScaleType.Fit,
			ZIndex = 4,
			Parent = button,
		})
		setIcon(image, icon)
		button.MouseEnter:Connect(function()
			if not IS_TOUCH and button:GetAttribute("Enabled") ~= false then
				stroke.Color = Theme.StrokeHover
			end
		end)
		button.MouseLeave:Connect(function()
			stroke.Color = Theme.Stroke
		end)
		return button, image
	end
	local leftArrow, leftImage = pageArrow("Previous", "chevron-left", 0)
	local rightArrow, rightImage = pageArrow("Next", "chevron-right", 1)

	local function stripLimit()
		return math.max(pillLayout.AbsoluteContentSize.X - pillStrip.AbsoluteSize.X, 0)
	end
	local function updateArrows()
		local overflow = pillLayout.AbsoluteContentSize.X > pillRow.AbsoluteSize.X + 1
		leftArrow.Visible = overflow
		rightArrow.Visible = overflow
		if overflow then
			pillStrip.Position = UDim2.fromOffset(34, 0)
			pillStrip.Size = UDim2.new(1, -68, 1, 0)
		else
			pillStrip.Position = UDim2.fromOffset(0, 0)
			pillStrip.Size = UDim2.fromScale(1, 1)
			pillStrip.CanvasPosition = Vector2.zero
		end
		local x = pillStrip.CanvasPosition.X
		local canLeft = overflow and x > 1
		local canRight = overflow and x < stripLimit() - 1
		leftArrow:SetAttribute("Enabled", canLeft)
		rightArrow:SetAttribute("Enabled", canRight)
		leftImage.ImageTransparency = canLeft and 0 or 0.65
		rightImage.ImageTransparency = canRight and 0 or 0.65
	end
	local function scrollStrip(target)
		target = math.clamp(math.floor(target + 0.5), 0, stripLimit())
		pillStrip.CanvasPosition = Vector2.new(target, 0)
		updateArrows()
	end
	leftArrow.MouseButton1Click:Connect(function()
		scrollStrip(pillStrip.CanvasPosition.X - math.max(pillStrip.AbsoluteSize.X * 0.7, 80))
	end)
	rightArrow.MouseButton1Click:Connect(function()
		scrollStrip(pillStrip.CanvasPosition.X + math.max(pillStrip.AbsoluteSize.X * 0.7, 80))
	end)
	pillLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateArrows)
	pillRow:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateArrows)
	pillStrip:GetPropertyChangedSignal("CanvasPosition"):Connect(updateArrows)

	local greeting = homeOptions.Greeting
	if greeting == nil then
		local hour = tonumber(os.date("%H")) or 12
		local partOfDay = hour < 12 and "morning" or (hour < 18 and "afternoon" or "evening")
		greeting = "Good " .. partOfDay .. "."
	end

	local welcomeCard
	if homeOptions.Welcome ~= false and shown("Welcome") then
		welcomeCard = create("Frame", {
			Size = UDim2.new(1, 0, 0, 58),
			BackgroundColor3 = Theme.Surface2,
			BorderSizePixel = 0,
			LayoutOrder = 2,
			Parent = list,
		})
		welcomeCard:SetAttribute(Const.ATTR_NO_DRAG, true)
		styleCard(welcomeCard)

		local avatar = create("ImageLabel", {
			Position = UDim2.fromOffset(12, 11),
			Size = UDim2.fromOffset(36, 36),
			BackgroundColor3 = Theme.Surface,
			BorderSizePixel = 0,
			Parent = welcomeCard,
		})
		addCorner(avatar, UDim.new(0, 8))
		addStroke(avatar)
		task.spawn(function()
			local ok, image = pcall(function()
				return Players:GetUserThumbnailAsync(LocalPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
			end)
			if ok and image and avatar.Parent then
				avatar.Image = image
			end
		end)

		createLabel({
			Position = UDim2.fromOffset(58, 11),
			Size = UDim2.new(1, -72, 0, 18),
			Text = tostring(homeOptions.Welcome or "Hello, ") .. LocalPlayer.DisplayName,
			TextSize = 15,
			Parent = welcomeCard,
		})
		createLabel({
			Position = UDim2.fromOffset(58, 30),
			Size = UDim2.new(1, -72, 0, 16),
			Text = greeting,
			TextSize = 13,
			FontFace = Fonts.Regular,
			TextColor3 = Theme.Muted,
			Parent = welcomeCard,
		})
	end

	local detailsPage = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 3,
		Parent = list,
	})
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		Parent = detailsPage,
	})

	if homeOptions.Sections ~= false and shown("Stats") then
		local headerRow = create("Frame", {
			Size = UDim2.new(1, 0, 0, 24),
			BackgroundTransparency = 1,
			LayoutOrder = orderOf("Stats", 2) - 1,
			Parent = detailsPage,
		})
		local headerLabel = createLabel({
			Position = UDim2.fromOffset(2, 6),
			Size = UDim2.new(0, 0, 0, 16),
			AutomaticSize = Enum.AutomaticSize.X,
			Text = string.upper(homeOptions.SectionName or "System info"),
			TextSize = 12,
			TextColor3 = Theme.Muted,
			TextTruncate = Enum.TextTruncate.None,
			Parent = headerRow,
		})
		local headerLine = create("Frame", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0, 14),
			Size = UDim2.new(1, -12, 0, 1),
			BackgroundColor3 = Theme.Stroke,
			BorderSizePixel = 0,
			Parent = headerRow,
		})
		local function fitLine()
			headerLine.Size = UDim2.new(1, -(headerLabel.AbsoluteSize.X / self.Scale.Scale + 14), 0, 1)
		end
		headerLabel:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitLine)
		task.defer(fitLine)
	end

	local keySetting = membership
	if keySetting == nil then
		keySetting = homeOptions.Key
	end
	local keyOptions = type(keySetting) == "table" and keySetting or {}
	if not shown("Membership") then
		keySetting = false
	end
	local keyOrder = orderOf("Membership", 0)
	if keySetting ~= false then
		self.KeyPanel = createKeyPanel(self, detailsPage, keyOrder, keyOptions)
	end
	task.spawn(function()
		while keySetting ~= false and keyOptions.Protected ~= false and not self._destroyed and detailsPage.Parent do
			task.wait(2)
			if self._destroyed or not detailsPage.Parent then
				break
			end
			local frame = self.KeyPanel and self.KeyPanel.Frame
			if not frame or frame.Parent ~= detailsPage then
				if frame and frame.Parent then
					pcall(function()
						frame:Destroy()
					end)
				end
				self.KeyPanel = createKeyPanel(self, detailsPage, keyOrder, keyOptions)
			elseif not frame.Visible then
				frame.Visible = true
			end
		end
	end)

	local statGrid = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = orderOf("Stats", 2),
		Visible = shown("Stats"),
		Parent = detailsPage,
	})
	create("UIGridLayout", {
		CellSize = UDim2.new(0.5, -4, 0, 62),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = statGrid,
	})

	local enabledStats = {}
	if shown("Stats") then
		for _, statName in ipairs(homeOptions.Stats or Const.DEFAULT_STATS) do
			enabledStats[statName] = true
		end
	end

	local tileCount = 0
	local function addStat(statName, icon, title)
		if not enabledStats[statName] then
			return nil
		end
		tileCount += 1
		return createStatTile(statGrid, tileCount, icon, title)
	end

	local fpsValue = addStat("FPS", "activity", "FPS")
	local pingValue = addStat("Ping", "wifi", "Ping")
	local executorValue = addStat("Executor", "terminal", "Executor")
	local gameValue = addStat("Game", "gamepad-2", "Game")
	local regionValue = addStat("Region", "globe", "Your region")
	local timeValue = addStat("Time", "clock", "Time of day")
	local playersValue = addStat("Players", "users", "Players")
	local uptimeValue = addStat("Uptime", "timer", "Session")

	if executorValue then
		executorValue.Text = getExecutorName()
	end
	if gameValue then
		gameValue.Text = "Loading"
		task.spawn(function()
			local name = getGameName()
			if gameValue.Parent then
				gameValue.Text = name
			end
		end)
	end
	if regionValue then
		regionValue.Text = "Loading"
		fetchRegion(function(region)
			if regionValue.Parent then
				regionValue.Text = region
			end
		end, homeOptions.RegionCity == false)
	end

	local frames = 0
	local sessionStart = os.clock()
	self:_listen("Render", function()
		frames += 1
	end)

	task.spawn(function()
		while not self._destroyed and homeTab.List.Parent and homeTab._page.Parent do

			if not self.Open or self.CurrentTab ~= homeTab then
				frames = 0
				task.wait(1)
				continue
			end
			if fpsValue then
				fpsValue.Text = tostring(frames)
			end
			frames = 0
			if pingValue then
				local ok, ping = pcall(function()
					return math.floor(LocalPlayer:GetNetworkPing() * 1000)
				end)
				pingValue.Text = (ok and ping or 0) .. " ms"
			end
			if timeValue then
				timeValue.Text = os.date(homeOptions.TimeFormat or "%H:%M")
			end
			if playersValue then
				playersValue.Text = #Players:GetPlayers() .. " / " .. Players.MaxPlayers
			end
			if uptimeValue then
				local seconds = math.floor(os.clock() - sessionStart)
				uptimeValue.Text = string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
			end
			task.wait(1)
		end
	end)

	if self._buildCommunity then
		self:_buildCommunity(detailsPage)
	end

	table.insert(pages, {
		Title = homeOptions.SectionName or "Details",
		Icon = homeOptions.TabIcon or "layout-grid",
		Frame = detailsPage,
	})

	do
		local function addTextCard(parent, order)
			local card = create("Frame", {
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundColor3 = Theme.Surface2,
				BorderSizePixel = 0,
				LayoutOrder = order,
				Parent = parent,
			})
			card:SetAttribute(Const.ATTR_NO_DRAG, true)
			styleCard(card)
			addPadding(card, 14, 14, 12, 14)
			return card
		end

		local function buildPage(pageDef)
			local pageFrame = create("Frame", {
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				Visible = false,
				LayoutOrder = 3,
				Parent = list,
			})
			create("UIListLayout", {
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 8),
				Parent = pageFrame,
			})

			if type(pageDef.Content) == "string" then
				local card = addTextCard(pageFrame, 1)
				createLabel({
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					Text = pageDef.Content,
					TextSize = 13,
					FontFace = Fonts.Regular,
					TextColor3 = Theme.Muted,
					TextWrapped = true,
					TextTruncate = Enum.TextTruncate.None,
					TextYAlignment = Enum.TextYAlignment.Top,
					Parent = card,
				})
			end

			if type(pageDef.Entries) == "table" then
				for entryIndex, entry in ipairs(pageDef.Entries) do
					createChangelogCard(pageFrame, entryIndex + 1, entry)
				end
			end

			if type(pageDef.Build) == "function" then
				safeCall(pageDef.Build, pageFrame)
				for _, child in ipairs(pageFrame:GetChildren()) do
					if child:IsA("GuiObject") then
						child:SetAttribute(Const.ATTR_NO_DRAG, true)
					end
				end
			end

			return {
				Title = pageDef.Name or pageDef.Title or "Page",
				Icon = pageDef.Icon,
				Frame = pageFrame,
			}
		end

		for _, pageDef in ipairs(pageDefs) do
			if type(pageDef) == "table" then
				table.insert(pages, buildPage(pageDef))
			end
		end

		local pills = {}
		local function revealPill(pageIndex)
			local pill = pills[pageIndex]
			if not pill or not leftArrow.Visible then
				return
			end
			local left = pill.Frame.AbsolutePosition.X - pillStrip.AbsolutePosition.X + pillStrip.CanvasPosition.X
			local right = left + pill.Frame.AbsoluteSize.X
			local view = pillStrip.CanvasPosition.X
			if left < view then
				scrollStrip(left)
			elseif right > view + pillStrip.AbsoluteSize.X then
				scrollStrip(right - pillStrip.AbsoluteSize.X)
			end
		end

		local function showPage(pageIndex, instant)
			local changed = self._homeIndex ~= pageIndex
			self._homeIndex = pageIndex
			if welcomeCard then
				welcomeCard.Visible = pageIndex == 1
				if pageIndex == 1 and changed and not instant then
					fadeInTree(welcomeCard)
				end
			end

			for index, page in ipairs(pages) do
				local active = index == pageIndex
				page.Frame.Visible = active
				if active and changed and not instant then
					for _, child in ipairs(page.Frame:GetChildren()) do
						if child:IsA("GuiObject") then
							fadeInTree(child)
						end
					end
				end

				local pill = pills[index]
				if pill then
					if active then
						task.defer(revealPill, index)
					end
					tween(pill.Frame, { BackgroundTransparency = active and 0 or 1 }, 0.15)
					tween(pill.Stroke, { Transparency = active and 0 or 1 }, 0.15)
					tween(pill.Label, { TextColor3 = active and Theme.Text or Theme.Muted }, 0.15)
					if pill.Icon then
						tween(pill.Icon, { ImageColor3 = active and Theme.Accent or Theme.Muted }, 0.15)
					end
				end
			end
		end

		local function addPill(index, page)
			local pillButton = create("TextButton", {
				Size = UDim2.fromOffset(0, 32),
				AutomaticSize = Enum.AutomaticSize.X,
				BackgroundColor3 = Theme.Surface2,
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
				LayoutOrder = index,
				Parent = pillStrip,
			})
			addCorner(pillButton, UDim.new(0, 7))
			local pillStroke = addStroke(pillButton, Theme.Stroke, 1)
			addPadding(pillButton, 12, 12)

			local pillIcon
			if page.Icon then
				pillIcon = create("ImageLabel", {
					AnchorPoint = Vector2.new(0, 0.5),
					Position = UDim2.new(0, 0, 0.5, 0),
					Size = UDim2.fromOffset(14, 14),
					BackgroundTransparency = 1,
					ImageColor3 = Theme.Muted,
					ScaleType = Enum.ScaleType.Fit,
					Parent = pillButton,
				})
				setIcon(pillIcon, page.Icon)
			end

			local pillLabel = createLabel({
				Position = UDim2.fromOffset(pillIcon and 20 or 0, 0),
				Size = UDim2.new(0, 0, 1, 0),
				AutomaticSize = Enum.AutomaticSize.X,
				Text = page.Title,
				TextSize = 13,
				TextColor3 = Theme.Muted,
				TextTruncate = Enum.TextTruncate.None,
				Parent = pillButton,
			})

			pills[index] = {
				Frame = pillButton,
				Stroke = pillStroke,
				Label = pillLabel,
				Icon = pillIcon,
			}

			pillButton.MouseEnter:Connect(function()
				if IS_TOUCH then
					return
				end
				if self._homeIndex ~= index then
					tween(pillButton, { BackgroundTransparency = 0.4 }, 0.12)
					tween(pillStroke, { Transparency = 0.5 }, 0.12)
				end
			end)
			pillButton.MouseLeave:Connect(function()
				if self._homeIndex ~= index then
					tween(pillButton, { BackgroundTransparency = 1 }, 0.2)
					tween(pillStroke, { Transparency = 1 }, 0.2)
				end
			end)
			pillButton.MouseButton1Click:Connect(function()
				showPage(index)
			end)
		end

		for index, page in ipairs(pages) do
			addPill(index, page)
		end

		showPage(1)
		self._showHomePage = showPage
		self._homePages = pages
		self._addHomePage = function(pageDef)
			local page = buildPage(pageDef)
			table.insert(pages, page)
			addPill(#pages, page)
			pillRow.Visible = #pages > 1
			showPage(self._homeIndex or 1, true)
			task.defer(updateArrows)
			return page
		end
		task.defer(updateArrows)
	end

	homeTab._order = 10
	self.Home = homeTab
	return homeTab
end

function Window:Tab(input, icon)
	local options = normalizeOptions(input, { Title = "Name", Description = "Desc" })
	if icon ~= nil and options.Icon == nil then
		options.Icon = icon
	end

	local tab = setmetatable({
		Name = options.Name or "Tab",
		Window = self,
		_order = 0,
	}, Tab)

	local section = options.Section
	if section == nil then
		section = self._currentSection
	end
	if section == false then
		section = nil
	end
	local sidebarOrder
	if section then
		section._count += 1
		sidebarOrder = section._base + section._count
		tab._section = section
		table.insert(section.Tabs, tab)
		if section._refreshCount then
			section:_refreshCount()
		end
	else
		self._looseTabOrder += 1
		sidebarOrder = self._looseTabOrder
	end

	local button = create("TextButton", {
		Size = UDim2.new(1, 0, 0, Const.TAB_HEIGHT),
		BackgroundColor3 = Theme.Surface2,
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = sidebarOrder,
		Parent = self.TabList,
	})
	addCorner(button)
	local buttonStroke = addStroke(button, Theme.Stroke, 1)
	tab._button = button
	tab._stroke = buttonStroke

	local hasIcon = options.Icon ~= nil
	if hasIcon then
		local iconImage = create("ImageLabel", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 12, 0.5, 0),
			Size = UDim2.fromOffset(16, 16),
			BackgroundTransparency = 1,
			ImageColor3 = Theme.Muted,
			ScaleType = Enum.ScaleType.Fit,
			Parent = button,
		})
		setIcon(iconImage, options.Icon)
		tab._icon = iconImage
	end

	tab._labelX = hasIcon and 36 or 14
	if not hasIcon then
		tab._initial = createLabel({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(20, 20),
			Text = string.upper(string.sub(tab.Name, 1, 1)),
			TextSize = 14,
			FontFace = Fonts.Bold,
			TextColor3 = Theme.Muted,
			TextXAlignment = Enum.TextXAlignment.Center,
			Visible = false,
			Parent = button,
		})
	end
	tab._label = createLabel({
		Position = UDim2.fromOffset(tab._labelX, 0),
		Size = UDim2.new(1, -(hasIcon and 44 or 22), 1, 0),
		Text = tab.Name,
		TextColor3 = Theme.Muted,
		Parent = button,
	})

	local page = create("Frame", {
		Name = tab.Name,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = self.Content,
	})
	tab._page = page

	tab._pageTitle = createLabel({
		Position = UDim2.fromOffset(Const.PAGE_PAD + 36, 18),
		Size = UDim2.new(1, -108, 0, 24),
		Text = tab.Name,
		TextSize = 19,
		Parent = page,
	})
	if options.Desc then
		tab._pageDesc = createLabel({
			Position = UDim2.fromOffset(Const.PAGE_PAD + 36, 40),
			Size = UDim2.new(1, -108, 0, 16),
			Text = options.Desc,
			TextSize = 13,
			FontFace = Fonts.Regular,
			TextColor3 = Theme.Muted,
			Parent = page,
		})
	end

	local listTop = options.Desc and 64 or 54
	local list = create("ScrollingFrame", {
		Active = true,
		Position = UDim2.fromOffset(0, listTop),
		Size = UDim2.new(1, 0, 1, -listTop),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Muted,
		ScrollBarImageTransparency = 0.55,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = page,
	})
	addScrollFades(list, "Background", 16)
	addPadding(list, Const.PAGE_PAD, Const.PAGE_PAD, 2, 20)
	if IS_TOUCH then
		list:SetAttribute(Const.ATTR_NO_DRAG, true)
	end
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, Appearance.Spacing),
		Parent = list,
	})
	tab.List = list

	local emptyState = createEmptyState(page, options.Icon or "layout-grid", options.EmptyText or "Nothing here yet")
	local childCount = 0
	list.ChildAdded:Connect(function(child)
		if child:IsA("GuiObject") then
			childCount += 1
			emptyState.Visible = false
		end
	end)
	list.ChildRemoved:Connect(function(child)
		if child:IsA("GuiObject") then
			childCount = math.max(childCount - 1, 0)
			emptyState.Visible = childCount <= 0
		end
	end)
	emptyState.Visible = true

	button.MouseEnter:Connect(function()
		if IS_TOUCH then
			return
		end
		if self._compact then
			self:_showTooltip(tab.Name, button)
		end
		if self.CurrentTab ~= tab and not tab._locked then
			tween(tab._label, { TextColor3 = Theme.Text }, 0.15)
			if tab._icon then
				tween(tab._icon, { ImageColor3 = Theme.Text }, 0.15)
			end
		end
	end)
	button.MouseLeave:Connect(function()
		self:_hideTooltip(button)
		if self.CurrentTab ~= tab then
			tween(tab._label, { TextColor3 = Theme.Muted }, 0.2)
			if tab._icon then
				tween(tab._icon, { ImageColor3 = Theme.Muted }, 0.2)
			end
		end
	end)
	button.MouseButton1Click:Connect(function()
		self:SelectTab(tab)
	end)

	if not self._introDone then
		button.Visible = false
	end
	if section and not section.Opened and not self._compact then
		button.Visible = false
		button:SetAttribute(Const.ATTR_HIDDEN, true)
	end
	if options.Badge ~= nil then
		tab:SetBadge(options.Badge)
	end
	self:_layoutTabButton(tab)
	if type(options.Build) == "function" then
		tab._lazyBuild = options.Build
	end
	if options.Locked == true then
		tab:SetLocked(true, options.LockedReason)
	end
	if options.Visible == false or options.Hidden == true then
		task.defer(function()
			tab:SetVisible(false)
		end)
	end

	table.insert(self.Tabs, tab)
	if #self.Tabs == 1 then
		task.defer(function()
			if not self.CurrentTab then
				self:SelectTab(tab)
			end
		end)
	end

	return tab
end
Window.CreateTab = Window.Tab

function Window:_placeIndicator(tab)
	local indicator = self.Indicator
	if not tab or not tab._button or self._destroyed then
		return
	end
	if indicator.Parent ~= tab._button then
		indicator.Parent = tab._button
	end
	indicator.BackgroundTransparency = 0.86
	indicator.Visible = true
end

function Window:SetBlur()
	removeLeftoverBlur()
end

function Window:SelectTab(tab)
	self:_hideTooltip()
	if type(tab) == "string" then
		local wanted = tab
		tab = nil
		for _, candidate in ipairs(self.Tabs) do
			if candidate.Name == wanted then
				tab = candidate
				break
			end
		end
	end
	if type(tab) ~= "table" or self.CurrentTab == tab then
		return
	end

	if tab._section and not tab._section.Opened then
		tab._section:SetOpen(true)
	end

	local previous = self.CurrentTab
	self.CurrentTab = tab
	self:_settleTransition()

	self._transitionGeneration = (self._transitionGeneration or 0) + 1
	local generation = self._transitionGeneration

	if previous then
		previous._button.BackgroundTransparency = 1
		previous._stroke.Transparency = 1
		tween(previous._label, { TextColor3 = Theme.Muted }, 0.18)
		previous._label.Position = UDim2.fromOffset(previous._labelX, 0)
		if previous._icon then
			tween(previous._icon, { ImageColor3 = Theme.Muted }, 0.18)
		end

		if instantUI() then
			previous._page.Parent = self.Content
			previous._page.Visible = false
		end
		local outLayer = (not instantUI()) and self._outLayer or nil
		if outLayer then
			previous._page.Parent = outLayer
			self._outPage = previous._page
			outLayer.GroupTransparency = 0
			outLayer.Position = UDim2.fromOffset(0, 0)
			outLayer.Visible = true
			tween(outLayer, { GroupTransparency = 1, Position = UDim2.fromOffset(0, -10) }, 0.18)
			task.delay(0.18, function()
				if self._transitionGeneration == generation then
					self:_settleOut()
				end
			end)
		end
	end

	tab._button.BackgroundTransparency = 1
	tab._stroke.Transparency = 1
	tween(tab._label, { TextColor3 = Theme.Text }, 0.18)
	tab._label.Position = UDim2.fromOffset(tab._labelX, 0)
	if tab._icon then
		tween(tab._icon, { ImageColor3 = Theme.Accent }, 0.18)
	end
	self:_placeIndicator(tab)

	local page = tab._page
	page.Position = UDim2.fromOffset(0, 0)
	page.Visible = true
	if instantUI() then
		page.Parent = self.Content
		return
	end
	page.Parent = self._inLayer
	self._inPage = page
	slideIn(self._inLayer)
	task.delay(0.32, function()
		if self._transitionGeneration == generation then
			self:_settleIn()
		end
	end)
end

function Window:_settleOut()
	if self._destroyed then
		return
	end
	local page = self._outPage
	if page then
		page.Parent = self.Content
		page.Visible = false
		self._outPage = nil
	end
	self._outLayer.Visible = false
end

function Window:_settleIn()
	if self._destroyed then
		return
	end
	local page = self._inPage
	if page then
		page.Parent = self.Content
		page.Position = UDim2.fromOffset(0, 0)
		self._inPage = nil
	end
	self._inLayer.Visible = false
end

function Window:_settleTransition()
	self:_settleOut()
	self:_settleIn()
end

Const.DIALOG_PADDING = 18
Const.DIALOG_WIDTH = 300

function Window:Dialog(input)
	local options = normalizeOptions(input, { Text = "Content", Message = "Content" })

	if self._dialog then
		self._dialog.Close()
	end

	local pad = Const.DIALOG_PADDING

	local backdrop = create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 40,
		Parent = self.Body,
	})
	addCorner(backdrop, UDim.new(0, Appearance.WindowRadius))

	local panel = create("TextButton", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 10),
		Size = UDim2.fromOffset(Const.DIALOG_WIDTH, 120),
		BackgroundColor3 = Theme.Background,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 41,
		Parent = backdrop,
	})
	addCorner(panel, UDim.new(0, 10))
	local panelStroke = addStroke(panel, Theme.Stroke, 1)
	local panelScale = create("UIScale", { Scale = 0.94, Parent = panel })

	local fades = {}
	local titleOffset = 0

	if options.Icon then
		local iconHolder, iconImage = createIcon(panel, options.Icon, Theme.Accent, UDim2.new(0, pad, 0, pad + 9))
		iconImage.ImageTransparency = 1
		iconHolder.ZIndex = 42
		iconImage.ZIndex = 42
		table.insert(fades, { iconImage, "ImageTransparency", 0 })
		titleOffset = 24
	end

	local titleLabel = createLabel({
		Position = UDim2.fromOffset(pad + titleOffset, pad),
		Size = UDim2.new(1, -(pad * 2 + titleOffset), 0, 18),
		Text = options.Title or "Are you sure?",
		TextSize = 15,
		TextTransparency = 1,
		ZIndex = 42,
		Parent = panel,
	})
	table.insert(fades, { titleLabel, "TextTransparency", 0 })

	local buttonRow = create("Frame", {
		Name = "ButtonRow",
		Size = UDim2.new(1, -pad * 2, 0, 34),
		BackgroundTransparency = 1,
		ZIndex = 42,
		Parent = panel,
	})
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		Parent = buttonRow,
	})

	local contentHeight = 0
	local inputField, inputBox, inputStroke
	local inputOptions = type(options.Input) == "table" and options.Input or (options.Input and {} or nil)
	local inputHeight = inputOptions and 42 or 0
	local function layout()
		panel.Size = UDim2.fromOffset(Const.DIALOG_WIDTH, pad + 24 + contentHeight + inputHeight + 12 + 34 + pad)
		if inputField then
			inputField.Position = UDim2.fromOffset(pad, pad + 24 + contentHeight + 6)
		end
		buttonRow.Position = UDim2.fromOffset(pad, pad + 24 + contentHeight + inputHeight + 12)
	end

	if inputOptions then
		inputField = create("Frame", {
			Size = UDim2.new(1, -pad * 2, 0, 34),
			BackgroundColor3 = Theme.Surface,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 42,
			Parent = panel,
		})
		addCorner(inputField, UDim.new(0, 7))
		inputStroke = addStroke(inputField, Theme.Stroke, 1)
		inputStroke.Transparency = 1
		local maxLength = tonumber(inputOptions.MaxLength)
		inputBox = create("TextBox", {
			Position = UDim2.fromOffset(10, 0),
			Size = UDim2.new(1, -20, 1, 0),
			BackgroundTransparency = 1,
			Text = "",
			PlaceholderText = tostring(inputOptions.Placeholder or ""),
			PlaceholderColor3 = Theme.Muted,
			TextColor3 = Theme.Text,
			TextSize = 13,
			FontFace = Fonts.Regular,
			TextXAlignment = Enum.TextXAlignment.Left,
			ClearTextOnFocus = false,
			ClipsDescendants = true,
			TextTransparency = 1,
			ZIndex = 43,
			Parent = inputField,
		})
		inputBox.Text = tostring(inputOptions.Default or "")
		inputBox:GetPropertyChangedSignal("Text"):Connect(function()
			if maxLength and #inputBox.Text > maxLength then
				inputBox.Text = inputBox.Text:sub(1, maxLength)
			end
		end)
		inputBox.Focused:Connect(function()
			tween(inputStroke, { Color = Theme.StrokeHover }, 0.15)
		end)
		inputBox.FocusLost:Connect(function()
			tween(inputStroke, { Color = Theme.Stroke }, 0.15)
		end)
		table.insert(fades, { inputField, "BackgroundTransparency", 0 })
		table.insert(fades, { inputStroke, "Transparency", 0 })
		table.insert(fades, { inputBox, "TextTransparency", 0 })
	end

	if options.Content then
		local contentLabel = createLabel({
			Position = UDim2.fromOffset(pad, pad + 24),
			Size = UDim2.new(1, -pad * 2, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Text = tostring(options.Content),
			TextSize = 13,
			FontFace = Fonts.Regular,
			TextColor3 = Theme.Muted,
			TextWrapped = true,
			TextTransparency = 1,
			TextTruncate = Enum.TextTruncate.None,
			TextYAlignment = Enum.TextYAlignment.Top,
			ZIndex = 42,
			Parent = panel,
		})
		table.insert(fades, { contentLabel, "TextTransparency", 0 })
		contentHeight = math.max(contentLabel.TextBounds.Y, 16) + 6
		contentLabel:GetPropertyChangedSignal("TextBounds"):Connect(function()
			local newHeight = math.max(contentLabel.TextBounds.Y, 16) + 6
			if newHeight ~= contentHeight then
				contentHeight = newHeight
				layout()
			end
		end)
	end
	layout()

	local dialog = {}
	local closed = false

	function dialog.Close()
		if closed then
			return
		end
		closed = true
		if self._dialog == dialog then
			self._dialog = nil
		end
		tween(backdrop, { BackgroundTransparency = 1 }, 0.18)
		tween(panel, { BackgroundTransparency = 1, Position = UDim2.new(0.5, 0, 0.5, 8) }, 0.18, Enum.EasingStyle.Quint)
		tween(panelScale, { Scale = 0.96 }, 0.18, Enum.EasingStyle.Quint)
		tween(panelStroke, { Transparency = 1 }, 0.12)
		for _, fade in ipairs(fades) do
			tween(fade[1], { [fade[2]] = 1 }, 0.12)
		end
		task.delay(0.2, function()
			backdrop:Destroy()
		end)
	end

	function dialog.Cancel()
		if closed then
			return
		end
		dialog.Close()
		safeCall(options.OnCancel)
	end

	function dialog.GetText()
		return inputBox and inputBox.Text or nil
	end

	local function inputValid()
		if not inputBox or not inputOptions.Numeric or tonumber(inputBox.Text) then
			return true
		end
		inputStroke.Color = Theme.Error
		tween(inputStroke, { Color = Theme.Stroke }, 0.6)
		return false
	end

	local primaryActivate

	local buttons = options.Buttons
	if type(buttons) ~= "table" or #buttons == 0 then
		buttons = { { Title = "OK", Variant = "Primary" } }
	end

	for order, buttonDef in ipairs(buttons) do
		local primary = buttonDef.Variant == "Primary"
		local restBackground = primary and 0.12 or 0
		local restStroke = primary and 0.4 or 0

		local dialogButton = create("TextButton", {
			Size = UDim2.fromOffset(0, 34),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = primary and Theme.Accent or Theme.Surface2,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Text = "",
			AutoButtonColor = false,
			ClipsDescendants = true,
			LayoutOrder = order,
			ZIndex = 43,
			Parent = buttonRow,
		})
		addCorner(dialogButton, UDim.new(0, 7))
		local buttonStroke = addStroke(dialogButton, primary and Theme.Accent or Theme.Stroke, 1)
		addPadding(dialogButton, 14, 14)

		local buttonLabel = createLabel({
			Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X,
			Text = buttonDef.Title or buttonDef.Name or "OK",
			TextSize = 13,
			TextColor3 = primary and Theme.AccentDark or Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextTransparency = 1,
			ZIndex = 44,
			Parent = dialogButton,
		})

		table.insert(fades, { dialogButton, "BackgroundTransparency", restBackground })
		table.insert(fades, { buttonStroke, "Transparency", restStroke })
		table.insert(fades, { buttonLabel, "TextTransparency", 0 })

		dialogButton.MouseEnter:Connect(function()
			if IS_TOUCH then
				return
			end
			if closed then
				return
			end
			if primary then
				tween(dialogButton, { BackgroundTransparency = 0 }, 0.12)
				tween(buttonStroke, { Transparency = 0 }, 0.12)
			else
				tween(buttonStroke, { Color = Theme.StrokeHover }, 0.12)
			end
		end)
		dialogButton.MouseLeave:Connect(function()
			if closed then
				return
			end
			if primary then
				tween(dialogButton, { BackgroundTransparency = restBackground }, 0.2)
				tween(buttonStroke, { Transparency = restStroke }, 0.2)
			else
				tween(buttonStroke, { Color = Theme.Stroke }, 0.2)
			end
		end)
		local function activate()
			if closed then
				return
			end
			if primary and not inputValid() then
				return
			end
			local text = inputBox and inputBox.Text or nil
			dialog.Close()
			runProtected(('dialog button "%s"'):format(tostring(buttonDef.Title or buttonDef.Name or "OK")), buttonDef.Callback, text)
		end
		if primary then
			primaryActivate = activate
		end
		dialogButton.MouseButton1Click:Connect(activate)
	end

	if inputBox then
		inputBox.FocusLost:Connect(function(enterPressed)
			if enterPressed and primaryActivate then
				primaryActivate()
			end
		end)
		task.delay(0.3, function()
			if not closed and inputBox.Parent and not IS_TOUCH then
				inputBox:CaptureFocus()
			end
		end)
	end

	dialog.Dismissable = options.CloseOnBackdrop ~= false
	if dialog.Dismissable then
		backdrop.MouseButton1Click:Connect(dialog.Cancel)
	end

	self._dialog = dialog

	tween(backdrop, { BackgroundTransparency = 0.45 }, 0.25)
	tween(panel, { BackgroundTransparency = 0, Position = UDim2.fromScale(0.5, 0.5) }, 0.3, Enum.EasingStyle.Quint)
	tween(panelStroke, { Transparency = 0 }, 0.25)
	tween(panelScale, { Scale = 1 }, 0.4, Enum.EasingStyle.Back)
	for _, fade in ipairs(fades) do
		tween(fade[1], { [fade[2]] = fade[3] }, 0.25)
	end

	return dialog
end

function Window:Prompt(input)
	local options = normalizeOptions(input, { Text = "Content", Message = "Content", PlaceholderText = "Placeholder" })
	return self:Dialog({
		Title = options.Title or "Enter a value",
		Content = options.Content,
		Icon = options.Icon,
		OnCancel = options.OnCancel,
		CloseOnBackdrop = options.CloseOnBackdrop,
		Input = {
			Placeholder = options.Placeholder,
			Default = options.Default,
			Numeric = options.Numeric,
			MaxLength = options.MaxLength,
		},
		Buttons = {
			{ Title = options.CancelText or "Cancel", Callback = function()
				safeCall(options.OnCancel)
			end },
			{ Title = options.ConfirmText or "OK", Variant = "Primary", Callback = function(text)
				safeCall(options.Callback, options.Numeric and tonumber(text) or text)
			end },
		},
	})
end

function Window:Confirm(input)
	local options = normalizeOptions(input, { Text = "Content", Message = "Content" })
	return self:Dialog({
		Title = options.Title or "Are you sure?",
		Content = options.Content,
		Icon = options.Icon,
		OnCancel = options.OnCancel,
		CloseOnBackdrop = options.CloseOnBackdrop,
		Buttons = {
			{ Title = options.CancelText or "Cancel", Callback = options.OnCancel },
			{ Title = options.ConfirmText or "Confirm", Variant = "Primary", Callback = options.Callback },
		},
	})
end

function Window:_listen(kind, listener, owner)
	local listeners = self._inputListeners[kind]
	table.insert(listeners, listener)

	local function disconnect()
		local index = table.find(listeners, listener)
		if index then
			table.remove(listeners, index)
		end
	end

	if owner then
		owner._listeners = owner._listeners or {}
		table.insert(owner._listeners, disconnect)
	end
	return disconnect
end

function Window:Toggle(open)
	if not self._introDone or self._destroyed then
		return
	end
	if self.Minimized then
		self:Minimize(false)
		if open ~= false then
			return
		end
	end
	if open == nil then
		open = not self.Open
	end
	if open == self.Open then
		return
	end
	self.Open = open
	self:_hideTooltip()
	for _, callback in ipairs(self._events[open and "Open" or "Close"]) do
		task.spawn(safeCall, callback)
	end

	if open then
		self.Root.Visible = true
		tween(self.Scale, { Scale = self._fitScale or 1 }, 0.4, Enum.EasingStyle.Back)
		self:_fadeIn(0.25)
		tween(self.BodyStroke, { Transparency = 0 }, 0.25)
		tween(self.Shadow, { ImageTransparency = 0.6 }, 0.3)
	else
		tween(self.Scale, { Scale = (self._fitScale or 1) * 0.94 }, 0.2, Enum.EasingStyle.Quint)
		self:_fadeOut(0.16)
		tween(self.BodyStroke, { Transparency = 1 }, 0.12)
		tween(self.Shadow, { ImageTransparency = 1 }, 0.16)
		if instantUI() then
			self.Root.Visible = false
		end
		task.delay(0.2, function()
			if not self.Open and not self._destroyed then
				self.Root.Visible = false
			end
		end)
	end
end

function Window:_setFade(amount)
	self._fadeGeneration = (self._fadeGeneration or 0) + 1
	local fader = self._fader
	fader.BackgroundColor3 = Theme.Background
	fader.BackgroundTransparency = amount
	fader.Visible = amount < 1
end

function Window:_fadeIn(duration)
	self._fadeGeneration = (self._fadeGeneration or 0) + 1
	local generation = self._fadeGeneration
	local fader = self._fader
	fader.BackgroundColor3 = Theme.Background
	if instantUI() or not duration or duration <= 0 then
		fader.BackgroundTransparency = 1
		fader.Visible = false
		return
	end
	fader.Visible = true
	tween(fader, { BackgroundTransparency = 1 }, duration)
	task.delay(duration, function()
		if self._fadeGeneration == generation and not self._destroyed then
			fader.Visible = false
		end
	end)
end

function Window:_fadeOut(duration)
	self._fadeGeneration = (self._fadeGeneration or 0) + 1
	local fader = self._fader
	fader.BackgroundColor3 = Theme.Background
	fader.Visible = true
	if instantUI() or not duration or duration <= 0 then
		fader.BackgroundTransparency = 0
		return
	end
	tween(fader, { BackgroundTransparency = 0 }, duration * 0.7)
end

function Window:SetKeepOnScreen(keep)
	self.KeepOnScreen = keep ~= false
	if self.KeepOnScreen then
		self:_clampToScreen()
	end
end

function Window:SetKeybind(key)
	key = toKeyCode(key)
	if not key then
		return
	end
	self.Keybind = key
	self._keyChipLabel.Text = keyDisplayName(key)
end

function Window:SetTitle(text)
	self._titleLabel.Text = tostring(text)
end

function Window:SetSubtitle(text)
	self._subtitleLabel.Text = tostring(text)
end

function Window:SetIcon(icon)
	setIcon(self._logo, icon)
end

function Window:SetTheme(themeInput)
	return Nucleus:SetTheme(themeInput)
end

function Window:SetScale(scale)
	self._userScale = math.clamp(tonumber(scale) or 1, 0.5, 1.5)
	self:_fitToScreen()
	self:_clampToScreen()
end

function Window:GetScale()
	return self._userScale or 1
end

function Window:_registerKeybind(entry)
	table.insert(self._keybinds, entry)
end

function Window:_showTooltip(text, owner)
	if IS_TOUCH then
		return
	end
	self._tooltipOwner = owner
	self._tooltipGeneration = (self._tooltipGeneration or 0) + 1
	local generation = self._tooltipGeneration
	task.delay(0.35, function()
		if self._destroyed or self._tooltipGeneration ~= generation or self._tooltipOwner ~= owner or not self.Open then
			return
		end
		if typeof(owner) == "Instance" then
			local current = owner
			while current and current ~= self.Gui do
				if current:IsA("GuiObject") and not current.Visible then
					return
				end
				current = current.Parent
			end
			if current ~= self.Gui then
				return
			end
		end
		self._tooltipLabel.Text = tostring(text)
		self._tooltip.Visible = true
		task.spawn(function()
			while self._tooltip.Visible and self._tooltipGeneration == generation and not self._destroyed do
				task.wait(0.25)
				if typeof(owner) == "Instance" and (not owner.Parent or not owner.Visible) then
					self:_hideTooltip(owner)
				end
			end
		end)
	end)
end

function Window:_hideTooltip(owner)
	if owner and owner ~= self._tooltipOwner then
		return
	end
	self._tooltipOwner = nil
	self._tooltipGeneration = (self._tooltipGeneration or 0) + 1
	if self._tooltip then
		self._tooltip.Visible = false
	end
end

Const.MAX_SEARCH_RESULTS = 40

function Window:_runSearch(text)
	local results = self._searchResults
	if not results then
		return
	end
	for _, child in ipairs(results:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end

	local query = string.lower((text or ""):match("^%s*(.-)%s*$"))
	if query == "" then
		results.Visible = false
		self.TabList.Visible = true
		if self.CurrentTab and self._introDone then
			self:_placeIndicator(self.CurrentTab)
		end
		return
	end

	results.Visible = true
	self.TabList.Visible = false
	self.Indicator.Visible = false

	local matches = {}
	for _, tab in ipairs(self.Tabs) do
		if not tab._userHidden and string.find(string.lower(tab.Name), query, 1, true) then
			table.insert(matches, { Title = tab.Name, Subtitle = "Tab", Tab = tab })
		end
	end
	for _, entry in ipairs(self._searchIndex) do
		if #matches >= Const.MAX_SEARCH_RESULTS then
			break
		end
		local element = entry.Element
		if not element._destroyed and entry.Frame.Parent and element.Visible ~= false
			and not (entry.Tab and entry.Tab._userHidden)
			and string.find(string.lower(entry.Name), query, 1, true)
		then
			table.insert(matches, {
				Title = entry.Name,
				Subtitle = entry.Tab.Name,
				Tab = entry.Tab,
				Group = entry.Group,
				Frame = entry.Frame,
			})
		end
	end

	if #matches == 0 then
		createLabel({
			Size = UDim2.new(1, 0, 0, 30),
			Text = "No results",
			TextSize = 13,
			FontFace = Fonts.Regular,
			TextColor3 = Theme.Muted,
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = results,
		})
		return
	end

	for order, match in ipairs(matches) do
		local row = create("TextButton", {
			Size = UDim2.new(1, 0, 0, 40),
			BackgroundColor3 = Theme.Surface2,
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = order,
			Parent = results,
		})
		addCorner(row)
		local rowStroke = addStroke(row, Theme.Stroke, 1)
		createLabel({
			Position = UDim2.fromOffset(12, 5),
			Size = UDim2.new(1, -20, 0, 16),
			Text = match.Title,
			TextSize = 13,
			Parent = row,
		})
		createLabel({
			Position = UDim2.fromOffset(12, 21),
			Size = UDim2.new(1, -20, 0, 14),
			Text = match.Subtitle,
			TextSize = 11,
			FontFace = Fonts.Regular,
			TextColor3 = Theme.Muted,
			Parent = row,
		})
		row.MouseEnter:Connect(function()
			if IS_TOUCH then
				return
			end
			tween(row, { BackgroundTransparency = 0.4 }, 0.12)
			tween(rowStroke, { Transparency = 0.5 }, 0.12)
		end)
		row.MouseLeave:Connect(function()
			tween(row, { BackgroundTransparency = 1 }, 0.2)
			tween(rowStroke, { Transparency = 1 }, 0.2)
		end)
		row.MouseButton1Click:Connect(function()
			self:_jumpTo(match)
		end)
	end
end

function Window:_jumpTo(match)
	if self._searchBox then
		self._searchBox.Text = ""
	end
	self:SelectTab(match.Tab)

	local group = match.Group
	while group do
		if not group.Open then
			group:SetOpen(true)
		end
		group = group._parentGroup
	end

	local frame = match.Frame
	if not frame then
		return
	end
	task.delay(0.4, function()
		if self._destroyed or not frame.Parent then
			return
		end
		local list = match.Tab.List
		local offset = (frame.AbsolutePosition.Y - list.AbsolutePosition.Y) / self.Scale.Scale
		local targetY = math.max(list.CanvasPosition.Y + offset - 12, 0)
		tween(list, { CanvasPosition = Vector2.new(0, targetY) }, 0.35, Enum.EasingStyle.Quint)
		task.delay(0.3, function()
			for _, child in ipairs(frame:GetChildren()) do
				if child:IsA("UIStroke") then
					flashStroke(child)
					task.delay(0.5, function()
						flashStroke(child)
					end)
					break
				end
			end
		end)
	end)
end

function Window:Search(text)
	if self._searchBox then
		self._searchBox.Text = tostring(text or "")
	end
end

local function createOverlayPanel(window, position, width, plain)
	local panel = create("Frame", {
		Position = position,
		Size = UDim2.fromOffset(width or 0, 0),
		AutomaticSize = width and Enum.AutomaticSize.Y or Enum.AutomaticSize.XY,
		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,
		ZIndex = 50,
		Parent = window.Gui,
	})
	addCorner(panel, UDim.new(0, 8))
	addStroke(panel)
	if not plain then
		addTopHighlight(panel)
	end
	table.insert(window._overlays, panel)
	return panel
end

function Window:Watermark(input)
	local options = normalizeOptions(input, { Name = "Text", Title = "Text" })
	local showFps = options.ShowFPS ~= false
	local showPing = options.ShowPing ~= false
	local showTime = options.ShowTime ~= false

	local panel = createOverlayPanel(self, options.Position or UDim2.fromOffset(16, math.floor(getTopbarHeight()) + 10), nil, true)
	panel.Size = UDim2.fromOffset(0, 30)
	panel.AutomaticSize = Enum.AutomaticSize.X
	addPadding(panel, 10, 12)
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		Parent = panel,
	})

	local icon = create("ImageLabel", {
		Size = UDim2.fromOffset(20, 20),
		BackgroundTransparency = 1,
		ImageColor3 = logoColor(options.Icon),
		ScaleType = Enum.ScaleType.Fit,
		LayoutOrder = 1,
		ZIndex = 51,
		Parent = panel,
	})
	setLogo(icon, options.Icon)

	local label = createLabel({
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		TextSize = 13,
		TextTruncate = Enum.TextTruncate.None,
		LayoutOrder = 2,
		ZIndex = 51,
		Parent = panel,
	})

	local watermark = { Frame = panel, Visible = true }
	local textSource = options.Text or self._titleLabel.Text
	local frames, fps = 0, 0
	local stopRender = self:_listen("Render", function()
		frames += 1
	end)

	local function render()
		local parts = {}
		local base = textSource
		if type(base) == "function" then
			local ok, value = pcall(base)
			base = ok and value or ""
		end
		if base ~= nil and tostring(base) ~= "" then
			table.insert(parts, tostring(base))
		end
		if showFps then
			table.insert(parts, fps .. " fps")
		end
		if showPing then
			local ok, ping = pcall(function()
				return math.floor(LocalPlayer:GetNetworkPing() * 1000)
			end)
			table.insert(parts, (ok and ping or 0) .. " ms")
		end
		if showTime then
			table.insert(parts, os.date(options.TimeFormat or "%H:%M"))
		end
		label.Text = table.concat(parts, "  •  ")
	end

	function watermark:SetText(text)
		textSource = text
		render()
	end

	function watermark:SetVisible(visible)
		watermark.Visible = visible ~= false
		panel.Visible = watermark.Visible
	end

	function watermark:Destroy()
		stopRender()
		panel:Destroy()
	end

	self:_makeDraggable(panel)
	render()

	task.spawn(function()
		local last = os.clock()
		while not self._destroyed and panel.Parent do
			task.wait(1)
			local now = os.clock()
			fps = math.floor(frames / math.max(now - last, 0.001) + 0.5)
			frames, last = 0, now
			if panel.Visible then
				render()
			end
		end
	end)

	if options.Visible == false then
		watermark:SetVisible(false)
	end
	return watermark
end

function Window:KeybindList(input)
	local options = normalizeOptions(input, { Name = "Title" })
	local activeOnly = options.ActiveOnly == true

	local panel = createOverlayPanel(self, options.Position or UDim2.new(0, 16, 0.5, -80), 210, true)
	addPadding(panel, 12, 12, 10, 10)
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6),
		Parent = panel,
	})

	local headerRow = create("Frame", {
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		ZIndex = 51,
		Parent = panel,
	})
	createIcon(headerRow, "keyboard", Theme.Accent, UDim2.new(0, 0, 0.5, 0))
	createLabel({
		Position = UDim2.fromOffset(24, 0),
		Size = UDim2.new(1, -24, 1, 0),
		Text = options.Title or "Keybinds",
		TextSize = 13,
		ZIndex = 51,
		Parent = headerRow,
	})
	create("Frame", {
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = Theme.Stroke,
		BorderSizePixel = 0,
		LayoutOrder = 2,
		ZIndex = 51,
		Parent = panel,
	})

	local rowsHolder = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 3,
		ZIndex = 51,
		Parent = panel,
	})
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 4),
		Parent = rowsHolder,
	})

	local list = { Frame = panel, Visible = true }
	local lastSignature

	local function refresh()
		local entries = {}
		local signatureParts = {}
		for _, entry in ipairs(self._keybinds) do
			local key = entry.GetKey()
			if key and not entry.Element._destroyed then
				local active = entry.GetActive()
				if not activeOnly or active then
					table.insert(entries, { Name = entry.Name, Key = key, Active = active })
					table.insert(signatureParts, entry.Name .. key.Name .. tostring(active))
				end
			end
		end
		local signature = table.concat(signatureParts, "|")
		if signature == lastSignature then
			return
		end
		lastSignature = signature

		for _, child in ipairs(rowsHolder:GetChildren()) do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end

		if #entries == 0 then
			createLabel({
				Size = UDim2.new(1, 0, 0, 18),
				Text = activeOnly and "Nothing active" or "No keybinds",
				TextSize = 12,
				FontFace = Fonts.Regular,
				TextColor3 = Theme.Muted,
				ZIndex = 51,
				Parent = rowsHolder,
			})
			return
		end

		for order, entry in ipairs(entries) do
			local row = create("Frame", {
				Size = UDim2.new(1, 0, 0, 18),
				BackgroundTransparency = 1,
				LayoutOrder = order,
				ZIndex = 51,
				Parent = rowsHolder,
			})
			createLabel({
				Size = UDim2.new(1, -70, 1, 0),
				Text = entry.Name,
				TextSize = 12,
				FontFace = Fonts.Regular,
				TextColor3 = entry.Active and Theme.Text or Theme.Muted,
				ZIndex = 51,
				Parent = row,
			})
			createLabel({
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, 0, 0, 0),
				Size = UDim2.new(0, 70, 1, 0),
				Text = "[" .. keyDisplayName(entry.Key) .. "]",
				TextSize = 12,
				TextColor3 = entry.Active and Theme.Accent or Theme.Muted,
				TextXAlignment = Enum.TextXAlignment.Right,
				ZIndex = 51,
				Parent = row,
			})
		end
	end

	function list:SetVisible(visible)
		list.Visible = visible ~= false
		panel.Visible = list.Visible
	end

	function list:Refresh()
		lastSignature = nil
		refresh()
	end

	function list:Destroy()
		panel:Destroy()
	end

	self:_makeDraggable(panel)
	refresh()

	task.spawn(function()
		while not self._destroyed and panel.Parent do
			task.wait(0.2)
			if panel.Visible then
				refresh()
			end
		end
	end)

	if options.Visible == false then
		list:SetVisible(false)
	end
	return list
end

local NOTIFY_POSITIONS = {
	TopRight = { Anchor = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 16), Bottom = false, Side = 1 },
	BottomRight = { Anchor = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -16), Bottom = true, Side = 1 },
	TopLeft = { Anchor = Vector2.new(0, 0), Position = UDim2.new(0, 16, 0, 16), Bottom = false, Side = -1 },
	BottomLeft = { Anchor = Vector2.new(0, 1), Position = UDim2.new(0, 16, 1, -16), Bottom = true, Side = -1 },
	Top = { Anchor = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, IS_TOUCH and 64 or 16), Bottom = false, Side = 0 },
	Bottom = { Anchor = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -16), Bottom = true, Side = 0 },
}

Const.DEFAULT_NOTIFY_POSITION = IS_TOUCH and "TopRight" or "BottomRight"
Const.NOTIFY_WIDTH = 300

local function applyNotifyPosition(host, positionName)
	local layout = NOTIFY_POSITIONS[positionName] or NOTIFY_POSITIONS[Const.DEFAULT_NOTIFY_POSITION]
	host.Position = NOTIFY_POSITIONS[positionName] and positionName or Const.DEFAULT_NOTIFY_POSITION
	host.Layout = layout
	host.Holder.AnchorPoint = layout.Anchor
	host.Holder.Position = layout.Position
	host.ListLayout.VerticalAlignment = layout.Bottom and Enum.VerticalAlignment.Bottom or Enum.VerticalAlignment.Top
end

createNotifyHost = function(screenGui, connections, maxCount, positionName)
	local holder = create("Frame", {
		Name = "Notifications",
		Size = UDim2.new(0, Const.NOTIFY_WIDTH, 1, -32),
		BackgroundTransparency = 1,
		ZIndex = 80,
		Parent = screenGui,
	})
	local listLayout = create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6),
		Parent = holder,
	})
	if IS_TOUCH then
		create("UIScale", { Scale = 0.85, Parent = holder })
	end
	local host = {
		Holder = holder,
		ListLayout = listLayout,
		Toasts = {},
		Order = 0,
		MaxNotifications = math.clamp(math.floor(tonumber(maxCount) or 4), 1, 10),
	}
	local function fit()
		local screen = screenGui.AbsoluteSize
		if screen.X > 0 then
			local topOffset = (host.Layout and host.Layout.Position.Y.Offset or 16)
			holder.Size = UDim2.new(0, math.min(Const.NOTIFY_WIDTH, screen.X - 24), 1, -(math.abs(topOffset) + 16))
		end
	end
	table.insert(connections, screenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit))
	applyNotifyPosition(host, positionName)
	fit()
	host.Fit = fit
	return host
end

local function toastKey(options)
	return tostring(options.Title) .. "\0" .. tostring(options.Content) .. "\0" .. tostring(options.Type)
end

local function showToast(host, input)
	local options = normalizeOptions(input, { Text = "Content", Message = "Content", Image = "Icon" })
	local isLoading = options.Type == "Loading"

	if not isLoading and options.Merge ~= false then
		local key = toastKey(options)
		for _, existing in ipairs(host.Toasts) do
			if existing._key == key and not existing._dismissed then
				existing:_bump()
				return existing
			end
		end
	end

	local toast = { _key = toastKey(options) }
	host.Order += 1
	local layout = host.Layout
	local slideOffset = layout.Side ~= 0 and layout.Side * (Const.NOTIFY_WIDTH + 24) or 0
	local slideY = layout.Side == 0 and (layout.Bottom and 30 or -30) or 0

	local slot = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundTransparency = 1,
		LayoutOrder = layout.Bottom and host.Order or -host.Order,
		Parent = host.Holder,
	})
	local slider = create("Frame", {
		Position = UDim2.fromOffset(slideOffset, slideY),
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = slot,
	})
	local shadow = create("ImageLabel", {
		Position = UDim2.fromOffset(-20, -20),
		Size = UDim2.new(1, 40, 1, 40),
		BackgroundTransparency = 1,
		Image = Assets.Shadow,
		ImageColor3 = Color3.new(0, 0, 0),
		ImageTransparency = 1,
		ScaleType = Enum.ScaleType.Slice,
		SliceCenter = Rect.new(49, 49, 450, 450),
		ZIndex = 0,
		Parent = slider,
	})
	local card = create("CanvasGroup", {
		Name = "Toast",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,
		GroupTransparency = 1,
		Parent = slider,
	})
	addCorner(card, UDim.new(0, 10))
	local cardStroke = addStroke(card, Theme.Stroke)
	addTopHighlight(card)

	local inner = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = card,
	})
	addPadding(inner, 12, 12, 12, 14)
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		Parent = inner,
	})

	local topRow = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = inner,
	})

	local iconTile = create("Frame", {
		Size = UDim2.fromOffset(30, 30),
		BackgroundColor3 = Theme.Accent,
		BackgroundTransparency = 0.85,
		BorderSizePixel = 0,
		Parent = topRow,
	})
	addCorner(iconTile, UDim.new(0, 8))
	local iconImage = create("ImageLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(16, 16),
		BackgroundTransparency = 1,
		ScaleType = Enum.ScaleType.Fit,
		Parent = iconTile,
	})

	local textColumn = create("Frame", {
		Position = UDim2.fromOffset(40, 0),
		Size = UDim2.new(1, -66, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = topRow,
	})
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 3),
		Parent = textColumn,
	})
	local titleRow = create("Frame", {
		Size = UDim2.new(1, 0, 0, 16),
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = textColumn,
	})
	local titleLabel = createLabel({
		Size = UDim2.new(1, -36, 1, 0),
		Text = "",
		TextSize = 14,
		Parent = titleRow,
	})
	local countBadge = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(0, 16),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Theme.Surface3,
		BorderSizePixel = 0,
		Visible = false,
		Parent = titleRow,
	})
	addCorner(countBadge, UDim.new(1, 0))
	addPadding(countBadge, 6, 6)
	local countLabel = createLabel({
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = "",
		TextSize = 11,
		TextColor3 = Theme.Text,
		TextTruncate = Enum.TextTruncate.None,
		Parent = countBadge,
	})
	local contentLabel = createLabel({
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Text = "",
		TextSize = 13,
		FontFace = Fonts.Regular,
		TextColor3 = Theme.Muted,
		TextWrapped = true,
		TextTruncate = Enum.TextTruncate.None,
		TextYAlignment = Enum.TextYAlignment.Top,
		LayoutOrder = 2,
		Parent = textColumn,
	})

	local dismissButton = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 4, 0, -4),
		Size = UDim2.fromOffset(IS_TOUCH and 30 or 22, IS_TOUCH and 30 or 22),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = topRow,
	})
	setIcon(create("ImageLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(13, 13),
		BackgroundTransparency = 1,
		ImageColor3 = Theme.Muted,
		ScaleType = Enum.ScaleType.Fit,
		Parent = dismissButton,
	}), "x")

	local buttonRow
	if type(options.Buttons) == "table" and #options.Buttons > 0 then
		buttonRow = create("Frame", {
			Size = UDim2.new(1, 0, 0, IS_TOUCH and 32 or 28),
			BackgroundTransparency = 1,
			LayoutOrder = 2,
			Parent = inner,
		})
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 6),
			Parent = buttonRow,
		})
	end

	local timerTrack = create("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 12, 1, -6),
		Size = UDim2.new(1, -24, 0, 2),
		BackgroundColor3 = Theme.Surface3,
		BorderSizePixel = 0,
		Parent = card,
	})
	addCorner(timerTrack, UDim.new(1, 0))
	local timerFill = create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Parent = timerTrack,
	})
	addCorner(timerFill, UDim.new(1, 0))

	local duration, remaining, persistent = 4, 4, false
	local paused, holding = false, false
	local spinning = false

	local function setDuration(value, loading)
		if value == nil then
			if loading then
				value = false
			else
				value = 4
			end
		end
		persistent = value == false or (type(value) == "number" and (value <= 0 or value == math.huge))
		duration = type(value) == "number" and value > 0 and value ~= math.huge and value or 4
		remaining = duration
		timerTrack.Visible = not persistent
		timerFill.Size = UDim2.fromScale(1, 1)
	end

	local function paint(data)
		local kind = data.Type
		local colorKey = Const.NOTIFY_TYPES[kind] or (kind == "Loading" and "Accent") or "Accent"
		local color = Theme[colorKey] or Theme.Accent
		iconTile.BackgroundColor3 = color
		iconImage.ImageColor3 = color
		timerFill.BackgroundColor3 = color
		titleLabel.TextColor3 = (kind and kind ~= "Info" and kind ~= "Loading") and color or Theme.Text

		local icon = data.Icon
		if icon == nil then
			icon = kind == "Loading" and "loader-circle" or Const.NOTIFY_ICONS[kind] or "bell"
		end
		local hasIcon = icon ~= false and setIcon(iconImage, icon)
		iconTile.Visible = hasIcon
		textColumn.Position = UDim2.fromOffset(hasIcon and 40 or 0, 0)
		textColumn.Size = UDim2.new(1, hasIcon and -66 or -26, 0, 0)
		spinning = kind == "Loading" and hasIcon
		if not spinning then
			iconImage.Rotation = 0
		end

		setTranslated(titleLabel, "Text", tostring(data.Title or "Notification"))
		local content = data.Content
		contentLabel.Visible = content ~= nil and tostring(content) ~= ""
		setTranslated(contentLabel, "Text", content ~= nil and tostring(content) or "")
	end

	paint(options)
	setDuration(options.Duration, isLoading)

	if buttonRow then
		for order, buttonDef in ipairs(options.Buttons) do
			local primary = buttonDef.Primary == true or buttonDef.Variant == "Primary"
			local button = create("TextButton", {
				Size = UDim2.fromOffset(0, IS_TOUCH and 32 or 28),
				AutomaticSize = Enum.AutomaticSize.X,
				BackgroundColor3 = primary and Theme.Accent or Theme.Surface2,
				Text = "",
				AutoButtonColor = false,
				LayoutOrder = order,
				Parent = buttonRow,
			})
			addCorner(button, UDim.new(0, 6))
			if not primary then
				addStroke(button)
			end
			addPadding(button, 12, 12)
			createLabel({
				Size = UDim2.new(0, 0, 1, 0),
				AutomaticSize = Enum.AutomaticSize.X,
				Text = tostring(buttonDef.Title or buttonDef.Name or "OK"),
				TextSize = 12,
				TextColor3 = primary and Theme.AccentDark or Theme.Text,
				TextTruncate = Enum.TextTruncate.None,
				Parent = button,
			})
			button.MouseButton1Click:Connect(function()
				runProtected(('notification button "%s"'):format(tostring(buttonDef.Title or buttonDef.Name or "Button")), buttonDef.Callback)
				if buttonDef.Close ~= false then
					toast:Dismiss()
				end
			end)
		end
	end

	if options.Sound then
		pcall(function()
			local sound = Instance.new("Sound")
			sound.SoundId = tostring(options.Sound)
			sound.Volume = tonumber(options.Volume) or 0.5
			sound.Parent = host.Holder
			sound:Play()
			task.delay(5, function()
				sound:Destroy()
			end)
		end)
	end

	local count = 1
	local dragConnections = {}
	toast._dismissed = false

	function toast:Dismiss(direction)
		if toast._dismissed then
			return
		end
		toast._dismissed = true
		local index = table.find(host.Toasts, toast)
		if index then
			table.remove(host.Toasts, index)
		end
		for _, connection in ipairs(dragConnections) do
			connection:Disconnect()
		end
		if instantUI() then
			slot:Destroy()
			safeCall(options.OnClose)
			return
		end
		local outX = direction or (layout.Side ~= 0 and layout.Side * (Const.NOTIFY_WIDTH + 24) or 0)
		tween(slider, { Position = UDim2.fromOffset(outX, slideY) }, 0.3, Enum.EasingStyle.Quint)
		tween(card, { GroupTransparency = 1 }, 0.2)
		tween(cardStroke, { Transparency = 1 }, 0.15)
		tween(shadow, { ImageTransparency = 1 }, 0.2)
		task.delay(0.22, function()
			if not slot.Parent then
				return
			end
			slot.ClipsDescendants = true
			tween(slot, { Size = UDim2.new(1, 0, 0, 0) }, 0.22, Enum.EasingStyle.Quint)
			task.delay(0.24, function()
				slot:Destroy()
			end)
		end)
		safeCall(options.OnClose)
	end

	function toast:Update(changes)
		if toast._dismissed or type(changes) ~= "table" then
			return
		end
		for key, value in pairs(changes) do
			options[key] = value
		end
		paint(options)
		if changes.Duration ~= nil or changes.Type ~= nil then
			setDuration(options.Duration, options.Type == "Loading")
		end
		toast._key = toastKey(options)
	end

	function toast:SetProgress(alpha)
		timerTrack.Visible = true
		persistent = true
		timerFill.Size = UDim2.fromScale(math.clamp(tonumber(alpha) or 0, 0, 1), 1)
	end

	function toast:_bump()
		count += 1
		countBadge.Visible = true
		countLabel.Text = "×" .. count
		remaining = duration
	end

	toast.Close = toast.Dismiss

	local hoverTargets = { card, dismissButton }
	for _, target in ipairs(hoverTargets) do
		target.MouseEnter:Connect(function()
			if IS_TOUCH then
				return
			end
			paused = true
		end)
		target.MouseLeave:Connect(function()
			paused = false
		end)
	end
	dismissButton.MouseButton1Click:Connect(function()
		toast:Dismiss()
	end)

	local dragStart, dragging, moved = nil, false, false
	card.InputBegan:Connect(function(inputObject)
		if isPress(inputObject) then
			dragStart = getMousePosition()
			dragging, moved, holding = true, false, true
		end
	end)
	table.insert(dragConnections, UserInputService.InputChanged:Connect(function(inputObject)
		if not dragging or not isMove(inputObject) then
			return
		end
		local dx = getMousePosition().X - dragStart.X
		if math.abs(dx) > 6 then
			moved = true
		end
		if moved then
			slider.Position = UDim2.fromOffset(dx, 0)
			if card:IsA("CanvasGroup") then
				card.GroupTransparency = math.clamp(math.abs(dx) / 220, 0, 0.6)
			end
		end
	end))
	table.insert(dragConnections, UserInputService.InputEnded:Connect(function(inputObject)
		if not dragging or not isPress(inputObject) then
			return
		end
		dragging, holding = false, false
		local dx = getMousePosition().X - dragStart.X
		if moved and math.abs(dx) > 70 then
			toast:Dismiss((dx > 0 and 1 or -1) * (Const.NOTIFY_WIDTH + 40))
		elseif moved then
			tween(slider, { Position = UDim2.fromOffset(0, 0) }, 0.25, Enum.EasingStyle.Quint)
			tween(card, { GroupTransparency = 0 }, 0.2)
		elseif type(options.Callback) == "function" then
			runProtected(('notification "%s"'):format(tostring(options.Title or "")), options.Callback)
			toast:Dismiss()
		end
	end))

	task.defer(function()
		if slot.Parent then
			tween(slot, { Size = UDim2.new(1, 0, 0, card.AbsoluteSize.Y) }, 0.3, Enum.EasingStyle.Quint)
		end
	end)
	local settled = false
	task.delay(0.32, function()
		settled = true
		if slot.Parent and not toast._dismissed then
			slot.Size = UDim2.new(1, 0, 0, card.AbsoluteSize.Y)
		end
	end)
	card:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if settled and slot.Parent and not toast._dismissed then
			slot.Size = UDim2.new(1, 0, 0, card.AbsoluteSize.Y)
		end
	end)

	tween(slider, { Position = UDim2.fromOffset(0, 0) }, 0.45, Enum.EasingStyle.Quint)
	tween(card, { GroupTransparency = 0 }, 0.3)
	tween(shadow, { ImageTransparency = 0.6 }, 0.4)

	task.spawn(function()
		while slot.Parent and not toast._dismissed do
			local elapsed = task.wait(0.05) or 0.05
			if spinning then
				iconImage.Rotation = (iconImage.Rotation + elapsed * 360) % 360
			end
			if not persistent and not paused and not holding then
				remaining -= elapsed
				timerFill.Size = UDim2.fromScale(math.clamp(remaining / duration, 0, 1), 1)
				if remaining <= 0 then
					toast:Dismiss()
				end
			end
		end
	end)

	table.insert(host.Toasts, toast)
	while #host.Toasts > host.MaxNotifications do
		local oldest = host.Toasts[1]
		oldest:Dismiss()
		if host.Toasts[1] == oldest then
			table.remove(host.Toasts, 1)
		end
	end

	return toast
end

function Window:Notify(input)
	local entry = { Time = os.time() }
	if type(input) == "table" then
		entry.Title = tostring(input.Title or input.Name or "")
		entry.Content = tostring(input.Content or input.Text or input.Message or "")
		entry.Type = input.Type
	else
		entry.Title = tostring(input or "")
		entry.Content = ""
	end
	self._notifyHistory = self._notifyHistory or {}
	table.insert(self._notifyHistory, 1, entry)
	if #self._notifyHistory > 50 then
		table.remove(self._notifyHistory)
	end
	return showToast(self._notifyHost, input)
end

function Window:SetNotificationPosition(positionName)
	applyNotifyPosition(self._notifyHost, positionName)
	self._notifyHost.Fit()
end

local fallbackHost
function Nucleus:_notifyFallback(input)
	if not fallbackHost or not fallbackHost.Holder.Parent then
		local screenGui = create("ScreenGui", {
			Name = Const.GUI_NAME .. "Notifications",
			IgnoreGuiInset = true,
			ResetOnSpawn = false,
			DisplayOrder = 1000,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
			Parent = getGuiParent(),
		})
		fallbackHost = createNotifyHost(screenGui, {}, 4, Nucleus.NotificationPosition)
		table.insert(Nucleus._cleanup, function()
			fallbackHost = nil
			screenGui:Destroy()
		end)
	end
	return showToast(fallbackHost, input)
end

Nucleus._showErrorToast = function(entry)
	local where = entry.Where or "a callback"
	Nucleus:Notify({
		Title = "Something went wrong",
		Content = ("In %s: %s"):format(where, entry.Summary or entry.Message or "unknown error"),
		Type = "Error",
		Duration = 8,
		Buttons = {
			{
				Title = "Copy details",
				Callback = function()
					Nucleus:Copy(("Nucleus UI %s\nWhere: %s\nError: %s\n%s"):format(
						Nucleus.Version, where, tostring(entry.Raw), tostring(entry.Traceback or "")))
				end,
			},
		},
	})
end

function Window:Destroy()
	if self._destroyed then
		return
	end
	if self._resetOnUnload then
		self._autoSaveEnabled = false
		for _, element in ipairs(table.clone(self._elements)) do
			if element._type == "Toggle" and element.Value == true and not element._destroyed then
				pcall(element.Set, element, false)
			end
		end
	end
	self._destroyed = true
	for _, loop in ipairs(self._loops) do
		loop.Running = false
	end
	for _, callback in ipairs(self._events.Destroy) do
		task.spawn(safeCall, callback)
	end

	local index = table.find(Nucleus.Windows, self)
	if index then
		table.remove(Nucleus.Windows, index)
	end

	for _, connection in ipairs(self._connections) do
		connection:Disconnect()
	end
	self._connections = {}

	for _, listeners in pairs(self._inputListeners) do
		table.clear(listeners)
	end
	table.clear(self._frameSteps)

	for flag, element in pairs(self.Flags) do
		if Nucleus.Flags[flag] == element then
			Nucleus.Flags[flag] = nil
		end
	end
	self.Flags = {}

	tween(self.Scale, { Scale = 0.9 }, 0.2)
	self:_fadeOut(0.2)
	tween(self.BodyStroke, { Transparency = 1 }, 0.12)
	tween(self.Shadow, { ImageTransparency = 1 }, 0.2)
	task.delay(0.22, function()
		self.Gui:Destroy()
	end)
end
local function installFeatures()

Const.ATTR_LOC_TEXT = "NucleusLocText"
Const.ATTR_LOC_PLACEHOLDER = "NucleusLocPlaceholderText"

function Nucleus:SetLocalization(settings)
	settings = type(settings) == "table" and settings or {}
	if type(settings.Prefix) == "string" then
		Localization.Prefix = settings.Prefix
	end
	if type(settings.Default) == "string" then
		Localization.Default = settings.Default
	end
	if type(settings.Translations) == "table" then
		for language, pack in pairs(settings.Translations) do
			Localization.Translations[language] = Localization.Translations[language] or {}
			for key, text in pairs(pack) do
				Localization.Translations[language][key] = text
			end
		end
	end
	Nucleus:SetLanguage(settings.Language or Localization.Language)
end

function Nucleus:SetLanguage(language)
	Localization.Language = tostring(language or Localization.Default)
	local prefix = Localization.Prefix
	for _, window in ipairs(Nucleus.Windows) do
		if window.Gui then
			for _, descendant in ipairs(window.Gui:GetDescendants()) do
				local textKey = descendant:GetAttribute(Const.ATTR_LOC_TEXT)
				if textKey then
					setTranslated(descendant, "Text", prefix .. textKey)
				end
				local placeholderKey = descendant:GetAttribute(Const.ATTR_LOC_PLACEHOLDER)
				if placeholderKey then
					setTranslated(descendant, "PlaceholderText", prefix .. placeholderKey)
				end
			end
		end
	end
end

function Nucleus:GetLanguage()
	return Localization.Language
end

function Nucleus:Translate(key)
	return (translate(Localization.Prefix .. tostring(key)))
end

function Window:OnOpen(callback)
	table.insert(self._events.Open, callback)
end

function Window:OnClose(callback)
	table.insert(self._events.Close, callback)
end

function Window:OnDestroy(callback)
	table.insert(self._events.Destroy, callback)
end

function Window:Show()
	self:Toggle(true)
end

function Window:Hide()
	self:Toggle(false)
end

Window.SetToggleKey = Window.SetKeybind

function Window:SetSize(size)
	local vector = Nucleus._toVector2(size)
	if not vector then
		return
	end
	size = UDim2.fromOffset(math.max(vector.X, 300), math.max(vector.Y, 220))
	self._baseSize = Vector2.new(size.X.Offset, size.Y.Offset)
	tween(self.Root, { Size = size }, 0.25, Enum.EasingStyle.Quint)
	task.delay(0.26, function()
		if not self._destroyed then
			self:_fitToScreen()
			self:_clampToScreen()
		end
	end)
end

function Window:SetResizable(enabled)
	if self._grip then
		self._grip.Visible = enabled ~= false
	end
end

function Window:GetElements()
	local alive = {}
	for _, element in ipairs(self._elements) do
		if not element._destroyed then
			table.insert(alive, element)
		end
	end
	return alive
end

function Window:GetLockedElements()
	local locked = {}
	for _, element in ipairs(self:GetElements()) do
		if element.Locked then
			table.insert(locked, element)
		end
	end
	return locked
end

function Window:LockAll(reason)
	for _, element in ipairs(self:GetElements()) do
		if type(element.SetLocked) == "function" and element._type ~= "Section" and element._type ~= "Divider" then
			element:SetLocked(true, reason)
		end
	end
end

function Window:UnlockAll()
	for _, element in ipairs(self:GetElements()) do
		if element.Locked and type(element.SetLocked) == "function" then
			element:SetLocked(false)
		end
	end
end

function Window:SetAnonymous(enabled)
	self._anonymous = enabled == true
	if self._profileName then
		self._profileName.Text = self._anonymous and "Anonymous" or LocalPlayer.DisplayName
	end
	if self._avatar then
		self._avatar.Image = (not self._anonymous and self._avatarImage) or ""
	end
end

function Window:SetBackground(image, transparency)
	if not self._background then
		self._background = create("ImageLabel", {
			Name = "Background",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			ScaleType = Enum.ScaleType.Crop,
			ImageTransparency = 1,
			ZIndex = 0,
			Parent = self.Body,
		})
		addCorner(self._background, UDim.new(0, Appearance.WindowRadius))
		self._background:SetAttribute(Const.ATTR_NO_THEME, true)
	end
	if image == nil or image == false or image == "" then
		self._background.Image = ""
		return
	end
	setIcon(self._background, image)
	self._background.ImageTransparency = tonumber(transparency) or 0.85
end

function Window:TabSection(input)
	local options = normalizeOptions(input, { Name = "Title" })
	self._sectionCount += 1
	local section = {
		Title = options.Title or "Section",
		Tabs = {},
		Opened = options.Opened ~= false,
		Window = self,
		_base = self._sectionCount * 1000,
		_count = 0,
	}

	local header = create("TextButton", {
		Name = "TabSection",
		Size = UDim2.new(1, 0, 0, 38),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = section._base,
		Parent = self.TabList,
	})
	local inner = create("Frame", {
		Position = UDim2.fromOffset(0, 12),
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundTransparency = 1,
		Parent = header,
	})
	local textLeft = 12
	if options.Icon then
		createIcon(inner, options.Icon, Theme.Muted, UDim2.new(0, 12, 0.5, 0))
		textLeft = 36
	end
	local titleLabel = createLabel({
		Name = "Title",
		Position = UDim2.fromOffset(textLeft, 0),
		Size = UDim2.new(1, -(textLeft + 24), 1, 0),
		Text = section.Title,
		TextSize = 12,
		FontFace = Fonts.Bold,
		TextColor3 = Theme.Muted,
		Parent = inner,
	})
	local chevron = createChevron(inner, 1, -4)
	local countLabel = createLabel({
		Name = "Count",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -28, 0.5, 0),
		Size = UDim2.fromOffset(28, 18),
		Text = "",
		TextSize = 11,
		FontFace = Fonts.Bold,
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Right,
		Visible = false,
		Parent = inner,
	})
	titleLabel.Size = UDim2.new(1, -(textLeft + 58), 1, 0)

	function section:_refreshCount()
		local count = #section.Tabs
		countLabel.Text = tostring(count)
		countLabel.Visible = not section.Opened and count > 0
	end
	section._header = header

	local function refreshIndicator()
		local current = self.CurrentTab
		if current and not self._destroyed then
			self:_placeIndicator(current)
		end
	end

	function section:SetOpen(open)
		section.Opened = open == true
		chevron:Set(section.Opened)
		for _, tab in ipairs(section.Tabs) do
			local show = section.Opened and not tab._userHidden
			tab._button:SetAttribute(Const.ATTR_HIDDEN, not show)
			if self.Window._introDone then
				tab._button.Visible = show
			end
		end
		section:_refreshCount()
		refreshIndicator()
	end

	function section:Toggle()
		section:SetOpen(not section.Opened)
	end

	function section:SetTitle(text)
		section.Title = tostring(text)
		setTranslated(titleLabel, "Text", section.Title)
	end

	function section:Tab(tabInput, icon)
		local tabOptions = normalizeOptions(tabInput, { Title = "Name", Description = "Desc" })
		tabOptions.Section = section
		return self.Window:Tab(tabOptions, icon)
	end
	section.CreateTab = section.Tab

	header.MouseButton1Click:Connect(function()
		section:Toggle()
	end)

	function section:_applyCompact(compact)
		header.Visible = not compact
		if compact then
			for _, tab in ipairs(section.Tabs) do
				tab._button:SetAttribute(Const.ATTR_HIDDEN, tab._userHidden == true)
				if section.Window._introDone then
					tab._button.Visible = not tab._userHidden
				end
			end
		else
			section:SetOpen(section.Opened)
		end
	end

	chevron:Set(section.Opened)
	self._sections = self._sections or {}
	table.insert(self._sections, section)
	if self._compact then
		section:_applyCompact(true)
	end
	self._currentSection = section
	return section
end
Window.CreateTabSection = Window.TabSection

function Window:_headerRow()
	if self._headerItems then
		return self._headerItems
	end
	local row = create("Frame", {
		Name = "HeaderItems",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, self._minimizeButton and -94 or -56, 0, 18),
		Size = UDim2.fromOffset(0, 24),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = self.Content,
	})
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6),
		Parent = row,
	})
	self._headerItems = row
	self._headerOrder = 0
	if self._layoutHeader then
		self:_layoutHeader()
	end
	return row
end

function Window:Tag(input)
	local options = normalizeOptions(input, { Name = "Title", Text = "Title" })
	local row = self:_headerRow()
	self._headerOrder += 1

	local color = options.Color or Theme.Accent
	local pill = create("Frame", {
		Size = UDim2.fromOffset(0, 22),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = color,
		BackgroundTransparency = 0.86,
		BorderSizePixel = 0,
		LayoutOrder = self._headerOrder,
		ZIndex = 5,
		Parent = row,
	})
	addCorner(pill, UDim.new(0, math.clamp(tonumber(options.Radius) or 11, 0, 11)))
	local pillStroke = addStroke(pill, color, 0.55)
	addPadding(pill, 8, 9)
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 5),
		Parent = pill,
	})
	local iconImage
	if options.Icon then
		iconImage = create("ImageLabel", {
			Size = UDim2.fromOffset(12, 12),
			BackgroundTransparency = 1,
			ImageColor3 = color,
			ScaleType = Enum.ScaleType.Fit,
			LayoutOrder = 1,
			ZIndex = 6,
			Parent = pill,
		})
		if not setIcon(iconImage, options.Icon) then
			iconImage:Destroy()
			iconImage = nil
		end
	end
	local label = createLabel({
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = tostring(options.Title or "Tag"),
		TextSize = 12,
		FontFace = Fonts.Bold,
		TextColor3 = color,
		TextTruncate = Enum.TextTruncate.None,
		LayoutOrder = 2,
		ZIndex = 6,
		Parent = pill,
	})

	local tag = { Frame = pill }
	function tag:SetTitle(text)
		setTranslated(label, "Text", tostring(text))
	end
	function tag:SetColor(newColor)
		pill.BackgroundColor3 = newColor
		pillStroke.Color = newColor
		label.TextColor3 = newColor
		if iconImage then
			iconImage.ImageColor3 = newColor
		end
	end
	function tag:Destroy()
		pill:Destroy()
	end
	return tag
end

function Window:HeaderButton(input)
	local options = normalizeOptions(input, {})
	local row = self:_headerRow()
	self._headerOrder += 1

	local button = create("TextButton", {
		Size = UDim2.fromOffset(26, 26),
		BackgroundColor3 = Theme.Surface2,
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = self._headerOrder,
		ZIndex = 5,
		Parent = row,
	})
	addCorner(button, UDim.new(0, 7))
	local image = create("ImageLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(15, 15),
		BackgroundTransparency = 1,
		ImageColor3 = Theme.Muted,
		ScaleType = Enum.ScaleType.Fit,
		ZIndex = 6,
		Parent = button,
	})
	setIcon(image, options.Icon or "circle")

	button.MouseEnter:Connect(function()
		if IS_TOUCH then
			return
		end
		tween(button, { BackgroundTransparency = 0 }, 0.15)
		tween(image, { ImageColor3 = Theme.Text }, 0.15)
		if options.Tooltip then
			self:_showTooltip(options.Tooltip, button)
		end
	end)
	button.MouseLeave:Connect(function()
		tween(button, { BackgroundTransparency = 1 }, 0.2)
		tween(image, { ImageColor3 = Theme.Muted }, 0.2)
		self:_hideTooltip(button)
	end)
	button.MouseButton1Click:Connect(function()
		runProtected(('header button "%s"'):format(tostring(options.Tooltip or options.Icon or "button")), options.Callback)
	end)

	local headerButton = { Frame = button }
	function headerButton:SetIcon(icon)
		setIcon(image, icon)
	end
	function headerButton:Destroy()
		button:Destroy()
	end
	return headerButton
end
Window.CreateTopbarButton = Window.HeaderButton

Const.POPUP_VARIANTS = {
	Primary = true,
	Secondary = true,
	Tertiary = true,
}

function Nucleus:Popup(input)
	local options = normalizeOptions(input, { Text = "Content", Message = "Content" })
	local window = Nucleus.Windows[#Nucleus.Windows]
	local ownGui
	local parentGui = window and window.Gui
	if not parentGui then
		ownGui = create("ScreenGui", {
			Name = Const.GUI_NAME .. "Popup",
			IgnoreGuiInset = true,
			ResetOnSpawn = false,
			DisplayOrder = 1000,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
			Parent = getGuiParent(),
		})
		parentGui = ownGui
	end

	local backdrop = create("TextButton", {
		Name = "Popup",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 200,
		Parent = parentGui,
	})
	local card = create("CanvasGroup", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 12),
		Size = UDim2.fromOffset(340, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,
		GroupTransparency = 1,
		ZIndex = 201,
		Parent = backdrop,
	})
	addCorner(card, UDim.new(0, 10))
	addStroke(card, Theme.Stroke)
	addTopHighlight(card)
	addPadding(card, 18, 18, 16, 16)
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 10),
		Parent = card,
	})

	local titleRow = create("Frame", {
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		ZIndex = 202,
		Parent = card,
	})
	local titleLeft = 0
	if options.Icon then
		local holder, image = createIcon(titleRow, options.Icon, Theme.Accent, UDim2.new(0, 0, 0.5, 0))
		holder.ZIndex = 202
		image.ZIndex = 202
		titleLeft = 26
	end
	createLabel({
		Position = UDim2.fromOffset(titleLeft, 0),
		Size = UDim2.new(1, -titleLeft, 1, 0),
		Text = tostring(options.Title or Const.LIB_NAME),
		TextSize = 16,
		FontFace = Fonts.Bold,
		ZIndex = 202,
		Parent = titleRow,
	})

	if options.Content then
		createLabel({
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Text = tostring(options.Content),
			TextSize = 13,
			FontFace = Fonts.Regular,
			TextColor3 = Theme.Muted,
			TextWrapped = true,
			TextTruncate = Enum.TextTruncate.None,
			TextYAlignment = Enum.TextYAlignment.Top,
			LayoutOrder = 2,
			ZIndex = 202,
			Parent = card,
		})
	end

	local buttonRow = create("Frame", {
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundTransparency = 1,
		LayoutOrder = 3,
		ZIndex = 202,
		Parent = card,
	})
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		Parent = buttonRow,
	})

	local popup = {}
	local closed = false
	function popup.Close()
		if closed then
			return
		end
		closed = true
		tween(backdrop, { BackgroundTransparency = 1 }, 0.18)
		tween(card, { GroupTransparency = 1, Position = UDim2.new(0.5, 0, 0.5, 8) }, 0.18, Enum.EasingStyle.Quint)
		task.delay(0.2, function()
			backdrop:Destroy()
			if ownGui then
				ownGui:Destroy()
			end
		end)
	end

	local buttons = options.Buttons
	if type(buttons) ~= "table" or #buttons == 0 then
		buttons = { { Title = "OK", Variant = "Primary" } }
	end
	for order, buttonDef in ipairs(buttons) do
		local variant = Const.POPUP_VARIANTS[buttonDef.Variant] and buttonDef.Variant or "Secondary"
		local primary = variant == "Primary"
		local tertiary = variant == "Tertiary"
		local button = create("TextButton", {
			Size = UDim2.fromOffset(0, 32),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = primary and Theme.Accent or Theme.Surface2,
			BackgroundTransparency = tertiary and 1 or 0,
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = order,
			ZIndex = 203,
			Parent = buttonRow,
		})
		addCorner(button, UDim.new(0, 7))
		if not primary and not tertiary then
			addStroke(button, Theme.Stroke)
		end
		addPadding(button, 14, 14)
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 6),
			Parent = button,
		})
		createLabel({
			Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X,
			Text = tostring(buttonDef.Title or buttonDef.Name or "OK"),
			TextSize = 13,
			TextColor3 = primary and Theme.AccentDark or (tertiary and Theme.Muted or Theme.Text),
			TextTruncate = Enum.TextTruncate.None,
			LayoutOrder = 1,
			ZIndex = 204,
			Parent = button,
		})
		if buttonDef.Icon then
			local image = create("ImageLabel", {
				Size = UDim2.fromOffset(14, 14),
				BackgroundTransparency = 1,
				ImageColor3 = primary and Theme.AccentDark or Theme.Text,
				ScaleType = Enum.ScaleType.Fit,
				LayoutOrder = 2,
				ZIndex = 204,
				Parent = button,
			})
			if not setIcon(image, buttonDef.Icon) then
				image:Destroy()
			end
		end
		button.MouseButton1Click:Connect(function()
			popup.Close()
			runProtected(('popup button "%s"'):format(tostring(buttonDef.Title or buttonDef.Name or "Button")), buttonDef.Callback)
		end)
	end

	if options.CloseOnBackdrop ~= false then
		backdrop.MouseButton1Click:Connect(popup.Close)
	end

	tween(backdrop, { BackgroundTransparency = 0.5 }, 0.25)
	tween(card, { GroupTransparency = 0, Position = UDim2.fromScale(0.5, 0.5) }, 0.3, Enum.EasingStyle.Quint)
	return popup
end

local CODE_KEYWORDS = {}
for _, word in ipairs({
	"and", "break", "do", "else", "elseif", "end", "false", "for", "function", "if", "in",
	"local", "nil", "not", "or", "repeat", "return", "then", "true", "until", "while", "continue",
}) do
	CODE_KEYWORDS[word] = true
end

local CODE_GLOBALS = {}
for _, word in ipairs({
	"game", "workspace", "script", "print", "warn", "error", "pairs", "ipairs", "require",
	"task", "math", "string", "table", "Instance", "Vector3", "Vector2", "CFrame", "Color3",
	"UDim2", "Enum", "tostring", "tonumber", "typeof", "type", "pcall", "loadstring", "getgenv",
}) do
	CODE_GLOBALS[word] = true
end

Const.MONO_FONT = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Regular)

local function escapeRich(text)
	return (text:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

local function colorHex(color)
	return string.format("#%02X%02X%02X", math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5))
end

local function highlightLua(source)
	local colors = {
		keyword = colorHex(Theme.Accent),
		global = colorHex(Theme.Glow),
		string = colorHex(Theme.Success),
		number = colorHex(Theme.Warning),
		comment = colorHex(Theme.Muted),
	}
	local out = {}
	local function paint(text, kind)
		table.insert(out, string.format('<font color="%s">%s</font>', colors[kind], escapeRich(text)))
	end
	local i, n = 1, string.len(source)
	while i <= n do
		local rest = source:sub(i)
		local longComment = rest:match("^%-%-%[(=*)%[")
		if longComment then
			local close = "]" .. longComment .. "]"
			local stop = source:find(close, i, true)
			local j = stop and (stop + #close - 1) or n
			paint(source:sub(i, j), "comment")
			i = j + 1
		elseif rest:sub(1, 2) == "--" then
			local stop = source:find("\n", i, true)
			local j = stop and (stop - 1) or n
			paint(source:sub(i, j), "comment")
			i = j + 1
		elseif rest:match("^%[=*%[") then
			local level = rest:match("^%[(=*)%[")
			local close = "]" .. level .. "]"
			local stop = source:find(close, i, true)
			local j = stop and (stop + #close - 1) or n
			paint(source:sub(i, j), "string")
			i = j + 1
		else
			local c = rest:sub(1, 1)
			if c == '"' or c == "'" then
				local j = i + 1
				while j <= n do
					local ch = source:sub(j, j)
					if ch == "\\" then
						j += 2
					elseif ch == c or ch == "\n" then
						break
					else
						j += 1
					end
				end
				paint(source:sub(i, math.min(j, n)), "string")
				i = j + 1
			elseif c:match("%d") then
				local number = rest:match("^0[xX]%x+") or rest:match("^%d+%.?%d*[eE]?[%-+]?%d*")
				paint(number, "number")
				i += #number
			elseif c:match("[%a_]") then
				local word = rest:match("^[%w_]+")
				if CODE_KEYWORDS[word] then
					paint(word, "keyword")
				elseif CODE_GLOBALS[word] then
					paint(word, "global")
				else
					table.insert(out, escapeRich(word))
				end
				i += #word
			else
				table.insert(out, escapeRich(c))
				i += 1
			end
		end
	end
	return table.concat(out)
end

local codeElements = setmetatable({}, { __mode = "k" })

function Tab:Code(input)
	local options = normalizeOptions(input, { Name = "Title", Text = "Code", Content = "Code" })
	local source = tostring(options.Code or "")

	local card = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Surface2,
		BorderSizePixel = 0,
		LayoutOrder = self:_nextOrder(),
		Parent = self.List,
	})
	card:SetAttribute(Const.ATTR_NO_DRAG, true)
	styleCard(card)
	addPadding(card, 12, 12, 10, 12)
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		Parent = card,
	})

	local headerRow = create("Frame", {
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = card,
	})
	createIcon(headerRow, "code", Theme.Accent, UDim2.new(0, 2, 0.5, 0))
	createLabel({
		Name = "Title",
		Position = UDim2.fromOffset(24, 0),
		Size = UDim2.new(1, -110, 1, 0),
		Text = tostring(options.Name or "Code"),
		Parent = headerRow,
	})

	local copyButton = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(0, 22),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Theme.Surface,
		Text = "",
		AutoButtonColor = false,
		Parent = headerRow,
	})
	addCorner(copyButton, UDim.new(0, 6))
	local copyStroke = addStroke(copyButton)
	addPadding(copyButton, 8, 9)
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 5),
		Parent = copyButton,
	})
	local copyIcon = create("ImageLabel", {
		Size = UDim2.fromOffset(12, 12),
		BackgroundTransparency = 1,
		ImageColor3 = Theme.Muted,
		ScaleType = Enum.ScaleType.Fit,
		LayoutOrder = 1,
		Parent = copyButton,
	})
	if not setIcon(copyIcon, "copy") then
		copyIcon:Destroy()
	end
	local copyLabel = createLabel({
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = "Copy",
		TextSize = 12,
		TextColor3 = Theme.Muted,
		TextTruncate = Enum.TextTruncate.None,
		LayoutOrder = 2,
		Parent = copyButton,
	})

	local body = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,
		LayoutOrder = 2,
		Parent = card,
	})
	addCorner(body, UDim.new(0, 6))
	addStroke(body)
	addPadding(body, 12, 12, 10, 10)
	local codeLabel = createLabel({
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Text = "",
		TextSize = 13,
		FontFace = Const.MONO_FONT,
		TextColor3 = Theme.Text,
		RichText = true,
		TextWrapped = true,
		TextTruncate = Enum.TextTruncate.None,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = body,
	})

	local element = { Title = options.Name or "Code" }
	local copyCallbacks = {}

	local function render()
		local ok, rich = pcall(highlightLua, source)
		codeLabel.Text = ok and rich or escapeRich(source)
	end

	function element:SetCode(text)
		source = tostring(text or "")
		render()
	end
	function element:GetCode()
		return source
	end
	element.Get = element.GetCode
	function element:OnCopy(callback)
		table.insert(copyCallbacks, callback)
	end
	function element:_rerender()
		render()
	end

	copyButton.MouseEnter:Connect(function()
		if IS_TOUCH then
			return
		end
		tween(copyStroke, { Color = Theme.StrokeHover }, 0.12)
		tween(copyLabel, { TextColor3 = Theme.Text }, 0.12)
	end)
	copyButton.MouseLeave:Connect(function()
		tween(copyStroke, { Color = Theme.Stroke }, 0.2)
		tween(copyLabel, { TextColor3 = Theme.Muted }, 0.2)
	end)
	copyButton.MouseButton1Click:Connect(function()
		Nucleus:Copy(source)
		copyLabel.Text = "Copied"
		task.delay(1.5, function()
			if copyLabel.Parent then
				copyLabel.Text = "Copy"
			end
		end)
		for _, callback in ipairs(copyCallbacks) do
			safeCall(callback, source)
		end
	end)

	render()
	codeElements[element] = true
	return registerElement(self, options, element, card, "Code")
end

function Tab:Space(input)
	local height = tonumber(input) or (type(input) == "table" and tonumber(input.Size or input.Height)) or 8
	local spacer = create("Frame", {
		Size = UDim2.new(1, 0, 0, height),
		BackgroundTransparency = 1,
		LayoutOrder = self:_nextOrder(),
		Parent = self.List,
	})
	return registerElement(self, {}, {}, spacer, "Space")
end

function Tab:Stat(input)
	local options = normalizeOptions(input, { Title = "Name", Text = "Value" })
	local height = options.Desc and Const.ROW_HEIGHT_DESC or Const.ROW_HEIGHT
	local card, stroke = createCard(self, "Frame", height)
	bindHoverStroke(card, stroke)

	local left = 14
	if options.Icon then
		createIcon(card, options.Icon, Theme.Accent, UDim2.new(0, 14, 0.5, 0))
		left = 40
	end
	local titleLabel, descLabel = createTitleBlock(card, options.Name or "Stat", options.Desc, 150)
	for _, label in ipairs({ titleLabel, descLabel }) do
		label.Position += UDim2.fromOffset(left - 14, 0)
		label.Size -= UDim2.fromOffset(left - 14, 0)
	end

	local valueLabel = createLabel({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.new(0, 140, 0, 20),
		Text = tostring(options.Value or "-"),
		TextSize = 14,
		FontFace = Fonts.Bold,
		TextColor3 = options.Color or Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = card,
	})

	local element = { Value = options.Value, _listeners = {} }
	function element:Set(value)
		element.Value = value
		local text = tostring(value)
		if valueLabel.Text ~= text then
			valueLabel.Text = text
		end
	end
	element.SetValue = element.Set
	function element:Get()
		return element.Value
	end
	function element:SetColor(color)
		valueLabel.TextColor3 = color
	end

	if type(options.Update) == "function" then
		local rate = math.max(tonumber(options.UpdateRate) or 1, 0.05)
		local running = true
		table.insert(element._listeners, function()
			running = false
		end)
		task.spawn(function()
			while running and card.Parent do
				local ok, value = pcall(options.Update)
				if ok and value ~= nil then
					element:Set(value)
				end
				task.wait(rate)
			end
		end)
	end

	return registerElement(self, options, element, card, "Stat")
end

function Tab:Image(input)
	local options = normalizeOptions(input, { Title = "Name", Text = "Caption", Desc = "Caption" })
	local height = tonumber(options.Height) or 150

	local card = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Surface2,
		BorderSizePixel = 0,
		LayoutOrder = self:_nextOrder(),
		Parent = self.List,
	})
	card:SetAttribute(Const.ATTR_NO_DRAG, true)
	styleCard(card)
	addPadding(card, 8, 8, 8, 8)
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		Parent = card,
	})

	local image = create("ImageLabel", {
		Size = UDim2.new(1, 0, 0, height),
		BackgroundColor3 = Theme.Background,
		ScaleType = options.ScaleType or Enum.ScaleType.Fit,
		LayoutOrder = 1,
		Parent = card,
	})
	image:SetAttribute(Const.ATTR_NO_THEME, true)
	addCorner(image, UDim.new(0, 6))
	setIcon(image, options.Image or options.Icon)

	local caption
	if options.Name or options.Caption then
		caption = createLabel({
			Name = "Title",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Text = tostring(options.Caption or options.Name),
			TextSize = 12,
			FontFace = Fonts.Regular,
			TextColor3 = Theme.Muted,
			TextWrapped = true,
			TextTruncate = Enum.TextTruncate.None,
			LayoutOrder = 2,
			Parent = card,
		})
		addPadding(caption, 4, 4)
	end

	local element = {}
	function element:SetImage(newImage)
		setIcon(image, newImage)
	end
	function element:SetHeight(newHeight)
		image.Size = UDim2.new(1, 0, 0, tonumber(newHeight) or height)
	end
	return registerElement(self, options, element, card, "Image")
end

function Window:FloatingButton(input)
	local window = self
	local options = normalizeOptions(input, { Name = "Title", Text = "Title" })
	local linked = options.Toggle
	local count = #(self._floating or {})
	self._floating = self._floating or {}

	local button = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = options.Position or UDim2.new(1, -16, 0.5, count * (IS_TOUCH and 52 or 44)),
		Size = UDim2.fromOffset(0, IS_TOUCH and 44 or 36),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Theme.Background,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 60,
		Parent = self.Gui,
	})
	addCorner(button, UDim.new(1, 0))
	local buttonStroke = addStroke(button, Theme.Stroke)
	addPadding(button, 12, 14)
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 7),
		Parent = button,
	})

	local dot = create("Frame", {
		Size = UDim2.fromOffset(8, 8),
		BackgroundColor3 = Theme.Muted,
		BorderSizePixel = 0,
		LayoutOrder = 1,
		Visible = linked ~= nil,
		ZIndex = 61,
		Parent = button,
	})
	addCorner(dot, UDim.new(1, 0))

	if options.Icon then
		local image = create("ImageLabel", {
			Size = UDim2.fromOffset(16, 16),
			BackgroundTransparency = 1,
			ImageColor3 = Theme.Accent,
			ScaleType = Enum.ScaleType.Fit,
			LayoutOrder = 2,
			ZIndex = 61,
			Parent = button,
		})
		if not setIcon(image, options.Icon) then
			image:Destroy()
		end
	end

	local label = createLabel({
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = tostring(options.Title or "Button"),
		TextSize = 13,
		TextTruncate = Enum.TextTruncate.AtEnd,
		LayoutOrder = 3,
		ZIndex = 61,
		Parent = button,
	})

	create("UISizeConstraint", { MaxSize = Vector2.new(IS_TOUCH and 140 or 220, math.huge), Parent = label })

	local floating = { Frame = button }

	local function renderState()
		if not linked then
			return
		end
		local on = linked:Get() == true
		tween(dot, { BackgroundColor3 = on and Theme.Success or Theme.Muted }, 0.15)
		tween(buttonStroke, { Color = on and Theme.Accent or Theme.Stroke }, 0.15)
	end

	local function press()
		if linked and type(linked.Set) == "function" then
			if not linked.Locked then
				linked:Set(not linked:Get())
			end
		else
			runProtected(('on-screen button "%s"'):format(tostring(options.Title or "Button")), options.Callback)
		end
		renderState()
		local scale = create("UIScale", { Scale = 0.94, Parent = button })
		tween(scale, { Scale = 1 }, 0.2, Enum.EasingStyle.Back)
		task.delay(0.21, function()
			scale:Destroy()
		end)
	end

	self:_makeDraggable(button, press)
	table.insert(self._overlays, button)
	table.insert(self._floating, floating)

	if linked then
		task.spawn(function()
			local lastState
			while button.Parent and not linked._destroyed do
				local state = linked:Get() == true
				if state ~= lastState then
					lastState = state
					renderState()
				end
				task.wait(0.2)
			end
			if button.Parent and linked._destroyed then
				floating:Destroy()
			end
		end)
	end

	function floating:SetTitle(text)
		setTranslated(label, "Text", tostring(text))
	end
	function floating:SetVisible(visible)
		button.Visible = visible ~= false
	end
	function floating:Destroy()
		local index = table.find(window._floating, floating)
		if index then
			table.remove(window._floating, index)
		end
		index = table.find(window._overlays, button)
		if index then
			table.remove(window._overlays, index)
		end
		button:Destroy()
	end

	if options.Visible == false or (options.TouchOnly and not IS_TOUCH) then
		floating:SetVisible(false)
	end
	renderState()
	return floating
end
Window.MobileButton = Window.FloatingButton

function Window:_miniBar()
	if self._miniBarFrame then
		return self._miniBarFrame
	end
	local miniOptions = self._miniOptions or {}
	local function shown(name)
		if miniOptions[name] == false then
			return false
		end
		if type(miniOptions.Hide) == "table" then
			for key, value in pairs(miniOptions.Hide) do
				if value == name or (key == name and value == true) then
					return false
				end
			end
		end
		return true
	end
	local bar = create("Frame", {
		Name = "MinimizedBar",
		Size = UDim2.fromOffset(0, 50),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,
		Active = true,
		Visible = false,
		ZIndex = 40,
		Parent = self.Gui,
	})
	addCorner(bar, UDim.new(0, 12))
	addStroke(bar)
	addPadding(bar, 10, 7)
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 10),
		Parent = bar,
	})
	local logo = create("ImageLabel", {
		Size = UDim2.fromOffset(28, 28),
		BackgroundTransparency = 1,
		ImageColor3 = Color3.new(1, 1, 1),
		ScaleType = Enum.ScaleType.Fit,
		LayoutOrder = 1,
		Visible = shown("Logo"),
		ZIndex = 41,
		Parent = bar,
	})
	logo.Image = self._logo.Image
	logo.ImageColor3 = self._logo.ImageColor3
	logo.ImageRectOffset = self._logo.ImageRectOffset
	logo.ImageRectSize = self._logo.ImageRectSize

	local textColumn = create("Frame", {
		Name = "Text",
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		ZIndex = 41,
		Parent = bar,
	})
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 1),
		Parent = textColumn,
	})
	local title = createLabel({
		Name = "Title",
		Size = UDim2.fromOffset(0, 17),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = self._titleLabel.Text,
		TextSize = 14,
		TextTruncate = Enum.TextTruncate.None,
		LayoutOrder = 1,
		Visible = shown("Title"),
		ZIndex = 41,
		Parent = textColumn,
	})
	create("UISizeConstraint", { MaxSize = Vector2.new(Const.MINI_TEXT_WIDTH, 17), Parent = title })
	local info = createLabel({
		Name = "Info",
		Size = UDim2.fromOffset(0, 14),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = "",
		TextSize = 11,
		FontFace = Fonts.Regular,
		TextColor3 = Theme.Muted,
		TextTruncate = Enum.TextTruncate.AtEnd,
		LayoutOrder = 2,
		ZIndex = 41,
		Parent = textColumn,
	})
	create("UISizeConstraint", { MaxSize = Vector2.new(Const.MINI_TEXT_WIDTH, 14), Parent = info })

	local activePill = create("Frame", {
		Name = "Active",
		Size = UDim2.fromOffset(0, 22),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Theme.Surface2,
		BorderSizePixel = 0,
		LayoutOrder = 3,
		Visible = false,
		ZIndex = 41,
		Parent = bar,
	})
	addCorner(activePill, UDim.new(1, 0))
	addStroke(activePill)
	addPadding(activePill, 8, 9)
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6),
		Parent = activePill,
	})
	local dot = create("Frame", {
		Size = UDim2.fromOffset(6, 6),
		BackgroundColor3 = Theme.Success,
		BorderSizePixel = 0,
		LayoutOrder = 1,
		ZIndex = 42,
		Parent = activePill,
	})
	addCorner(dot, UDim.new(1, 0))
	local activeLabel = createLabel({
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = "",
		TextSize = 11,
		TextTruncate = Enum.TextTruncate.None,
		LayoutOrder = 2,
		ZIndex = 42,
		Parent = activePill,
	})

	local stats = createLabel({
		Name = "Stats",
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = "",
		TextSize = 11,
		FontFace = Fonts.Regular,
		TextColor3 = Theme.Muted,
		TextTruncate = Enum.TextTruncate.None,
		LayoutOrder = 5,
		Visible = shown("Stats"),
		ZIndex = 41,
		Parent = bar,
	})

	local chips = {}
	for _, entry in ipairs(type(miniOptions.Toggles) == "table" and miniOptions.Toggles or {}) do
		local flag = type(entry) == "table" and entry.Flag or entry
		local chip = create("TextButton", {
			Name = "Toggle",
			Size = UDim2.fromOffset(0, 24),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = Theme.Surface2,
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = 4,
			Visible = false,
			ZIndex = 41,
			Parent = bar,
		})
		addCorner(chip, UDim.new(1, 0))
		local chipStroke = addStroke(chip)
		addPadding(chip, 10, 10)
		local chipLabel = createLabel({
			Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X,
			Text = "",
			TextSize = 11,
			TextColor3 = Theme.Muted,
			TextTruncate = Enum.TextTruncate.None,
			ZIndex = 42,
			Parent = chip,
		})
		chip.MouseButton1Click:Connect(function()
			local element = self.Flags[tostring(flag)]
			if element and element.Set and not element._destroyed then
				element:Set(element.Value ~= true)
				if self._miniRefresh then
					self._miniRefresh()
				end
			end
		end)
		table.insert(chips, {
			Flag = tostring(flag),
			Title = type(entry) == "table" and (entry.Title or entry.Name) or nil,
			Button = chip,
			Stroke = chipStroke,
			Label = chipLabel,
		})
	end

	local function barButton(order, name, icon, onClick)
		local button = create("TextButton", {
			Name = name,
			Size = UDim2.fromOffset(32, 32),
			BackgroundColor3 = Theme.Surface2,
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = order,
			ZIndex = 41,
			Parent = bar,
		})
		addCorner(button, UDim.new(0, 8))
		local image = create("ImageLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(16, 16),
			BackgroundTransparency = 1,
			ImageColor3 = Theme.Muted,
			ScaleType = Enum.ScaleType.Fit,
			ZIndex = 42,
			Parent = button,
		})
		setIcon(image, icon)
		button.MouseEnter:Connect(function()
			if IS_TOUCH then
				return
			end
			tween(button, { BackgroundTransparency = 0 }, 0.15)
			tween(image, { ImageColor3 = Theme.Text }, 0.15)
		end)
		button.MouseLeave:Connect(function()
			tween(button, { BackgroundTransparency = 1 }, 0.2)
			tween(image, { ImageColor3 = Theme.Muted }, 0.2)
		end)
		button.MouseButton1Click:Connect(onClick)
		return button
	end
	for index, entry in ipairs(type(miniOptions.Buttons) == "table" and miniOptions.Buttons or {}) do
		if type(entry) == "table" then
			local custom = barButton(6, "Custom" .. index, entry.Icon or "circle", function()
				safeCall(entry.Callback)
			end)
			if entry.Tooltip or entry.Title then
				custom.MouseEnter:Connect(function()
					self:_showTooltip(tostring(entry.Tooltip or entry.Title), custom)
				end)
				custom.MouseLeave:Connect(function()
					self:_hideTooltip(custom)
				end)
			end
		end
	end
	barButton(7, "Restore", "maximize-2", function()
		self:Minimize(false)
	end).Visible = shown("Restore")
	barButton(8, "Close", "x", function()
		self:RequestClose()
	end).Visible = shown("Close")

	local frames, lastCount = 0, os.clock()
	local function refresh()
		title.Text = self._titleLabel.Text
		local text = self._miniText
		if type(text) == "function" then
			local ok, value = pcall(text)
			text = ok and value or nil
		end
		if text == nil or tostring(text) == "" then
			text = self._subtitleLabel.Text
		end
		info.Text = tostring(text or "")
		info.Visible = info.Text ~= "" and shown("Text")

		for _, chip in ipairs(chips) do
			local element = self.Flags[chip.Flag]
			local exists = element ~= nil and not element._destroyed and element.Set ~= nil
			chip.Button.Visible = exists
			if exists then
				local on = element.Value == true
				chip.Label.Text = chip.Title or (element._label and element._label:match('^%w+ "(.*)"$')) or chip.Flag
				chip.Label.TextColor3 = on and Theme.Text or Theme.Muted
				chip.Stroke.Color = on and Theme.Accent or Theme.Stroke
			end
		end

		local active = 0
		if shown("Active") then
			for _, element in ipairs(self._elements) do
				if element._type == "Toggle" and element.Value == true and not element._destroyed then
					active += 1
				end
			end
		end
		activePill.Visible = active > 0
		activeLabel.Text = active .. " on"

		if stats.Visible then
			local now = os.clock()
			local fps = math.floor(frames / math.max(now - lastCount, 0.001) + 0.5)
			frames, lastCount = 0, now
			local ok, ping = pcall(function()
				return math.floor(LocalPlayer:GetNetworkPing() * 1000)
			end)
			stats.Text = ("%d fps  ·  %d ms"):format(math.min(fps, 999), ok and ping or 0)
		end
	end

	self:_makeDraggable(bar, function()
		self:Minimize(false)
	end)
	self._miniBarFrame = bar
	self._miniBarTitle = title
	self._miniBarInfo = info
	self._miniBarLogo = logo
	self._miniRefresh = refresh
	self._miniCount = function()
		frames += 1
	end
	return bar
end

function Window:_startMiniLoop()
	if self._miniStop then
		self._miniStop()
	end
	local stopRender = self:_listen("Render", self._miniCount)
	local running = true
	self._miniStop = function()
		running = false
		stopRender()
		self._miniStop = nil
	end
	task.spawn(function()
		while running and not self._destroyed do
			task.wait(1)
			if running and self.Minimized then
				self._miniRefresh()
			end
		end
	end)
end

function Window:AddHomePage(first, second, third)
	if not self._addHomePage then
		log("AddHomePage needs the Home tab. Remove Home = false from your window to use it.")
		return nil
	end
	local pageDef = first
	if type(first) == "string" then
		pageDef = { Title = first }
		for _, value in ipairs({ second, third }) do
			if type(value) == "function" then
				pageDef.Build = value
			elseif type(value) == "table" then
				pageDef.Entries = value
			elseif type(value) == "string" then
				if pageDef.Content == nil then
					pageDef.Content = value
				else
					pageDef.Icon = value
				end
			end
		end
	end
	if type(pageDef) ~= "table" then
		return nil
	end
	local page = self._addHomePage(pageDef)
	return page and page.Frame or nil
end

function Window:SelectHomePage(page)
	if not self._showHomePage or not self._homePages then
		return false
	end
	local index = tonumber(page)
	if not index then
		for position, entry in ipairs(self._homePages) do
			if entry.Title == page then
				index = position
			end
		end
	end
	if not index or not self._homePages[index] then
		return false
	end
	self._showHomePage(index)
	return true
end

function Nucleus:SetAnimations(enabled)
	Nucleus.Animations = enabled == true
end

function Window:RequestClose()
	if self._destroyed then
		return
	end
	if self._closeAction == "Hide" then
		self:Toggle(false)
		return
	end
	if not self._confirmClose then
		Nucleus:Destroy()
		return
	end
	if self.Minimized then
		self:Minimize(false)
	end
	if not self.Open then
		self:Toggle(true)
	end
	self:Dialog({
		Title = "Unload " .. tostring(self._titleLabel.Text ~= "" and self._titleLabel.Text or Const.LIB_NAME) .. "?",
		Content = "This closes the menu and turns off everything it was running. Run the script again to bring it back.",
		Icon = "power",
		Buttons = {
			{ Title = "Cancel" },
			{ Title = "Unload", Variant = "Primary", Callback = function()
				task.defer(function()
					Nucleus:Destroy()
				end)
			end },
		},
	})
end

function Window:SetMinimizedBar(options)
	if type(options) ~= "table" then
		return
	end
	self._miniOptions = self._miniOptions or {}
	for key, value in pairs(options) do
		self._miniOptions[key] = value
	end
	if options.Text ~= nil then
		self._miniText = options.Text
	end
	local bar = self._miniBarFrame
	if not bar then
		return
	end
	local position = bar.Position
	local wasMinimized = self.Minimized
	self._miniBarFrame = nil
	bar:Destroy()
	local fresh = self:_miniBar()
	fresh.Position = position
	if wasMinimized then
		fresh.Visible = true
		self._miniRefresh()
		self:_startMiniLoop()
	end
end

function Window:SetMinimizedText(text)
	self._miniText = text
	if self.Minimized and self._miniRefresh then
		self._miniRefresh()
	end
end

function Window:Minimize(minimized)
	if minimized == nil then
		minimized = not self.Minimized
	end
	minimized = minimized == true
	if self._destroyed or not self._introDone or minimized == (self.Minimized == true) then
		return
	end
	if minimized and not self.Open then
		return
	end
	local root = self.Root
	local bar = self:_miniBar()
	self:_hideTooltip()
	if minimized then
		self.Minimized = true
		self._miniBarTitle.Text = self._titleLabel.Text
		self._miniBarLogo.Image = self._logo.Image
		self._miniRefresh()
		local topLeft = root.AbsolutePosition - self.Gui.AbsolutePosition
		bar.Position = UDim2.fromOffset(math.max(topLeft.X, 8), math.max(topLeft.Y, 8))
		root.Visible = false
		bar.Visible = true
		self:_startMiniLoop()
	else
		self.Minimized = false
		if self._miniStop then
			self._miniStop()
		end
		bar.Visible = false
		local barTopLeft = bar.AbsolutePosition - self.Gui.AbsolutePosition
		local size = root.AbsoluteSize
		root.Position = UDim2.fromOffset(barTopLeft.X + size.X * root.AnchorPoint.X, barTopLeft.Y + size.Y * root.AnchorPoint.Y)
		root.Visible = true
		self:_clampToScreen()
	end
	for _, callback in ipairs(self._events[minimized and "Close" or "Open"]) do
		task.spawn(safeCall, callback)
	end
end

function Window:Restore()
	self:Minimize(false)
end

do
	local DEFAULT_PERKS = {
		"No key system, no checkpoints",
		"Instant access every time you play",
		"Supports future updates",
	}
	local COOLDOWN_FILE = "NucleusUI/premium.json"

	local function isFreeUser(window)
		local status = Nucleus._getKeyStatus()
		if window._premium and window._premium.ShowWithoutKey then
			return not status.Premium
		end
		return status.HasKey and not status.Premium
	end

	local function readLastShown()
		local ok, value = pcall(function()
			if type(isfile) == "function" and isfile(COOLDOWN_FILE) then
				return tonumber(HttpService:JSONDecode(readfile(COOLDOWN_FILE)).LastShown)
			end
		end)
		return ok and value or nil
	end

	local function writeLastShown(time)
		pcall(function()
			if type(writefile) ~= "function" then
				return
			end
			if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder("NucleusUI") then
				makefolder("NucleusUI")
			end
			writefile(COOLDOWN_FILE, HttpService:JSONEncode({ LastShown = time }))
		end)
	end

	function Nucleus:IsPremium()
		return Nucleus._getKeyStatus().Premium == true
	end

	function Nucleus:GetKeyStatus()
		return Nucleus._getKeyStatus()
	end

	function Window:_premiumClicked(source)
		local premium = self._premium
		if not premium then
			return
		end
		Nucleus:Copy(premium.Link)
		safeCall(premium.OnClick, source)
	end

	function Window:ShowPremium(source)
		local premium = self._premium
		if not premium or self._destroyed then
			return nil
		end
		local lines = {}
		if premium.Text then
			table.insert(lines, tostring(premium.Text))
			table.insert(lines, "")
		end
		for _, perk in ipairs(premium.Perks) do
			table.insert(lines, "•  " .. tostring(perk))
		end
		if premium.Price then
			table.insert(lines, "")
			table.insert(lines, tostring(premium.Price))
		end
		safeCall(premium.OnShown, source or "manual")
		return Nucleus:Popup({
			Title = premium.Title,
			Icon = "crown",
			Content = table.concat(lines, "\n"),
			Buttons = {
				{ Title = "Not now", Variant = "Tertiary" },
				{ Title = premium.ButtonText or "Get Premium", Icon = "crown", Variant = "Primary", Callback = function()
					self:_premiumClicked(source or "popup")
				end },
			},
		})
	end

	function Window:_setupPremium(windowOptions)
		local settings = windowOptions.Premium
		if settings == false then
			return
		end
		settings = type(settings) == "table" and settings or {}
		local home = type(windowOptions.Home) == "table" and windowOptions.Home or {}
		local homeKey = (type(windowOptions.Membership) == "table" and windowOptions.Membership) or (type(home.Key) == "table" and home.Key) or {}
		local link = settings.Link or homeKey.PremiumLink
		if type(link) ~= "string" or link == "" then
			return
		end
		self._premium = {
			Link = link,
			Title = settings.Title or "Go Premium",
			Text = settings.Text,
			Perks = type(settings.Perks) == "table" and settings.Perks or DEFAULT_PERKS,
			Price = settings.Price,
			ButtonText = settings.ButtonText,
			ShowWithoutKey = settings.ShowWithoutKey == true,
			OnClick = settings.OnClick,
			OnShown = settings.OnShown,
		}

		if settings.HeaderButton ~= false then
			local headerButton = self:HeaderButton({
				Icon = "crown",
				Tooltip = "Get Premium",
				Callback = function()
					self:ShowPremium("header")
				end,
			})
			headerButton.Frame.Visible = isFreeUser(self)
			task.spawn(function()
				while not self._destroyed and headerButton.Frame.Parent do
					headerButton.Frame.Visible = isFreeUser(self)
					task.wait(3)
				end
			end)
		end

		if settings.Popup ~= false then
			local delay = math.max(tonumber(settings.PopupDelay) or 600, 5)
			local cooldown = tonumber(settings.Cooldown) or 86400
			task.delay(delay, function()
				if self._destroyed or not isFreeUser(self) then
					return
				end
				local last = readLastShown()
				local now = os.time()
				if last and now - last < cooldown then
					return
				end
				writeLastShown(now)
				self:ShowPremium("timer")
			end)
		end
	end

	function Tab:PremiumBanner(input)
		local options = normalizeOptions(input, { Title = "Text", Name = "Text", Content = "Text" })
		local window = self.Window
		local card = create("Frame", {
			Size = UDim2.new(1, 0, 0, Const.ROW_HEIGHT),
			BackgroundColor3 = Theme.Surface2,
			BorderSizePixel = 0,
			LayoutOrder = self:_nextOrder(),
			Parent = self.List,
		})
		card:SetAttribute(Const.ATTR_NO_DRAG, true)
		addCorner(card)
		local stroke = addStroke(card, Theme.Accent, 1)
		stroke.Transparency = 0.6
		createIcon(card, "crown", Theme.Accent, UDim2.new(0, 14, 0.5, 0))
		local label = createLabel({
			Name = "Title",
			Position = UDim2.fromOffset(40, 0),
			Size = UDim2.new(1, -150, 1, 0),
			Text = tostring(options.Text or "Premium: no key system, instant access"),
			TextSize = 13,
			Parent = card,
		})
		local button = create("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(0, 26),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = Theme.Accent,
			BorderSizePixel = 0,
			Text = "",
			AutoButtonColor = false,
			Parent = card,
		})
		button:SetAttribute(Const.ATTR_NO_DRAG, true)
		addCorner(button, UDim.new(0, 6))
		addPadding(button, 12, 12)
		createLabel({
			Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X,
			Text = tostring(options.ButtonText or "Get Premium"),
			TextSize = 12,
			TextColor3 = Theme.AccentDark,
			TextTruncate = Enum.TextTruncate.None,
			Parent = button,
		})
		button.MouseButton1Click:Connect(function()
			if options.Link then
				Nucleus:Copy(options.Link)
			elseif window._premium then
				window:ShowPremium("banner")
			end
		end)

		local element = {}
		function element:SetText(text)
			setTranslated(label, "Text", tostring(text))
		end
		local registered = registerElement(self, options, element, card, "PremiumBanner")
		local function refresh()
			local status = Nucleus._getKeyStatus()
			local show = not status.Premium and (status.HasKey or options.ShowWithoutKey == true)
			card.Visible = element.Visible ~= false and show
		end
		refresh()
		task.spawn(function()
			while card.Parent and not window._destroyed do
				task.wait(3)
				refresh()
			end
		end)
		return registered
	end
	Tab.CreatePremiumBanner = Tab.PremiumBanner
end

function Window:SetSidebarCollapsed(collapsed)
	self._sidebarCollapsed = collapsed == true
	self:_setCompact(self._autoCompact == true or self._sidebarCollapsed, self._introDone == true)
end

function Window:ToggleSidebar()
	self:SetSidebarCollapsed(not self._compact)
end

function Window:IsSidebarCollapsed()
	return self._compact == true
end

function Window:Popup(input)
	return Nucleus:Popup(input)
end

do
	local function startLoop(owner, list, callback, delay, where)
		local loop = { Running = true }
		function loop:Stop()
			loop.Running = false
		end
		loop.Disconnect = loop.Stop
		if type(callback) ~= "function" then
			loop.Running = false
			return loop
		end
		table.insert(list, loop)
		task.spawn(function()
			local failures = 0
			while loop.Running and not owner._destroyed do
				local ok, captured = xpcall(callback, captureError)
				if not ok then
					failures += 1
					loop.Errors = failures
					if failures == 1 or failures % 100 == 0 then
						reportError(where or "a loop", captured)
					end
				end
				if not loop.Running or owner._destroyed then
					break
				end
				local waitTime = delay
				if type(waitTime) == "function" then
					local okDelay, value = pcall(waitTime)
					waitTime = okDelay and value or 0
				end
				waitTime = tonumber(waitTime) or 0
				if waitTime > 0 then
					task.wait(waitTime)
				else
					task.wait()
				end
			end
			loop.Running = false
			local index = table.find(list, loop)
			if index then
				table.remove(list, index)
			end
		end)
		return loop
	end

	function Window:Loop(callback, delay, name)
		if type(callback) ~= "function" then
			log("Loop needs a function, but got a " .. typeof(callback) .. ".")
		end
		return startLoop(self, self._loops, callback, delay, name and ("loop \"" .. tostring(name) .. "\"") or nil)
	end

	function Window:Connect(signal, callback)
		assert(signal and type(callback) == "function", Const.LOG_PREFIX .. "Connect needs a signal and a function")
		local connection = signal:Connect(function(...)
			if not self._destroyed then
				runProtected("a connected event", callback, ...)
			end
		end)
		table.insert(self._connections, connection)
		return connection
	end

	function Window:Spawn(callback, ...)
		local thread = task.spawn(runProtected, "a spawned task", callback, ...)
		self:OnDestroy(function()
			if coroutine.status(thread) ~= "dead" then
				pcall(task.cancel, thread)
			end
		end)
		return thread
	end

	Window.OnUnload = Window.OnDestroy

	local globalOwner = { _destroyed = false }
	local globalLoops = {}

	function Nucleus:Loop(callback, delay)
		local window = Nucleus.Windows[#Nucleus.Windows]
		if window then
			return window:Loop(callback, delay)
		end
		local loop = startLoop(globalOwner, globalLoops, callback, delay)
		table.insert(Nucleus._cleanup, function()
			loop:Stop()
		end)
		return loop
	end

	function Nucleus:Connect(signal, callback)
		local window = Nucleus.Windows[#Nucleus.Windows]
		if window then
			return window:Connect(signal, callback)
		end
		local connection = signal:Connect(function(...)
			safeCall(callback, ...)
		end)
		table.insert(Nucleus._cleanup, function()
			connection:Disconnect()
		end)
		return connection
	end

	function Nucleus:OnUnload(callback)
		if type(callback) == "function" then
			table.insert(Nucleus._cleanup, callback)
		end
	end

	function Nucleus:GetValues()
		local values = {}
		for flag, element in pairs(Nucleus.Flags) do
			if type(element.Get) == "function" then
				local ok, value = pcall(element.Get, element)
				if ok then
					values[flag] = value
				end
			end
		end
		return values
	end

	function Nucleus:SetValues(values)
		if type(values) ~= "table" then
			return
		end
		for flag, value in pairs(values) do
			Nucleus:SetValue(flag, value)
		end
	end
end

do
	local function isTruthy(value)
		if type(value) == "table" then
			return next(value) ~= nil
		elseif type(value) == "string" then
			return value ~= ""
		elseif type(value) == "number" then
			return value ~= 0
		end
		return value ~= nil and value ~= false
	end

	local function matches(value, expected)
		if expected == nil then
			return isTruthy(value)
		end
		if type(expected) == "table" then
			for _, option in ipairs(expected) do
				if matches(value, option) then
					return true
				end
			end
			return false
		end
		if type(value) == "table" then
			return table.find(value, expected) ~= nil
		end
		if typeof(value) == "EnumItem" and type(expected) == "string" then
			return value.Name == expected
		end
		return value == expected
	end

	local function flagValue(window, flag)
		local element = window.Flags[flag] or Nucleus.Flags[flag]
		if element and type(element.Get) == "function" then
			local ok, value = pcall(element.Get, element)
			if ok then
				return value
			end
		elseif element == nil then
			window._missingDependencies = window._missingDependencies or {}
			if not window._missingDependencies[flag] then
				window._missingDependencies[flag] = true
				task.delay(3, function()
					if not window._destroyed and window.Flags[flag] == nil and Nucleus.Flags[flag] == nil then
						log(('DependsOn uses the Flag "%s", but no element has that Flag. Check the spelling.'):format(tostring(flag)))
					end
				end)
			end
		end
		return nil
	end

	local function evaluate(window, dependency)
		if type(dependency) == "function" then
			local ok, result = pcall(dependency)
			return ok and result and true or false
		elseif type(dependency) == "string" then
			return isTruthy(flagValue(window, dependency))
		elseif type(dependency) == "table" then
			if dependency.Flag ~= nil then
				local result = matches(flagValue(window, dependency.Flag), dependency.Value)
				if dependency.Not then
					result = not result
				end
				return result
			end
			for _, part in ipairs(dependency) do
				if not evaluate(window, part) then
					return false
				end
			end
		end
		return true
	end

	function Window:_queueDependencies()
		if self._dependencyQueued or self._destroyed or #self._dependents == 0 then
			return
		end
		self._dependencyQueued = true
		task.defer(function()
			self._dependencyQueued = false
			if not self._destroyed then
				self:_refreshDependencies()
			end
		end)
	end

	function Window:_refreshDependencies()
		for _, element in ipairs(table.clone(self._dependents)) do
			if not element._destroyed and type(element.SetVisible) == "function" then
				local show = evaluate(self, element._dependsOn)
				if element._dependencyShown ~= show then
					element._dependencyShown = show
					element:SetVisible(show)
				end
			end
		end
	end
end

function Tab:Clear()
	local window = self.Window
	if not window or not self.List then
		return 0
	end
	local doomed = {}
	for _, element in ipairs(window._elements) do
		local frame = element._frame
		if not element._destroyed and element._type ~= "KeyInfo" and typeof(frame) == "Instance"
			and frame:IsDescendantOf(self.List) then
			table.insert(doomed, element)
		end
	end
	for _, element in ipairs(doomed) do
		element:Destroy()
	end
	return #doomed
end

Const.BUTTON_ROW_STYLES = {
	Primary = "Accent",
	Danger = "Error",
}

function Tab:ButtonRow(input)
	local options = type(input) == "table" and input or {}
	local definitions = options.Buttons
	if type(definitions) ~= "table" then
		definitions = {}
		for _, definition in ipairs(options) do
			table.insert(definitions, definition)
		end
	end
	local count = math.max(#definitions, 1)
	local gap = 8

	local holder = create("Frame", {
		Size = UDim2.new(1, 0, 0, Const.ROW_HEIGHT),
		BackgroundTransparency = 1,
		LayoutOrder = self:_nextOrder(),
		Parent = self.List,
	})
	holder:SetAttribute(Const.ATTR_NO_DRAG, true)
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, gap),
		Parent = holder,
	})

	local element = { Buttons = {} }
	for index, definition in ipairs(definitions) do
		if type(definition) == "string" then
			definition = { Name = definition }
		end
		local name = definition.Name or definition.Title or ("Button " .. index)
		local colorKey = Const.BUTTON_ROW_STYLES[definition.Style]
		local button = create("TextButton", {
			Name = "Button" .. index,
			Size = UDim2.new(1 / count, -gap * (count - 1) / count, 1, 0),
			BackgroundColor3 = colorKey and Theme[colorKey] or Theme.Surface2,
			BackgroundTransparency = colorKey and 0.12 or 0,
			BorderSizePixel = 0,
			Text = "",
			AutoButtonColor = false,
			ClipsDescendants = true,
			LayoutOrder = index,
			Parent = holder,
		})
		button:SetAttribute(Const.ATTR_NO_DRAG, true)
		addCorner(button)
		local stroke = addStroke(button, colorKey and Theme[colorKey] or Theme.Stroke, 1)
		if colorKey then
			stroke.Transparency = 0.4
			button.MouseEnter:Connect(function()
				if IS_TOUCH then
					return
				end
				tween(button, { BackgroundTransparency = 0 }, 0.12)
				tween(stroke, { Transparency = 0 }, 0.12)
			end)
			button.MouseLeave:Connect(function()
				tween(button, { BackgroundTransparency = 0.12 }, 0.25)
				tween(stroke, { Transparency = 0.4 }, 0.25)
			end)
		else
			bindHoverStroke(button, stroke)
		end

		local content = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundTransparency = 1,
			Parent = button,
		})
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 6),
			Parent = content,
		})
		local textColor = colorKey and Theme.AccentDark or Theme.Text
		if definition.Icon then
			local iconHolder = createIcon(content, definition.Icon, colorKey and Theme.AccentDark or Theme.Accent, UDim2.new())
			iconHolder.AnchorPoint = Vector2.zero
			iconHolder.LayoutOrder = 1
		end
		local label = createLabel({
			Name = "Title",
			Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X,
			Text = tostring(name),
			TextSize = 13,
			TextColor3 = textColor,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextTruncate = Enum.TextTruncate.None,
			LayoutOrder = 2,
			Parent = content,
		})

		local function fitLabel()
			local available = button.AbsoluteSize.X - 20 - (definition.Icon and 22 or 0)
			if available > 0 and label.TextBounds.X > available then
				label.AutomaticSize = Enum.AutomaticSize.None
				label.Size = UDim2.new(0, available, 1, 0)
				label.TextTruncate = Enum.TextTruncate.AtEnd
			else
				label.AutomaticSize = Enum.AutomaticSize.X
				label.Size = UDim2.new(0, 0, 1, 0)
				label.TextTruncate = Enum.TextTruncate.None
			end
		end
		button:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitLabel)
		task.defer(fitLabel)

		button.MouseButton1Click:Connect(function()
			if element.Locked then
				return
			end
			ripple(button, colorKey and Theme.AccentDark or Theme.Accent)
			runProtected(('Button "%s"'):format(tostring(name)), definition.Callback)
		end)

		element.Buttons[index] = {
			Frame = button,
			SetText = function(_, text)
				setTranslated(label, "Text", tostring(text))
				fitLabel()
			end,
			SetCallback = function(_, callback)
				definition.Callback = callback
			end,
		}
	end

	function element:GetButton(index)
		return element.Buttons[index]
	end
	function element:SetButtonText(index, text)
		local button = element.Buttons[index]
		if button then
			button:SetText(text)
		end
	end

	return registerElement(self, { Name = options.Name, DependsOn = options.DependsOn, Tooltip = options.Tooltip, Locked = options.Locked, LockedReason = options.LockedReason }, element, holder, "ButtonRow")
end
Tab.Buttons = Tab.ButtonRow

function Tab:TextArea(input)
	local options = normalizeOptions(input, {
		Title = "Name",
		Description = "Desc",
		PlaceholderText = "Placeholder",
		CurrentValue = "Default",
		Value = "Default",
	})
	local minHeight = math.max(tonumber(options.Height) or 84, 40)
	local maxHeight = math.max(tonumber(options.MaxHeight) or 220, minHeight)
	local maxLength = tonumber(options.MaxLength)

	local card = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Surface2,
		BorderSizePixel = 0,
		LayoutOrder = self:_nextOrder(),
		Parent = self.List,
	})
	card:SetAttribute(Const.ATTR_NO_DRAG, true)
	local stroke = styleCard(card)
	addPadding(card, 14, 14, 11, 12)
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6),
		Parent = card,
	})

	createLabel({
		Name = "Title",
		Size = UDim2.new(1, 0, 0, 14),
		Text = options.Name or "Text",
		LayoutOrder = 1,
		Parent = card,
	})
	if options.Desc then
		createLabel({
			Name = "Desc",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Text = tostring(options.Desc),
			TextSize = 12,
			FontFace = Fonts.Regular,
			TextColor3 = Theme.Muted,
			TextWrapped = true,
			TextTruncate = Enum.TextTruncate.None,
			LayoutOrder = 2,
			Parent = card,
		})
	end

	local box = create("ScrollingFrame", {
		Size = UDim2.new(1, 0, 0, minHeight),
		BackgroundColor3 = Theme.Surface,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Muted,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		LayoutOrder = 3,
		Parent = card,
	})
	addCorner(box, UDim.new(0, 6))
	local boxStroke = addStroke(box)
	addPadding(box, 8, 8, 6, 6)

	local function clampLength(text)
		text = tostring(text or "")
		if maxLength and #text > maxLength then
			return text:sub(1, maxLength)
		end
		return text
	end

	local textBox = create("TextBox", {
		Size = UDim2.new(1, 0, 0, minHeight - 12),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Text = "",
		PlaceholderText = tostring(options.Placeholder or ""),
		PlaceholderColor3 = Theme.Muted,
		TextColor3 = Theme.Text,
		TextSize = 13,
		FontFace = options.Monospace and Const.MONO_FONT or Fonts.Regular,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		MultiLine = true,
		ClearTextOnFocus = false,
		Parent = box,
	})
	textBox.Text = clampLength(options.Default)

	local function fitBox()
		local wanted = textBox.TextBounds.Y + 14
		box.Size = UDim2.new(1, 0, 0, math.clamp(wanted, minHeight, maxHeight))
	end

	textBox:GetPropertyChangedSignal("Text"):Connect(function()
		local clamped = clampLength(textBox.Text)
		if clamped ~= textBox.Text then
			textBox.Text = clamped
			return
		end
		if textBox:IsFocused() then
			safeCall(options.OnChanged, textBox.Text)
			if (tonumber(textBox.CursorPosition) or -1) >= #textBox.Text then
				task.defer(function()
					box.CanvasPosition = Vector2.new(0, math.max(box.AbsoluteCanvasSize.Y - box.AbsoluteWindowSize.Y, 0))
				end)
			end
		end
	end)
	textBox:GetPropertyChangedSignal("TextBounds"):Connect(fitBox)
	task.defer(fitBox)

	textBox.Focused:Connect(function()
		tween(boxStroke, { Color = Theme.StrokeHover }, 0.15)
	end)
	textBox.FocusLost:Connect(function()
		tween(boxStroke, { Color = Theme.Stroke }, 0.15)
		safeCall(options.Callback, textBox.Text)
	end)

	local element = {}
	function element:Set(text, silent)
		textBox.Text = clampLength(text)
		flashStroke(stroke)
		if not silent then
			safeCall(options.Callback, textBox.Text)
		end
	end
	function element:Get()
		return textBox.Text
	end
	function element:SetPlaceholder(text)
		textBox.PlaceholderText = tostring(text)
	end
	function element:Focus()
		textBox:CaptureFocus()
	end
	function element:Clear()
		element:Set("")
	end

	return registerElement(self, options, element, card, "TextArea")
end

do
	local Utils = {}
	Nucleus.Utils = Utils

	function Utils.GetCharacter(player)
		player = player or LocalPlayer
		return player and player.Character or nil
	end

	function Utils.GetHumanoid(player)
		local character = Utils.GetCharacter(player)
		return character and character:FindFirstChildOfClass("Humanoid") or nil
	end

	function Utils.GetRoot(player)
		local character = Utils.GetCharacter(player)
		if not character then
			return nil
		end
		return character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
	end

	function Utils.IsAlive(player)
		local humanoid = Utils.GetHumanoid(player)
		return humanoid ~= nil and humanoid.Health > 0
	end

	function Utils.GetPlayers(excludeSelf)
		local list = {}
		for _, player in ipairs(Players:GetPlayers()) do
			if not (excludeSelf and player == LocalPlayer) then
				table.insert(list, player)
			end
		end
		return list
	end

	function Utils.GetPlayer(query)
		if typeof(query) == "Instance" then
			return query
		end
		query = string.lower(tostring(query or ""))
		if query == "" then
			return nil
		end
		local partial
		for _, player in ipairs(Players:GetPlayers()) do
			local name, display = string.lower(player.Name), string.lower(player.DisplayName or player.Name)
			if name == query or display == query then
				return player
			end
			if not partial and (name:sub(1, #query) == query or display:sub(1, #query) == query) then
				partial = player
			end
		end
		return partial
	end

	function Utils.GetClosestPlayer(options)
		options = type(options) == "table" and options or {}
		local root = Utils.GetRoot()
		if not root then
			return nil
		end
		local best, bestDistance = nil, tonumber(options.MaxDistance) or math.huge
		for _, player in ipairs(Players:GetPlayers()) do
			local eligible = player ~= LocalPlayer
				and not (options.TeamCheck and player.Team ~= nil and player.Team == LocalPlayer.Team)
				and (options.AliveCheck == false or Utils.IsAlive(player))
			if eligible then
				local otherRoot = Utils.GetRoot(player)
				if otherRoot then
					local distance = (otherRoot.Position - root.Position).Magnitude
					if distance < bestDistance then
						best, bestDistance = player, distance
					end
				end
			end
		end
		return best, best and bestDistance or nil
	end

	function Utils.Teleport(target, offset)
		local root = Utils.GetRoot()
		if not root then
			return false
		end
		local goal
		if typeof(target) == "CFrame" then
			goal = target
		elseif typeof(target) == "Vector3" then
			goal = CFrame.new(target)
		elseif typeof(target) == "Instance" then
			if target:IsA("Player") then
				local otherRoot = Utils.GetRoot(target)
				goal = otherRoot and otherRoot.CFrame
			elseif target:IsA("BasePart") then
				goal = target.CFrame
			elseif target:IsA("Model") then
				goal = target:GetPivot()
			end
		end
		if not goal then
			return false
		end
		if typeof(offset) == "Vector3" then
			goal *= CFrame.new(offset)
		elseif typeof(offset) == "CFrame" then
			goal *= offset
		end
		local character = root.Parent
		local ok = pcall(function()
			if character and character:IsA("Model") then
				character:PivotTo(goal)
			else
				root.CFrame = goal
			end
		end)
		return ok
	end

	function Utils.Rejoin()
		local TeleportService = game:GetService("TeleportService")
		if #Players:GetPlayers() <= 1 then
			return pcall(TeleportService.Teleport, TeleportService, game.PlaceId, LocalPlayer)
		end
		return pcall(TeleportService.TeleportToPlaceInstance, TeleportService, game.PlaceId, game.JobId, LocalPlayer)
	end

	function Utils.ServerHop(options)
		options = type(options) == "table" and options or {}
		local lowest = options.Lowest == true
		local ok, servers = pcall(function()
			local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=%s&limit=100&excludeFullGames=true")
				:format(game.PlaceId, lowest and "Asc" or "Desc")
			return HttpService:JSONDecode(game:HttpGet(url)).data
		end)
		if not ok or type(servers) ~= "table" then
			return false, "could not load the server list"
		end
		local choices = {}
		for _, server in ipairs(servers) do
			if type(server) == "table" and server.id ~= game.JobId then
				local playing, maximum = tonumber(server.playing), tonumber(server.maxPlayers)
				if playing and maximum and playing < maximum then
					table.insert(choices, server.id)
				end
			end
		end
		if #choices == 0 then
			return false, "no other servers found"
		end
		local TeleportService = game:GetService("TeleportService")
		local choice = lowest and choices[1] or choices[math.random(#choices)]
		return pcall(TeleportService.TeleportToPlaceInstance, TeleportService, game.PlaceId, choice, LocalPlayer)
	end

	local antiAfkConnection
	function Utils.AntiAFK(enabled)
		if enabled == false then
			if antiAfkConnection then
				antiAfkConnection:Disconnect()
				antiAfkConnection = nil
			end
			return false
		end
		if antiAfkConnection then
			return true
		end
		local ok, connection = pcall(function()
			local VirtualUser = game:GetService("VirtualUser")
			return LocalPlayer.Idled:Connect(function()
				pcall(function()
					VirtualUser:CaptureController()
					VirtualUser:ClickButton2(Vector2.zero)
				end)
			end)
		end)
		if not ok or not connection then
			return false
		end
		antiAfkConnection = connection
		table.insert(Nucleus._cleanup, function()
			Utils.AntiAFK(false)
		end)
		return true
	end

	function Utils.GetExecutor()
		return getExecutorName()
	end

	function Utils.FormatNumber(number, decimals)
		number = tonumber(number) or 0
		local suffixes = { "", "K", "M", "B", "T", "Qd", "Qn" }
		local index, value = 1, math.abs(number)
		while value >= 1000 and index < #suffixes do
			value /= 1000
			index += 1
		end
		local text = string.format("%." .. math.clamp(tonumber(decimals) or 1, 0, 4) .. "f", value)
		if text:find("%.") then
			text = text:gsub("0+$", ""):gsub("%.$", "")
		end
		return (number < 0 and "-" or "") .. text .. suffixes[index]
	end

	function Utils.FormatTime(seconds)
		seconds = math.max(math.floor(tonumber(seconds) or 0), 0)
		local hours, minutes, rest = seconds // 3600, (seconds % 3600) // 60, seconds % 60
		if hours > 0 then
			return string.format("%d:%02d:%02d", hours, minutes, rest)
		end
		return string.format("%d:%02d", minutes, rest)
	end

	Nucleus.GetExecutor = function()
		return getExecutorName()
	end
end

Tab.CreateButtonRow = Tab.ButtonRow
Tab.CreateTextArea = Tab.TextArea

Tab.CreateStat = Tab.Stat
Tab.CreateImage = Tab.Image
Tab.CreateCode = Tab.Code
Tab.CreateSpace = Tab.Space

table.insert(Nucleus._themeListeners, function()
	for element in pairs(codeElements) do
		if not element._destroyed then
			element:_rerender()
		end
	end
end)

do
	function Nucleus:OnError(callback)
		if type(callback) ~= "function" then
			return { Disconnect = function() end }
		end
		table.insert(Nucleus._errorListeners, callback)
		return {
			Disconnect = function()
				local index = table.find(Nucleus._errorListeners, callback)
				if index then
					table.remove(Nucleus._errorListeners, index)
				end
			end,
		}
	end

	function Nucleus:GetErrors()
		return table.clone(Nucleus.Errors)
	end

	function Nucleus:ClearErrors()
		table.clear(Nucleus.Errors)
	end

	function Nucleus:SetErrorNotifications(enabled)
		Nucleus.ErrorNotifications = enabled ~= false
	end

	function Nucleus:Try(name, callback, ...)
		if type(name) == "function" then
			return runProtected("your code", name, callback, ...)
		end
		return runProtected(tostring(name), callback, ...)
	end

	function Nucleus:ReportError(where, message)
		return reportError(tostring(where or "your code"), { Error = message, Traceback = debug.traceback(nil, 2) or "" })
	end

	local Utils = Nucleus.Utils

	function Utils.WaitForCharacter(timeout)
		local deadline = os.clock() + (tonumber(timeout) or 10)
		repeat
			local character = LocalPlayer and LocalPlayer.Character
			if character and character:FindFirstChildOfClass("Humanoid") and (character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart) then
				return character
			end
			task.wait(0.1)
		until os.clock() > deadline
		return nil
	end

	function Utils.OnCharacter(callback)
		if type(callback) ~= "function" or not LocalPlayer then
			return { Disconnect = function() end }
		end
		local connection
		local ok = pcall(function()
			connection = LocalPlayer.CharacterAdded:Connect(function(character)
				runProtected("a character callback", callback, character)
			end)
		end)
		if LocalPlayer.Character then
			task.spawn(runProtected, "a character callback", callback, LocalPlayer.Character)
		end
		local handle = {
			Disconnect = function()
				if connection then
					connection:Disconnect()
					connection = nil
				end
			end,
		}
		if ok then
			table.insert(Nucleus._cleanup, handle.Disconnect)
		end
		return handle
	end

	local function dataPath(name)
		local clean = tostring(name or "data"):gsub("[^%w%-_ ]", "")
		if clean == "" then
			clean = "data"
		end
		return "NucleusUI/data/" .. clean .. ".json"
	end

	function Utils.SaveData(name, data)
		if type(writefile) ~= "function" then
			return false, "your executor can't write files"
		end
		local ok, err = pcall(function()
			if type(isfolder) == "function" and type(makefolder) == "function" then
				if not isfolder("NucleusUI") then
					makefolder("NucleusUI")
				end
				if not isfolder("NucleusUI/data") then
					makefolder("NucleusUI/data")
				end
			end
			writefile(dataPath(name), HttpService:JSONEncode(data))
		end)
		if not ok then
			log("SaveData failed: " .. tostring(err))
		end
		return ok, not ok and tostring(err) or nil
	end

	function Utils.LoadData(name, default)
		if type(readfile) ~= "function" then
			return default
		end
		local path = dataPath(name)
		if type(isfile) == "function" and not isfile(path) then
			path = path:gsub("^NucleusUI/", "NeoxHub/")
			if not isfile(path) then
				return default
			end
		end
		local ok, data = pcall(function()
			return HttpService:JSONDecode(readfile(path))
		end)
		if not ok then
			log("LoadData could not read " .. tostring(name) .. ", using the default instead")
			return default
		end
		return data
	end

	function Utils.Debounce(callback, seconds)
		local busy = false
		seconds = tonumber(seconds) or 0.5
		return function(...)
			if busy then
				return
			end
			busy = true
			task.delay(seconds, function()
				busy = false
			end)
			return callback(...)
		end
	end

	function Tab:SetBadge(value)
		if value == nil or value == false or value == "" or value == 0 then
			self._badgeText = nil
		else
			self._badgeText = tostring(value)
		end
		if not self._badge and self._badgeText then
			local badge = create("Frame", {
				Name = "Badge",
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -8, 0.5, 0),
				Size = UDim2.fromOffset(0, 16),
				AutomaticSize = Enum.AutomaticSize.X,
				BackgroundColor3 = Theme.Accent,
				BackgroundTransparency = 0.82,
				BorderSizePixel = 0,
				ZIndex = 2,
				Parent = self._button,
			})
			addCorner(badge, UDim.new(1, 0))
			addPadding(badge, 6, 6)
			self._badgeLabel = createLabel({
				Size = UDim2.new(0, 0, 1, 0),
				AutomaticSize = Enum.AutomaticSize.X,
				Text = "",
				TextSize = 10,
				FontFace = Fonts.Bold,
				TextColor3 = Theme.Accent,
				TextTruncate = Enum.TextTruncate.None,
				ZIndex = 2,
				Parent = badge,
			})
			self._badge = badge
			badge:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
				self:_fitBadge()
			end)
		end
		if self._badge then
			if self._badgeText then
				self._badgeLabel.Text = self._badgeText
			end
			self._badge.Visible = self._badgeText ~= nil and not self.Window._compact
			self:_fitBadge()
		end
		return self
	end

	function Tab:GetBadge()
		return self._badgeText
	end

	function Tab:_fitBadge()
		local label = self._label
		if not label then
			return
		end
		local reserve = 0
		if self._badge and self._badge.Visible then
			local scale = self.Window.Scale and self.Window.Scale.Scale or 1
			reserve = self._badge.AbsoluteSize.X / math.max(scale, 0.01) + 6
		end
		label.Size = UDim2.new(1, -(self._labelX + 8 + reserve), 1, 0)
	end

	function Tab:AccentPicker(input)
		local options = normalizeOptions(input, { Title = "Name", Description = "Desc" })
		local userCallback = options.Callback
		return self:ColorPicker({
			Name = options.Name or "Accent colour",
			Desc = options.Desc,
			Default = options.Default or Theme.Accent,
			Flag = options.Flag,
			Callback = function(color)
				Nucleus:SetAccent(color)
				safeCall(userCallback, color)
			end,
		})
	end

	Tab.CreateAccentPicker = Tab.AccentPicker

	local NOTIFY_POSITION_NAMES = { "TopRight", "BottomRight", "TopLeft", "BottomLeft", "Top", "Bottom" }

	function Window:GetNotificationHistory()
		local copy = {}
		for index, entry in ipairs(self._notifyHistory or {}) do
			copy[index] = table.clone(entry)
		end
		return copy
	end

	function Window:ClearNotificationHistory()
		self._notifyHistory = {}
	end

	function Window:ShowNotificationHistory(limit)
		limit = math.clamp(tonumber(limit) or 8, 1, 50)
		local lines = {}
		for index, entry in ipairs(self._notifyHistory or {}) do
			if index > limit then
				break
			end
			local line = os.date("%H:%M", entry.Time) .. "  " .. entry.Title
			if entry.Content ~= "" then
				line ..= ": " .. entry.Content
			end
			table.insert(lines, line)
		end
		return self:Dialog({
			Title = "Recent notifications",
			Content = #lines > 0 and table.concat(lines, "\n") or "No notifications yet.",
			Buttons = {
				{ Title = "Clear", Callback = function()
					self:ClearNotificationHistory()
				end },
				{ Title = "Close", Variant = "Primary" },
			},
		})
	end

	function Tab:Settings(input)
		local options = normalizeOptions(input, {})
		local prefix = tostring(options.FlagPrefix or "Nucleus")
		local tab = self
		local window = self.Window
		local titles = type(options.Titles) == "table" and options.Titles or {}
		local function section(key, default)
			if titles[key] ~= false then
				tab:Section(tostring(titles[key] or default))
			end
		end

		if options.Interface ~= false then
			section("Interface", "Interface")
			if options.Theme ~= false then
				tab:ThemePicker({ Flag = prefix .. "Theme" })
			end
			if options.Accent ~= false then
				tab:AccentPicker({ Flag = prefix .. "Accent" })
			end
			if options.Scale ~= false then
				tab:Slider({
					Name = "Interface size",
					Min = 50,
					Max = 150,
					Step = 5,
					Suffix = "%",
					Default = math.floor(window:GetScale() * 100 + 0.5),
					Flag = prefix .. "Scale",
					OnRelease = true,
					Callback = function(value)
						window:SetScale(value / 100)
					end,
				})
			end
			if options.Keybind ~= false and not IS_TOUCH then
				tab:Keybind({
					Name = "Show / hide key",
					Default = window.Keybind and window.Keybind.Name or "RightControl",
					Flag = prefix .. "ToggleKey",
					OnChanged = function(keyCode)
						if keyCode then
							window:SetKeybind(keyCode)
						end
					end,
				})
			end
			if options.Notifications ~= false then
				tab:Dropdown({
					Name = "Notification position",
					Options = NOTIFY_POSITION_NAMES,
					Default = window._notifyHost and window._notifyHost.Position or NOTIFY_POSITION_NAMES[1],
					Flag = prefix .. "NotifyPosition",
					Callback = function(position)
						if type(position) == "string" then
							window:SetNotificationPosition(position)
						end
					end,
				})
			end
			if options.Sidebar ~= false then
				tab:Toggle({
					Name = "Compact sidebar",
					Default = window:IsSidebarCollapsed(),
					Flag = prefix .. "CompactSidebar",
					Callback = function(on)
						window:SetSidebarCollapsed(on)
					end,
				})
			end
			if options.Anonymous ~= false then
				tab:Toggle({
					Name = "Hide my name and avatar",
					Default = false,
					Flag = prefix .. "Anonymous",
					Callback = function(on)
						window:SetAnonymous(on)
					end,
				})
			end
			if options.History ~= false then
				tab:Button({
					Name = "Recent notifications",
					Callback = function()
						window:ShowNotificationHistory()
					end,
				})
			end
		end

		if options.Configs ~= false then
			tab:ConfigManager({ Name = titles.Configs or "Configs" })
		end

		if options.Server ~= false then
			section("Server", "Server")
			tab:ButtonRow({
				{ Name = "Rejoin", Icon = "refresh-cw", Callback = function()
					Nucleus.Utils.Rejoin()
				end },
				{ Name = "Server hop", Icon = "shuffle", Callback = function()
					Nucleus.Utils.ServerHop()
				end },
			})
		end

		if options.Unload ~= false then
			section("Script", "Script")
			tab:Button({
				Name = "Unload " .. tostring(window._titleLabel and window._titleLabel.Text or Const.LIB_NAME),
				Style = "Danger",
				Confirm = "Click again to unload",
				Callback = function()
					window:Destroy()
				end,
			})
		end

		return tab
	end

	function Window:SettingsTab(input)
		local options = normalizeOptions(input, { Title = "Name" })
		local tab = self:Tab({
			Name = options.Name or "Settings",
			Icon = options.Icon or "settings",
			Section = options.Section,
			Badge = options.Badge,
		})
		tab:Settings(options)
		return tab
	end

	local SOCIAL_PRESETS = {
		discord = { "Discord", "logo-discord" },
		youtube = { "YouTube", "logo-youtube" },
		instagram = { "Instagram", "logo-instagram" },
		tiktok = { "TikTok", "music-2" },
		twitter = { "X", "logo-x" },
		x = { "X", "logo-x" },
		github = { "GitHub", "logo-github" },
		twitch = { "Twitch", "logo-twitch" },
		facebook = { "Facebook", "logo-facebook" },
		telegram = { "Telegram", "logo-telegram" },
		reddit = { "Reddit", "logo-reddit" },
		whatsapp = { "WhatsApp", "logo-whatsapp" },
		pinterest = { "Pinterest", "logo-pinterest" },
		threads = { "Threads", "logo-threads" },
		linkedin = { "LinkedIn", "linkedin" },
		roblox = { "Roblox", "gamepad-2" },
		kofi = { "Ko-fi", "coffee" },
		patreon = { "Patreon", "heart-handshake" },
		paypal = { "PayPal", "wallet" },
		website = { "Website", "globe" },
	}

	local SOCIAL_DOMAINS = {
		["discord.gg"] = "discord", ["discord.com"] = "discord", ["youtube.com"] = "youtube", ["youtu.be"] = "youtube",
		["instagram.com"] = "instagram", ["tiktok.com"] = "tiktok", ["twitter.com"] = "twitter", ["x.com"] = "x",
		["github.com"] = "github", ["twitch.tv"] = "twitch", ["facebook.com"] = "facebook", ["fb.com"] = "facebook",
		["t.me"] = "telegram", ["telegram.me"] = "telegram", ["reddit.com"] = "reddit", ["wa.me"] = "whatsapp",
		["whatsapp.com"] = "whatsapp", ["pinterest.com"] = "pinterest", ["threads.net"] = "threads",
		["linkedin.com"] = "linkedin", ["roblox.com"] = "roblox", ["ko-fi.com"] = "kofi", ["patreon.com"] = "patreon",
		["paypal.me"] = "paypal", ["paypal.com"] = "paypal",
	}

	local function detectSocial(kind, name, link)
		local key = type(kind) == "string" and kind:lower():gsub("[%s%-_]", "") or nil
		if key and SOCIAL_PRESETS[key] then
			return key
		end
		key = type(name) == "string" and name:lower():gsub("[%s%-_]", "") or nil
		if key and SOCIAL_PRESETS[key] then
			return key
		end
		if type(link) == "string" then
			local host = link:lower():gsub("^%a+://", ""):match("^[^/%?#:]+") or ""
			while host ~= "" do
				if SOCIAL_DOMAINS[host] then
					return SOCIAL_DOMAINS[host]
				end
				local dot = host:find("%.")
				if not dot then
					break
				end
				host = host:sub(dot + 1)
			end
		end
		return "website"
	end

	local function normalizeSocials(input)
		local source = input
		if type(source) == "table" and type(source.Links) == "table" then
			source = source.Links
		end
		local list = {}
		if type(source) ~= "table" then
			return list
		end
		local named = {}
		for key, value in pairs(source) do
			if type(key) == "string" and type(value) == "string" and SOCIAL_PRESETS[key:lower():gsub("[%s%-_]", "")] then
				table.insert(named, { Type = key, Link = value })
			end
		end
		table.sort(named, function(a, b)
			return a.Type < b.Type
		end)
		for _, entry in ipairs(source) do
			if type(entry) == "string" then
				entry = { Link = entry }
			end
			if type(entry) == "table" then
				local link = entry.Link or entry.Url or entry.URL or entry[2]
				if type(link) == "string" and link ~= "" then
					table.insert(named, {
						Type = entry.Type,
						Name = entry.Name or entry.Title or entry[1],
						Link = link,
						Icon = entry.Icon,
					})
				end
			end
		end
		for _, entry in ipairs(named) do
			local preset = SOCIAL_PRESETS[detectSocial(entry.Type, entry.Name, entry.Link)]
			table.insert(list, {
				Name = tostring(entry.Name or preset[1]),
				Link = entry.Link,
				Icon = entry.Icon or preset[2],
			})
		end
		return list
	end

	local function formatAmount(number)
		local text = tostring(math.floor(tonumber(number) or 0))
		local formatted = text:reverse():gsub("(%d%d%d)", "%1,"):reverse()
		return (formatted:gsub("^,", ""))
	end

	local function createInfoCard(parent, order, title, icon, text)
		local card = create("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = Theme.Surface2,
			BorderSizePixel = 0,
			LayoutOrder = order,
			Parent = parent,
		})
		card:SetAttribute(Const.ATTR_NO_DRAG, true)
		styleCard(card)
		addPadding(card, 14, 14, 12, 14)
		create("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 10),
			Parent = card,
		})
		local header = create("Frame", {
			Size = UDim2.new(1, 0, 0, 20),
			BackgroundTransparency = 1,
			LayoutOrder = 1,
			Parent = card,
		})
		createIcon(header, icon, Theme.Accent, UDim2.new(0, 0, 0.5, 0))
		local titleLabel = createLabel({
			Name = "Title",
			Position = UDim2.fromOffset(24, 0),
			Size = UDim2.new(1, -24, 1, 0),
			Text = title,
			TextSize = 14,
			Parent = header,
		})
		local textLabel
		if text and text ~= "" then
			textLabel = createLabel({
				Name = "Text",
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				Text = text,
				TextSize = 12,
				FontFace = Fonts.Regular,
				TextColor3 = Theme.Muted,
				TextWrapped = true,
				TextTruncate = Enum.TextTruncate.None,
				LayoutOrder = 2,
				Parent = card,
			})
		end
		return card, titleLabel, textLabel
	end

	local function createButtonGrid(card, order, count)
		local columns = math.max(1, math.min(count, IS_TOUCH and 2 or 3))
		local grid = create("Frame", {
			Name = "Buttons",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = order,
			Parent = card,
		})
		create("UIGridLayout", {
			CellSize = UDim2.new(1 / columns, -math.ceil(8 * (columns - 1) / columns), 0, 34),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = grid,
		})
		return grid
	end

	local function createGridButton(grid, order, text, icon, sideText, primary, onClick)
		local button = create("TextButton", {
			BackgroundColor3 = primary and Theme.Accent or Theme.Surface,
			BackgroundTransparency = primary and 0.1 or 0,
			BorderSizePixel = 0,
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = order,
			Parent = grid,
		})
		button:SetAttribute(Const.ATTR_NO_DRAG, true)
		addCorner(button, UDim.new(0, 8))
		local textColor = primary and Theme.AccentDark or Theme.Text
		local left = 10
		if icon then
			createIcon(button, icon, primary and Theme.AccentDark or Theme.Accent, UDim2.new(0, 10, 0.5, 0))
			left = 32
		end
		local sideWidth = 0
		if sideText and sideText ~= "" then
			local side = createLabel({
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -10, 0.5, 0),
				Size = UDim2.fromOffset(0, 16),
				AutomaticSize = Enum.AutomaticSize.X,
				Text = sideText,
				TextSize = 11,
				FontFace = Fonts.Bold,
				TextColor3 = primary and Theme.AccentDark or Theme.Muted,
				TextTruncate = Enum.TextTruncate.None,
				Parent = button,
			})
			sideWidth = math.max(28, #sideText * 7)
			side.TextXAlignment = Enum.TextXAlignment.Right
		end
		createLabel({
			Position = UDim2.fromOffset(left, 0),
			Size = UDim2.new(1, -(left + 10 + (sideWidth > 0 and sideWidth + 6 or 0)), 1, 0),
			Text = text,
			TextSize = 12,
			TextColor3 = textColor,
			Parent = button,
		})
		button.MouseEnter:Connect(function()
			if IS_TOUCH then
				return
			end
			tween(button, { BackgroundTransparency = primary and 0 or 0.35 }, 0.12)
		end)
		button.MouseLeave:Connect(function()
			tween(button, { BackgroundTransparency = primary and 0.1 or 0 }, 0.2)
		end)
		button.MouseButton1Click:Connect(onClick)
		return button
	end

	local function buildSocialsCard(parent, order, input)
		local options = type(input) == "table" and input or {}
		local links = normalizeSocials(input)
		if #links == 0 then
			log("Socials needs at least one link, like { YouTube = \"https://youtube.com/@you\" }")
			return nil
		end
		local card, titleLabel = createInfoCard(parent, order, tostring(options.Title or "Community"), options.Icon or "users-round", options.Text)
		local controller = { Links = links, Frame = card }
		local grid
		local function render()
			if grid then
				grid:Destroy()
			end
			grid = createButtonGrid(card, 3, #controller.Links)
			for index, entry in ipairs(controller.Links) do
				createGridButton(grid, index, entry.Name, entry.Icon, nil, false, function()
					Nucleus:Copy(entry.Link)
					safeCall(options.OnClick, entry)
				end)
			end
		end
		render()
		function controller:SetLinks(newLinks)
			local normalized = normalizeSocials(newLinks)
			if #normalized == 0 then
				log("SetLinks needs at least one link")
				return false
			end
			controller.Links = normalized
			render()
			return true
		end
		function controller:AddLink(link, name)
			local normalized = normalizeSocials({ type(link) == "table" and link or { Name = name, Link = link } })
			if #normalized == 0 then
				return false
			end
			table.insert(controller.Links, normalized[1])
			render()
			return true
		end
		function controller:SetTitle(text)
			titleLabel.Text = tostring(text)
		end
		return card, controller
	end

	local DONATION_ICONS = {
		{ "paypal", "wallet" }, { "ko%-?fi", "coffee" }, { "buymeacoffee", "coffee" }, { "coffee", "coffee" },
		{ "patreon", "heart-handshake" }, { "stripe", "credit-card" }, { "card", "credit-card" },
		{ "bitcoin", "logo-bitcoin" }, { "btc", "logo-bitcoin" }, { "ethereum", "coins" }, { "eth", "coins" },
		{ "usdt", "coins" }, { "tether", "coins" }, { "litecoin", "coins" }, { "ltc", "coins" }, { "solana", "coins" },
		{ "crypto", "coins" },
	}

	local function donationIcon(item)
		if item.Icon then
			return item.Icon
		end
		local haystack = (tostring(item.Name or "") .. " " .. tostring(item.Network or "") .. " " .. tostring(item.Link or "")):lower()
		for _, rule in ipairs(DONATION_ICONS) do
			if haystack:find(rule[1]) then
				return rule[2]
			end
		end
		if item.Address then
			return "wallet"
		end
		if item.Link then
			return "hand-coins"
		end
		return "heart"
	end

	local function amountText(amount, prefix)
		if amount == nil or amount == "" then
			return nil
		end
		if type(amount) == "number" then
			local whole = math.floor(amount)
			local text = whole == amount and tostring(whole) or string.format("%.2f", amount)
			return tostring(prefix or "$") .. text
		end
		return tostring(amount)
	end

	local function normalizeDonations(input)
		local options = type(input) == "table" and input or {}
		local list = {}
		for _, entry in ipairs(options.Options or options.Tiers or options) do
			if type(entry) == "table" then
				local item = {
					Name = tostring(entry.Name or entry.Title or "Donate"),
					Amount = entry.Amount or entry.Price,
					Link = entry.Link or entry.Url or entry.URL,
					Address = entry.Address or entry.Wallet,
					Network = entry.Network,
					Icon = entry.Icon,
					Callback = entry.Callback,
					Primary = entry.Primary == true,
				}
				if entry.Robux or entry.AssetId or entry.GamePassId then
					log(("donation option \"%s\": Robux donations aren't supported. Use Link (PayPal, Ko-fi...) or Address (crypto)."):format(item.Name))
				end
				if item.Link or item.Address or type(item.Callback) == "function" then
					table.insert(list, item)
				else
					log(("donation option \"%s\" needs Link, Address or Callback"):format(item.Name))
				end
			end
		end
		return options, list
	end

	function Window:_donate(item, donationOptions)
		donationOptions = donationOptions or {}
		if item.Link or item.Address then
			local copied = Nucleus:Copy(item.Link or item.Address, true)
			if copied then
				local title
				if item.Address then
					title = (item.Network and (tostring(item.Network) .. " address") or "Wallet address") .. " copied"
				else
					title = item.Name .. " link copied"
				end
				self:Notify({
					Title = title,
					Content = tostring(donationOptions.Thanks or (item.Address and "Paste it in your wallet app. Thank you for the support!" or "Paste it in your browser to donate. Thank you for the support!")),
					Type = "Success",
					Icon = "heart",
					Duration = 6,
				})
			end
		end
		if type(item.Callback) == "function" then
			runProtected(('donation option "%s"'):format(item.Name), item.Callback, item)
		end
		safeCall(donationOptions.OnClick, item)
	end

	local function buildDonationCard(window, parent, order, input)
		local options, items = normalizeDonations(input)
		if #items == 0 then
			log("Donations needs at least one option, like { Name = \"PayPal\", Link = \"https://paypal.me/you\" }")
			return nil
		end
		local card, titleLabel, textLabel = createInfoCard(parent, order, tostring(options.Title or "Support the creator"), options.Icon or "heart", options.Text or "Donations are optional and help keep the script updated.")
		local controller = { Options = items, Frame = card }
		local goalRow, goalAmount, goalFill, goalLabel
		local goalPrefix = tostring(options.Currency or "$")

		function controller:SetGoal(current, target, label)
			if type(current) == "table" then
				current, target, label = current.Current, current.Target, current.Label
			end
			if current == nil and target == nil then
				if goalRow then
					goalRow.Visible = false
				end
				return true
			end
			target = tonumber(target) or (controller._target)
			if not target or target <= 0 then
				log("SetGoal needs a target above 0")
				return false
			end
			controller._target = target
			current = math.max(0, tonumber(current) or 0)
			if not goalRow then
				goalRow = create("Frame", {
					Name = "Goal",
					Size = UDim2.new(1, 0, 0, 24),
					BackgroundTransparency = 1,
					LayoutOrder = 3,
					Parent = card,
				})
				goalLabel = createLabel({
					Size = UDim2.new(0.45, -4, 0, 14),
					Text = "Goal",
					TextSize = 12,
					TextColor3 = Theme.Text,
					Parent = goalRow,
				})
				goalAmount = createLabel({
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.fromScale(1, 0),
					Size = UDim2.new(0.55, 0, 0, 14),
					Text = "",
					TextSize = 12,
					FontFace = Fonts.Regular,
					TextColor3 = Theme.Muted,
					TextXAlignment = Enum.TextXAlignment.Right,
					Parent = goalRow,
				})
				local track = create("Frame", {
					Position = UDim2.fromOffset(0, 19),
					Size = UDim2.new(1, 0, 0, 5),
					BackgroundColor3 = Theme.Surface3,
					BorderSizePixel = 0,
					Parent = goalRow,
				})
				addCorner(track, UDim.new(1, 0))
				goalFill = create("Frame", {
					Size = UDim2.fromScale(0, 1),
					BackgroundColor3 = Theme.Accent,
					BorderSizePixel = 0,
					Parent = track,
				})
				addCorner(goalFill, UDim.new(1, 0))
			end
			if label ~= nil then
				goalLabel.Text = tostring(label)
			end
			goalRow.Visible = true
			goalAmount.Text = goalPrefix .. formatAmount(current) .. " / " .. goalPrefix .. formatAmount(target)
			goalFill.Size = UDim2.fromScale(math.clamp(current / target, 0, 1), 1)
			controller.Goal = { Current = current, Target = target, Label = goalLabel.Text }
			return true
		end

		local goal = type(options.Goal) == "table" and options.Goal or nil
		if goal then
			goalPrefix = tostring(goal.Prefix or goalPrefix)
			controller:SetGoal(goal.Current, goal.Target, goal.Label or "Goal")
		end

		local grid
		local function render()
			if grid then
				grid:Destroy()
			end
			grid = createButtonGrid(card, 4, #controller.Options)
			for index, item in ipairs(controller.Options) do
				local side = amountText(item.Amount, options.Currency) or (item.Address and "Copy" or nil)
				createGridButton(grid, index, item.Name, donationIcon(item), side, item.Primary, function()
					window:_donate(item, options)
				end)
			end
		end
		render()

		function controller:SetOptions(newOptions)
			local _, normalized = normalizeDonations({ Options = newOptions })
			if #normalized == 0 then
				log("SetOptions needs at least one donation option")
				return false
			end
			controller.Options = normalized
			render()
			return true
		end
		function controller:AddOption(option)
			local _, normalized = normalizeDonations({ Options = { option } })
			if #normalized == 0 then
				return false
			end
			table.insert(controller.Options, normalized[1])
			render()
			return true
		end
		function controller:SetTitle(text)
			titleLabel.Text = tostring(text)
		end
		function controller:SetText(text)
			if textLabel then
				textLabel.Text = tostring(text)
			end
		end
		return card, controller
	end

	function Window:_buildCommunity(parent)
		local shown = self._homeShown or function()
			return true
		end
		local orderOf = self._homeOrderOf or function(_, default)
			return default
		end
		local socials = self._socialsOptions
		if socials ~= nil and socials ~= false and shown("Socials") and not (type(socials) == "table" and socials.ShowOnHome == false) then
			self._socialsCard, self.Socials = buildSocialsCard(parent, orderOf("Socials", 3), socials)
		end
		local donations = self._donationOptions
		if donations ~= nil and donations ~= false and shown("Donations") and not (type(donations) == "table" and donations.ShowOnHome == false) then
			self._donationCard, self.Donations = buildDonationCard(self, parent, orderOf("Donations", 4), donations)
		end
	end

	function Window:_setupDonations()
		local donations = self._donationOptions
		if type(donations) ~= "table" or donations.HeaderButton == false then
			return
		end
		local _, items = normalizeDonations(donations)
		if #items == 0 then
			return
		end
		self._donationHeader = self:HeaderButton({
			Icon = donations.Icon or "heart",
			Tooltip = tostring(donations.Title or "Support the creator"),
			Callback = function()
				self:ShowDonations()
			end,
		})
	end

	function Window:ShowDonations()
		local card = self._donationCard
		if card and card.Parent and self.Home then
			if not self.Open then
				self:Toggle(true)
			end
			if self._showHomePage then
				self._showHomePage(1)
			end
			self:SelectTab(self.Home)
			task.defer(function()
				local list = self.Home.List
				if card.Parent and list then
					local scale = self.Scale and self.Scale.Scale or 1
					local offset = (card.AbsolutePosition.Y - list.AbsolutePosition.Y) / math.max(scale, 0.01)
					list.CanvasPosition = Vector2.new(0, math.max(0, list.CanvasPosition.Y + offset - 8))
				end
			end)
			return true
		end
		local options, items = normalizeDonations(self._donationOptions)
		if #items == 0 then
			return false
		end
		local buttons = {}
		for index, item in ipairs(items) do
			if index > 3 then
				break
			end
			local amount = amountText(item.Amount, options.Currency)
			table.insert(buttons, {
				Title = amount and (item.Name .. "  " .. amount) or item.Name,
				Variant = item.Primary and "Primary" or nil,
				Callback = function()
					self:_donate(item, options)
				end,
			})
		end
		table.insert(buttons, { Title = "Later" })
		self:Dialog({
			Title = tostring(options.Title or "Support the creator"),
			Content = tostring(options.Text or "Donations are optional and help keep the script updated."),
			Icon = options.Icon or "heart",
			Buttons = buttons,
		})
		return true
	end

	function Tab:Socials(input)
		local card, controller = buildSocialsCard(self.List, self:_nextOrder(), input)
		if not card then
			return nil
		end
		return registerElement(self, { Name = type(input) == "table" and input.Title or "Community" }, controller, card, "Socials")
	end

	function Tab:Donations(input)
		local card, controller = buildDonationCard(self.Window, self.List, self:_nextOrder(), input)
		if not card then
			return nil
		end
		return registerElement(self, { Name = type(input) == "table" and input.Title or "Support the creator" }, controller, card, "Donations")
	end

	local function shortLink(link)
		local text = tostring(link):gsub("^https?://", ""):gsub("^www%.", ""):gsub("/$", "")
		return text
	end

	local function createActionRow(tab, options, icon, sideText, onClick)
		local height = options.Desc and Const.ROW_HEIGHT_DESC or Const.ROW_HEIGHT
		local card, stroke = createCard(tab, "TextButton", height)
		bindHoverStroke(card, stroke)
		createIcon(card, icon, Theme.Accent, UDim2.new(0, 14, 0.5, 0))
		local reserve = 30
		local side
		if sideText and sideText ~= "" then
			side = createLabel({
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -14, 0.5, 0),
				Size = UDim2.fromOffset(0, 16),
				AutomaticSize = Enum.AutomaticSize.X,
				Text = sideText,
				TextSize = 12,
				FontFace = Fonts.Bold,
				TextColor3 = Theme.Muted,
				TextTruncate = Enum.TextTruncate.None,
				Parent = card,
			})
			reserve = math.max(30, #sideText * 8 + 20)
		else
			createIcon(card, "copy", Theme.Muted, UDim2.new(1, -30, 0.5, 0))
		end
		local titleLabel, descLabel = createTitleBlock(card, options.Name, options.Desc, reserve)
		for _, label in ipairs({ titleLabel, descLabel }) do
			label.Position += UDim2.fromOffset(26, 0)
			label.Size -= UDim2.fromOffset(26, 0)
		end
		card.MouseButton1Click:Connect(onClick)
		return card, titleLabel, descLabel, side
	end

	function Tab:SocialLink(input, maybeLink)
		if type(input) == "string" and type(maybeLink) == "string" then
			input = { Name = input, Link = maybeLink }
		elseif type(input) == "string" then
			input = { Link = input }
		end
		local raw = type(input) == "table" and input or {}
		local normalized = normalizeSocials({ raw })
		if #normalized == 0 then
			log("SocialLink needs a Link, like Tab:SocialLink(\"https://youtube.com/@you\")")
			return nil
		end
		local entry = normalized[1]
		local options = {
			Name = entry.Name,
			Desc = raw.Desc or raw.Description or (raw.ShowLink ~= false and shortLink(entry.Link) or nil),
		}
		local element = { Link = entry.Link }
		local card, titleLabel, descLabel = createActionRow(self, options, entry.Icon, nil, function()
			Nucleus:Copy(element.Link)
			safeCall(raw.Callback or raw.OnClick, element.Link)
		end)
		function element:SetLink(link)
			element.Link = tostring(link)
			if descLabel and raw.Desc == nil and raw.ShowLink ~= false then
				descLabel.Text = shortLink(element.Link)
			end
		end
		function element:Get()
			return element.Link
		end
		function element:SetTitle(text)
			titleLabel.Text = tostring(text)
		end
		return registerElement(self, { Name = entry.Name, Flag = raw.Flag }, element, card, "SocialLink")
	end

	function Tab:DonateButton(input)
		local raw = type(input) == "table" and input or {}
		local options, items = normalizeDonations({
			Options = { raw },
			Thanks = raw.Thanks,
			OnClick = raw.OnClick,
			Currency = raw.Currency,
		})
		if #items == 0 then
			return nil
		end
		local item = items[1]
		local side = amountText(item.Amount, options.Currency) or (item.Address and "Copy" or nil)
		local window = self.Window
		local card, titleLabel = createActionRow(self, { Name = item.Name, Desc = raw.Desc or raw.Description }, donationIcon(item), side or "", function()
			window:_donate(item, options)
		end)
		local element = { Option = item }
		function element:SetTitle(text)
			titleLabel.Text = tostring(text)
		end
		return registerElement(self, { Name = item.Name }, element, card, "DonateButton")
	end

	function Tab:Membership(input)
		return self:KeyInfo(input)
	end

	function Tab:Changelog(input)
		local entries = type(input) == "table" and (input.Entries or input) or {}
		local element = { Entries = {} }
		local holder = create("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = self:_nextOrder(),
			Parent = self.List,
		})
		create("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, Appearance.Spacing),
			Parent = holder,
		})
		local count = 0
		function element:Add(entry, atTop)
			if type(entry) ~= "table" then
				return false
			end
			count += 1
			createChangelogCard(holder, atTop and -count or count, entry)
			table.insert(element.Entries, atTop and 1 or #element.Entries + 1, entry)
			return true
		end
		function element:Clear()
			for _, child in ipairs(holder:GetChildren()) do
				if child:IsA("GuiObject") then
					child:Destroy()
				end
			end
			element.Entries = {}
		end
		for _, entry in ipairs(entries) do
			element:Add(entry)
		end
		return registerElement(self, { Name = "Changelog" }, element, holder, "Changelog")
	end

	function Tab:Welcome(input)
		local options = type(input) == "table" and input or {}
		local card = create("Frame", {
			Size = UDim2.new(1, 0, 0, 58),
			BackgroundColor3 = Theme.Surface2,
			BorderSizePixel = 0,
			LayoutOrder = self:_nextOrder(),
			Parent = self.List,
		})
		card:SetAttribute(Const.ATTR_NO_DRAG, true)
		styleCard(card)
		local avatar = create("ImageLabel", {
			Position = UDim2.fromOffset(12, 11),
			Size = UDim2.fromOffset(36, 36),
			BackgroundColor3 = Theme.Surface,
			BorderSizePixel = 0,
			Parent = card,
		})
		addCorner(avatar, UDim.new(0, 8))
		task.spawn(function()
			local ok, image = pcall(function()
				return Players:GetUserThumbnailAsync(LocalPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
			end)
			if ok and image and avatar.Parent then
				avatar.Image = image
			end
		end)
		local greeting = options.Greeting
		if greeting == nil then
			local hour = tonumber(os.date("%H")) or 12
			greeting = "Good " .. (hour < 12 and "morning" or (hour < 18 and "afternoon" or "evening")) .. "."
		end
		local titleLabel = createLabel({
			Position = UDim2.fromOffset(58, 11),
			Size = UDim2.new(1, -72, 0, 18),
			Text = tostring(options.Text or options.Welcome or "Hello, ") .. LocalPlayer.DisplayName,
			TextSize = 15,
			Parent = card,
		})
		local greetingLabel = createLabel({
			Position = UDim2.fromOffset(58, 30),
			Size = UDim2.new(1, -72, 0, 16),
			Text = tostring(greeting),
			TextSize = 13,
			FontFace = Fonts.Regular,
			TextColor3 = Theme.Muted,
			Parent = card,
		})
		local element = {}
		function element:SetGreeting(text)
			greetingLabel.Text = tostring(text)
		end
		function element:SetTitle(text)
			titleLabel.Text = tostring(text)
		end
		return registerElement(self, { Name = "Welcome" }, element, card, "Welcome")
	end

	local SYSTEM_STATS = {
		FPS = { "activity", "FPS" },
		Ping = { "wifi", "Ping" },
		Executor = { "terminal", "Executor" },
		Game = { "gamepad-2", "Game" },
		Region = { "globe", "Your region" },
		Time = { "clock", "Time of day" },
		Players = { "users", "Players" },
		Uptime = { "timer", "Session" },
	}

	function Tab:SystemStats(input)
		local options = type(input) == "table" and input or {}
		local names = options.Stats or (#options > 0 and options) or { "FPS", "Ping", "Executor", "Game", "Region", "Time" }
		local window = self.Window
		local grid = create("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = self:_nextOrder(),
			Parent = self.List,
		})
		create("UIGridLayout", {
			CellSize = UDim2.new(0.5, -4, 0, 62),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = grid,
		})
		local values = {}
		for index, name in ipairs(names) do
			local preset = SYSTEM_STATS[name]
			if preset then
				values[name] = createStatTile(grid, index, preset[1], preset[2])
			else
				log(("SystemStats has no stat \"%s\". Use FPS, Ping, Executor, Game, Region, Time, Players or Uptime."):format(tostring(name)))
			end
		end
		if values.Executor then
			values.Executor.Text = getExecutorName()
		end
		if values.Game then
			values.Game.Text = "Loading"
			task.spawn(function()
				local name = getGameName()
				if values.Game.Parent then
					values.Game.Text = name
				end
			end)
		end
		if values.Region then
			values.Region.Text = "Loading"
			fetchRegion(function(region)
				if values.Region.Parent then
					values.Region.Text = region
				end
			end, options.RegionCity == false)
		end
		local frames = 0
		local sessionStart = os.clock()
		window:_listen("Render", function()
			frames += 1
		end)
		local tab = self._rootTab or self
		task.spawn(function()
			while not window._destroyed and grid.Parent do
				if window.Open and window.CurrentTab == tab and grid.Visible then
					if values.FPS then
						values.FPS.Text = tostring(frames)
					end
					if values.Ping then
						local ok, ping = pcall(function()
							return math.floor(LocalPlayer:GetNetworkPing() * 1000)
						end)
						values.Ping.Text = (ok and ping or 0) .. " ms"
					end
					if values.Time then
						values.Time.Text = os.date(options.TimeFormat or "%H:%M")
					end
					if values.Players then
						values.Players.Text = #Players:GetPlayers() .. " / " .. Players.MaxPlayers
					end
					if values.Uptime then
						local seconds = math.floor(os.clock() - sessionStart)
						values.Uptime.Text = string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
					end
				end
				frames = 0
				task.wait(1)
			end
		end)
		return registerElement(self, { Name = "System stats" }, { Values = values }, grid, "SystemStats")
	end

	Tab.CreateSocials = Tab.Socials
	Tab.CreateDonations = Tab.Donations
	Tab.Donate = Tab.Donations
	Tab.CreateSocialLink = Tab.SocialLink
	Tab.CreateDonateButton = Tab.DonateButton
	Tab.CreateMembership = Tab.Membership
	Tab.CreateChangelog = Tab.Changelog
	Tab.CreateWelcome = Tab.Welcome
	Tab.CreateSystemStats = Tab.SystemStats
	Tab.CreateSettings = Tab.Settings

	function Tab:SetVisible(visible)
		visible = visible ~= false
		self._userHidden = not visible
		local window = self.Window
		local section = self._section
		local show = visible and (section == nil or section.Opened or window._compact)
		self._button:SetAttribute(Const.ATTR_HIDDEN, not show)
		if window._introDone then
			self._button.Visible = show
		end
		if section and section._refreshCount then
			section:_refreshCount()
		end
		if not visible and window.CurrentTab == self then
			for _, other in ipairs(window.Tabs) do
				if other ~= self and not other._userHidden then
					window:SelectTab(other)
					break
				end
			end
		elseif window.CurrentTab then
			window:_placeIndicator(window.CurrentTab)
		end
		return self
	end

	function Tab:Hide()
		return self:SetVisible(false)
	end

	function Tab:Show()
		return self:SetVisible(true)
	end

	function Tab:IsVisible()
		return not self._userHidden
	end

	function Tab:IsSelected()
		return self.Window.CurrentTab == self
	end

	function Tab:SetIcon(icon)
		if self._icon then
			if icon == nil or icon == false then
				self._icon.Visible = false
			else
				setIcon(self._icon, icon)
				self._icon.Visible = true
			end
		end
		return self
	end

	function Tab:Destroy()
		local window = self.Window
		if self._destroyed then
			return
		end
		self._destroyed = true
		if window._outLayer then
			window:_settleTransition()
		end
		local index = table.find(window.Tabs, self)
		if index then
			table.remove(window.Tabs, index)
		end
		if self._section then
			local sectionIndex = table.find(self._section.Tabs, self)
			if sectionIndex then
				table.remove(self._section.Tabs, sectionIndex)
			end
			if self._section._refreshCount then
				self._section:_refreshCount()
			end
		end
		for flag, element in pairs(window.Flags) do
			local owner = element._tab
			if owner == self or (owner and owner._rootTab == self) then
				window.Flags[flag] = nil
				if Nucleus.Flags[flag] == element then
					Nucleus.Flags[flag] = nil
				end
			end
		end
		if window.CurrentTab == self then
			window.CurrentTab = nil
			if window.Indicator then
				window.Indicator.Parent = window.TabList
				window.Indicator.Visible = false
			end
			for _, other in ipairs(window.Tabs) do
				if not other._userHidden then
					window:SelectTab(other)
					break
				end
			end
		end
		if self._button then
			self._button:Destroy()
		end
		if self._page then
			self._page:Destroy()
		end
	end

	function Window:GetTab(name)
		for _, tab in ipairs(self.Tabs) do
			if tab.Name == name then
				return tab
			end
		end
		local lowered = string.lower(tostring(name or ""))
		for _, tab in ipairs(self.Tabs) do
			if string.lower(tab.Name) == lowered then
				return tab
			end
		end
		return nil
	end

	function Window:GetCurrentTab()
		return self.CurrentTab
	end

	function Window:OnTabChanged(listener)
		if type(listener) ~= "function" then
			return { Disconnect = function() end }
		end
		self._tabListeners = self._tabListeners or {}
		table.insert(self._tabListeners, listener)
		return {
			Disconnect = function()
				local index = table.find(self._tabListeners, listener)
				if index then
					table.remove(self._tabListeners, index)
				end
			end,
		}
	end

	function Tab:Build()
		local builder = self._lazyBuild
		if builder then
			self._lazyBuild = nil
			runProtected(('building tab "%s"'):format(tostring(self.Name)), builder, self)
		end
		return self
	end

	function Tab:IsBuilt()
		return self._lazyBuild == nil
	end

	function Window:BuildAllTabs()
		for _, tab in ipairs(table.clone(self.Tabs)) do
			tab:Build()
		end
	end

	local baseRunSearch = Window._runSearch
	function Window:_runSearch(text, ...)
		if type(text) == "string" and text:gsub("%s", "") ~= "" then
			self:BuildAllTabs()
		end
		return baseRunSearch(self, text, ...)
	end

	function Tab:SetLocked(locked, reason)
		self._locked = locked == true
		self._lockedReason = reason
		local faded = self._locked and 0.55 or 0
		if self._label then
			self._label.TextTransparency = faded
		end
		if self._icon then
			self._icon.ImageTransparency = faded
		end
		if not self._lockIcon and self._locked and self._button then
			self._lockIcon = create("ImageLabel", {
				Name = "LockIcon",
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -10, 0.5, 0),
				Size = UDim2.fromOffset(12, 12),
				BackgroundTransparency = 1,
				ImageColor3 = Theme.Muted,
				ZIndex = 2,
				Parent = self._button,
			})
			setIcon(self._lockIcon, "lock")
		end
		if self._lockIcon then
			self._lockIcon.Visible = self._locked and not self.Window._compact
		end
		return self
	end

	function Tab:Lock(reason)
		return self:SetLocked(true, reason)
	end

	function Tab:Unlock()
		return self:SetLocked(false)
	end

	function Tab:IsLocked()
		return self._locked == true
	end

	local baseSelectTab = Window.SelectTab
	function Window:SelectTab(tab, ...)
		if type(tab) == "string" then
			tab = self:GetTab(tab) or tab
		end
		if type(tab) == "table" and tab._locked then
			if self._introDone then
				self:Notify({
					Title = tostring(tab.Name or "Tab") .. " is locked",
					Content = tostring(tab._lockedReason or "This tab isn't available right now."),
					Type = "Warning",
					Icon = "lock",
					Duration = 4,
				})
			end
			return nil
		end
		if type(tab) == "table" and tab._lazyBuild then
			tab:Build()
		end
		local previous = self.CurrentTab
		local result = baseSelectTab(self, tab, ...)
		local current = self.CurrentTab
		if current ~= previous and current then
			for _, listener in ipairs(table.clone(self._tabListeners or {})) do
				runProtected("OnTabChanged", listener, current, previous)
			end
			if self._rememberKey and self._rememberReady and current.Name then
				Nucleus.Utils.SaveData(self._rememberKey, { Tab = current.Name })
			end
		end
		return result
	end

	function Window:_restoreTab()
		if not self._rememberKey then
			return
		end
		local saved = Nucleus.Utils.LoadData(self._rememberKey, nil)
		local tab = type(saved) == "table" and saved.Tab and self:GetTab(saved.Tab)
		if tab and not tab._userHidden and self.CurrentTab ~= tab then
			self:SelectTab(tab)
		end
		self._rememberReady = true
	end

	function Nucleus:OnFlagChanged(flag, listener)
		if type(flag) ~= "string" or type(listener) ~= "function" then
			log("OnFlagChanged needs a flag name and a function")
			return { Disconnect = function() end }
		end
		Nucleus._flagListeners = Nucleus._flagListeners or {}
		local list = Nucleus._flagListeners[flag] or {}
		Nucleus._flagListeners[flag] = list
		local entry = { Listener = listener, Connections = {} }
		table.insert(list, entry)
		local existing = Nucleus.Flags[flag]
		if existing and existing.OnChanged then
			entry.Connections[existing] = existing:OnChanged(listener)
		end
		return {
			Disconnect = function()
				local index = table.find(list, entry)
				if index then
					table.remove(list, index)
				end
				for _, connection in pairs(entry.Connections) do
					if connection and connection.Disconnect then
						connection.Disconnect()
					end
				end
				entry.Connections = {}
			end,
		}
	end

	function Window:OnFlagChanged(flag, listener)
		return Nucleus:OnFlagChanged(flag, listener)
	end

	local function playerLabel(player, useDisplay)
		if useDisplay and player.DisplayName and player.DisplayName ~= player.Name then
			return player.DisplayName .. " (@" .. player.Name .. ")"
		end
		return player.Name
	end

	function Tab:PlayerDropdown(input)
		local options = normalizeOptions(input, { Title = "Name", Description = "Desc" })
		local includeSelf = options.IncludeSelf == true
		local useDisplay = options.DisplayNames ~= false
		local labelToName = {}
		local function buildList()
			local labels = {}
			labelToName = {}
			local players = Players:GetPlayers()
			table.sort(players, function(a, b)
				return string.lower(a.Name) < string.lower(b.Name)
			end)
			for _, player in ipairs(players) do
				if includeSelf or player ~= LocalPlayer then
					local label = playerLabel(player, useDisplay)
					labelToName[label] = player.Name
					table.insert(labels, label)
				end
			end
			return labels
		end
		local userCallback = options.Callback
		local dropdown
		local function findByName(name)
			for _, player in ipairs(Players:GetPlayers()) do
				if player.Name == name then
					return player
				end
			end
			return nil
		end
		local function toPlayers(value)
			if type(value) == "table" then
				local list = {}
				for _, label in ipairs(value) do
					local player = findByName(labelToName[label] or label)
					if player then
						table.insert(list, player)
					end
				end
				return list
			end
			if value == nil then
				return nil
			end
			return findByName(labelToName[value] or value)
		end
		local dropdownOptions = table.clone(options)
		dropdownOptions.Options = buildList()
		dropdownOptions.Name = options.Name or (options.Multi and "Players" or "Player")
		dropdownOptions.Search = options.Search ~= false
		dropdownOptions.Callback = function(value)
			if userCallback then
				userCallback(toPlayers(value), value)
			end
		end
		dropdown = self:Dropdown(dropdownOptions)
		if not dropdown then
			return nil
		end
		local function refresh()
			if dropdown._destroyed then
				return
			end
			dropdown:Refresh(buildList(), true)
		end
		local window = self.Window
		window:Connect(Players.PlayerAdded, function()
			task.defer(refresh)
		end)
		window:Connect(Players.PlayerRemoving, function()
			task.defer(refresh)
		end)
		function dropdown:GetPlayer()
			return toPlayers(dropdown:Get())
		end
		dropdown.GetPlayers = dropdown.GetPlayer
		function dropdown:RefreshPlayers()
			refresh()
		end
		return dropdown
	end

	local CONSOLE_COLORS = { Info = "Text", Success = "Success", Warning = "Warning", Error = "Error", Muted = "Muted" }

	function Tab:Console(input)
		local options = normalizeOptions(input, { Title = "Name" })
		local maxLines = math.clamp(tonumber(options.MaxLines) or 100, 5, 500)
		local height = math.clamp(tonumber(options.Height) or 160, 80, 600)
		local showTime = options.Timestamps ~= false
		local card = create("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = Theme.Surface2,
			BorderSizePixel = 0,
			LayoutOrder = self:_nextOrder(),
			Parent = self.List,
		})
		card:SetAttribute(Const.ATTR_NO_DRAG, true)
		styleCard(card)
		addPadding(card, 12, 12, 10, 12)
		create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8), Parent = card })
		local header = create("Frame", { Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, LayoutOrder = 1, Parent = card })
		createIcon(header, options.Icon or "terminal", Theme.Muted, UDim2.new(0, 0, 0.5, 0))
		local titleLabel = createLabel({
			Position = UDim2.fromOffset(24, 0),
			Size = UDim2.new(1, -120, 1, 0),
			Text = tostring(options.Name or "Console"),
			TextSize = 13,
			Parent = header,
		})
		local function headerButton(text, offset, onClick)
			local button = create("TextButton", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, offset, 0.5, 0),
				Size = UDim2.fromOffset(46, 20),
				BackgroundColor3 = Theme.Surface,
				BorderSizePixel = 0,
				Text = "",
				AutoButtonColor = false,
				Parent = header,
			})
			button:SetAttribute(Const.ATTR_NO_DRAG, true)
			addCorner(button, UDim.new(0, 6))
			createLabel({
				Size = UDim2.fromScale(1, 1),
				Text = text,
				TextSize = 11,
				TextColor3 = Theme.Muted,
				TextXAlignment = Enum.TextXAlignment.Center,
				Parent = button,
			})
			button.MouseButton1Click:Connect(onClick)
			return button
		end
		local box = create("ScrollingFrame", {
			Size = UDim2.new(1, 0, 0, height),
			BackgroundColor3 = Theme.Surface,
			BorderSizePixel = 0,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = Theme.Muted,
			ScrollBarImageTransparency = 0.55,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			LayoutOrder = 2,
			Parent = card,
		})
		box:SetAttribute(Const.ATTR_NO_DRAG, true)
		addCorner(box, UDim.new(0, 6))
		addStroke(box)
		addPadding(box, 8, 8, 6, 6)
		create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2), Parent = box })
		local emptyLabel = createLabel({
			Size = UDim2.new(1, 0, 0, 16),
			Text = tostring(options.EmptyText or "Nothing logged yet."),
			TextSize = 12,
			FontFace = Fonts.Regular,
			TextColor3 = Theme.Muted,
			LayoutOrder = 0,
			Parent = box,
		})
		local element = { Lines = {} }
		local rows = {}
		local counter = 0
		local function scrollToEnd()
			task.defer(function()
				if box.Parent then
					box.CanvasPosition = Vector2.new(0, math.max(0, box.AbsoluteCanvasSize.Y))
				end
			end)
		end
		function element:Log(text, kind)
			kind = CONSOLE_COLORS[kind] and kind or "Info"
			text = tostring(text)
			counter += 1
			local stamp = showTime and os.date("%H:%M:%S") or nil
			table.insert(element.Lines, { Text = text, Type = kind, Time = stamp })
			emptyLabel.Visible = false
			local row = createLabel({
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				Text = (stamp and (stamp .. "  ") or "") .. text,
				TextSize = 12,
				FontFace = Const.MONO_FONT or Fonts.Regular,
				TextColor3 = Theme[CONSOLE_COLORS[kind]],
				TextWrapped = true,
				TextTruncate = Enum.TextTruncate.None,
				LayoutOrder = counter,
				Parent = box,
			})
			table.insert(rows, row)
			while #rows > maxLines do
				table.remove(rows, 1):Destroy()
				table.remove(element.Lines, 1)
			end
			if options.AutoScroll ~= false then
				scrollToEnd()
			end
			return element
		end
		element.Add = element.Log
		element.Print = element.Log
		function element:Info(text) return element:Log(text, "Info") end
		function element:Success(text) return element:Log(text, "Success") end
		function element:Warn(text) return element:Log(text, "Warning") end
		function element:Error(text) return element:Log(text, "Error") end
		function element:Clear()
			for _, row in ipairs(rows) do
				row:Destroy()
			end
			rows = {}
			element.Lines = {}
			emptyLabel.Visible = true
			return element
		end
		function element:GetText()
			local out = {}
			for _, line in ipairs(element.Lines) do
				table.insert(out, (line.Time and (line.Time .. "  ") or "") .. line.Text)
			end
			return table.concat(out, "\n")
		end
		function element:SetTitle(text)
			titleLabel.Text = tostring(text)
		end
		headerButton("Clear", 0, function()
			element:Clear()
		end)
		headerButton("Copy", -52, function()
			Nucleus:Copy(element:GetText())
		end)
		return registerElement(self, { Name = options.Name or "Console" }, element, card, "Console")
	end

	local STATUS_KEYS = { Success = "Success", Warning = "Warning", Error = "Error", Info = "Accent", Idle = "Muted" }

	function Tab:Status(input)
		local options = normalizeOptions(input, { Title = "Name", Description = "Desc" })
		local height = options.Desc and Const.ROW_HEIGHT_DESC or Const.ROW_HEIGHT
		local card = createCard(self, "Frame", height)
		local titleLabel = createTitleBlock(card, options.Name or "Status", options.Desc, 150)
		local pill = create("Frame", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -14, 0.5, 0),
			Size = UDim2.fromOffset(0, 22),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = Theme.Surface,
			BorderSizePixel = 0,
			Parent = card,
		})
		addCorner(pill, UDim.new(1, 0))
		addPadding(pill, 9, 10)
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 6),
			Parent = pill,
		})
		local dot = create("Frame", { Size = UDim2.fromOffset(7, 7), BorderSizePixel = 0, LayoutOrder = 1, Parent = pill })
		addCorner(dot, UDim.new(1, 0))
		local statusLabel = createLabel({
			Size = UDim2.fromOffset(0, 22),
			AutomaticSize = Enum.AutomaticSize.X,
			Text = "",
			TextSize = 12,
			TextTruncate = Enum.TextTruncate.None,
			LayoutOrder = 2,
			Parent = pill,
		})
		local element = {}
		function element:SetStatus(text, kind)
			kind = STATUS_KEYS[kind] and kind or (element.Type or "Idle")
			element.Status = tostring(text)
			element.Type = kind
			statusLabel.Text = element.Status
			dot.BackgroundColor3 = Theme[STATUS_KEYS[kind]]
			statusLabel.TextColor3 = kind == "Idle" and Theme.Muted or Theme.Text
			return element
		end
		function element:Get()
			return element.Status, element.Type
		end
		function element:SetTitle(text)
			titleLabel.Text = tostring(text)
		end
		element:SetStatus(options.Status or options.Text or "Idle", options.Type or "Idle")
		return registerElement(self, options, element, card, "Status")
	end

	function Utils.FindPlayer(query)
		return Utils.GetPlayer(query)
	end

	function Utils.GetPlayerNames(includeSelf)
		local names = {}
		for _, player in ipairs(Players:GetPlayers()) do
			if includeSelf or player ~= LocalPlayer then
				table.insert(names, player.Name)
			end
		end
		table.sort(names, function(a, b)
			return string.lower(a) < string.lower(b)
		end)
		return names
	end

	function Utils.Distance(a, b)
		local function position(value)
			if typeof(value) == "Vector3" then
				return value
			elseif typeof(value) == "CFrame" then
				return value.Position
			elseif typeof(value) == "Instance" then
				if value:IsA("Player") then
					local root = Utils.GetRoot(value)
					return root and root.Position
				elseif value:IsA("Model") then
					local primary = value.PrimaryPart or value:FindFirstChild("HumanoidRootPart")
					return primary and primary.Position
				elseif value:IsA("BasePart") then
					return value.Position
				end
			end
			return nil
		end
		local first, second = position(a), position(b or LocalPlayer)
		if not first or not second then
			return math.huge
		end
		return (first - second).Magnitude
	end

	function Utils.ServerInfo()
		local ok, ping = pcall(function()
			return math.floor(LocalPlayer:GetNetworkPing() * 1000)
		end)
		local uptimeOk, uptime = pcall(function()
			return math.floor(workspace.DistributedGameTime)
		end)
		return {
			PlaceId = game.PlaceId,
			JobId = game.JobId,
			Players = #Players:GetPlayers(),
			MaxPlayers = Players.MaxPlayers,
			Ping = ok and ping or 0,
			Uptime = uptimeOk and uptime or 0,
		}
	end

	function Utils.CopyJobId()
		return Nucleus:Copy(game.JobId)
	end

	function Utils.JoinServer(jobId, placeId)
		if type(jobId) ~= "string" or jobId == "" then
			log("JoinServer needs a JobId")
			return false
		end
		local ok, err = pcall(function()
			game:GetService("TeleportService"):TeleportToPlaceInstance(tonumber(placeId) or game.PlaceId, jobId, LocalPlayer)
		end)
		if not ok then
			log("JoinServer failed: " .. tostring(err))
		end
		return ok
	end

	function Utils.HttpGet(url)
		local ok, result = pcall(function()
			return game:HttpGet(url)
		end)
		if ok then
			return true, result
		end
		return false, tostring(result)
	end

	function Utils.JSONEncode(value)
		local ok, result = pcall(HttpService.JSONEncode, HttpService, value)
		return ok and result or nil
	end

	function Utils.JSONDecode(text)
		local ok, result = pcall(HttpService.JSONDecode, HttpService, text)
		return ok and result or nil
	end

	local ELEMENT_TYPES = {
		Toggle = true, Button = true, Slider = true, Dropdown = true, Input = true, Keybind = true,
		ColorPicker = true, Label = true, Paragraph = true, Section = true, Divider = true, Space = true,
		Stepper = true, Progress = true, Select = true, TextArea = true, Code = true, Stat = true, Image = true,
		ButtonRow = true, Status = true, Console = true, PlayerDropdown = true, SocialLink = true,
		DonateButton = true, Socials = true, Donations = true, Group = true,
	}

	function Tab:AddElements(list)
		local created = {}
		if type(list) ~= "table" then
			log("AddElements needs a list, like { { Type = \"Toggle\", Name = \"Fly\" } }")
			return created
		end
		for index, entry in ipairs(list) do
			local kind = type(entry) == "table" and (entry.Type or entry.Element)
			if not (kind and ELEMENT_TYPES[kind]) then
				log(("AddElements item %d has no valid Type (got %s)"):format(index, tostring(kind)))
			else
				local options = table.clone(entry)
				options.Type = nil
				options.Element = nil
				local children = options.Elements
				options.Elements = nil
				local element
				if kind == "Section" or kind == "Divider" or kind == "Space" then
					element = self[kind](self, options.Name or options.Title or options.Text or options.Size)
				else
					element = self[kind](self, options)
				end
				if kind == "Group" and element and type(children) == "table" then
					element:AddElements(children)
				end
				created[index] = element
				if type(options.Flag) == "string" then
					created[options.Flag] = element
				end
			end
		end
		return created
	end

	function Window:BindKey(key, callback, options)
		options = type(options) == "table" and options or {}
		local function resolve(value)
			if typeof(value) == "EnumItem" then
				return value
			end
			local ok, keyCode = pcall(function()
				return Enum.KeyCode[tostring(value)]
			end)
			return ok and keyCode or nil
		end
		local keyCode = resolve(key)
		if not keyCode or type(callback) ~= "function" then
			log("BindKey needs a key like \"F\" or Enum.KeyCode.F and a function")
			return { Disconnect = function() end, SetKey = function() end }
		end
		local handle = { Key = keyCode, Enabled = true }
		local connection = self:Connect(UserInputService.InputBegan, function(inputObject, gameProcessed)
			if not handle.Enabled or inputObject.KeyCode ~= handle.Key then
				return
			end
			if gameProcessed and not options.IgnoreGameProcessed then
				return
			end
			if UserInputService:GetFocusedTextBox() then
				return
			end
			runProtected(("key %s"):format(handle.Key.Name), callback, handle.Key)
		end)
		local releaseConnection
		if type(options.OnRelease) == "function" then
			releaseConnection = self:Connect(UserInputService.InputEnded, function(inputObject)
				if handle.Enabled and inputObject.KeyCode == handle.Key then
					runProtected(("key %s release"):format(handle.Key.Name), options.OnRelease, handle.Key)
				end
			end)
		end
		function handle:SetKey(newKey)
			local resolved = resolve(newKey)
			if resolved then
				handle.Key = resolved
			end
			return resolved ~= nil
		end
		function handle:SetEnabled(enabled)
			handle.Enabled = enabled ~= false
		end
		function handle:Disconnect()
			handle.Enabled = false
			if connection and connection.Disconnect then
				connection:Disconnect()
			end
			if releaseConnection and releaseConnection.Disconnect then
				releaseConnection:Disconnect()
			end
		end
		return handle
	end

	local function matchesGame(ids)
		if type(ids) ~= "table" then
			ids = { ids }
		end
		for _, id in ipairs(ids) do
			local number = tonumber(id)
			if number and (number == game.PlaceId or number == game.GameId) then
				return true
			end
		end
		return false
	end

	function Utils.IsGame(ids)
		return matchesGame(ids)
	end

	function Nucleus:ForGame(map, fallback)
		if type(map) ~= "table" then
			log("ForGame needs a table like { [PlaceId] = function() end }")
			return nil
		end
		for id, handler in pairs(map) do
			if matchesGame(id) and type(handler) == "function" then
				return handler(game.PlaceId)
			end
		end
		if type(fallback) == "function" then
			return fallback(game.PlaceId)
		end
		return nil
	end

	local function versionParts(text)
		local parts = {}
		for number in string.gmatch(tostring(text or ""), "%d+") do
			table.insert(parts, tonumber(number))
		end
		return parts
	end

	function Utils.CompareVersions(a, b)
		local left, right = versionParts(a), versionParts(b)
		for index = 1, math.max(#left, #right) do
			local x, y = left[index] or 0, right[index] or 0
			if x ~= y then
				return x < y and -1 or 1
			end
		end
		return 0
	end

	function Nucleus:CheckVersion(input)
		local options = type(input) == "table" and input or {}
		if type(options.Url) ~= "string" or options.Current == nil then
			log("CheckVersion needs { Url = \"...\", Current = \"1.0.0\" }")
			return false
		end
		local done = options.OnResult
		task.spawn(function()
			local ok, body = Utils.HttpGet(options.Url)
			if not ok then
				safeCall(done, false, nil)
				return
			end
			local latest = tostring(body):match("[%d%.]+") or tostring(body)
			local outdated = Utils.CompareVersions(options.Current, latest) < 0
			if outdated and options.Notify ~= false then
				Nucleus:Notify({
					Title = tostring(options.Title or "Update available"),
					Content = tostring(options.Message or ("Version " .. latest .. " is out. You have " .. tostring(options.Current) .. ".")),
					Type = "Info",
					Duration = 8,
				})
			end
			safeCall(done, outdated, latest)
		end)
		return true
	end

	local function globalFunction(name)
		local envOk, env = pcall(function()
			return getgenv()
		end)
		local sources = { _G }
		if envOk and type(env) == "table" then
			table.insert(sources, 1, env)
		end
		for _, source in ipairs(sources) do
			local current = source
			for part in tostring(name):gmatch("[^%.]+") do
				current = type(current) == "table" and current[part] or nil
			end
			if type(current) == "function" then
				return true
			end
		end
		return false
	end

	function Utils.Supports(...)
		local missing = {}
		for _, name in ipairs({ ... }) do
			if not globalFunction(name) then
				table.insert(missing, tostring(name))
			end
		end
		return #missing == 0, missing
	end

	function Nucleus:RequireFunctions(names, message)
		if type(names) ~= "table" then
			names = { names }
		end
		local ok, missing = Utils.Supports(table.unpack(names))
		if not ok then
			Nucleus:Notify({
				Title = "Executor not supported",
				Content = tostring(message or ("Missing: " .. table.concat(missing, ", "))),
				Type = "Warning",
				Duration = 8,
			})
		end
		return ok, missing
	end

	function Utils.Throttle(fn, seconds)
		seconds = tonumber(seconds) or 0.2
		local last = -math.huge
		return function(...)
			local now = os.clock()
			if now - last >= seconds then
				last = now
				return fn(...)
			end
			return nil
		end
	end

	function Utils.WaitForPath(root, path, timeout)
		if type(root) == "string" and path == nil then
			root, path = game, root
		elseif type(root) == "string" then
			timeout, path, root = path, root, game
		end
		timeout = tonumber(timeout) or 5
		local current = root
		local deadline = os.clock() + timeout
		for part in string.gmatch(tostring(path), "[^%.]+") do
			if current == game then
				local ok, service = pcall(game.GetService, game, part)
				if ok and service then
					current = service
					continue
				end
			end
			local child = current:FindFirstChild(part)
			while not child and os.clock() < deadline do
				task.wait(0.1)
				child = current:FindFirstChild(part)
			end
			if not child then
				return nil
			end
			current = child
		end
		return current
	end

	Tab.CreateElements = Tab.AddElements
	Window.Section = Window.TabSection
	Window.CreateSection = Window.TabSection
	Tab.Colorpicker = Tab.ColorPicker
	Tab.CreateColorpicker = Tab.ColorPicker
	Tab.CreatePlayerDropdown = Tab.PlayerDropdown
	Tab.CreateConsole = Tab.Console
	Tab.CreateStatus = Tab.Status
	Tab.Log = Tab.Console

	do
		Const.WINDOW_PARTS = {
			"Logo", "Title", "Subtitle", "Search", "Profile", "KeyHint",
			"SidebarButton", "MinimizeButton", "CloseButton",
		}
		local partLookup = {}
		for _, name in ipairs(Const.WINDOW_PARTS) do
			partLookup[string.lower(name)] = name
		end

		function Window:_layoutHeader()
			local cursor = -14
			for _, button in ipairs({ self._closeButton, self._minimizeButton }) do
				if button and button.Visible then
					button.Position = UDim2.new(1, cursor, 0, 13)
					cursor -= 38
				end
			end
			if self._headerItems then
				self._headerItems.Position = UDim2.new(1, cursor - 4, 0, 18)
			end
		end

		function Window:_enforceParts()
			local hidden = self._hiddenParts or {}
			local compact = self._compact == true
			self._logo.Visible = not hidden.Logo
			if hidden.Title then
				self._titleLabel.Visible = false
			end
			if hidden.Subtitle then
				self._subtitleLabel.Visible = false
			end
			if self._searchFrame then
				self._searchFrame.Visible = not hidden.Search and not compact
			end
			self._profile.Visible = not hidden.Profile
			if hidden.KeyHint then
				self._keyChip.Visible = false
				self._hintLabel.Visible = false
			end
			if self._sidebarButton then
				self._sidebarButton.Visible = not hidden.SidebarButton
			end
			if not compact then
				self._titleLabel.Visible = not hidden.Title
				self._subtitleLabel.Visible = not hidden.Subtitle
			end
		end

		function Window:_applyParts()
			local hidden = self._hiddenParts or {}
			local textX = hidden.Logo and 14 or 54
			local single = hidden.Subtitle or self._subtitleLabel.Text == ""
			self._titleLabel.Position = UDim2.fromOffset(textX, single and 23 or 16)
			self._titleLabel.Size = UDim2.new(1, -(textX + 4), 0, 20)
			self._subtitleLabel.Position = UDim2.fromOffset(textX, hidden.Title and 26 or 36)
			self._subtitleLabel.Size = UDim2.new(1, -(textX + 4), 0, 14)

			self._listTopBase = self._listTopBase or self._listTop
			self._listTop = (self._searchFrame and not hidden.Search) and self._listTopBase or 72
			self._listBottom = hidden.Profile and 8 or 66
			if hidden.Search and self._searchBox and self._searchBox.Text ~= "" then
				self._searchBox.Text = ""
			end
			local top = self._compact and 66 or self._listTop
			for _, list in ipairs({ self.TabList, self._searchResults }) do
				if list then
					list.Position = UDim2.fromOffset(0, top)
					list.Size = UDim2.new(1, 0, 1, -(top + self._listBottom))
				end
			end

			self._profileName.Position = UDim2.fromOffset(48, hidden.KeyHint and 16 or 7)
			if not hidden.KeyHint and not self._compact then
				self._keyChip.Visible = not IS_TOUCH
				self._hintLabel.Visible = true
			end

			if self._closeButton then
				self._closeButton.Visible = not hidden.CloseButton
			end
			if self._minimizeButton then
				self._minimizeButton.Visible = not hidden.MinimizeButton
			end
			self:_layoutHeader()

			for _, tab in ipairs(self.Tabs) do
				self:_placePageTitle(tab)
			end
			self:_enforceParts()
		end

		function Window:_placePageTitle(tab)
			local hidden = self._hiddenParts or {}
			local x = hidden.SidebarButton and Const.PAGE_PAD or (Const.PAGE_PAD + 36)
			if tab._pageTitle then
				tab._pageTitle.Position = UDim2.fromOffset(x, 18)
				tab._pageTitle.Size = UDim2.new(1, -(x + 48), 0, 24)
			end
			if tab._pageDesc then
				tab._pageDesc.Position = UDim2.fromOffset(x, 40)
				tab._pageDesc.Size = UDim2.new(1, -(x + 48), 0, 16)
			end
		end

		function Window:SetPartVisible(name, visible)
			local part = partLookup[string.lower(tostring(name))]
			if not part then
				log(("unknown window part '%s'. Parts: %s"):format(tostring(name), table.concat(Const.WINDOW_PARTS, ", ")))
				return false
			end
			self._hiddenParts = self._hiddenParts or {}
			self._hiddenParts[part] = visible == false or nil
			self:_applyParts()
			return true
		end

		function Window:HidePart(name)
			return self:SetPartVisible(name, false)
		end

		function Window:ShowPart(name)
			return self:SetPartVisible(name, true)
		end

		function Window:IsPartVisible(name)
			local part = partLookup[string.lower(tostring(name))]
			return part ~= nil and not (self._hiddenParts and self._hiddenParts[part])
		end

		function Window:GetParts()
			return table.clone(Const.WINDOW_PARTS)
		end

		local baseSetSubtitle = Window.SetSubtitle
		function Window:SetSubtitle(text)
			baseSetSubtitle(self, text)
			self:_applyParts()
		end

		local baseTab = Window.Tab
		local function tabWithParts(self, ...)
			local tab = baseTab(self, ...)
			if type(tab) == "table" and self._hiddenParts and self._hiddenParts.SidebarButton then
				self:_placePageTitle(tab)
			end
			return tab
		end
		for key, value in pairs(table.clone(Window)) do
			if value == baseTab then
				Window[key] = tabWithParts
			end
		end

		local function readHideList(list)
			local result = {}
			if type(list) == "string" then
				list = { list }
			end
			if type(list) ~= "table" then
				return result
			end
			for key, value in pairs(list) do
				local name = type(key) == "number" and value or (value == true and key or nil)
				local part = name and partLookup[string.lower(tostring(name))]
				if part then
					result[part] = true
				elseif name then
					log(("unknown window part '%s' in Hide. Parts: %s"):format(tostring(name), table.concat(Const.WINDOW_PARTS, ", ")))
				end
			end
			return result
		end

		local function keyFile(ks, windowOptions)
			local folder = tostring(ks.Folder or "NucleusUI/Keys")
			local name = tostring(ks.FileName or (windowOptions and windowOptions.Title) or "key")
			name = name:gsub("[^%w%-_]", "")
			if name == "" then
				name = "key"
			end
			return folder, folder .. "/" .. name .. ".txt"
		end

		local function readSavedKey(path)
			local ok, value = pcall(function()
				if type(isfile) == "function" and isfile(path) then
					return readfile(path)
				end
			end)
			if ok and type(value) == "string" and value ~= "" then
				return (value:gsub("^%s+", ""):gsub("%s+$", ""))
			end
			return nil
		end

		local function writeSavedKey(folder, path, key)
			pcall(function()
				if type(writefile) ~= "function" then
					return
				end
				if type(makefolder) == "function" and type(isfolder) == "function" then
					local current = ""
					for piece in folder:gmatch("[^/]+") do
						current = current == "" and piece or (current .. "/" .. piece)
						if not isfolder(current) then
							makefolder(current)
						end
					end
				end
				writefile(path, key)
			end)
		end

		local function checkKey(ks, key)
			local checker = ks.Check or ks.Validate or ks.Verify
			if type(checker) == "function" then
				local ok, result, message = pcall(checker, key)
				if not ok then
					return false, "Could not check the key. Try again."
				end
				if type(result) == "table" then
					return result.Valid == true or result.Success == true, result.Message
				end
				return result == true, message
			end
			local keys = ks.Key or ks.Keys
			if type(keys) == "string" then
				keys = { keys }
			end
			for _, valid in ipairs(type(keys) == "table" and keys or {}) do
				if key == tostring(valid) then
					return true
				end
			end
			return false
		end

		function Nucleus:KeySystem(ks, windowOptions)
			ks = type(ks) == "table" and ks or {}
			windowOptions = windowOptions or {}
			if windowOptions.Theme ~= nil then
				pcall(Nucleus.SetTheme, Nucleus, windowOptions.Theme)
			end
			local folder, path = keyFile(ks, windowOptions)
			Nucleus._keyFile = path
			Nucleus._savedKeyUsed = false
			if ks.SaveKey ~= false then
				local saved = readSavedKey(path)
				if saved and checkKey(ks, saved) then
					Nucleus.Key = saved
					Nucleus._savedKeyUsed = true
					safeCall(ks.OnSuccess, saved)
					return saved
				end
			end

