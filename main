local function resolveIcon(u)
	if type(u) == "string" and t[string.lower(u)] then
		local v = t[string.lower(u)]
		return v[1], v[2], v[3]
	end
	if typeof(u) == "table" then
		return u.Image, u.RectOffset, u.RectSize
	end
	if type(u) == "number" then
		return "rbxassetid://" .. tostring(u)
	end
	if type(u) ~= "string" or u == "" then
		return nil
	end
	if u:find("^rbx%a*://") or u:find("^http") then
		return u
	end

	local v = u:gsub("^lucide:", "")
	local w = getIconPack()
	if not w then
		return nil
	end

	local x = (w.Icons and w.Icons[v]) or w[v]
	if type(x) == "table" then
		local y = x.Image
		if type(y) == "number" then
			y = "rbxassetid://" .. tostring(y)
		end
		local z = w.Spritesheets and w.Spritesheets[tostring(y)] or y
		return z, x.ImageRectPosition, x.ImageRectSize
	elseif type(x) == "string" then
		return x
	end

	log("unknown lucide icon: " .. v)
	return nil
end

