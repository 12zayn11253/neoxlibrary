	local ak = { "TopRight", "BottomRight", "TopLeft", "BottomLeft", "Top", "Bottom" }

	function aa:GetNotificationHistory()
		local al = {}
		for am, an in ipairs(self._notifyHistory or {}) do
			al[am] = table.clone(an)
		end
		return al
	end

	function aa:ClearNotificationHistory()
		self._notifyHistory = {}
	end

	function aa:ShowNotificationHistory(al)
		al = math.clamp(tonumber(al) or 8, 1, 50)
		local am = {}
		for an, ao in ipairs(self._notifyHistory or {}) do
			if an > al then
				break
			end
			local ap = os.date("%H:%M", ao.Time) .. "  " .. ao.Title
			if ao.Content ~= "" then
				ap ..= ": " .. ao.Content
			end
			table.insert(am, ap)
		end
		return self:Dialog({
			Title = "Recent notifications",
			Content = #am > 0 and table.concat(am, "\n") or "No notifications yet.",
			Buttons = {
				{ Title = "Clear", Callback = function()
					self:ClearNotificationHistory()
				end },
				{ Title = "Close", Variant = "Primary" },
			},
		})
	end

	function K:Settings(al)
		local am = normalizeOptions(al, {})
		local an = tostring(am.FlagPrefix or "Nucleus")
		local ao = self
		local ap = self.Window
		local aq = type(am.Titles) == "table" and am.Titles or {}
		local function section(ar, as)
			if aq[ar] ~= false then
				ao:Section(tostring(aq[ar] or as))
			end
		end

		if am.Interface ~= false then
			section("Interface", "Interface")
			if am.Theme ~= false then
				ao:ThemePicker({ Flag = an .. "Theme" })
			end
			if am.Accent ~= false then
				ao:AccentPicker({ Flag = an .. "Accent" })
			end
			if am.Scale ~= false then
				ao:Slider({
					Name = "Interface size",
					Min = 50,
					Max = 150,
					Step = 5,
					Suffix = "%",
					Default = math.floor(ap:GetScale() * 100 + 0.5),
					Flag = an .. "Scale",
					OnRelease = true,
					Callback = function(ar)
						ap:SetScale(ar / 100)
					end,
				})
			end
			if am.Keybind ~= false and not x then
				ao:Keybind({
					Name = "Show / hide key",
					Default = ap.Keybind and ap.Keybind.Name or "RightControl",
					Flag = an .. "ToggleKey",
					OnChanged = function(ar)
						if ar then
							ap:SetKeybind(ar)
						end
					end,
				})
			end
			if am.Notifications ~= false then
				ao:Dropdown({
					Name = "Notification position",
					Options = ak,
					Default = ap._notifyHost and ap._notifyHost.Position or ak[1],
					Flag = an .. "NotifyPosition",
					Callback = function(ar)
						if type(ar) == "string" then
							ap:SetNotificationPosition(ar)
						end
					end,
				})
			end
			if am.Sidebar ~= false then
				ao:Toggle({
					Name = "Compact sidebar",
					Default = ap:IsSidebarCollapsed(),
					Flag = an .. "CompactSidebar",
					Callback = function(ar)
						ap:SetSidebarCollapsed(ar)
					end,
				})
			end
			if am.Anonymous ~= false then
				ao:Toggle({
					Name = "Hide my name and avatar",
					Default = false,
					Flag = an .. "Anonymous",
					Callback = function(ar)
						ap:SetAnonymous(ar)
					end,
				})
			end
			if am.History ~= false then
				ao:Button({
					Name = "Recent notifications",
					Callback = function()
						ap:ShowNotificationHistory()
					end,
				})
			end
		end

		if am.Configs ~= false then
			ao:ConfigManager({ Name = aq.Configs or "Configs" })
		end

		if am.Server ~= false then
			section("Server", "Server")
			ao:ButtonRow({
				{ Name = "Rejoin", Icon = "refresh-cw", Callback = function()
					h.Utils.Rejoin()
				end },
				{ Name = "Server hop", Icon = "shuffle", Callback = function()
					h.Utils.ServerHop()
				end },
			})
		end

		if am.Unload ~= false then
			section("Script", "Script")
			ao:Button({
				Name = "Unload " .. tostring(ap._titleLabel and ap._titleLabel.Text or i.LIB_NAME),
				Style = "Danger",
				Confirm = "Click again to unload",
				Callback = function()
					ap:Destroy()
				end,
			})
		end

		return ao
	end

