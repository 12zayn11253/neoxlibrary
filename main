local l = {}

local function editDistance(m: string, n: string): number
	local o, p = string.len(m), string.len(n)
	if math.abs(o - p) > 2 then
		return 3
	end
	local q = {}
	for r = 1, p + 1 do
		q[r] = r - 1
	end
	for r = 1, o do
		local s = { r }
		local t = r
		for u = 1, p do
			local v = string.sub(m, r, r) == string.sub(n, u, u) and 0 or 1
			local w = math.min(q[u + 1] + 1, s[u] + 1, q[u] + v)
			s[u + 1] = w
			t = math.min(t, w)
		end
		if t > 2 then
			return 3
		end
		q = s
	end
	return q[p + 1]
end

local function suggestOption(m)
	local n = string.lower(m)
	local o, p = nil, #m <= 5 and 1 or 2
	for q in pairs(j) do
		local r = editDistance(n, string.lower(q))
		if r <= p then
			if r < p or not o then
				o, p = q, r
			end
		end
	end
	return o
end

local function checkOptionKeys(m)
	for n, o in pairs(m) do
		if type(n) == "string" and not j[n] and #n >= 3 then
			local p = k[string.lower(n)]
			if p then
				if m[p] == nil then
					m[p] = o
				end
				if not l[n] then
					l[n] = true
					log(("option '%s' should be written '%s' (capital letters matter). Nucleus UI used it as '%s' for you."):format(n, p, p))
				end
			elseif not l[n] then
				local q = suggestOption(n)
				if q then
					l[n] = true
					log(("unknown option '%s'. Did you mean '%s'?"):format(n, q))
				end
			end
		end
	end
end

local function normalizeOptions(m, n)
	local o = {}
	if type(m) == "string" then
		o.Name = m
	elseif type(m) == "table" then
		for p, q in pairs(m) do
			o[p] = q
		end
		checkOptionKeys(o)
	end
	local p = o.Value
	if type(p) == "table" and (p.Min ~= nil or p.Max ~= nil or p.Default ~= nil) and p[1] == nil then
		o.Min = o.Min or p.Min
		o.Max = o.Max or p.Max
		if o.Default == nil then
			o.Default = p.Default
		end
		o.Value = p.Default
	end
	if o.Options == nil and type(o.Values) == "table" then
		o.Options = o.Values
	end
	for q, r in pairs(n or {}) do
		if o[r] == nil and o[q] ~= nil then
			o[r] = o[q]
		end
	end
	if type(o.Range) == "table" then
		o.Min = o.Min or o.Range[1]
		o.Max = o.Max or o.Range[2]
	end
	return o
end

local m = debug.info(1, "s")

h.Errors = {}
h.ErrorNotifications = true
h._errorListeners = {}
local n = {}

local function captureError(o)
	local p, q
	for r = 2, 40 do
		local s, t = debug.info(r, "sl")
		if s == nil then
			break
		end
		if s ~= m and s ~= "[C]" and t and t > 0 then
			p, q = s, t
			break
		end
	end
	local r = ""
	pcall(function()
		local s = string.split(debug.traceback() or "", "\n")
		local t = 1
		for u, v in ipairs(s) do
			if v:find("captureError", 1, true) then
				t = u + 1
				break
			end
		end
		r = table.concat(s, "\n", t)
	end)
	return { Error = o, Traceback = r, Source = p, Line = q }
end

local function describeError(o)
	local p = tostring(o)
	local q, r, s = p:match("^(.-):(%d+): (.*)$")
	if q and #q < 200 and not q:find("\n") then
		return s, tonumber(r), q
	end
	return p, nil, nil
end

local function reportError(o, p)
	if type(p) ~= "table" then
		p = { Error = p, Traceback = "" }
	end
	local q, r, s = describeError(p.Error)
	local t = s ~= nil and s == m
	if t or not r then
		r = p.Line or r
	end
	local u = {
		Where = o,
		Message = q,
		Line = r,
		InsideLibrary = t,
		Raw = tostring(p.Error),
		Traceback = p.Traceback or "",
		Time = os.time(),
	}
	table.insert(h.Errors, u)
	if #h.Errors > 50 then
		table.remove(h.Errors, 1)
	end

	local v = o .. "\0" .. q
	local w = os.clock()
	if n[v] and w - n[v] < 2 then
		return u
	end
	n[v] = w

	u.Summary = q .. (r and (" (line " .. r .. ")") or "")
	warn(("%serror in %s: %s\n%s"):format(i.LOG_PREFIX, o, u.Summary, u.Traceback))
	for x, y in ipairs(table.clone(h._errorListeners)) do
		pcall(y, u)
	end
	if h.ErrorNotifications ~= false and type(h._showErrorToast) == "function" then
		pcall(h._showErrorToast, u)
	end
	return u
end

local function runProtected(o, p, ...)
	if type(p) ~= "function" then
		return false
	end
	local q, r = xpcall(p, captureError, ...)
	if not q then
		reportError(o, r)
	end
	return q, r
end

local function safeCall(o, ...)
	if type(o) ~= "function" then
		return
	end
	runProtected("a callback", o, ...)
end

