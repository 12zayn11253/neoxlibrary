				Position = UDim2.fromOffset(20, 0),
				Size = UDim2.new(1, -20, 0, 16),
				AutomaticSize = Enum.AutomaticSize.Y,
				Text = "",
				TextSize = 12,
				FontFace = Fonts.Regular,
				TextColor3 = Theme.Muted,
				TextWrapped = true,
				TextTruncate = Enum.TextTruncate.None,
				Parent = statusRow,
			})
			local function setStatus(text, color, iconName)
				status.Text = text or ""
				status.TextColor3 = color or Theme.Muted
				statusIcon.ImageColor3 = color or Theme.Muted
				statusIcon.Visible = setIcon(statusIcon, iconName or "info")
				statusRow.Visible = status.Text ~= ""
			end

			local function keyButton(parent, order, text, iconName, primary, height, callback)
				local button = create("TextButton", {
					Size = UDim2.new(1, 0, 0, height),
					BackgroundColor3 = primary and Theme.Accent or Theme.Surface,
					Text = "",
					AutoButtonColor = false,
					LayoutOrder = order,
					Parent = parent,
				})
				addCorner(button, UDim.new(0, 9))
				local stroke = addStroke(button, primary and Theme.Accent or Theme.Stroke)
				create("UIListLayout", {
					FillDirection = Enum.FillDirection.Horizontal,
					HorizontalAlignment = Enum.HorizontalAlignment.Center,
					VerticalAlignment = Enum.VerticalAlignment.Center,
					SortOrder = Enum.SortOrder.LayoutOrder,
					Padding = UDim.new(0, 7),
					Parent = button,
				})
				local label = createLabel({
					Size = UDim2.new(0, 0, 1, 0),
					AutomaticSize = Enum.AutomaticSize.X,
					Text = text,
					TextSize = primary and 14 or 13,
					FontFace = Fonts.Bold,
					TextColor3 = primary and Theme.AccentDark or Theme.Text,
					TextTruncate = Enum.TextTruncate.None,
					LayoutOrder = primary and 1 or 2,
					Parent = button,
				})
				if iconName then
					local image = create("ImageLabel", {
						Size = UDim2.fromOffset(15, 15),
						BackgroundTransparency = 1,
						ImageColor3 = primary and Theme.AccentDark or Theme.Accent,
						ScaleType = Enum.ScaleType.Fit,
						LayoutOrder = primary and 2 or 1,
						Parent = button,
					})
					if not setIcon(image, iconName) then
						image:Destroy()
					end
				end
				button.MouseEnter:Connect(function()
					if IS_TOUCH then
						return
					end
					if primary then
						tween(button, { BackgroundTransparency = 0.12 }, 0.12)
					else
						tween(stroke, { Color = Theme.StrokeHover }, 0.12)
						tween(button, { BackgroundColor3 = Theme.Surface2 }, 0.12)
					end
				end)
				button.MouseLeave:Connect(function()
					if primary then
						tween(button, { BackgroundTransparency = 0 }, 0.2)
					else
						tween(stroke, { Color = Theme.Stroke }, 0.2)
						tween(button, { BackgroundColor3 = Theme.Surface }, 0.2)
					end
				end)
				button.MouseButton1Click:Connect(function()
					safeCall(callback)
				end)
				return button, label
			end

			local checking = false
			local submitLabel
			local submitText = tostring(ks.SubmitText or "Continue")
			local function submit()
				if checking or accepted or closed then
					return
				end
				local key = (box.Text:gsub("^%s+", ""):gsub("%s+$", ""))
				if key == "" then
					setStatus("Type or paste your key first.", Theme.Warning, "circle-alert")
					return
				end
				checking = true
				setStatus("Checking...", Theme.Muted, "loader-circle")
				if submitLabel then
					submitLabel.Text = "Checking..."
				end
				task.spawn(function()
					local valid, message = checkKey(ks, key)
					checking = false
					if submitLabel then
						submitLabel.Text = submitText
					end
					if closed then
						return
					end
					if valid then
						setStatus(message or "Key accepted.", Theme.Success, "circle-check")
						inputStroke.Color = Theme.Success
						if ks.SaveKey ~= false then
							writeSavedKey(folder, path, key)
						end
						task.wait(0.35)
						accepted = key
					else
						setStatus(message or "That key isn't valid. Check it and try again.", Theme.Error, "circle-x")
						inputStroke.Color = Theme.Error
						safeCall(ks.OnFail, key)
					end
				end)
			end

			local _, primaryLabel = keyButton(card, 5, submitText, "arrow-right", true, 42, submit)
			submitLabel = primaryLabel

			local secondary = {}
			if link or type(ks.GetKey) == "function" then
				table.insert(secondary, { tostring(ks.GetKeyText or "Get key"), "link", function()
					if type(ks.GetKey) == "function" then
						ks.GetKey()
						return
					end
					if Nucleus:Copy(tostring(link), true) then
						setStatus("Link copied. Paste it in your browser.", Theme.Muted, "copy")
					else
						setStatus(tostring(link), Theme.Muted, "link")
					end
				end })
			end
			if ks.Discord then
				table.insert(secondary, { "Discord", "discord", function()
					if Nucleus:Copy(tostring(ks.Discord), true) then
						setStatus("Discord invite copied.", Theme.Muted, "copy")
					else
						setStatus(tostring(ks.Discord), Theme.Muted, "link")
					end
				end })
			end
			if #secondary > 0 then
				local row = create("Frame", {
					Size = UDim2.new(1, 0, 0, 38),
					BackgroundTransparency = 1,
					LayoutOrder = 6,
					Parent = card,
				})
				create("UIListLayout", {
					FillDirection = Enum.FillDirection.Horizontal,
					SortOrder = Enum.SortOrder.LayoutOrder,
					Padding = UDim.new(0, 8),
					Parent = row,
				})
				local count = #secondary
				for index, entry in ipairs(secondary) do
					local button = keyButton(row, index, entry[1], entry[2], false, 38, entry[3])
					button.Size = UDim2.new(1 / count, -math.ceil(8 * (count - 1) / count), 0, 38)
				end
			end

			if ks.SaveKey ~= false then
				local footer = create("Frame", {
					Size = UDim2.new(1, 0, 0, 16),
					BackgroundTransparency = 1,
					LayoutOrder = 7,
					Parent = card,
				})
				create("UIListLayout", {
					FillDirection = Enum.FillDirection.Horizontal,
					HorizontalAlignment = Enum.HorizontalAlignment.Center,
					VerticalAlignment = Enum.VerticalAlignment.Center,
					SortOrder = Enum.SortOrder.LayoutOrder,
					Padding = UDim.new(0, 6),
					Parent = footer,
				})
				local lock = create("ImageLabel", {
					Size = UDim2.fromOffset(12, 12),
					BackgroundTransparency = 1,
					ImageColor3 = Theme.Muted,
					ScaleType = Enum.ScaleType.Fit,
					LayoutOrder = 1,
					Parent = footer,
				})
				if not setIcon(lock, "lock") then
					lock:Destroy()
				end
				createLabel({
					Size = UDim2.new(0, 0, 1, 0),
					AutomaticSize = Enum.AutomaticSize.X,
					Text = tostring(ks.FooterText or "Your key is remembered on this device"),
					TextSize = 12,
					FontFace = Fonts.Regular,
					TextColor3 = Theme.Muted,
					TextTruncate = Enum.TextTruncate.None,
					LayoutOrder = 2,
					Parent = footer,
				})
			end

			local focused = false
			box.Focused:Connect(function()
				focused = true
				inputStroke.Color = Theme.StrokeHover
				inputIcon.ImageColor3 = Theme.Text
			end)
			box.FocusLost:Connect(function(enterPressed)
				focused = false
				inputStroke.Color = Theme.Stroke
				inputIcon.ImageColor3 = Theme.Muted
				if enterPressed then
					submit()
				end
			end)
			box:GetPropertyChangedSignal("Text"):Connect(function()
				if statusRow.Visible and not checking then
					statusRow.Visible = false
					inputStroke.Color = focused and Theme.StrokeHover or Theme.Stroke
				end
			end)
			setIcon(statusIcon, "circle-check")
			gui.Parent = windowOptions.Parent or getGuiParent()
			fitCard()
			task.defer(fitCard)

			while not accepted and not closed do
				task.wait(0.05)
			end
			gui:Destroy()
			if closed then
				safeCall(ks.OnClose)
				return nil
			end
			Nucleus.Key = accepted
			safeCall(ks.OnSuccess, accepted)
			return accepted
		end

		function Nucleus:ClearSavedKey(ks, windowOptions)
			local path = Nucleus._keyFile
			if type(ks) == "table" or type(windowOptions) == "table" then
				local _, chosen = keyFile(type(ks) == "table" and ks or {}, type(windowOptions) == "table" and windowOptions or nil)
				path = chosen
			end
			if not path then
				return false
			end
			local ok = pcall(function()
				if type(isfile) == "function" and isfile(path) then
					if type(delfile) == "function" then
						delfile(path)
					else
						writefile(path, "")
					end
				end
			end)
			return ok
		end

		local createWindowBase = Nucleus.Window
		local function windowWithExtras(first, second)
			local options = first == Nucleus and second or first
			if type(options) == "table" and type(options.KeySystem) == "table" and options.KeySystem.Enabled ~= false then
				local key = Nucleus:KeySystem(options.KeySystem, options)
				if not key then
					while true do
						task.wait(3600)
					end
				end
			end
			local window = createWindowBase(first, second)
			if type(window) == "table" and type(options) == "table" then
				window.Key = Nucleus.Key
				local ks = options.KeySystem
				if type(ks) == "table" and ks.Enabled ~= false and Nucleus._savedKeyUsed and ks.SavedNotice ~= false then
					Nucleus._savedKeyUsed = false
					task.delay(0.5, function()
						if not window._destroyed then
							window:Notify({
								Title = "Signed in",
								Content = "Your saved key still works, so the key screen was skipped.",
								Type = "Success",
								Icon = "key-round",
								Duration = 4,
							})
						end
					end)
				end
				local hide = readHideList(options.Hide)
				if next(hide) then
					window._hiddenParts = hide
				end
				window:_applyParts()
			end
			return window
		end
		for key, value in pairs(table.clone(Nucleus)) do
			if value == createWindowBase then
				Nucleus[key] = windowWithExtras
			end
		end
	end

	do
		local function fits(kind, value)
			local valueType = typeof(value)
			for part in string.gmatch(kind, "[^|]+") do
				if part == "list" then
					if valueType == "table" and (value[1] ~= nil or next(value) == nil) then
						return true
					end
				elseif part == valueType then
					return true
				end
			end
			return false
		end

		local function fromShorthand(schema, ...)
			local count = select("#", ...)
			local first = ...
			if count == 0 or (count == 1 and type(first) ~= "function") then
				return nil
			end
			local options, extra = {}, nil
			local slot = 1
			for index = 1, count do
				local value = select(index, ...)
				local valueType = typeof(value)
				if valueType == "function" then
					if options.Callback == nil then
						options.Callback = value
					end
				elseif valueType == "table" and not fits("list", value) then
					extra = extra or {}
					for key, item in pairs(value) do
						if extra[key] == nil then
							extra[key] = item
						end
					end
				elseif value == nil then
					slot += 1
				else
					while schema[slot] and not fits(schema[slot][2], value) do
						slot += 1
					end
					local entry = schema[slot]
					if entry then
						options[entry[1]] = value
						slot += 1
					end
				end
			end
			if extra then
				for key, item in pairs(extra) do
					if options[key] == nil then
						options[key] = item
					end
				end
			end
			return options
		end

		local readingValue = false
		local liveValue = {
			__index = function(element, key)
				if key == "Value" and not readingValue and type(rawget(element, "Get")) == "function" then
					readingValue = true
					local ok, value = pcall(rawget(element, "Get"), element)
					readingValue = false
					if ok then
						return value
					end
				end
				return nil
			end,
		}

		local title, desc = { "Title", "string" }, { "Desc", "string" }
		local range = { title, { "Min", "number" }, { "Max", "number" }, { "Value", "number" } }
		local typing = { title, { "Placeholder", "string" } }
		Const.SHORTHAND = {
			Button = { title, desc },
			Toggle = { title, { "Value", "boolean" } },
			Slider = range,
			Stepper = range,
			Dropdown = { title, { "Values", "list" }, { "Value", "string|number|list" } },
			Input = typing,
			TextArea = typing,
			Keybind = { title, { "Value", "string|EnumItem" } },
			ColorPicker = { title, { "Value", "Color3" } },
			Paragraph = { title, desc },
			Progress = { title, { "Value", "number" } },
			Code = { title, { "Code", "string" } },
			Group = { title, desc },
		}

		for name, schema in pairs(Const.SHORTHAND) do
			local method = Tab[name]
			if type(method) == "function" then
				local function shorthand(self, ...)
					local options = fromShorthand(schema, ...)
					local element
					if options then
						if name == "Dropdown" and type(options.Value) == "table" and options.Multi == nil then
							options.Multi = true
						end
						element = method(self, options)
					else
						element = method(self, ...)
					end
					if type(element) == "table" and getmetatable(element) == nil and rawget(element, "Value") == nil
						and type(rawget(element, "Get")) == "function" then
						setmetatable(element, liveValue)
					end
					return element
				end
				for key, value in pairs(table.clone(Tab)) do
					if value == method then
						Tab[key] = shorthand
					end
				end
			end
		end

		local function notifyShorthand(first, second, third, fourth)
			if type(first) ~= "string" or (second == nil and third == nil and fourth == nil) then
				return first
			end
			local options = { Title = first }
			local values = { second, third, fourth }
			for index = 1, 3 do
				local value = values[index]
				if type(value) == "number" then
					options.Duration = value
				elseif type(value) == "string" and options.Content == nil then
					options.Content = value
				elseif type(value) == "string" then
					options.Type = value
				end
			end
			return options
		end
		local windowNotify = Window.Notify
		Window.Notify = function(self, first, second, third, fourth)
			return windowNotify(self, notifyShorthand(first, second, third, fourth))
		end
		local nucleusNotify = Nucleus.Notify
		Nucleus.Notify = function(self, first, second, third, fourth)
			return nucleusNotify(self, notifyShorthand(first, second, third, fourth))
		end

		local createWindow = Nucleus.Window
		local function windowShorthand(first, second, third)
			if first == Nucleus then
				if type(second) == "string" then
					second = { Title = second, Author = type(third) == "string" and third or nil }
				end
				return createWindow(first, second)
			end
			if type(first) == "string" then
				return createWindow({ Title = first, Author = type(second) == "string" and second or nil })
			end
			return createWindow(first, second)
		end
		for key, value in pairs(table.clone(Nucleus)) do
			if value == createWindow then
				Nucleus[key] = windowShorthand
			end
		end
	end

	local FORGIVING = {
		"Notify", "Confirm", "Dialog", "Prompt", "Popup", "SetTheme", "AddTheme", "GetValue", "SetValue",
		"GetValues", "SetValues", "Copy", "Destroy", "Unload", "Loop", "Connect", "OnUnload", "OnError",
		"GetErrors", "ClearErrors", "SetLanguage", "SetLocalization", "Translate", "GetFlag", "GetThemes",
		"GetLanguage", "SetErrorNotifications", "Try", "ReportError", "PreloadIcons", "LoadFont",
		"SetAccent", "GetAccent", "SetFont", "SetKeySource", "GetKeyStatus", "IsPremium", "OnFlagChanged",
		"ForGame", "CheckVersion", "RequireFunctions",
	}
	for _, name in ipairs(FORGIVING) do
		local method = Nucleus[name]
		if type(method) == "function" then
			Nucleus[name] = function(self, ...)
				if self ~= Nucleus then
					return method(Nucleus, self, ...)
				end
				return method(self, ...)
			end
		end
	end

	local function guardMethods(class, className)
		for name, method in pairs(class) do
			if type(name) == "string" and type(method) == "function" and name:sub(1, 1) ~= "_" then
				class[name] = function(self, ...)
					if type(self) ~= "table" or getmetatable(self) ~= class then
						error(("%s%s.%s(...) was called with a dot. Write %s:%s(...) with a colon instead.")
							:format(Const.LOG_PREFIX, className, name, className, name), 2)
					end
					return method(self, ...)
				end
			end
		end
	end
	guardMethods(Tab, "Tab")
	guardMethods(Window, "Window")
end
end
installFeatures()

return Nucleus
