local Window = {}
Window.__index = Window

local DEFAULT_WINDOW_SIZE = UDim2.fromOffset(680, 500)
local DEFAULT_MIN_SIZE = Vector2.new(520, 360)

function NeoxHub.Window(selfOrOptions, maybeOptions)

	local input = maybeOptions
	if selfOrOptions ~= NeoxHub and maybeOptions == nil then
		input = selfOrOptions
	end

	local options = normalizeOptions(input, {
		Name = "Title",
		LoadingSubtitle = "Subtitle",
		ToggleUIKeybind = "Keybind",
	})

	if options.Theme ~= nil then
		NeoxHub:SetTheme(options.Theme)
	end

	local toggleKey = toKeyCode(options.Keybind) or Enum.KeyCode.RightControl

	local window = setmetatable({
		Tabs = {},
		Flags = {},
		CurrentTab = nil,
		Open = true,
		Keybind = toggleKey,
		_connections = {},
		_controls = {},
		_inputListeners = {
			Began = {},
			Changed = {},
			Ended = {},
			Render = {},
		},
		_frameSteps = {},
		_destroyed = false,
		_searchIndex = {},
		_keybinds = {},
		_overlays = {},
		_userScale = math.clamp(tonumber(options.Scale) or 1, 0.5, 1.5),
	}, Window)

	local function dispatcher(kind)
		return function(...)

			for _, listener in ipairs(table.clone(window._inputListeners[kind])) do
				listener(...)
			end
		end
	end

	local dispatchRender = dispatcher("Render")
	table.insert(window._connections, RunService.RenderStepped:Connect(function(deltaTime)
		dispatchRender(deltaTime)
		for _, frameStep in ipairs(window._frameSteps) do
			frameStep(deltaTime)
		end
	end))
	table.insert(window._connections, UserInputService.InputBegan:Connect(dispatcher("Began")))
	table.insert(window._connections, UserInputService.InputChanged:Connect(dispatcher("Changed")))
	table.insert(window._connections, UserInputService.InputEnded:Connect(dispatcher("Ended")))

	local screenGui = create("ScreenGui", {
		Name = options.GuiName or GUI_NAME,
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		DisplayOrder = 999,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})
	window.Gui = screenGui

	local root = create("Frame", {
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = options.Size or DEFAULT_WINDOW_SIZE,
		BackgroundTransparency = 1,
		Parent = screenGui,
	})
	window.Root = root

	window.Scale = create("UIScale", { Parent = root })

	window.Shadow = create("ImageLabel", {
		Position = UDim2.fromOffset(-25, -25),
		Size = UDim2.new(1, 50, 1, 50),
		BackgroundTransparency = 1,
		Image = Assets.Shadow,
		ImageColor3 = Color3.new(0, 0, 0),
		ImageTransparency = 0.6,
		ScaleType = Enum.ScaleType.Slice,
		SliceCenter = Rect.new(49, 49, 450, 450),
		Parent = root,
	})

	local body = create("CanvasGroup", {
		Name = "Body",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,
		Parent = root,
	})
	window.Body = body
	addCorner(body, UDim.new(0, 8))
	window.BodyStroke = addStroke(body, Theme.Stroke)
	addAccentLine(body)

	local topBar = create("Frame", {
		Name = "TopBar",
		Size = UDim2.new(1, 0, 0, TOPBAR_HEIGHT),
		BackgroundColor3 = Theme.Surface,
		BorderSizePixel = 0,
		Parent = body,
	})
	create("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = Theme.Stroke,
		BorderSizePixel = 0,
		Parent = topBar,
	})

	local logoTile = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 14, 0.5, 0),
		Size = UDim2.fromOffset(32, 32),
		BackgroundColor3 = Theme.Surface2,
		BorderSizePixel = 0,
		Parent = topBar,
	})
	addCorner(logoTile, UDim.new(0, 8))
	addStroke(logoTile)
	local logo = create("ImageLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(18, 18),
		BackgroundTransparency = 1,
		Image = "",
		ImageColor3 = Theme.Accent,
		ScaleType = Enum.ScaleType.Fit,
		Parent = logoTile,
	})
	setIcon(logo, options.Icon or Assets.Logo)
	window._logo = logo

	window._titleLabel = createLabel({
		Position = UDim2.fromOffset(56, 9),
		Size = UDim2.new(1, -340, 0, 19),
		Text = options.Title or LIB_NAME,
		TextSize = 15,
		FontFace = Fonts.Bold,
		Parent = topBar,
	})
	window._subtitleLabel = createLabel({
		Position = UDim2.fromOffset(56, 29),
		Size = UDim2.new(1, -340, 0, 14),
		Text = options.Subtitle or "",
		TextSize = 12,
		FontFace = Fonts.Regular,
		TextColor3 = Theme.Muted,
		Parent = topBar,
	})

	local controls = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(0, 32),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		Parent = topBar,
	})
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6),
		Parent = controls,
	})

	local function createTopButton(icon, glyph, order)
		local button = create("TextButton", {
			Size = UDim2.fromOffset(32, 32),
			BackgroundColor3 = Theme.Surface2,
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = order,
			Parent = controls,
		})
		addCorner(button, UDim.new(0, 8))
		local buttonStroke = addStroke(button, Theme.Stroke, 1)

		local image = create("ImageLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(16, 16),
			BackgroundTransparency = 1,
			ImageColor3 = Theme.Muted,
			ScaleType = Enum.ScaleType.Fit,
			Parent = button,
		})
		local glyphLabel
		if not setIcon(image, icon) then
			image:Destroy()
			image = nil
			glyphLabel = createLabel({
				Size = UDim2.fromScale(1, 1),
				Text = glyph,
				TextSize = 20,
				TextColor3 = Theme.Muted,
				TextXAlignment = Enum.TextXAlignment.Center,
				Parent = button,
			})
		end

		button.MouseEnter:Connect(function()
			tween(button, { BackgroundTransparency = 0 }, 0.15)
			tween(buttonStroke, { Transparency = 0 }, 0.15)
			if image then
				tween(image, { ImageColor3 = Theme.Text }, 0.15)
			else
				tween(glyphLabel, { TextColor3 = Theme.Text }, 0.15)
			end
		end)
		button.MouseLeave:Connect(function()
			tween(button, { BackgroundTransparency = 1 }, 0.2)
			tween(buttonStroke, { Transparency = 1 }, 0.2)
			if image then
				tween(image, { ImageColor3 = Theme.Muted }, 0.2)
			else
				tween(glyphLabel, { TextColor3 = Theme.Muted }, 0.2)
			end
		end)
		return button
	end

	local searchEnabled = options.Search ~= false
	if searchEnabled then
		local searchFrame = create("Frame", {
			Name = "Search",
			Size = UDim2.fromOffset(190, 32),
			BackgroundColor3 = Theme.Background,
			BorderSizePixel = 0,
			LayoutOrder = 1,
			Parent = controls,
		})
		addCorner(searchFrame, UDim.new(0, 8))
		local searchStroke = addStroke(searchFrame)
		createIcon(searchFrame, "search", Theme.Muted, UDim2.new(0, 10, 0.5, 0))

		local searchBox = create("TextBox", {
			Position = UDim2.fromOffset(32, 0),
			Size = UDim2.new(1, -40, 1, 0),
			BackgroundTransparency = 1,
			Text = "",
			PlaceholderText = options.SearchPlaceholder or "Search features",
			PlaceholderColor3 = Theme.Muted,
			TextColor3 = Theme.Text,
			TextSize = 13,
			FontFace = Fonts.Regular,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ClearTextOnFocus = false,
			Parent = searchFrame,
		})
		searchBox.Focused:Connect(function()
			tween(searchStroke, { Color = Theme.Accent }, 0.15)
		end)
		searchBox.FocusLost:Connect(function()
			tween(searchStroke, { Color = Theme.Stroke }, 0.15)
		end)

		local results = create("ScrollingFrame", {
			Name = "SearchResults",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -88, 0, TOPBAR_HEIGHT - 6),
			Size = UDim2.fromOffset(250, 0),
			BackgroundColor3 = Theme.Background,
			BorderSizePixel = 0,
			ScrollBarThickness = 2,
			ScrollBarImageColor3 = Theme.Accent,
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			CanvasSize = UDim2.new(),
			Visible = false,
			ZIndex = 60,
			Parent = body,
		})
		addCorner(results, UDim.new(0, 8))
		addStroke(results)
		addPadding(results, 6, 6, 6, 6)
		create("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 2),
			Parent = results,
		})

		window._searchBox = searchBox
		window._searchResults = results
		searchBox:GetPropertyChangedSignal("Text"):Connect(function()
			window:_runSearch(searchBox.Text)
		end)
	end

	local minimizeButton = createTopButton("minus", "–", 2)
	minimizeButton.MouseButton1Click:Connect(function()
		window:Minimize()
	end)
	local closeButton = createTopButton("x", "×", 3)
	closeButton.MouseButton1Click:Connect(function()
		window:Toggle(false)
	end)

	local tabStrip = create("Frame", {
		Name = "TabStrip",
		Position = UDim2.fromOffset(0, TOPBAR_HEIGHT),
		Size = UDim2.new(1, 0, 0, TABSTRIP_HEIGHT),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Parent = body,
	})
	create("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = Theme.Stroke,
		BorderSizePixel = 0,
		Parent = tabStrip,
	})

	local indicator = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.fromOffset(0, 30),
		BackgroundColor3 = Theme.Surface2,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 1,
		Parent = tabStrip,
	})
	addCorner(indicator, UDim.new(0, 7))
	addStroke(indicator)
	local indicatorLine = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.new(1, -18, 0, 2),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = indicator,
	})
	addCorner(indicatorLine, UDim.new(1, 0))
	window.Indicator = indicator

	local tabList = create("ScrollingFrame", {
		Name = "Tabs",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 0,
		ScrollingDirection = Enum.ScrollingDirection.X,
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		CanvasSize = UDim2.new(),
		ZIndex = 3,
		Parent = tabStrip,
	})
	tabList:SetAttribute(ATTR_NO_DRAG, true)
	addPadding(tabList, 12, 12)
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 4),
		Parent = tabList,
	})
	window.TabList = tabList

	local lastCanvasX = tabList.CanvasPosition.X
	table.insert(window._frameSteps, function()
		local canvasX = tabList.CanvasPosition.X
		if canvasX == lastCanvasX or not window.CurrentTab or not window._introDone then
			return
		end
		lastCanvasX = canvasX
		local x, width = window:_indicatorX(window.CurrentTab)
		local stripWidth = tabStrip.AbsoluteSize.X / window.Scale.Scale
		indicator.Visible = x + width > 0 and x < stripWidth
		indicator.Position = UDim2.new(0, x, 0.5, 0)
		indicator.Size = UDim2.fromOffset(width, 30)
	end)

	local statusBar = create("Frame", {
		Name = "StatusBar",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, STATUSBAR_HEIGHT),
		BackgroundColor3 = Theme.Surface,
		BorderSizePixel = 0,
		Parent = body,
	})
	create("Frame", {
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = Theme.Stroke,
		BorderSizePixel = 0,
		Parent = statusBar,
	})

	local keyChip = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.fromOffset(0, 18),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Theme.Surface2,
		BorderSizePixel = 0,
		Parent = statusBar,
	})
	addCorner(keyChip, UDim.new(0, 4))
	addStroke(keyChip)
	addPadding(keyChip, 6, 6)
	window._keyChipLabel = createLabel({
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = keyDisplayName(toggleKey),
		TextSize = 10,
		FontFace = Fonts.Bold,
		TextColor3 = Theme.Muted,
		TextTruncate = Enum.TextTruncate.None,
		Parent = keyChip,
	})
	local hintLabel = createLabel({
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.new(0.5, 0, 1, 0),
		Text = IS_TOUCH and "or tap the pill to hide" or "to hide",
		TextSize = 11,
		FontFace = Fonts.Regular,
