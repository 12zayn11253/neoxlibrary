	KNOWN_OPTIONS[name] = true
	KNOWN_OPTIONS_LOWER[string.lower(name)] = name
end
local warnedOptions = {}

local function editDistance(a: string, b: string): number
	local lengthA, lengthB = string.len(a), string.len(b)
	if math.abs(lengthA - lengthB) > 2 then
		return 3
	end
	local previous = {}
	for j = 1, lengthB + 1 do
		previous[j] = j - 1
	end
	for i = 1, lengthA do
		local current = { i }
		local rowMin = i
		for j = 1, lengthB do
			local cost = string.sub(a, i, i) == string.sub(b, j, j) and 0 or 1
			local value = math.min(previous[j + 1] + 1, current[j] + 1, previous[j] + cost)
			current[j + 1] = value
			rowMin = math.min(rowMin, value)
		end
		if rowMin > 2 then
			return 3
		end
		previous = current
	end
	return previous[lengthB + 1]
end

local function suggestOption(key)
	local lowerKey = string.lower(key)
	local best, bestDistance = nil, #key <= 5 and 1 or 2
	for name in pairs(KNOWN_OPTIONS) do
		local distance = editDistance(lowerKey, string.lower(name))
		if distance <= bestDistance then
			if distance < bestDistance or not best then
				best, bestDistance = name, distance
			end
		end
	end
	return best
end

local function checkOptionKeys(options)
	for key, value in pairs(options) do
		if type(key) == "string" and not KNOWN_OPTIONS[key] and #key >= 3 then
			local exact = KNOWN_OPTIONS_LOWER[string.lower(key)]
			if exact then
				if options[exact] == nil then
					options[exact] = value
				end
				if not warnedOptions[key] then
					warnedOptions[key] = true
					log(("option '%s' should be written '%s' (capital letters matter). Nucleus UI used it as '%s' for you."):format(key, exact, exact))
				end
			elseif not warnedOptions[key] then
				local suggestion = suggestOption(key)
				if suggestion then
					warnedOptions[key] = true
					log(("unknown option '%s'. Did you mean '%s'?"):format(key, suggestion))
				end
			end
		end
	end
end

local function normalizeOptions(input, aliases)
	local options = {}
	if type(input) == "string" then
		options.Name = input
	elseif type(input) == "table" then
		for key, value in pairs(input) do
			options[key] = value
		end
		checkOptionKeys(options)
	end
	local value = options.Value
	if type(value) == "table" and (value.Min ~= nil or value.Max ~= nil or value.Default ~= nil) and value[1] == nil then
		options.Min = options.Min or value.Min
		options.Max = options.Max or value.Max
		if options.Default == nil then
			options.Default = value.Default
		end
		options.Value = value.Default
	end
	if options.Options == nil and type(options.Values) == "table" then
		options.Options = options.Values
	end
	for alias, canonical in pairs(aliases or {}) do
		if options[canonical] == nil and options[alias] ~= nil then
			options[canonical] = options[alias]
		end
	end
	if type(options.Range) == "table" then
		options.Min = options.Min or options.Range[1]
		options.Max = options.Max or options.Range[2]
	end
	return options
end

local LIBRARY_SOURCE = debug.info(1, "s")

Nucleus.Errors = {}
Nucleus.ErrorNotifications = true
Nucleus._errorListeners = {}
local lastErrorTimes = {}

local function captureError(err)
	local userSource, userLine
	for level = 2, 40 do
		local source, line = debug.info(level, "sl")
		if source == nil then
			break
		end
		if source ~= LIBRARY_SOURCE and source ~= "[C]" and line and line > 0 then
			userSource, userLine = source, line
			break
		end
	end
	local traceback = ""
	pcall(function()
		local lines = string.split(debug.traceback() or "", "\n")
		local start = 1
		for index, line in ipairs(lines) do
			if line:find("captureError", 1, true) then
				start = index + 1
				break
			end
		end
		traceback = table.concat(lines, "\n", start)
	end)
	return { Error = err, Traceback = traceback, Source = userSource, Line = userLine }
end

local function describeError(raw)
	local text = tostring(raw)
	local location, line, rest = text:match("^(.-):(%d+): (.*)$")
	if location and #location < 200 and not location:find("\n") then
		return rest, tonumber(line), location
	end
	return text, nil, nil
end

local function reportError(where, captured)
	if type(captured) ~= "table" then
		captured = { Error = captured, Traceback = "" }
	end
	local message, line, location = describeError(captured.Error)
	local insideLibrary = location ~= nil and location == LIBRARY_SOURCE
	if insideLibrary or not line then
		line = captured.Line or line
	end
	local entry = {
		Where = where,
		Message = message,
		Line = line,
		InsideLibrary = insideLibrary,
		Raw = tostring(captured.Error),
		Traceback = captured.Traceback or "",
		Time = os.time(),
	}
	table.insert(Nucleus.Errors, entry)
	if #Nucleus.Errors > 50 then
		table.remove(Nucleus.Errors, 1)
	end

	local key = where .. "\0" .. message
	local now = os.clock()
	if lastErrorTimes[key] and now - lastErrorTimes[key] < 2 then
		return entry
	end
	lastErrorTimes[key] = now

	entry.Summary = message .. (line and (" (line " .. line .. ")") or "")
	warn(("%serror in %s: %s\n%s"):format(Const.LOG_PREFIX, where, entry.Summary, entry.Traceback))
	for _, listener in ipairs(table.clone(Nucleus._errorListeners)) do
		pcall(listener, entry)
	end
	if Nucleus.ErrorNotifications ~= false and type(Nucleus._showErrorToast) == "function" then
		pcall(Nucleus._showErrorToast, entry)
	end
	return entry
end

local function runProtected(where, callback, ...)
	if type(callback) ~= "function" then
		return false
	end
	local ok, result = xpcall(callback, captureError, ...)
	if not ok then
		reportError(where, result)
	end
	return ok, result
end

local function safeCall(callback, ...)
	if type(callback) ~= "function" then
		return
	end
	runProtected("a callback", callback, ...)
end

