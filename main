Const.DEFAULT_FONT_FAMILY = "rbxasset://fonts/families/GothamSSm.json"

Const.TEXT_WEIGHTS = {
	Regular = Enum.FontWeight.Medium,
	Medium = Enum.FontWeight.Bold,
	Bold = Enum.FontWeight.Bold,
}

Nucleus.Fonts = {
	Regular = Font.new(Const.DEFAULT_FONT_FAMILY, Const.TEXT_WEIGHTS.Regular),
	Medium = Font.new(Const.DEFAULT_FONT_FAMILY, Const.TEXT_WEIGHTS.Medium),
	Bold = Font.new(Const.DEFAULT_FONT_FAMILY, Const.TEXT_WEIGHTS.Bold),
}

local KNOWN_FONTS = {
	ValleySans = {
		Regular = "https://raw.githubusercontent.com/HelsinkiTypeStudio/valley-sans/main/fonts/ttf/ValleySans-Regular.ttf",
		Medium = "https://raw.githubusercontent.com/HelsinkiTypeStudio/valley-sans/main/fonts/ttf/ValleySans-Medium.ttf",
		SemiBold = "https://raw.githubusercontent.com/HelsinkiTypeStudio/valley-sans/main/fonts/ttf/ValleySans-SemiBold.ttf",
	},
}

local FONT_WEIGHTS = {
	Regular = { 400, Enum.FontWeight.Regular },
	Medium = { 500, Enum.FontWeight.Medium },
	SemiBold = { 600, Enum.FontWeight.SemiBold },
	Bold = { 700, Enum.FontWeight.Bold },
}

function Nucleus:SetFont(family)
	local resolved
	if typeof(family) == "EnumItem" then
		local ok, font = pcall(Font.fromEnum, family)
		resolved = ok and font and font.Family or nil
	elseif type(family) == "string" and family ~= "" then
		if family:find("^rbxasset") then
			resolved = family
		else
			resolved = "rbxasset://fonts/families/" .. family:gsub("%s", "") .. ".json"
		end
	end
	if not resolved then
		log("SetFont needs a font name like \"Montserrat\" or an Enum.Font")
		return false
	end
	local fonts = Nucleus.Fonts
	fonts.Regular = Font.new(resolved, Const.TEXT_WEIGHTS.Regular)
	fonts.Medium = Font.new(resolved, Const.TEXT_WEIGHTS.Medium)
	fonts.Bold = Font.new(resolved, Const.TEXT_WEIGHTS.Bold)
	return true
end

function Nucleus:LoadFont(input)
	input = normalizeOptions(input, {})
	if type(writefile) ~= "function" or type(isfile) ~= "function" or type(getcustomasset) ~= "function" then
		log("custom fonts need writefile, isfile and getcustomasset")
		return false
	end

	local familyName = input.Name or "CustomFont"
	local weightUrls = input.Weights or KNOWN_FONTS[familyName]
	if type(weightUrls) ~= "table" then
		log("no font weights for " .. familyName)
		return false
	end

	local folder = input.Folder or Const.FONT_FOLDER
	pcall(function()
		if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder(folder) then
			makefolder(folder)
		end
	end)

	local faces = {}
	local loadedWeights = {}
	for weightName, url in pairs(weightUrls) do
		local weightInfo = FONT_WEIGHTS[weightName]
		if weightInfo then
			local path = folder .. "/" .. familyName .. "-" .. weightName .. ".ttf"
			local ok = true
			if not isfile(path) then
				ok = pcall(function()
					writefile(path, game:HttpGet(url))
				end)
			end
			local assetOk, assetId = false, nil
			if ok then
				assetOk, assetId = pcall(getcustomasset, path)
			end
			if ok and assetOk and assetId then
				loadedWeights[weightName] = true
				table.insert(faces, {
					name = weightName,
					weight = weightInfo[1],
					style = "normal",
					assetId = assetId,
				})
			else
				log("could not download the " .. weightName .. " weight of " .. familyName)
			end
		end
	end

	if #faces == 0 then
		return false
	end

	local familyPath = folder .. "/" .. familyName .. ".json"
	local wrote = pcall(function()
		writefile(familyPath, HttpService:JSONEncode({ name = familyName, faces = faces }))
	end)
	if not wrote then
		return false
	end

	local familyOk, familyAsset = pcall(getcustomasset, familyPath)
	if not familyOk or not familyAsset then
		return false
	end

	local function fontFor(weightName, fallback)
		local weightInfo = FONT_WEIGHTS[weightName]
		if weightInfo and loadedWeights[weightName] then
			return Font.new(familyAsset, weightInfo[2])
		end
		return fallback
	end

	local fonts = Nucleus.Fonts
	fonts.Regular = fontFor("Regular", fonts.Regular)
	fonts.Medium = fontFor("Medium", fontFor("Regular", fonts.Medium))
	fonts.Bold = fontFor("SemiBold", fontFor("Bold", fonts.Bold))
	return true
end

Const.ICON_PACK_URL = "https://raw.githubusercontent.com/Footagesus/Icons/refs/heads/main/lucide/dist/Icons.lua"
local iconPack

local iconPackLoading = false

local function getIconPack()
	if iconPack ~= nil then
		return iconPack
	end
	if iconPackLoading then
		local waited = 0
		while iconPack == nil and waited < 15 do
			waited += task.wait(0.05)
		end
		return iconPack or false
	end
	iconPackLoading = true
	local ok, result = pcall(function()
		return loadstring(game:HttpGet(Const.ICON_PACK_URL))()
	end)
	if ok and type(result) == "table" then
		iconPack = result
	else
		iconPack = false
		log("lucide icons unavailable: " .. tostring(result))
	end
	iconPackLoading = false
	return iconPack
end
task.spawn(getIconPack)

function Nucleus:PreloadIcons()
	return getIconPack() ~= false
end

