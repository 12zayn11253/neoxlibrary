		ai._grip.Visible = false
	end

	local U = ae.ConfigurationSaving
	if type(U) == "table" and U.Enabled ~= false then
		ai.ConfigFolder = U.FolderName or i.GUI_NAME
		if not U.FolderName and type(isfolder) == "function" then
			local V, W = pcall(isfolder, i.GUI_NAME)
			local X, Y = pcall(isfolder, "NeoxHub")
			if V and X and not W and Y then
				ai.ConfigFolder = "NeoxHub"
			end
		end
		if U.PerGame == true then
			local V = (game.GameId and game.GameId ~= 0) and game.GameId or game.PlaceId
			ai.ConfigFolder = ai.ConfigFolder .. "/" .. tostring(V)
		end
		ai.ConfigName = U.FileName or "default"
		ai._autoSaveEnabled = U.AutoSave == true
		ai._autoLoad = U.AutoLoad == true
	else
		ai.ConfigFolder = i.GUI_NAME
		ai.ConfigName = "default"
		ai._autoSaveEnabled = false
	end

	table.insert(ai._connections, b.InputBegan:Connect(function(V, W)
		if W then
			return
		end
		if V.KeyCode == Enum.KeyCode.Escape and ai._dialog and ai._dialog.Dismissable then
			ai._dialog.Cancel()
			return
		end
		if V.UserInputType == Enum.UserInputType.Keyboard and V.KeyCode == ai.Keybind then

			task.defer(function()
				local X = ai._consumedKey == V.KeyCode
					and os.clock() - (ai._consumedAt or 0) < 0.2
				ai._consumedKey = nil
				if not X and not ai._destroyed then
					ai:Toggle(not ai.Open)
				end
			end)
		end
	end))

	pcall(function()
		if typeof(syn) == "table" and typeof(syn.protect_gui) == "function" then
			syn.protect_gui(ak)
		end
	end)
	ak.Parent = ae.Parent or getGuiParent()

	ai.Scale.Scale = 0.9
	ai:_setFade(0)
	ai.Shadow.ImageTransparency = 1
	ai.BodyStroke.Transparency = 1
	al.Visible = false
	ai:_fitToScreen(true)

	table.insert(ai._connections, ak:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		ai:_fitToScreen()
		ai:_clampToScreen()
	end))

	local V = ae.OpenButton
	if (V ~= nil and V ~= false) or (V == nil and x) then
		ai:_createOpenButton(type(V) == "table" and V or {})
	end

	ai._introDone = false
	table.insert(h.Windows, ai)

	ai:_setupPremium(ae)
	ai:_setupDonations()
	if ae.RememberTab == true then
		local W = tostring(ae.Title or "window"):gsub("[^%w]", "")
		ai._rememberKey = "tab_" .. (W ~= "" and W or "window")
		task.delay(0.6, function()
			if not ai._destroyed then
				ai:_restoreTab()
			end
		end)
	end
	if ae.Home ~= false then
		ai:_buildHome(type(ae.Home) == "table" and ae.Home or {}, ae.Membership)
	end

	if type(ae.User) == "table" and ae.User.Anonymous then
		ai:SetAnonymous(true)
	end
	if ae.Background then
		ai:SetBackground(ae.Background, ae.BackgroundTransparency)
	end

	local W = ae.Loading
	if type(W) == "table" then
		ae.LoadingDuration = W.Duration or ae.LoadingDuration
		ae.LoadingText = W.Text or W.Subtitle or ae.LoadingText
		ae.LoadingSteps = W.Steps or ae.LoadingSteps
		ae.LoadingTitle = W.Title or ae.LoadingTitle
		W = W.Enabled ~= false
	end

	if W == false then
		task.defer(function()
			if not ai._destroyed then
				ai:_playIntro()
			end
		end)
	else
		ai:_showLoader(ae)
	end

	return ai
end
h.CreateWindow = h.Window

local function remapProperty(ab, ac, ad)
	local ae = ad[ab[ac]:ToHex()]
	if ae then
		ab[ac] = ae
	end
end

local function remapGradient(ab, ac)
	local ad = false
	local ae = {}
	for af, ah in ipairs(ab.Color.Keypoints) do
		local ai = ac[ah.Value:ToHex()]
		if ai then
			ad = true
		end
		ae[af] = ColorSequenceKeypoint.new(ah.Time, ai or ah.Value)
	end
	if ad then
		ab.Color = ColorSequence.new(ae)
	end
end

local function isThemeExempt(ab)
	if ab:GetAttribute(i.ATTR_NO_THEME) then
		return true
	end

	local ac = ab.Parent
	return ac ~= nil
		and (ab:IsA("UIStroke") or ab:IsA("UIGradient"))
		and ac:GetAttribute(i.ATTR_NO_THEME) == true
end

local function recolorInstance(ab, ac)
	if isThemeExempt(ab) then
		return
	end
	if ab:IsA("GuiObject") then
		remapProperty(ab, "BackgroundColor3", ac)
	end
	if ab:IsA("TextLabel") or ab:IsA("TextButton") or ab:IsA("TextBox") then
		remapProperty(ab, "TextColor3", ac)
	end
	if ab:IsA("TextBox") then
		remapProperty(ab, "PlaceholderColor3", ac)
	end
	if ab:IsA("ImageLabel") or ab:IsA("ImageButton") then
		remapProperty(ab, "ImageColor3", ac)
	end
	if ab:IsA("ScrollingFrame") then
		remapProperty(ab, "ScrollBarImageColor3", ac)
	end
	if ab:IsA("UIStroke") then
		remapProperty(ab, "Color", ac)
	elseif ab:IsA("UIGradient") then
		remapGradient(ab, ac)
	end
end

local function recolorAllWindows(ab)
	for ac, ad in ipairs(h.Windows) do
		if ad.Gui and ad.Gui.Parent then
			for ae, af in ipairs(ad.Gui:GetDescendants()) do
				recolorInstance(af, ab)
			end
		end
	end
end

i.THEME_ALIASES = {
	Mono = "Default",
	Dark = "Default",
	White = "Light",
	Black = "Obsidian",
}

local function resolveTheme(ab)
	if type(ab) == "string" then
		ab = i.THEME_ALIASES[ab] or ab
		local ac = h.Themes[ab]
		if not ac then
			log("unknown theme: " .. ab)
			return nil
		end
		return table.clone(ac), ab
	elseif type(ab) == "table" then
		local ac = ab.Base or "Default"
		local ad = h.Themes[i.THEME_ALIASES[ac] or ac] or h.Themes.Default
		local ae = table.clone(ad)
		for af, ah in ipairs(o) do
			if typeof(ab[ah]) == "Color3" then
				ae[ah] = ab[ah]
			end
		end
		return ae, ab.Name or "Custom"
	end
	log("SetTheme expects a theme name or a table of colours")
	return nil
end

function h:SetAccent(ab)
	if ab ~= nil and typeof(ab) ~= "Color3" then
		log("SetAccent needs a Color3, like Color3.fromRGB(120, 200, 255), or nil to use the theme's own accent")
		return false
	end
	h._accent = ab
	return h:SetTheme(h._themeInput or h.ThemeName)
end

function h:GetAccent()
	return u.Accent
end

function h:GetThemes()
	local ab = {}
	for ac in pairs(h.Themes) do
		if ac ~= "Default" then
			table.insert(ab, ac)
		end
	end
	table.sort(ab)
	table.insert(ab, 1, "Default")
	return ab
end

function h:AddTheme(ab, ac)
	assert(type(ab) == "string" and ab ~= "", "AddTheme needs a name")
	local ad = resolveTheme(ac)
	if ad then
		h.Themes[ab] = ad
	end
	return ad ~= nil
end

local ab = 0

local function accentContrast(ac)
	local ad = 0.299 * ac.R + 0.587 * ac.G + 0.114 * ac.B
	if ad > 0.55 then
		return Color3.fromRGB(17, 17, 19)
	end
	return Color3.fromRGB(251, 251, 252)
end

function h:SetTheme(ac)
	local ad, ae = resolveTheme(ac)
	if not ad then
		return false
	end
	h._themeInput = ac
	local af = h._accent
	if af then
		ad.Accent = af
		ad.AccentDark = accentContrast(af)
	end

	local ah = {}
	local ai = {}
	for aj, ak in ipairs(o) do
		ai[ad[ak]:ToHex()] = true
	end
	for aj, ak in ipairs(o) do
		local al, am = u[ak], ad[ak]
		local an = al:ToHex()
		if al ~= am and ah[an] == nil then
			ah[an] = am
		end
	end

	for aj, ak in ipairs(o) do
		u[ak] = ad[ak]
	end
	h.ThemeName = ae

	recolorAllWindows(ah)
	for aj, ak in ipairs(h._themeListeners) do
		safeCall(ak)
	end

	ab += 1
	local aj = ab
	local ak = {}
	for al, am in pairs(ah) do
		if not ai[al] then
			ak[al] = am
		end
	end
	task.delay(0.6, function()
		if aj == ab then
			recolorAllWindows(ak)
		end
	end)

	return true
end

local function latestWindow()
	return h.Windows[#h.Windows]
end

function h:Notify(ac)
	local ad = latestWindow()
	if ad then
		return ad:Notify(ac)
	end
	return h:_notifyFallback(ac)
end

function h:Confirm(ac)
	local ad = latestWindow()
	return ad and ad:Confirm(ac) or nil
end

function h:Prompt(ac)
	local ad = latestWindow()
	return ad and ad:Prompt(ac) or nil
end

function h:Dialog(ac)
	local ad = latestWindow()
	return ad and ad:Dialog(ac) or nil
end

function h:GetFlag(ac)
	return h.Flags[ac]
end

function h:GetValue(ac)
	local ad = h.Flags[ac]
	if ad and type(ad.Get) == "function" then
		return ad:Get()
	end
	return nil
end

function h:SetValue(ac, ad, ae)
	local af = h.Flags[ac]
	if af and type(af.Set) == "function" then
		af:Set(ad, ae)
		return true
	end
	return false
end

function h:Copy(ac, ad)
	ac = tostring(ac or "")
	local ae = setclipboard
		or toclipboard
		or (syn and syn.write_clipboard)
		or (Clipboard and Clipboard.set)
	if type(ae) ~= "function" then
		h:Notify({ Title = "Can't copy", Content = "Your executor doesn't support copying.", Type = "Error", Duration = 3 })
		return false
	end
	local af = pcall(ae, ac)
	if ad and af then
		return true
	end
	local ah = #ac > 60 and (ac:sub(1, 57) .. "...") or ac
	h:Notify({
		Title = af and "Copied to clipboard" or "Copy failed",
		Content = ah ~= "" and ah or nil,
		Type = af and "Success" or "Error",
		Duration = 2.5,
	})
	return af
end

function h:Destroy()
	for ac = #h.Windows, 1, -1 do
		h.Windows[ac]:Destroy()
	end
	local ac = h._cleanup
	h._cleanup = {}
	for ad, ae in ipairs(ac) do
		task.spawn(safeCall, ae)
	end
end
h.Unload = h.Destroy

local function isVisiblyAt(ac, ad, ae)
	local af = ac
	while af and af ~= ad and af:IsA("GuiObject") do
		if not af.Visible then
			return false
		end
		local ah = af.Parent
		if ah and ah ~= ad and ah:IsA("GuiObject")
			and (ah.ClipsDescendants or ah:IsA("ScrollingFrame"))
			and not pointInside(ae, ah)
		then
			return false
		end
		af = ah
	end
	return true
end

function aa:_refreshControls()
	local ac, ad = {}, {}
	for ae, af in ipairs(self.Body:GetDescendants()) do
		if af:IsA("GuiButton") or af:IsA("TextBox") or af:GetAttribute(i.ATTR_NO_DRAG) then
			table.insert(ac, af)
		elseif af:IsA("ScrollingFrame") then
			table.insert(ad, af)
		end
	end
	self._controls = ac
	self._scrollers = ad
	self._controlsDirty = false
end

function aa:_overScrollbar(ac)
	for ad, ae in ipairs(self._scrollers or {}) do
		if ae.Parent and ae.ScrollBarThickness > 0 and pointInside(ac, ae) then
			local af, ah = ae.AbsoluteCanvasSize, ae.AbsoluteWindowSize
			local ai = ae.AbsolutePosition.X + ae.AbsoluteSize.X
			local aj = ae.AbsolutePosition.Y + ae.AbsoluteSize.Y
			local ak = ae.ScrollBarThickness + i.SCROLLBAR_GRAB
			local al = af.Y > ah.Y + 1 and ac.X >= ai - ak
			local am = af.X > ah.X + 1 and ac.Y >= aj - ak
			if (al or am) and isVisiblyAt(ae, self.Body, ac) then
				return true
			end
		end
	end
	return false
end

function aa:_overControl(ac)
	if self._dialog then
		return true
	end
	if self._controlsDirty then
		self:_refreshControls()
	end
	for ad, ae in ipairs(self._controls) do
		if ae.Parent and pointInside(ac, ae) and isVisiblyAt(ae, self.Body, ac) then
			return true
		end
	end
	return self:_overScrollbar(ac)
end

function aa:_overOverlay(ac)
	if self._grip and pointInside(ac, self._grip) then
		return true
	end
	for ad, ae in ipairs(self._overlays) do
		if ae.Parent and ae.Visible and pointInside(ac, ae) then
			return true
		end
	end
	if self.OpenButton and self.OpenButton.Visible and pointInside(ac, self.OpenButton) then
		return true
	end
	for ad, ae in ipairs(self.NotifyHolder:GetChildren()) do
		if ae:IsA("GuiObject") and pointInside(ac, ae) then
			return true
		end
	end
	return false
end

function aa:_enableDrag()
	local ac = false
	local ad = Vector2.zero

	local function rootCenter()
		local ae = self.Root
		return ae.AbsolutePosition + ae.AbsoluteSize * ae.AnchorPoint - self.Gui.AbsolutePosition
	end

	table.insert(self._connections, b.InputBegan:Connect(function(ae)
		if not isPress(ae) or not self.Open or not self.Root.Visible then
			return
		end
		local af = getMousePosition()
		if not pointInside(af, self.Body) or self:_overControl(af) or self:_overOverlay(af) then
			return
		end
		ac = true
		ad = af - rootCenter()
	end))

	table.insert(self._connections, b.InputEnded:Connect(function(ae)
		if ac and isPress(ae) then
			ac = false
			self:_clampToScreen()
		end
	end))

	table.insert(self._frameSteps, function(ae)
		if not ac then
			return
		end
		local af = getMousePosition() - ad
		local ah = 1 - math.exp(-ae * 45)
		local ai = rootCenter():Lerp(af, ah)
		self.Root.Position = UDim2.fromOffset(math.floor(ai.X + 0.5), math.floor(ai.Y + 0.5))
		self._userMoved = true
	end)
end

function aa:_restPosition()
	return self._restCenter or UDim2.fromScale(0.5, 0.5)
end

local function revealElement(ac, ad, ae)
	if not ac.Visible and not ae then
		return
	end
	ac.Visible = false
	task.delay(ad, function()
		if not ac.Parent or ac:GetAttribute(i.ATTR_HIDDEN) then
			return
		end
		local af = create("UIScale", { Scale = 0.94, Parent = ac })
		ac.Visible = true
		tween(af, { Scale = 1 }, 0.4, Enum.EasingStyle.Back)
		task.delay(0.4, function()
			af:Destroy()
		end)
	end)
end

function aa:_revealCards(ac, ad)
	if ac._revealed then
		return
	end
	ac._revealed = true
	if instantUI() then
		return
	end
	local ae = 0
	for af, ah in ipairs(ac.List:GetChildren()) do
		if ah:IsA("GuiObject") then
			revealElement(ah, (ad or 0) + ae * 0.035)
			ae += 1
		end
	end
end

function aa:_playIntro(ac)
	if self._introDone or self._destroyed then
		return
	end
	self._introDone = true
	if self._autoLoad and not self._autoLoaded then
		self._autoLoaded = true
		self:LoadConfig(self.ConfigName)
	end
	task.delay(1, function()
		self._autoSaveReady = true
	end)

	local ad, ae, af = self.Root, self.Shadow, self.Scale

	if self.CurrentTab then
		self:_revealCards(self.CurrentTab, ac and 0.15 or 0.25)
	end

	ad.Visible = true
	if ac then

		af.Scale = self._fitScale or 1
		ad.Position = self:_restPosition()
		self:_fadeIn(0.3)
		tween(self.BodyStroke, { Transparency = 0 }, 0.3)
		tween(ae, { ImageTransparency = 0.6 }, 0.3)
	else
		ad.Position = self:_restPosition() + UDim2.fromOffset(0, 24)
		tween(af, { Scale = self._fitScale or 1 }, 0.5, Enum.EasingStyle.Back)
		tween(ad, { Position = self:_restPosition() }, 0.5, Enum.EasingStyle.Quint)
		self:_fadeIn(0.35)
		tween(self.BodyStroke, { Transparency = 0 }, 0.35)
		tween(ae, { ImageTransparency = 0.6 }, 0.5)
	end

	if instantUI() then
		for ah, ai in ipairs(self.Tabs) do
			ai._button.Visible = ai._button:GetAttribute(i.ATTR_HIDDEN) ~= true
		end
	else
		for ah, ai in ipairs(self.Tabs) do
			revealElement(ai._button, 0.1 + ah * 0.05, true)
		end
	end

	if self.CurrentTab then
		self:_placeIndicator(self.CurrentTab)
	end
end

function aa:_showLoader(ac)
	local ad = ac.LoadingDuration or 1.6

	local ae = create("CanvasGroup", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 16),
		Size = UDim2.fromOffset(300, 132),
		BackgroundColor3 = u.Background,
		BorderSizePixel = 0,
		GroupTransparency = 1,
		ZIndex = 10,
		Parent = self.Gui,
	})
	local af = addCorner(ae, UDim.new(0, 12))
	local ah = addStroke(ae, u.Stroke, 1)
	addTopHighlight(ae)

	local ai = create("UIScale", { Scale = 0.92, Parent = ae })

	local aj = create("ImageLabel", {
		Position = UDim2.fromOffset(-25, -25),
		Size = UDim2.new(1, 50, 1, 50),
		BackgroundTransparency = 1,
		Image = v.Shadow,
		ImageColor3 = Color3.new(0, 0, 0),
		ImageTransparency = 1,
		ScaleType = Enum.ScaleType.Slice,
		SliceCenter = Rect.new(49, 49, 450, 450),
		ZIndex = 0,
		Parent = ae,
	})

	local ak = create("Frame", {
		Position = UDim2.fromOffset(22, 24),
		Size = UDim2.fromOffset(48, 48),
		BackgroundTransparency = 1,
		Parent = ae,
	})
	local al = create("ImageLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.5, 0.5),
		Rotation = -14,
		BackgroundTransparency = 1,
		ImageColor3 = logoColor(ac.Icon),
		ImageTransparency = 1,
		ScaleType = Enum.ScaleType.Fit,
		Parent = ak,
	})
	setLogo(al, ac.Icon)
	task.delay(0.15, function()
		tween(al, { Size = UDim2.fromScale(0.85, 0.85), Rotation = 0 }, 0.6, Enum.EasingStyle.Back)
		tween(al, { ImageTransparency = 0 }, 0.4)
	end)

	createLabel({
		Position = UDim2.fromOffset(84, 30),
		Size = UDim2.new(1, -104, 0, 22),
		Text = ac.LoadingTitle or ac.Title or i.LIB_NAME,
		TextSize = 20,
		Parent = ae,
	})
	local am = createLabel({
		Position = UDim2.fromOffset(84, 52),
		Size = UDim2.new(1, -104, 0, 16),
		Text = ac.LoadingText or ac.Subtitle or "Loading",
		TextSize = 13,
		FontFace = w.Regular,
		TextColor3 = u.Muted,
		Parent = ae,
	})

	local an = create("Frame", {
		Position = UDim2.new(0, 24, 1, -30),
		Size = UDim2.new(1, -48, 0, 4),
		BackgroundColor3 = u.Surface3,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = ae,
	})
	addCorner(an, UDim.new(1, 0))
	local ao = create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = u.Accent,
		BorderSizePixel = 0,
		Parent = an,
	})
	addCorner(ao, UDim.new(1, 0))
	local ap = create("Frame", {
		Position = UDim2.fromScale(-0.4, 0),
		Size = UDim2.fromScale(0.4, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = an,
	})
	create("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = ap,
	})

	tween(ae, { GroupTransparency = 0, Position = UDim2.fromScale(0.5, 0.5) }, 0.4, Enum.EasingStyle.Quint)
	tween(ai, { Scale = 1 }, 0.5, Enum.EasingStyle.Back)
	tween(aj, { ImageTransparency = 0.6 }, 0.4)

	local aq = a:Create(ap,
		TweenInfo.new(1.1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1),
		{ Position = UDim2.fromScale(1, 0) })
	aq:Play()

	tween(ao, { Size = UDim2.fromScale(0.85, 1) }, ad * 0.8, Enum.EasingStyle.Quart)
	task.spawn(getIconPack)

	local ar = ac.LoadingSteps or { "Preparing interface", "Loading icons", "Almost there" }
	for as, at in ipairs(ar) do
		task.delay(ad * (as - 1) / #ar, function()
			if ae.Parent then
				am.Text = at
			end
		end)
	end

	task.delay(ad, function()
		if self._destroyed or not ae.Parent then
			aq:Cancel()
			return
		end
		tween(ao, { Size = UDim2.fromScale(1, 1) }, 0.25, Enum.EasingStyle.Quint)

		task.delay(0.25, function()
			aq:Cancel()
			if self._destroyed or not ae.Parent then
				return
			end

			for as, at in ipairs(ae:GetChildren()) do
				if at:IsA("TextLabel") then
					tween(at, { TextTransparency = 1 }, 0.15)
				end
			end
			tween(al, { ImageTransparency = 1 }, 0.15)
			tween(an, { BackgroundTransparency = 1 }, 0.15)
			tween(ao, { BackgroundTransparency = 1 }, 0.15)
			tween(ap, { BackgroundTransparency = 1 }, 0.1)

			local as = self._fitScale or 1
			local at = self.Root.Size
			tween(ae, {
				Size = UDim2.fromOffset(at.X.Offset * as, at.Y.Offset * as),
				Position = self:_restPosition(),
			}, 0.5, Enum.EasingStyle.Quint)
			tween(af, { CornerRadius = UDim.new(0, 10) }, 0.5, Enum.EasingStyle.Quint)
			tween(ai, { Scale = 1 }, 0.5, Enum.EasingStyle.Quint)

			task.delay(0.28, function()
				if self._destroyed then
					return
				end
				self:_playIntro(true)
				tween(ae, { GroupTransparency = 1 }, 0.25)
				tween(ah, { Transparency = 1 }, 0.2)
				tween(aj, { ImageTransparency = 1 }, 0.2)
			end)
			task.delay(0.6, function()
				ae:Destroy()
			end)
		end)
	end)
end

function aa:_fitToScreen(ac)
	local ad = self.Gui.AbsoluteSize
	if ad.X == 0 or ad.Y == 0 then
		return
	end
	local ae = self._baseSize or Vector2.new(self.Root.Size.X.Offset, self.Root.Size.Y.Offset)
	local af = self._userScale or 1
	local ah, ai

	if x then
		local aj = math.min(ad.X, ad.Y) >= 700
		local ak = ad.Y > ad.X
		local al = math.clamp(getTopbarHeight(), 0, ad.Y * 0.25)
		local am = ad.Y - al
		local an
		if self._userResized then
			ah = math.floor(ae.X)
			ai = math.floor(ae.Y)
			an = self._lockedFit or self._fitScale or 1
		else
			ah = math.floor(aj and ae.X or math.min(ae.X, i.PHONE_LAYOUT.X))
			ai = math.floor(aj and ae.Y or math.min(ae.Y, i.PHONE_LAYOUT.Y))
			local ao = ad.X * (ak and i.PHONE_FIT.PortraitX or (aj and i.PHONE_FIT.TabletX or i.PHONE_FIT.LandscapeX))
			local ap = am * (ak and i.PHONE_FIT.PortraitY or i.PHONE_FIT.LandscapeY)
			an = math.min(ao / ah, ap / ai, 1) * af
		end
		an = math.min(an, (ad.X - 16) / ah, (am - 16) / ai)
		self._fitScale = math.max(an, 0.45)
		self._restCenter = UDim2.new(0.5, 0, 0.5, math.floor(al / 2))
		if self._introDone and not self._userMoved and self.Root.Position ~= self._restCenter then
			self.Root.Position = self._restCenter
		end
	else
		local aj = 24
		local ak, al = ad.X - aj * 2, ad.Y - aj * 2
		ah = math.min(ae.X, ak / af)
		ai = math.min(ae.Y, al / af)
		ah = math.floor(math.max(ah, math.min(i.COMPACT_MIN.X, ae.X)))
		ai = math.floor(math.max(ai, math.min(i.COMPACT_MIN.Y, ae.Y)))
		local am = math.min(ak / ah, al / ai)
		self._fitScale = math.max(math.min(af, am), 0.5)
		local an = self.Root
		local ao = an.AnchorPoint.X == 0.5 and an.Position.X.Scale == 0.5
		if ao then
			ah -= (math.floor(ad.X) - ah) % 2
			ai -= (math.floor(ad.Y) - ai) % 2
		else
			ah -= ah % 2
			ai -= ai % 2
		end
	end

	local aj = self.Root.Size
	if aj.X.Offset ~= ah or aj.Y.Offset ~= ai then
		self.Root.Size = UDim2.fromOffset(ah, ai)
	end
	self._autoCompact = ah < (x and i.PHONE_LAYOUT.X or i.COMPACT_WIDTH)
	self:_setCompact(self._autoCompact or self._sidebarCollapsed == true)

	if self._introDone and self.Open then
		if ac then
			self.Scale.Scale = self._fitScale
		else
			tween(self.Scale, { Scale = self._fitScale }, 0.2)
		end
	end
end

i.SIDEBAR_TWEEN = 0.3

function aa:_layoutTabButton(ac, ad, ae)
	local af = self._compact == true
	ac._button.Size = UDim2.new(1, 0, 0, i.TAB_HEIGHT)
	if ac._icon then
		local ah = math.floor(ac._icon.Size.X.Offset / 2)
		local ai = af and UDim2.new(0.5, -ah, 0.5, 0) or UDim2.new(0, 12, 0.5, 0)
		ac._icon.AnchorPoint = Vector2.new(0, 0.5)
		if ad then
			tween(ac._icon, { Position = ai }, i.SIDEBAR_TWEEN, Enum.EasingStyle.Quint)
		else
			ac._icon.Position = ai
		end
	end
	if ae then
		return
	end
	ac._label.Visible = not af
	if ac._initial then
		ac._initial.Visible = af and not ac._icon
	end
	if ac._badge then
		ac._badge.Visible = not af and ac._badgeText ~= nil
		ac:_fitBadge()
	end
	if ac._lockIcon then
		ac._lockIcon.Visible = ac._locked == true and not af
	end
end

function aa:_fadeItem(ac, ad, ae)
	if not ac then
		return
	end
	self._fadeBase = self._fadeBase or setmetatable({}, { __mode = "k" })
	local af = self._fadeBase
	local ah = {}
	local function add(ai, aj)
		local ak = af[ai]
		local al = ak and ak[aj]
		if al == nil then
			al = ai[aj]
			if type(al) ~= "number" or al >= 1 then
				return
			end
			ak = ak or {}
			ak[aj] = al
			af[ai] = ak
		end
		table.insert(ah, { ai, aj, al })
	end
	local function scan(ai)
		if ai:IsA("TextLabel") or ai:IsA("TextButton") or ai:IsA("TextBox") then
			add(ai, "TextTransparency")
		elseif ai:IsA("ImageLabel") or ai:IsA("ImageButton") then
			add(ai, "ImageTransparency")
		end
		if ai:IsA("UIStroke") then
			add(ai, "Transparency")
		elseif ai:IsA("GuiObject") then
			add(ai, "BackgroundTransparency")
		end
	end
	scan(ac)
	for ai, aj in ipairs(ac:GetDescendants()) do
		scan(aj)
	end
	if ad then
		ac.Visible = true
		for ai, aj in ipairs(ah) do
			aj[1][aj[2] ] = 1
		end
		task.delay(0.08, function()
			if self._compactGeneration ~= ae or self._destroyed then
				return
			end
			for ai, aj in ipairs(ah) do
				tween(aj[1], { [aj[2] ] = aj[3] }, 0.22)
			end
		end)
	else
		for ai, aj in ipairs(ah) do
			tween(aj[1], { [aj[2] ] = 1 }, 0.12)
		end
	end
end

function aa:_restoreFades()
	for ac, ad in pairs(self._fadeBase or {}) do
		for ae, af in pairs(ad) do
			ac[ae] = af
		end
	end
	self._fadeBase = nil
end

function aa:_sidebarTextItems(ac)
	local ad = { self._titleLabel, self._subtitleLabel, self._profileName, self._hintLabel }
	if not x then
		table.insert(ad, self._keyChip)
	end
	if self._searchFrame then
		table.insert(ad, self._searchFrame)
	end
	for ae, af in ipairs(self.Tabs) do
		table.insert(ad, af._label)
		if af._badge and af._badgeText ~= nil then
			table.insert(ad, af._badge)
		end
		if af._lockIcon and af._locked then
			table.insert(ad, af._lockIcon)
		end
	end
	return ad
end

function aa:_setCompact(ac, ad)
	ac = ac == true
	if self._compact == ac then
		return
	end
	self._compact = ac
	ad = ad == true and not instantUI()
	self._compactGeneration = (self._compactGeneration or 0) + 1
	local ae = self._compactGeneration
	if self._sidebarIcon then
		local af = ac and 180 or 0
		if ad then
			tween(self._sidebarIcon, { Rotation = af }, i.SIDEBAR_TWEEN, Enum.EasingStyle.Quint)
		else
			self._sidebarIcon.Rotation = af
		end
	end

	local af = ac and i.COMPACT_SIDEBAR or self._sidebarWidth
	local ah = UDim2.new(0, af - 8, 1, -16)
	local ai = UDim2.fromOffset(af + 2, 0)
	local aj = UDim2.new(1, -(af + 2), 1, 0)
	local ak = ac and 66 or self._listTop
	local al = UDim2.fromOffset(0, ak)
	local am = UDim2.new(1, 0, 1, -(ak + (self._listBottom or 66)))
	local an = math.floor(self._logo.Size.X.Offset / 2)
	local ao = math.floor(self._avatar.Size.X.Offset / 2)
	local ap = ac and UDim2.new(0.5, -an, 0, 15) or UDim2.fromOffset(12, 15)
	local aq = ac and UDim2.new(0.5, -ao, 0.5, 0) or UDim2.new(0, 8, 0.5, 0)
	self._logo.AnchorPoint = Vector2.zero
	self._avatar.AnchorPoint = Vector2.new(0, 0.5)

	local function placeLists(ar)
		ar.Position = al
		ar.Size = am
	end

	local function finish()
		if self._compactGeneration ~= ae or self._destroyed then
			return
		end
		self._sidebar.ClipsDescendants = false
		self._sidebar.Size = ah
		self.Content.Position = ai
		self.Content.Size = aj
		self._logo.Position = ap
		self._avatar.Position = aq
		placeLists(self.TabList)
		if self._searchResults then
			placeLists(self._searchResults)
		end
		self._titleLabel.Visible = not ac
		self._subtitleLabel.Visible = not ac
		if self._searchFrame then
			self._searchFrame.Visible = not ac
		end
		self._profileName.Visible = not ac
		self._keyChip.Visible = not ac and not x
		self._hintLabel.Visible = not ac
		if self._enforceParts then
			self:_enforceParts()
		end
		for ar, as in ipairs(self.Tabs) do
			self:_layoutTabButton(as)
		end
		for ar, as in ipairs(self._sections or {}) do
			as:_applyCompact(ac)
			if as._header then
				as._header.Size = UDim2.new(1, 0, 0, 38)
				as._header.ClipsDescendants = false
			end
		end
		self:_restoreFades()
		local ar = self.CurrentTab
		if ar and self._introDone and ar._button.Visible then
			self:_placeIndicator(ar)
		end
	end

	if ac and self._searchFrame and self._searchBox.Text ~= "" then
		self._searchBox.Text = ""
	end

	if not ad then
		finish()
		return
	end

	local ar = Enum.EasingStyle.Quint
	local as = i.SIDEBAR_TWEEN
	self._sidebar.ClipsDescendants = true
	tween(self._sidebar, { Size = ah }, as, ar)
	tween(self.Content, { Position = ai, Size = aj }, as, ar)
	tween(self._logo, { Position = ap }, as, ar)
	tween(self._avatar, { Position = aq }, as, ar)
	tween(self.TabList, { Position = al, Size = am }, as, ar)
	if self._searchResults then
		placeLists(self._searchResults)
	end

	if ac then
		for at, au in ipairs(self:_sidebarTextItems()) do
			if au.Visible then
				self:_fadeItem(au, false, ae)
			end
		end
		for at, au in ipairs(self.Tabs) do
			self:_layoutTabButton(au, true, true)
		end
		for at, au in ipairs(self._sections or {}) do
			if au._header and au._header.Visible then
				au._header.ClipsDescendants = true
				self:_fadeItem(au._header, false, ae)
				tween(au._header, { Size = UDim2.new(1, 0, 0, 0) }, as, ar)
			end
		end
	else
		self._titleLabel.Visible = true
		self._subtitleLabel.Visible = true
		self._profileName.Visible = true
		self._hintLabel.Visible = true
		self._keyChip.Visible = not x
		if self._searchFrame then
			self._searchFrame.Visible = true
		end
		if self._enforceParts then
			self:_enforceParts()
		end
		for at, au in ipairs(self.Tabs) do
			self:_layoutTabButton(au, true)
		end
		for at, au in ipairs(self:_sidebarTextItems()) do
			if au.Visible then
				self:_fadeItem(au, true, ae)
			end
		end
		for at, au in ipairs(self._sections or {}) do
			au:_applyCompact(false)
			local av = au._header
			if av then
				av.ClipsDescendants = true
				av.Size = UDim2.new(1, 0, 0, 0)
				self:_fadeItem(av, true, ae)
				tween(av, { Size = UDim2.new(1, 0, 0, 38) }, as, ar)
			end
		end
	end
	task.delay(as + 0.04, finish)
end

function aa:_clampToScreen()
	if not self.KeepOnScreen then
		return
	end
	local ac = self.Gui.AbsoluteSize
	local ad = self.Root
	local ae = ad.AbsoluteSize / 2
	local af = ad.AbsolutePosition + ae - self.Gui.AbsolutePosition
	local ah = Vector2.new(
		math.clamp(af.X, math.min(ae.X, ac.X / 2), math.max(ac.X - ae.X, ac.X / 2)),
		math.clamp(af.Y, math.min(ae.Y, ac.Y / 2), math.max(ac.Y - ae.Y, ac.Y / 2))
	)
	if (ah - af).Magnitude > 0.5 then
		tween(ad, { Position = UDim2.fromOffset(math.floor(ah.X + 0.5), math.floor(ah.Y + 0.5)) }, 0.25, Enum.EasingStyle.Quint)
	end
end

function aa:_createOpenButton(ac)
	local ad = self.Gui
	local ae = create("TextButton", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.fromOffset(0, 34),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = u.Background,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 30,
		Parent = ad,
	})
	addCorner(ae, UDim.new(1, 0))
	addStroke(ae, u.Stroke)
	addPadding(ae, 12, 16)

	local af = create("ImageLabel", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(22, 22),
		BackgroundTransparency = 1,
		ImageColor3 = logoColor(ac.Icon),
		ScaleType = Enum.ScaleType.Fit,
		ZIndex = 31,
		Parent = ae,
	})
	setLogo(af, ac.Icon)

	local ah = createLabel({
		Position = UDim2.fromOffset(30, 0),
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = ac.Title or i.LIB_NAME,
		TextSize = 13,
		TextTruncate = Enum.TextTruncate.None,
		ZIndex = 31,
		Parent = ae,
	})
	self.OpenButton = ae

	local ai
	local function placePill()
		if ai and ae.Position ~= ai then
			return
		end
		local aj = getTopbarInset()
		if aj and aj.Min.X > 0 and aj.Height >= 30 then
			local ak = aj.Height >= 50
			local al = ak and 44 or 32
			local am = ak and (aj.Max.Y - 24) or (aj.Min.Y + aj.Height / 2)
			ae.AnchorPoint = Vector2.new(0, 0.5)
			ae.Size = UDim2.fromOffset(0, al)
			af.Size = UDim2.fromOffset(ak and 26 or 22, ak and 26 or 22)
			ah.Position = UDim2.fromOffset(ak and 34 or 30, 0)
			ah.TextSize = math.floor((ak and 15 or 13) * h.TextScale + 0.5)
			ai = UDim2.fromOffset(aj.Min.X + 10, am)
		else
			ae.AnchorPoint = Vector2.new(0.5, 0)
			ai = UDim2.new(0.5, 0, 0, 6)
		end
		ae.Position = ai
	end
	placePill()
	pcall(function()
		table.insert(self._connections, c:GetPropertyChangedSignal("TopbarInset"):Connect(placePill))
	end)

	self:_makeDraggable(ae, function()
		self:Toggle()
	end)
	table.insert(self._overlays, ae)
end

function aa:_makeDraggable(ac, ad)
	local ae = self.Gui
	local af, ah = false, false
	local ai, aj = Vector2.zero, Vector2.zero

	ac.InputBegan:Connect(function(ak)
		if isPress(ak) then
			af, ah = true, false
			aj = getMousePosition()
			ai = aj - ac.AbsolutePosition
		end
	end)

	table.insert(self._connections, b.InputChanged:Connect(function(ak)
		if not af or not isMove(ak) then
			return
		end
		local al = getMousePosition()
		if (al - aj).Magnitude > 4 then
			ah = true
		end
		if not ah then
			return
		end
		local am = al - ai - ae.AbsolutePosition
		ac.AnchorPoint = Vector2.new(0, 0)
		ac.Position = UDim2.fromOffset(
			math.floor(math.clamp(am.X, 0, math.max(ae.AbsoluteSize.X - ac.AbsoluteSize.X, 0)) + 0.5),
			math.floor(math.clamp(am.Y, 0, math.max(ae.AbsoluteSize.Y - ac.AbsoluteSize.Y, 0)) + 0.5)
		)
	end))

	table.insert(self._connections, b.InputEnded:Connect(function(ak)
		if af and isPress(ak) then
			af = false
			if not ah and ad then
				ad()
			end
		end
	end))
end

function aa:_enableResize(ac)
	local ad = self.MaxSize or Vector2.new(math.huge, math.huge)
	if x then
		ac = Vector2.new(math.min(ac.X, 360), math.min(ac.Y, 240))
	end

	local ae = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, 4, 1, 4),
		Size = x and UDim2.fromOffset(48, 48) or UDim2.fromOffset(32, 32),
		BackgroundTransparency = 1,
		Active = true,
		ZIndex = 20,
		Parent = self.Root,
	})
	self._grip = ae

	local af = create("ImageLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, -16, 0.5, -16),
		Size = UDim2.fromOffset(96, 96),
		BackgroundTransparency = 1,
		Image = v.ResizeGrip,
		ImageColor3 = u.Accent,
		ImageTransparency = 0.8,
		ZIndex = 20,
		Parent = ae,
	})

	local ah = false
	local ai = self.Root.Size
	local aj = Vector2.zero
	local ak

	ae.InputBegan:Connect(function(al)
		if isPress(al) then
			ah = true
			ai = self.Root.Size
			aj = getMousePosition()
			tween(af, { ImageTransparency = 0.35 }, 0.1)
		end
	end)
	ae.MouseEnter:Connect(function()
		if x then
			return
		end
		if not ah then
			tween(af, { ImageTransparency = 0.35 }, 0.1)
		end
	end)
	ae.MouseLeave:Connect(function()
		if not ah then
			tween(af, { ImageTransparency = 0.8 }, 0.17)
		end
	end)

	table.insert(self._connections, b.InputEnded:Connect(function(al)
		if ah and isPress(al) then
			ah = false
			tween(af, { ImageTransparency = 0.8 }, 0.17)
			if ak then
				self.Root.Size = UDim2.fromOffset(ak.X, ak.Y)
				self._baseSize = ak
				ak = nil
				self._userResized = true
				self._lockedFit = self._fitScale
			end
			self:_fitToScreen()
			self:_clampToScreen()
		end
	end))

	table.insert(self._frameSteps, function(al)
		if not ah then
			return
		end
		local am = (getMousePosition() - aj) / self.Scale.Scale
		ak = Vector2.new(
			math.clamp(ai.X.Offset + am.X * 2, ac.X, ad.X),
			math.clamp(ai.Y.Offset + am.Y * 2, ac.Y, ad.Y)
		)
		local an = Vector2.new(self.Root.Size.X.Offset, self.Root.Size.Y.Offset)
		local ao = 1 - math.exp(-al * 35)
		local ap = an:Lerp(ak, ao)
		ap = Vector2.new(math.floor(ap.X + 0.5), math.floor(ap.Y + 0.5))
		if ap ~= an then
			self.Root.Size = UDim2.fromOffset(ap.X, ap.Y)
		end
	end)
end

local function sanitizeConfigName(ac)
	ac = tostring(ac or "")
		:gsub('[%c/\\:%*%?"<>|]', "")
		:gsub("%.%.+", ".")
		:gsub("^[%s%.]+", "")
		:gsub("[%s%.]+$", "")
	if ac == "" then
		return nil
	end
	return ac
end

local function configPath(ac, ad)
	local ae = sanitizeConfigName(ad)
	if not ae then
		return nil, "invalid config name"
	end
	return ac.ConfigFolder .. "/" .. ae .. ".json", ae
end

local function hasFileApi()
	return type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
end

local function ensureFolder(ac)
	if type(isfolder) ~= "function" or type(makefolder) ~= "function" then
		return
	end
	local ad = ""
	for ae in string.gmatch(ac, "[^/]+") do
		ad = ad == "" and ae or (ad .. "/" .. ae)
		if not isfolder(ad) then
			makefolder(ad)
		end
	end
end

local function serializeElement(ac)
	local ad = ac._type
	local ae = ac:Get()
	if ad == "Keybind" then
		return { Type = ad, Value = ae and ae.Name or nil }
	elseif ad == "ColorPicker" then
		return { Type = ad, Value = { ae.R, ae.G, ae.B } }
	end
	return { Type = ad, Value = ae }
end

local function applySavedValue(ac, ad, ae)
	local af = ac._type
	local ah = ad.Value
	if af == "Keybind" then
		ac:Set(toKeyCode(ah), ae)
	elseif af == "ColorPicker" then
		if type(ah) == "table" then
			ac:Set(Color3.new(ah[1], ah[2], ah[3]), ae)
		end
	elseif af == "Dropdown" then

		ac:Set(ah, ae)
	elseif ah ~= nil then
		ac:Set(ah, ae)
	end
end

function aa:SaveConfig(ac)
	if not hasFileApi() then
		return false, "file API unavailable"
	end
	local ad, ae = configPath(self, ac or self.ConfigName)
	if not ad then
		return false, ae
	end

	local af = {}
	for ah, ai in pairs(self.Flags) do
		if ai._type and type(ai.Get) == "function" then
			af[ah] = serializeElement(ai)
		end
	end
	for ah, ai in pairs(self._loadedConfig or {}) do
		if af[ah] == nil then
			af[ah] = ai
		end
	end

	local ah, ai = pcall(function()
		ensureFolder(self.ConfigFolder)
		writefile(ad, e:JSONEncode(af))
	end)
	if ah then
		self.ConfigName = ae
	end
	return ah, ai
end

function aa:LoadConfig(ac, ad)
	if not hasFileApi() then
		return false, "file API unavailable"
	end
	local ae, af = configPath(self, ac or self.ConfigName)
	if not ae then
		return false, af
	end
	if not isfile(ae) then
		return false, "no config named " .. af
	end

	local ah, ai = pcall(function()
		return e:JSONDecode(readfile(ae))
	end)
	if not ah or type(ai) ~= "table" then
		return false, "config is not valid JSON"
	end

	local aj = self._autoSaveEnabled
	self._autoSaveEnabled = false
	for ak, al in pairs(ai) do
		local am = self.Flags[ak]
		if am and type(am.Set) == "function" and type(al) == "table" and al.Type == am._type then
			local an, ao = pcall(applySavedValue, am, al, ad == true)
			if not an then
				log("could not load flag " .. tostring(ak) .. ": " .. tostring(ao))
			end
		end
	end
	self._autoSaveEnabled = aj
	self._autoSaveReady = true
	self.ConfigName = af
	self._loadedConfig = ai
	self:_queueDependencies()
	return true
end

function aa:_applyLateConfig(ac, ad)
	local ae = self._loadedConfig
	local af = ae and ae[ad]
	if type(af) ~= "table" or af.Type ~= ac._type or type(ac.Set) ~= "function" then
		return
	end
	local ah = self._autoSaveEnabled
	self._autoSaveEnabled = false
	local ai, aj = pcall(applySavedValue, ac, af, false)
	self._autoSaveEnabled = ah
	if not ai then
		log("could not load flag " .. tostring(ad) .. ": " .. tostring(aj))
	end
end

function aa:DeleteConfig(ac)
	if not hasFileApi() or type(delfile) ~= "function" then
		return false, "file API unavailable"
	end
	local ad, ae = configPath(self, ac)
	if not ad then
		return false, ae
	end
	if not isfile(ad) then
		return false, "no config named " .. ae
	end
	return pcall(delfile, ad)
end

function aa:ListConfigs()
	local ac = {}
	if type(listfiles) ~= "function" or type(isfolder) ~= "function" or not isfolder(self.ConfigFolder) then
		return ac
	end
	local ad, ae = pcall(listfiles, self.ConfigFolder)
	if not ad or type(ae) ~= "table" then
		return ac
	end
	for af, ah in ipairs(ae) do
		local ai = ah:match("([^/\\]+)%.json$")
		if ai then
			table.insert(ac, ai)
		end
	end
	table.sort(ac)
	return ac
end

function aa:ExportConfig()
	local ac = {}
	for ad, ae in pairs(self.Flags) do
		if ae._type and type(ae.Get) == "function" then
			ac[ad] = serializeElement(ae)
		end
	end
	for ad, ae in pairs(self._loadedConfig or {}) do
		if ac[ad] == nil then
			ac[ad] = ae
		end
	end
	local ad, ae = pcall(function()
		return e:JSONEncode(ac)
	end)
	return ad and ae or nil
end

function aa:ImportConfig(ac)
	local ad, ae = pcall(function()
		return e:JSONDecode(ac)
	end)
	if not ad or type(ae) ~= "table" then
		return false, "that is not a valid config"
	end
	local af = 0
	for ah, ai in pairs(ae) do
		local aj = self.Flags[ah]
		if aj and type(aj.Set) == "function" and type(ai) == "table" and ai.Type == aj._type then
			if pcall(applySavedValue, aj, ai, false) then
				af += 1
			end
		end
	end
	self._loadedConfig = ae
	if af == 0 then
		return false, "nothing in that config matches this script"
	end
	return true, af
end

function aa:ResetConfig()
	local ac = 0
	for ad, ae in pairs(self.Flags) do
		if ae._defaultValue ~= nil and type(ae.Set) == "function" then
			local af = ae._defaultValue
			if type(af) == "table" then
				af = table.clone(af)
			end
			if pcall(ae.Set, ae, af) then
				ac += 1
			end
		end
	end
	return ac
end

function aa:SetAutoSave(ac)
	self._autoSaveEnabled = ac == true
end

function aa:_autoSave()
	if not self._autoSaveEnabled or self._destroyed or not self._autoSaveReady or self._autoSavePending then
		return
	end
	self._autoSavePending = true
	task.delay(0.5, function()
		self._autoSavePending = false
		if not self._destroyed then
			self:SaveConfig(self.ConfigName)
		end
	end)
end

local function createEmptyState(ac, ad, ae)
	local af = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, -10),
		Size = UDim2.fromOffset(200, 70),
		BackgroundTransparency = 1,
		Parent = ac,
	})
	local ah = create("ImageLabel", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.fromOffset(26, 26),
		BackgroundTransparency = 1,
		ImageColor3 = u.Muted,
		ImageTransparency = 0.15,
		ScaleType = Enum.ScaleType.Fit,
		Parent = af,
	})
	setIcon(ah, ad)
	local ai = createLabel({
		Position = UDim2.fromOffset(0, 36),
		Size = UDim2.new(1, 0, 0, 16),
		Text = ae,
		TextSize = 13,
		FontFace = w.Regular,
		TextColor3 = u.Muted,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = af,
	})
	return af, ai, ah
end

local function createStatTile(ac, ad, ae, af)
	local ah = create("Frame", {
		Size = UDim2.new(0.5, -4, 0, 62),
		BackgroundColor3 = u.Surface2,
		BorderSizePixel = 0,
		LayoutOrder = ad,
		Parent = ac,
	})
	styleCard(ah)
	ah:SetAttribute(i.ATTR_NO_DRAG, true)
	if ae then
		createIcon(ah, ae, u.Muted, UDim2.new(0, 14, 0, 21))
	end
	createLabel({
		Position = UDim2.fromOffset(ae and 36 or 14, 12),
		Size = UDim2.new(1, -(ae and 50 or 28), 0, 16),
		Text = af,
		TextSize = 12,
		TextColor3 = u.Muted,
		Parent = ah,
	})
	return createLabel({
		Position = UDim2.fromOffset(14, 34),
		Size = UDim2.new(1, -28, 0, 18),
		Text = "…",
		TextSize = 15,
		Parent = ah,
	})
end

local ac = setmetatable({}, { __mode = "k" })

local function fadeInTree(ad)
	local ae = {}

	local function remember(af, ah)
		local ai = ac[af]
		if ai == nil then
			ai = af[ah]
			ac[af] = ai
		end
		table.insert(ae, { af, ah, ai })
	end

	local function walk(af)
		for ah, ai in ipairs(af:GetChildren()) do
			if ai:IsA("TextLabel") or ai:IsA("TextButton") or ai:IsA("TextBox") then
				remember(ai, "TextTransparency")
			elseif ai:IsA("ImageLabel") or ai:IsA("ImageButton") then
				remember(ai, "ImageTransparency")
			elseif ai:IsA("UIStroke") then
				remember(ai, "Transparency")
			elseif ai:IsA("Frame") then
				remember(ai, "BackgroundTransparency")
			end
			walk(ai)
		end
	end

	if ad:IsA("Frame") then
		remember(ad, "BackgroundTransparency")
	end
	walk(ad)

	for af, ah in ipairs(ae) do
		ah[1][ah[2] ] = 1
		tween(ah[1], { [ah[2] ] = ah[3] }, 0.28)
	end
end

local function slideIn(ad, ae)
	ae = ae or 0
	ad.GroupTransparency = 1
	ad.Position = UDim2.fromOffset(0, ae + 14)
	ad.Visible = true
	tween(ad, { GroupTransparency = 0, Position = UDim2.fromOffset(0, ae) }, 0.32, Enum.EasingStyle.Quint)
end

local function createChangelogCard(ad, ae, af)
	local ah = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = u.Surface2,
		BorderSizePixel = 0,
		LayoutOrder = ae,
		Parent = ad,
	})
	ah:SetAttribute(i.ATTR_NO_DRAG, true)
	styleCard(ah)
	addPadding(ah, 14, 14, 12, 14)
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 4),
		Parent = ah,
	})

	local ai = create("Frame", {
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = ah,
	})
	createLabel({
		Size = UDim2.new(1, -70, 1, 0),
		Text = af.Title or af.Version or "Update",
		TextSize = 14,
		Parent = ai,
	})

	if af.Date or af.Tag then
		local aj = create("Frame", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0),
			Size = UDim2.fromOffset(0, 20),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = u.Surface,
			BorderSizePixel = 0,
			Parent = ai,
		})
		addCorner(aj, UDim.new(0, 5))
		addStroke(aj)
		addPadding(aj, 8, 8)
		createLabel({
			Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X,
			Text = tostring(af.Tag or af.Date),
			TextSize = 11,
			TextColor3 = u.Muted,
			TextTruncate = Enum.TextTruncate.None,
			Parent = aj,
		})
	end

	local aj = af.Content or af.Body
	if type(af.Changes) == "table" then
		aj = "• " .. table.concat(af.Changes, "\n• ")
	end
	if aj then
		createLabel({
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Text = tostring(aj),
			TextSize = 13,
			FontFace = w.Regular,
			TextColor3 = u.Muted,
			TextWrapped = true,
			TextTruncate = Enum.TextTruncate.None,
			TextYAlignment = Enum.TextYAlignment.Top,
			LayoutOrder = 2,
			Parent = ah,
		})
	end
	return ah
end

i.DEFAULT_STATS = { "FPS", "Ping", "Executor", "Game", "Region", "Time" }

function aa:_buildHome(ad, ae)
	local af = self:Tab({
		Name = ad.Name or ad.Title or "Home",
		Desc = ad.Desc,
		Icon = ad.Icon or "house",
	})
	local ah = af.List
	local ai = ad.Pages or ad.Tabs
	local aj = {}

	local ak = type(ad.Layout) == "table" and ad.Layout or nil
	local al = {}
	if ak then
		for am, an in ipairs(ak) do
			al[tostring(an)] = am
		end
	end
	local function shown(am)
		return ak == nil or al[am] ~= nil
	end
	local function orderOf(am, an)
		return al[am] and al[am] * 10 or an
	end
	self._homeShown = shown
	self._homeOrderOf = orderOf

	if type(ai) ~= "table" then
		ai = {}
	end
	local am = create("Frame", {
		Name = "PageBar",
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Visible = #ai > 0,
		Parent = ah,
	})
	am:SetAttribute(i.ATTR_NO_DRAG, true)
	local an = create("ScrollingFrame", {
		Name = "Strip",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 0,
		ScrollingDirection = Enum.ScrollingDirection.X,
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		CanvasSize = UDim2.new(),
		ElasticBehavior = Enum.ElasticBehavior.Never,
		Parent = am,
	})
	an:SetAttribute(i.ATTR_NO_DRAG, true)
	local ao = create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6),
		Parent = an,
	})

	local function pageArrow(ap, aq, ar)
		local as = create("TextButton", {
			Name = ap,
			AnchorPoint = Vector2.new(ar, 0),
			Position = UDim2.fromScale(ar, 0),
			Size = UDim2.fromOffset(28, 32),
			BackgroundColor3 = u.Surface2,
			Text = "",
			AutoButtonColor = false,
			Visible = false,
			ZIndex = 3,
			Parent = am,
		})
		addCorner(as, UDim.new(0, 7))
		local at = addStroke(as)
		local au = create("ImageLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(16, 16),
			BackgroundTransparency = 1,
			ImageColor3 = u.Text,
			ScaleType = Enum.ScaleType.Fit,
			ZIndex = 4,
			Parent = as,
		})
		setIcon(au, aq)
		as.MouseEnter:Connect(function()
			if not x and as:GetAttribute("Enabled") ~= false then
				at.Color = u.StrokeHover
			end
		end)
		as.MouseLeave:Connect(function()
			at.Color = u.Stroke
		end)
		return as, au
	end
	local ap, aq = pageArrow("Previous", "chevron-left", 0)
	local ar, as = pageArrow("Next", "chevron-right", 1)

	local function stripLimit()
		return math.max(ao.AbsoluteContentSize.X - an.AbsoluteSize.X, 0)
	end
	local function updateArrows()
		local at = ao.AbsoluteContentSize.X > am.AbsoluteSize.X + 1
		ap.Visible = at
		ar.Visible = at
		if at then
			an.Position = UDim2.fromOffset(34, 0)
			an.Size = UDim2.new(1, -68, 1, 0)
		else
			an.Position = UDim2.fromOffset(0, 0)
			an.Size = UDim2.fromScale(1, 1)
			an.CanvasPosition = Vector2.zero
		end
		local au = an.CanvasPosition.X
		local av = at and au > 1
		local aw = at and au < stripLimit() - 1
		ap:SetAttribute("Enabled", av)
		ar:SetAttribute("Enabled", aw)
		aq.ImageTransparency = av and 0 or 0.65
		as.ImageTransparency = aw and 0 or 0.65
	end
	local function scrollStrip(at)
		at = math.clamp(math.floor(at + 0.5), 0, stripLimit())
		an.CanvasPosition = Vector2.new(at, 0)
		updateArrows()
	end
	ap.MouseButton1Click:Connect(function()
		scrollStrip(an.CanvasPosition.X - math.max(an.AbsoluteSize.X * 0.7, 80))
	end)
	ar.MouseButton1Click:Connect(function()
		scrollStrip(an.CanvasPosition.X + math.max(an.AbsoluteSize.X * 0.7, 80))
	end)
	ao:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateArrows)
	am:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateArrows)
	an:GetPropertyChangedSignal("CanvasPosition"):Connect(updateArrows)

	local at = ad.Greeting
	if at == nil then
		local au = tonumber(os.date("%H")) or 12
		local av = au < 12 and "morning" or (au < 18 and "afternoon" or "evening")
		at = "Good " .. av .. "."
	end

	local au
	if ad.Welcome ~= false and shown("Welcome") then
		au = create("Frame", {
			Size = UDim2.new(1, 0, 0, 58),
			BackgroundColor3 = u.Surface2,
			BorderSizePixel = 0,
			LayoutOrder = 2,
			Parent = ah,
		})
		au:SetAttribute(i.ATTR_NO_DRAG, true)
		styleCard(au)

		local av = create("ImageLabel", {
			Position = UDim2.fromOffset(12, 11),
			Size = UDim2.fromOffset(36, 36),
			BackgroundColor3 = u.Surface,
			BorderSizePixel = 0,
			Parent = au,
		})
		addCorner(av, UDim.new(0, 8))
		addStroke(av)
		task.spawn(function()
			local aw, L = pcall(function()
				return f:GetUserThumbnailAsync(g.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
			end)
			if aw and L and av.Parent then
				av.Image = L
			end
		end)

		createLabel({
			Position = UDim2.fromOffset(58, 11),
			Size = UDim2.new(1, -72, 0, 18),
			Text = tostring(ad.Welcome or "Hello, ") .. g.DisplayName,
			TextSize = 15,
			Parent = au,
		})
		createLabel({
			Position = UDim2.fromOffset(58, 30),
			Size = UDim2.new(1, -72, 0, 16),
			Text = at,
			TextSize = 13,
			FontFace = w.Regular,
			TextColor3 = u.Muted,
			Parent = au,
		})
	end

	local av = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 3,
		Parent = ah,
	})
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		Parent = av,
	})

	if ad.Sections ~= false and shown("Stats") then
		local aw = create("Frame", {
			Size = UDim2.new(1, 0, 0, 24),
			BackgroundTransparency = 1,
			LayoutOrder = orderOf("Stats", 2) - 1,
			Parent = av,
		})
		local L = createLabel({
			Position = UDim2.fromOffset(2, 6),
			Size = UDim2.new(0, 0, 0, 16),
			AutomaticSize = Enum.AutomaticSize.X,
			Text = string.upper(ad.SectionName or "System info"),
			TextSize = 12,
			TextColor3 = u.Muted,
			TextTruncate = Enum.TextTruncate.None,
			Parent = aw,
		})
		local M = create("Frame", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0, 14),
			Size = UDim2.new(1, -12, 0, 1),
			BackgroundColor3 = u.Stroke,
			BorderSizePixel = 0,
			Parent = aw,
		})
		local function fitLine()
			M.Size = UDim2.new(1, -(L.AbsoluteSize.X / self.Scale.Scale + 14), 0, 1)
		end
		L:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitLine)
		task.defer(fitLine)
	end

	local aw = ae
	if aw == nil then
		aw = ad.Key
	end
	local L = type(aw) == "table" and aw or {}
	if not shown("Membership") then
		aw = false
	end
	local M = orderOf("Membership", 0)
	if aw ~= false then
		self.KeyPanel = createKeyPanel(self, av, M, L)
	end
	task.spawn(function()
		while aw ~= false and L.Protected ~= false and not self._destroyed and av.Parent do
			task.wait(2)
			if self._destroyed or not av.Parent then
				break
			end
			local N = self.KeyPanel and self.KeyPanel.Frame
			if not N or N.Parent ~= av then
				if N and N.Parent then
					pcall(function()
						N:Destroy()
					end)
				end
				self.KeyPanel = createKeyPanel(self, av, M, L)
			elseif not N.Visible then
				N.Visible = true
			end
		end
	end)

	local N = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = orderOf("Stats", 2),
		Visible = shown("Stats"),
		Parent = av,
	})
	create("UIGridLayout", {
		CellSize = UDim2.new(0.5, -4, 0, 62),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = N,
	})

	local O = {}
	if shown("Stats") then
		for P, Q in ipairs(ad.Stats or i.DEFAULT_STATS) do
			O[Q] = true
		end
	end

	local P = 0
	local function addStat(Q, R, S)
		if not O[Q] then
			return nil
		end
		P += 1
		return createStatTile(N, P, R, S)
	end

	local Q = addStat("FPS", "activity", "FPS")
	local R = addStat("Ping", "wifi", "Ping")
	local S = addStat("Executor", "terminal", "Executor")
	local T = addStat("Game", "gamepad-2", "Game")
	local U = addStat("Region", "globe", "Your region")
	local V = addStat("Time", "clock", "Time of day")
	local W = addStat("Players", "users", "Players")
	local X = addStat("Uptime", "timer", "Session")

	if S then
		S.Text = getExecutorName()
	end
	if T then
		T.Text = "Loading"
		task.spawn(function()
			local Y = getGameName()
			if T.Parent then
				T.Text = Y
			end
		end)
	end
	if U then
		U.Text = "Loading"
		fetchRegion(function(Y)
			if U.Parent then
				U.Text = Y
			end
		end, ad.RegionCity == false)
	end

	local Y = 0
	local Z = os.clock()
	self:_listen("Render", function()
		Y += 1
	end)

	task.spawn(function()
		while not self._destroyed and af.List.Parent and af._page.Parent do

			if not self.Open or self.CurrentTab ~= af then
				Y = 0
				task.wait(1)
				continue
			end
			if Q then
				Q.Text = tostring(Y)
			end
			Y = 0
			if R then
				local _, ax = pcall(function()
					return math.floor(g:GetNetworkPing() * 1000)
				end)
				R.Text = (_ and ax or 0) .. " ms"
			end
			if V then
				V.Text = os.date(ad.TimeFormat or "%H:%M")
			end
			if W then
				W.Text = #f:GetPlayers() .. " / " .. f.MaxPlayers
			end
			if X then
				local ax = math.floor(os.clock() - Z)
				X.Text = string.format("%d:%02d", math.floor(ax / 60), ax % 60)
			end
			task.wait(1)
		end
	end)

	if self._buildCommunity then
		self:_buildCommunity(av)
	end

	table.insert(aj, {
		Title = ad.SectionName or "Details",
		Icon = ad.TabIcon or "layout-grid",
		Frame = av,
	})

	do
		local function addTextCard(ax, _)
			local ay = create("Frame", {
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundColor3 = u.Surface2,
				BorderSizePixel = 0,
				LayoutOrder = _,
				Parent = ax,
			})
			ay:SetAttribute(i.ATTR_NO_DRAG, true)
			styleCard(ay)
			addPadding(ay, 14, 14, 12, 14)
			return ay
		end

		local function buildPage(ax)
			local ay = create("Frame", {
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				Visible = false,
				LayoutOrder = 3,
				Parent = ah,
			})
			create("UIListLayout", {
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 8),
				Parent = ay,
			})

			if type(ax.Content) == "string" then
				local _ = addTextCard(ay, 1)
				createLabel({
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					Text = ax.Content,
					TextSize = 13,
					FontFace = w.Regular,
					TextColor3 = u.Muted,
					TextWrapped = true,
					TextTruncate = Enum.TextTruncate.None,
					TextYAlignment = Enum.TextYAlignment.Top,
					Parent = _,
				})
			end

			if type(ax.Entries) == "table" then
				for _, az in ipairs(ax.Entries) do
					createChangelogCard(ay, _ + 1, az)
				end
			end

			if type(ax.Build) == "function" then
				safeCall(ax.Build, ay)
				for az, _ in ipairs(ay:GetChildren()) do
					if _:IsA("GuiObject") then
						_:SetAttribute(i.ATTR_NO_DRAG, true)
					end
				end
			end

			return {
				Title = ax.Name or ax.Title or "Page",
				Icon = ax.Icon,
				Frame = ay,
			}
		end

		for ax, ay in ipairs(ai) do
			if type(ay) == "table" then
				table.insert(aj, buildPage(ay))
			end
		end

		local ax = {}
		local function revealPill(ay)
			local az = ax[ay]
			if not az or not ap.Visible then
				return
			end
			local _ = az.Frame.AbsolutePosition.X - an.AbsolutePosition.X + an.CanvasPosition.X
			local aA = _ + az.Frame.AbsoluteSize.X
			local aB = an.CanvasPosition.X
			if _ < aB then
				scrollStrip(_)
			elseif aA > aB + an.AbsoluteSize.X then
				scrollStrip(aA - an.AbsoluteSize.X)
			end
		end

		local function showPage(ay, az)
			local aA = self._homeIndex ~= ay
			self._homeIndex = ay
			if au then
				au.Visible = ay == 1
				if ay == 1 and aA and not az then
					fadeInTree(au)
				end
			end

			for aB, _ in ipairs(aj) do
				local aC = aB == ay
				_.Frame.Visible = aC
				if aC and aA and not az then
					for aD, aE in ipairs(_.Frame:GetChildren()) do
						if aE:IsA("GuiObject") then
							fadeInTree(aE)
						end
					end
				end

				local aD = ax[aB]
				if aD then
					if aC then
						task.defer(revealPill, aB)
					end
					tween(aD.Frame, { BackgroundTransparency = aC and 0 or 1 }, 0.15)
					tween(aD.Stroke, { Transparency = aC and 0 or 1 }, 0.15)
					tween(aD.Label, { TextColor3 = aC and u.Text or u.Muted }, 0.15)
					if aD.Icon then
						tween(aD.Icon, { ImageColor3 = aC and u.Accent or u.Muted }, 0.15)
					end
				end
			end
		end

		local function addPill(ay, az)
			local aA = create("TextButton", {
				Size = UDim2.fromOffset(0, 32),
				AutomaticSize = Enum.AutomaticSize.X,
				BackgroundColor3 = u.Surface2,
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
				LayoutOrder = ay,
				Parent = an,
			})
			addCorner(aA, UDim.new(0, 7))
			local aB = addStroke(aA, u.Stroke, 1)
			addPadding(aA, 12, 12)

			local aC
			if az.Icon then
				aC = create("ImageLabel", {
					AnchorPoint = Vector2.new(0, 0.5),
					Position = UDim2.new(0, 0, 0.5, 0),
					Size = UDim2.fromOffset(14, 14),
					BackgroundTransparency = 1,
					ImageColor3 = u.Muted,
					ScaleType = Enum.ScaleType.Fit,
					Parent = aA,
				})
				setIcon(aC, az.Icon)
			end

			local aD = createLabel({
				Position = UDim2.fromOffset(aC and 20 or 0, 0),
				Size = UDim2.new(0, 0, 1, 0),
				AutomaticSize = Enum.AutomaticSize.X,
				Text = az.Title,
				TextSize = 13,
				TextColor3 = u.Muted,
				TextTruncate = Enum.TextTruncate.None,
				Parent = aA,
			})

			ax[ay] = {
				Frame = aA,
				Stroke = aB,
				Label = aD,
				Icon = aC,
			}

			aA.MouseEnter:Connect(function()
				if x then
					return
				end
				if self._homeIndex ~= ay then
					tween(aA, { BackgroundTransparency = 0.4 }, 0.12)
					tween(aB, { Transparency = 0.5 }, 0.12)
				end
			end)
			aA.MouseLeave:Connect(function()
				if self._homeIndex ~= ay then
					tween(aA, { BackgroundTransparency = 1 }, 0.2)
					tween(aB, { Transparency = 1 }, 0.2)
				end
			end)
			aA.MouseButton1Click:Connect(function()
				showPage(ay)
			end)
		end

		for ay, az in ipairs(aj) do
			addPill(ay, az)
		end

		showPage(1)
		self._showHomePage = showPage
		self._homePages = aj
		self._addHomePage = function(ay)
			local az = buildPage(ay)
			table.insert(aj, az)
			addPill(#aj, az)
			am.Visible = #aj > 1
			showPage(self._homeIndex or 1, true)
			task.defer(updateArrows)
			return az
		end
		task.defer(updateArrows)
	end

	af._order = 10
	self.Home = af
	return af
end

function aa:Tab(ad, ae)
	local af = normalizeOptions(ad, { Title = "Name", Description = "Desc" })
	if ae ~= nil and af.Icon == nil then
		af.Icon = ae
	end

	local ah = setmetatable({
		Name = af.Name or "Tab",
		Window = self,
		_order = 0,
	}, K)

	local ai = af.Section
	if ai == nil then
		ai = self._currentSection
	end
	if ai == false then
		ai = nil
	end
	local aj
	if ai then
		ai._count += 1
		aj = ai._base + ai._count
		ah._section = ai
		table.insert(ai.Tabs, ah)
		if ai._refreshCount then
			ai:_refreshCount()
		end
	else
		self._looseTabOrder += 1
		aj = self._looseTabOrder
	end

	local ak = create("TextButton", {
		Size = UDim2.new(1, 0, 0, i.TAB_HEIGHT),
		BackgroundColor3 = u.Surface2,
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = aj,
		Parent = self.TabList,
	})
	addCorner(ak)
	local al = addStroke(ak, u.Stroke, 1)
	ah._button = ak
	ah._stroke = al

	local am = af.Icon ~= nil
	if am then
		local an = create("ImageLabel", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 12, 0.5, 0),
			Size = UDim2.fromOffset(16, 16),
			BackgroundTransparency = 1,
			ImageColor3 = u.Muted,
			ScaleType = Enum.ScaleType.Fit,
			Parent = ak,
		})
		setIcon(an, af.Icon)
		ah._icon = an
	end

	ah._labelX = am and 36 or 14
	if not am then
		ah._initial = createLabel({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(20, 20),
			Text = string.upper(string.sub(ah.Name, 1, 1)),
			TextSize = 14,
			FontFace = w.Bold,
			TextColor3 = u.Muted,
			TextXAlignment = Enum.TextXAlignment.Center,
			Visible = false,
			Parent = ak,
		})
	end
	ah._label = createLabel({
		Position = UDim2.fromOffset(ah._labelX, 0),
		Size = UDim2.new(1, -(am and 44 or 22), 1, 0),
		Text = ah.Name,
		TextColor3 = u.Muted,
		Parent = ak,
	})

	local an = create("Frame", {
		Name = ah.Name,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = self.Content,
	})
	ah._page = an

	ah._pageTitle = createLabel({
		Position = UDim2.fromOffset(i.PAGE_PAD + 36, 18),
		Size = UDim2.new(1, -108, 0, 24),
		Text = ah.Name,
		TextSize = 19,
		Parent = an,
	})
	if af.Desc then
		ah._pageDesc = createLabel({
			Position = UDim2.fromOffset(i.PAGE_PAD + 36, 40),
			Size = UDim2.new(1, -108, 0, 16),
			Text = af.Desc,
			TextSize = 13,
			FontFace = w.Regular,
			TextColor3 = u.Muted,
			Parent = an,
		})
	end

	local ao = af.Desc and 64 or 54
	local ap = create("ScrollingFrame", {
		Active = true,
		Position = UDim2.fromOffset(0, ao),
		Size = UDim2.new(1, 0, 1, -ao),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = u.Muted,
		ScrollBarImageTransparency = 0.55,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = an,
	})
	addScrollFades(ap, "Background", 16)
	addPadding(ap, i.PAGE_PAD, i.PAGE_PAD, 2, 20)
	if x then
		ap:SetAttribute(i.ATTR_NO_DRAG, true)
	end
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, C.Spacing),
		Parent = ap,
	})
	ah.List = ap

	local aq = createEmptyState(an, af.Icon or "layout-grid", af.EmptyText or "Nothing here yet")
	local ar = 0
	ap.ChildAdded:Connect(function(as)
		if as:IsA("GuiObject") then
			ar += 1
			aq.Visible = false
		end
	end)
	ap.ChildRemoved:Connect(function(as)
		if as:IsA("GuiObject") then
			ar = math.max(ar - 1, 0)
			aq.Visible = ar <= 0
		end
	end)
	aq.Visible = true

	ak.MouseEnter:Connect(function()
		if x then
			return
		end
		if self._compact then
			self:_showTooltip(ah.Name, ak)
		end
		if self.CurrentTab ~= ah and not ah._locked then
			tween(ah._label, { TextColor3 = u.Text }, 0.15)
			if ah._icon then
				tween(ah._icon, { ImageColor3 = u.Text }, 0.15)
			end
		end
	end)
	ak.MouseLeave:Connect(function()
		self:_hideTooltip(ak)
		if self.CurrentTab ~= ah then
			tween(ah._label, { TextColor3 = u.Muted }, 0.2)
			if ah._icon then
				tween(ah._icon, { ImageColor3 = u.Muted }, 0.2)
			end
		end
	end)
	ak.MouseButton1Click:Connect(function()
		self:SelectTab(ah)
	end)

	if not self._introDone then
		ak.Visible = false
	end
	if ai and not ai.Opened and not self._compact then
		ak.Visible = false
		ak:SetAttribute(i.ATTR_HIDDEN, true)
	end
	if af.Badge ~= nil then
		ah:SetBadge(af.Badge)
	end
	self:_layoutTabButton(ah)
	if type(af.Build) == "function" then
		ah._lazyBuild = af.Build
	end
	if af.Locked == true then
		ah:SetLocked(true, af.LockedReason)
	end
	if af.Visible == false or af.Hidden == true then
		task.defer(function()
			ah:SetVisible(false)
		end)
	end

	table.insert(self.Tabs, ah)
	if #self.Tabs == 1 then
		task.defer(function()
			if not self.CurrentTab then
				self:SelectTab(ah)
			end
		end)
	end

	return ah
end
aa.CreateTab = aa.Tab

function aa:_placeIndicator(ad)
	local ae = self.Indicator
	if not ad or not ad._button or self._destroyed then
		return
	end
	if ae.Parent ~= ad._button then
		ae.Parent = ad._button
	end
	ae.BackgroundTransparency = 0.86
	ae.Visible = true
end

function aa:SetBlur()
	removeLeftoverBlur()
end

function aa:SelectTab(ad)
	self:_hideTooltip()
	if type(ad) == "string" then
		local ae = ad
		ad = nil
		for af, ah in ipairs(self.Tabs) do
			if ah.Name == ae then
				ad = ah
				break
			end
		end
	end
	if type(ad) ~= "table" or self.CurrentTab == ad then
		return
	end

	if ad._section and not ad._section.Opened then
		ad._section:SetOpen(true)
	end

	local ae = self.CurrentTab
	self.CurrentTab = ad
	self:_settleTransition()

	self._transitionGeneration = (self._transitionGeneration or 0) + 1
	local af = self._transitionGeneration

	if ae then
		ae._button.BackgroundTransparency = 1
		ae._stroke.Transparency = 1
		tween(ae._label, { TextColor3 = u.Muted }, 0.18)
		ae._label.Position = UDim2.fromOffset(ae._labelX, 0)
		if ae._icon then
			tween(ae._icon, { ImageColor3 = u.Muted }, 0.18)
		end

		if instantUI() then
			ae._page.Parent = self.Content
			ae._page.Visible = false
		end
		local ah = (not instantUI()) and self._outLayer or nil
		if ah then
			ae._page.Parent = ah
			self._outPage = ae._page
			ah.GroupTransparency = 0
			ah.Position = UDim2.fromOffset(0, 0)
			ah.Visible = true
			tween(ah, { GroupTransparency = 1, Position = UDim2.fromOffset(0, -10) }, 0.18)
			task.delay(0.18, function()
				if self._transitionGeneration == af then
					self:_settleOut()
				end
			end)
		end
	end

	ad._button.BackgroundTransparency = 1
	ad._stroke.Transparency = 1
	tween(ad._label, { TextColor3 = u.Text }, 0.18)
	ad._label.Position = UDim2.fromOffset(ad._labelX, 0)
	if ad._icon then
		tween(ad._icon, { ImageColor3 = u.Accent }, 0.18)
	end
	self:_placeIndicator(ad)

	local ah = ad._page
	ah.Position = UDim2.fromOffset(0, 0)
	ah.Visible = true
	if instantUI() then
		ah.Parent = self.Content
		return
	end
	ah.Parent = self._inLayer
	self._inPage = ah
	slideIn(self._inLayer)
	task.delay(0.32, function()
		if self._transitionGeneration == af then
			self:_settleIn()
		end
	end)
end

function aa:_settleOut()
	if self._destroyed then
		return
	end
	local ad = self._outPage
	if ad then
		ad.Parent = self.Content
		ad.Visible = false
		self._outPage = nil
	end
	self._outLayer.Visible = false
end

function aa:_settleIn()
	if self._destroyed then
		return
	end
	local ad = self._inPage
	if ad then
		ad.Parent = self.Content
		ad.Position = UDim2.fromOffset(0, 0)
		self._inPage = nil
	end
	self._inLayer.Visible = false
end

function aa:_settleTransition()
	self:_settleOut()
	self:_settleIn()
end

i.DIALOG_PADDING = 18
i.DIALOG_WIDTH = 300

function aa:Dialog(ad)
	local ae = normalizeOptions(ad, { Text = "Content", Message = "Content" })

	if self._dialog then
		self._dialog.Close()
	end

	local af = i.DIALOG_PADDING

	local ah = create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 40,
		Parent = self.Body,
	})
	addCorner(ah, UDim.new(0, C.WindowRadius))

	local ai = create("TextButton", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 10),
		Size = UDim2.fromOffset(i.DIALOG_WIDTH, 120),
		BackgroundColor3 = u.Background,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 41,
		Parent = ah,
	})
	addCorner(ai, UDim.new(0, 10))
	local aj = addStroke(ai, u.Stroke, 1)
	local ak = create("UIScale", { Scale = 0.94, Parent = ai })

	local al = {}
	local am = 0

	if ae.Icon then
		local an, ao = createIcon(ai, ae.Icon, u.Accent, UDim2.new(0, af, 0, af + 9))
		ao.ImageTransparency = 1
		an.ZIndex = 42
		ao.ZIndex = 42
		table.insert(al, { ao, "ImageTransparency", 0 })
		am = 24
	end

	local an = createLabel({
		Position = UDim2.fromOffset(af + am, af),
		Size = UDim2.new(1, -(af * 2 + am), 0, 18),
		Text = ae.Title or "Are you sure?",
		TextSize = 15,
		TextTransparency = 1,
		ZIndex = 42,
		Parent = ai,
	})
	table.insert(al, { an, "TextTransparency", 0 })

	local ao = create("Frame", {
		Name = "ButtonRow",
		Size = UDim2.new(1, -af * 2, 0, 34),
		BackgroundTransparency = 1,
		ZIndex = 42,
		Parent = ai,
	})
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		Parent = ao,
	})

	local ap = 0
	local aq, ar, as
	local at = type(ae.Input) == "table" and ae.Input or (ae.Input and {} or nil)
	local au = at and 42 or 0
	local function layout()
		ai.Size = UDim2.fromOffset(i.DIALOG_WIDTH, af + 24 + ap + au + 12 + 34 + af)
		if aq then
			aq.Position = UDim2.fromOffset(af, af + 24 + ap + 6)
		end
		ao.Position = UDim2.fromOffset(af, af + 24 + ap + au + 12)
	end

	if at then
		aq = create("Frame", {
			Size = UDim2.new(1, -af * 2, 0, 34),
			BackgroundColor3 = u.Surface,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 42,
			Parent = ai,
		})
		addCorner(aq, UDim.new(0, 7))
		as = addStroke(aq, u.Stroke, 1)
		as.Transparency = 1
		local av = tonumber(at.MaxLength)
		ar = create("TextBox", {
			Position = UDim2.fromOffset(10, 0),
			Size = UDim2.new(1, -20, 1, 0),
			BackgroundTransparency = 1,
			Text = "",
			PlaceholderText = tostring(at.Placeholder or ""),
			PlaceholderColor3 = u.Muted,
			TextColor3 = u.Text,
			TextSize = 13,
			FontFace = w.Regular,
			TextXAlignment = Enum.TextXAlignment.Left,
			ClearTextOnFocus = false,
			ClipsDescendants = true,
			TextTransparency = 1,
			ZIndex = 43,
			Parent = aq,
		})
		ar.Text = tostring(at.Default or "")
		ar:GetPropertyChangedSignal("Text"):Connect(function()
			if av and #ar.Text > av then
				ar.Text = ar.Text:sub(1, av)
			end
		end)
		ar.Focused:Connect(function()
			tween(as, { Color = u.StrokeHover }, 0.15)
		end)
		ar.FocusLost:Connect(function()
			tween(as, { Color = u.Stroke }, 0.15)
		end)
		table.insert(al, { aq, "BackgroundTransparency", 0 })
		table.insert(al, { as, "Transparency", 0 })
		table.insert(al, { ar, "TextTransparency", 0 })
	end

	if ae.Content then
		local av = createLabel({
			Position = UDim2.fromOffset(af, af + 24),
			Size = UDim2.new(1, -af * 2, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Text = tostring(ae.Content),
			TextSize = 13,
			FontFace = w.Regular,
			TextColor3 = u.Muted,
			TextWrapped = true,
			TextTransparency = 1,
			TextTruncate = Enum.TextTruncate.None,
			TextYAlignment = Enum.TextYAlignment.Top,
			ZIndex = 42,
			Parent = ai,
		})
		table.insert(al, { av, "TextTransparency", 0 })
		ap = math.max(av.TextBounds.Y, 16) + 6
		av:GetPropertyChangedSignal("TextBounds"):Connect(function()
			local aw = math.max(av.TextBounds.Y, 16) + 6
			if aw ~= ap then
				ap = aw
				layout()
			end
		end)
	end
	layout()

	local av = {}
	local aw = false

	function av.Close()
		if aw then
			return
		end
		aw = true
		if self._dialog == av then
			self._dialog = nil
		end
		tween(ah, { BackgroundTransparency = 1 }, 0.18)
		tween(ai, { BackgroundTransparency = 1, Position = UDim2.new(0.5, 0, 0.5, 8) }, 0.18, Enum.EasingStyle.Quint)
		tween(ak, { Scale = 0.96 }, 0.18, Enum.EasingStyle.Quint)
		tween(aj, { Transparency = 1 }, 0.12)
		for ax, ay in ipairs(al) do
			tween(ay[1], { [ay[2] ] = 1 }, 0.12)
		end
		task.delay(0.2, function()
			ah:Destroy()
		end)
	end

	function av.Cancel()
		if aw then
			return
		end
		av.Close()
		safeCall(ae.OnCancel)
	end

	function av.GetText()
		return ar and ar.Text or nil
	end

	local function inputValid()
		if not ar or not at.Numeric or tonumber(ar.Text) then
			return true
		end
		as.Color = u.Error
		tween(as, { Color = u.Stroke }, 0.6)
		return false
	end

	local ax

	local ay = ae.Buttons
	if type(ay) ~= "table" or #ay == 0 then
		ay = { { Title = "OK", Variant = "Primary" } }
	end

	for az, aA in ipairs(ay) do
		local aB = aA.Variant == "Primary"
		local aC = aB and 0.12 or 0
		local aD = aB and 0.4 or 0

		local aE = create("TextButton", {
			Size = UDim2.fromOffset(0, 34),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = aB and u.Accent or u.Surface2,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Text = "",
			AutoButtonColor = false,
			ClipsDescendants = true,
			LayoutOrder = az,
			ZIndex = 43,
			Parent = ao,
		})
		addCorner(aE, UDim.new(0, 7))
		local L = addStroke(aE, aB and u.Accent or u.Stroke, 1)
		addPadding(aE, 14, 14)

		local M = createLabel({
			Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X,
			Text = aA.Title or aA.Name or "OK",
			TextSize = 13,
			TextColor3 = aB and u.AccentDark or u.Text,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextTransparency = 1,
			ZIndex = 44,
			Parent = aE,
		})

		table.insert(al, { aE, "BackgroundTransparency", aC })
		table.insert(al, { L, "Transparency", aD })
		table.insert(al, { M, "TextTransparency", 0 })

		aE.MouseEnter:Connect(function()
			if x then
				return
			end
			if aw then
				return
			end
			if aB then
				tween(aE, { BackgroundTransparency = 0 }, 0.12)
				tween(L, { Transparency = 0 }, 0.12)
			else
				tween(L, { Color = u.StrokeHover }, 0.12)
			end
		end)
		aE.MouseLeave:Connect(function()
			if aw then
				return
			end
			if aB then
				tween(aE, { BackgroundTransparency = aC }, 0.2)
				tween(L, { Transparency = aD }, 0.2)
			else
				tween(L, { Color = u.Stroke }, 0.2)
			end
		end)
		local function activate()
			if aw then
				return
			end
			if aB and not inputValid() then
				return
			end
			local N = ar and ar.Text or nil
			av.Close()
			runProtected(('dialog button "%s"'):format(tostring(aA.Title or aA.Name or "OK")), aA.Callback, N)
		end
		if aB then
			ax = activate
		end
		aE.MouseButton1Click:Connect(activate)
	end

	if ar then
		ar.FocusLost:Connect(function(az)
			if az and ax then
				ax()
			end
		end)
		task.delay(0.3, function()
			if not aw and ar.Parent and not x then
				ar:CaptureFocus()
			end
		end)
	end

	av.Dismissable = ae.CloseOnBackdrop ~= false
	if av.Dismissable then
		ah.MouseButton1Click:Connect(av.Cancel)
	end

	self._dialog = av

	tween(ah, { BackgroundTransparency = 0.45 }, 0.25)
	tween(ai, { BackgroundTransparency = 0, Position = UDim2.fromScale(0.5, 0.5) }, 0.3, Enum.EasingStyle.Quint)
	tween(aj, { Transparency = 0 }, 0.25)
	tween(ak, { Scale = 1 }, 0.4, Enum.EasingStyle.Back)
	for az, aA in ipairs(al) do
		tween(aA[1], { [aA[2] ] = aA[3] }, 0.25)
	end

	return av
end

function aa:Prompt(ad)
	local ae = normalizeOptions(ad, { Text = "Content", Message = "Content", PlaceholderText = "Placeholder" })
	return self:Dialog({
		Title = ae.Title or "Enter a value",
		Content = ae.Content,
		Icon = ae.Icon,
		OnCancel = ae.OnCancel,
		CloseOnBackdrop = ae.CloseOnBackdrop,
		Input = {
			Placeholder = ae.Placeholder,
			Default = ae.Default,
			Numeric = ae.Numeric,
			MaxLength = ae.MaxLength,
		},
		Buttons = {
			{ Title = ae.CancelText or "Cancel", Callback = function()
				safeCall(ae.OnCancel)
			end },
			{ Title = ae.ConfirmText or "OK", Variant = "Primary", Callback = function(af)
				safeCall(ae.Callback, ae.Numeric and tonumber(af) or af)
			end },
		},
	})
end

function aa:Confirm(ad)
	local ae = normalizeOptions(ad, { Text = "Content", Message = "Content" })
	return self:Dialog({
		Title = ae.Title or "Are you sure?",
		Content = ae.Content,
		Icon = ae.Icon,
		OnCancel = ae.OnCancel,
		CloseOnBackdrop = ae.CloseOnBackdrop,
		Buttons = {
			{ Title = ae.CancelText or "Cancel", Callback = ae.OnCancel },
			{ Title = ae.ConfirmText or "Confirm", Variant = "Primary", Callback = ae.Callback },
		},
	})
end

function aa:_listen(ad, ae, af)
	local ah = self._inputListeners[ad]
	table.insert(ah, ae)

	local function disconnect()
		local ai = table.find(ah, ae)
		if ai then
			table.remove(ah, ai)
		end
	end

	if af then
		af._listeners = af._listeners or {}
		table.insert(af._listeners, disconnect)
	end
	return disconnect
end

function aa:Toggle(ad)
	if not self._introDone or self._destroyed then
		return
	end
	if self.Minimized then
		self:Minimize(false)
		if ad ~= false then
			return
		end
	end
	if ad == nil then
		ad = not self.Open
	end
	if ad == self.Open then
		return
	end
	self.Open = ad
	self:_hideTooltip()
	for ae, af in ipairs(self._events[ad and "Open" or "Close"]) do
		task.spawn(safeCall, af)
	end

	if ad then
		self.Root.Visible = true
		tween(self.Scale, { Scale = self._fitScale or 1 }, 0.4, Enum.EasingStyle.Back)
		self:_fadeIn(0.25)
		tween(self.BodyStroke, { Transparency = 0 }, 0.25)
		tween(self.Shadow, { ImageTransparency = 0.6 }, 0.3)
	else
		tween(self.Scale, { Scale = (self._fitScale or 1) * 0.94 }, 0.2, Enum.EasingStyle.Quint)
		self:_fadeOut(0.16)
		tween(self.BodyStroke, { Transparency = 1 }, 0.12)
		tween(self.Shadow, { ImageTransparency = 1 }, 0.16)
		if instantUI() then
			self.Root.Visible = false
		end
		task.delay(0.2, function()
			if not self.Open and not self._destroyed then
				self.Root.Visible = false
			end
		end)
	end
end

function aa:_setFade(ad)
	self._fadeGeneration = (self._fadeGeneration or 0) + 1
	local ae = self._fader
	ae.BackgroundColor3 = u.Background
	ae.BackgroundTransparency = ad
	ae.Visible = ad < 1
end

function aa:_fadeIn(ad)
	self._fadeGeneration = (self._fadeGeneration or 0) + 1
	local ae = self._fadeGeneration
	local af = self._fader
	af.BackgroundColor3 = u.Background
	if instantUI() or not ad or ad <= 0 then
		af.BackgroundTransparency = 1
		af.Visible = false
		return
	end
	af.Visible = true
	tween(af, { BackgroundTransparency = 1 }, ad)
	task.delay(ad, function()
		if self._fadeGeneration == ae and not self._destroyed then
			af.Visible = false
		end
	end)
end

function aa:_fadeOut(ad)
	self._fadeGeneration = (self._fadeGeneration or 0) + 1
	local ae = self._fader
	ae.BackgroundColor3 = u.Background
	ae.Visible = true
	if instantUI() or not ad or ad <= 0 then
		ae.BackgroundTransparency = 0
		return
	end
	tween(ae, { BackgroundTransparency = 0 }, ad * 0.7)
end

function aa:SetKeepOnScreen(ad)
	self.KeepOnScreen = ad ~= false
	if self.KeepOnScreen then
		self:_clampToScreen()
	end
end

function aa:SetKeybind(ad)
	ad = toKeyCode(ad)
	if not ad then
		return
	end
	self.Keybind = ad
	self._keyChipLabel.Text = keyDisplayName(ad)
end

function aa:SetTitle(ad)
	self._titleLabel.Text = tostring(ad)
end

function aa:SetSubtitle(ad)
	self._subtitleLabel.Text = tostring(ad)
end

function aa:SetIcon(ad)
	setIcon(self._logo, ad)
end

function aa:SetTheme(ad)
	return h:SetTheme(ad)
end

function aa:SetScale(ad)
	self._userScale = math.clamp(tonumber(ad) or 1, 0.5, 1.5)
	self:_fitToScreen()
	self:_clampToScreen()
end

function aa:GetScale()
	return self._userScale or 1
end

function aa:_registerKeybind(ad)
	table.insert(self._keybinds, ad)
end

function aa:_showTooltip(ad, ae)
	if x then
		return
	end
	self._tooltipOwner = ae
	self._tooltipGeneration = (self._tooltipGeneration or 0) + 1
	local af = self._tooltipGeneration
	task.delay(0.35, function()
		if self._destroyed or self._tooltipGeneration ~= af or self._tooltipOwner ~= ae or not self.Open then
			return
		end
		if typeof(ae) == "Instance" then
			local ah = ae
			while ah and ah ~= self.Gui do
				if ah:IsA("GuiObject") and not ah.Visible then
					return
				end
				ah = ah.Parent
			end
			if ah ~= self.Gui then
				return
			end
		end
		self._tooltipLabel.Text = tostring(ad)
		self._tooltip.Visible = true
		task.spawn(function()
			while self._tooltip.Visible and self._tooltipGeneration == af and not self._destroyed do
				task.wait(0.25)
				if typeof(ae) == "Instance" and (not ae.Parent or not ae.Visible) then
					self:_hideTooltip(ae)
				end
			end
		end)
	end)
end

function aa:_hideTooltip(ad)
	if ad and ad ~= self._tooltipOwner then
		return
	end
	self._tooltipOwner = nil
	self._tooltipGeneration = (self._tooltipGeneration or 0) + 1
	if self._tooltip then
		self._tooltip.Visible = false
	end
end

i.MAX_SEARCH_RESULTS = 40

function aa:_runSearch(ad)
	local ae = self._searchResults
	if not ae then
		return
	end
	for af, ah in ipairs(ae:GetChildren()) do
		if ah:IsA("GuiObject") then
			ah:Destroy()
		end
	end

	local af = string.lower((ad or ""):match("^%s*(.-)%s*$"))
	if af == "" then
		ae.Visible = false
		self.TabList.Visible = true
		if self.CurrentTab and self._introDone then
			self:_placeIndicator(self.CurrentTab)
		end
		return
	end

	ae.Visible = true
	self.TabList.Visible = false
	self.Indicator.Visible = false

	local ah = {}
	for ai, aj in ipairs(self.Tabs) do
		if not aj._userHidden and string.find(string.lower(aj.Name), af, 1, true) then
			table.insert(ah, { Title = aj.Name, Subtitle = "Tab", Tab = aj })
		end
	end
	for ai, aj in ipairs(self._searchIndex) do
		if #ah >= i.MAX_SEARCH_RESULTS then
			break
		end
		local ak = aj.Element
		if not ak._destroyed and aj.Frame.Parent and ak.Visible ~= false
			and not (aj.Tab and aj.Tab._userHidden)
			and string.find(string.lower(aj.Name), af, 1, true)
		then
			table.insert(ah, {
				Title = aj.Name,
				Subtitle = aj.Tab.Name,
				Tab = aj.Tab,
				Group = aj.Group,
				Frame = aj.Frame,
			})
		end
	end

	if #ah == 0 then
		createLabel({
			Size = UDim2.new(1, 0, 0, 30),
			Text = "No results",
			TextSize = 13,
			FontFace = w.Regular,
			TextColor3 = u.Muted,
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = ae,
		})
		return
	end

	for ai, aj in ipairs(ah) do
		local ak = create("TextButton", {
			Size = UDim2.new(1, 0, 0, 40),
			BackgroundColor3 = u.Surface2,
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = ai,
			Parent = ae,
		})
		addCorner(ak)
		local al = addStroke(ak, u.Stroke, 1)
		createLabel({
			Position = UDim2.fromOffset(12, 5),
			Size = UDim2.new(1, -20, 0, 16),
			Text = aj.Title,
			TextSize = 13,
			Parent = ak,
		})
		createLabel({
			Position = UDim2.fromOffset(12, 21),
			Size = UDim2.new(1, -20, 0, 14),
			Text = aj.Subtitle,
			TextSize = 11,
			FontFace = w.Regular,
			TextColor3 = u.Muted,
			Parent = ak,
		})
		ak.MouseEnter:Connect(function()
			if x then
				return
			end
			tween(ak, { BackgroundTransparency = 0.4 }, 0.12)
			tween(al, { Transparency = 0.5 }, 0.12)
		end)
		ak.MouseLeave:Connect(function()
			tween(ak, { BackgroundTransparency = 1 }, 0.2)
			tween(al, { Transparency = 1 }, 0.2)
		end)
		ak.MouseButton1Click:Connect(function()
			self:_jumpTo(aj)
		end)
	end
end

function aa:_jumpTo(ad)
	if self._searchBox then
		self._searchBox.Text = ""
	end
	self:SelectTab(ad.Tab)

	local ae = ad.Group
	while ae do
		if not ae.Open then
			ae:SetOpen(true)
		end
		ae = ae._parentGroup
	end

	local af = ad.Frame
	if not af then
		return
	end
	task.delay(0.4, function()
		if self._destroyed or not af.Parent then
			return
		end
		local ah = ad.Tab.List
		local ai = (af.AbsolutePosition.Y - ah.AbsolutePosition.Y) / self.Scale.Scale
		local aj = math.max(ah.CanvasPosition.Y + ai - 12, 0)
		tween(ah, { CanvasPosition = Vector2.new(0, aj) }, 0.35, Enum.EasingStyle.Quint)
		task.delay(0.3, function()
			for ak, al in ipairs(af:GetChildren()) do
				if al:IsA("UIStroke") then
					flashStroke(al)
					task.delay(0.5, function()
						flashStroke(al)
					end)
					break
				end
			end
		end)
	end)
end

function aa:Search(ad)
	if self._searchBox then
		self._searchBox.Text = tostring(ad or "")
	end
end

local function createOverlayPanel(ad, ae, af, ah)
	local ai = create("Frame", {
		Position = ae,
		Size = UDim2.fromOffset(af or 0, 0),
		AutomaticSize = af and Enum.AutomaticSize.Y or Enum.AutomaticSize.XY,
		BackgroundColor3 = u.Background,
		BorderSizePixel = 0,
		ZIndex = 50,
		Parent = ad.Gui,
	})
	addCorner(ai, UDim.new(0, 8))
	addStroke(ai)
	if not ah then
		addTopHighlight(ai)
	end
	table.insert(ad._overlays, ai)
	return ai
end

function aa:Watermark(ad)
	local ae = normalizeOptions(ad, { Name = "Text", Title = "Text" })
	local af = ae.ShowFPS ~= false
	local ah = ae.ShowPing ~= false
	local ai = ae.ShowTime ~= false

	local aj = createOverlayPanel(self, ae.Position or UDim2.fromOffset(16, math.floor(getTopbarHeight()) + 10), nil, true)
	aj.Size = UDim2.fromOffset(0, 30)
	aj.AutomaticSize = Enum.AutomaticSize.X
	addPadding(aj, 10, 12)
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		Parent = aj,
	})

	local ak = create("ImageLabel", {
		Size = UDim2.fromOffset(20, 20),
		BackgroundTransparency = 1,
		ImageColor3 = logoColor(ae.Icon),
		ScaleType = Enum.ScaleType.Fit,
		LayoutOrder = 1,
		ZIndex = 51,
		Parent = aj,
	})
	setLogo(ak, ae.Icon)

	local al = createLabel({
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		TextSize = 13,
		TextTruncate = Enum.TextTruncate.None,
		LayoutOrder = 2,
		ZIndex = 51,
		Parent = aj,
	})

	local am = { Frame = aj, Visible = true }
	local an = ae.Text or self._titleLabel.Text
	local ao, ap = 0, 0
	local aq = self:_listen("Render", function()
		ao += 1
	end)

	local function render()
		local ar = {}
		local as = an
		if type(as) == "function" then
			local at, au = pcall(as)
			as = at and au or ""
		end
		if as ~= nil and tostring(as) ~= "" then
			table.insert(ar, tostring(as))
		end
		if af then
			table.insert(ar, ap .. " fps")
		end
		if ah then
			local at, au = pcall(function()
				return math.floor(g:GetNetworkPing() * 1000)
			end)
			table.insert(ar, (at and au or 0) .. " ms")
		end
		if ai then
			table.insert(ar, os.date(ae.TimeFormat or "%H:%M"))
		end
		al.Text = table.concat(ar, "  •  ")
	end

	function am:SetText(ar)
		an = ar
		render()
	end

	function am:SetVisible(ar)
		am.Visible = ar ~= false
		aj.Visible = am.Visible
	end

	function am:Destroy()
		aq()
		aj:Destroy()
	end

	self:_makeDraggable(aj)
	render()

	task.spawn(function()
		local ar = os.clock()
		while not self._destroyed and aj.Parent do
			task.wait(1)
			local as = os.clock()
			ap = math.floor(ao / math.max(as - ar, 0.001) + 0.5)
			ao, ar = 0, as
			if aj.Visible then
				render()
			end
		end
	end)

	if ae.Visible == false then
		am:SetVisible(false)
	end
	return am
end

function aa:KeybindList(ad)
	local ae = normalizeOptions(ad, { Name = "Title" })
	local af = ae.ActiveOnly == true

	local ah = createOverlayPanel(self, ae.Position or UDim2.new(0, 16, 0.5, -80), 210, true)
	addPadding(ah, 12, 12, 10, 10)
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6),
		Parent = ah,
	})

	local ai = create("Frame", {
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		ZIndex = 51,
		Parent = ah,
	})
	createIcon(ai, "keyboard", u.Accent, UDim2.new(0, 0, 0.5, 0))
	createLabel({
		Position = UDim2.fromOffset(24, 0),
		Size = UDim2.new(1, -24, 1, 0),
		Text = ae.Title or "Keybinds",
		TextSize = 13,
		ZIndex = 51,
		Parent = ai,
	})
	create("Frame", {
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = u.Stroke,
		BorderSizePixel = 0,
		LayoutOrder = 2,
		ZIndex = 51,
		Parent = ah,
	})

	local aj = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 3,
		ZIndex = 51,
		Parent = ah,
	})
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 4),
		Parent = aj,
	})

	local ak = { Frame = ah, Visible = true }
	local al

	local function refresh()
		local am = {}
		local an = {}
		for ao, ap in ipairs(self._keybinds) do
			local aq = ap.GetKey()
			if aq and not ap.Element._destroyed then
				local ar = ap.GetActive()
				if not af or ar then
					table.insert(am, { Name = ap.Name, Key = aq, Active = ar })
					table.insert(an, ap.Name .. aq.Name .. tostring(ar))
				end
			end
		end
		local ao = table.concat(an, "|")
		if ao == al then
			return
		end
		al = ao

		for ap, aq in ipairs(aj:GetChildren()) do
			if aq:IsA("GuiObject") then
				aq:Destroy()
			end
		end

		if #am == 0 then
			createLabel({
				Size = UDim2.new(1, 0, 0, 18),
				Text = af and "Nothing active" or "No keybinds",
				TextSize = 12,
				FontFace = w.Regular,
				TextColor3 = u.Muted,
				ZIndex = 51,
				Parent = aj,
			})
			return
		end

		for ap, aq in ipairs(am) do
			local ar = create("Frame", {
				Size = UDim2.new(1, 0, 0, 18),
				BackgroundTransparency = 1,
				LayoutOrder = ap,
				ZIndex = 51,
				Parent = aj,
			})
			createLabel({
				Size = UDim2.new(1, -70, 1, 0),
				Text = aq.Name,
				TextSize = 12,
				FontFace = w.Regular,
				TextColor3 = aq.Active and u.Text or u.Muted,
				ZIndex = 51,
				Parent = ar,
			})
			createLabel({
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, 0, 0, 0),
				Size = UDim2.new(0, 70, 1, 0),
				Text = "[" .. keyDisplayName(aq.Key) .. "]",
				TextSize = 12,
				TextColor3 = aq.Active and u.Accent or u.Muted,
				TextXAlignment = Enum.TextXAlignment.Right,
				ZIndex = 51,
				Parent = ar,
			})
		end
	end

	function ak:SetVisible(am)
		ak.Visible = am ~= false
		ah.Visible = ak.Visible
	end

	function ak:Refresh()
		al = nil
		refresh()
	end

	function ak:Destroy()
		ah:Destroy()
	end

	self:_makeDraggable(ah)
	refresh()

	task.spawn(function()
		while not self._destroyed and ah.Parent do
			task.wait(0.2)
			if ah.Visible then
				refresh()
			end
		end
	end)

	if ae.Visible == false then
		ak:SetVisible(false)
	end
	return ak
end

local ad = {
	TopRight = { Anchor = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 16), Bottom = false, Side = 1 },
	BottomRight = { Anchor = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -16), Bottom = true, Side = 1 },
	TopLeft = { Anchor = Vector2.new(0, 0), Position = UDim2.new(0, 16, 0, 16), Bottom = false, Side = -1 },
	BottomLeft = { Anchor = Vector2.new(0, 1), Position = UDim2.new(0, 16, 1, -16), Bottom = true, Side = -1 },
	Top = { Anchor = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, x and 64 or 16), Bottom = false, Side = 0 },
	Bottom = { Anchor = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -16), Bottom = true, Side = 0 },
}

i.DEFAULT_NOTIFY_POSITION = x and "TopRight" or "BottomRight"
i.NOTIFY_WIDTH = 300

local function applyNotifyPosition(ae, af)
	local ah = ad[af] or ad[i.DEFAULT_NOTIFY_POSITION]
	ae.Position = ad[af] and af or i.DEFAULT_NOTIFY_POSITION
	ae.Layout = ah
	ae.Holder.AnchorPoint = ah.Anchor
	ae.Holder.Position = ah.Position
	ae.ListLayout.VerticalAlignment = ah.Bottom and Enum.VerticalAlignment.Bottom or Enum.VerticalAlignment.Top
end

A = function(ae, af, ah, ai)
	local aj = create("Frame", {
		Name = "Notifications",
		Size = UDim2.new(0, i.NOTIFY_WIDTH, 1, -32),
		BackgroundTransparency = 1,
		ZIndex = 80,
		Parent = ae,
	})
	local ak = create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6),
		Parent = aj,
	})
	if x then
		create("UIScale", { Scale = 0.85, Parent = aj })
	end
	local al = {
		Holder = aj,
		ListLayout = ak,
		Toasts = {},
		Order = 0,
		MaxNotifications = math.clamp(math.floor(tonumber(ah) or 4), 1, 10),
	}
	local function fit()
		local am = ae.AbsoluteSize
		if am.X > 0 then
			local an = (al.Layout and al.Layout.Position.Y.Offset or 16)
			aj.Size = UDim2.new(0, math.min(i.NOTIFY_WIDTH, am.X - 24), 1, -(math.abs(an) + 16))
		end
	end
	table.insert(af, ae:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit))
	applyNotifyPosition(al, ai)
	fit()
	al.Fit = fit
	return al
end

local function toastKey(ae)
	return tostring(ae.Title) .. "\0" .. tostring(ae.Content) .. "\0" .. tostring(ae.Type)
end

local function showToast(ae, af)
	local ah = normalizeOptions(af, { Text = "Content", Message = "Content", Image = "Icon" })
	local ai = ah.Type == "Loading"

	if not ai and ah.Merge ~= false then
		local aj = toastKey(ah)
		for ak, al in ipairs(ae.Toasts) do
			if al._key == aj and not al._dismissed then
				al:_bump()
				return al
			end
		end
	end

	local aj = { _key = toastKey(ah) }
	ae.Order += 1
	local ak = ae.Layout
	local al = ak.Side ~= 0 and ak.Side * (i.NOTIFY_WIDTH + 24) or 0
	local am = ak.Side == 0 and (ak.Bottom and 30 or -30) or 0

	local an = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundTransparency = 1,
		LayoutOrder = ak.Bottom and ae.Order or -ae.Order,
		Parent = ae.Holder,
	})
	local ao = create("Frame", {
		Position = UDim2.fromOffset(al, am),
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = an,
	})
	local ap = create("ImageLabel", {
		Position = UDim2.fromOffset(-20, -20),
		Size = UDim2.new(1, 40, 1, 40),
		BackgroundTransparency = 1,
		Image = v.Shadow,
		ImageColor3 = Color3.new(0, 0, 0),
		ImageTransparency = 1,
		ScaleType = Enum.ScaleType.Slice,
		SliceCenter = Rect.new(49, 49, 450, 450),
		ZIndex = 0,
		Parent = ao,
	})
	local aq = create("CanvasGroup", {
		Name = "Toast",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = u.Background,
		BorderSizePixel = 0,
		GroupTransparency = 1,
		Parent = ao,
	})
	addCorner(aq, UDim.new(0, 8))
	local ar = addStroke(aq, u.Stroke)
	local as = ah.Timer == true

	local at = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = aq,
	})
	addPadding(at, 12, 12, 11, 12)
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		Parent = at,
	})

	local au = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = at,
	})

	local av = create("Frame", {
		Size = UDim2.fromOffset(16, 16),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = au,
	})
	local aw = create("ImageLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ScaleType = Enum.ScaleType.Fit,
		Parent = av,
	})

	local ax = create("Frame", {
		Position = UDim2.fromOffset(24, 0),
		Size = UDim2.new(1, -46, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = au,
	})
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 3),
		Parent = ax,
	})
	local ay = create("Frame", {
		Size = UDim2.new(1, 0, 0, 16),
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = ax,
	})
	local az = createLabel({
		Size = UDim2.new(1, -30, 1, 0),
		Text = "",
		TextSize = 13,
		TextColor3 = u.Text,
		Parent = ay,
	})
	local aA = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(0, 16),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Visible = false,
		Parent = ay,
	})
	local aB = createLabel({
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = "",
		TextSize = 12,
		FontFace = w.Regular,
		TextColor3 = u.Muted,
		TextTruncate = Enum.TextTruncate.None,
		Parent = aA,
	})
	local aC = createLabel({
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Text = "",
		TextSize = 12,
		FontFace = w.Regular,
		TextColor3 = u.Muted,
		TextWrapped = true,
		TextTruncate = Enum.TextTruncate.None,
		TextYAlignment = Enum.TextYAlignment.Top,
		LayoutOrder = 2,
		Parent = ax,
	})

	local aD = create("TextButton", {
		Name = "Dismiss",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 4, 0, -4),
		Size = UDim2.fromOffset(x and 30 or 22, x and 30 or 22),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Visible = x,
		Parent = au,
	})
	setIcon(create("ImageLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(13, 13),
		BackgroundTransparency = 1,
		ImageColor3 = u.Muted,
		ScaleType = Enum.ScaleType.Fit,
		Parent = aD,
	}), "x")

	local aE
	if type(ah.Buttons) == "table" and #ah.Buttons > 0 then
		aE = create("Frame", {
			Size = UDim2.new(1, 0, 0, x and 32 or 28),
			BackgroundTransparency = 1,
			LayoutOrder = 2,
			Parent = at,
		})
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 6),
			Parent = aE,
		})
	end

	local L = create("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 12, 1, -6),
		Size = UDim2.new(1, -24, 0, 2),
		BackgroundColor3 = u.Surface3,
		BorderSizePixel = 0,
		Parent = aq,
	})
	addCorner(L, UDim.new(1, 0))
	local M = create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = u.Accent,
		BorderSizePixel = 0,
		Parent = L,
	})
	addCorner(M, UDim.new(1, 0))

	local N, O, P = 4, 4, false
	local Q, R = false, false
	local S = false

	local function setDuration(T, U)
		if T == nil then
			if U then
				T = false
			else
				T = 4
			end
		end
		P = T == false or (type(T) == "number" and (T <= 0 or T == math.huge))
		N = type(T) == "number" and T > 0 and T ~= math.huge and T or 4
		O = N
		L.Visible = as and not P
		M.Size = UDim2.fromScale(1, 1)
	end

	local function paint(T)
		local U = T.Type
		local V = U == "Success" or U == "Warning" or U == "Error"
		local W = V and i.NOTIFY_TYPES[U] or nil
		local X = W and u[W] or (U == "Loading" and u.Muted) or u.Text
		aw.ImageColor3 = X
		M.BackgroundColor3 = u.Muted
		az.TextColor3 = u.Text

		local Y = T.Icon
		if Y == nil then
			Y = (U == "Loading" and "loader-circle") or (V and i.NOTIFY_ICONS[U]) or false
		end
		local Z = Y ~= false and setIcon(aw, Y)
		av.Visible = Z
		ax.Position = UDim2.fromOffset(Z and 24 or 0, 0)
		ax.Size = UDim2.new(1, Z and -46 or -22, 0, 0)
		S = U == "Loading" and Z
		if not S then
			aw.Rotation = 0
		end

		setTranslated(az, "Text", tostring(T.Title or "Notification"))
		local _ = T.Content
		aC.Visible = _ ~= nil and tostring(_) ~= ""
		setTranslated(aC, "Text", _ ~= nil and tostring(_) or "")
	end

	paint(ah)
	setDuration(ah.Duration, ai)

	if aE then
		for T, U in ipairs(ah.Buttons) do
			local V = U.Primary == true or U.Variant == "Primary"
			local W = create("TextButton", {
				Size = UDim2.fromOffset(0, x and 32 or 28),
				AutomaticSize = Enum.AutomaticSize.X,
				BackgroundColor3 = V and u.Accent or u.Surface2,
				Text = "",
				AutoButtonColor = false,
				LayoutOrder = T,
				Parent = aE,
			})
			addCorner(W, UDim.new(0, 6))
			if not V then
				addStroke(W)
			end
			addPadding(W, 12, 12)
			createLabel({
				Size = UDim2.new(0, 0, 1, 0),
				AutomaticSize = Enum.AutomaticSize.X,
				Text = tostring(U.Title or U.Name or "OK"),
				TextSize = 12,
				TextColor3 = V and u.AccentDark or u.Text,
				TextTruncate = Enum.TextTruncate.None,
				Parent = W,
			})
			W.MouseButton1Click:Connect(function()
				runProtected(('notification button "%s"'):format(tostring(U.Title or U.Name or "Button")), U.Callback)
				if U.Close ~= false then
					aj:Dismiss()
				end
			end)
		end
	end

	if ah.Sound then
		pcall(function()
			local T = Instance.new("Sound")
			T.SoundId = tostring(ah.Sound)
			T.Volume = tonumber(ah.Volume) or 0.5
			T.Parent = ae.Holder
			T:Play()
			task.delay(5, function()
				T:Destroy()
			end)
		end)
	end

	local T = 1
	local U = {}
	aj._dismissed = false

	function aj:Dismiss(V)
		if aj._dismissed then
			return
		end
		aj._dismissed = true
		local W = table.find(ae.Toasts, aj)
		if W then
			table.remove(ae.Toasts, W)
		end
		for X, Y in ipairs(U) do
			Y:Disconnect()
		end
		if instantUI() then
			an:Destroy()
			safeCall(ah.OnClose)
			return
		end
		local X = V or (ak.Side ~= 0 and ak.Side * (i.NOTIFY_WIDTH + 24) or 0)
		tween(ao, { Position = UDim2.fromOffset(X, am) }, 0.3, Enum.EasingStyle.Quint)
		tween(aq, { GroupTransparency = 1 }, 0.2)
		tween(ar, { Transparency = 1 }, 0.15)
		tween(ap, { ImageTransparency = 1 }, 0.2)
		task.delay(0.22, function()
			if not an.Parent then
				return
			end
			an.ClipsDescendants = true
			tween(an, { Size = UDim2.new(1, 0, 0, 0) }, 0.22, Enum.EasingStyle.Quint)
			task.delay(0.24, function()
				an:Destroy()
			end)
		end)
		safeCall(ah.OnClose)
	end

	function aj:Update(V)
		if aj._dismissed or type(V) ~= "table" then
			return
		end
		for W, X in pairs(V) do
			ah[W] = X
		end
		paint(ah)
		if V.Duration ~= nil or V.Type ~= nil then
			setDuration(ah.Duration, ah.Type == "Loading")
		end
		aj._key = toastKey(ah)
	end

	function aj:SetProgress(V)
		L.Visible = true
		P = true
		M.Size = UDim2.fromScale(math.clamp(tonumber(V) or 0, 0, 1), 1)
	end

	function aj:_bump()
		T += 1
		aA.Visible = true
		aB.Text = "×" .. T
		O = N
	end

	aj.Close = aj.Dismiss

	local V = { aq, aD }
	for W, X in ipairs(V) do
		X.MouseEnter:Connect(function()
			if x then
				return
			end
			Q = true
			aD.Visible = true
		end)
		X.MouseLeave:Connect(function()
			Q = false
			if not x and X == aq then
				aD.Visible = false
			end
		end)
	end
	aD.MouseButton1Click:Connect(function()
		aj:Dismiss()
	end)

	local W, X, Y = nil, false, false
	aq.InputBegan:Connect(function(Z)
		if isPress(Z) then
			W = getMousePosition()
			X, Y, R = true, false, true
		end
	end)
	table.insert(U, b.InputChanged:Connect(function(Z)
		if not X or not isMove(Z) then
			return
		end
		local _ = getMousePosition().X - W.X
		if math.abs(_) > 6 then
			Y = true
		end
		if Y then
			ao.Position = UDim2.fromOffset(_, 0)
			if aq:IsA("CanvasGroup") then
				aq.GroupTransparency = math.clamp(math.abs(_) / 220, 0, 0.6)
			end
		end
	end))
	table.insert(U, b.InputEnded:Connect(function(Z)
		if not X or not isPress(Z) then
			return
		end
		X, R = false, false
		local _ = getMousePosition().X - W.X
		if Y and math.abs(_) > 70 then
			aj:Dismiss((_ > 0 and 1 or -1) * (i.NOTIFY_WIDTH + 40))
		elseif Y then
			tween(ao, { Position = UDim2.fromOffset(0, 0) }, 0.25, Enum.EasingStyle.Quint)
			tween(aq, { GroupTransparency = 0 }, 0.2)
		elseif type(ah.Callback) == "function" then
			runProtected(('notification "%s"'):format(tostring(ah.Title or "")), ah.Callback)
			aj:Dismiss()
		end
	end))

	task.defer(function()
		if an.Parent then
			tween(an, { Size = UDim2.new(1, 0, 0, aq.AbsoluteSize.Y) }, 0.3, Enum.EasingStyle.Quint)
		end
	end)
	local Z = false
	task.delay(0.32, function()
		Z = true
		if an.Parent and not aj._dismissed then
			an.Size = UDim2.new(1, 0, 0, aq.AbsoluteSize.Y)
		end
	end)
	aq:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if Z and an.Parent and not aj._dismissed then
			an.Size = UDim2.new(1, 0, 0, aq.AbsoluteSize.Y)
		end
	end)

	tween(ao, { Position = UDim2.fromOffset(0, 0) }, 0.45, Enum.EasingStyle.Quint)
	tween(aq, { GroupTransparency = 0 }, 0.3)
	tween(ap, { ImageTransparency = 0.75 }, 0.4)

	task.spawn(function()
		while an.Parent and not aj._dismissed do
			local _ = task.wait(0.05) or 0.05
			if S then
				aw.Rotation = (aw.Rotation + _ * 360) % 360
			end
			if not P and not Q and not R then
				O -= _
				M.Size = UDim2.fromScale(math.clamp(O / N, 0, 1), 1)
				if O <= 0 then
					aj:Dismiss()
				end
			end
		end
	end)

	table.insert(ae.Toasts, aj)
	while #ae.Toasts > ae.MaxNotifications do
		local _ = ae.Toasts[1]
		_:Dismiss()
		if ae.Toasts[1] == _ then
			table.remove(ae.Toasts, 1)
		end
	end

	return aj
end

function aa:Notify(ae)
	local af = { Time = os.time() }
	if type(ae) == "table" then
		af.Title = tostring(ae.Title or ae.Name or "")
		af.Content = tostring(ae.Content or ae.Text or ae.Message or "")
		af.Type = ae.Type
	else
		af.Title = tostring(ae or "")
		af.Content = ""
	end
	self._notifyHistory = self._notifyHistory or {}
	table.insert(self._notifyHistory, 1, af)
	if #self._notifyHistory > 50 then
		table.remove(self._notifyHistory)
	end
	return showToast(self._notifyHost, ae)
end

function aa:SetNotificationPosition(ae)
	applyNotifyPosition(self._notifyHost, ae)
	self._notifyHost.Fit()
end

local ae
function h:_notifyFallback(af)
	if not ae or not ae.Holder.Parent then
		local ah = create("ScreenGui", {
			Name = i.GUI_NAME .. "Notifications",
			IgnoreGuiInset = true,
			ResetOnSpawn = false,
			DisplayOrder = 1000,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
			Parent = getGuiParent(),
		})
		ae = A(ah, {}, 4, h.NotificationPosition)
		table.insert(h._cleanup, function()
			ae = nil
			ah:Destroy()
		end)
	end
	return showToast(ae, af)
end

h._showErrorToast = function(af)
	local ah = af.Where or "a callback"
	h:Notify({
		Title = "Script error",
		Content = ("In %s: %s"):format(ah, af.Summary or af.Message or "unknown error"),
		Type = "Error",
		Duration = 8,
		Buttons = {
			{
				Title = "Copy details",
				Callback = function()
					h:Copy(("Nucleus UI %s\nWhere: %s\nError: %s\n%s"):format(
						h.Version, ah, tostring(af.Raw), tostring(af.Traceback or "")))
				end,
			},
		},
	})
end

function aa:Destroy()
	if self._destroyed then
		return
	end
	if self._resetOnUnload then
		self._autoSaveEnabled = false
		for af, ah in ipairs(table.clone(self._elements)) do
			if ah._type == "Toggle" and ah.Value == true and not ah._destroyed then
				pcall(ah.Set, ah, false)
			end
		end
	end
	self._destroyed = true
	for af, ah in ipairs(self._loops) do
		ah.Running = false
	end
	for af, ah in ipairs(self._events.Destroy) do
		task.spawn(safeCall, ah)
	end

	local af = table.find(h.Windows, self)
	if af then
		table.remove(h.Windows, af)
	end

	for ah, ai in ipairs(self._connections) do
		ai:Disconnect()
	end
	self._connections = {}

	for ah, ai in pairs(self._inputListeners) do
		table.clear(ai)
	end
	table.clear(self._frameSteps)

	for ah, ai in pairs(self.Flags) do
		if h.Flags[ah] == ai then
			h.Flags[ah] = nil
		end
	end
	self.Flags = {}

	tween(self.Scale, { Scale = 0.9 }, 0.2)
	self:_fadeOut(0.2)
	tween(self.BodyStroke, { Transparency = 1 }, 0.12)
	tween(self.Shadow, { ImageTransparency = 1 }, 0.2)
	task.delay(0.22, function()
		self.Gui:Destroy()
	end)
end
local function installFeatures()

i.ATTR_LOC_TEXT = "NucleusLocText"
i.ATTR_LOC_PLACEHOLDER = "NucleusLocPlaceholderText"

function h:SetLocalization(af)
	af = type(af) == "table" and af or {}
	if type(af.Prefix) == "string" then
		B.Prefix = af.Prefix
	end
	if type(af.Default) == "string" then
		B.Default = af.Default
	end
	if type(af.Translations) == "table" then
		for ah, ai in pairs(af.Translations) do
			B.Translations[ah] = B.Translations[ah] or {}
			for aj, ak in pairs(ai) do
				B.Translations[ah][aj] = ak
			end
		end
	end
	h:SetLanguage(af.Language or B.Language)
end

function h:SetLanguage(af)
	B.Language = tostring(af or B.Default)
	local ah = B.Prefix
	for ai, aj in ipairs(h.Windows) do
		if aj.Gui then
			for ak, al in ipairs(aj.Gui:GetDescendants()) do
				local am = al:GetAttribute(i.ATTR_LOC_TEXT)
				if am then
					setTranslated(al, "Text", ah .. am)
				end
				local an = al:GetAttribute(i.ATTR_LOC_PLACEHOLDER)
				if an then
					setTranslated(al, "PlaceholderText", ah .. an)
				end
			end
		end
	end
end

function h:GetLanguage()
	return B.Language
end

function h:Translate(af)
	return (translate(B.Prefix .. tostring(af)))
end

function aa:OnOpen(af)
	table.insert(self._events.Open, af)
end

function aa:OnClose(af)
	table.insert(self._events.Close, af)
end

function aa:OnDestroy(af)
	table.insert(self._events.Destroy, af)
end

function aa:Show()
	self:Toggle(true)
end

function aa:Hide()
	self:Toggle(false)
end

aa.SetToggleKey = aa.SetKeybind

function aa:SetSize(af)
	local ah = h._toVector2(af)
	if not ah then
		return
	end
	af = UDim2.fromOffset(math.max(ah.X, 300), math.max(ah.Y, 220))
	self._baseSize = Vector2.new(af.X.Offset, af.Y.Offset)
	tween(self.Root, { Size = af }, 0.25, Enum.EasingStyle.Quint)
	task.delay(0.26, function()
		if not self._destroyed then
			self:_fitToScreen()
			self:_clampToScreen()
		end
	end)
end

function aa:SetResizable(af)
	if self._grip then
		self._grip.Visible = af ~= false
	end
end

function aa:GetElements()
	local af = {}
	for ah, ai in ipairs(self._elements) do
		if not ai._destroyed then
			table.insert(af, ai)
		end
	end
	return af
end

function aa:GetLockedElements()
	local af = {}
	for ah, ai in ipairs(self:GetElements()) do
		if ai.Locked then
			table.insert(af, ai)
		end
	end
	return af
end

function aa:LockAll(af)
	for ah, ai in ipairs(self:GetElements()) do
		if type(ai.SetLocked) == "function" and ai._type ~= "Section" and ai._type ~= "Divider" then
			ai:SetLocked(true, af)
		end
	end
end

function aa:UnlockAll()
	for af, ah in ipairs(self:GetElements()) do
		if ah.Locked and type(ah.SetLocked) == "function" then
			ah:SetLocked(false)
		end
	end
end

function aa:SetAnonymous(af)
	self._anonymous = af == true
	if self._profileName then
		self._profileName.Text = self._anonymous and "Anonymous" or g.DisplayName
	end
	if self._avatar then
		self._avatar.Image = (not self._anonymous and self._avatarImage) or ""
	end
end

function aa:SetBackground(af, ah)
	if not self._background then
		self._background = create("ImageLabel", {
			Name = "Background",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			ScaleType = Enum.ScaleType.Crop,
			ImageTransparency = 1,
			ZIndex = 0,
			Parent = self.Body,
		})
		addCorner(self._background, UDim.new(0, C.WindowRadius))
		self._background:SetAttribute(i.ATTR_NO_THEME, true)
	end
	if af == nil or af == false or af == "" then
		self._background.Image = ""
		return
	end
	setIcon(self._background, af)
	self._background.ImageTransparency = tonumber(ah) or 0.85
end

function aa:TabSection(af)
	local ah = normalizeOptions(af, { Name = "Title" })
	self._sectionCount += 1
	local ai = {
		Title = ah.Title or "Section",
		Tabs = {},
		Opened = ah.Opened ~= false,
		Window = self,
		_base = self._sectionCount * 1000,
		_count = 0,
	}

	local aj = create("TextButton", {
		Name = "TabSection",
		Size = UDim2.new(1, 0, 0, 38),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = ai._base,
		Parent = self.TabList,
	})
	local ak = create("Frame", {
		Position = UDim2.fromOffset(0, 12),
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundTransparency = 1,
		Parent = aj,
	})
	local al = 12
	if ah.Icon then
		createIcon(ak, ah.Icon, u.Muted, UDim2.new(0, 12, 0.5, 0))
		al = 36
	end
	local am = createLabel({
		Name = "Title",
		Position = UDim2.fromOffset(al, 0),
		Size = UDim2.new(1, -(al + 24), 1, 0),
		Text = ai.Title,
		TextSize = 12,
		FontFace = w.Bold,
		TextColor3 = u.Muted,
		Parent = ak,
	})
	local an = createChevron(ak, 1, -4)
	local ao = createLabel({
		Name = "Count",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -28, 0.5, 0),
		Size = UDim2.fromOffset(28, 18),
		Text = "",
		TextSize = 11,
		FontFace = w.Bold,
		TextColor3 = u.Muted,
		TextXAlignment = Enum.TextXAlignment.Right,
		Visible = false,
		Parent = ak,
	})
	am.Size = UDim2.new(1, -(al + 58), 1, 0)

	function ai:_refreshCount()
		local ap = #ai.Tabs
		ao.Text = tostring(ap)
		ao.Visible = not ai.Opened and ap > 0
	end
	ai._header = aj

	local function refreshIndicator()
		local ap = self.CurrentTab
		if ap and not self._destroyed then
			self:_placeIndicator(ap)
		end
	end

	function ai:SetOpen(ap)
		ai.Opened = ap == true
		an:Set(ai.Opened)
		for aq, ar in ipairs(ai.Tabs) do
			local as = ai.Opened and not ar._userHidden
			ar._button:SetAttribute(i.ATTR_HIDDEN, not as)
			if self.Window._introDone then
				ar._button.Visible = as
			end
		end
		ai:_refreshCount()
		refreshIndicator()
	end

	function ai:Toggle()
		ai:SetOpen(not ai.Opened)
	end

	function ai:SetTitle(ap)
		ai.Title = tostring(ap)
		setTranslated(am, "Text", ai.Title)
	end

	function ai:Tab(ap, aq)
		local ar = normalizeOptions(ap, { Title = "Name", Description = "Desc" })
		ar.Section = ai
		return self.Window:Tab(ar, aq)
	end
	ai.CreateTab = ai.Tab

	aj.MouseButton1Click:Connect(function()
		ai:Toggle()
	end)

	function ai:_applyCompact(ap)
		aj.Visible = not ap
		if ap then
			for aq, ar in ipairs(ai.Tabs) do
				ar._button:SetAttribute(i.ATTR_HIDDEN, ar._userHidden == true)
				if ai.Window._introDone then
					ar._button.Visible = not ar._userHidden
				end
			end
		else
			ai:SetOpen(ai.Opened)
		end
	end

	an:Set(ai.Opened)
	self._sections = self._sections or {}
	table.insert(self._sections, ai)
	if self._compact then
		ai:_applyCompact(true)
	end
	self._currentSection = ai
	return ai
end
aa.CreateTabSection = aa.TabSection

function aa:_headerRow()
	if self._headerItems then
		return self._headerItems
	end
	local af = create("Frame", {
		Name = "HeaderItems",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, self._minimizeButton and -94 or -56, 0, 18),
		Size = UDim2.fromOffset(0, 24),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = self.Content,
	})
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6),
		Parent = af,
	})
	self._headerItems = af
	self._headerOrder = 0
	if self._layoutHeader then
		self:_layoutHeader()
	end
	return af
end

function aa:Tag(af)
	local ah = normalizeOptions(af, { Name = "Title", Text = "Title" })
	local ai = self:_headerRow()
	self._headerOrder += 1

	local aj = ah.Color or u.Accent
	local ak = create("Frame", {
		Size = UDim2.fromOffset(0, 22),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = aj,
		BackgroundTransparency = 0.86,
		BorderSizePixel = 0,
		LayoutOrder = self._headerOrder,
		ZIndex = 5,
		Parent = ai,
	})
	addCorner(ak, UDim.new(0, math.clamp(tonumber(ah.Radius) or 11, 0, 11)))
	local al = addStroke(ak, aj, 0.55)
	addPadding(ak, 8, 9)
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 5),
		Parent = ak,
	})
	local am
	if ah.Icon then
		am = create("ImageLabel", {
			Size = UDim2.fromOffset(12, 12),
			BackgroundTransparency = 1,
			ImageColor3 = aj,
			ScaleType = Enum.ScaleType.Fit,
			LayoutOrder = 1,
			ZIndex = 6,
			Parent = ak,
		})
		if not setIcon(am, ah.Icon) then
			am:Destroy()
			am = nil
		end
	end
	local an = createLabel({
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = tostring(ah.Title or "Tag"),
		TextSize = 12,
		FontFace = w.Bold,
		TextColor3 = aj,
		TextTruncate = Enum.TextTruncate.None,
		LayoutOrder = 2,
		ZIndex = 6,
		Parent = ak,
	})

	local ao = { Frame = ak }
	function ao:SetTitle(ap)
		setTranslated(an, "Text", tostring(ap))
	end
	function ao:SetColor(ap)
		ak.BackgroundColor3 = ap
		al.Color = ap
		an.TextColor3 = ap
		if am then
			am.ImageColor3 = ap
		end
	end
	function ao:Destroy()
		ak:Destroy()
	end
	return ao
end

function aa:HeaderButton(af)
	local ah = normalizeOptions(af, {})
	local ai = self:_headerRow()
	self._headerOrder += 1

	local aj = create("TextButton", {
		Size = UDim2.fromOffset(26, 26),
		BackgroundColor3 = u.Surface2,
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = self._headerOrder,
		ZIndex = 5,
		Parent = ai,
	})
	addCorner(aj, UDim.new(0, 7))
	local ak = create("ImageLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(15, 15),
		BackgroundTransparency = 1,
		ImageColor3 = u.Muted,
		ScaleType = Enum.ScaleType.Fit,
		ZIndex = 6,
		Parent = aj,
	})
	setIcon(ak, ah.Icon or "circle")

	aj.MouseEnter:Connect(function()
		if x then
			return
		end
		tween(aj, { BackgroundTransparency = 0 }, 0.15)
		tween(ak, { ImageColor3 = u.Text }, 0.15)
		if ah.Tooltip then
			self:_showTooltip(ah.Tooltip, aj)
		end
	end)
	aj.MouseLeave:Connect(function()
		tween(aj, { BackgroundTransparency = 1 }, 0.2)
		tween(ak, { ImageColor3 = u.Muted }, 0.2)
		self:_hideTooltip(aj)
	end)
	aj.MouseButton1Click:Connect(function()
		runProtected(('header button "%s"'):format(tostring(ah.Tooltip or ah.Icon or "button")), ah.Callback)
	end)

	local al = { Frame = aj }
	function al:SetIcon(am)
		setIcon(ak, am)
	end
	function al:Destroy()
		aj:Destroy()
	end
	return al
end
