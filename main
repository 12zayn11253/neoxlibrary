local function getTopbarInset()
	local ok, inset = pcall(function()
		return GuiService.TopbarInset
	end)
	if ok and typeof(inset) == "Rect" and inset.Height > 0 then
		return inset
	end
	return nil
end

local function getTopbarHeight()
	local inset = getTopbarInset()
	if inset then
		return inset.Max.Y
	end
	local ok, guiInset = pcall(function()
		return GuiService:GetGuiInset()
	end)
	return ok and typeof(guiInset) == "Vector2" and guiInset.Y or 36
end

local function toVector2(value)
	if typeof(value) == "Vector2" then
		return value
	elseif typeof(value) == "UDim2" then
		return Vector2.new(value.X.Offset, value.Y.Offset)
	elseif type(value) == "table" then
		local x, y = tonumber(value[1] or value.X), tonumber(value[2] or value.Y)
		if x and y then
			return Vector2.new(x, y)
		end
	end
	return nil
end
Nucleus._toVector2 = toVector2

function Nucleus.Window(selfOrOptions, maybeOptions)

	local input = maybeOptions
	if selfOrOptions ~= Nucleus and maybeOptions == nil then
		input = selfOrOptions
	end

	local options = normalizeOptions(input, {
		Name = "Title",
		LoadingSubtitle = "Subtitle",
		Author = "Subtitle",
		ToggleUIKeybind = "Keybind",
		ToggleKey = "Keybind",
	})
	if options.HideSearchBar == true and options.Search == nil then
		options.Search = false
	end
	local sidebarWidth = options.SidebarWidth or options.SideBarWidth
	if sidebarWidth ~= nil then
		options.Appearance = type(options.Appearance) == "table" and table.clone(options.Appearance) or {}
		if options.Appearance.SidebarWidth == nil then
			options.Appearance.SidebarWidth = sidebarWidth
		end
	end
	if type(options.Folder) == "string" and options.ConfigurationSaving == nil then
		options.ConfigurationSaving = { Enabled = true, FolderName = options.Folder }
	end

	if options.Theme ~= nil then
		Nucleus:SetTheme(options.Theme)
	end
	if type(options.Localization) == "table" then
		Nucleus:SetLocalization(options.Localization)
	end
	if options.ErrorNotifications ~= nil then
		Nucleus.ErrorNotifications = options.ErrorNotifications ~= false
	end
	if tonumber(options.TextScale) then
		Nucleus.TextScale = math.clamp(tonumber(options.TextScale), 0.7, 1.3)
	end
	applyAppearance(options.Appearance)
	do
		local home = type(options.Home) == "table" and options.Home or {}
		local keyOptions = type(options.Membership) == "table" and options.Membership or (type(home.Key) == "table" and home.Key) or {}
		if type(keyOptions.Data) == "function" then
			Nucleus._keySource = keyOptions.Data
			Nucleus._keySourceWarned = false
		end
	end

	local toggleKey = toKeyCode(options.Keybind) or Enum.KeyCode.RightControl

	local window = setmetatable({
		Tabs = {},
		Flags = {},
		CurrentTab = nil,
		Open = true,
		Keybind = toggleKey,
		_connections = {},
		_controls = {},
		_inputListeners = {
			Began = {},
			Changed = {},
			Ended = {},
			Render = {},
		},
		_frameSteps = {},
		_destroyed = false,
		_elements = {},
		_dependents = {},
		_loops = {},
		_resetOnUnload = options.ResetOnUnload == true,
		_events = { Open = {}, Close = {}, Destroy = {} },
		_sidebarCollapsed = options.SidebarCollapsed == true,
		_looseTabOrder = 0,
		_sectionCount = 0,
		_searchIndex = {},
		_keybinds = {},
		_overlays = {},
		_userScale = math.clamp(tonumber(options.Scale) or 1, 0.5, 1.5),
		_sidebarWidth = Appearance.SidebarWidth,
		_socialsOptions = options.Socials,
		_donationOptions = options.Donations,
	}, Window)

	local function dispatcher(kind)
		return function(...)

			for _, listener in ipairs(table.clone(window._inputListeners[kind])) do
				listener(...)
			end
		end
	end

	local dispatchRender = dispatcher("Render")
	table.insert(window._connections, RunService.RenderStepped:Connect(function(deltaTime)
		dispatchRender(deltaTime)
		for _, frameStep in ipairs(window._frameSteps) do
			frameStep(deltaTime)
		end
	end))
	table.insert(window._connections, UserInputService.InputBegan:Connect(dispatcher("Began")))
	table.insert(window._connections, UserInputService.InputChanged:Connect(dispatcher("Changed")))
	table.insert(window._connections, UserInputService.InputEnded:Connect(dispatcher("Ended")))

	local screenGui = create("ScreenGui", {
