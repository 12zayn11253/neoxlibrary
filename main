	ai._tooltipLabel = S
	table.insert(ai._frameSteps, function()
		if not R.Visible then
			return
		end
		local T = getMousePosition() - ak.AbsolutePosition
		local U = ak.AbsoluteSize
		local V = math.min(T.X + 14, U.X - R.AbsoluteSize.X - 8)
		local W = T.Y + 18
		if W + R.AbsoluteSize.Y > U.Y - 8 then
			W = T.Y - R.AbsoluteSize.Y - 8
		end
		R.Position = UDim2.fromOffset(math.max(V, 8), math.max(W, 8))
	end)

