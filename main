		ai:ToggleSidebar()
	end)

	local function headerIconButton(Q, R, S)
		local T = create("TextButton", {
			Name = Q,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, S, 0, 13),
			Size = UDim2.fromOffset(34, 34),
			BackgroundColor3 = u.Surface2,
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			ZIndex = 5,
