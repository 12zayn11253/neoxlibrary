	return create("UIPadding", {
		PaddingLeft = UDim.new(0, E or 0),
		PaddingRight = UDim.new(0, F or 0),
		PaddingTop = UDim.new(0, G or 0),
		PaddingBottom = UDim.new(0, H or 0),
		Parent = D,
	})
end

local function createLabel(D)
	local E = {
		BackgroundTransparency = 1,
		TextColor3 = u.Text,
		TextSize = 14,
		FontFace = w.Medium,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}
	for F, G in pairs(D) do
		E[F] = G
	end
	return create("TextLabel", E)
end

local function addInnerShadow(D, E, F)
	local G = create("Frame", {
		Name = "InnerShadow",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		ZIndex = 0,
		Parent = D,
	})
	G:SetAttribute(i.ATTR_NO_THEME, true)
	local H = D:FindFirstChildOfClass("UICorner")
	if H then
		addCorner(G, H.CornerRadius)
	end
	create("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, E or 0.55),
			NumberSequenceKeypoint.new(F or 0.5, 1),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = G,
	})
	return G
end

local function addScrollFades(D, E, F)
	F = F or 18
	local G = create("Frame", {
		Name = "ScrollFades",
		Position = D.Position,
		Size = D.Size,
		BackgroundTransparency = 1,
		ZIndex = (D.ZIndex or 1) + 5,
		Parent = D.Parent,
	})
	local function makeFade(H)
		local I = create("Frame", {
			AnchorPoint = Vector2.new(0, H and 0 or 1),
			Position = H and UDim2.new() or UDim2.fromScale(0, 1),
			Size = UDim2.new(1, 0, 0, F),
			BackgroundColor3 = u[E],
			BorderSizePixel = 0,
			Visible = false,
			ZIndex = G.ZIndex,
			Parent = G,
		})
		create("UIGradient", {
			Rotation = H and 90 or 270,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = I,
		})
		return I
	end
	local H, I = makeFade(true), makeFade(false)
	local function update()
		local J, K, L = D.AbsoluteCanvasSize, D.AbsoluteWindowSize, D.CanvasPosition
		if not (J and K and L) then
			return
		end
		local M = L.Y
		local N = K.Y
		local O = J.Y
		H.Visible = M > 2
		I.Visible = O - N - M > 2
	end
	local function sync()
		G.Position = D.Position
		G.Size = D.Size
		G.Visible = D.Visible
	end
	for J, K in ipairs({ "CanvasPosition", "AbsoluteCanvasSize", "AbsoluteWindowSize" }) do
		D:GetPropertyChangedSignal(K):Connect(update)
	end
	for J, K in ipairs({ "Position", "Size", "Visible" }) do
		D:GetPropertyChangedSignal(K):Connect(sync)
	end
	task.defer(update)
	return G
end

