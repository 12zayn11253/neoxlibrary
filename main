local q = {
	Regular = { 400, Enum.FontWeight.Regular },
	Medium = { 500, Enum.FontWeight.Medium },
	SemiBold = { 600, Enum.FontWeight.SemiBold },
	Bold = { 700, Enum.FontWeight.Bold },
}

function h:SetFont(r)
	local s
	if typeof(r) == "EnumItem" then
		local t, u = pcall(Font.fromEnum, r)
		s = t and u and u.Family or nil
	elseif type(r) == "string" and r ~= "" then
		if r:find("^rbxasset") then
			s = r
		else
			s = "rbxasset://fonts/families/" .. r:gsub("%s", "") .. ".json"
		end
	end
	if not s then
		log("SetFont needs a font name like \"Montserrat\" or an Enum.Font")
		return false
	end
	local t = h.Fonts
	t.Regular = Font.new(s, i.TEXT_WEIGHTS.Regular)
	t.Medium = Font.new(s, i.TEXT_WEIGHTS.Medium)
	t.Bold = Font.new(s, i.TEXT_WEIGHTS.Bold)
	return true
end

function h:LoadFont(r)
	r = normalizeOptions(r, {})
	if type(writefile) ~= "function" or type(isfile) ~= "function" or type(getcustomasset) ~= "function" then
		log("custom fonts need writefile, isfile and getcustomasset")
		return false
	end

	local s = r.Name or "CustomFont"
	local t = r.Weights or p[s]
	if type(t) ~= "table" then
		log("no font weights for " .. s)
		return false
	end

	local u = r.Folder or i.FONT_FOLDER
	pcall(function()
		if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder(u) then
			makefolder(u)
		end
	end)

	local v = {}
	local w = {}
	for x, y in pairs(t) do
		local z = q[x]
		if z then
			local A = u .. "/" .. s .. "-" .. x .. ".ttf"
			local B = true
			if not isfile(A) then
				B = pcall(function()
					writefile(A, game:HttpGet(y))
				end)
			end
			local C, D = false, nil
			if B then
				C, D = pcall(getcustomasset, A)
			end
			if B and C and D then
				w[x] = true
				table.insert(v, {
					name = x,
					weight = z[1],
					style = "normal",
					assetId = D,
				})
			else
				log("could not download the " .. x .. " weight of " .. s)
			end
		end
	end

	if #v == 0 then
		return false
	end

	local x = u .. "/" .. s .. ".json"
	local y = pcall(function()
		writefile(x, e:JSONEncode({ name = s, faces = v }))
	end)
	if not y then
		return false
	end

	local z, A = pcall(getcustomasset, x)
	if not z or not A then
		return false
	end

	local function fontFor(B, C)
		local D = q[B]
		if D and w[B] then
			return Font.new(A, D[2])
		end
		return C
	end

	local B = h.Fonts
	B.Regular = fontFor("Regular", B.Regular)
	B.Medium = fontFor("Medium", fontFor("Regular", B.Medium))
	B.Bold = fontFor("SemiBold", fontFor("Bold", B.Bold))
	return true
end

i.ICON_PACK_URL = "https://raw.githubusercontent.com/Footagesus/Icons/refs/heads/main/lucide/dist/Icons.lua"
local r

local s = false

local function getIconPack()
	if r ~= nil then
		return r
	end
	if s then
		local t = 0
		while r == nil and t < 15 do
			t += task.wait(0.05)
		end
		return r or false
	end
	s = true
	local t, u = pcall(function()
		return loadstring(game:HttpGet(i.ICON_PACK_URL))()
	end)
	if t and type(u) == "table" then
		r = u
	else
		r = false
		log("lucide icons unavailable: " .. tostring(u))
	end
	s = false
	return r
end
task.spawn(getIconPack)

function h:PreloadIcons()
	return getIconPack() ~= false
end

