		})
		addCorner(T, UDim.new(0, 8))
		local U = create("ImageLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(17, 17),
			BackgroundTransparency = 1,
			ImageColor3 = u.Muted,
			ScaleType = Enum.ScaleType.Fit,
			ZIndex = 6,
			Parent = T,
		})
		setIcon(U, R)
		T.MouseEnter:Connect(function()
			if x then
				return
			end
			tween(T, { BackgroundTransparency = 0 }, 0.15)
			tween(U, { ImageColor3 = u.Text }, 0.15)
		end)
		T.MouseLeave:Connect(function()
			tween(T, { BackgroundTransparency = 1 }, 0.2)
			tween(U, { ImageColor3 = u.Muted }, 0.2)
		end)
		return T
	end

	local Q = headerIconButton("Close", "x", -14)
	Q.MouseButton1Click:Connect(function()
		ai:RequestClose()
	end)
	ai._closeButton = Q

	if ae.MinimizeButton ~= false then
		local R = headerIconButton("Minimize", "minus", -52)
		R:SetAttribute(i.ATTR_NO_DRAG, true)
		R.MouseButton1Click:Connect(function()
