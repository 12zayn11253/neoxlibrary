			})
			local tile = create("Frame", {
				Size = UDim2.fromOffset(44, 44),
				BackgroundColor3 = Theme.Surface2,
				BorderSizePixel = 0,
				Parent = header,
			})
			addCorner(tile, UDim.new(0, 12))
			addStroke(tile)
