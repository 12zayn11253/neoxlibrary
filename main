local y = {}
local z = setmetatable({}, { __mode = "k" })

local function fadeGroup(A, B, C)
	local D = z[A]
	if not D then
		D = { Value = 0, Bases = setmetatable({}, { __mode = "k" }) }
		z[A] = D
	end
	local E = D.Value
	D.Value = B
	local F
	local function apply(G, H)
		local I = D.Bases[G]
		if not I then
			I = {}
			D.Bases[G] = I
		end
		local J = I[H]
		if J == nil then
			J = G[H]
			if type(J) ~= "number" then
				return
			end
			I[H] = J
			G[H] = J + (1 - J) * E
		end
		local K = J + (1 - J) * B
		if C then
			F = a:Create(G, C, { [H] = K })
			F:Play()
		else
			G[H] = K
		end
	end
	local function visit(G)
		if G:IsA("TextLabel") or G:IsA("TextButton") or G:IsA("TextBox") then
			apply(G, "TextTransparency")
		elseif G:IsA("ImageLabel") or G:IsA("ImageButton") then
			apply(G, "ImageTransparency")
		end
		if G:IsA("UIStroke") then
			apply(G, "Transparency")
		elseif G:IsA("GuiObject") then
			apply(G, "BackgroundTransparency")
		end
	end
	visit(A)
	for G, H in ipairs(A:GetDescendants()) do
		visit(H)
	end
	return F
end

local function tween(A, B, C, D, E)
	C = C or 0.2
	if instantUI() then
		C = 0
	end
	if not x and B.GroupTransparency ~= nil and z[A] then
		local F = table.clone(B)
		F.GroupTransparency = nil
		local G
		if C > 0 then
			G = TweenInfo.new(C, D or Enum.EasingStyle.Quart, E or Enum.EasingDirection.Out)
		end
		local H = fadeGroup(A, B.GroupTransparency, G)
		if next(F) then
			return tween(A, F, C, D, E) or H
		end
		return H
	end
	if C <= 0 then
		for F, G in pairs(B) do
			if F ~= "GroupTransparency" or A:IsA("CanvasGroup") then
				A[F] = G
			elseif A:IsA("GuiObject") then
				A.Visible = G < 1
			end
		end
		return nil
	end
	D = D or Enum.EasingStyle.Quart
	E = E or Enum.EasingDirection.Out

	local F = C .. D.Name .. E.Name
	local G = y[F]
	if not G then
		G = TweenInfo.new(C, D, E)
		y[F] = G
	end

	local H = a:Create(A, G, B)
	H:Play()
	return H
end

h.TextScale = 0.9
h.NotificationPosition = nil
local A
h._themeListeners = {}
h._cleanup = {}

local B = {
	Prefix = "loc:",
	Default = "en",
	Language = "en",
	Translations = {},
}
h._localization = B

local function translate(C)
	if type(C) ~= "string" then
		return C, nil
	end
	local D = B.Prefix
	if D == "" or C:sub(1, #D) ~= D then
		return C, nil
	end
	local E = C:sub(#D + 1)
	local F = B.Translations[B.Language] or {}
	local G = B.Translations[B.Default] or {}
	return F[E] or G[E] or E, E
end

i.TRANSLATED_PROPERTIES = { Text = true, PlaceholderText = true }

local function setTranslated(C, D, E)
	local F, G = translate(E)
	C[D] = F
	C:SetAttribute("NucleusLoc" .. D, G)
end

local function create(C, D, E)
	local F = C == "CanvasGroup" and (x or not i.REAL_GROUPS[D.Name or ""])
	local G = Instance.new(F and "Frame" or C)
	if F and not x then
		z[G] = { Value = D.GroupTransparency or 0, Bases = setmetatable({}, { __mode = "k" }) }
	end
	for H, I in pairs(D) do
		if F and H == "GroupTransparency" then
			continue
		elseif H == "TextSize" then
			G.TextSize = math.max(i.MIN_TEXT_SIZE, math.floor(I * (h.TextScale or 1) + 0.5))
		elseif i.TRANSLATED_PROPERTIES[H] and type(I) == "string" then
			setTranslated(G, H, I)
		elseif H ~= "Parent" then
			G[H] = I
		end
	end
	if E then
		for H, I in ipairs(E) do
			I.Parent = G
		end
	end
	if D.Parent then
		G.Parent = D.Parent
	end
	return G
end

local function addCorner(C, D)
	return create("UICorner", {
		CornerRadius = D or UDim.new(0, 8),
		Parent = C,
	})
end

local function addStroke(C, D, E, F)
	return create("UIStroke", {
		Color = D or u.Stroke,
		Transparency = E or 0,
		Thickness = F or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = C,
	})
end

i.APPEARANCE_DEFAULTS = {
	WindowRadius = 12,
	CardRadius = 10,
	CardBorder = false,
	SidebarWidth = 146,
	Spacing = 6,
	Shadow = true,
	TabHighlight = "Fill",
	Depth = true,
}

i.APPEARANCE_LIMITS = {
	WindowRadius = { 0, 24 },
	CardRadius = { 0, 18 },
	SidebarWidth = { 120, 220 },
	Spacing = { 2, 16 },
}

i.TAB_HIGHLIGHTS = { Fill = true, Outline = true }

local C = table.clone(i.APPEARANCE_DEFAULTS)
h.Appearance = C

local function applyAppearance(D)
	for E, F in pairs(i.APPEARANCE_DEFAULTS) do
		C[E] = F
	end
	if D == nil then
		return
	end
	if type(D) ~= "table" then
		log("Appearance should be a table, like Appearance = { CardRadius = 8 }")
		return
	end
	for E, F in pairs(D) do
		local G = i.APPEARANCE_DEFAULTS[E]
		if E == "Font" then
			h:SetFont(F)
		elseif G == nil then
			local H = { "Font" }
			for I in pairs(i.APPEARANCE_DEFAULTS) do
				table.insert(H, I)
			end
			table.sort(H)
			log(("Appearance has no option '%s'. Options: %s"):format(tostring(E), table.concat(H, ", ")))
		elseif type(G) == "number" then
			local H = tonumber(F)
			if H then
				local I = i.APPEARANCE_LIMITS[E]
				C[E] = math.clamp(math.floor(H + 0.5), I[1], I[2])
			else
				log(("Appearance.%s should be a number"):format(E))
			end
		elseif type(G) == "boolean" then
			C[E] = F == true
		elseif E == "TabHighlight" then
			if i.TAB_HIGHLIGHTS[F] then
				C[E] = F
			else
				log('Appearance.TabHighlight should be "Fill" or "Outline"')
			end
		end
	end
end
h._applyAppearance = applyAppearance

local function styleCard(D)
	addCorner(D, UDim.new(0, C.CardRadius))
	local E = C.CardBorder and "Stroke" or "Surface2"
	local F = addStroke(D, u[E])
	F:SetAttribute(i.ATTR_STROKE_BASE, E)
	if C.Depth then
		create("UIGradient", {
			Name = "Depth",
			Rotation = 90,
			Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(222, 222, 226)),
			Parent = D,
		})
	end
	return F
end

