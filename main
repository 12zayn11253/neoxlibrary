	local function detectSocial(an, ao, ap)
		local aq = type(an) == "string" and an:lower():gsub("[%s%-_]", "") or nil
		if aq and al[aq] then
			return aq
		end
		aq = type(ao) == "string" and ao:lower():gsub("[%s%-_]", "") or nil
		if aq and al[aq] then
			return aq
		end
		if type(ap) == "string" then
			local ar = ap:lower():gsub("^%a+://", ""):match("^[^/%?#:]+") or ""
			while ar ~= "" do
				if am[ar] then
					return am[ar]
				end
				local as = ar:find("%.")
				if not as then
					break
				end
				ar = ar:sub(as + 1)
			end
		end
		return "website"
	end

	local function normalizeSocials(an)
		local ao = an
		if type(ao) == "table" and type(ao.Links) == "table" then
			ao = ao.Links
		end
		local ap = {}
		if type(ao) ~= "table" then
			return ap
		end
		local aq = {}
		for ar, as in pairs(ao) do
			if type(ar) == "string" and type(as) == "string" and al[ar:lower():gsub("[%s%-_]", "")] then
				table.insert(aq, { Type = ar, Link = as })
			end
		end
		table.sort(aq, function(ar, as)
			return ar.Type < as.Type
		end)
		for ar, as in ipairs(ao) do
			if type(as) == "string" then
				as = { Link = as }
			end
			if type(as) == "table" then
				local at = as.Link or as.Url or as.URL or as[2]
				if type(at) == "string" and at ~= "" then
					table.insert(aq, {
						Type = as.Type,
						Name = as.Name or as.Title or as[1],
						Link = at,
						Icon = as.Icon,
					})
				end
			end
		end
		for ar, as in ipairs(aq) do
			local at = al[detectSocial(as.Type, as.Name, as.Link)]
			table.insert(ap, {
				Name = tostring(as.Name or at[1]),
				Link = as.Link,
				Icon = as.Icon or at[2],
			})
		end
		return ap
	end

	local function formatAmount(an)
		local ao = tostring(math.floor(tonumber(an) or 0))
		local ap = ao:reverse():gsub("(%d%d%d)", "%1,"):reverse()
		return (ap:gsub("^,", ""))
	end

	local function createInfoCard(an, ao, ap, aq, ar)
		local as = create("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = u.Surface2,
			BorderSizePixel = 0,
			LayoutOrder = ao,
			Parent = an,
		})
		as:SetAttribute(i.ATTR_NO_DRAG, true)
		styleCard(as)
		addPadding(as, 14, 14, 12, 14)
		create("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 10),
			Parent = as,
		})
		local at = create("Frame", {
			Size = UDim2.new(1, 0, 0, 20),
			BackgroundTransparency = 1,
			LayoutOrder = 1,
			Parent = as,
		})
		createIcon(at, aq, u.Accent, UDim2.new(0, 0, 0.5, 0))
		local au = createLabel({
			Name = "Title",
			Position = UDim2.fromOffset(24, 0),
			Size = UDim2.new(1, -24, 1, 0),
			Text = ap,
			TextSize = 14,
			Parent = at,
		})
		local av
		if ar and ar ~= "" then
			av = createLabel({
				Name = "Text",
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				Text = ar,
				TextSize = 12,
				FontFace = w.Regular,
				TextColor3 = u.Muted,
				TextWrapped = true,
				TextTruncate = Enum.TextTruncate.None,
				LayoutOrder = 2,
				Parent = as,
			})
		end
		return as, au, av
	end

	local function createButtonGrid(an, ao, ap)
		local aq = math.max(1, math.min(ap, x and 2 or 3))
		local ar = create("Frame", {
			Name = "Buttons",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = ao,
			Parent = an,
		})
		create("UIGridLayout", {
			CellSize = UDim2.new(1 / aq, -math.ceil(8 * (aq - 1) / aq), 0, 34),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = ar,
		})
		return ar
	end

	local function createGridButton(an, ao, ap, aq, ar, as, at)
		local au = create("TextButton", {
			BackgroundColor3 = as and u.Accent or u.Surface,
			BackgroundTransparency = as and 0.1 or 0,
			BorderSizePixel = 0,
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = ao,
			Parent = an,
		})
		au:SetAttribute(i.ATTR_NO_DRAG, true)
		addCorner(au, UDim.new(0, 8))
		local av = as and u.AccentDark or u.Text
		local aw = 10
		if aq then
			createIcon(au, aq, as and u.AccentDark or u.Accent, UDim2.new(0, 10, 0.5, 0))
			aw = 32
		end
		local ax = 0
		if ar and ar ~= "" then
			local ay = createLabel({
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -10, 0.5, 0),
				Size = UDim2.fromOffset(0, 16),
				AutomaticSize = Enum.AutomaticSize.X,
				Text = ar,
				TextSize = 11,
				FontFace = w.Bold,
				TextColor3 = as and u.AccentDark or u.Muted,
				TextTruncate = Enum.TextTruncate.None,
				Parent = au,
			})
			ax = math.max(28, #ar * 7)
			ay.TextXAlignment = Enum.TextXAlignment.Right
		end
		createLabel({
			Position = UDim2.fromOffset(aw, 0),
			Size = UDim2.new(1, -(aw + 10 + (ax > 0 and ax + 6 or 0)), 1, 0),
			Text = ap,
			TextSize = 12,
			TextColor3 = av,
			Parent = au,
		})
		au.MouseEnter:Connect(function()
			if x then
				return
			end
			tween(au, { BackgroundTransparency = as and 0 or 0.35 }, 0.12)
		end)
		au.MouseLeave:Connect(function()
			tween(au, { BackgroundTransparency = as and 0.1 or 0 }, 0.2)
		end)
		au.MouseButton1Click:Connect(at)
		return au
	end

	local function buildSocialsCard(an, ao, ap)
		local aq = type(ap) == "table" and ap or {}
		local ar = normalizeSocials(ap)
		if #ar == 0 then
			log("Socials needs at least one link, like { YouTube = \"https://youtube.com/@you\" }")
			return nil
		end
		local as, at = createInfoCard(an, ao, tostring(aq.Title or "Community"), aq.Icon or "users-round", aq.Text)
		local au = { Links = ar, Frame = as }
		local av
		local function render()
			if av then
				av:Destroy()
			end
			av = createButtonGrid(as, 3, #au.Links)
			for aw, ax in ipairs(au.Links) do
				createGridButton(av, aw, ax.Name, ax.Icon, nil, false, function()
					h:Copy(ax.Link)
					safeCall(aq.OnClick, ax)
				end)
			end
		end
		render()
		function au:SetLinks(aw)
			local ax = normalizeSocials(aw)
			if #ax == 0 then
				log("SetLinks needs at least one link")
				return false
			end
			au.Links = ax
			render()
			return true
		end
		function au:AddLink(aw, ax)
			local ay = normalizeSocials({ type(aw) == "table" and aw or { Name = ax, Link = aw } })
			if #ay == 0 then
				return false
			end
			table.insert(au.Links, ay[1])
			render()
			return true
		end
		function au:SetTitle(aw)
			at.Text = tostring(aw)
		end
		return as, au
	end

	local an = {
		{ "paypal", "wallet" }, { "ko%-?fi", "coffee" }, { "buymeacoffee", "coffee" }, { "coffee", "coffee" },
		{ "patreon", "heart-handshake" }, { "stripe", "credit-card" }, { "card", "credit-card" },
		{ "bitcoin", "logo-bitcoin" }, { "btc", "logo-bitcoin" }, { "ethereum", "coins" }, { "eth", "coins" },
		{ "usdt", "coins" }, { "tether", "coins" }, { "litecoin", "coins" }, { "ltc", "coins" }, { "solana", "coins" },
		{ "crypto", "coins" },
	}

	local function donationIcon(ao)
		if ao.Icon then
			return ao.Icon
		end
		local ap = (tostring(ao.Name or "") .. " " .. tostring(ao.Network or "") .. " " .. tostring(ao.Link or "")):lower()
		for aq, ar in ipairs(an) do
			if ap:find(ar[1]) then
				return ar[2]
			end
		end
		if ao.Address then
			return "wallet"
		end
		if ao.Link then
			return "hand-coins"
		end
		return "heart"
	end

	local function amountText(ao, ap)
		if ao == nil or ao == "" then
			return nil
		end
		if type(ao) == "number" then
			local aq = math.floor(ao)
			local ar = aq == ao and tostring(aq) or string.format("%.2f", ao)
			return tostring(ap or "$") .. ar
		end
		return tostring(ao)
	end

	local function normalizeDonations(ao)
		local ap = type(ao) == "table" and ao or {}
		local aq = {}
		for ar, as in ipairs(ap.Options or ap.Tiers or ap) do
			if type(as) == "table" then
				local at = {
					Name = tostring(as.Name or as.Title or "Donate"),
					Amount = as.Amount or as.Price,
					Link = as.Link or as.Url or as.URL,
					Address = as.Address or as.Wallet,
					Network = as.Network,
					Icon = as.Icon,
					Callback = as.Callback,
					Primary = as.Primary == true,
				}
				if as.Robux or as.AssetId or as.GamePassId then
					log(("donation option \"%s\": Robux donations aren't supported. Use Link (PayPal, Ko-fi...) or Address (crypto)."):format(at.Name))
				end
				if at.Link or at.Address or type(at.Callback) == "function" then
					table.insert(aq, at)
				else
					log(("donation option \"%s\" needs Link, Address or Callback"):format(at.Name))
				end
			end
		end
		return ap, aq
	end

	function aa:_donate(ao, ap)
		ap = ap or {}
		if ao.Link or ao.Address then
			local aq = h:Copy(ao.Link or ao.Address, true)
			if aq then
				local ar
				if ao.Address then
					ar = (ao.Network and (tostring(ao.Network) .. " address") or "Wallet address") .. " copied"
				else
					ar = ao.Name .. " link copied"
				end
				self:Notify({
					Title = ar,
					Content = tostring(ap.Thanks or (ao.Address and "Paste it in your wallet app. Thanks for the support." or "Open it in your browser. Thanks for the support.")),
					Type = "Success",
					Icon = "heart",
					Duration = 6,
				})
			end
		end
		if type(ao.Callback) == "function" then
			runProtected(('donation option "%s"'):format(ao.Name), ao.Callback, ao)
		end
		safeCall(ap.OnClick, ao)
	end

	local function buildDonationCard(ao, ap, aq, ar)
		local as, at = normalizeDonations(ar)
		if #at == 0 then
			log("Donations needs at least one option, like { Name = \"PayPal\", Link = \"https://paypal.me/you\" }")
			return nil
		end
		local au, av, aw = createInfoCard(ap, aq, tostring(as.Title or "Support the creator"), as.Icon or "heart", as.Text or "Donations are optional and help keep the script updated.")
		local ax = { Options = at, Frame = au }
		local ay, az, aA, aB
		local aC = tostring(as.Currency or "$")

		function ax:SetGoal(aD, aE, L)
			if type(aD) == "table" then
				aD, aE, L = aD.Current, aD.Target, aD.Label
			end
			if aD == nil and aE == nil then
				if ay then
					ay.Visible = false
				end
				return true
			end
			aE = tonumber(aE) or (ax._target)
			if not aE or aE <= 0 then
				log("SetGoal needs a target above 0")
				return false
			end
			ax._target = aE
			aD = math.max(0, tonumber(aD) or 0)
			if not ay then
				ay = create("Frame", {
					Name = "Goal",
					Size = UDim2.new(1, 0, 0, 24),
					BackgroundTransparency = 1,
					LayoutOrder = 3,
					Parent = au,
				})
				aB = createLabel({
					Size = UDim2.new(0.45, -4, 0, 14),
					Text = "Goal",
					TextSize = 12,
					TextColor3 = u.Text,
					Parent = ay,
				})
				az = createLabel({
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.fromScale(1, 0),
					Size = UDim2.new(0.55, 0, 0, 14),
					Text = "",
					TextSize = 12,
					FontFace = w.Regular,
					TextColor3 = u.Muted,
					TextXAlignment = Enum.TextXAlignment.Right,
					Parent = ay,
				})
				local M = create("Frame", {
					Position = UDim2.fromOffset(0, 19),
					Size = UDim2.new(1, 0, 0, 5),
					BackgroundColor3 = u.Surface3,
					BorderSizePixel = 0,
					Parent = ay,
				})
				addCorner(M, UDim.new(1, 0))
				aA = create("Frame", {
					Size = UDim2.fromScale(0, 1),
					BackgroundColor3 = u.Accent,
					BorderSizePixel = 0,
					Parent = M,
				})
				addCorner(aA, UDim.new(1, 0))
			end
			if L ~= nil then
				aB.Text = tostring(L)
			end
			ay.Visible = true
			az.Text = aC .. formatAmount(aD) .. " / " .. aC .. formatAmount(aE)
			aA.Size = UDim2.fromScale(math.clamp(aD / aE, 0, 1), 1)
			ax.Goal = { Current = aD, Target = aE, Label = aB.Text }
			return true
		end

		local aD = type(as.Goal) == "table" and as.Goal or nil
		if aD then
			aC = tostring(aD.Prefix or aC)
			ax:SetGoal(aD.Current, aD.Target, aD.Label or "Goal")
		end

		local aE
		local function render()
			if aE then
				aE:Destroy()
			end
			aE = createButtonGrid(au, 4, #ax.Options)
			for L, M in ipairs(ax.Options) do
				local N = amountText(M.Amount, as.Currency) or (M.Address and "Copy" or nil)
				createGridButton(aE, L, M.Name, donationIcon(M), N, M.Primary, function()
					ao:_donate(M, as)
				end)
			end
		end
		render()

		function ax:SetOptions(L)
			local M, N = normalizeDonations({ Options = L })
			if #N == 0 then
				log("SetOptions needs at least one donation option")
				return false
			end
			ax.Options = N
			render()
			return true
		end
		function ax:AddOption(L)
			local M, N = normalizeDonations({ Options = { L } })
			if #N == 0 then
				return false
			end
			table.insert(ax.Options, N[1])
			render()
			return true
		end
		function ax:SetTitle(L)
			av.Text = tostring(L)
		end
		function ax:SetText(L)
			if aw then
				aw.Text = tostring(L)
			end
		end
		return au, ax
	end

	function aa:_buildCommunity(ao)
		local ap = self._homeShown or function()
			return true
		end
		local aq = self._homeOrderOf or function(aq, ar)
			return ar
		end
		local ar = self._socialsOptions
		if ar ~= nil and ar ~= false and ap("Socials") and not (type(ar) == "table" and ar.ShowOnHome == false) then
			self._socialsCard, self.Socials = buildSocialsCard(ao, aq("Socials", 3), ar)
		end
		local as = self._donationOptions
		if as ~= nil and as ~= false and ap("Donations") and not (type(as) == "table" and as.ShowOnHome == false) then
			self._donationCard, self.Donations = buildDonationCard(self, ao, aq("Donations", 4), as)
		end
	end

	function aa:_setupDonations()
		local ao = self._donationOptions
		if type(ao) ~= "table" or ao.HeaderButton == false then
			return
		end
		local ap, aq = normalizeDonations(ao)
		if #aq == 0 then
			return
		end
		self._donationHeader = self:HeaderButton({
			Icon = ao.Icon or "heart",
			Tooltip = tostring(ao.Title or "Support the creator"),
			Callback = function()
				self:ShowDonations()
			end,
		})
	end

	function aa:ShowDonations()
		local ao = self._donationCard
		if ao and ao.Parent and self.Home then
			if not self.Open then
				self:Toggle(true)
			end
			if self._showHomePage then
				self._showHomePage(1)
			end
			self:SelectTab(self.Home)
			task.defer(function()
				local ap = self.Home.List
				if ao.Parent and ap then
					local aq = self.Scale and self.Scale.Scale or 1
					local ar = (ao.AbsolutePosition.Y - ap.AbsolutePosition.Y) / math.max(aq, 0.01)
					ap.CanvasPosition = Vector2.new(0, math.max(0, ap.CanvasPosition.Y + ar - 8))
				end
			end)
			return true
		end
		local ap, aq = normalizeDonations(self._donationOptions)
		if #aq == 0 then
			return false
		end
		local ar = {}
		for as, at in ipairs(aq) do
			if as > 3 then
				break
			end
			local au = amountText(at.Amount, ap.Currency)
			table.insert(ar, {
				Title = au and (at.Name .. "  " .. au) or at.Name,
				Variant = at.Primary and "Primary" or nil,
				Callback = function()
					self:_donate(at, ap)
				end,
			})
		end
		table.insert(ar, { Title = "Later" })
		self:Dialog({
			Title = tostring(ap.Title or "Support the creator"),
			Content = tostring(ap.Text or "Donations are optional and help keep the script updated."),
			Icon = ap.Icon or "heart",
			Buttons = ar,
		})
		return true
	end

	function K:Socials(ao)
		local ap, aq = buildSocialsCard(self.List, self:_nextOrder(), ao)
		if not ap then
			return nil
		end
		return registerElement(self, { Name = type(ao) == "table" and ao.Title or "Community" }, aq, ap, "Socials")
	end

	function K:Donations(ao)
		local ap, aq = buildDonationCard(self.Window, self.List, self:_nextOrder(), ao)
		if not ap then
			return nil
		end
		return registerElement(self, { Name = type(ao) == "table" and ao.Title or "Support the creator" }, aq, ap, "Donations")
	end

	local function shortLink(ao)
		local ap = tostring(ao):gsub("^https?://", ""):gsub("^www%.", ""):gsub("/$", "")
		return ap
	end

	local function createActionRow(ao, ap, aq, ar, as)
		local at = ap.Desc and i.ROW_HEIGHT_DESC or i.ROW_HEIGHT
		local au, av = createCard(ao, "TextButton", at)
		bindHoverStroke(au, av)
		createIcon(au, aq, u.Accent, UDim2.new(0, 14, 0.5, 0))
		local aw = 30
		local ax
		if ar and ar ~= "" then
			ax = createLabel({
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -14, 0.5, 0),
				Size = UDim2.fromOffset(0, 16),
				AutomaticSize = Enum.AutomaticSize.X,
				Text = ar,
				TextSize = 12,
				FontFace = w.Bold,
				TextColor3 = u.Muted,
				TextTruncate = Enum.TextTruncate.None,
				Parent = au,
			})
			aw = math.max(30, #ar * 8 + 20)
		else
			createIcon(au, "copy", u.Muted, UDim2.new(1, -30, 0.5, 0))
		end
		local ay, az = createTitleBlock(au, ap.Name, ap.Desc, aw)
		for aA, aB in ipairs({ ay, az }) do
			aB.Position += UDim2.fromOffset(26, 0)
			aB.Size -= UDim2.fromOffset(26, 0)
		end
		au.MouseButton1Click:Connect(as)
		return au, ay, az, ax
	end

	function K:SocialLink(ao, ap)
		if type(ao) == "string" and type(ap) == "string" then
			ao = { Name = ao, Link = ap }
		elseif type(ao) == "string" then
			ao = { Link = ao }
		end
		local aq = type(ao) == "table" and ao or {}
		local ar = normalizeSocials({ aq })
		if #ar == 0 then
			log("SocialLink needs a Link, like Tab:SocialLink(\"https://youtube.com/@you\")")
			return nil
		end
		local as = ar[1]
		local at = {
			Name = as.Name,
			Desc = aq.Desc or aq.Description or (aq.ShowLink ~= false and shortLink(as.Link) or nil),
		}
		local au = { Link = as.Link }
		local av, aw, ax = createActionRow(self, at, as.Icon, nil, function()
			h:Copy(au.Link)
			safeCall(aq.Callback or aq.OnClick, au.Link)
		end)
		function au:SetLink(ay)
			au.Link = tostring(ay)
			if ax and aq.Desc == nil and aq.ShowLink ~= false then
				ax.Text = shortLink(au.Link)
			end
		end
		function au:Get()
			return au.Link
		end
		function au:SetTitle(ay)
			aw.Text = tostring(ay)
		end
		return registerElement(self, { Name = as.Name, Flag = aq.Flag }, au, av, "SocialLink")
	end

	function K:DonateButton(ao)
		local ap = type(ao) == "table" and ao or {}
		local aq, ar = normalizeDonations({
			Options = { ap },
			Thanks = ap.Thanks,
			OnClick = ap.OnClick,
			Currency = ap.Currency,
		})
		if #ar == 0 then
			return nil
		end
		local as = ar[1]
		local at = amountText(as.Amount, aq.Currency) or (as.Address and "Copy" or nil)
		local au = self.Window
		local av, aw = createActionRow(self, { Name = as.Name, Desc = ap.Desc or ap.Description }, donationIcon(as), at or "", function()
			au:_donate(as, aq)
		end)
		local ax = { Option = as }
		function ax:SetTitle(ay)
			aw.Text = tostring(ay)
		end
		return registerElement(self, { Name = as.Name }, ax, av, "DonateButton")
	end

	function K:Membership(ao)
		return self:KeyInfo(ao)
	end

	function K:Changelog(ao)
		local ap = type(ao) == "table" and (ao.Entries or ao) or {}
		local aq = { Entries = {} }
		local ar = create("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = self:_nextOrder(),
			Parent = self.List,
		})
		create("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, C.Spacing),
			Parent = ar,
		})
		local as = 0
		function aq:Add(at, au)
			if type(at) ~= "table" then
				return false
			end
			as += 1
			createChangelogCard(ar, au and -as or as, at)
			table.insert(aq.Entries, au and 1 or #aq.Entries + 1, at)
			return true
		end
		function aq:Clear()
			for at, au in ipairs(ar:GetChildren()) do
				if au:IsA("GuiObject") then
					au:Destroy()
				end
			end
			aq.Entries = {}
		end
		for at, au in ipairs(ap) do
			aq:Add(au)
		end
		return registerElement(self, { Name = "Changelog" }, aq, ar, "Changelog")
	end

	function K:Welcome(ao)
		local ap = type(ao) == "table" and ao or {}
		local aq = create("Frame", {
			Size = UDim2.new(1, 0, 0, 58),
			BackgroundColor3 = u.Surface2,
			BorderSizePixel = 0,
			LayoutOrder = self:_nextOrder(),
			Parent = self.List,
		})
		aq:SetAttribute(i.ATTR_NO_DRAG, true)
		styleCard(aq)
		local ar = create("ImageLabel", {
			Position = UDim2.fromOffset(12, 11),
			Size = UDim2.fromOffset(36, 36),
			BackgroundColor3 = u.Surface,
			BorderSizePixel = 0,
			Parent = aq,
		})
		addCorner(ar, UDim.new(0, 8))
		task.spawn(function()
			local as, at = pcall(function()
				return f:GetUserThumbnailAsync(g.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
			end)
			if as and at and ar.Parent then
				ar.Image = at
			end
		end)
		local as = ap.Greeting
		if as == nil then
			local at = tonumber(os.date("%H")) or 12
			as = "Good " .. (at < 12 and "morning" or (at < 18 and "afternoon" or "evening")) .. "."
		end
		local at = createLabel({
			Position = UDim2.fromOffset(58, 11),
			Size = UDim2.new(1, -72, 0, 18),
			Text = tostring(ap.Text or ap.Welcome or "Hello, ") .. g.DisplayName,
			TextSize = 15,
			Parent = aq,
		})
		local au = createLabel({
			Position = UDim2.fromOffset(58, 30),
			Size = UDim2.new(1, -72, 0, 16),
			Text = tostring(as),
			TextSize = 13,
			FontFace = w.Regular,
			TextColor3 = u.Muted,
			Parent = aq,
		})
		local av = {}
		function av:SetGreeting(aw)
			au.Text = tostring(aw)
		end
		function av:SetTitle(aw)
			at.Text = tostring(aw)
		end
		return registerElement(self, { Name = "Welcome" }, av, aq, "Welcome")
	end

	local ao = {
		FPS = { "activity", "FPS" },
		Ping = { "wifi", "Ping" },
		Executor = { "terminal", "Executor" },
		Game = { "gamepad-2", "Game" },
		Region = { "globe", "Your region" },
		Time = { "clock", "Time of day" },
		Players = { "users", "Players" },
		Uptime = { "timer", "Session" },
	}

	function K:SystemStats(ap)
		local aq = type(ap) == "table" and ap or {}
		local ar = aq.Stats or (#aq > 0 and aq) or { "FPS", "Ping", "Executor", "Game", "Region", "Time" }
		local as = self.Window
		local at = create("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = self:_nextOrder(),
			Parent = self.List,
		})
		create("UIGridLayout", {
			CellSize = UDim2.new(0.5, -4, 0, 62),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = at,
		})
		local au = {}
		for av, aw in ipairs(ar) do
			local ax = ao[aw]
			if ax then
				au[aw] = createStatTile(at, av, ax[1], ax[2])
			else
				log(("SystemStats has no stat \"%s\". Use FPS, Ping, Executor, Game, Region, Time, Players or Uptime."):format(tostring(aw)))
			end
		end
		if au.Executor then
			au.Executor.Text = getExecutorName()
		end
		if au.Game then
			au.Game.Text = "Loading"
			task.spawn(function()
				local av = getGameName()
				if au.Game.Parent then
					au.Game.Text = av
				end
			end)
		end
		if au.Region then
			au.Region.Text = "Loading"
			fetchRegion(function(av)
				if au.Region.Parent then
					au.Region.Text = av
				end
			end, aq.RegionCity == false)
		end
		local av = 0
		local aw = os.clock()
		as:_listen("Render", function()
			av += 1
		end)
		local ax = self._rootTab or self
		task.spawn(function()
			while not as._destroyed and at.Parent do
				if as.Open and as.CurrentTab == ax and at.Visible then
					if au.FPS then
						au.FPS.Text = tostring(av)
					end
					if au.Ping then
						local ay, az = pcall(function()
							return math.floor(g:GetNetworkPing() * 1000)
						end)
						au.Ping.Text = (ay and az or 0) .. " ms"
					end
					if au.Time then
						au.Time.Text = os.date(aq.TimeFormat or "%H:%M")
					end
					if au.Players then
						au.Players.Text = #f:GetPlayers() .. " / " .. f.MaxPlayers
					end
					if au.Uptime then
						local ay = math.floor(os.clock() - aw)
						au.Uptime.Text = string.format("%d:%02d", math.floor(ay / 60), ay % 60)
					end
				end
				av = 0
				task.wait(1)
			end
		end)
		return registerElement(self, { Name = "System stats" }, { Values = au }, at, "SystemStats")
	end

	K.CreateSocials = K.Socials
	K.CreateDonations = K.Donations
	K.Donate = K.Donations
	K.CreateSocialLink = K.SocialLink
	K.CreateDonateButton = K.DonateButton
	K.CreateMembership = K.Membership
	K.CreateChangelog = K.Changelog
	K.CreateWelcome = K.Welcome
	K.CreateSystemStats = K.SystemStats
	K.CreateSettings = K.Settings

	function K:SetVisible(ap)
		ap = ap ~= false
		self._userHidden = not ap
		local aq = self.Window
		local ar = self._section
		local as = ap and (ar == nil or ar.Opened or aq._compact)
		self._button:SetAttribute(i.ATTR_HIDDEN, not as)
		if aq._introDone then
			self._button.Visible = as
		end
		if ar and ar._refreshCount then
			ar:_refreshCount()
		end
		if not ap and aq.CurrentTab == self then
			for at, au in ipairs(aq.Tabs) do
				if au ~= self and not au._userHidden then
					aq:SelectTab(au)
					break
				end
			end
		elseif aq.CurrentTab then
			aq:_placeIndicator(aq.CurrentTab)
		end
		return self
	end

	function K:Hide()
		return self:SetVisible(false)
	end

	function K:Show()
		return self:SetVisible(true)
	end

	function K:IsVisible()
		return not self._userHidden
	end

	function K:IsSelected()
		return self.Window.CurrentTab == self
	end

	function K:SetIcon(ap)
		if self._icon then
			if ap == nil or ap == false then
				self._icon.Visible = false
			else
				setIcon(self._icon, ap)
				self._icon.Visible = true
			end
		end
		return self
	end

	function K:Destroy()
		local ap = self.Window
		if self._destroyed then
			return
		end
		self._destroyed = true
		if ap._outLayer then
			ap:_settleTransition()
		end
		local aq = table.find(ap.Tabs, self)
		if aq then
			table.remove(ap.Tabs, aq)
		end
		if self._section then
			local ar = table.find(self._section.Tabs, self)
			if ar then
				table.remove(self._section.Tabs, ar)
			end
			if self._section._refreshCount then
				self._section:_refreshCount()
			end
		end
		for ar, as in pairs(ap.Flags) do
			local at = as._tab
			if at == self or (at and at._rootTab == self) then
				ap.Flags[ar] = nil
				if h.Flags[ar] == as then
					h.Flags[ar] = nil
				end
			end
		end
		if ap.CurrentTab == self then
			ap.CurrentTab = nil
			if ap.Indicator then
				ap.Indicator.Parent = ap.TabList
				ap.Indicator.Visible = false
			end
			for ar, as in ipairs(ap.Tabs) do
				if not as._userHidden then
					ap:SelectTab(as)
					break
				end
			end
		end
		if self._button then
			self._button:Destroy()
		end
		if self._page then
			self._page:Destroy()
		end
	end

	function aa:GetTab(ap)
		for aq, ar in ipairs(self.Tabs) do
			if ar.Name == ap then
				return ar
			end
		end
		local aq = string.lower(tostring(ap or ""))
		for ar, as in ipairs(self.Tabs) do
			if string.lower(as.Name) == aq then
				return as
			end
		end
		return nil
	end

	function aa:GetCurrentTab()
		return self.CurrentTab
	end

	function aa:OnTabChanged(ap)
		if type(ap) ~= "function" then
			return { Disconnect = function() end }
		end
		self._tabListeners = self._tabListeners or {}
		table.insert(self._tabListeners, ap)
		return {
			Disconnect = function()
				local aq = table.find(self._tabListeners, ap)
				if aq then
					table.remove(self._tabListeners, aq)
				end
			end,
		}
	end

	function K:Build()
		local ap = self._lazyBuild
		if ap then
			self._lazyBuild = nil
			runProtected(('building tab "%s"'):format(tostring(self.Name)), ap, self)
		end
		return self
	end

	function K:IsBuilt()
		return self._lazyBuild == nil
	end

	function aa:BuildAllTabs()
		for ap, aq in ipairs(table.clone(self.Tabs)) do
			aq:Build()
		end
	end

	local ap = aa._runSearch
	function aa:_runSearch(aq, ...)
		if type(aq) == "string" and aq:gsub("%s", "") ~= "" then
			self:BuildAllTabs()
		end
		return ap(self, aq, ...)
	end

	function K:SetLocked(aq, ar)
		self._locked = aq == true
		self._lockedReason = ar
		local as = self._locked and 0.55 or 0
		if self._label then
			self._label.TextTransparency = as
		end
		if self._icon then
			self._icon.ImageTransparency = as
		end
		if not self._lockIcon and self._locked and self._button then
			self._lockIcon = create("ImageLabel", {
				Name = "LockIcon",
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -10, 0.5, 0),
				Size = UDim2.fromOffset(12, 12),
				BackgroundTransparency = 1,
				ImageColor3 = u.Muted,
				ZIndex = 2,
				Parent = self._button,
			})
			setIcon(self._lockIcon, "lock")
		end
		if self._lockIcon then
			self._lockIcon.Visible = self._locked and not self.Window._compact
		end
		return self
	end

	function K:Lock(aq)
		return self:SetLocked(true, aq)
	end

	function K:Unlock()
		return self:SetLocked(false)
	end

	function K:IsLocked()
		return self._locked == true
	end

	local aq = aa.SelectTab
	function aa:SelectTab(ar, ...)
		if type(ar) == "string" then
			ar = self:GetTab(ar) or ar
		end
		if type(ar) == "table" and ar._locked then
			if self._introDone then
				self:Notify({
					Title = tostring(ar.Name or "Tab") .. " is locked",
					Content = tostring(ar._lockedReason or "This tab isn't available right now."),
					Type = "Warning",
					Icon = "lock",
					Duration = 4,
				})
			end
			return nil
		end
		if type(ar) == "table" and ar._lazyBuild then
			ar:Build()
		end
		local as = self.CurrentTab
		local at = aq(self, ar, ...)
		local au = self.CurrentTab
		if au ~= as and au then
			for av, aw in ipairs(table.clone(self._tabListeners or {})) do
				runProtected("OnTabChanged", aw, au, as)
			end
			if self._rememberKey and self._rememberReady and au.Name then
				h.Utils.SaveData(self._rememberKey, { Tab = au.Name })
			end
		end
		return at
	end

	function aa:_restoreTab()
		if not self._rememberKey then
			return
		end
		local ar = h.Utils.LoadData(self._rememberKey, nil)
		local as = type(ar) == "table" and ar.Tab and self:GetTab(ar.Tab)
		if as and not as._userHidden and self.CurrentTab ~= as then
			self:SelectTab(as)
		end
		self._rememberReady = true
	end

	function h:OnFlagChanged(ar, as)
		if type(ar) ~= "string" or type(as) ~= "function" then
			log("OnFlagChanged needs a flag name and a function")
			return { Disconnect = function() end }
		end
		h._flagListeners = h._flagListeners or {}
		local at = h._flagListeners[ar] or {}
		h._flagListeners[ar] = at
		local au = { Listener = as, Connections = {} }
		table.insert(at, au)
		local av = h.Flags[ar]
		if av and av.OnChanged then
			au.Connections[av] = av:OnChanged(as)
		end
		return {
			Disconnect = function()
				local aw = table.find(at, au)
				if aw then
					table.remove(at, aw)
				end
				for ax, ay in pairs(au.Connections) do
					if ay and ay.Disconnect then
						ay.Disconnect()
					end
				end
				au.Connections = {}
			end,
		}
	end

	function aa:OnFlagChanged(ar, as)
		return h:OnFlagChanged(ar, as)
	end

	local function playerLabel(ar, as)
		if as and ar.DisplayName and ar.DisplayName ~= ar.Name then
			return ar.DisplayName .. " (@" .. ar.Name .. ")"
		end
		return ar.Name
	end

	function K:PlayerDropdown(ar)
		local as = normalizeOptions(ar, { Title = "Name", Description = "Desc" })
		local at = as.IncludeSelf == true
		local au = as.DisplayNames ~= false
		local av = {}
		local function buildList()
			local aw = {}
			av = {}
			local ax = f:GetPlayers()
			table.sort(ax, function(ay, az)
				return string.lower(ay.Name) < string.lower(az.Name)
			end)
			for ay, az in ipairs(ax) do
				if at or az ~= g then
					local aA = playerLabel(az, au)
					av[aA] = az.Name
					table.insert(aw, aA)
				end
			end
			return aw
		end
		local aw = as.Callback
		local ax
		local function findByName(ay)
			for az, aA in ipairs(f:GetPlayers()) do
				if aA.Name == ay then
					return aA
				end
			end
			return nil
		end
		local function toPlayers(ay)
			if type(ay) == "table" then
				local az = {}
				for aA, aB in ipairs(ay) do
					local aC = findByName(av[aB] or aB)
					if aC then
						table.insert(az, aC)
					end
				end
				return az
			end
			if ay == nil then
				return nil
			end
			return findByName(av[ay] or ay)
		end
		local ay = table.clone(as)
		ay.Options = buildList()
		ay.Name = as.Name or (as.Multi and "Players" or "Player")
		ay.Search = as.Search ~= false
		ay.Callback = function(az)
			if aw then
				aw(toPlayers(az), az)
			end
		end
		ax = self:Dropdown(ay)
		if not ax then
			return nil
		end
		local function refresh()
			if ax._destroyed then
				return
			end
			ax:Refresh(buildList(), true)
		end
		local az = self.Window
		az:Connect(f.PlayerAdded, function()
			task.defer(refresh)
		end)
		az:Connect(f.PlayerRemoving, function()
			task.defer(refresh)
		end)
		function ax:GetPlayer()
			return toPlayers(ax:Get())
		end
		ax.GetPlayers = ax.GetPlayer
		function ax:RefreshPlayers()
			refresh()
		end
		return ax
	end

	local ar = { Info = "Text", Success = "Success", Warning = "Warning", Error = "Error", Muted = "Muted" }

	function K:Console(as)
		local at = normalizeOptions(as, { Title = "Name" })
		local au = math.clamp(tonumber(at.MaxLines) or 100, 5, 500)
		local av = math.clamp(tonumber(at.Height) or 160, 80, 600)
		local aw = at.Timestamps ~= false
		local ax = create("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = u.Surface2,
			BorderSizePixel = 0,
			LayoutOrder = self:_nextOrder(),
			Parent = self.List,
		})
		ax:SetAttribute(i.ATTR_NO_DRAG, true)
		styleCard(ax)
		addPadding(ax, 12, 12, 10, 12)
		create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8), Parent = ax })
		local ay = create("Frame", { Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, LayoutOrder = 1, Parent = ax })
		createIcon(ay, at.Icon or "terminal", u.Muted, UDim2.new(0, 0, 0.5, 0))
		local az = createLabel({
			Position = UDim2.fromOffset(24, 0),
			Size = UDim2.new(1, -120, 1, 0),
			Text = tostring(at.Name or "Console"),
			TextSize = 13,
			Parent = ay,
		})
		local function headerButton(aA, aB, aC)
			local aD = create("TextButton", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, aB, 0.5, 0),
				Size = UDim2.fromOffset(46, 20),
				BackgroundColor3 = u.Surface,
				BorderSizePixel = 0,
				Text = "",
				AutoButtonColor = false,
				Parent = ay,
			})
			aD:SetAttribute(i.ATTR_NO_DRAG, true)
			addCorner(aD, UDim.new(0, 6))
			createLabel({
				Size = UDim2.fromScale(1, 1),
				Text = aA,
				TextSize = 11,
				TextColor3 = u.Muted,
				TextXAlignment = Enum.TextXAlignment.Center,
				Parent = aD,
			})
			aD.MouseButton1Click:Connect(aC)
			return aD
		end
		local aA = create("ScrollingFrame", {
			Size = UDim2.new(1, 0, 0, av),
			BackgroundColor3 = u.Surface,
			BorderSizePixel = 0,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = u.Muted,
			ScrollBarImageTransparency = 0.55,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			LayoutOrder = 2,
			Parent = ax,
		})
		aA:SetAttribute(i.ATTR_NO_DRAG, true)
		addCorner(aA, UDim.new(0, 6))
		addStroke(aA)
		addPadding(aA, 8, 8, 6, 6)
		create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2), Parent = aA })
		local aB = createLabel({
			Size = UDim2.new(1, 0, 0, 16),
			Text = tostring(at.EmptyText or "Nothing logged yet."),
			TextSize = 12,
			FontFace = w.Regular,
			TextColor3 = u.Muted,
			LayoutOrder = 0,
			Parent = aA,
		})
		local aC = { Lines = {} }
		local aD = {}
		local aE = 0
		local function scrollToEnd()
			task.defer(function()
				if aA.Parent then
					aA.CanvasPosition = Vector2.new(0, math.max(0, aA.AbsoluteCanvasSize.Y))
				end
			end)
		end
		function aC:Log(L, M)
			M = ar[M] and M or "Info"
			L = tostring(L)
			aE += 1
			local N = aw and os.date("%H:%M:%S") or nil
			table.insert(aC.Lines, { Text = L, Type = M, Time = N })
			aB.Visible = false
			local O = createLabel({
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				Text = (N and (N .. "  ") or "") .. L,
				TextSize = 12,
				FontFace = i.MONO_FONT or w.Regular,
				TextColor3 = u[ar[M] ],
				TextWrapped = true,
				TextTruncate = Enum.TextTruncate.None,
				LayoutOrder = aE,
				Parent = aA,
			})
			table.insert(aD, O)
			while #aD > au do
				table.remove(aD, 1):Destroy()
				table.remove(aC.Lines, 1)
			end
			if at.AutoScroll ~= false then
				scrollToEnd()
			end
			return aC
		end
		aC.Add = aC.Log
		aC.Print = aC.Log
		function aC:Info(L) return aC:Log(L, "Info") end
		function aC:Success(L) return aC:Log(L, "Success") end
		function aC:Warn(L) return aC:Log(L, "Warning") end
		function aC:Error(L) return aC:Log(L, "Error") end
		function aC:Clear()
			for L, M in ipairs(aD) do
				M:Destroy()
			end
			aD = {}
			aC.Lines = {}
			aB.Visible = true
			return aC
		end
		function aC:GetText()
			local L = {}
			for M, N in ipairs(aC.Lines) do
				table.insert(L, (N.Time and (N.Time .. "  ") or "") .. N.Text)
			end
			return table.concat(L, "\n")
		end
		function aC:SetTitle(L)
			az.Text = tostring(L)
		end
		headerButton("Clear", 0, function()
			aC:Clear()
		end)
		headerButton("Copy", -52, function()
			h:Copy(aC:GetText())
		end)
		return registerElement(self, { Name = at.Name or "Console" }, aC, ax, "Console")
	end

	local as = { Success = "Success", Warning = "Warning", Error = "Error", Info = "Accent", Idle = "Muted" }

	function K:Status(at)
		local au = normalizeOptions(at, { Title = "Name", Description = "Desc" })
		local av = au.Desc and i.ROW_HEIGHT_DESC or i.ROW_HEIGHT
		local aw = createCard(self, "Frame", av)
		local ax = createTitleBlock(aw, au.Name or "Status", au.Desc, 150)
		local ay = create("Frame", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -14, 0.5, 0),
			Size = UDim2.fromOffset(0, 22),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = u.Surface,
			BorderSizePixel = 0,
			Parent = aw,
		})
		addCorner(ay, UDim.new(1, 0))
		addPadding(ay, 9, 10)
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 6),
			Parent = ay,
		})
		local az = create("Frame", { Size = UDim2.fromOffset(7, 7), BorderSizePixel = 0, LayoutOrder = 1, Parent = ay })
		addCorner(az, UDim.new(1, 0))
		local aA = createLabel({
			Size = UDim2.fromOffset(0, 22),
			AutomaticSize = Enum.AutomaticSize.X,
			Text = "",
			TextSize = 12,
			TextTruncate = Enum.TextTruncate.None,
			LayoutOrder = 2,
			Parent = ay,
		})
		local aB = {}
		function aB:SetStatus(aC, aD)
			aD = as[aD] and aD or (aB.Type or "Idle")
			aB.Status = tostring(aC)
			aB.Type = aD
			aA.Text = aB.Status
			az.BackgroundColor3 = u[as[aD] ]
			aA.TextColor3 = aD == "Idle" and u.Muted or u.Text
			return aB
		end
		function aB:Get()
			return aB.Status, aB.Type
		end
		function aB:SetTitle(aC)
			ax.Text = tostring(aC)
		end
		aB:SetStatus(au.Status or au.Text or "Idle", au.Type or "Idle")
		return registerElement(self, au, aB, aw, "Status")
	end

	function aj.FindPlayer(at)
		return aj.GetPlayer(at)
	end

	function aj.GetPlayerNames(at)
		local au = {}
		for av, aw in ipairs(f:GetPlayers()) do
			if at or aw ~= g then
				table.insert(au, aw.Name)
			end
		end
		table.sort(au, function(av, aw)
			return string.lower(av) < string.lower(aw)
		end)
		return au
	end

	function aj.Distance(at, au)
		local function position(av)
			if typeof(av) == "Vector3" then
				return av
			elseif typeof(av) == "CFrame" then
				return av.Position
			elseif typeof(av) == "Instance" then
				if av:IsA("Player") then
					local aw = aj.GetRoot(av)
					return aw and aw.Position
				elseif av:IsA("Model") then
					local aw = av.PrimaryPart or av:FindFirstChild("HumanoidRootPart")
					return aw and aw.Position
				elseif av:IsA("BasePart") then
					return av.Position
				end
			end
			return nil
		end
		local av, aw = position(at), position(au or g)
		if not av or not aw then
			return math.huge
		end
		return (av - aw).Magnitude
	end

	function aj.ServerInfo()
		local at, au = pcall(function()
			return math.floor(g:GetNetworkPing() * 1000)
		end)
		local av, aw = pcall(function()
			return math.floor(workspace.DistributedGameTime)
		end)
		return {
			PlaceId = game.PlaceId,
			JobId = game.JobId,
			Players = #f:GetPlayers(),
			MaxPlayers = f.MaxPlayers,
			Ping = at and au or 0,
			Uptime = av and aw or 0,
		}
	end

	function aj.CopyJobId()
		return h:Copy(game.JobId)
	end

	function aj.JoinServer(at, au)
		if type(at) ~= "string" or at == "" then
			log("JoinServer needs a JobId")
			return false
		end
		local av, aw = pcall(function()
			game:GetService("TeleportService"):TeleportToPlaceInstance(tonumber(au) or game.PlaceId, at, g)
		end)
		if not av then
			log("JoinServer failed: " .. tostring(aw))
		end
		return av
	end

	function aj.HttpGet(at)
		local au, av = pcall(function()
			return game:HttpGet(at)
		end)
		if au then
			return true, av
		end
		return false, tostring(av)
	end

	function aj.JSONEncode(at)
		local au, av = pcall(e.JSONEncode, e, at)
		return au and av or nil
	end

	function aj.JSONDecode(at)
		local au, av = pcall(e.JSONDecode, e, at)
		return au and av or nil
	end

	local at = {
		Toggle = true, Button = true, Slider = true, Dropdown = true, Input = true, Keybind = true,
		ColorPicker = true, Label = true, Paragraph = true, Section = true, Divider = true, Space = true,
		Stepper = true, Progress = true, Select = true, TextArea = true, Code = true, Stat = true, Image = true,
		ButtonRow = true, Status = true, Console = true, PlayerDropdown = true, SocialLink = true,
		DonateButton = true, Socials = true, Donations = true, Group = true,
	}

	function K:AddElements(au)
		local av = {}
		if type(au) ~= "table" then
			log("AddElements needs a list, like { { Type = \"Toggle\", Name = \"Fly\" } }")
			return av
		end
		for aw, ax in ipairs(au) do
			local ay = type(ax) == "table" and (ax.Type or ax.Element)
			if not (ay and at[ay]) then
				log(("AddElements item %d has no valid Type (got %s)"):format(aw, tostring(ay)))
			else
				local az = table.clone(ax)
				az.Type = nil
				az.Element = nil
				local aA = az.Elements
				az.Elements = nil
				local aB
				if ay == "Section" or ay == "Divider" or ay == "Space" then
					aB = self[ay](self, az.Name or az.Title or az.Text or az.Size)
				else
					aB = self[ay](self, az)
				end
				if ay == "Group" and aB and type(aA) == "table" then
					aB:AddElements(aA)
				end
				av[aw] = aB
				if type(az.Flag) == "string" then
					av[az.Flag] = aB
				end
			end
		end
		return av
	end

	function aa:BindKey(au, av, aw)
		aw = type(aw) == "table" and aw or {}
		local function resolve(ax)
			if typeof(ax) == "EnumItem" then
				return ax
			end
			local ay, az = pcall(function()
				return Enum.KeyCode[tostring(ax)]
			end)
			return ay and az or nil
		end
		local ax = resolve(au)
		if not ax or type(av) ~= "function" then
			log("BindKey needs a key like \"F\" or Enum.KeyCode.F and a function")
			return { Disconnect = function() end, SetKey = function() end }
		end
		local ay = { Key = ax, Enabled = true }
		local az = self:Connect(b.InputBegan, function(az, aA)
			if not ay.Enabled or az.KeyCode ~= ay.Key then
				return
			end
			if aA and not aw.IgnoreGameProcessed then
				return
			end
			if b:GetFocusedTextBox() then
				return
			end
			runProtected(("key %s"):format(ay.Key.Name), av, ay.Key)
		end)
		local aA
		if type(aw.OnRelease) == "function" then
			aA = self:Connect(b.InputEnded, function(aB)
				if ay.Enabled and aB.KeyCode == ay.Key then
					runProtected(("key %s release"):format(ay.Key.Name), aw.OnRelease, ay.Key)
				end
			end)
		end
		function ay:SetKey(aB)
			local aC = resolve(aB)
			if aC then
				ay.Key = aC
			end
			return aC ~= nil
		end
		function ay:SetEnabled(aB)
			ay.Enabled = aB ~= false
		end
		function ay:Disconnect()
			ay.Enabled = false
			if az and az.Disconnect then
				az:Disconnect()
			end
			if aA and aA.Disconnect then
				aA:Disconnect()
			end
		end
		return ay
	end

	local function matchesGame(au)
		if type(au) ~= "table" then
			au = { au }
		end
		for av, aw in ipairs(au) do
			local ax = tonumber(aw)
			if ax and (ax == game.PlaceId or ax == game.GameId) then
				return true
			end
		end
		return false
	end

	function aj.IsGame(au)
		return matchesGame(au)
	end

	function h:ForGame(au, av)
		if type(au) ~= "table" then
			log("ForGame needs a table like { [PlaceId] = function() end }")
			return nil
		end
		for aw, ax in pairs(au) do
			if matchesGame(aw) and type(ax) == "function" then
				return ax(game.PlaceId)
			end
		end
		if type(av) == "function" then
			return av(game.PlaceId)
		end
		return nil
	end

	local function versionParts(au)
		local av = {}
		for aw in string.gmatch(tostring(au or ""), "%d+") do
			table.insert(av, tonumber(aw))
		end
		return av
	end

	function aj.CompareVersions(au, av)
		local aw, ax = versionParts(au), versionParts(av)
		for ay = 1, math.max(#aw, #ax) do
			local az, aA = aw[ay] or 0, ax[ay] or 0
			if az ~= aA then
				return az < aA and -1 or 1
			end
		end
		return 0
	end

	function h:CheckVersion(au)
		local av = type(au) == "table" and au or {}
		if type(av.Url) ~= "string" or av.Current == nil then
			log("CheckVersion needs { Url = \"...\", Current = \"1.0.0\" }")
			return false
		end
		local aw = av.OnResult
		task.spawn(function()
			local ax, ay = aj.HttpGet(av.Url)
			if not ax then
				safeCall(aw, false, nil)
				return
			end
			local az = tostring(ay):match("[%d%.]+") or tostring(ay)
			local aA = aj.CompareVersions(av.Current, az) < 0
			if aA and av.Notify ~= false then
				h:Notify({
					Title = tostring(av.Title or "Update available"),
					Content = tostring(av.Message or ("Version " .. az .. " is out. You have " .. tostring(av.Current) .. ".")),
					Type = "Info",
					Duration = 8,
				})
			end
			safeCall(aw, aA, az)
		end)
		return true
	end

	local function globalFunction(au)
		local av, aw = pcall(function()
			return getgenv()
		end)
		local ax = { _G }
		if av and type(aw) == "table" then
			table.insert(ax, 1, aw)
		end
		for ay, az in ipairs(ax) do
			local aA = az
			for aB in tostring(au):gmatch("[^%.]+") do
				aA = type(aA) == "table" and aA[aB] or nil
			end
			if type(aA) == "function" then
				return true
			end
		end
		return false
	end

	function aj.Supports(...)
		local au = {}
		for av, aw in ipairs({ ... }) do
			if not globalFunction(aw) then
				table.insert(au, tostring(aw))
			end
		end
		return #au == 0, au
	end

	function h:RequireFunctions(au, av)
		if type(au) ~= "table" then
			au = { au }
		end
		local aw, ax = aj.Supports(table.unpack(au))
		if not aw then
			h:Notify({
				Title = "Executor not supported",
				Content = tostring(av or ("Missing: " .. table.concat(ax, ", "))),
				Type = "Warning",
				Duration = 8,
			})
		end
		return aw, ax
	end

	function aj.Throttle(au, av)
		av = tonumber(av) or 0.2
		local aw = -math.huge
		return function(...)
			local ax = os.clock()
			if ax - aw >= av then
				aw = ax
				return au(...)
			end
			return nil
		end
	end

	function aj.WaitForPath(au, av, aw)
		if type(au) == "string" and av == nil then
			au, av = game, au
		elseif type(au) == "string" then
			aw, av, au = av, au, game
		end
		aw = tonumber(aw) or 5
		local ax = au
		local ay = os.clock() + aw
		for az in string.gmatch(tostring(av), "[^%.]+") do
			if ax == game then
				local aA, aB = pcall(game.GetService, game, az)
				if aA and aB then
					ax = aB
					continue
				end
			end
			local aA = ax:FindFirstChild(az)
			while not aA and os.clock() < ay do
				task.wait(0.1)
				aA = ax:FindFirstChild(az)
			end
			if not aA then
				return nil
			end
			ax = aA
		end
		return ax
	end

