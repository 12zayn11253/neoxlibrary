local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local STATUS_COLORS = {
	Warning = rgb(255, 184, 92),
	Success = rgb(74, 222, 128),
	Error = rgb(248, 96, 112),
}

local function withStatusColors(theme)
	for key, color in pairs(STATUS_COLORS) do
		if theme[key] == nil then
			theme[key] = color
		end
	end
	return theme
end

